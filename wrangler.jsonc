{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	"name": "hskkit",
	"workers_dev": false,
	"compatibility_date": "2026-05-24",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			// Self-reference service binding, the service name must match the worker name
			// see https://opennext.js.org/cloudflare/caching
			"binding": "WORKER_SELF_REFERENCE",
			"service": "hskkit"
		}
	],
	"images": {
		// Enable image optimization
		// see https://opennextjs.org/cloudflare/howtos/image
		"binding": "IMAGES"
	},
	"vars": {
		"DEEPSEEK_BASE_URL": "https://api.deepseek.com",
		"DEEPSEEK_MODEL": "deepseek-flash",
		"AI_DAILY_ALLOWANCE": "10",
		"AI_RATE_LIMIT_PER_MINUTE": "6",
		"AI_MAX_OUTPUT_TOKENS": "500",
		"COMMERCE_MODE": "live",
		"STRIPE_PAID_CHECKOUT_ENABLED": "true",
		"STRIPE_HALF_OFF_COUPON_ID": "OOU69X7Q",
		"STRIPE_HALF_OFF_START_AT": "2026-10-20T03:15:00.000Z",
		"STRIPE_HALF_OFF_END_AT": "2026-11-03T03:15:00.000Z",
		"PLACEMENT_DB_MODE": "primary",
		"GOOGLE_REDIRECT_URI": "https://hskkit.com/api/v1/auth/google/callback"
	},
	"d1_databases": [{
		"binding": "LEARNING_DB",
		"database_name": "hskkit-learning",
		"database_id": "214d11f8-3cb2-46b7-b7b1-0dfb602dc6e7",
		"migrations_dir": "migrations"
	}, {
		"binding": "PLACEMENT_DB",
		"database_name": "hskkit-placement",
		"database_id": "f9cd1bb9-a95c-4e8e-843e-25cb013a41a2",
		"migrations_dir": "migrations-placement"
	}],
	"send_email": [{
		"name": "FEEDBACK_EMAIL"
	}],
	"r2_buckets": [{
		"binding": "COMMERCIAL_EXPORTS_R2",
		"bucket_name": "hskkit-commercial-exports"
	}, {
		"binding": "BLOG_MEDIA_R2",
		"bucket_name": "hskkit-blog-media"
	}],
	"queues": {
		"producers": [{
			"binding": "COMMERCIAL_EXPORT_QUEUE",
			"queue": "hskkit-commercial-exports"
		}]
	}
}

