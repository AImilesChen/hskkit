    },
    {
      "id": "C1A-M20",
      "kind": "listening-source",
      "sourcePlays": 1,
      "script": [
        {
          "speaker": "male",
          "text": {
            "zh-Hans": "周末你喜欢做什么？",
            "zh-Hant": "週末你喜歡做什麼？"
          }
        },
        {
          "speaker": "female",
          "text": {
            "zh-Hans": "我喜欢画画，也喜欢听音乐。这周六下午我要在家画画。星期天再去听音乐。",
            "zh-Hant": "我喜歡畫畫，也喜歡聽音樂。這週六下午我要在家畫畫。星期天再去聽音樂。"
          }
        }
      ],
      "sourceDurationSeconds": 11.846,
