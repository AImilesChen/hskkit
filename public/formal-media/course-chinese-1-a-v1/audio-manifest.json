      "sha256": "504fc708206515fdf3a50e6e33f1df4753da7683db9690f7a36d123dd1a04481"
    },
    {
      "id": "C1A-M02",
      "kind": "listening-source",
      "sourcePlays": 1,
      "script": [
        {
          "speaker": "female",
          "text": {
            "zh-Hans": "我家有四个人。爸爸是老师，妈妈是医生。我和弟弟都是学生。妈妈每天早上八点去医院。",
            "zh-Hant": "我家有四個人。爸爸是老師，媽媽是醫生。我和弟弟都是學生。媽媽每天早上八點去醫院。"
          }
        }
      ],
      "sourceDurationSeconds": 10.08,
      "src": "assets/audio/c1a-m02.mp3",
      "durationSeconds": 10.632,
      "pcmSeconds": 10.58,
      "bytes": 85292,
      "sha256": "fffbb9a4bafe658b5303b8e442aeffc3b9b9cf512ce4b6e38e23bb53b05aa410"
    },
    {
      "id": "C1A-M03",
      "kind": "listening-source",
      "sourcePlays": 1,
      "script": [
        {
          "speaker": "male",
          "text": {
            "zh-Hans": "这是我妹妹的照片，她今年十五岁，喜欢唱歌。我弟弟只有九岁，喜欢画画。我每天和妹妹一起上学。",
            "zh-Hant": "這是我妹妹的照片，她今年十五歲，喜歡唱歌。我弟弟只有九歲，喜歡畫畫。我每天和妹妹一起上學。"
          }
        }
      ],
      "sourceDurationSeconds": 10.632,
      "src": "assets/audio/c1a-m03.mp3",
      "durationSeconds": 11.184,
      "pcmSeconds": 11.132,
      "bytes": 89708,
      "sha256": "48dd4fd97f75de6bdc849f0589832667f59d5c9a5f5fd8d676bc8aa5239292be"
    },
    {
      "id": "C1A-M04",
      "kind": "listening-source",
      "sourcePlays": 1,
      "script": [
        {
          "speaker": "female",
          "text": {
            "zh-Hans": "我叫李安，是韩国人。现在我在北京学中文。我们班的老师是中国人，我的好朋友是美国人。",
            "zh-Hant": "我叫李安，是韓國人。現在我在北京學中文。我們班的老師是中國人，我的好朋友是美國人。"
          }
        }
      ],
      "sourceDurationSeconds": 10.176,
      "src": "assets/audio/c1a-m04.mp3",
      "durationSeconds": 10.728,
      "pcmSeconds": 10.676,
      "bytes": 86060,
      "sha256": "73d0c497297cee0fc57235d14c92d7fffca986214b27f591bb440023022cdafd"
    },
    {
      "id": "C1A-M05",
      "kind": "listening-source",
      "sourcePlays": 1,
      "script": [
        {
          "speaker": "male",
          "text": {
            "zh-Hans": "我是明华学校的学生。今天是星期一，我在学校门口等朋友。她是新同学，今天第一次来这里上课。",
            "zh-Hant": "我是明華學校的學生。今天是星期一，我在學校門口等朋友。她是新同學，今天第一次來這裏上課。"
          }
        }
      ],
      "sourceDurationSeconds": 9.984,
      "src": "assets/audio/c1a-m05.mp3",
      "durationSeconds": 10.536,
      "pcmSeconds": 10.484,
      "bytes": 84524,
      "sha256": "ba00accbf560d25183382cb5e07eec7467f9c0fe7cc7f883a9e89c42eee0be7c"
    },
    {
      "id": "C1A-M06",
      "kind": "listening-source",
      "sourcePlays": 1,
      "script": [
        {
          "speaker": "female",
          "text": {
            "zh-Hans": "上课要用铅笔。你有铅笔吗？",
            "zh-Hant": "上課要用鉛筆。你有鉛筆嗎？"
          }
        },
        {
          "speaker": "male",
          "text": {
            "zh-Hans": "我只有一支钢笔，没有铅笔。",
            "zh-Hant": "我只有一支鋼筆，沒有鉛筆。"
          }
        },
        {
          "speaker": "female",
          "text": {
            "zh-Hans": "你可以先用我的，我有两支铅笔。",
            "zh-Hant": "你可以先用我的，我有兩支鉛筆。"
          }
        }
      ],
      "sourceDurationSeconds": 11.62,
      "src": "assets/audio/c1a-m06.mp3",
      "durationSeconds": 12.168,
      "pcmSeconds": 12.12,
      "bytes": 97580,
      "sha256": "95781f85ada7797c0d9602f34590348177a5764edf93986105d7858d68db57e7"
    },
    {
      "id": "C1A-M07",
      "kind": "listening-source",
      "sourcePlays": 1,
      "script": [
        {
          "speaker": "male",
          "text": {
            "zh-Hans": "你的中文书能借我看一下吗？",
            "zh-Hant": "你的中文書能借我看一下嗎？"
          }
        },
        {
          "speaker": "female",
          "text": {
            "zh-Hans": "可以，书在桌子上。",
            "zh-Hant": "可以，書在桌子上。"
          }
        },
        {
          "speaker": "male",
          "text": {
            "zh-Hans": "谢谢。我的中文书在家里，英语书在书包里。",
            "zh-Hant": "謝謝。我的中文書在家裏，英語書在書包裏。"
          }
        }
      ],
      "sourceDurationSeconds": 12.028,
      "src": "assets/audio/c1a-m07.mp3",
      "durationSeconds": 12.576,
      "pcmSeconds": 12.528,
      "bytes": 100844,
      "sha256": "1e2eec65a5c1bc7032f2f913f44e37af9425f9ba3fa036b878bc8cdfe7127d6c"
    },
    {
      "id": "C1A-M08",
      "kind": "listening-source",
      "sourcePlays": 1,
      "script": [
        {
          "speaker": "female",
          "text": {
            "zh-Hans": "老师，今天在哪儿上课？",
            "zh-Hant": "老師，今天在哪兒上課？"
          }
        },
        {
          "speaker": "male",
          "text": {
            "zh-Hans": "在三楼的三零二教室，不是二楼。",
            "zh-Hant": "在三樓的三零二教室，不是二樓。"
          }
        },
        {
          "speaker": "female",
          "text": {
            "zh-Hans": "好的，我现在去三楼等同学。",
            "zh-Hant": "好的，我現在去三樓等同學。"
          }
        }
      ],
      "sourceDurationSeconds": 10.804,
      "src": "assets/audio/c1a-m08.mp3",
      "durationSeconds": 11.352,
      "pcmSeconds": 11.304,
      "bytes": 91052,
      "sha256": "47b35ff7b22673e9324709071ab945041e53d2a2304108afca7cf4e6537881d2"
    },
    {
      "id": "C1A-M09",
      "kind": "listening-source",
      "sourcePlays": 1,
      "script": [
        {
          "speaker": "male",
          "text": {
            "zh-Hans": "下课后你去哪儿？去食堂吃饭吗？",
            "zh-Hant": "下課後你去哪兒？去食堂喫飯嗎？"
          }
        },
        {
          "speaker": "female",
          "text": {
            "zh-Hans": "我先去图书馆借书，然后回家。今天我不在学校吃饭。",
            "zh-Hant": "我先去圖書館借書，然後回家。今天我不在學校喫飯。"
          }
        }
      ],
      "sourceDurationSeconds": 10.934,
      "src": "assets/audio/c1a-m09.mp3",
      "durationSeconds": 11.496,
      "pcmSeconds": 11.434,
      "bytes": 92204,
      "sha256": "d82c5fae5c95ac088324f5aebdc6237da9777bfe478a7d4f895b70ed8ff3f303"
    },
    {
      "id": "C1A-M10",
      "kind": "listening-source",
      "sourcePlays": 1,
      "script": [
        {
          "speaker": "female",
          "text": {
            "zh-Hans": "今天的中文课还是九点开始吗？",
            "zh-Hant": "今天的中文課還是九點開始嗎？"
          }
        },
        {
          "speaker": "male",
          "text": {
            "zh-Hans": "不是，今天九点半开始，十点半下课。",
            "zh-Hant": "不是，今天九點半開始，十點半下課。"
          }
        },
        {
          "speaker": "female",
          "text": {
            "zh-Hans": "好，那我九点二十到教室。",
            "zh-Hant": "好，那我九點二十到教室。"
          }
        }
      ],
      "sourceDurationSeconds": 11.956,
      "src": "assets/audio/c1a-m10.mp3",
      "durationSeconds": 12.504,
      "pcmSeconds": 12.456,
      "bytes": 100268,
      "sha256": "ffe987b1f9a8dfc901be1809d440720352afce6778e0abdfb0ae823f0dfec4bd"
    },
    {
      "id": "C1A-M11",
      "kind": "listening-source",
      "sourcePlays": 1,
      "script": [
        {
          "speaker": "male",
          "text": {
            "zh-Hans": "中午吃什么？你想吃面条吗？",
            "zh-Hant": "中午喫什麼？你想喫麪條嗎？"
          }
        },
        {
          "speaker": "female",
          "text": {
            "zh-Hans": "晚上我想吃面条。现在我想吃米饭和鸡蛋，不想吃肉。",
            "zh-Hant": "晚上我想喫麪條。現在我想喫米飯和雞蛋，不想喫肉。"
          }
        }
      ],
      "sourceDurationSeconds": 10.91,
      "src": "assets/audio/c1a-m11.mp3",
      "durationSeconds": 11.472,
      "pcmSeconds": 11.41,
      "bytes": 92012,
      "sha256": "0d33007d1c7c02be801d924f68cf981ee587dd387993dac0fe2d5224385cfc86"
    },
    {
      "id": "C1A-M12",
      "kind": "listening-source",
      "sourcePlays": 1,
      "script": [
        {
          "speaker": "female",
          "text": {
            "zh-Hans": "早上妈妈喝茶，爸爸喝咖啡。我不喝茶，也不喝咖啡。我每天喝一杯牛奶，然后去上学。",
            "zh-Hant": "早上媽媽喝茶，爸爸喝咖啡。我不喝茶，也不喝咖啡。我每天喝一杯牛奶，然後去上學。"
          }
        }
      ],
      "sourceDurationSeconds": 9.84,
      "src": "assets/audio/c1a-m12.mp3",
      "durationSeconds": 10.392,
      "pcmSeconds": 10.34,
      "bytes": 83372,
      "sha256": "bacadf9899a610dee290de227f156d24b8d59e6a3f13a2b159ef1410af2b2e6a"
    },
    {
      "id": "C1A-M13",
      "kind": "listening-source",
      "sourcePlays": 1,
      "script": [
        {
          "speaker": "female",
          "text": {
            "zh-Hans": "你要几个苹果？",
            "zh-Hant": "你要幾個蘋果？"
          }
        },
        {
          "speaker": "male",
          "text": {
            "zh-Hans": "我要四个苹果，再要两个香蕉。",
            "zh-Hant": "我要四個蘋果，再要兩個香蕉。"
          }
        },
        {
          "speaker": "female",
          "text": {
            "zh-Hans": "好的，四个苹果、两个香蕉，放在这个袋子里。",
            "zh-Hant": "好的，四個蘋果、兩個香蕉，放在這個袋子裏。"
          }
        }
      ],
      "sourceDurationSeconds": 11.236,
      "src": "assets/audio/c1a-m13.mp3",
      "durationSeconds": 11.784,
      "pcmSeconds": 11.736,
      "bytes": 94508,
      "sha256": "5fdbb5f6e3babd6675bc7192c6bfcb729e043cbbf1c36e7d7842bdaa12c57fff"
    },
    {
      "id": "C1A-M14",
      "kind": "listening-source",
      "sourcePlays": 1,
      "script": [
        {
          "speaker": "male",
          "text": {
            "zh-Hans": "这份午饭多少钱？",
            "zh-Hant": "這份午飯多少錢？"
          }
        },
        {
          "speaker": "female",
          "text": {
            "zh-Hans": "十二块。",
            "zh-Hant": "十二塊。"
          }
        },
        {
          "speaker": "male",
          "text": {
            "zh-Hans": "给你二十块。",
            "zh-Hant": "給你二十塊。"
          }
        },
        {
          "speaker": "female",
          "text": {
            "zh-Hans": "谢谢，找你八块。你的午饭在桌子上。",
            "zh-Hant": "謝謝，找你八塊。你的午飯在桌子上。"
          }
        }
      ],
      "sourceDurationSeconds": 11.898,
      "src": "assets/audio/c1a-m14.mp3",
      "durationSeconds": 12.456,
      "pcmSeconds": 12.398,
      "bytes": 99884,
      "sha256": "de646b69b19f0a7b7f08fd5eb6a41563c813b715a9db8fbb44924e9f65271455"
    },
    {
      "id": "C1A-M15",
      "kind": "listening-source",
      "sourcePlays": 1,
      "script": [
        {
          "speaker": "female",
          "text": {
            "zh-Hans": "你喜欢这件红色的衣服吗？",
            "zh-Hant": "你喜歡這件紅色的衣服嗎？"
          }
        },
        {
          "speaker": "male",
          "text": {
            "zh-Hans": "我喜欢蓝色的，不喜欢红色的。蓝色这件也不大，我就买这件吧。",
            "zh-Hant": "我喜歡藍色的，不喜歡紅色的。藍色這件也不大，我就買這件吧。"
          }
        }
      ],
      "sourceDurationSeconds": 9.926,
      "src": "assets/audio/c1a-m15.mp3",
      "durationSeconds": 10.488,
      "pcmSeconds": 10.426,
      "bytes": 84140,
      "sha256": "d49db9faa720ed3b602c2c158a1948ae2cc53bb185803c3e579b8a7f4fb701c5"
    },
    {
      "id": "C1A-M16",
      "kind": "listening-source",
      "sourcePlays": 1,
      "script": [
        {
          "speaker": "male",
          "text": {
            "zh-Hans": "星期六一起去看电影，好吗？",
            "zh-Hant": "星期六一起去看電影，好嗎？"
          }
        },
        {
          "speaker": "female",
          "text": {
            "zh-Hans": "星期六我要上课。星期天下午我有时间。",
            "zh-Hant": "星期六我要上課。星期天下午我有時間。"
          }
        },
        {
          "speaker": "male",
          "text": {
            "zh-Hans": "好，我们星期天下午见。",
            "zh-Hant": "好，我們星期天下午見。"
          }
        }
      ],
      "sourceDurationSeconds": 12.412,
      "src": "assets/audio/c1a-m16.mp3",
      "durationSeconds": 12.96,
      "pcmSeconds": 12.912,
      "bytes": 103916,
      "sha256": "16fc26724206bfff3a32b0c3e165bc923b0897b15926a13be300529733de8c72"
    },
    {
      "id": "C1A-M17",
      "kind": "listening-source",
      "sourcePlays": 1,
      "script": [
        {
          "speaker": "female",
          "text": {
            "zh-Hans": "你早上几点出门？",
            "zh-Hant": "你早上幾點出門？"
          }
        },
        {
          "speaker": "male",
          "text": {
            "zh-Hans": "我六点半起床，七点吃早饭，七点半出门。学校很近，八点以前就能到。",
            "zh-Hant": "我六點半起牀，七點喫早飯，七點半出門。學校很近，八點以前就能到。"
          }
        }
      ],
      "sourceDurationSeconds": 10.574,
      "src": "assets/audio/c1a-m17.mp3",
      "durationSeconds": 11.136,
      "pcmSeconds": 11.074,
      "bytes": 89324,
      "sha256": "58717873d4b6010ce8b39d7be1b925ebca8889734a74470cf32f02912dd0b269"
    },
    {
      "id": "C1A-M18",
      "kind": "listening-source",
      "sourcePlays": 1,
      "script": [
        {
          "speaker": "male",
          "text": {
            "zh-Hans": "今天外面很冷，你穿这件衣服去学校吗？",
            "zh-Hant": "今天外面很冷，你穿這件衣服去學校嗎？"
          }
        },
        {
          "speaker": "female",
          "text": {
            "zh-Hans": "不穿这件薄的。我穿那件厚外套。",
            "zh-Hant": "不穿這件薄的。我穿那件厚外套。"
          }
        },
        {
          "speaker": "male",
          "text": {
            "zh-Hans": "好，别忘了你的书包。",
            "zh-Hant": "好，別忘了你的書包。"
          }
        }
      ],
      "sourceDurationSeconds": 12.244,
      "src": "assets/audio/c1a-m18.mp3",
      "durationSeconds": 12.792,
      "pcmSeconds": 12.744,
      "bytes": 102572,
      "sha256": "c7d51b8a47622d772e3f55ed1f942e49d85ce6fad6c075c1889854c683e95b08"
    },
    {
      "id": "C1A-M19",
      "kind": "listening-source",
      "sourcePlays": 1,
      "script": [
        {
          "speaker": "female",
          "text": {
            "zh-Hans": "下午一起去打篮球吧？",
            "zh-Hant": "下午一起去打籃球吧？"
          }
        },
        {
          "speaker": "male",
          "text": {
            "zh-Hans": "我不太会打篮球。我想去公园走走，你去吗？",
            "zh-Hant": "我不太會打籃球。我想去公園走走，你去嗎？"
          }
        },
        {
          "speaker": "female",
          "text": {
            "zh-Hans": "好，我也想去公园。",
            "zh-Hant": "好，我也想去公園。"
          }
        }
      ],
      "sourceDurationSeconds": 11.236,
      "src": "assets/audio/c1a-m19.mp3",
      "durationSeconds": 11.784,
      "pcmSeconds": 11.736,
