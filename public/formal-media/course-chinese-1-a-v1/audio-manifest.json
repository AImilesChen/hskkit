    {
      "id": "S1-1",
      "kind": "oral-prompt",
      "sourcePlays": 2,
      "singlePlayPcmSeconds": 4.68,
      "repeatGapSeconds": 1.5,
      "singlePlayPcmSha256": "bd33f0a46e58e7f30a2f4ed247df26bf8bdced6361ef67de3b0efd88c0d74490",
