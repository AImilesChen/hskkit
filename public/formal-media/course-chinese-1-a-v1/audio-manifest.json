    {
      "id": "C1A-M01",
      "kind": "listening-source",
      "sourcePlays": 1,
      "script": [
        {
          "speaker": "male",
          "text": {
            "zh-Hans": "大家好，我叫王明。我今年十七岁，在明华学校上学。我哥哥十九岁，他在上海学习。",
            "zh-Hant": "大家好，我叫王明。我今年十七歲，在明華學校上學。我哥哥十九歲，他在上海學習。"
          }
        }
      ],
      "sourceDurationSeconds": 9.624,
      "src": "assets/audio/c1a-m01.mp3",
      "durationSeconds": 10.176,
      "pcmSeconds": 10.124,
