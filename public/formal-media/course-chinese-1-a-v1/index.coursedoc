<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="robots" content="noindex,nofollow"><base href="/api/v1/course-tests/chinese-1/a/file/"><title>Chinese 1 · Paper A · HSKKit</title><link rel="stylesheet" href="workspace.css"></head><body><header class="bar"><a class="brand" href="/">HSKKit</a><a href="/chinese-course-tests">← Chinese 1 papers</a></header><div id="live" class="live" aria-live="polite"></div><div id="clockbar" class="clockbar" hidden><strong id="clock" role="timer"></strong><span id="oral-clock" role="timer"></span></div><div id="audio-dock" class="audio-dock" hidden><strong id="audio-label"></strong><audio id="listening-player" controls preload="metadata"></audio><p id="audio-error" role="alert" hidden>Audio could not load. Retry or open Audio review.</p></div><main id="app"></main><audio id="prompt-player" preload="none"></audio><footer><p>Independent HSKKit course review. Writing and speaking need manual review. Not an official school, HSK or ACTFL assessment.</p><a href="listening.html">Audio review</a> · <a href="teacher.html">Answer guide</a></footer><script id="paper-data" type="application/json">{"id": "course-chinese-1-a-v1", "product": "HSKKit Chinese 1 Course Review", "paperCode": "A", "version": "content-draft-v1", "authoredOn": "2026-11-09", "status": "content_complete_pending_audio_listening_and_teacher_pilot", "officialExam": false, "purpose": "Review only the published HSKKit Chinese 1 course scope; no official school credit, ACTFL/HSK equivalence or placement certification.", "blueprint": {"id": "course-chinese-1-a-blueprint-v1", "source": "docs/course-level-stage1-20261109/chinese-1-blueprint.json", "sha256": "ac1b916e507d606ed48b308bf1f888f56d60d50dbe3437aa16984a32108d3856"}, "provenance": {"original": true, "aiAssisted": true, "competitorQuestionsCopied": false, "relabelledHskQuestions": false, "humanListeningAcceptance": false, "teacherReview": false, "learnerPilot": false, "userAcceptance": false, "traditionalScript": "OpenCC s2t; author comparison only, pending independent editorial review"}, "order": ["listening", "reading", "writing", "speaking"], "sections": [{"id": "listening", "seconds": 900, "objectiveItems": 20, "groups": 4, "itemsPerGroup": 5, "sourcePlays": 2}, {"id": "reading", "seconds": 1200, "objectiveItems": 20, "groups": 4, "itemsPerGroup": 5}, {"id": "writing", "seconds": 900, "manualTasks": 2, "sharedClock": true}, {"id": "speaking", "seconds": 600, "manualTasks": 2}], "counts": {"listening": 20, "reading": 20, "writing": 2, "speaking": 2, "speakingRecordings": 5, "topLevelTasks": 44}, "scoring": {"listeningMax": 20, "readingMax": 20, "pointsPerObjectiveItem": 1, "incorrectOrUnansweredPoints": 0, "manualTaskMax": 8, "combinedScore": null, "passCutoff": null, "officialConversion": null, "unsubmittedManual": "unsubmitted", "technicalFailureManual": "needs_rerecording"}, "materials": [{"id": "C1A-M01", "title": "A new classmate", "section": "listening", "kind": "short-audio", "original": true, "script": [{"speaker": "male", "text": {"zh-Hans": "大家好，我叫王明。我今年十七岁，在明华学校上学。我哥哥十九岁，他在上海学习。", "zh-Hant": "大家好，我叫王明。我今年十七歲，在明華學校上學。我哥哥十九歲，他在上海學習。"}}]}, {"id": "C1A-M02", "title": "Jobs in the family", "section": "listening", "kind": "short-audio", "original": true, "script": [{"speaker": "female", "text": {"zh-Hans": "我家有四个人。爸爸是老师，妈妈是医生。我和弟弟都是学生。妈妈每天早上八点去医院。", "zh-Hant": "我家有四個人。爸爸是老師，媽媽是醫生。我和弟弟都是學生。媽媽每天早上八點去醫院。"}}]}, {"id": "C1A-M03", "title": "Two younger relatives", "section": "listening", "kind": "short-audio", "original": true, "script": [{"speaker": "male", "text": {"zh-Hans": "这是我妹妹的照片，她今年十五岁，喜欢唱歌。我弟弟只有九岁，喜欢画画。我每天和妹妹一起上学。", "zh-Hant": "這是我妹妹的照片，她今年十五歲，喜歡唱歌。我弟弟只有九歲，喜歡畫畫。我每天和妹妹一起上學。"}}]}, {"id": "C1A-M04", "title": "Where a classmate is from", "section": "listening", "kind": "short-audio", "original": true, "script": [{"speaker": "female", "text": {"zh-Hans": "我叫李安，是韩国人。现在我在北京学中文。我们班的老师是中国人，我的好朋友是美国人。", "zh-Hant": "我叫李安，是韓國人。現在我在北京學中文。我們班的老師是中國人，我的好朋友是美國人。"}}]}, {"id": "C1A-M05", "title": "Meeting at school", "section": "listening", "kind": "short-audio", "original": true, "script": [{"speaker": "male", "text": {"zh-Hans": "我是明华学校的学生。今天是星期一，我在学校门口等朋友。她是新同学，今天第一次来这里上课。", "zh-Hant": "我是明華學校的學生。今天是星期一，我在學校門口等朋友。她是新同學，今天第一次來這裏上課。"}}]}, {"id": "C1A-M06", "title": "A pencil for class", "section": "listening", "kind": "short-audio", "original": true, "script": [{"speaker": "female", "text": {"zh-Hans": "上课要用铅笔。你有铅笔吗？", "zh-Hant": "上課要用鉛筆。你有鉛筆嗎？"}}, {"speaker": "male", "text": {"zh-Hans": "我只有一支钢笔，没有铅笔。", "zh-Hant": "我只有一支鋼筆，沒有鉛筆。"}}, {"speaker": "female", "text": {"zh-Hans": "你可以先用我的，我有两支铅笔。", "zh-Hant": "你可以先用我的，我有兩支鉛筆。"}}]}, {"id": "C1A-M07", "title": "Borrowing a book", "section": "listening", "kind": "short-audio", "original": true, "script": [{"speaker": "male", "text": {"zh-Hans": "你的中文书能借我看一下吗？", "zh-Hant": "你的中文書能借我看一下嗎？"}}, {"speaker": "female", "text": {"zh-Hans": "可以，书在桌子上。", "zh-Hant": "可以，書在桌子上。"}}, {"speaker": "male", "text": {"zh-Hans": "谢谢。我的中文书在家里，英语书在书包里。", "zh-Hant": "謝謝。我的中文書在家裏，英語書在書包裏。"}}]}, {"id": "C1A-M08", "title": "Finding a classroom", "section": "listening", "kind": "short-audio", "original": true, "script": [{"speaker": "female", "text": {"zh-Hans": "老师，今天在哪儿上课？", "zh-Hant": "老師，今天在哪兒上課？"}}, {"speaker": "male", "text": {"zh-Hans": "在三楼的三零二教室，不是二楼。", "zh-Hant": "在三樓的三零二教室，不是二樓。"}}, {"speaker": "female", "text": {"zh-Hans": "好的，我现在去三楼等同学。", "zh-Hant": "好的，我現在去三樓等同學。"}}]}, {"id": "C1A-M09", "title": "After the lesson", "section": "listening", "kind": "short-audio", "original": true, "script": [{"speaker": "male", "text": {"zh-Hans": "下课后你去哪儿？去食堂吃饭吗？", "zh-Hant": "下課後你去哪兒？去食堂喫飯嗎？"}}, {"speaker": "female", "text": {"zh-Hans": "我先去图书馆借书，然后回家。今天我不在学校吃饭。", "zh-Hant": "我先去圖書館借書，然後回家。今天我不在學校喫飯。"}}]}, {"id": "C1A-M10", "title": "Today’s starting time", "section": "listening", "kind": "short-audio", "original": true, "script": [{"speaker": "female", "text": {"zh-Hans": "今天的中文课还是九点开始吗？", "zh-Hant": "今天的中文課還是九點開始嗎？"}}, {"speaker": "male", "text": {"zh-Hans": "不是，今天九点半开始，十点半下课。", "zh-Hant": "不是，今天九點半開始，十點半下課。"}}, {"speaker": "female", "text": {"zh-Hans": "好，那我九点二十到教室。", "zh-Hant": "好，那我九點二十到教室。"}}]}, {"id": "C1A-M11", "title": "Lunch and dinner", "section": "listening", "kind": "short-audio", "original": true, "script": [{"speaker": "male", "text": {"zh-Hans": "中午吃什么？你想吃面条吗？", "zh-Hant": "中午喫什麼？你想喫麪條嗎？"}}, {"speaker": "female", "text": {"zh-Hans": "晚上我想吃面条。现在我想吃米饭和鸡蛋，不想吃肉。", "zh-Hant": "晚上我想喫麪條。現在我想喫米飯和雞蛋，不想喫肉。"}}]}, {"id": "C1A-M12", "title": "Three breakfast drinks", "section": "listening", "kind": "short-audio", "original": true, "script": [{"speaker": "female", "text": {"zh-Hans": "早上妈妈喝茶，爸爸喝咖啡。我不喝茶，也不喝咖啡。我每天喝一杯牛奶，然后去上学。", "zh-Hant": "早上媽媽喝茶，爸爸喝咖啡。我不喝茶，也不喝咖啡。我每天喝一杯牛奶，然後去上學。"}}]}, {"id": "C1A-M13", "title": "Buying fruit", "section": "listening", "kind": "short-audio", "original": true, "script": [{"speaker": "female", "text": {"zh-Hans": "你要几个苹果？", "zh-Hant": "你要幾個蘋果？"}}, {"speaker": "male", "text": {"zh-Hans": "我要四个苹果，再要两个香蕉。", "zh-Hant": "我要四個蘋果，再要兩個香蕉。"}}, {"speaker": "female", "text": {"zh-Hans": "好的，四个苹果、两个香蕉，放在这个袋子里。", "zh-Hant": "好的，四個蘋果、兩個香蕉，放在這個袋子裏。"}}]}, {"id": "C1A-M14", "title": "The price of lunch", "section": "listening", "kind": "short-audio", "original": true, "script": [{"speaker": "male", "text": {"zh-Hans": "这份午饭多少钱？", "zh-Hant": "這份午飯多少錢？"}}, {"speaker": "female", "text": {"zh-Hans": "十二块。", "zh-Hant": "十二塊。"}}, {"speaker": "male", "text": {"zh-Hans": "给你二十块。", "zh-Hant": "給你二十塊。"}}, {"speaker": "female", "text": {"zh-Hans": "谢谢，找你八块。你的午饭在桌子上。", "zh-Hant": "謝謝，找你八塊。你的午飯在桌子上。"}}]}, {"id": "C1A-M15", "title": "Choosing a shirt", "section": "listening", "kind": "short-audio", "original": true, "script": [{"speaker": "female", "text": {"zh-Hans": "你喜欢这件红色的衣服吗？", "zh-Hant": "你喜歡這件紅色的衣服嗎？"}}, {"speaker": "male", "text": {"zh-Hans": "我喜欢蓝色的，不喜欢红色的。蓝色这件也不大，我就买这件吧。", "zh-Hant": "我喜歡藍色的，不喜歡紅色的。藍色這件也不大，我就買這件吧。"}}]}, {"id": "C1A-M16", "title": "Choosing a day", "section": "listening", "kind": "short-audio", "original": true, "script": [{"speaker": "male", "text": {"zh-Hans": "星期六一起去看电影，好吗？", "zh-Hant": "星期六一起去看電影，好嗎？"}}, {"speaker": "female", "text": {"zh-Hans": "星期六我要上课。星期天下午我有时间。", "zh-Hant": "星期六我要上課。星期天下午我有時間。"}}, {"speaker": "male", "text": {"zh-Hans": "好，我们星期天下午见。", "zh-Hant": "好，我們星期天下午見。"}}]}, {"id": "C1A-M17", "title": "Leaving after breakfast", "section": "listening", "kind": "short-audio", "original": true, "script": [{"speaker": "female", "text": {"zh-Hans": "你早上几点出门？", "zh-Hant": "你早上幾點出門？"}}, {"speaker": "male", "text": {"zh-Hans": "我六点半起床，七点吃早饭，七点半出门。学校很近，八点以前就能到。", "zh-Hant": "我六點半起牀，七點喫早飯，七點半出門。學校很近，八點以前就能到。"}}]}, {"id": "C1A-M18", "title": "A cold morning", "section": "listening", "kind": "short-audio", "original": true, "script": [{"speaker": "male", "text": {"zh-Hans": "今天外面很冷，你穿这件衣服去学校吗？", "zh-Hant": "今天外面很冷，你穿這件衣服去學校嗎？"}}, {"speaker": "female", "text": {"zh-Hans": "不穿这件薄的。我穿那件厚外套。", "zh-Hant": "不穿這件薄的。我穿那件厚外套。"}}, {"speaker": "male", "text": {"zh-Hans": "好，别忘了你的书包。", "zh-Hant": "好，別忘了你的書包。"}}]}, {"id": "C1A-M19", "title": "A shared activity", "section": "listening", "kind": "short-audio", "original": true, "script": [{"speaker": "female", "text": {"zh-Hans": "下午一起去打篮球吧？", "zh-Hant": "下午一起去打籃球吧？"}}, {"speaker": "male", "text": {"zh-Hans": "我不太会打篮球。我想去公园走走，你去吗？", "zh-Hant": "我不太會打籃球。我想去公園走走，你去嗎？"}}, {"speaker": "female", "text": {"zh-Hans": "好，我也想去公园。", "zh-Hant": "好，我也想去公園。"}}]}, {"id": "C1A-M20", "title": "A free afternoon", "section": "listening", "kind": "short-audio", "original": true, "script": [{"speaker": "male", "text": {"zh-Hans": "周末你喜欢做什么？", "zh-Hant": "週末你喜歡做什麼？"}}, {"speaker": "female", "text": {"zh-Hans": "我喜欢画画，也喜欢听音乐。这周六下午我要在家画画。星期天再去听音乐。", "zh-Hant": "我喜歡畫畫，也喜歡聽音樂。這週六下午我要在家畫畫。星期天再去聽音樂。"}}]}, {"id": "C1A-M21", "title": "Classmate profile", "section": "reading", "kind": "text-card", "original": true, "text": {"zh-Hans": "新同学：金娜\n年龄：十六岁\n来自：韩国\n学校：明华学校\n家人：爸爸、妈妈、弟弟\n爱好：听音乐", "zh-Hant": "新同學：金娜\n年齡：十六歲\n來自：韓國\n學校：明華學校\n家人：爸爸、媽媽、弟弟\n愛好：聽音樂"}}, {"id": "C1A-M22", "title": "A message about family", "section": "reading", "kind": "text-card", "original": true, "text": {"zh-Hans": "小雨，你好！我爸爸在学校教中文，妈妈在医院工作，是医生。我哥哥在大学读书。我还在中学上学。\n王宁", "zh-Hant": "小雨，你好！我爸爸在學校教中文，媽媽在醫院工作，是醫生。我哥哥在大學讀書。我還在中學上學。\n王寧"}}, {"id": "C1A-M23", "title": "Photo note", "section": "reading", "kind": "text-card", "original": true, "text": {"zh-Hans": "照片上是我和妹妹。我今年十六岁，妹妹十二岁。她喜欢红色，我喜欢蓝色。我们星期天常常一起去公园。", "zh-Hant": "照片上是我和妹妹。我今年十六歲，妹妹十二歲。她喜歡紅色，我喜歡藍色。我們星期天常常一起去公園。"}}, {"id": "C1A-M24", "title": "Who lives with whom", "section": "reading", "kind": "text-card", "original": true, "text": {"zh-Hans": "你好，我是安娜。我现在和爸爸妈妈住在北京。哥哥在上海工作，不和我们一起住。我们星期日晚上给哥哥打电话。", "zh-Hant": "你好，我是安娜。我現在和爸爸媽媽住在北京。哥哥在上海工作，不和我們一起住。我們星期日晚上給哥哥打電話。"}}, {"id": "C1A-M25", "title": "A welcome note", "section": "reading", "kind": "text-card", "original": true, "text": {"zh-Hans": "新同学林明：\n欢迎来二班！我们在三楼302教室上课。请带中文书。今天九点上课，老师姓王。\n二班班长 小李", "zh-Hant": "新同學林明：\n歡迎來二班！我們在三樓302教室上課。請帶中文書。今天九點上課，老師姓王。\n二班班長 小李"}}, {"id": "C1A-M26", "title": "What to bring tomorrow", "section": "reading", "kind": "text-card", "original": true, "text": {"zh-Hans": "同学们：\n明天有画画课，请带铅笔和彩色笔。老师有纸，大家不用带纸。书包请放在桌子下面。\n刘老师", "zh-Hant": "同學們：\n明天有畫畫課，請帶鉛筆和彩色筆。老師有紙，大家不用帶紙。書包請放在桌子下面。\n劉老師"}}, {"id": "C1A-M27", "title": "Morning timetable", "section": "reading", "kind": "text-card", "original": true, "text": {"zh-Hans": "星期二上午课表\n中文：9:00—9:40\n英语：10:00—10:40\n数学：11:00—11:40\n请在上课前到教室。", "zh-Hant": "星期二上午課表\n中文：9:00—9:40\n英語：10:00—10:40\n數學：11:00—11:40\n請在上課前到教室。"}}, {"id": "C1A-M28", "title": "Where to return a book", "section": "reading", "kind": "text-card", "original": true, "text": {"zh-Hans": "小陈：\n你的书我看完了。今天下课后我把书放在王老师的桌子上。请你去办公室拿，不用来我们教室。\n小周", "zh-Hant": "小陳：\n你的書我看完了。今天下課後我把書放在王老師的桌子上。請你去辦公室拿，不用來我們教室。\n小周"}}, {"id": "C1A-M29", "title": "A book left at home", "section": "reading", "kind": "text-card", "original": true, "text": {"zh-Hans": "老师：\n我的中文书在家里，英语书在书包里。今天能借您的中文书用一下吗？下课后我就还给您。\n李小文", "zh-Hant": "老師：\n我的中文書在家裏，英語書在書包裏。今天能借您的中文書用一下嗎？下課後我就還給您。\n李小文"}}, {"id": "C1A-M30", "title": "Two weekly activities", "section": "reading", "kind": "text-card", "original": true, "text": {"zh-Hans": "小林的一周\n星期一下午：在学校打篮球\n星期三下午：在图书馆看书\n星期六上午：和妈妈买水果\n星期天：在家休息", "zh-Hant": "小林的一週\n星期一下午：在學校打籃球\n星期三下午：在圖書館看書\n星期六上午：和媽媽買水果\n星期天：在家休息"}}, {"id": "C1A-M31", "title": "Lunch menu", "section": "reading", "kind": "text-card", "original": true, "text": {"zh-Hans": "学校食堂菜单\n米饭：四元\n面条：六元\n鸡蛋：两元\n牛奶：五元\n中午十一点开始卖，下午一点结束。", "zh-Hant": "學校食堂菜單\n米飯：四元\n麪條：六元\n雞蛋：兩元\n牛奶：五元\n中午十一點開始賣，下午一點結束。"}}, {"id": "C1A-M32", "title": "An order message", "section": "reading", "kind": "text-card", "original": true, "text": {"zh-Hans": "妈妈：\n今天午饭我想吃米饭和鸡蛋，不要肉。妹妹想吃面条。请再给我买一瓶水，谢谢！我十二点回家。\n小安", "zh-Hant": "媽媽：\n今天午飯我想喫米飯和雞蛋，不要肉。妹妹想喫麪條。請再給我買一瓶水，謝謝！我十二點回家。\n小安"}}, {"id": "C1A-M33", "title": "Fruit-shopping note", "section": "reading", "kind": "text-card", "original": true, "text": {"zh-Hans": "爸爸：\n家里还有三个苹果，今天不用买苹果。请买两个香蕉和四个橙子。香蕉给妹妹，橙子我们一起吃。\n小美", "zh-Hant": "爸爸：\n家裏還有三個蘋果，今天不用買蘋果。請買兩個香蕉和四個橙子。香蕉給妹妹，橙子我們一起喫。\n小美"}}, {"id": "C1A-M34", "title": "A drink request", "section": "reading", "kind": "text-card", "original": true, "text": {"zh-Hans": "小李：\n今天有点儿冷，我不想喝冷水。请给我一杯热茶，不加糖。你的咖啡在桌子上。我在教室等你。\n小文", "zh-Hant": "小李：\n今天有點兒冷，我不想喝冷水。請給我一杯熱茶，不加糖。你的咖啡在桌子上。我在教室等你。\n小文"}}, {"id": "C1A-M35", "title": "Choosing clothes", "section": "reading", "kind": "text-card", "original": true, "text": {"zh-Hans": "小青：\n商店里有蓝色和白色的衬衫。我喜欢蓝色的，要小号。白色那件太大了，我不买。请你帮我看看蓝色小号多少钱。", "zh-Hant": "小青：\n商店裏有藍色和白色的襯衫。我喜歡藍色的，要小號。白色那件太大了，我不買。請你幫我看看藍色小號多少錢。"}}, {"id": "C1A-M36", "title": "Changing the day", "section": "reading", "kind": "text-card", "original": true, "text": {"zh-Hans": "小白：周六上午来我家，好吗？\n小林：周六我有课。周日上午九点可以吗？\n小白：可以，我九点在家等你。", "zh-Hant": "小白：週六上午來我家，好嗎？\n小林：週六我有課。週日上午九點可以嗎？\n小白：可以，我九點在家等你。"}}, {"id": "C1A-M37", "title": "School-day morning", "section": "reading", "kind": "text-card", "original": true, "text": {"zh-Hans": "我的早上\n六点起床，六点半吃早饭，七点坐公共汽车去学校。八点开始上课。爸爸七点半出门去工作。", "zh-Hant": "我的早上\n六點起牀，六點半喫早飯，七點坐公共汽車去學校。八點開始上課。爸爸七點半出門去工作。"}}, {"id": "C1A-M38", "title": "A note before going out", "section": "reading", "kind": "text-card", "original": true, "text": {"zh-Hans": "小雨：\n今天很热。去公园时请带帽子和水，不用带厚外套。你的蓝帽子在门口，白帽子在学校。\n妈妈", "zh-Hant": "小雨：\n今天很熱。去公園時請帶帽子和水，不用帶厚外套。你的藍帽子在門口，白帽子在學校。\n媽媽"}}, {"id": "C1A-M39", "title": "A weekend invitation", "section": "reading", "kind": "text-card", "original": true, "text": {"zh-Hans": "小周：周日下午一起去看电影吗？\n小陈：好啊！我上午要打篮球，下午有空。\n小周：那我们两点在电影院门口见。", "zh-Hant": "小周：週日下午一起去看電影嗎？\n小陳：好啊！我上午要打籃球，下午有空。\n小周：那我們兩點在電影院門口見。"}}, {"id": "C1A-M40", "title": "Choosing a club", "section": "reading", "kind": "text-card", "original": true, "text": {"zh-Hans": "学校活动\n画画：星期二下午，王老师教。\n唱歌：星期四下午，刘老师教。\n小红喜欢画画，不喜欢唱歌。她周二下午有空。", "zh-Hant": "學校活動\n畫畫：星期二下午，王老師教。\n唱歌：星期四下午，劉老師教。\n小紅喜歡畫畫，不喜歡唱歌。她週二下午有空。"}}], "questions": [{"id": "course-zh1-a-q01", "number": 1, "section": "listening", "group": "L1", "theme": "identity", "materialId": "C1A-M01", "target": "Identify the age of the speaker rather than a relative.", "promptEn": "How old is Wang Ming?", "options": {"A": {"zh-Hans": "十六岁", "zh-Hant": "十六歲"}, "B": {"zh-Hans": "十七岁", "zh-Hant": "十七歲"}, "C": {"zh-Hans": "十九岁", "zh-Hant": "十九歲"}}, "correctAnswer": "B", "evidence": {"materialId": "C1A-M01", "quote": {"zh-Hans": "我今年十七岁", "zh-Hant": "我今年十七歲"}}, "explanation": {"en": "Wang Ming explicitly says he is seventeen.", "zh": "王明说自己今年十七岁。"}, "distractors": {"A": {"en": "Sixteen is not the age given.", "zh": "稿件没有说王明十六岁。"}, "C": {"en": "Nineteen is his older brother’s age.", "zh": "十九岁是哥哥的年龄。"}}, "reviewStatus": "author_self_checked_pending_teacher_and_user_review"}, {"id": "course-zh1-a-q02", "number": 2, "section": "listening", "group": "L1", "theme": "identity", "materialId": "C1A-M02", "target": "Identify a family member’s occupation.", "promptEn": "What does the speaker’s mother do?", "options": {"A": {"zh-Hans": "医生", "zh-Hant": "醫生"}, "B": {"zh-Hans": "老师", "zh-Hant": "老師"}, "C": {"zh-Hans": "学生", "zh-Hant": "學生"}}, "correctAnswer": "A", "evidence": {"materialId": "C1A-M02", "quote": {"zh-Hans": "妈妈是医生", "zh-Hant": "媽媽是醫生"}}, "explanation": {"en": "The mother is identified as a doctor.", "zh": "妈妈的工作是医生。"}, "distractors": {"B": {"en": "The father, not the mother, is a teacher.", "zh": "老师是爸爸的工作。"}, "C": {"en": "The speaker and younger brother are students.", "zh": "学生指说话者和弟弟。"}}, "reviewStatus": "author_self_checked_pending_teacher_and_user_review"}, {"id": "course-zh1-a-q03", "number": 3, "section": "listening", "group": "L1", "theme": "identity", "materialId": "C1A-M03", "target": "Match an age to a family relationship.", "promptEn": "Who is fifteen years old?", "options": {"A": {"zh-Hans": "弟弟", "zh-Hant": "弟弟"}, "B": {"zh-Hans": "哥哥", "zh-Hant": "哥哥"}, "C": {"zh-Hans": "妹妹", "zh-Hant": "妹妹"}}, "correctAnswer": "C", "evidence": {"materialId": "C1A-M03", "quote": {"zh-Hans": "我妹妹的照片，她今年十五岁", "zh-Hant": "我妹妹的照片，她今年十五歲"}}, "explanation": {"en": "The younger sister is explicitly fifteen.", "zh": "说话者明确说妹妹十五岁。"}, "distractors": {"A": {"en": "The younger brother is nine.", "zh": "弟弟九岁，不是十五岁。"}, "B": {"en": "No older brother is described.", "zh": "材料没有介绍哥哥。"}}, "reviewStatus": "author_self_checked_pending_teacher_and_user_review"}, {"id": "course-zh1-a-q04", "number": 4, "section": "listening", "group": "L1", "theme": "identity", "materialId": "C1A-M04", "target": "Distinguish the speaker’s nationality from others’ nationalities.", "promptEn": "Where is Li An from?", "options": {"A": {"zh-Hans": "中国", "zh-Hant": "中國"}, "B": {"zh-Hans": "韩国", "zh-Hant": "韓國"}, "C": {"zh-Hans": "美国", "zh-Hant": "美國"}}, "correctAnswer": "B", "evidence": {"materialId": "C1A-M04", "quote": {"zh-Hans": "我叫李安，是韩国人", "zh-Hant": "我叫李安，是韓國人"}}, "explanation": {"en": "Li An introduces herself as Korean.", "zh": "李安说自己是韩国人。"}, "distractors": {"A": {"en": "The teacher is Chinese; Li An is not described that way.", "zh": "中国人指老师。"}, "C": {"en": "Her friend, rather than Li An, is American.", "zh": "美国人指她的好朋友。"}}, "reviewStatus": "author_self_checked_pending_teacher_and_user_review"}, {"id": "course-zh1-a-q05", "number": 5, "section": "listening", "group": "L1", "theme": "school", "materialId": "C1A-M05", "target": "Locate a familiar school meeting point.", "promptEn": "Where is the speaker waiting?", "options": {"A": {"zh-Hans": "家门口", "zh-Hant": "家門口"}, "B": {"zh-Hans": "商店门口", "zh-Hant": "商店門口"}, "C": {"zh-Hans": "学校门口", "zh-Hant": "學校門口"}}, "correctAnswer": "C", "evidence": {"materialId": "C1A-M05", "quote": {"zh-Hans": "我在学校门口等朋友", "zh-Hant": "我在學校門口等朋友"}}, "explanation": {"en": "He says he is waiting at the school entrance.", "zh": "他明确说在学校门口等朋友。"}, "distractors": {"A": {"en": "The speaker is not waiting at home.", "zh": "说话者没有在家门口等人。"}, "B": {"en": "No shop is mentioned.", "zh": "材料没有提到商店。"}}, "reviewStatus": "author_self_checked_pending_teacher_and_user_review"}, {"id": "course-zh1-a-q06", "number": 6, "section": "listening", "group": "L2", "theme": "school", "materialId": "C1A-M06", "target": "Identify a missing classroom item.", "promptEn": "What does the boy need for class?", "options": {"A": {"zh-Hans": "铅笔", "zh-Hant": "鉛筆"}, "B": {"zh-Hans": "钢笔", "zh-Hant": "鋼筆"}, "C": {"zh-Hans": "尺子", "zh-Hant": "尺子"}}, "correctAnswer": "A", "evidence": {"materialId": "C1A-M06", "quote": {"zh-Hans": "上课要用铅笔", "zh-Hant": "上課要用鉛筆"}}, "explanation": {"en": "The class requires a pencil, and he does not have one.", "zh": "上课要用铅笔，男生没有。"}, "distractors": {"B": {"en": "He already has a pen; it is not the requested item.", "zh": "男生已有钢笔，但课堂需要铅笔。"}, "C": {"en": "A ruler is not mentioned.", "zh": "材料没有提到尺子。"}}, "reviewStatus": "author_self_checked_pending_teacher_and_user_review"}, {"id": "course-zh1-a-q07", "number": 7, "section": "listening", "group": "L2", "theme": "school", "materialId": "C1A-M07", "target": "Identify the book being requested.", "promptEn": "Which book does the boy want to borrow?", "options": {"A": {"zh-Hans": "英语书", "zh-Hant": "英語書"}, "B": {"zh-Hans": "数学书", "zh-Hant": "數學書"}, "C": {"zh-Hans": "中文书", "zh-Hant": "中文書"}}, "correctAnswer": "C", "evidence": {"materialId": "C1A-M07", "quote": {"zh-Hans": "你的中文书能借我看一下吗", "zh-Hant": "你的中文書能借我看一下嗎"}}, "explanation": {"en": "He directly asks to borrow the Chinese book.", "zh": "男生直接提出借中文书。"}, "distractors": {"A": {"en": "His English book is already in his bag.", "zh": "他的英语书已经在书包里。"}, "B": {"en": "No mathematics book is requested.", "zh": "他没有提出借数学书。"}}, "reviewStatus": "author_self_checked_pending_teacher_and_user_review"}, {"id": "course-zh1-a-q08", "number": 8, "section": "listening", "group": "L2", "theme": "school", "materialId": "C1A-M08", "target": "Identify a classroom number and floor.", "promptEn": "Which classroom should the girl go to?", "options": {"A": {"zh-Hans": "二楼201", "zh-Hant": "二樓201"}, "B": {"zh-Hans": "三楼302", "zh-Hant": "三樓302"}, "C": {"zh-Hans": "四楼402", "zh-Hant": "四樓402"}}, "correctAnswer": "B", "evidence": {"materialId": "C1A-M08", "quote": {"zh-Hans": "在三楼的三零二教室", "zh-Hant": "在三樓的三零二教室"}}, "explanation": {"en": "The room is 302 on the third floor.", "zh": "教室是三楼302。"}, "distractors": {"A": {"en": "The teacher explicitly says not the second floor.", "zh": "老师明确说不是二楼。"}, "C": {"en": "No fourth-floor room is given.", "zh": "材料没有说去四楼。"}}, "reviewStatus": "author_self_checked_pending_teacher_and_user_review"}, {"id": "course-zh1-a-q09", "number": 9, "section": "listening", "group": "L2", "theme": "school", "materialId": "C1A-M09", "target": "Identify the first action in a short sequence.", "promptEn": "What will the girl do first after class?", "options": {"A": {"zh-Hans": "借书", "zh-Hant": "借書"}, "B": {"zh-Hans": "吃饭", "zh-Hant": "喫飯"}, "C": {"zh-Hans": "买衣服", "zh-Hant": "買衣服"}}, "correctAnswer": "A", "evidence": {"materialId": "C1A-M09", "quote": {"zh-Hans": "我先去图书馆借书", "zh-Hant": "我先去圖書館借書"}}, "explanation": {"en": "She will first borrow books at the library.", "zh": "女生说先去图书馆借书。"}, "distractors": {"B": {"en": "She says she is not eating at school today.", "zh": "她今天不在学校吃饭，吃饭也不是先做的事。"}, "C": {"en": "Buying clothes is not mentioned.", "zh": "材料没有提到买衣服。"}}, "reviewStatus": "author_self_checked_pending_teacher_and_user_review"}, {"id": "course-zh1-a-q10", "number": 10, "section": "listening", "group": "L2", "theme": "schedule", "materialId": "C1A-M10", "target": "Distinguish the start time from an arrival or end time.", "promptEn": "When does today’s Chinese class begin?", "options": {"A": {"zh-Hans": "九点", "zh-Hant": "九點"}, "B": {"zh-Hans": "十点半", "zh-Hant": "十點半"}, "C": {"zh-Hans": "九点半", "zh-Hant": "九點半"}}, "correctAnswer": "C", "evidence": {"materialId": "C1A-M10", "quote": {"zh-Hans": "今天九点半开始", "zh-Hant": "今天九點半開始"}}, "explanation": {"en": "The boy says class begins at nine thirty today.", "zh": "男生说明今天九点半开始。"}, "distractors": {"A": {"en": "Nine is the suggested time that is corrected.", "zh": "九点是被否定的原先时间。"}, "B": {"en": "Ten thirty is the end of class.", "zh": "十点半是下课时间。"}}, "reviewStatus": "author_self_checked_pending_teacher_and_user_review"}, {"id": "course-zh1-a-q11", "number": 11, "section": "listening", "group": "L3", "theme": "food", "materialId": "C1A-M11", "target": "Distinguish a present meal choice from a later one.", "promptEn": "What does the girl want to eat now?", "options": {"A": {"zh-Hans": "面条", "zh-Hant": "麪條"}, "B": {"zh-Hans": "米饭和鸡蛋", "zh-Hant": "米飯和雞蛋"}, "C": {"zh-Hans": "米饭和肉", "zh-Hant": "米飯和肉"}}, "correctAnswer": "B", "evidence": {"materialId": "C1A-M11", "quote": {"zh-Hans": "现在我想吃米饭和鸡蛋", "zh-Hant": "現在我想喫米飯和雞蛋"}}, "explanation": {"en": "She chooses rice and eggs for now.", "zh": "她现在想吃米饭和鸡蛋。"}, "distractors": {"A": {"en": "Noodles are her choice for the evening.", "zh": "面条是她晚上想吃的。"}, "C": {"en": "She explicitly does not want meat.", "zh": "她说现在不想吃肉。"}}, "reviewStatus": "author_self_checked_pending_teacher_and_user_review"}, {"id": "course-zh1-a-q12", "number": 12, "section": "listening", "group": "L3", "theme": "food", "materialId": "C1A-M12", "target": "Identify the speaker’s own preference.", "promptEn": "What does the speaker drink every morning?", "options": {"A": {"zh-Hans": "牛奶", "zh-Hant": "牛奶"}, "B": {"zh-Hans": "茶", "zh-Hant": "茶"}, "C": {"zh-Hans": "咖啡", "zh-Hant": "咖啡"}}, "correctAnswer": "A", "evidence": {"materialId": "C1A-M12", "quote": {"zh-Hans": "我每天喝一杯牛奶", "zh-Hant": "我每天喝一杯牛奶"}}, "explanation": {"en": "The speaker says she drinks milk every day.", "zh": "说话者每天喝一杯牛奶。"}, "distractors": {"B": {"en": "Tea is her mother’s drink, not hers.", "zh": "茶是妈妈喝的，她自己不喝。"}, "C": {"en": "Coffee is her father’s drink, not hers.", "zh": "咖啡是爸爸喝的，她自己不喝。"}}, "reviewStatus": "author_self_checked_pending_teacher_and_user_review"}, {"id": "course-zh1-a-q13", "number": 13, "section": "listening", "group": "L3", "theme": "food", "materialId": "C1A-M13", "target": "Identify a quantity attached to the correct item.", "promptEn": "How many apples does the boy want?", "options": {"A": {"zh-Hans": "两个", "zh-Hant": "兩個"}, "B": {"zh-Hans": "六个", "zh-Hant": "六個"}, "C": {"zh-Hans": "四个", "zh-Hant": "四個"}}, "correctAnswer": "C", "evidence": {"materialId": "C1A-M13", "quote": {"zh-Hans": "我要四个苹果", "zh-Hant": "我要四個蘋果"}}, "explanation": {"en": "He requests four apples, repeated by the seller.", "zh": "他要四个苹果，卖家也重复确认。"}, "distractors": {"A": {"en": "Two is the number of bananas.", "zh": "两个是香蕉的数量。"}, "B": {"en": "Six would combine both fruits, not just apples.", "zh": "六个把两种水果加在一起，不是苹果数量。"}}, "reviewStatus": "author_self_checked_pending_teacher_and_user_review"}, {"id": "course-zh1-a-q14", "number": 14, "section": "listening", "group": "L3", "theme": "food", "materialId": "C1A-M14", "target": "Separate the stated price from payment and change.", "promptEn": "How much does the lunch cost?", "options": {"A": {"zh-Hans": "二十块", "zh-Hant": "二十塊"}, "B": {"zh-Hans": "十二块", "zh-Hant": "十二塊"}, "C": {"zh-Hans": "八块", "zh-Hant": "八塊"}}, "correctAnswer": "B", "evidence": {"materialId": "C1A-M14", "quote": {"zh-Hans": "十二块", "zh-Hant": "十二塊"}}, "explanation": {"en": "The seller states that lunch costs twelve.", "zh": "卖家直接说午饭十二块。"}, "distractors": {"A": {"en": "Twenty is the amount handed over.", "zh": "二十块是顾客付出的纸币金额。"}, "C": {"en": "Eight is the change returned.", "zh": "八块是找回的零钱。"}}, "reviewStatus": "author_self_checked_pending_teacher_and_user_review"}, {"id": "course-zh1-a-q15", "number": 15, "section": "listening", "group": "L3", "theme": "clothing", "materialId": "C1A-M15", "target": "Identify a color preference expressed with negation.", "promptEn": "Which color does the boy choose?", "options": {"A": {"zh-Hans": "蓝色", "zh-Hant": "藍色"}, "B": {"zh-Hans": "红色", "zh-Hant": "紅色"}, "C": {"zh-Hans": "白色", "zh-Hant": "白色"}}, "correctAnswer": "A", "evidence": {"materialId": "C1A-M15", "quote": {"zh-Hans": "我喜欢蓝色的，不喜欢红色的", "zh-Hant": "我喜歡藍色的，不喜歡紅色的"}}, "explanation": {"en": "He chooses the blue item.", "zh": "他说喜欢蓝色，并决定买蓝色这件。"}, "distractors": {"B": {"en": "He explicitly does not like red.", "zh": "他明确说不喜欢红色。"}, "C": {"en": "White is not offered or selected in the dialogue.", "zh": "对话没有提供或选择白色。"}}, "reviewStatus": "author_self_checked_pending_teacher_and_user_review"}, {"id": "course-zh1-a-q16", "number": 16, "section": "listening", "group": "L4", "theme": "schedule", "materialId": "C1A-M16", "target": "Identify the final agreed arrangement.", "promptEn": "When will they meet?", "options": {"A": {"zh-Hans": "星期六上午", "zh-Hant": "星期六上午"}, "B": {"zh-Hans": "星期六下午", "zh-Hant": "星期六下午"}, "C": {"zh-Hans": "星期天下午", "zh-Hant": "星期天下午"}}, "correctAnswer": "C", "evidence": {"materialId": "C1A-M16", "quote": {"zh-Hans": "我们星期天下午见", "zh-Hant": "我們星期天下午見"}}, "explanation": {"en": "Both agree on Sunday afternoon.", "zh": "双方最后约定周日下午见。"}, "distractors": {"A": {"en": "Saturday is unavailable because she has class.", "zh": "女生周六要上课，没有约在周六上午。"}, "B": {"en": "They do not agree to meet on Saturday.", "zh": "他们没有同意周六下午见。"}}, "reviewStatus": "author_self_checked_pending_teacher_and_user_review"}, {"id": "course-zh1-a-q17", "number": 17, "section": "listening", "group": "L4", "theme": "schedule", "materialId": "C1A-M17", "target": "Identify one time among several daily activities.", "promptEn": "When does the boy leave home?", "options": {"A": {"zh-Hans": "六点半", "zh-Hant": "六點半"}, "B": {"zh-Hans": "七点半", "zh-Hant": "七點半"}, "C": {"zh-Hans": "七点", "zh-Hant": "七點"}}, "correctAnswer": "B", "evidence": {"materialId": "C1A-M17", "quote": {"zh-Hans": "七点半出门", "zh-Hant": "七點半出門"}}, "explanation": {"en": "He leaves home at seven thirty.", "zh": "他七点半出门。"}, "distractors": {"A": {"en": "Six thirty is his waking time.", "zh": "六点半是起床时间。"}, "C": {"en": "Seven is his breakfast time.", "zh": "七点是吃早饭的时间。"}}, "reviewStatus": "author_self_checked_pending_teacher_and_user_review"}, {"id": "course-zh1-a-q18", "number": 18, "section": "listening", "group": "L4", "theme": "clothing", "materialId": "C1A-M18", "target": "Identify a clothing choice in a familiar weather context.", "promptEn": "What will the girl wear?", "options": {"A": {"zh-Hans": "厚外套", "zh-Hant": "厚外套"}, "B": {"zh-Hans": "薄衣服", "zh-Hant": "薄衣服"}, "C": {"zh-Hans": "短裤", "zh-Hant": "短褲"}}, "correctAnswer": "A", "evidence": {"materialId": "C1A-M18", "quote": {"zh-Hans": "我穿那件厚外套", "zh-Hant": "我穿那件厚外套"}}, "explanation": {"en": "She chooses the thick coat for the cold weather.", "zh": "她决定穿厚外套。"}, "distractors": {"B": {"en": "She explicitly rejects the thin item.", "zh": "她明确说不穿这件薄的。"}, "C": {"en": "Shorts are not mentioned.", "zh": "材料没有提到短裤。"}}, "reviewStatus": "author_self_checked_pending_teacher_and_user_review"}, {"id": "course-zh1-a-q19", "number": 19, "section": "listening", "group": "L4", "theme": "leisure", "materialId": "C1A-M19", "target": "Identify an accepted alternative to an invitation.", "promptEn": "What do they agree to do?", "options": {"A": {"zh-Hans": "打篮球", "zh-Hant": "打籃球"}, "B": {"zh-Hans": "去公园", "zh-Hant": "去公園"}, "C": {"zh-Hans": "看电视", "zh-Hant": "看電視"}}, "correctAnswer": "B", "evidence": {"materialId": "C1A-M19", "quote": {"zh-Hans": "好，我也想去公园", "zh-Hant": "好，我也想去公園"}}, "explanation": {"en": "Both agree to go to the park.", "zh": "两人最后都同意去公园。"}, "distractors": {"A": {"en": "Basketball is suggested first, but not chosen.", "zh": "篮球是最初建议，最后没有选择。"}, "C": {"en": "Watching television is not mentioned.", "zh": "材料没有提到看电视。"}}, "reviewStatus": "author_self_checked_pending_teacher_and_user_review"}, {"id": "course-zh1-a-q20", "number": 20, "section": "listening", "group": "L4", "theme": "leisure", "materialId": "C1A-M20", "target": "Match a leisure activity to the stated day.", "promptEn": "What will the girl do on Saturday afternoon?", "options": {"A": {"zh-Hans": "画画", "zh-Hant": "畫畫"}, "B": {"zh-Hans": "听音乐", "zh-Hant": "聽音樂"}, "C": {"zh-Hans": "唱歌", "zh-Hant": "唱歌"}}, "correctAnswer": "A", "evidence": {"materialId": "C1A-M20", "quote": {"zh-Hans": "这周六下午我要在家画画", "zh-Hant": "這週六下午我要在家畫畫"}}, "explanation": {"en": "She will draw at home on Saturday afternoon.", "zh": "她周六下午在家画画。"}, "distractors": {"B": {"en": "Listening to music is planned for Sunday.", "zh": "听音乐安排在星期天。"}, "C": {"en": "Singing is not in her stated plan.", "zh": "她没有说计划唱歌。"}}, "reviewStatus": "author_self_checked_pending_teacher_and_user_review"}, {"id": "course-zh1-a-q21", "number": 21, "section": "reading", "group": "R1", "theme": "identity", "materialId": "C1A-M21", "target": "Read a country of origin on a personal profile.", "promptEn": "Where is Jin Na from?", "options": {"A": {"zh-Hans": "中国", "zh-Hant": "中國"}, "B": {"zh-Hans": "美国", "zh-Hant": "美國"}, "C": {"zh-Hans": "韩国", "zh-Hant": "韓國"}}, "correctAnswer": "C", "evidence": {"materialId": "C1A-M21", "quote": {"zh-Hans": "来自：韩国", "zh-Hant": "來自：韓國"}}, "explanation": {"en": "The origin field gives Korea.", "zh": "来自一栏写的是韩国。"}, "distractors": {"A": {"en": "China is not the country listed on the profile.", "zh": "资料卡没有把中国列为来源国家。"}, "B": {"en": "The profile does not say she is from the United States.", "zh": "资料卡没有说她来自美国。"}}, "reviewStatus": "author_self_checked_pending_teacher_and_user_review"}, {"id": "course-zh1-a-q22", "number": 22, "section": "reading", "group": "R1", "theme": "identity", "materialId": "C1A-M22", "target": "Locate information about a particular family member.", "promptEn": "Who studies at university?", "options": {"A": {"zh-Hans": "爸爸", "zh-Hant": "爸爸"}, "B": {"zh-Hans": "哥哥", "zh-Hant": "哥哥"}, "C": {"zh-Hans": "妈妈", "zh-Hant": "媽媽"}}, "correctAnswer": "B", "evidence": {"materialId": "C1A-M22", "quote": {"zh-Hans": "我哥哥在大学读书", "zh-Hant": "我哥哥在大學讀書"}}, "explanation": {"en": "The older brother studies at university.", "zh": "原文说哥哥在大学读书。"}, "distractors": {"A": {"en": "The father teaches Chinese at school.", "zh": "爸爸在学校教中文。"}, "C": {"en": "The mother is a doctor working at a hospital.", "zh": "妈妈是医院的医生。"}}, "reviewStatus": "author_self_checked_pending_teacher_and_user_review"}, {"id": "course-zh1-a-q23", "number": 23, "section": "reading", "group": "R1", "theme": "identity", "materialId": "C1A-M23", "target": "Find a relative’s age in a short note.", "promptEn": "How old is the younger sister?", "options": {"A": {"zh-Hans": "十二岁", "zh-Hant": "十二歲"}, "B": {"zh-Hans": "十六岁", "zh-Hant": "十六歲"}, "C": {"zh-Hans": "十四岁", "zh-Hant": "十四歲"}}, "correctAnswer": "A", "evidence": {"materialId": "C1A-M23", "quote": {"zh-Hans": "妹妹十二岁", "zh-Hant": "妹妹十二歲"}}, "explanation": {"en": "The note explicitly gives the younger sister’s age as twelve.", "zh": "照片说明明确写妹妹十二岁。"}, "distractors": {"B": {"en": "Sixteen is the writer’s own age.", "zh": "十六岁是作者自己的年龄。"}, "C": {"en": "Fourteen is not given in the note.", "zh": "原文没有出现十四岁。"}}, "reviewStatus": "author_self_checked_pending_teacher_and_user_review"}, {"id": "course-zh1-a-q24", "number": 24, "section": "reading", "group": "R1", "theme": "identity", "materialId": "C1A-M24", "target": "Identify household members without inferring from stereotypes.", "promptEn": "Who lives with Anna in Beijing?", "options": {"A": {"zh-Hans": "哥哥", "zh-Hant": "哥哥"}, "B": {"zh-Hans": "爷爷奶奶", "zh-Hant": "爺爺奶奶"}, "C": {"zh-Hans": "爸爸妈妈", "zh-Hant": "爸爸媽媽"}}, "correctAnswer": "C", "evidence": {"materialId": "C1A-M24", "quote": {"zh-Hans": "我现在和爸爸妈妈住在北京", "zh-Hant": "我現在和爸爸媽媽住在北京"}}, "explanation": {"en": "Anna says she lives with her parents.", "zh": "安娜说自己和爸爸妈妈住在北京。"}, "distractors": {"A": {"en": "Her older brother works in Shanghai and lives separately.", "zh": "哥哥在上海工作，不与她同住。"}, "B": {"en": "Grandparents are not listed as living with her.", "zh": "原文没有说爷爷奶奶和她住。"}}, "reviewStatus": "author_self_checked_pending_teacher_and_user_review"}, {"id": "course-zh1-a-q25", "number": 25, "section": "reading", "group": "R1", "theme": "school", "materialId": "C1A-M25", "target": "Distinguish a class number from a floor or room number.", "promptEn": "Which class is Lin Ming joining?", "options": {"A": {"zh-Hans": "一班", "zh-Hant": "一班"}, "B": {"zh-Hans": "二班", "zh-Hant": "二班"}, "C": {"zh-Hans": "三班", "zh-Hant": "三班"}}, "correctAnswer": "B", "evidence": {"materialId": "C1A-M25", "quote": {"zh-Hans": "欢迎来二班", "zh-Hant": "歡迎來二班"}}, "explanation": {"en": "The welcome and signature both identify Class Two.", "zh": "欢迎语和署名都说明是二班。"}, "distractors": {"A": {"en": "The note does not welcome him to Class One.", "zh": "便条不是欢迎他到一班。"}, "C": {"en": "The third floor is a location, not the class number.", "zh": "三楼是楼层，不是三班。"}}, "reviewStatus": "author_self_checked_pending_teacher_and_user_review"}, {"id": "course-zh1-a-q26", "number": 26, "section": "reading", "group": "R2", "theme": "school", "materialId": "C1A-M26", "target": "Read a simple classroom instruction with negation.", "promptEn": "Which item do students NOT need to bring?", "options": {"A": {"zh-Hans": "纸", "zh-Hant": "紙"}, "B": {"zh-Hans": "铅笔", "zh-Hant": "鉛筆"}, "C": {"zh-Hans": "彩色笔", "zh-Hant": "彩色筆"}}, "correctAnswer": "A", "evidence": {"materialId": "C1A-M26", "quote": {"zh-Hans": "大家不用带纸", "zh-Hant": "大家不用帶紙"}}, "explanation": {"en": "The teacher supplies paper and says not to bring it.", "zh": "老师有纸，明确说大家不用带。"}, "distractors": {"B": {"en": "Students are explicitly asked to bring pencils.", "zh": "通知要求带铅笔。"}, "C": {"en": "Students are explicitly asked to bring colored pens.", "zh": "通知要求带彩色笔。"}}, "reviewStatus": "author_self_checked_pending_teacher_and_user_review"}, {"id": "course-zh1-a-q27", "number": 27, "section": "reading", "group": "R2", "theme": "school", "materialId": "C1A-M27", "target": "Locate a lesson in a simple timetable.", "promptEn": "Which lesson starts at ten o’clock?", "options": {"A": {"zh-Hans": "中文", "zh-Hant": "中文"}, "B": {"zh-Hans": "数学", "zh-Hant": "數學"}, "C": {"zh-Hans": "英语", "zh-Hant": "英語"}}, "correctAnswer": "C", "evidence": {"materialId": "C1A-M27", "quote": {"zh-Hans": "英语：10:00—10:40", "zh-Hant": "英語：10:00—10:40"}}, "explanation": {"en": "English is the ten-o’clock lesson.", "zh": "课表写英语十点开始。"}, "distractors": {"A": {"en": "Chinese begins at nine.", "zh": "中文九点开始。"}, "B": {"en": "Mathematics begins at eleven.", "zh": "数学十一点开始。"}}, "reviewStatus": "author_self_checked_pending_teacher_and_user_review"}, {"id": "course-zh1-a-q28", "number": 28, "section": "reading", "group": "R2", "theme": "school", "materialId": "C1A-M28", "target": "Follow a school message about collecting an item.", "promptEn": "Where should Xiao Chen collect the book?", "options": {"A": {"zh-Hans": "小周的教室", "zh-Hant": "小周的教室"}, "B": {"zh-Hans": "办公室", "zh-Hant": "辦公室"}, "C": {"zh-Hans": "图书馆", "zh-Hant": "圖書館"}}, "correctAnswer": "B", "evidence": {"materialId": "C1A-M28", "quote": {"zh-Hans": "请你去办公室拿", "zh-Hant": "請你去辦公室拿"}}, "explanation": {"en": "The book is to be collected in the office.", "zh": "便条让小陈去办公室拿书。"}, "distractors": {"A": {"en": "The writer explicitly says not to come to their classroom.", "zh": "小周明确说不用来自己教室。"}, "C": {"en": "The library is not the collection location.", "zh": "便条没有安排在图书馆取书。"}}, "reviewStatus": "author_self_checked_pending_teacher_and_user_review"}, {"id": "course-zh1-a-q29", "number": 29, "section": "reading", "group": "R2", "theme": "school", "materialId": "C1A-M29", "target": "Identify the purpose of a short request.", "promptEn": "What does Li Xiaowen ask to borrow?", "options": {"A": {"zh-Hans": "英语书", "zh-Hant": "英語書"}, "B": {"zh-Hans": "书包", "zh-Hant": "書包"}, "C": {"zh-Hans": "中文书", "zh-Hant": "中文書"}}, "correctAnswer": "C", "evidence": {"materialId": "C1A-M29", "quote": {"zh-Hans": "今天能借您的中文书用一下吗", "zh-Hant": "今天能借您的中文書用一下嗎"}}, "explanation": {"en": "The writer directly asks to use the teacher’s Chinese book.", "zh": "学生直接请求借老师的中文书。"}, "distractors": {"A": {"en": "The English book is already in the bag.", "zh": "英语书已在书包里，不是借用目标。"}, "B": {"en": "The writer does not ask for a bag.", "zh": "便条没有提出借书包。"}}, "reviewStatus": "author_self_checked_pending_teacher_and_user_review"}, {"id": "course-zh1-a-q30", "number": 30, "section": "reading", "group": "R2", "theme": "schedule", "materialId": "C1A-M30", "target": "Read the time of an activity in a weekly plan.", "promptEn": "When does Xiao Lin play basketball?", "options": {"A": {"zh-Hans": "星期一下午", "zh-Hant": "星期一下午"}, "B": {"zh-Hans": "星期三下午", "zh-Hant": "星期三下午"}, "C": {"zh-Hans": "星期六上午", "zh-Hant": "星期六上午"}}, "correctAnswer": "A", "evidence": {"materialId": "C1A-M30", "quote": {"zh-Hans": "星期一下午：在学校打篮球", "zh-Hant": "星期一下午：在學校打籃球"}}, "explanation": {"en": "The schedule lists basketball on Monday afternoon.", "zh": "安排表把篮球放在周一下午。"}, "distractors": {"B": {"en": "Wednesday afternoon is for reading at the library.", "zh": "周三下午是在图书馆看书。"}, "C": {"en": "Saturday morning is for buying fruit.", "zh": "周六上午是和妈妈买水果。"}}, "reviewStatus": "author_self_checked_pending_teacher_and_user_review"}, {"id": "course-zh1-a-q31", "number": 31, "section": "reading", "group": "R3", "theme": "food", "materialId": "C1A-M31", "target": "Read a price from a functional menu without unnecessary arithmetic.", "promptEn": "How much are the noodles?", "options": {"A": {"zh-Hans": "四元", "zh-Hant": "四元"}, "B": {"zh-Hans": "六元", "zh-Hant": "六元"}, "C": {"zh-Hans": "五元", "zh-Hant": "五元"}}, "correctAnswer": "B", "evidence": {"materialId": "C1A-M31", "quote": {"zh-Hans": "面条：六元", "zh-Hant": "麪條：六元"}}, "explanation": {"en": "The menu prices noodles at six yuan.", "zh": "菜单标明面条六元。"}, "distractors": {"A": {"en": "Four yuan is the price of rice.", "zh": "四元是米饭价格。"}, "C": {"en": "Five yuan is the price of milk.", "zh": "五元是牛奶价格。"}}, "reviewStatus": "author_self_checked_pending_teacher_and_user_review"}, {"id": "course-zh1-a-q32", "number": 32, "section": "reading", "group": "R3", "theme": "food", "materialId": "C1A-M32", "target": "Distinguish the writer’s meal from another person’s order.", "promptEn": "What does Xiao An want for lunch?", "options": {"A": {"zh-Hans": "米饭和鸡蛋", "zh-Hant": "米飯和雞蛋"}, "B": {"zh-Hans": "面条", "zh-Hant": "麪條"}, "C": {"zh-Hans": "米饭和肉", "zh-Hant": "米飯和肉"}}, "correctAnswer": "A", "evidence": {"materialId": "C1A-M32", "quote": {"zh-Hans": "今天午饭我想吃米饭和鸡蛋", "zh-Hant": "今天午飯我想喫米飯和雞蛋"}}, "explanation": {"en": "Xiao An’s message requests rice and eggs.", "zh": "小安在便条中要米饭和鸡蛋。"}, "distractors": {"B": {"en": "The younger sister wants noodles.", "zh": "面条是妹妹想吃的。"}, "C": {"en": "Xiao An explicitly says not to include meat.", "zh": "小安明确说不要肉。"}}, "reviewStatus": "author_self_checked_pending_teacher_and_user_review"}, {"id": "course-zh1-a-q33", "number": 33, "section": "reading", "group": "R3", "theme": "food", "materialId": "C1A-M33", "target": "Match a quantity with the requested fruit.", "promptEn": "What should Dad buy TWO of?", "options": {"A": {"zh-Hans": "苹果", "zh-Hant": "蘋果"}, "B": {"zh-Hans": "橙子", "zh-Hant": "橙子"}, "C": {"zh-Hans": "香蕉", "zh-Hant": "香蕉"}}, "correctAnswer": "C", "evidence": {"materialId": "C1A-M33", "quote": {"zh-Hans": "请买两个香蕉", "zh-Hant": "請買兩個香蕉"}}, "explanation": {"en": "The shopping note requests two bananas.", "zh": "便条明确要求买两个香蕉。"}, "distractors": {"A": {"en": "Apples are already at home and should not be bought today.", "zh": "家里已有苹果，今天不用买。"}, "B": {"en": "The note requests four oranges.", "zh": "橙子要买四个。"}}, "reviewStatus": "author_self_checked_pending_teacher_and_user_review"}, {"id": "course-zh1-a-q34", "number": 34, "section": "reading", "group": "R3", "theme": "food", "materialId": "C1A-M34", "target": "Read a simple drink preference and distinguish ownership.", "promptEn": "What drink does Xiaowen request?", "options": {"A": {"zh-Hans": "冷水", "zh-Hant": "冷水"}, "B": {"zh-Hans": "热茶", "zh-Hant": "熱茶"}, "C": {"zh-Hans": "咖啡", "zh-Hant": "咖啡"}}, "correctAnswer": "B", "evidence": {"materialId": "C1A-M34", "quote": {"zh-Hans": "请给我一杯热茶", "zh-Hant": "請給我一杯熱茶"}}, "explanation": {"en": "The request is for a cup of hot tea without sugar.", "zh": "小文要一杯不加糖的热茶。"}, "distractors": {"A": {"en": "The writer explicitly does not want cold water.", "zh": "小文明确说不想喝冷水。"}, "C": {"en": "The coffee belongs to Xiao Li, not the writer’s request.", "zh": "咖啡是小李的，不是小文要的饮料。"}}, "reviewStatus": "author_self_checked_pending_teacher_and_user_review"}, {"id": "course-zh1-a-q35", "number": 35, "section": "reading", "group": "R3", "theme": "clothing", "materialId": "C1A-M35", "target": "Combine two explicit details in a clothing request.", "promptEn": "Which shirt does the writer want?", "options": {"A": {"zh-Hans": "白色大号", "zh-Hant": "白色大號"}, "B": {"zh-Hans": "蓝色大号", "zh-Hant": "藍色大號"}, "C": {"zh-Hans": "蓝色小号", "zh-Hant": "藍色小號"}}, "correctAnswer": "C", "evidence": {"materialId": "C1A-M35", "quote": {"zh-Hans": "我喜欢蓝色的，要小号", "zh-Hant": "我喜歡藍色的，要小號"}}, "explanation": {"en": "Both the preferred color and size match.", "zh": "蓝色小号同时符合颜色和尺码要求。"}, "distractors": {"A": {"en": "The writer rejects the large white shirt.", "zh": "作者不买太大的白色衬衫。"}, "B": {"en": "Blue is right, but the writer wants a small size.", "zh": "颜色对，但作者要小号，不是大号。"}}, "reviewStatus": "author_self_checked_pending_teacher_and_user_review"}, {"id": "course-zh1-a-q36", "number": 36, "section": "reading", "group": "R4", "theme": "schedule", "materialId": "C1A-M36", "target": "Read a final arrangement across a short exchange.", "promptEn": "When do they finally agree to meet?", "options": {"A": {"zh-Hans": "周日上午九点", "zh-Hant": "週日上午九點"}, "B": {"zh-Hans": "周六上午九点", "zh-Hant": "週六上午九點"}, "C": {"zh-Hans": "周日上午十点", "zh-Hant": "週日上午十點"}}, "correctAnswer": "A", "evidence": {"materialId": "C1A-M36", "quote": {"zh-Hans": "周日上午九点可以吗", "zh-Hant": "週日上午九點可以嗎"}}, "explanation": {"en": "The second message proposes Sunday at nine and the last accepts it.", "zh": "小林提出周日九点，小白随后同意。"}, "distractors": {"B": {"en": "Saturday is unavailable because Xiao Lin has class.", "zh": "小林周六有课，双方没有约在周六九点。"}, "C": {"en": "The agreed hour is nine, not ten.", "zh": "约定的是上午九点，不是十点。"}}, "reviewStatus": "author_self_checked_pending_teacher_and_user_review"}, {"id": "course-zh1-a-q37", "number": 37, "section": "reading", "group": "R4", "theme": "schedule", "materialId": "C1A-M37", "target": "Identify one person’s travel time in a daily sequence.", "promptEn": "When does the writer take the bus?", "options": {"A": {"zh-Hans": "六点半", "zh-Hant": "六點半"}, "B": {"zh-Hans": "七点半", "zh-Hant": "七點半"}, "C": {"zh-Hans": "七点", "zh-Hant": "七點"}}, "correctAnswer": "C", "evidence": {"materialId": "C1A-M37", "quote": {"zh-Hans": "七点坐公共汽车去学校", "zh-Hant": "七點坐公共汽車去學校"}}, "explanation": {"en": "The writer takes the bus at seven.", "zh": "作者七点坐公共汽车。"}, "distractors": {"A": {"en": "Six thirty is breakfast time.", "zh": "六点半是吃早饭时间。"}, "B": {"en": "Seven thirty is Dad’s leaving time.", "zh": "七点半是爸爸出门时间。"}}, "reviewStatus": "author_self_checked_pending_teacher_and_user_review"}, {"id": "course-zh1-a-q38", "number": 38, "section": "reading", "group": "R4", "theme": "clothing", "materialId": "C1A-M38", "target": "Use a simple instruction and location to select clothing.", "promptEn": "Which item of clothing should Xiaoyu take from home?", "options": {"A": {"zh-Hans": "厚外套", "zh-Hant": "厚外套"}, "B": {"zh-Hans": "蓝帽子", "zh-Hant": "藍帽子"}, "C": {"zh-Hans": "白帽子", "zh-Hant": "白帽子"}}, "correctAnswer": "B", "evidence": {"materialId": "C1A-M38", "quote": {"zh-Hans": "你的蓝帽子在门口，白帽子在学校", "zh-Hant": "你的藍帽子在門口，白帽子在學校"}}, "explanation": {"en": "A hat is requested, and the blue one is at home by the door.", "zh": "需要带帽子，蓝帽子在家门口。"}, "distractors": {"A": {"en": "The note explicitly says no thick coat is needed.", "zh": "便条明确说不用带厚外套。"}, "C": {"en": "The white hat is at school, not at home.", "zh": "白帽子在学校，不在家里。"}}, "reviewStatus": "author_self_checked_pending_teacher_and_user_review"}, {"id": "course-zh1-a-q39", "number": 39, "section": "reading", "group": "R4", "theme": "leisure", "materialId": "C1A-M39", "target": "Distinguish an accepted invitation from an earlier personal activity.", "promptEn": "What will they do together on Sunday afternoon?", "options": {"A": {"zh-Hans": "看电影", "zh-Hant": "看電影"}, "B": {"zh-Hans": "打篮球", "zh-Hant": "打籃球"}, "C": {"zh-Hans": "在家看书", "zh-Hant": "在家看書"}}, "correctAnswer": "A", "evidence": {"materialId": "C1A-M39", "quote": {"zh-Hans": "周日下午一起去看电影吗", "zh-Hant": "週日下午一起去看電影嗎"}}, "explanation": {"en": "The invitation to see a film is accepted for the afternoon.", "zh": "小陈同意了下午看电影的邀请。"}, "distractors": {"B": {"en": "Basketball is Xiao Chen’s morning activity.", "zh": "篮球是小陈上午的安排。"}, "C": {"en": "Reading at home is not the agreed activity.", "zh": "对话没有约定在家看书。"}}, "reviewStatus": "author_self_checked_pending_teacher_and_user_review"}, {"id": "course-zh1-a-q40", "number": 40, "section": "reading", "group": "R4", "theme": "leisure", "materialId": "C1A-M40", "target": "Combine preference and schedule in choosing an activity.", "promptEn": "Which activity fits Xiaohong’s preference and free time?", "options": {"A": {"zh-Hans": "星期四唱歌", "zh-Hant": "星期四唱歌"}, "B": {"zh-Hans": "星期二画画", "zh-Hant": "星期二畫畫"}, "C": {"zh-Hans": "星期二唱歌", "zh-Hant": "星期二唱歌"}}, "correctAnswer": "B", "evidence": {"materialId": "C1A-M40", "quote": {"zh-Hans": "画画：星期二下午", "zh-Hant": "畫畫：星期二下午"}}, "explanation": {"en": "Drawing matches both her preference and Tuesday availability.", "zh": "周二画画同时符合喜好和空闲时间。"}, "distractors": {"A": {"en": "She dislikes singing; her stated free time is Tuesday.", "zh": "她不喜欢唱歌，明确有空的是周二下午。"}, "C": {"en": "The school does not list singing on Tuesday.", "zh": "学校没有列出周二唱歌活动。"}}, "reviewStatus": "author_self_checked_pending_teacher_and_user_review"}], "tasks": [{"id": "W1", "section": "writing", "type": "short-message-reply", "title": "Reply to an invitation", "promptEn": "Your classmate sent the message below. Reply in Chinese. Say whether you can come on Saturday, give a time or another day that works for you, and ask one relevant question. You may invent personal details. About 20-40 Chinese characters is a guide, not a minimum.", "stimulus": {"zh-Hans": "小林：你好！星期六来我家吃午饭，好吗？你想吃米饭还是面条？你几点有空？\n小周", "zh-Hant": "小林：你好！星期六來我家喫午飯，好嗎？你想喫米飯還是麪條？你幾點有空？\n小周"}, "requirements": ["Respond to the Saturday invitation.", "Give a workable time or suggest another day.", "Ask one question related to the visit."], "optionalDetail": "You may also answer the meal-choice question; this is not a fourth required scoring point.", "reference": {"zh-Hans": "小周，你好！周六可以。我想吃面条，十一点有空。你家在哪儿？谢谢！", "zh-Hant": "小周，你好！週六可以。我想喫麪條，十一點有空。你家在哪兒？謝謝！"}, "alternateReference": {"zh-Hans": "你好！周六我有课，周日可以吗？我十二点有空。你家在哪儿？", "zh-Hant": "你好！週六我有課，週日可以嗎？我十二點有空。你家在哪兒？"}, "reviewNotes": ["Accept a polite decline plus an alternative day; acceptance is not required.", "Names and personal details may differ.", "A relevant question about location, arrival or food can meet the question requirement."], "suggestedHanzi": [20, 40], "enforcedMinimum": null, "sharedTimingGroup": "writing", "rubric": {"maxPoints": 8, "dimensions": [{"id": "completion", "name": "任务完成", "levels": {"0": "无相关可评内容。", "1": "回应部分要求，遗漏关键信息。", "2": "以初阶表达回应主要要求。"}}, {"id": "comprehensibility", "name": "可理解性", "levels": {"0": "大部分意思无法恢复。", "1": "部分需借助上下文猜测。", "2": "主要意思能够理解。"}}, {"id": "language", "name": "基础语言运用", "levels": {"0": "缺少可用于表达目标意思的中文。", "1": "有限词句传达部分意思，错误有时干扰。", "2": "简单词句基本适合情境，允许初阶错误。"}}, {"id": "organization", "name": "组织／相关回应", "levels": {"0": "缺乏可辨关系或相关回应。", "1": "有部分顺序或相关回应。", "2": "简单但连贯，回应相关、易于跟随。"}}], "missing": "unsubmitted", "technicalFailure": "needs_rerecording", "automaticGrade": false, "reviewerOptions": ["self", "own_teacher"], "teacherServiceIncluded": false, "notes": "One profile per task. Accent similarity to native speakers and suggested length are not scoring criteria. For S1, a missing individual response is recorded separately; review available responses as a partial task. Mark the whole task unsubmitted only if no response is submitted. A technical failure needs rerecording rather than an automatic zero."}}, {"id": "W2", "section": "writing", "type": "profile-or-day-description", "title": "Introduce a student", "promptEn": "Use the fictional profile below to introduce Lin An in Chinese. Include the person’s name and age, school and class starting time, and at least one preference. Write connected simple sentences. About 40-70 Chinese characters is a guide, not a minimum. Do not substitute your own private information.", "stimulus": {"zh-Hans": "姓名：林安\n年龄：十六岁\n学校：明华学校\n上课：上午九点\n喜欢：画画、米饭\n不喜欢：咖啡", "zh-Hant": "姓名：林安\n年齡：十六歲\n學校：明華學校\n上課：上午九點\n喜歡：畫畫、米飯\n不喜歡：咖啡"}, "requirements": ["Identify Lin An by name and age.", "Give the school and the class starting time.", "State at least one preference consistently with the card."], "reference": {"zh-Hans": "这是林安，今年十六岁。林安在明华学校上学，上午九点开始上课。林安喜欢画画，也喜欢吃米饭。林安不喜欢喝咖啡。", "zh-Hant": "這是林安，今年十六歲。林安在明華學校上學，上午九點開始上課。林安喜歡畫畫，也喜歡喫米飯。林安不喜歡喝咖啡。"}, "reviewNotes": ["All facts come from the fictional card; gender need not be inferred.", "Any one listed preference meets that requirement.", "A list copied without sentences gives less evidence of organization; do not impose an arbitrary length penalty."], "suggestedHanzi": [40, 70], "enforcedMinimum": null, "sharedTimingGroup": "writing", "rubric": {"maxPoints": 8, "dimensions": [{"id": "completion", "name": "任务完成", "levels": {"0": "无相关可评内容。", "1": "回应部分要求，遗漏关键信息。", "2": "以初阶表达回应主要要求。"}}, {"id": "comprehensibility", "name": "可理解性", "levels": {"0": "大部分意思无法恢复。", "1": "部分需借助上下文猜测。", "2": "主要意思能够理解。"}}, {"id": "language", "name": "基础语言运用", "levels": {"0": "缺少可用于表达目标意思的中文。", "1": "有限词句传达部分意思，错误有时干扰。", "2": "简单词句基本适合情境，允许初阶错误。"}}, {"id": "organization", "name": "组织／相关回应", "levels": {"0": "缺乏可辨关系或相关回应。", "1": "有部分顺序或相关回应。", "2": "简单但连贯，回应相关、易于跟随。"}}], "missing": "unsubmitted", "technicalFailure": "needs_rerecording", "automaticGrade": false, "reviewerOptions": ["self", "own_teacher"], "teacherServiceIncluded": false, "notes": "One profile per task. Accent similarity to native speakers and suggested length are not scoring criteria. For S1, a missing individual response is recorded separately; review available responses as a partial task. Mark the whole task unsubmitted only if no response is submitted. A technical failure needs rerecording rather than an automatic zero."}}, {"id": "S1", "section": "speaking", "type": "simulated-guided-exchange", "title": "Meet a classmate", "promptEn": "Respond in Chinese to four recorded prompts. Each prompt plays twice, followed by 10 seconds to prepare and up to 20 seconds to record. Use real or invented information. The four responses form ONE task, reviewed together out of eight. These are fixed prompts, not an adaptive conversation.", "scenarioEn": "A new classmate asks about you and proposes an activity. Listen to the questions rather than reading their transcripts.", "exchanges": [{"id": "S1-1", "speaker": "female", "prompt": {"zh-Hans": "你好！你叫什么名字？今年多大？", "zh-Hant": "你好！你叫什麼名字？今年多大？"}, "reference": {"zh-Hans": "你好，我叫李安，今年十六岁。", "zh-Hant": "你好，我叫李安，今年十六歲。"}, "checklist": ["Give a name and an age; invented details are acceptable."]}, {"id": "S1-2", "speaker": "female", "prompt": {"zh-Hans": "你喜欢吃什么？喜欢喝什么？", "zh-Hant": "你喜歡喫什麼？喜歡喝什麼？"}, "reference": {"zh-Hans": "我喜欢吃面条，喜欢喝牛奶。", "zh-Hant": "我喜歡喫麪條，喜歡喝牛奶。"}, "checklist": ["Give a food and a drink preference."]}, {"id": "S1-3", "speaker": "female", "prompt": {"zh-Hans": "你早上几点去学校？几点上课？", "zh-Hant": "你早上幾點去學校？幾點上課？"}, "reference": {"zh-Hans": "我七点半去学校，八点上课。", "zh-Hant": "我七點半去學校，八點上課。"}, "checklist": ["Respond with a travel time and a class time."]}, {"id": "S1-4", "speaker": "female", "prompt": {"zh-Hans": "星期六一起去公园，好吗？你几点有空？", "zh-Hant": "星期六一起去公園，好嗎？你幾點有空？"}, "reference": {"zh-Hans": "好啊！我星期六下午两点有空。", "zh-Hant": "好啊！我星期六下午兩點有空。"}, "alternateReference": {"zh-Hans": "对不起，星期六我有课。星期天下午可以吗？", "zh-Hant": "對不起，星期六我有課。星期天下午可以嗎？"}, "checklist": ["Accept with a time, or decline and suggest an alternative."]}], "playsPerPrompt": 2, "preparationSecondsPerPrompt": 10, "responseSecondsPerPrompt": 20, "rubricScope": "all_four_responses_together", "rubric": {"maxPoints": 8, "dimensions": [{"id": "completion", "name": "任务完成", "levels": {"0": "无相关可评内容。", "1": "回应部分要求，遗漏关键信息。", "2": "以初阶表达回应主要要求。"}}, {"id": "comprehensibility", "name": "可理解性", "levels": {"0": "大部分意思无法恢复。", "1": "部分需借助上下文猜测。", "2": "主要意思能够理解。"}}, {"id": "language", "name": "基础语言运用", "levels": {"0": "缺少可用于表达目标意思的中文。", "1": "有限词句传达部分意思，错误有时干扰。", "2": "简单词句基本适合情境，允许初阶错误。"}}, {"id": "organization", "name": "组织／相关回应", "levels": {"0": "缺乏可辨关系或相关回应。", "1": "有部分顺序或相关回应。", "2": "简单但连贯，回应相关、易于跟随。"}}], "missing": "unsubmitted", "technicalFailure": "needs_rerecording", "automaticGrade": false, "reviewerOptions": ["self", "own_teacher"], "teacherServiceIncluded": false, "notes": "One profile per task. Accent similarity to native speakers and suggested length are not scoring criteria. For S1, a missing individual response is recorded separately; review available responses as a partial task. Mark the whole task unsubmitted only if no response is submitted. A technical failure needs rerecording rather than an automatic zero."}}, {"id": "S2", "section": "speaking", "type": "short-presentation", "title": "Tell a classmate about a school day", "promptEn": "Introduce the fictional student’s day in Chinese using the card. Include who the student is, when and where the student studies, and one after-school activity. You have 60 seconds to prepare and up to 60 seconds to speak. Simple sentences are enough; no minimum recording length is enforced.", "stimulus": {"zh-Hans": "姓名：王宁\n学校：明华学校\n八点：在学校上课\n十二点：吃午饭\n下午三点：下课\n下课后：去公园走走", "zh-Hant": "姓名：王寧\n學校：明華學校\n八點：在學校上課\n十二點：喫午飯\n下午三點：下課\n下課後：去公園走走"}, "requirements": ["Identify Wang Ning.", "Give the school and at least one class time from the card.", "Describe the after-school activity."], "reference": {"zh-Hans": "这是王宁。王宁在明华学校上学，早上八点开始上课。十二点吃午饭，下午三点下课。下课以后，王宁去公园走走。", "zh-Hant": "這是王寧。王寧在明華學校上學，早上八點開始上課。十二點喫午飯，下午三點下課。下課以後，王寧去公園走走。"}, "reviewNotes": ["Not all times must be recited to meet the task.", "Short comprehensible sentences are sufficient; a native-like accent or a full sixty-second answer is not required."], "preparationSeconds": 60, "responseSeconds": 60, "rubric": {"maxPoints": 8, "dimensions": [{"id": "completion", "name": "任务完成", "levels": {"0": "无相关可评内容。", "1": "回应部分要求，遗漏关键信息。", "2": "以初阶表达回应主要要求。"}}, {"id": "comprehensibility", "name": "可理解性", "levels": {"0": "大部分意思无法恢复。", "1": "部分需借助上下文猜测。", "2": "主要意思能够理解。"}}, {"id": "language", "name": "基础语言运用", "levels": {"0": "缺少可用于表达目标意思的中文。", "1": "有限词句传达部分意思，错误有时干扰。", "2": "简单词句基本适合情境，允许初阶错误。"}}, {"id": "organization", "name": "组织／相关回应", "levels": {"0": "缺乏可辨关系或相关回应。", "1": "有部分顺序或相关回应。", "2": "简单但连贯，回应相关、易于跟随。"}}], "missing": "unsubmitted", "technicalFailure": "needs_rerecording", "automaticGrade": false, "reviewerOptions": ["self", "own_teacher"], "teacherServiceIncluded": false, "notes": "One profile per task. Accent similarity to native speakers and suggested length are not scoring criteria. For S1, a missing individual response is recorded separately; review available responses as a partial task. Mark the whole task unsubmitted only if no response is submitted. A technical failure needs rerecording rather than an automatic zero."}}], "instructions": {"en": "Choose one of three answers for each listening or reading question. Listening sources play twice in the timed track. Writing tasks share 15 minutes. Oral responses are recorded separately; they need self-review or review by your own teacher. No automatic writing/speaking grade or teacher-marking service is included. Use invented personal details if preferred.", "zh": "听读每题三选一。计时听力每段两遍。写作两题共用十五分钟。口语分别录音，口写用量表自评或交由自己的教师评阅，不自动批改，不包含本站人工代评。个人资料可以虚构。"}, "vocabularySupport": [{"term": {"zh-Hans": "铅笔", "zh-Hant": "鉛筆"}, "pinyin": "qiānbǐ", "meaningEn": "pencil"}, {"term": {"zh-Hans": "钢笔", "zh-Hant": "鋼筆"}, "pinyin": "gāngbǐ", "meaningEn": "pen"}, {"term": {"zh-Hans": "教室", "zh-Hant": "教室"}, "pinyin": "jiàoshì", "meaningEn": "classroom"}, {"term": {"zh-Hans": "图书馆", "zh-Hant": "圖書館"}, "pinyin": "túshūguǎn", "meaningEn": "library"}, {"term": {"zh-Hans": "办公室", "zh-Hant": "辦公室"}, "pinyin": "bàngōngshì", "meaningEn": "office"}, {"term": {"zh-Hans": "食堂", "zh-Hant": "食堂"}, "pinyin": "shítáng", "meaningEn": "school canteen"}, {"term": {"zh-Hans": "衬衫", "zh-Hant": "襯衫"}, "pinyin": "chènshān", "meaningEn": "shirt"}, {"term": {"zh-Hans": "小号", "zh-Hant": "小號"}, "pinyin": "xiǎohào", "meaningEn": "small size"}, {"term": {"zh-Hans": "外套", "zh-Hant": "外套"}, "pinyin": "wàitào", "meaningEn": "coat"}, {"term": {"zh-Hans": "厚", "zh-Hant": "厚"}, "pinyin": "hòu", "meaningEn": "thick"}, {"term": {"zh-Hans": "薄", "zh-Hant": "薄"}, "pinyin": "báo", "meaningEn": "thin"}, {"term": {"zh-Hans": "帽子", "zh-Hant": "帽子"}, "pinyin": "màozi", "meaningEn": "hat"}, {"term": {"zh-Hans": "橙子", "zh-Hant": "橙子"}, "pinyin": "chéngzi", "meaningEn": "orange"}, {"term": {"zh-Hans": "公共汽车", "zh-Hant": "公共汽車"}, "pinyin": "gōnggòng qìchē", "meaningEn": "bus"}], "supportPolicy": "Optional vocabulary support is for preparation/practice. Do not include it in the timed learner paper or compare assisted and unassisted attempts as identical.", "nextAcceptance": ["Audio technical validation and actual pacing", "Human listening acceptance", "Independent teacher review of elementary load and item ambiguity", "Learner pilot; observed completion times", "Separate runtime integration and release validation"]}</script><script id="audio-data" type="application/json">{"paperId": "course-chinese-1-a-v1", "provider": "Edge TTS used at authoring time; playback uses local MP3 files, no runtime TTS service", "rate": "-8%", "voices": {"female": "zh-CN-XiaoxiaoNeural", "male": "zh-CN-YunxiNeural"}, "humanListeningAcceptance": false, "units": [{"id": "C1A-M01", "kind": "listening-source", "sourcePlays": 1, "script": [{"speaker": "male", "text": {"zh-Hans": "大家好，我叫王明。我今年十七岁，在明华学校上学。我哥哥十九岁，他在上海学习。", "zh-Hant": "大家好，我叫王明。我今年十七歲，在明華學校上學。我哥哥十九歲，他在上海學習。"}}], "sourceDurationSeconds": 9.624, "src": "assets/audio/c1a-m01.mp3", "durationSeconds": 10.176, "pcmSeconds": 10.124, "bytes": 81644, "sha256": "504fc708206515fdf3a50e6e33f1df4753da7683db9690f7a36d123dd1a04481"}, {"id": "C1A-M02", "kind": "listening-source", "sourcePlays": 1, "script": [{"speaker": "female", "text": {"zh-Hans": "我家有四个人。爸爸是老师，妈妈是医生。我和弟弟都是学生。妈妈每天早上八点去医院。", "zh-Hant": "我家有四個人。爸爸是老師，媽媽是醫生。我和弟弟都是學生。媽媽每天早上八點去醫院。"}}], "sourceDurationSeconds": 10.08, "src": "assets/audio/c1a-m02.mp3", "durationSeconds": 10.632, "pcmSeconds": 10.58, "bytes": 85292, "sha256": "fffbb9a4bafe658b5303b8e442aeffc3b9b9cf512ce4b6e38e23bb53b05aa410"}, {"id": "C1A-M03", "kind": "listening-source", "sourcePlays": 1, "script": [{"speaker": "male", "text": {"zh-Hans": "这是我妹妹的照片，她今年十五岁，喜欢唱歌。我弟弟只有九岁，喜欢画画。我每天和妹妹一起上学。", "zh-Hant": "這是我妹妹的照片，她今年十五歲，喜歡唱歌。我弟弟只有九歲，喜歡畫畫。我每天和妹妹一起上學。"}}], "sourceDurationSeconds": 10.632, "src": "assets/audio/c1a-m03.mp3", "durationSeconds": 11.184, "pcmSeconds": 11.132, "bytes": 89708, "sha256": "48dd4fd97f75de6bdc849f0589832667f59d5c9a5f5fd8d676bc8aa5239292be"}, {"id": "C1A-M04", "kind": "listening-source", "sourcePlays": 1, "script": [{"speaker": "female", "text": {"zh-Hans": "我叫李安，是韩国人。现在我在北京学中文。我们班的老师是中国人，我的好朋友是美国人。", "zh-Hant": "我叫李安，是韓國人。現在我在北京學中文。我們班的老師是中國人，我的好朋友是美國人。"}}], "sourceDurationSeconds": 10.176, "src": "assets/audio/c1a-m04.mp3", "durationSeconds": 10.728, "pcmSeconds": 10.676, "bytes": 86060, "sha256": "73d0c497297cee0fc57235d14c92d7fffca986214b27f591bb440023022cdafd"}, {"id": "C1A-M05", "kind": "listening-source", "sourcePlays": 1, "script": [{"speaker": "male", "text": {"zh-Hans": "我是明华学校的学生。今天是星期一，我在学校门口等朋友。她是新同学，今天第一次来这里上课。", "zh-Hant": "我是明華學校的學生。今天是星期一，我在學校門口等朋友。她是新同學，今天第一次來這裏上課。"}}], "sourceDurationSeconds": 9.984, "src": "assets/audio/c1a-m05.mp3", "durationSeconds": 10.536, "pcmSeconds": 10.484, "bytes": 84524, "sha256": "ba00accbf560d25183382cb5e07eec7467f9c0fe7cc7f883a9e89c42eee0be7c"}, {"id": "C1A-M06", "kind": "listening-source", "sourcePlays": 1, "script": [{"speaker": "female", "text": {"zh-Hans": "上课要用铅笔。你有铅笔吗？", "zh-Hant": "上課要用鉛筆。你有鉛筆嗎？"}}, {"speaker": "male", "text": {"zh-Hans": "我只有一支钢笔，没有铅笔。", "zh-Hant": "我只有一支鋼筆，沒有鉛筆。"}}, {"speaker": "female", "text": {"zh-Hans": "你可以先用我的，我有两支铅笔。", "zh-Hant": "你可以先用我的，我有兩支鉛筆。"}}], "sourceDurationSeconds": 11.62, "src": "assets/audio/c1a-m06.mp3", "durationSeconds": 12.168, "pcmSeconds": 12.12, "bytes": 97580, "sha256": "95781f85ada7797c0d9602f34590348177a5764edf93986105d7858d68db57e7"}, {"id": "C1A-M07", "kind": "listening-source", "sourcePlays": 1, "script": [{"speaker": "male", "text": {"zh-Hans": "你的中文书能借我看一下吗？", "zh-Hant": "你的中文書能借我看一下嗎？"}}, {"speaker": "female", "text": {"zh-Hans": "可以，书在桌子上。", "zh-Hant": "可以，書在桌子上。"}}, {"speaker": "male", "text": {"zh-Hans": "谢谢。我的中文书在家里，英语书在书包里。", "zh-Hant": "謝謝。我的中文書在家裏，英語書在書包裏。"}}], "sourceDurationSeconds": 12.028, "src": "assets/audio/c1a-m07.mp3", "durationSeconds": 12.576, "pcmSeconds": 12.528, "bytes": 100844, "sha256": "1e2eec65a5c1bc7032f2f913f44e37af9425f9ba3fa036b878bc8cdfe7127d6c"}, {"id": "C1A-M08", "kind": "listening-source", "sourcePlays": 1, "script": [{"speaker": "female", "text": {"zh-Hans": "老师，今天在哪儿上课？", "zh-Hant": "老師，今天在哪兒上課？"}}, {"speaker": "male", "text": {"zh-Hans": "在三楼的三零二教室，不是二楼。", "zh-Hant": "在三樓的三零二教室，不是二樓。"}}, {"speaker": "female", "text": {"zh-Hans": "好的，我现在去三楼等同学。", "zh-Hant": "好的，我現在去三樓等同學。"}}], "sourceDurationSeconds": 10.804, "src": "assets/audio/c1a-m08.mp3", "durationSeconds": 11.352, "pcmSeconds": 11.304, "bytes": 91052, "sha256": "47b35ff7b22673e9324709071ab945041e53d2a2304108afca7cf4e6537881d2"}, {"id": "C1A-M09", "kind": "listening-source", "sourcePlays": 1, "script": [{"speaker": "male", "text": {"zh-Hans": "下课后你去哪儿？去食堂吃饭吗？", "zh-Hant": "下課後你去哪兒？去食堂喫飯嗎？"}}, {"speaker": "female", "text": {"zh-Hans": "我先去图书馆借书，然后回家。今天我不在学校吃饭。", "zh-Hant": "我先去圖書館借書，然後回家。今天我不在學校喫飯。"}}], "sourceDurationSeconds": 10.934, "src": "assets/audio/c1a-m09.mp3", "durationSeconds": 11.496, "pcmSeconds": 11.434, "bytes": 92204, "sha256": "d82c5fae5c95ac088324f5aebdc6237da9777bfe478a7d4f895b70ed8ff3f303"}, {"id": "C1A-M10", "kind": "listening-source", "sourcePlays": 1, "script": [{"speaker": "female", "text": {"zh-Hans": "今天的中文课还是九点开始吗？", "zh-Hant": "今天的中文課還是九點開始嗎？"}}, {"speaker": "male", "text": {"zh-Hans": "不是，今天九点半开始，十点半下课。", "zh-Hant": "不是，今天九點半開始，十點半下課。"}}, {"speaker": "female", "text": {"zh-Hans": "好，那我九点二十到教室。", "zh-Hant": "好，那我九點二十到教室。"}}], "sourceDurationSeconds": 11.956, "src": "assets/audio/c1a-m10.mp3", "durationSeconds": 12.504, "pcmSeconds": 12.456, "bytes": 100268, "sha256": "ffe987b1f9a8dfc901be1809d440720352afce6778e0abdfb0ae823f0dfec4bd"}, {"id": "C1A-M11", "kind": "listening-source", "sourcePlays": 1, "script": [{"speaker": "male", "text": {"zh-Hans": "中午吃什么？你想吃面条吗？", "zh-Hant": "中午喫什麼？你想喫麪條嗎？"}}, {"speaker": "female", "text": {"zh-Hans": "晚上我想吃面条。现在我想吃米饭和鸡蛋，不想吃肉。", "zh-Hant": "晚上我想喫麪條。現在我想喫米飯和雞蛋，不想喫肉。"}}], "sourceDurationSeconds": 10.91, "src": "assets/audio/c1a-m11.mp3", "durationSeconds": 11.472, "pcmSeconds": 11.41, "bytes": 92012, "sha256": "0d33007d1c7c02be801d924f68cf981ee587dd387993dac0fe2d5224385cfc86"}, {"id": "C1A-M12", "kind": "listening-source", "sourcePlays": 1, "script": [{"speaker": "female", "text": {"zh-Hans": "早上妈妈喝茶，爸爸喝咖啡。我不喝茶，也不喝咖啡。我每天喝一杯牛奶，然后去上学。", "zh-Hant": "早上媽媽喝茶，爸爸喝咖啡。我不喝茶，也不喝咖啡。我每天喝一杯牛奶，然後去上學。"}}], "sourceDurationSeconds": 9.84, "src": "assets/audio/c1a-m12.mp3", "durationSeconds": 10.392, "pcmSeconds": 10.34, "bytes": 83372, "sha256": "bacadf9899a610dee290de227f156d24b8d59e6a3f13a2b159ef1410af2b2e6a"}, {"id": "C1A-M13", "kind": "listening-source", "sourcePlays": 1, "script": [{"speaker": "female", "text": {"zh-Hans": "你要几个苹果？", "zh-Hant": "你要幾個蘋果？"}}, {"speaker": "male", "text": {"zh-Hans": "我要四个苹果，再要两个香蕉。", "zh-Hant": "我要四個蘋果，再要兩個香蕉。"}}, {"speaker": "female", "text": {"zh-Hans": "好的，四个苹果、两个香蕉，放在这个袋子里。", "zh-Hant": "好的，四個蘋果、兩個香蕉，放在這個袋子裏。"}}], "sourceDurationSeconds": 11.236, "src": "assets/audio/c1a-m13.mp3", "durationSeconds": 11.784, "pcmSeconds": 11.736, "bytes": 94508, "sha256": "5fdbb5f6e3babd6675bc7192c6bfcb729e043cbbf1c36e7d7842bdaa12c57fff"}, {"id": "C1A-M14", "kind": "listening-source", "sourcePlays": 1, "script": [{"speaker": "male", "text": {"zh-Hans": "这份午饭多少钱？", "zh-Hant": "這份午飯多少錢？"}}, {"speaker": "female", "text": {"zh-Hans": "十二块。", "zh-Hant": "十二塊。"}}, {"speaker": "male", "text": {"zh-Hans": "给你二十块。", "zh-Hant": "給你二十塊。"}}, {"speaker": "female", "text": {"zh-Hans": "谢谢，找你八块。你的午饭在桌子上。", "zh-Hant": "謝謝，找你八塊。你的午飯在桌子上。"}}], "sourceDurationSeconds": 11.898, "src": "assets/audio/c1a-m14.mp3", "durationSeconds": 12.456, "pcmSeconds": 12.398, "bytes": 99884, "sha256": "de646b69b19f0a7b7f08fd5eb6a41563c813b715a9db8fbb44924e9f65271455"}, {"id": "C1A-M15", "kind": "listening-source", "sourcePlays": 1, "script": [{"speaker": "female", "text": {"zh-Hans": "你喜欢这件红色的衣服吗？", "zh-Hant": "你喜歡這件紅色的衣服嗎？"}}, {"speaker": "male", "text": {"zh-Hans": "我喜欢蓝色的，不喜欢红色的。蓝色这件也不大，我就买这件吧。", "zh-Hant": "我喜歡藍色的，不喜歡紅色的。藍色這件也不大，我就買這件吧。"}}], "sourceDurationSeconds": 9.926, "src": "assets/audio/c1a-m15.mp3", "durationSeconds": 10.488, "pcmSeconds": 10.426, "bytes": 84140, "sha256": "d49db9faa720ed3b602c2c158a1948ae2cc53bb185803c3e579b8a7f4fb701c5"}, {"id": "C1A-M16", "kind": "listening-source", "sourcePlays": 1, "script": [{"speaker": "male", "text": {"zh-Hans": "星期六一起去看电影，好吗？", "zh-Hant": "星期六一起去看電影，好嗎？"}}, {"speaker": "female", "text": {"zh-Hans": "星期六我要上课。星期天下午我有时间。", "zh-Hant": "星期六我要上課。星期天下午我有時間。"}}, {"speaker": "male", "text": {"zh-Hans": "好，我们星期天下午见。", "zh-Hant": "好，我們星期天下午見。"}}], "sourceDurationSeconds": 12.412, "src": "assets/audio/c1a-m16.mp3", "durationSeconds": 12.96, "pcmSeconds": 12.912, "bytes": 103916, "sha256": "16fc26724206bfff3a32b0c3e165bc923b0897b15926a13be300529733de8c72"}, {"id": "C1A-M17", "kind": "listening-source", "sourcePlays": 1, "script": [{"speaker": "female", "text": {"zh-Hans": "你早上几点出门？", "zh-Hant": "你早上幾點出門？"}}, {"speaker": "male", "text": {"zh-Hans": "我六点半起床，七点吃早饭，七点半出门。学校很近，八点以前就能到。", "zh-Hant": "我六點半起牀，七點喫早飯，七點半出門。學校很近，八點以前就能到。"}}], "sourceDurationSeconds": 10.574, "src": "assets/audio/c1a-m17.mp3", "durationSeconds": 11.136, "pcmSeconds": 11.074, "bytes": 89324, "sha256": "58717873d4b6010ce8b39d7be1b925ebca8889734a74470cf32f02912dd0b269"}, {"id": "C1A-M18", "kind": "listening-source", "sourcePlays": 1, "script": [{"speaker": "male", "text": {"zh-Hans": "今天外面很冷，你穿这件衣服去学校吗？", "zh-Hant": "今天外面很冷，你穿這件衣服去學校嗎？"}}, {"speaker": "female", "text": {"zh-Hans": "不穿这件薄的。我穿那件厚外套。", "zh-Hant": "不穿這件薄的。我穿那件厚外套。"}}, {"speaker": "male", "text": {"zh-Hans": "好，别忘了你的书包。", "zh-Hant": "好，別忘了你的書包。"}}], "sourceDurationSeconds": 12.244, "src": "assets/audio/c1a-m18.mp3", "durationSeconds": 12.792, "pcmSeconds": 12.744, "bytes": 102572, "sha256": "c7d51b8a47622d772e3f55ed1f942e49d85ce6fad6c075c1889854c683e95b08"}, {"id": "C1A-M19", "kind": "listening-source", "sourcePlays": 1, "script": [{"speaker": "female", "text": {"zh-Hans": "下午一起去打篮球吧？", "zh-Hant": "下午一起去打籃球吧？"}}, {"speaker": "male", "text": {"zh-Hans": "我不太会打篮球。我想去公园走走，你去吗？", "zh-Hant": "我不太會打籃球。我想去公園走走，你去嗎？"}}, {"speaker": "female", "text": {"zh-Hans": "好，我也想去公园。", "zh-Hant": "好，我也想去公園。"}}], "sourceDurationSeconds": 11.236, "src": "assets/audio/c1a-m19.mp3", "durationSeconds": 11.784, "pcmSeconds": 11.736, "bytes": 94508, "sha256": "c6fb3b2871c1eb740caeca7954eaa740b673e896cfaac5ae414deae7dfb2b83f"}, {"id": "C1A-M20", "kind": "listening-source", "sourcePlays": 1, "script": [{"speaker": "male", "text": {"zh-Hans": "周末你喜欢做什么？", "zh-Hant": "週末你喜歡做什麼？"}}, {"speaker": "female", "text": {"zh-Hans": "我喜欢画画，也喜欢听音乐。这周六下午我要在家画画。星期天再去听音乐。", "zh-Hant": "我喜歡畫畫，也喜歡聽音樂。這週六下午我要在家畫畫。星期天再去聽音樂。"}}], "sourceDurationSeconds": 11.846, "src": "assets/audio/c1a-m20.mp3", "durationSeconds": 12.408, "pcmSeconds": 12.346, "bytes": 99500, "sha256": "6a141d00f63d2303916f720e86007336875be6a3a7734ee146abe62eb3d3dc64"}, {"id": "S1-1", "kind": "oral-prompt", "sourcePlays": 2, "singlePlayPcmSeconds": 4.68, "repeatGapSeconds": 1.5, "singlePlayPcmSha256": "bd33f0a46e58e7f30a2f4ed247df26bf8bdced6361ef67de3b0efd88c0d74490", "script": {"zh-Hans": "你好！你叫什么名字？今年多大？", "zh-Hant": "你好！你叫什麼名字？今年多大？"}, "src": "assets/audio/s1-1.mp3", "durationSeconds": 10.92, "pcmSeconds": 10.86, "bytes": 87596, "sha256": "cc27866f92fa24028b87ef98cd6ccd754382c3bd6704c9c740520b19f92ccb96"}, {"id": "S1-2", "kind": "oral-prompt", "sourcePlays": 2, "singlePlayPcmSeconds": 3.744, "repeatGapSeconds": 1.5, "singlePlayPcmSha256": "b32df0af7421d5fbf7a9232797581a5658ac855f4e196c802a819e34a339385d", "script": {"zh-Hans": "你喜欢吃什么？喜欢喝什么？", "zh-Hant": "你喜歡喫什麼？喜歡喝什麼？"}, "src": "assets/audio/s1-2.mp3", "durationSeconds": 9.048, "pcmSeconds": 8.988, "bytes": 72620, "sha256": "ddf184601b95ab5f4448ee0238b77510316c2695a08da6165254cf70e03bd877"}, {"id": "S1-3", "kind": "oral-prompt", "sourcePlays": 2, "singlePlayPcmSeconds": 4.08, "repeatGapSeconds": 1.5, "singlePlayPcmSha256": "a1be6414f43a187d4f9e5e433e873c9e95746d22aaef48abdc9cf204877f3909", "script": {"zh-Hans": "你早上几点去学校？几点上课？", "zh-Hant": "你早上幾點去學校？幾點上課？"}, "src": "assets/audio/s1-3.mp3", "durationSeconds": 9.72, "pcmSeconds": 9.66, "bytes": 77996, "sha256": "64f5c8b56d36df555ddc76f5824ce4320f43dfdfe07886263dbbf6fde6e2b544"}, {"id": "S1-4", "kind": "oral-prompt", "sourcePlays": 2, "singlePlayPcmSeconds": 4.8, "repeatGapSeconds": 1.5, "singlePlayPcmSha256": "dae72bcab24634e8c3f499ca3ed1edab58a0f39d16f6e6ec38a74831dd980bb3", "script": {"zh-Hans": "星期六一起去公园，好吗？你几点有空？", "zh-Hant": "星期六一起去公園，好嗎？你幾點有空？"}, "src": "assets/audio/s1-4.mp3", "durationSeconds": 11.16, "pcmSeconds": 11.1, "bytes": 89516, "sha256": "c6abf0a3bcdc61d2e0cb9195e8dc741feb00ed32ece322a6b1887d6dbce319ba"}], "groups": [{"id": "L1", "sourcePlays": 2, "src": "assets/audio/listening-group-1.mp3", "durationSeconds": 225.048, "pcmSeconds": 225.0, "bytes": 1800620, "sha256": "230fab80a1097cc63956746255dc6e5a7e20db80de4156ebbcc88db032317184"}, {"id": "L2", "sourcePlays": 2, "src": "assets/audio/listening-group-2.mp3", "durationSeconds": 225.048, "pcmSeconds": 225.0, "bytes": 1800620, "sha256": "7055f79b99bb812b948b13331127b0e29cd4007f79130a4a2d6fd39b3a61022a"}, {"id": "L3", "sourcePlays": 2, "src": "assets/audio/listening-group-3.mp3", "durationSeconds": 225.048, "pcmSeconds": 225.0, "bytes": 1800620, "sha256": "2834476218887a7fb8fc30e10d6846b5fa8069c7d2e66365c883b56cdcf5db29"}, {"id": "L4", "sourcePlays": 2, "src": "assets/audio/listening-group-4.mp3", "durationSeconds": 225.048, "pcmSeconds": 225.0, "bytes": 1800620, "sha256": "3e6b4b633d089778e4cacbb44317a7ffbf02d00100bccf980fba1d5bfe52d9cc"}], "timedTrack": {"src": "assets/audio/listening-full.mp3", "durationSeconds": 900.048, "pcmSeconds": 900.0, "bytes": 7200620, "sha256": "5b0911dcb1fa80cd15def7382f9d700ec04f29b5e5c17367d9f883f982aaf6fb"}, "timeline": [{"id": "C1A-M01", "questionNumber": 1, "labelStartSeconds": 7.912, "firstPlayStartSeconds": 9.948, "secondPlayStartSeconds": 21.072, "speechEndSeconds": 30.696, "answerWindowSeconds": 20.634, "slotEndSeconds": 51.33, "sourcePlays": 2}, {"id": "C1A-M02", "questionNumber": 2, "labelStartSeconds": 51.33, "firstPlayStartSeconds": 53.342, "secondPlayStartSeconds": 64.922, "speechEndSeconds": 75.002, "answerWindowSeconds": 19.746, "slotEndSeconds": 94.747, "sourcePlays": 2}, {"id": "C1A-M03", "questionNumber": 3, "labelStartSeconds": 94.747, "firstPlayStartSeconds": 96.879, "secondPlayStartSeconds": 109.011, "speechEndSeconds": 119.643, "answerWindowSeconds": 18.522, "slotEndSeconds": 138.165, "sourcePlays": 2}, {"id": "C1A-M04", "questionNumber": 4, "labelStartSeconds": 138.165, "firstPlayStartSeconds": 140.297, "secondPlayStartSeconds": 151.973, "speechEndSeconds": 162.149, "answerWindowSeconds": 19.434, "slotEndSeconds": 181.582, "sourcePlays": 2}, {"id": "C1A-M05", "questionNumber": 5, "labelStartSeconds": 181.582, "firstPlayStartSeconds": 183.642, "secondPlayStartSeconds": 195.126, "speechEndSeconds": 205.11, "answerWindowSeconds": 19.89, "slotEndSeconds": 225.0, "sourcePlays": 2}, {"id": "C1A-M06", "questionNumber": 6, "labelStartSeconds": 232.936, "firstPlayStartSeconds": 235.044, "secondPlayStartSeconds": 248.164, "speechEndSeconds": 259.784, "answerWindowSeconds": 16.565, "slotEndSeconds": 276.349, "sourcePlays": 2}, {"id": "C1A-M07", "questionNumber": 7, "labelStartSeconds": 276.349, "firstPlayStartSeconds": 278.457, "secondPlayStartSeconds": 291.985, "speechEndSeconds": 304.013, "answerWindowSeconds": 15.749, "slotEndSeconds": 319.762, "sourcePlays": 2}, {"id": "C1A-M08", "questionNumber": 8, "labelStartSeconds": 319.762, "firstPlayStartSeconds": 321.846, "secondPlayStartSeconds": 334.15, "speechEndSeconds": 344.954, "answerWindowSeconds": 18.221, "slotEndSeconds": 363.174, "sourcePlays": 2}, {"id": "C1A-M09", "questionNumber": 9, "labelStartSeconds": 363.174, "firstPlayStartSeconds": 365.258, "secondPlayStartSeconds": 377.692, "speechEndSeconds": 388.626, "answerWindowSeconds": 17.961, "slotEndSeconds": 406.587, "sourcePlays": 2}, {"id": "C1A-M10", "questionNumber": 10, "labelStartSeconds": 406.587, "firstPlayStartSeconds": 408.743, "secondPlayStartSeconds": 422.199, "speechEndSeconds": 434.155, "answerWindowSeconds": 15.845, "slotEndSeconds": 450.0, "sourcePlays": 2}, {"id": "C1A-M11", "questionNumber": 11, "labelStartSeconds": 458.032, "firstPlayStartSeconds": 460.308, "secondPlayStartSeconds": 472.718, "speechEndSeconds": 483.628, "answerWindowSeconds": 17.798, "slotEndSeconds": 501.426, "sourcePlays": 2}, {"id": "C1A-M12", "questionNumber": 12, "labelStartSeconds": 501.426, "firstPlayStartSeconds": 503.702, "secondPlayStartSeconds": 515.042, "speechEndSeconds": 524.882, "answerWindowSeconds": 19.938, "slotEndSeconds": 544.819, "sourcePlays": 2}, {"id": "C1A-M13", "questionNumber": 13, "labelStartSeconds": 544.819, "firstPlayStartSeconds": 547.143, "secondPlayStartSeconds": 559.879, "speechEndSeconds": 571.115, "answerWindowSeconds": 17.098, "slotEndSeconds": 588.213, "sourcePlays": 2}, {"id": "C1A-M14", "questionNumber": 14, "labelStartSeconds": 588.213, "firstPlayStartSeconds": 590.561, "secondPlayStartSeconds": 603.959, "speechEndSeconds": 615.857, "answerWindowSeconds": 15.75, "slotEndSeconds": 631.606, "sourcePlays": 2}, {"id": "C1A-M15", "questionNumber": 15, "labelStartSeconds": 631.606, "firstPlayStartSeconds": 633.882, "secondPlayStartSeconds": 645.308, "speechEndSeconds": 655.234, "answerWindowSeconds": 19.766, "slotEndSeconds": 675.0, "sourcePlays": 2}, {"id": "C1A-M16", "questionNumber": 16, "labelStartSeconds": 683.032, "firstPlayStartSeconds": 685.38, "secondPlayStartSeconds": 699.292, "speechEndSeconds": 711.704, "answerWindowSeconds": 14.722, "slotEndSeconds": 726.426, "sourcePlays": 2}, {"id": "C1A-M17", "questionNumber": 17, "labelStartSeconds": 726.426, "firstPlayStartSeconds": 728.774, "secondPlayStartSeconds": 740.848, "speechEndSeconds": 751.422, "answerWindowSeconds": 18.398, "slotEndSeconds": 769.819, "sourcePlays": 2}, {"id": "C1A-M18", "questionNumber": 18, "labelStartSeconds": 769.819, "firstPlayStartSeconds": 772.119, "secondPlayStartSeconds": 785.863, "speechEndSeconds": 798.107, "answerWindowSeconds": 15.106, "slotEndSeconds": 813.213, "sourcePlays": 2}, {"id": "C1A-M19", "questionNumber": 19, "labelStartSeconds": 813.213, "firstPlayStartSeconds": 815.537, "secondPlayStartSeconds": 828.273, "speechEndSeconds": 839.509, "answerWindowSeconds": 17.098, "slotEndSeconds": 856.606, "sourcePlays": 2}, {"id": "C1A-M20", "questionNumber": 20, "labelStartSeconds": 856.606, "firstPlayStartSeconds": 858.834, "secondPlayStartSeconds": 872.18, "speechEndSeconds": 884.026, "answerWindowSeconds": 15.974, "slotEndSeconds": 900.0, "sourcePlays": 2}], "cache": [{"key": "4e99c6749e73ecc0d302020a", "speaker": "female", "text": "中文一，A卷，听力第1组。每段听两遍，请选择一个答案。", "sha256": "a0730d92359e67bbe2f2a75f52e3cf3096609eb93a4093979eece83b15d1ff30"}, {"key": "1aa90443b1e599a587e3593d", "speaker": "female", "text": "中文一，A卷，听力第2组。每段听两遍，请选择一个答案。", "sha256": "47afef82afdded5c6b3458e379404d07749cd53daa8e09db3262fc74e7534a1b"}, {"key": "c35f62cb365c6a5694d6bbb7", "speaker": "female", "text": "中文一，A卷，听力第3组。每段听两遍，请选择一个答案。", "sha256": "2037936776fa5aefeb5194ce22028a82e46e2485db1c5ae0466a2cc70c419db8"}, {"key": "2ae9831cf6c24a8d8d74cbfb", "speaker": "female", "text": "中文一，A卷，听力第4组。每段听两遍，请选择一个答案。", "sha256": "ec54db2edd28e7271e3dbd61873cc8e2160074e412d479588b61df20a1dbd532"}, {"key": "66e938a39710225cd0a2b3d4", "speaker": "male", "text": "大家好，我叫王明。我今年十七岁，在明华学校上学。我哥哥十九岁，他在上海学习。", "sha256": "6008cf7be56e0777ea3ca3a3ef523d70d7d208e4b9d742761201abe479dca756"}, {"key": "34e89f8d03ace2b111d8dc37", "speaker": "female", "text": "第1题。", "sha256": "3895df58b8b6ce61365216490dcb339db3aa7ef168eef8d2098c469073a4cdc2"}, {"key": "485bfa8504d75c46358bc0d4", "speaker": "female", "text": "我家有四个人。爸爸是老师，妈妈是医生。我和弟弟都是学生。妈妈每天早上八点去医院。", "sha256": "52afc1322c8ebf978a7b2951c9e138ef05ba72ae73ff1540ccd597d55836a38c"}, {"key": "1741fb60958696627ba5f0ed", "speaker": "female", "text": "第2题。", "sha256": "39f2c75a46983608745be0da5fe2130f1e77b5cd88f7b9b3928a0a06485a2744"}, {"key": "ee1794a61e72a4eaaad5d968", "speaker": "male", "text": "这是我妹妹的照片，她今年十五岁，喜欢唱歌。我弟弟只有九岁，喜欢画画。我每天和妹妹一起上学。", "sha256": "298985bc2427dcc6f1b1f0f175dbf94f43853193e06ed9d5598b419cf26f4c5e"}, {"key": "97e9c8d06f3e0171388ee24b", "speaker": "female", "text": "第3题。", "sha256": "74d7fdba0fd9fae146470574deadbd8616eca796fece18aaf8190b3792f4225e"}, {"key": "0414d0616ef624e98a0d98a1", "speaker": "female", "text": "我叫李安，是韩国人。现在我在北京学中文。我们班的老师是中国人，我的好朋友是美国人。", "sha256": "f090aab2a757557991273902f8f84554819a4b56c3d6304a368e7b84e7dc2f82"}, {"key": "b25d3caab3d72c3d0347de4b", "speaker": "female", "text": "第4题。", "sha256": "cc38e6d168e0664b2b8f98558b26288abcea294390f4e9aa13d8f457ef5a7046"}, {"key": "5aa519c809109324aeee5432", "speaker": "male", "text": "我是明华学校的学生。今天是星期一，我在学校门口等朋友。她是新同学，今天第一次来这里上课。", "sha256": "2f7025c60ed53874522e9b9d9c3e996a747fdd913a302dd1ab767cf01c1f0d9f"}, {"key": "c5b1d9675aba74bbd668ea00", "speaker": "female", "text": "第5题。", "sha256": "057a4202f7d25216a190a84d6056c30f42be93ac60cdc21879a97aaaf19252d9"}, {"key": "7d5261594c3ae5ec7e9b04b0", "speaker": "female", "text": "上课要用铅笔。你有铅笔吗？", "sha256": "48bb7a0fcf94ea5e54e0ca70d61535f6a655e529181e3f9b13f33b683a7e25db"}, {"key": "516d95571f216ce5777207aa", "speaker": "male", "text": "我只有一支钢笔，没有铅笔。", "sha256": "289bab570be863ef92de75661d20cb3e7022c48dbe7875d5ac665ba91de0d17f"}, {"key": "8f1a2716953e1d77036ced94", "speaker": "female", "text": "你可以先用我的，我有两支铅笔。", "sha256": "b5f8017b9d5aff9548e0b2f1798c39260965ead093499d7c78aea072de480120"}, {"key": "5e6c5b336701fe2c48b7fa2f", "speaker": "female", "text": "第6题。", "sha256": "fcc5b0fabad8f1fa79148054a17b60ac8d2cb351d57ed0d5eb073df550e3ee93"}, {"key": "519585a633548c6e14abf107", "speaker": "male", "text": "你的中文书能借我看一下吗？", "sha256": "93aab6f5b70fe2518c7c6b9211d32d837794200b47ecd18d3d8c6f4e5409bfa0"}, {"key": "b43a9d0913e6eb5543c158c0", "speaker": "female", "text": "可以，书在桌子上。", "sha256": "bc3b7550bdc05edea960e76592c69cf0e39489cb757ab141d39a1cdbd6efc383"}, {"key": "cda4efff1a384b7d082acb32", "speaker": "male", "text": "谢谢。我的中文书在家里，英语书在书包里。", "sha256": "52b003070fa3db69e62c5b4d17dd4ff3ec9467f87012ca6ffc200222183b22c0"}, {"key": "79e0bdfd02236c1d4253adc0", "speaker": "female", "text": "第7题。", "sha256": "5151859d99f51fb43c1c4ba74a72c7d8898fd12ebdb151ca350243f27169a52c"}, {"key": "47481ac1ff573d6d04a1dd70", "speaker": "female", "text": "老师，今天在哪儿上课？", "sha256": "1f342640de3d9745eefe4efbee4bab3466435fffa88edb2c85ffb5416918baa1"}, {"key": "7088fd1479bce009ccfbf503", "speaker": "male", "text": "在三楼的三零二教室，不是二楼。", "sha256": "4d32fcfe4998f393526b51a4294c245988b4664294d2910341ccd7eb4459e616"}, {"key": "688e32dec4bcd66143fe5a90", "speaker": "female", "text": "好的，我现在去三楼等同学。", "sha256": "ce0e7df52199d17125ced1b02adb047c30526c15380cf79f8b39e8d184872c89"}, {"key": "b431efe26b8c6cc712ef43b8", "speaker": "female", "text": "第8题。", "sha256": "65ff1f952179bc643f6b488a3150eee5a21667f5901053151fd7aeb53f0c7786"}, {"key": "493f5e960a80f962b959edd2", "speaker": "male", "text": "下课后你去哪儿？去食堂吃饭吗？", "sha256": "d63be4f6215fc17281a189641097724bb08e8401446c6dc75422da2967ce9e44"}, {"key": "232d62dd60b1e0984db9ea64", "speaker": "female", "text": "我先去图书馆借书，然后回家。今天我不在学校吃饭。", "sha256": "f4413acf4cb44e93e6ae9912b65f9c0b2c95ebd911c97870072dbd3294ca2bdc"}, {"key": "76f9b7034e5801a6360f40bd", "speaker": "female", "text": "第9题。", "sha256": "439f37e4f9738e7ac1dc180f588ae4ed900731c0623d4038b9f3533da20c0ada"}, {"key": "5e178373328b95e4859ab75f", "speaker": "female", "text": "今天的中文课还是九点开始吗？", "sha256": "410b1120a6e512b5a5747aa21296acaad4d9210c6d5032ea5af9c2f227b36f50"}, {"key": "6eb61db38bcee2be8b8e052b", "speaker": "male", "text": "不是，今天九点半开始，十点半下课。", "sha256": "d743ee52443014a3b10ee2a7d2c09fa3d1a658c8f006db1b16f2f026aa9d8e1c"}, {"key": "de1784be226867be04922bc5", "speaker": "female", "text": "好，那我九点二十到教室。", "sha256": "53385b2b90e5a4ca6854fa223aaad4036f05e48c1cf85ebbd2116e9ea426d185"}, {"key": "86d64da7bc27367110de5cb7", "speaker": "female", "text": "第10题。", "sha256": "a443b83201af7bae91780e167c2fcd53ef523b448bf77dd4ad6b238de2e582d2"}, {"key": "b3ee81f3d9ce042a862a46c3", "speaker": "male", "text": "中午吃什么？你想吃面条吗？", "sha256": "3948355b52059c6f3321ee4f5b229b360ff6e894a644c77057913f9e1868bb79"}, {"key": "41b3d452c203c60d7a90f3ab", "speaker": "female", "text": "晚上我想吃面条。现在我想吃米饭和鸡蛋，不想吃肉。", "sha256": "ecaa3a1f5437182a689fe7470a6154ffb562a2ed8e2893885d4c28df67cdbae1"}, {"key": "63d3dd3f27ad85dca9aa0606", "speaker": "female", "text": "第11题。", "sha256": "09609165ce7b5b5bbc80de6236e7726415e2ab45d65241e1ca3c75ec4a697f32"}, {"key": "76fa11a20536912cacd07777", "speaker": "female", "text": "早上妈妈喝茶，爸爸喝咖啡。我不喝茶，也不喝咖啡。我每天喝一杯牛奶，然后去上学。", "sha256": "5fee34e52935f552aa3621a7a21e791781e044817d021ecef7c5ac394e381846"}, {"key": "2dbff9b332f7edc61b4c3c18", "speaker": "female", "text": "第12题。", "sha256": "f25ea7d43ed9f81b7dd1af25fa0339498c7d458e79931122755e838f8d314a83"}, {"key": "afabc0fe6311163b81dee9fa", "speaker": "female", "text": "你要几个苹果？", "sha256": "799da6b7d5f0bcbfac8031a145703fba43846bd3283eafed7d373a9c0aa5cb29"}, {"key": "d42c4203a26a67c2aea5df42", "speaker": "male", "text": "我要四个苹果，再要两个香蕉。", "sha256": "1a24876cd26ac00e03715d8a48ec1c59f4ae1f8dc370091be1da56e12c4cfc57"}, {"key": "8ae1db41def055adb9ac0a8c", "speaker": "female", "text": "好的，四个苹果、两个香蕉，放在这个袋子里。", "sha256": "3fbb259017bb62a833e76c5218d0064f76598a5423a6742f4534ba2e3b2b9695"}, {"key": "ec1acc6c51d958bc6eb290a5", "speaker": "female", "text": "第13题。", "sha256": "e6515323a9eef38c0320124c2e99d81f002d229d597de7f44a76008521622c43"}, {"key": "13f317c74d643a0cf9530a17", "speaker": "male", "text": "这份午饭多少钱？", "sha256": "c4a9c0b6a8a6619bb1d43c13f40de6dccb7ea8b2ee733dfc4678e7cf85279f64"}, {"key": "7f11a494f94072c075f3f7f3", "speaker": "female", "text": "十二块。", "sha256": "a0a7d060391629df9ef2aa85163ec6cbf250729efa36626aefc2906af1efe4a9"}, {"key": "06e5fd2f240fcc6b89961a20", "speaker": "male", "text": "给你二十块。", "sha256": "59c506155db8c23873943f9182b605295d4974a8227dc6f506b745e392b63083"}, {"key": "bfdb9bf238c77c3cf027c98e", "speaker": "female", "text": "谢谢，找你八块。你的午饭在桌子上。", "sha256": "a7f6e73bf82203e77ae012089445512c0d34334f0388d65a07e7f31ed5ee986b"}, {"key": "6a9458d981e42c448c56e5d7", "speaker": "female", "text": "第14题。", "sha256": "3c248ca1222db546caafa3ccef0afeb1d63689c8e501a91b906f7c38012bc8f4"}, {"key": "9d1a7ed6e49a574f0a43a1ce", "speaker": "female", "text": "你喜欢这件红色的衣服吗？", "sha256": "326e63ffc428ad687aa16b4c6e5f519168950f16372b98207610ea5947b4180b"}, {"key": "0f490f354e1f1bfae100de38", "speaker": "male", "text": "我喜欢蓝色的，不喜欢红色的。蓝色这件也不大，我就买这件吧。", "sha256": "6497f3de739da64ca78b7dd4a4bbd4311cbe92c90fe81a453646f1006220f8ff"}, {"key": "9d1b8c046279c5b498214791", "speaker": "female", "text": "第15题。", "sha256": "774136cf8893575562e62fc53ca824d970e119df2986004fbc9a795341529ed7"}, {"key": "eefc18ff88d790d66038989e", "speaker": "male", "text": "星期六一起去看电影，好吗？", "sha256": "2c27fc8fc9eb849ae88339c721b2c299fe14a4f1001308a468d3b2686258a4cf"}, {"key": "c96c97901884928a6a4868e7", "speaker": "female", "text": "星期六我要上课。星期天下午我有时间。", "sha256": "304557f99c568e830f7ac61b1aa071b32612a4ced8cbaf37c488b2173c0b4d4d"}, {"key": "6c2d84bdbd272e28b8be59bf", "speaker": "male", "text": "好，我们星期天下午见。", "sha256": "f8078216aea2b35d23a96b823d4332340f13229f2a3007659a7918fed5834efb"}, {"key": "0cffbf1010d1e54023057ea9", "speaker": "female", "text": "第16题。", "sha256": "6cbe22b4463ef0127dbcb5957919648ee9b071c97d70d0b85edf327b6a0071df"}, {"key": "4b2983937fabfaed299be0cc", "speaker": "female", "text": "你早上几点出门？", "sha256": "62e8d7abdf7fe77060b9e16da3c073ec4b162e367fc71de5999ee45631feb5f3"}, {"key": "7cd8ad81a359c89eb734de57", "speaker": "male", "text": "我六点半起床，七点吃早饭，七点半出门。学校很近，八点以前就能到。", "sha256": "bb81236552ac830d59b76390948885b9cadbcb6d1ac8f6508885dde93df7b632"}, {"key": "61f4d2e4e5f3e0536be36453", "speaker": "female", "text": "第17题。", "sha256": "7b303e3cdea4e6b338b981ca7d27218c5da50fd4e2ca1cb297c3ba0853fbff6b"}, {"key": "84f27c8c7fe5f52c1190bd9c", "speaker": "male", "text": "今天外面很冷，你穿这件衣服去学校吗？", "sha256": "6a793ca40619cb1fbde9537ccb22fd03450538f8eba9b0924787ab486f81a823"}, {"key": "acf7efa4cf3fb3b80dda5c52", "speaker": "female", "text": "不穿这件薄的。我穿那件厚外套。", "sha256": "5d086864936d5065eb1b53b59521aaef4e3374aaee620f281e637936830cd0f8"}, {"key": "41c10ff12f088b73fd31a95e", "speaker": "male", "text": "好，别忘了你的书包。", "sha256": "6c04329756c42f3dc39f1631502e086439e743e6b3adf257b2bf626cc7c33a5f"}, {"key": "2e9092b1191d42999a9f695d", "speaker": "female", "text": "第18题。", "sha256": "b0832c56a97774c35b538f689f08bf8314e263e14ab809871867bcdede27a70b"}, {"key": "b679094c6cf0601cedffacde", "speaker": "female", "text": "下午一起去打篮球吧？", "sha256": "4add6c800c47d7e425e619285d11958a59bcc4b69f519f5dda5f73e10414e4cc"}, {"key": "306b74cb667839d5e909058c", "speaker": "male", "text": "我不太会打篮球。我想去公园走走，你去吗？", "sha256": "d00aededad7a0bc06e7bf9372df95c1af0cfb6673bc0405b252c43abaf704aa7"}, {"key": "b7e73f25bce732eaec4220d4", "speaker": "female", "text": "好，我也想去公园。", "sha256": "70eb3474fba4f45e8691ca8a877b8300ca81de7d87165e73d42e5ed4e9a97389"}, {"key": "ee9540a1a810afba0a3a7056", "speaker": "female", "text": "第19题。", "sha256": "91a1a230e642a4906da5e058c485a56cf6a1c77b67c899338da1843b7db5066e"}, {"key": "839820f84a224a5978c66fb7", "speaker": "male", "text": "周末你喜欢做什么？", "sha256": "73965a159525ece92c63a983052268cc19a81006adbf6f37d524dade7855ffa6"}, {"key": "d16efb50aec6c2dfc781a75a", "speaker": "female", "text": "我喜欢画画，也喜欢听音乐。这周六下午我要在家画画。星期天再去听音乐。", "sha256": "e23a4452f51fb12780563d23277f58762c5724f9694f71145a42da69703cba7e"}, {"key": "689adfbaa5b63ac16b96aac6", "speaker": "female", "text": "第20题。", "sha256": "f2a7aa65a74fad7dc9d19d81d6990ac99260287106ff304656efb599e75400e1"}, {"key": "7572befcf270f0803c0fc4d2", "speaker": "female", "text": "你好！你叫什么名字？今年多大？", "sha256": "25218879844a3d82d0259abc25f6b34f9283c0f626ce0adff52eb18c8c1f45ad"}, {"key": "876d43549c744ea5918f40e6", "speaker": "female", "text": "你喜欢吃什么？喜欢喝什么？", "sha256": "cc5c1d132d96519088a79656066c51b63a11d830ad9b0494cb4eb42732ddcc96"}, {"key": "a86cb92746b7ca4ca14a41ac", "speaker": "female", "text": "你早上几点去学校？几点上课？", "sha256": "c5a399fa9aaa8c023d9feaf0908cb7fc5c670298fceb2ca83284401d22b49ce8"}, {"key": "2e405aa315e16e15b93ee491", "speaker": "female", "text": "星期六一起去公园，好吗？你几点有空？", "sha256": "7ccb68056de7bc5423f966f1cd6b29b170f3fcdf2aeafd61a89801ae6617da19"}]}</script><script src="workspace.js" defer></script><noscript>Use the learner PDF and audio review if JavaScript is unavailable.</noscript></body></html>