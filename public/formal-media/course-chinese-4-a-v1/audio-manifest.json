      "singlePlayPcmSha256": "6ad07a881893491e8bdf3f9dd1bad5f76331f9f4885f1f9e393356313f6dabf1",
      "script": {
        "zh-Hans": "活动要让不同语言的同学都能参加。你最想先照顾谁的需要？为什么？",
        "zh-Hant": "活動要讓不同語言的同學都能參加。你最想先照顧誰的需要？爲什麼？"
      },
      "src": "assets/audio/s1-1.mp3",
      "durationSeconds": 17.832,
      "pcmSeconds": 17.772,
      "bytes": 142892,
      "sha256": "c92e8c5b23e3c534f0fd479a9efdf67b2e2b8ef188c506ef035414843b118b05"
    },
    {
      "id": "S1-2",
      "kind": "oral-prompt",
      "sourcePlays": 2,
      "singlePlayPcmSeconds": 7.776,
      "repeatGapSeconds": 1.5,
      "singlePlayPcmSha256": "20e365cd0eabc1e9f042b0b56e5550c068f2fbb5ee427c05c2b5c77b1f060993",
      "script": {
        "zh-Hans": "有人提议只讲一种语言，有人希望两种语言并用。你怎样比较这两个办法？",
        "zh-Hant": "有人提議只講一種語言，有人希望兩種語言並用。你怎樣比較這兩個辦法？"
      },
      "src": "assets/audio/s1-2.mp3",
      "durationSeconds": 17.112,
      "pcmSeconds": 17.052,
      "bytes": 137132,
      "sha256": "fc213d3a813285264f884889b8ad59d90ff9522fcab752838039452da8f50e19"
    },
    {
      "id": "S1-3",
