<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="robots" content="noindex,nofollow"><base href="/api/v1/course-tests/chinese-4/a/file/"><title>Chinese 4 · Paper A · HSKKit</title><link rel="stylesheet" href="workspace.css"></head><body><header class="bar"><a class="brand" href="/">HSKKit</a><a href="/chinese-course-tests#chinese-4">← Chinese 4 papers</a></header><div id="live" class="live" aria-live="polite"></div><div id="clockbar" class="clockbar" hidden><strong id="clock" role="timer"></strong><span id="oral-clock" role="timer"></span></div><div id="audio-dock" class="audio-dock" hidden><strong id="audio-label"></strong><audio id="listening-player" controls preload="metadata"></audio><p id="audio-error" role="alert" hidden>Audio could not load. Retry or open Audio review.</p></div><main id="app"></main><audio id="prompt-player" preload="none"></audio><footer><p>Independent HSKKit course review. Writing and speaking need manual review. Not an official school, HSK or ACTFL assessment.</p><a href="listening.html">Audio review</a> · <a href="teacher.html">Answer guide</a></footer><script id="paper-data" type="application/json">{"id": "course-chinese-4-a-v1", "product": "HSKKit Chinese 4 Course Review", "paperCode": "A", "version": "content-draft-v1", "authoredOn": "2026-11-11", "status": "content_authored_independent_acceptance_pending", "officialExam": false, "purpose": "Review HSKKit Chinese 4 scope only; not a universal school syllabus, official grade or level conversion.", "blueprint": {"id": "course-chinese-4-blueprint-v1", "source": "docs/course-chinese4-spec-20261110/blueprint.json", "sha256": "be5e916bce0e36cfb7c46ee9579d288263b6d77282281f78757ac14f53417842"}, "provenance": {"original": true, "aiAssisted": true, "competitorQuestionsCopied": false, "relabelledHskQuestions": false, "humanListeningAcceptance": false, "teacherReview": false, "learnerPilot": false, "userAcceptance": false, "traditionalScript": "OpenCC s2t plus author comparison; independent review pending"}, "order": ["listening", "reading", "writing", "speaking"], "sections": [{"id": "listening", "seconds": 1800, "objectiveItems": 20, "groups": 4, "itemsPerGroup": 5, "materialCount": 12, "sourcePlays": 2}, {"id": "reading", "seconds": 1800, "objectiveItems": 20, "groups": 4, "itemsPerGroup": 5, "materialCount": 12}, {"id": "writing", "seconds": 1800, "manualTasks": 2, "sharedClock": true}, {"id": "speaking", "seconds": 600, "manualTasks": 2}], "counts": {"listening": 20, "reading": 20, "writing": 2, "speaking": 2, "speakingRecordings": 5, "topLevelTasks": 44, "listeningMaterials": 12, "readingMaterials": 12}, "scoring": {"listeningMax": 20, "readingMax": 20, "pointsPerObjectiveItem": 1, "incorrectOrUnansweredPoints": 0, "manualTaskMax": 8, "combinedScore": null, "passCutoff": null, "officialConversion": null, "unsubmittedManual": "unsubmitted", "technicalFailureManual": "needs_rerecording"}, "materials": [{"id": "C4A-L1a", "blueprintMaterialSlotId": "L1a", "title": "Keeping a bilingual title", "section": "listening", "group": "L1", "kind": "connected-source", "subSources": 1, "original": true, "questionNumbers": [1], "glossary": [{"term": {"zh-Hans": "标题", "zh-Hant": "標題"}, "meaningEn": "title"}, {"term": {"zh-Hans": "保留", "zh-Hant": "保留"}, "meaningEn": "retain"}], "lexicalAudit": {"status": "author_checked_pending_teacher_suitability_review", "nonTargetGlossCount": 2, "maximumNonTargetUnfamiliarWords": 4, "completeCalibratedWordList": false}, "script": [{"speaker": "female", "text": {"zh-Hans": "社区故事展原来只用中文写标题。今年有同学建议全部换成英文，让更多邻居看懂。我认为可以保留中文，再加一句英文说明。这样不认识汉字的人也能了解内容，熟悉中文的老人仍然能看到原来的名字。两种文字不是只能选一种。我们还会请讲故事的人检查说明，免得意思变了。", "zh-Hant": "社區故事展原來只用中文寫標題。今年有同學建議全部換成英文，讓更多鄰居看懂。我認爲可以保留中文，再加一句英文說明。這樣不認識漢字的人也能瞭解內容，熟悉中文的老人仍然能看到原來的名字。兩種文字不是隻能選一種。我們還會請講故事的人檢查說明，免得意思變了。"}}]}, {"id": "C4A-L1b", "blueprintMaterialSlotId": "L1b", "title": "A narrator changes her opening", "section": "listening", "group": "L1", "kind": "connected-source", "subSources": 1, "original": true, "questionNumbers": [2, 3], "glossary": [{"term": {"zh-Hans": "背景", "zh-Hant": "背景"}, "meaningEn": "background"}, {"term": {"zh-Hans": "规定", "zh-Hant": "規定"}, "meaningEn": "rule"}], "lexicalAudit": {"status": "author_checked_pending_teacher_suitability_review", "nonTargetGlossCount": 2, "maximumNonTargetUnfamiliarWords": 4, "completeCalibratedWordList": false}, "script": [{"speaker": "male", "text": {"zh-Hans": "我以前介绍家里的故事，总是先说我们家的人每年都这样做。后来妹妹提醒我，她在外地读书以后就换了做法，不能把我的经验说成全家的规定。", "zh-Hant": "我以前介紹家裏的故事，總是先說我們家的人每年都這樣做。後來妹妹提醒我，她在外地讀書以後就換了做法，不能把我的經驗說成全家的規定。"}}, {"speaker": "female", "text": {"zh-Hans": "那你在故事展里怎么介绍呢？", "zh-Hant": "那你在故事展裏怎麼介紹呢？"}}, {"speaker": "male", "text": {"zh-Hans": "我先说明这是我小时候和爷爷一起准备晚饭的经历，再请妹妹补充她现在的办法。原来的菜名仍然保留，做菜步骤却可以不同。我们想让观众听出两个人的生活背景，而不是判断谁的做法才算正确。妹妹也同意把两段录音放在一起。展签会写清楚是谁在讲，也请观众先听完，再提出自己的问题。", "zh-Hant": "我先說明這是我小時候和爺爺一起準備晚飯的經歷，再請妹妹補充她現在的辦法。原來的菜名仍然保留，做菜步驟卻可以不同。我們想讓觀衆聽出兩個人的生活背景，而不是判斷誰的做法纔算正確。妹妹也同意把兩段錄音放在一起。展籤會寫清楚是誰在講，也請觀衆先聽完，再提出自己的問題。"}}]}, {"id": "C4A-L1c", "blueprintMaterialSlotId": "L1c", "title": "Two messages about the exchange", "section": "listening", "group": "L1", "kind": "bounded-two-source-panel", "subSources": 2, "original": true, "questionNumbers": [4, 5], "glossary": [{"term": {"zh-Hans": "值班", "zh-Hant": "值班"}, "meaningEn": "be on duty"}, {"term": {"zh-Hans": "成品", "zh-Hant": "成品"}, "meaningEn": "finished work"}], "lexicalAudit": {"status": "author_checked_pending_teacher_suitability_review", "nonTargetGlossCount": 2, "maximumNonTargetUnfamiliarWords": 4, "completeCalibratedWordList": false}, "script": [{"speaker": "female", "text": {"zh-Hans": "留言甲。我邀请伙伴来故事展时说，周五先随便聊聊，不用准备正式发言。我想让第一次见面的同学轻松一些。标题翻译等大家熟悉后再一起商量，不需要他们先交成品。", "zh-Hant": "留言甲。我邀請夥伴來故事展時說，週五先隨便聊聊，不用準備正式發言。我想讓第一次見面的同學輕鬆一些。標題翻譯等大家熟悉後再一起商量，不需要他們先交成品。"}}, {"speaker": "male", "text": {"zh-Hans": "留言乙。我以为随便聊聊就是可以不参加，所以答应那天替朋友值班。我并不是不愿意合作。我现在才知道，那次见面是让双方认识、分配后面的工作。我可以换班，但想先确认见面的目的和结束时间，再答复。我希望以后邀请时把参加要求写清楚，不只是说气氛轻松，以免其他人也理解错。", "zh-Hant": "留言乙。我以爲隨便聊聊就是可以不參加，所以答應那天替朋友值班。我並不是不願意合作。我現在才知道，那次見面是讓雙方認識、分配後面的工作。我可以換班，但想先確認見面的目的和結束時間，再答覆。我希望以後邀請時把參加要求寫清楚，不只是說氣氛輕鬆，以免其他人也理解錯。"}}]}, {"id": "C4A-L2a", "blueprintMaterialSlotId": "L2a", "title": "Confirming a partner session", "section": "listening", "group": "L2", "kind": "connected-source", "subSources": 1, "original": true, "questionNumbers": [6], "glossary": [{"term": {"zh-Hans": "设备测试", "zh-Hant": "設備測試"}, "meaningEn": "device check"}], "lexicalAudit": {"status": "author_checked_pending_teacher_suitability_review", "nonTargetGlossCount": 1, "maximumNonTargetUnfamiliarWords": 4, "completeCalibratedWordList": false}, "script": [{"speaker": "male", "text": {"zh-Hans": "这次线上交流已经确定在周四放学后进行，参加者要先看完对方发来的三张展览照片。老师会把不认识的词放在照片旁边。大家不用写完整报告，但每个人都要准备一个与照片有关的问题。交流时可以请对方解释，不必假装已经了解所有背景。设备测试另安排在周三午休。", "zh-Hant": "這次線上交流已經確定在週四放學後進行，參加者要先看完對方發來的三張展覽照片。老師會把不認識的詞放在照片旁邊。大家不用寫完整報告，但每個人都要準備一個與照片有關的問題。交流時可以請對方解釋，不必假裝已經瞭解所有背景。設備測試另安排在週三午休。"}}]}, {"id": "C4A-L2b", "blueprintMaterialSlotId": "L2b", "title": "Two translation-tool users", "section": "listening", "group": "L2", "kind": "bounded-two-source-panel", "subSources": 2, "original": true, "questionNumbers": [7, 8], "glossary": [{"term": {"zh-Hans": "并排", "zh-Hant": "並排"}, "meaningEn": "side by side"}, {"term": {"zh-Hans": "译文", "zh-Hant": "譯文"}, "meaningEn": "translation"}], "lexicalAudit": {"status": "author_checked_pending_teacher_suitability_review", "nonTargetGlossCount": 2, "maximumNonTargetUnfamiliarWords": 4, "completeCalibratedWordList": false}, "script": [{"speaker": "female", "text": {"zh-Hans": "反馈甲。我用翻译工具给展品写英文简介，第一稿出来得很快。但是人物称呼有时不对。我希望先看到中文原稿和英文并排的结果，这样能请讲故事的人一起检查，再决定是否使用。", "zh-Hant": "反饋甲。我用翻譯工具給展品寫英文簡介，第一稿出來得很快。但是人物稱呼有時不對。我希望先看到中文原稿和英文並排的結果，這樣能請講故事的人一起檢查，再決定是否使用。"}}, {"speaker": "male", "text": {"zh-Hans": "反馈乙。我负责接待，不会把工具的结果直接印出来。工具省下了查普通词的时间，可是有些地方的名字译得不一致。我也想保留两种文字，还要给改过的地方作标记。现在有人建议把所有译文自动发布，我觉得还需要人工确认。确认过的内容才能给访客看，修改以后也要留下日期，避免误用旧稿。", "zh-Hant": "反饋乙。我負責接待，不會把工具的結果直接印出來。工具省下了查普通詞的時間，可是有些地方的名字譯得不一致。我也想保留兩種文字，還要給改過的地方作標記。現在有人建議把所有譯文自動發佈，我覺得還需要人工確認。確認過的內容才能給訪客看，修改以後也要留下日期，避免誤用舊稿。"}}]}, {"id": "C4A-L2c", "blueprintMaterialSlotId": "L2c", "title": "Library space rules", "section": "listening", "group": "L2", "kind": "connected-source", "subSources": 1, "original": true, "questionNumbers": [9, 10], "glossary": [{"term": {"zh-Hans": "预约", "zh-Hant": "預約"}, "meaningEn": "reserve"}, {"term": {"zh-Hans": "试行", "zh-Hant": "試行"}, "meaningEn": "trial implementation"}], "lexicalAudit": {"status": "author_checked_pending_teacher_suitability_review", "nonTargetGlossCount": 2, "maximumNonTargetUnfamiliarWords": 4, "completeCalibratedWordList": false}, "script": [{"speaker": "female", "text": {"zh-Hans": "图书馆下周开始试行新规则。靠窗的区域保持安静，讨论小组可以预约门口的房间，每次三十分钟。有人担心临时来的人没有位置，所以我们先把周三中午留作不用预约的时段。", "zh-Hant": "圖書館下週開始試行新規則。靠窗的區域保持安靜，討論小組可以預約門口的房間，每次三十分鐘。有人擔心臨時來的人沒有位置，所以我們先把週三中午留作不用預約的時段。"}}, {"speaker": "male", "text": {"zh-Hans": "那我接受先试两周。不过不用预约也不该表示可以一直占着房间。我们要写清楚，每组仍然最多用三十分钟，两周后再看等候记录。", "zh-Hant": "那我接受先試兩週。不過不用預約也不該表示可以一直佔着房間。我們要寫清楚，每組仍然最多用三十分鐘，兩週後再看等候記錄。"}}, {"speaker": "female", "text": {"zh-Hans": "同意。这样能听到临时使用者的意见，也不取消原来需要安静的人可以使用的区域。通知里会分别写出两种空间的用途，让第一次来的同学也容易理解。", "zh-Hant": "同意。這樣能聽到臨時使用者的意見，也不取消原來需要安靜的人可以使用的區域。通知裏會分別寫出兩種空間的用途，讓第一次來的同學也容易理解。"}}]}, {"id": "C4A-L3a", "blueprintMaterialSlotId": "L3a", "title": "Introducing an original film", "section": "listening", "group": "L3", "kind": "connected-source", "subSources": 1, "original": true, "questionNumbers": [11], "glossary": [{"term": {"zh-Hans": "导演", "zh-Hant": "導演"}, "meaningEn": "director"}, {"term": {"zh-Hans": "放映", "zh-Hant": "放映"}, "meaningEn": "screening"}], "lexicalAudit": {"status": "author_checked_pending_teacher_suitability_review", "nonTargetGlossCount": 2, "maximumNonTargetUnfamiliarWords": 4, "completeCalibratedWordList": false}, "script": [{"speaker": "female", "text": {"zh-Hans": "这部校园短片不是教大家怎样整理旧照片。导演拍的是两位同学看同一张照片时不同的反应。画面里没有解释谁记错了，而是让两个人分别讲述当时的感受。放映后，观众可以说自己注意到的细节，再看看这些细节怎样影响理解。我们希望大家学会听见不同的声音，不是背出标准感想。", "zh-Hant": "這部校園短片不是教大家怎樣整理舊照片。導演拍的是兩位同學看同一張照片時不同的反應。畫面裏沒有解釋誰記錯了，而是讓兩個人分別講述當時的感受。放映後，觀衆可以說自己注意到的細節，再看看這些細節怎樣影響理解。我們希望大家學會聽見不同的聲音，不是背出標準感想。"}}]}, {"id": "C4A-L3b", "blueprintMaterialSlotId": "L3b", "title": "A pause in a film", "section": "listening", "group": "L3", "kind": "connected-source", "subSources": 1, "original": true, "questionNumbers": [12, 13], "glossary": [{"term": {"zh-Hans": "旁白", "zh-Hant": "旁白"}, "meaningEn": "voice-over"}, {"term": {"zh-Hans": "停顿", "zh-Hant": "停頓"}, "meaningEn": "pause"}], "lexicalAudit": {"status": "author_checked_pending_teacher_suitability_review", "nonTargetGlossCount": 2, "maximumNonTargetUnfamiliarWords": 4, "completeCalibratedWordList": false}, "script": [{"speaker": "male", "text": {"zh-Hans": "短片里，小河站在门外很久才进去。我们剪第一版时，有人觉得这段停顿没用，应该删掉。我却想留下，因为前面他刚说过，怕进去以后不知道怎样开口。", "zh-Hant": "短片裏，小河站在門外很久才進去。我們剪第一版時，有人覺得這段停頓沒用，應該刪掉。我卻想留下，因爲前面他剛說過，怕進去以後不知道怎樣開口。"}}, {"speaker": "female", "text": {"zh-Hans": "留下以后，观众明白你的意思了吗？", "zh-Hant": "留下以後，觀衆明白你的意思了嗎？"}}, {"speaker": "male", "text": {"zh-Hans": "有的人说看出了他的紧张，也有人觉得他只是等朋友。我们后来加了他伸手又收回的一个动作，没有加旁白直接解释。我愿意让观众有不同理解，但希望大家的解释能联系画面，而不是说任何猜想都一样有道理。下一次放映时，我们会先让观众说出具体细节，再解释他们的判断。", "zh-Hant": "有的人說看出了他的緊張，也有人覺得他只是等朋友。我們後來加了他伸手又收回的一個動作，沒有加旁白直接解釋。我願意讓觀衆有不同理解，但希望大家的解釋能聯繫畫面，而不是說任何猜想都一樣有道理。下一次放映時，我們會先讓觀衆說出具體細節，再解釋他們的判斷。"}}]}, {"id": "C4A-L3c", "blueprintMaterialSlotId": "L3c", "title": "Two reuse proposals", "section": "listening", "group": "L3", "kind": "bounded-two-source-panel", "subSources": 2, "original": true, "questionNumbers": [14, 15], "glossary": [{"term": {"zh-Hans": "归还", "zh-Hant": "歸還"}, "meaningEn": "return borrowed items"}, {"term": {"zh-Hans": "储存架", "zh-Hant": "儲存架"}, "meaningEn": "storage rack"}], "lexicalAudit": {"status": "author_checked_pending_teacher_suitability_review", "nonTargetGlossCount": 2, "maximumNonTargetUnfamiliarWords": 4, "completeCalibratedWordList": false}, "script": [{"speaker": "female", "text": {"zh-Hans": "方案甲。我们提议在校园活动中借用可重复使用的杯子。现有一百个杯子，清洗室周五下午能用，两位同学愿意在结束后负责清洗。先在这一次活动试用，记录归还情况，再决定要不要扩大。", "zh-Hant": "方案甲。我們提議在校園活動中借用可重複使用的杯子。現有一百個杯子，清洗室週五下午能用，兩位同學願意在結束後負責清洗。先在這一次活動試用，記錄歸還情況，再決定要不要擴大。"}}, {"speaker": "male", "text": {"zh-Hans": "方案乙。我们希望每个活动都立即使用这套杯子。可是周末清洗室不开，储存架也只够放这一百个。我们还没有找到周末能负责清洗的人。若能先解决清洗和存放，再推广比较稳妥，不应该只看杯子数量就决定。我们会先问清负责人的时间，再把完整的借还安排告诉其他活动组。", "zh-Hant": "方案乙。我們希望每個活動都立即使用這套杯子。可是週末清洗室不開，儲存架也只夠放這一百個。我們還沒有找到週末能負責清洗的人。若能先解決清洗和存放，再推廣比較穩妥，不應該只看杯子數量就決定。我們會先問清負責人的時間，再把完整的借還安排告訴其他活動組。"}}]}, {"id": "C4A-L4a", "blueprintMaterialSlotId": "L4a", "title": "A revised collection notice", "section": "listening", "group": "L4", "kind": "connected-source", "subSources": 1, "original": true, "questionNumbers": [16], "glossary": [{"term": {"zh-Hans": "破损", "zh-Hant": "破損"}, "meaningEn": "damaged"}], "lexicalAudit": {"status": "author_checked_pending_teacher_suitability_review", "nonTargetGlossCount": 1, "maximumNonTargetUnfamiliarWords": 4, "completeCalibratedWordList": false}, "script": [{"speaker": "male", "text": {"zh-Hans": "关于周五活动的杯子归还，我们修改一项安排。原来所有人都要到食堂后门排队，现在每个班先收齐，再由两名代表送过去。杯子仍然只在周五下午清洗，不能留到周末。破损的杯子要单独放进有标记的盒子，不算作没有归还。试用记录会分别写清归还数量和破损数量，避免把两种情况混在一起。", "zh-Hant": "關於週五活動的杯子歸還，我們修改一項安排。原來所有人都要到食堂後門排隊，現在每個班先收齊，再由兩名代表送過去。杯子仍然只在週五下午清洗，不能留到週末。破損的杯子要單獨放進有標記的盒子，不算作沒有歸還。試用記錄會分別寫清歸還數量和破損數量，避免把兩種情況混在一起。"}}]}, {"id": "C4A-L4b", "blueprintMaterialSlotId": "L4b", "title": "Two interviews about a guide tool", "section": "listening", "group": "L4", "kind": "bounded-two-source-panel", "subSources": 2, "original": true, "questionNumbers": [17, 18], "glossary": [{"term": {"zh-Hans": "识别", "zh-Hant": "識別"}, "meaningEn": "recognize"}, {"term": {"zh-Hans": "导览", "zh-Hant": "導覽"}, "meaningEn": "navigation guide"}], "lexicalAudit": {"status": "author_checked_pending_teacher_suitability_review", "nonTargetGlossCount": 2, "maximumNonTargetUnfamiliarWords": 4, "completeCalibratedWordList": false}, "script": [{"speaker": "female", "text": {"zh-Hans": "访谈甲。我试用导览工具后，找教室快了一些。因为主要路线的牌子都能识别，我不用每次问路。但是地下活动室的牌子太暗，工具两次都读错了。我建议先改善那里的标记，再请新同学试。", "zh-Hant": "訪談甲。我試用導覽工具後，找教室快了一些。因爲主要路線的牌子都能識別，我不用每次問路。但是地下活動室的牌子太暗，工具兩次都讀錯了。我建議先改善那裏的標記，再請新同學試。"}}, {"speaker": "male", "text": {"zh-Hans": "访谈乙。我带三位新同学试用，只有熟悉手机操作的一位一直顺利。另两位需要我先教他们怎么拍标记。教过以后，他们也能找到目的地。我赞成继续用，不过三个人的经历不能说明所有新生都不用帮助，更不能说工具已经在任何地方都准确。下一轮还需要让更多不同经验的同学试一试。", "zh-Hant": "訪談乙。我帶三位新同學試用，只有熟悉手機操作的一位一直順利。另兩位需要我先教他們怎麼拍標記。教過以後，他們也能找到目的地。我贊成繼續用，不過三個人的經歷不能說明所有新生都不用幫助，更不能說工具已經在任何地方都準確。下一輪還需要讓更多不同經驗的同學試一試。"}}]}, {"id": "C4A-L4c", "blueprintMaterialSlotId": "L4c", "title": "What the community display changed", "section": "listening", "group": "L4", "kind": "connected-source", "subSources": 1, "original": true, "questionNumbers": [19, 20], "glossary": [{"term": {"zh-Hans": "勾选", "zh-Hant": "勾選"}, "meaningEn": "tick an option"}, {"term": {"zh-Hans": "个体", "zh-Hant": "個體"}, "meaningEn": "individual"}], "lexicalAudit": {"status": "author_checked_pending_teacher_suitability_review", "nonTargetGlossCount": 2, "maximumNonTargetUnfamiliarWords": 4, "completeCalibratedWordList": false}, "script": [{"speaker": "female", "text": {"zh-Hans": "刚开始，社区展览要求每个家庭用同一张表介绍习惯。有位老人说表格能比较，可是写不出她为什么保留那个名字；一位年轻人也说自己的做法变过，不适合只勾选有或没有。", "zh-Hant": "剛開始，社區展覽要求每個家庭用同一張表介紹習慣。有位老人說表格能比較，可是寫不出她爲什麼保留那個名字；一位年輕人也說自己的做法變過，不適合只勾選有或沒有。"}}, {"speaker": "male", "text": {"zh-Hans": "所以后来你们怎样处理？", "zh-Hant": "所以後來你們怎樣處理？"}}, {"speaker": "female", "text": {"zh-Hans": "我们保留简短表格，让想讲经历的人加一段录音。工作人员帮忙整理，但请本人检查。这样没有取消共同的结构，也没有把个体故事压成一个选项。我原来觉得传统只要原样留下就好，现在更在意谁在讲、为什么改变，以及改变后哪些意义还在。", "zh-Hant": "我們保留簡短表格，讓想講經歷的人加一段錄音。工作人員幫忙整理，但請本人檢查。這樣沒有取消共同的結構，也沒有把個體故事壓成一個選項。我原來覺得傳統只要原樣留下就好，現在更在意誰在講、爲什麼改變，以及改變後哪些意義還在。"}}]}, {"id": "C4A-R1a", "blueprintMaterialSlotId": "R1a", "title": "A name beside the new title", "section": "reading", "group": "R1", "kind": "connected-source", "subSources": 1, "original": true, "questionNumbers": [21], "glossary": [{"term": {"zh-Hans": "展签", "zh-Hant": "展籤"}, "meaningEn": "exhibit label"}], "lexicalAudit": {"status": "author_checked_pending_teacher_suitability_review", "nonTargetGlossCount": 1, "maximumNonTargetUnfamiliarWords": 4, "completeCalibratedWordList": false}, "text": {"zh-Hans": "这次社区故事展给每段录音设计了新的英文标题，方便不同语言的邻居寻找内容。策划人仍把讲述者选定的中文名字印在旁边，字号和英文一样大。志愿者建议把不容易翻译的名字删掉，讲述者却认为，名字与自己的经历相连，不能只因翻译麻烦就取消。最后双方决定保留中文，并用一句简短英文解释名字的来由。解释须先交本人确认，才印成展签。", "zh-Hant": "這次社區故事展給每段錄音設計了新的英文標題，方便不同語言的鄰居尋找內容。策劃人仍把講述者選定的中文名字印在旁邊，字號和英文一樣大。志願者建議把不容易翻譯的名字刪掉，講述者卻認爲，名字與自己的經歷相連，不能只因翻譯麻煩就取消。最後雙方決定保留中文，並用一句簡短英文解釋名字的來由。解釋須先交本人確認，才印成展籤。"}, "hanziCount": 143}, {"id": "C4A-R1b", "blueprintMaterialSlotId": "R1b", "title": "Two ways to share a family story", "section": "reading", "group": "R1", "kind": "connected-source", "subSources": 1, "original": true, "questionNumbers": [22, 23], "glossary": [{"term": {"zh-Hans": "并列", "zh-Hant": "並列"}, "meaningEn": "display alongside"}, {"term": {"zh-Hans": "模拟图", "zh-Hant": "模擬圖"}, "meaningEn": "illustrative mock-up"}], "lexicalAudit": {"status": "author_checked_pending_teacher_suitability_review", "nonTargetGlossCount": 2, "maximumNonTargetUnfamiliarWords": 4, "completeCalibratedWordList": false}, "text": {"zh-Hans": "小时候，小岚每年都与外婆一起写手工菜单，把当天要做的饭菜记下来。她记得最清楚的不是菜的数量，而是外婆讲述每个菜名时的语气。因此，她准备在故事展里放一张旧菜单，并配上自己的回忆录音。她在介绍里写明，这只是自己与外婆的经验，不能代表所有家庭。\n弟弟现在在外地学习，平时用手机与家人商量吃什么。他提议再放一张聊天记录的模拟图，说明今天的联系方法。小岚起初觉得新图会破坏旧菜单的意义，听完弟弟的解释后，同意把两者并列。她发现，保留共同商量饭菜的习惯，不一定要求每次都使用同一种工具。展示只用重新编写的例子，不公开家人的真实聊天内容。", "zh-Hant": "小時候，小嵐每年都與外婆一起寫手工菜單，把當天要做的飯菜記下來。她記得最清楚的不是菜的數量，而是外婆講述每個菜名時的語氣。因此，她準備在故事展裏放一張舊菜單，並配上自己的回憶錄音。她在介紹裏寫明，這只是自己與外婆的經驗，不能代表所有家庭。\n弟弟現在在外地學習，平時用手機與家人商量喫什麼。他提議再放一張聊天記錄的模擬圖，說明今天的聯繫方法。小嵐起初覺得新圖會破壞舊菜單的意義，聽完弟弟的解釋後，同意把兩者並列。她發現，保留共同商量飯菜的習慣，不一定要求每次都使用同一種工具。展示只用重新編寫的例子，不公開家人的真實聊天內容。"}, "hanziCount": 238}, {"id": "C4A-R1c", "blueprintMaterialSlotId": "R1c", "title": "An invitation and a reply", "section": "reading", "group": "R1", "kind": "bounded-two-source-panel", "subSources": 2, "original": true, "questionNumbers": [24, 25], "glossary": [{"term": {"zh-Hans": "代表", "zh-Hant": "代表"}, "meaningEn": "representative"}, {"term": {"zh-Hans": "排练", "zh-Hant": "排練"}, "meaningEn": "rehearsal"}], "lexicalAudit": {"status": "author_checked_pending_teacher_suitability_review", "nonTargetGlossCount": 2, "maximumNonTargetUnfamiliarWords": 4, "completeCalibratedWordList": false}, "text": {"zh-Hans": "材料甲，交流邀请：周二午休请两校代表先到线上房间碰面。此次只是认识伙伴、确认后续分工，不需要准备正式展示。每位代表仍需到场，若时间有困难，请提前留言。文化故事的翻译工作在下次会议才开始。请不要为了这次碰面赶写成品。\n材料乙，伙伴回复：我看到“不需要正式展示”，以为午休那次可以不去，就报名参加了同一时间的排练。读到老师转来的补充说明，才发现每位代表都应该参加。我想调整排练时间，并询问是否可以提前十分钟结束。如果不能，我会先说明冲突，请大家确认可否由另一位代表代替，不能直接当作已经请好假。", "zh-Hant": "材料甲，交流邀請：週二午休請兩校代表先到線上房間碰面。此次只是認識夥伴、確認後續分工，不需要準備正式展示。每位代表仍需到場，若時間有困難，請提前留言。文化故事的翻譯工作在下次會議纔開始。請不要爲了這次碰面趕寫成品。\n材料乙，夥伴回覆：我看到“不需要正式展示”，以爲午休那次可以不去，就報名參加了同一時間的排練。讀到老師轉來的補充說明，才發現每位代表都應該參加。我想調整排練時間，並詢問是否可以提前十分鐘結束。如果不能，我會先說明衝突，請大家確認可否由另一位代表代替，不能直接當作已經請好假。"}, "hanziCount": 218}, {"id": "C4A-R2a", "blueprintMaterialSlotId": "R2a", "title": "Preparing for an exchange", "section": "reading", "group": "R2", "kind": "connected-source", "subSources": 1, "original": true, "questionNumbers": [26], "glossary": [{"term": {"zh-Hans": "主持人", "zh-Hant": "主持人"}, "meaningEn": "host"}, {"term": {"zh-Hans": "澄清", "zh-Hant": "澄清"}, "meaningEn": "clarify"}], "lexicalAudit": {"status": "author_checked_pending_teacher_suitability_review", "nonTargetGlossCount": 2, "maximumNonTargetUnfamiliarWords": 4, "completeCalibratedWordList": false}, "text": {"zh-Hans": "两校下周举行线上交流，每位参加者须先读一张伙伴提供的生活照片卡，记下一个想进一步了解的问题。照片旁已经解释可能陌生的词，因此不要求学生另外搜索文化知识。主持人提醒，问题要围绕卡片中的具体细节，不能请一位伙伴代表整个国家。若照片中的人物不愿回答私人经历，可以只讨论图片里已经给出的信息。活动后每人整理一条得到澄清的认识。", "zh-Hant": "兩校下週舉行線上交流，每位參加者須先讀一張夥伴提供的生活照片卡，記下一個想進一步瞭解的問題。照片旁已經解釋可能陌生的詞，因此不要求學生另外搜索文化知識。主持人提醒，問題要圍繞卡片中的具體細節，不能請一位夥伴代表整個國家。若照片中的人物不願回答私人經歷，可以只討論圖片裏已經給出的信息。活動後每人整理一條得到澄清的認識。"}, "hanziCount": 148}, {"id": "C4A-R2b", "blueprintMaterialSlotId": "R2b", "title": "A tool trial and a user reply", "section": "reading", "group": "R2", "kind": "bounded-two-source-panel", "subSources": 2, "original": true, "questionNumbers": [27, 28], "glossary": [{"term": {"zh-Hans": "版本", "zh-Hant": "版本"}, "meaningEn": "version"}, {"term": {"zh-Hans": "初稿", "zh-Hant": "初稿"}, "meaningEn": "first draft"}], "lexicalAudit": {"status": "author_checked_pending_teacher_suitability_review", "nonTargetGlossCount": 2, "maximumNonTargetUnfamiliarWords": 4, "completeCalibratedWordList": false}, "text": {"zh-Hans": "材料甲，试用记录：展览翻译工具让六段中文简介很快有了英文初稿。检查时发现，普通物品名称大多清楚，但同一个人的称呼前后不同。试用组建议保留原文和译文，先由熟悉内容的人确认，再公开。记录只涉及这六段文字，没有测试口头对话或其他题材。\n材料乙，接待组回复：我们愿意继续试用，不过需要知道每次修改了哪里。上次有人改正一个名字，另一位同学却拿旧版本去印，造成两套展签。请在并排页面上标出改动，并让确认后的版本有清楚日期。对接待组来说，速度有帮助，但能找到最新且核对过的文字更重要。现阶段不能把“很快有初稿”写成“所有内容都已准确翻译”。", "zh-Hant": "材料甲，試用記錄：展覽翻譯工具讓六段中文簡介很快有了英文初稿。檢查時發現，普通物品名稱大多清楚，但同一個人的稱呼前後不同。試用組建議保留原文和譯文，先由熟悉內容的人確認，再公開。記錄只涉及這六段文字，沒有測試口頭對話或其他題材。\n材料乙，接待組回覆：我們願意繼續試用，不過需要知道每次修改了哪裏。上次有人改正一個名字，另一位同學卻拿舊版本去印，造成兩套展籤。請在並排頁面上標出改動，並讓確認後的版本有清楚日期。對接待組來說，速度有幫助，但能找到最新且覈對過的文字更重要。現階段不能把“很快有初稿”寫成“所有內容都已準確翻譯”。"}, "hanziCount": 234}, {"id": "C4A-R2c", "blueprintMaterialSlotId": "R2c", "title": "A trial library rule", "section": "reading", "group": "R2", "kind": "connected-source", "subSources": 1, "original": true, "questionNumbers": [29, 30], "glossary": [{"term": {"zh-Hans": "超时", "zh-Hant": "超時"}, "meaningEn": "exceed the time limit"}, {"term": {"zh-Hans": "意见栏", "zh-Hant": "意見欄"}, "meaningEn": "feedback section"}], "lexicalAudit": {"status": "author_checked_pending_teacher_suitability_review", "nonTargetGlossCount": 2, "maximumNonTargetUnfamiliarWords": 4, "completeCalibratedWordList": false}, "text": {"zh-Hans": "图书馆原来把讨论室全部改成预约使用，有同学反映，临时遇到小组问题时常常找不到当天的空位。管理组提出两周试行办法：周一与周四午休各留一个房间，不预约也可排队使用，但每组最多二十分钟；其他房间继续按预约安排。靠窗阅读区仍保持安静。\n一位同学在意见栏中支持先试行，条件是把排队和超时情况记下来。他指出，留出临时时段也许能帮助部分人，但如果少数组一直超时，后面的人仍然没有机会。两周后应同时查看预约组与临时组的记录，再讨论是否调整房间数量。意见栏中的支持不表示他认为所有房间都该取消预约。", "zh-Hant": "圖書館原來把討論室全部改成預約使用，有同學反映，臨時遇到小組問題時常常找不到當天的空位。管理組提出兩週試行辦法：週一與週四午休各留一個房間，不預約也可排隊使用，但每組最多二十分鐘；其他房間繼續按預約安排。靠窗閱讀區仍保持安靜。\n一位同學在意見欄中支持先試行，條件是把排隊和超時情況記下來。他指出，留出臨時時段也許能幫助部分人，但如果少數組一直超時，後面的人仍然沒有機會。兩週後應同時查看預約組與臨時組的記錄，再討論是否調整房間數量。意見欄中的支持不表示他認爲所有房間都該取消預約。"}, "hanziCount": 221}, {"id": "C4A-R3a", "blueprintMaterialSlotId": "R3a", "title": "An invitation to watch closely", "section": "reading", "group": "R3", "kind": "connected-source", "subSources": 1, "original": true, "questionNumbers": [31], "glossary": [{"term": {"zh-Hans": "术语", "zh-Hant": "術語"}, "meaningEn": "technical terminology"}, {"term": {"zh-Hans": "创作者", "zh-Hant": "創作者"}, "meaningEn": "creator"}], "lexicalAudit": {"status": "author_checked_pending_teacher_suitability_review", "nonTargetGlossCount": 2, "maximumNonTargetUnfamiliarWords": 4, "completeCalibratedWordList": false}, "text": {"zh-Hans": "校园短片周的介绍说，作品《门口》用同一段进门前的画面，引出三位虚构同学不同的回忆。放映后的讨论面向普通观众，不要求知道电影术语。组织者请大家先说看见的动作、听见的话，再解释自己怎样理解人物。介绍没有给出标准感想，也不要求观众同意创作者的每个判断。如果观点不同，大家可以回到共同看到的细节继续讨论，而不是以谁更懂电影决定谁能发言。", "zh-Hant": "校園短片周的介紹說，作品《門口》用同一段進門前的畫面，引出三位虛構同學不同的回憶。放映後的討論面向普通觀衆，不要求知道電影術語。組織者請大家先說看見的動作、聽見的話，再解釋自己怎樣理解人物。介紹沒有給出標準感想，也不要求觀衆同意創作者的每個判斷。如果觀點不同，大家可以回到共同看到的細節繼續討論，而不是以誰更懂電影決定誰能發言。"}, "hanziCount": 149}, {"id": "C4A-R3b", "blueprintMaterialSlotId": "R3b", "title": "The unfinished message", "section": "reading", "group": "R3", "kind": "connected-source", "subSources": 1, "original": true, "questionNumbers": [32, 33], "glossary": [{"term": {"zh-Hans": "指责", "zh-Hant": "指責"}, "meaningEn": "blame"}, {"term": {"zh-Hans": "短评", "zh-Hant": "短評"}, "meaningEn": "short commentary"}], "lexicalAudit": {"status": "author_checked_pending_teacher_suitability_review", "nonTargetGlossCount": 2, "maximumNonTargetUnfamiliarWords": 4, "completeCalibratedWordList": false}, "text": {"zh-Hans": "原创微型故事：阿宁录好给旧朋友的问候，手指停在发送键上，却迟迟没有按下。去年两人因为一次误会很少联系。他删掉开头那句“你一定早就忘了”，换成“我还记得我们一起做展板的下午”。消息发出后，他把手机放进书包，走去参加社团活动。故事没有写朋友是否回复。\n读书会的一段短评认为，删掉那句指责并不是阿宁不在乎过去，而是他试着从双方共有的经历重新开口。评论特别提到，最后把手机收起的动作，可以支持他愿意迈出一步、又不把当天全部心情交给等待的理解。不过这不足以证明两人已经和好，更不能替故事补出朋友的真实想法。其他读者可提出不同解释，但要说明依据在哪里。", "zh-Hant": "原創微型故事：阿寧錄好給舊朋友的問候，手指停在發送鍵上，卻遲遲沒有按下。去年兩人因爲一次誤會很少聯繫。他刪掉開頭那句“你一定早就忘了”，換成“我還記得我們一起做展板的下午”。消息發出後，他把手機放進書包，走去參加社團活動。故事沒有寫朋友是否回覆。\n讀書會的一段短評認爲，刪掉那句指責並不是阿寧不在乎過去，而是他試着從雙方共有的經歷重新開口。評論特別提到，最後把手機收起的動作，可以支持他願意邁出一步、又不把當天全部心情交給等待的理解。不過這不足以證明兩人已經和好，更不能替故事補出朋友的真實想法。其他讀者可提出不同解釋，但要說明依據在哪裏。"}, "hanziCount": 243}, {"id": "C4A-R3c", "blueprintMaterialSlotId": "R3c", "title": "Reuse plan and a follow-up note", "section": "reading", "group": "R3", "kind": "bounded-two-source-panel", "subSources": 2, "original": true, "questionNumbers": [34, 35], "glossary": [{"term": {"zh-Hans": "跨日", "zh-Hant": "跨日"}, "meaningEn": "across different days"}, {"term": {"zh-Hans": "通道", "zh-Hant": "通道"}, "meaningEn": "passageway"}], "lexicalAudit": {"status": "author_checked_pending_teacher_suitability_review", "nonTargetGlossCount": 2, "maximumNonTargetUnfamiliarWords": 4, "completeCalibratedWordList": false}, "text": {"zh-Hans": "材料甲，活动方案：环保组计划在周五的读书交流会借出八十个可重复使用的杯子。茶水台旁有清楚的归还箱，两位志愿者愿意收齐并在当天清洗。方案建议先记录借出、归还与损坏情况，活动后再决定是否给其他小组使用。暂不购买更多杯子。\n材料乙，场地补充：周五清洗间可以用到下午五点，周末关闭；归还箱只能当日放在茶水台旁，不能长期占通道。已有小组想把杯子借到星期六，但还没有清洗地点和收回时间。负责人建议先完成周五试用，核对损坏和归还记录，再商量跨日借用的具体安排。参加者若带自己的杯子，也不影响本次记录，只须分开统计。", "zh-Hant": "材料甲，活動方案：環保組計劃在週五的讀書交流會借出八十個可重複使用的杯子。茶水臺旁有清楚的歸還箱，兩位志願者願意收齊並在當天清洗。方案建議先記錄借出、歸還與損壞情況，活動後再決定是否給其他小組使用。暫不購買更多杯子。\n材料乙，場地補充：週五清洗間可以用到下午五點，週末關閉；歸還箱只能當日放在茶水臺旁，不能長期佔通道。已有小組想把杯子借到星期六，但還沒有清洗地點和收回時間。負責人建議先完成周五試用，覈對損壞和歸還記錄，再商量跨日借用的具體安排。參加者若帶自己的杯子，也不影響本次記錄，只須分開統計。"}, "hanziCount": 226}, {"id": "C4A-R4a", "blueprintMaterialSlotId": "R4a", "title": "Scope of the revised trial", "section": "reading", "group": "R4", "kind": "connected-source", "subSources": 1, "original": true, "questionNumbers": [36], "glossary": [{"term": {"zh-Hans": "评估", "zh-Hant": "評估"}, "meaningEn": "evaluate"}], "lexicalAudit": {"status": "author_checked_pending_teacher_suitability_review", "nonTargetGlossCount": 1, "maximumNonTargetUnfamiliarWords": 4, "completeCalibratedWordList": false}, "text": {"zh-Hans": "环保组把试用通知修改为：本周只在周五读书交流会使用共用杯，不接受周末跨日借用。各组可以由代表统一归还，但杯子要在下午四点半前送到茶水台旁；之后志愿者清洗。破损杯另放一箱，数量也要记录。带自用杯的人不用借杯，不计入未归还人数。本次结束后再按记录评估是否扩大，不能把一次活动的结果说成全校长期使用的效果。", "zh-Hant": "環保組把試用通知修改爲：本週只在週五讀書交流會使用共用杯，不接受週末跨日借用。各組可以由代表統一歸還，但杯子要在下午四點半前送到茶水臺旁；之後志願者清洗。破損杯另放一箱，數量也要記錄。帶自用杯的人不用借杯，不計入未歸還人數。本次結束後再按記錄評估是否擴大，不能把一次活動的結果說成全校長期使用的效果。"}, "hanziCount": 138}, {"id": "C4A-R4b", "blueprintMaterialSlotId": "R4b", "title": "A guide description and user feedback", "section": "reading", "group": "R4", "kind": "bounded-two-source-panel", "subSources": 2, "original": true, "questionNumbers": [37, 38], "glossary": [{"term": {"zh-Hans": "反光", "zh-Hant": "反光"}, "meaningEn": "reflective glare"}, {"term": {"zh-Hans": "封闭", "zh-Hant": "封閉"}, "meaningEn": "closed off"}], "lexicalAudit": {"status": "author_checked_pending_teacher_suitability_review", "nonTargetGlossCount": 2, "maximumNonTargetUnfamiliarWords": 4, "completeCalibratedWordList": false}, "text": {"zh-Hans": "材料甲，校园导览工具说明：工具读取教室旁的标记，显示从当前位置到目的地的路线。试用范围包括教学楼一层和二层。识别需要标记清楚、光线足够；说明没有承诺在标记损坏或光线不足时仍然准确。工具可以帮助找路，但不代替工作人员处理临时封闭区域。\n材料乙，使用者反馈：我在一层主走廊三次顺利找到教室，在楼梯口遇到反光标记时却读错了。我请工作人员确认后，才知道该走另一边。另一位同学不熟悉拍摄操作，第一次也没成功，学习后才能使用。我支持修好标记后再扩大试用，但现有经历只覆盖少量地点和使用者，不能据此声称所有新生都可以完全独立地在全校通行。", "zh-Hant": "材料甲，校園導覽工具說明：工具讀取教室旁的標記，顯示從當前位置到目的地的路線。試用範圍包括教學樓一層和二層。識別需要標記清楚、光線足夠；說明沒有承諾在標記損壞或光線不足時仍然準確。工具可以幫助找路，但不代替工作人員處理臨時封閉區域。\n材料乙，使用者反饋：我在一層主走廊三次順利找到教室，在樓梯口遇到反光標記時卻讀錯了。我請工作人員確認後，才知道該走另一邊。另一位同學不熟悉拍攝操作，第一次也沒成功，學習後才能使用。我支持修好標記後再擴大試用，但現有經歷只覆蓋少量地點和使用者，不能據此聲稱所有新生都可以完全獨立地在全校通行。"}, "hanziCount": 239}, {"id": "C4A-R4c", "blueprintMaterialSlotId": "R4c", "title": "A display changes its format", "section": "reading", "group": "R4", "kind": "connected-source", "subSources": 1, "original": true, "questionNumbers": [39, 40], "glossary": [{"term": {"zh-Hans": "持相同看法", "zh-Hant": "持相同看法"}, "meaningEn": "share the same view"}, {"term": {"zh-Hans": "格式", "zh-Hant": "格式"}, "meaningEn": "format"}], "lexicalAudit": {"status": "author_checked_pending_teacher_suitability_review", "nonTargetGlossCount": 2, "maximumNonTargetUnfamiliarWords": 4, "completeCalibratedWordList": false}, "text": {"zh-Hans": "社区故事展起初规定，每位参与者只能填写同样的五个问题，工作人员再把答案做成统一图卡。一位参与者说，这样容易比较，却没有地方说明自己为什么改变做法。另一位参与者担心，若只展示一句话，观众会以为整个家庭都持相同看法。组织者于是保留图卡，同时增加可选的短录音，并把每张卡的讲述者写清楚。\n录音整理后都交本人核对，愿意只填卡的人也可以不录音。试用结束时，工作人员发现，观众开始问“这位讲述者为什么这样选择”，而不只问“你们是不是都这样”。策划人在总结中说，统一格式有助于寻找信息，但认识文化还要听具体人物的理由。传统可以有延续，也可以有变化；仅凭一个故事，不足以推断每个家庭或每个地区的生活方式。", "zh-Hant": "社區故事展起初規定，每位參與者只能填寫同樣的五個問題，工作人員再把答案做成統一圖卡。一位參與者說，這樣容易比較，卻沒有地方說明自己爲什麼改變做法。另一位參與者擔心，若只展示一句話，觀衆會以爲整個家庭都持相同看法。組織者於是保留圖卡，同時增加可選的短錄音，並把每張卡的講述者寫清楚。\n錄音整理後都交本人覈對，願意只填卡的人也可以不錄音。試用結束時，工作人員發現，觀衆開始問“這位講述者爲什麼這樣選擇”，而不只問“你們是不是都這樣”。策劃人在總結中說，統一格式有助於尋找信息，但認識文化還要聽具體人物的理由。傳統可以有延續，也可以有變化；僅憑一個故事，不足以推斷每個家庭或每個地區的生活方式。"}, "hanziCount": 264}], "questions": [{"id": "course-zh4-a-q01", "blueprintSlotId": "C4-L-01", "number": 1, "section": "listening", "group": "L1", "theme": "heritage", "cognitiveTarget": "direct", "designDifficulty": "foundation", "materialId": "C4A-L1a", "target": "定位传承活动中明确保留的做法", "promptEn": "What does the speaker explicitly want to retain?", "options": {"A": {"zh-Hans": "只有英文的说明", "zh-Hant": "只有英文的說明"}, "B": {"zh-Hans": "去年的全部展品", "zh-Hant": "去年的全部展品"}, "C": {"zh-Hans": "原来的中文名字", "zh-Hant": "原來的中文名字"}}, "correctAnswer": "C", "evidence": {"materialId": "C4A-L1a", "quote": {"zh-Hans": "保留中文，再加一句英文说明", "zh-Hant": "保留中文，再加一句英文說明"}, "additionalQuotes": []}, "explanation": {"en": "She keeps the Chinese name and adds English.", "zh": "保留的是中文名字，并补充英文。"}, "distractors": {"A": {"en": "She explicitly wants both languages, not English alone.", "zh": "她主张两种文字并用，不是只用英文。"}, "B": {"en": "Nothing requires keeping all of last year's exhibits.", "zh": "材料没有要求保留去年的全部展品。"}}, "languageTags": ["connected-discourse", "heritage", "direct"], "crossSourceIntegration": false, "reviewStatus": "author_checked_pending_independent_review"}, {"id": "course-zh4-a-q02", "blueprintSlotId": "C4-L-02", "number": 2, "section": "listening", "group": "L1", "theme": "heritage", "cognitiveTarget": "direct", "designDifficulty": "foundation", "materialId": "C4A-L1b", "target": "辨识人物明确表达的文化经验", "promptEn": "What experience will the man describe?", "options": {"A": {"zh-Hans": "妹妹在外地参加比赛", "zh-Hant": "妹妹在外地參加比賽"}, "B": {"zh-Hans": "全家刚制定的新规定", "zh-Hant": "全家剛制定的新規定"}, "C": {"zh-Hans": "小时候与爷爷准备晚饭", "zh-Hant": "小時候與爺爺準備晚飯"}}, "correctAnswer": "C", "evidence": {"materialId": "C4A-L1b", "quote": {"zh-Hans": "这是我小时候和爷爷一起准备晚饭的经历", "zh-Hant": "這是我小時候和爺爺一起準備晚飯的經歷"}, "additionalQuotes": []}, "explanation": {"en": "He explicitly identifies a childhood cooking experience.", "zh": "他明确介绍自己小时候与爷爷准备晚饭的经历。"}, "distractors": {"A": {"en": "The sister studies elsewhere; no competition is mentioned.", "zh": "妹妹在外地读书，未提比赛。"}, "B": {"en": "He revises his generalization rather than making a family rule.", "zh": "他修正的是概括方式，没有制定新规定。"}}, "languageTags": ["connected-discourse", "heritage", "direct"], "crossSourceIntegration": false, "reviewStatus": "author_checked_pending_independent_review"}, {"id": "course-zh4-a-q03", "blueprintSlotId": "C4-L-03", "number": 3, "section": "listening", "group": "L1", "theme": "heritage", "cognitiveTarget": "integrate", "designDifficulty": "standard", "materialId": "C4A-L1b", "target": "连接过去和当前的选择，解释保留或改变的理由", "promptEn": "Why will the two recordings be presented together?", "options": {"A": {"zh-Hans": "展示不同背景下做法的变化", "zh-Hant": "展示不同背景下做法的變化"}, "B": {"zh-Hans": "证明妹妹必须恢复旧做法", "zh-Hant": "證明妹妹必須恢復舊做法"}, "C": {"zh-Hans": "选出唯一正确的做菜顺序", "zh-Hant": "選出唯一正確的做菜順序"}}, "correctAnswer": "A", "evidence": {"materialId": "C4A-L1b", "quote": {"zh-Hans": "做菜步骤却可以不同", "zh-Hant": "做菜步驟卻可以不同"}, "additionalQuotes": [{"zh-Hans": "让观众听出两个人的生活背景", "zh-Hant": "讓觀衆聽出兩個人的生活背景"}]}, "explanation": {"en": "The paired experiences explain variation without declaring one correct tradition.", "zh": "两段经历呈现不同生活背景，允许步骤有变化。"}, "distractors": {"B": {"en": "He permits his sister's current method; she need not restore the old one.", "zh": "他允许妹妹补充现在的办法，没有要求恢复。"}, "C": {"en": "He explicitly rejects deciding which method alone is correct.", "zh": "他说不是判断谁才正确。"}}, "languageTags": ["connected-discourse", "heritage", "integrate"], "crossSourceIntegration": false, "reviewStatus": "author_checked_pending_independent_review"}, {"id": "course-zh4-a-q04", "blueprintSlotId": "C4-L-04", "number": 4, "section": "listening", "group": "L1", "theme": "connections", "cognitiveTarget": "direct", "designDifficulty": "standard", "materialId": "C4A-L1c", "target": "辨识两位交流者各自明确的关注点", "promptEn": "What was the organizer’s stated purpose?", "options": {"A": {"zh-Hans": "让新伙伴轻松认识彼此", "zh-Hant": "讓新夥伴輕鬆認識彼此"}, "B": {"zh-Hans": "要求伙伴提前交翻译成品", "zh-Hant": "要求夥伴提前交翻譯成品"}, "C": {"zh-Hans": "当场选出最好的演讲者", "zh-Hant": "當場選出最好的演講者"}}, "correctAnswer": "A", "evidence": {"materialId": "C4A-L1c", "quote": {"zh-Hans": "让第一次见面的同学轻松一些", "zh-Hant": "讓第一次見面的同學輕鬆一些"}, "additionalQuotes": []}, "explanation": {"en": "The first message states an introductory, low-pressure meeting.", "zh": "甲说明要让初次见面的同学轻松认识。"}, "distractors": {"B": {"en": "The organizer says no finished translation is needed beforehand.", "zh": "甲明确不需要先交成品。"}, "C": {"en": "There is no speech contest or selection.", "zh": "没有演讲比赛或选拔安排。"}}, "languageTags": ["connected-discourse", "connections", "direct"], "crossSourceIntegration": false, "reviewStatus": "author_checked_pending_independent_review"}, {"id": "course-zh4-a-q05", "blueprintSlotId": "C4-L-05", "number": 5, "section": "listening", "group": "L1", "theme": "connections", "cognitiveTarget": "infer", "designDifficulty": "stretch", "materialId": "C4A-L1c", "target": "对照两段语音留言，推断误会的具体来源并限定结论", "promptEn": "What most likely caused the misunderstanding?", "options": {"A": {"zh-Hans": "伙伴认为自己的翻译已经被拒绝", "zh-Hant": "夥伴認爲自己的翻譯已經被拒絕"}, "B": {"zh-Hans": "双方把非正式见面理解成不同的参与要求", "zh-Hant": "雙方把非正式見面理解成不同的參與要求"}, "C": {"zh-Hans": "组织者临时把会议改成了值班", "zh-Hant": "組織者臨時把會議改成了值班"}}, "correctAnswer": "B", "evidence": {"materialId": "C4A-L1c", "quote": {"zh-Hans": "不用准备正式发言", "zh-Hant": "不用準備正式發言"}, "additionalQuotes": [{"zh-Hans": "我以为随便聊聊就是可以不参加", "zh-Hant": "我以爲隨便聊聊就是可以不參加"}]}, "explanation": {"en": "The first speaker meant informal participation; the second interpreted it as optional attendance.", "zh": "甲指不用正式发言，乙却理解为可以缺席，误差来自参与要求。"}, "distractors": {"A": {"en": "No translation has been rejected or even required yet.", "zh": "甲没有拒绝任何翻译，且没有要求成品。"}, "C": {"en": "The partner arranged the duty shift; the organizer did not replace the meeting.", "zh": "值班是乙自行答应的安排，不是甲更改会议。"}}, "languageTags": ["connected-discourse", "connections", "infer"], "crossSourceIntegration": true, "reviewStatus": "author_checked_pending_independent_review"}, {"id": "course-zh4-a-q06", "blueprintSlotId": "C4-L-06", "number": 6, "section": "listening", "group": "L2", "theme": "connections", "cognitiveTarget": "direct", "designDifficulty": "foundation", "materialId": "C4A-L2a", "target": "定位交流通知中已确认的安排", "promptEn": "What must participants prepare?", "options": {"A": {"zh-Hans": "看照片后提出一个相关问题", "zh-Hant": "看照片後提出一個相關問題"}, "B": {"zh-Hans": "交一篇完整的文化研究报告", "zh-Hant": "交一篇完整的文化研究報告"}, "C": {"zh-Hans": "周三完成正式交流", "zh-Hant": "週三完成正式交流"}}, "correctAnswer": "A", "evidence": {"materialId": "C4A-L2a", "quote": {"zh-Hans": "每个人都要准备一个与照片有关的问题", "zh-Hant": "每個人都要準備一個與照片有關的問題"}, "additionalQuotes": []}, "explanation": {"en": "A photo-related question is required.", "zh": "要求是根据照片准备一个问题。"}, "distractors": {"B": {"en": "A complete report is explicitly unnecessary.", "zh": "明确不用写完整报告。"}, "C": {"en": "Wednesday is the device check; the exchange is Thursday.", "zh": "周三只有设备测试，交流在周四。"}}, "languageTags": ["connected-discourse", "connections", "direct"], "crossSourceIntegration": false, "reviewStatus": "author_checked_pending_independent_review"}, {"id": "course-zh4-a-q07", "blueprintSlotId": "C4-L-07", "number": 7, "section": "listening", "group": "L2", "theme": "technology", "cognitiveTarget": "integrate", "designDifficulty": "standard", "materialId": "C4A-L2b", "target": "结合两名使用者的反馈，归纳工具的共同用途", "promptEn": "What useful function do both users describe?", "options": {"A": {"zh-Hans": "保证所有称呼和地名都准确", "zh-Hant": "保證所有稱呼和地名都準確"}, "B": {"zh-Hans": "完全代替讲故事的人审核", "zh-Hant": "完全代替講故事的人審覈"}, "C": {"zh-Hans": "帮助更快地完成初步语言处理", "zh-Hant": "幫助更快地完成初步語言處理"}}, "correctAnswer": "C", "evidence": {"materialId": "C4A-L2b", "quote": {"zh-Hans": "第一稿出来得很快", "zh-Hant": "第一稿出來得很快"}, "additionalQuotes": [{"zh-Hans": "省下了查普通词的时间", "zh-Hant": "省下了查普通詞的時間"}]}, "explanation": {"en": "Both gain initial drafting or lookup speed while still finding errors.", "zh": "两人都承认初稿或查词省时，同时指出错误。"}, "distractors": {"A": {"en": "Both reports identify errors in names or forms of address.", "zh": "两段都列出称呼或地名问题。"}, "B": {"en": "One wants the storyteller's check and the other requires human confirmation.", "zh": "甲要请本人检查，乙要求人工确认。"}}, "languageTags": ["connected-discourse", "technology", "integrate"], "crossSourceIntegration": false, "reviewStatus": "author_checked_pending_independent_review"}, {"id": "course-zh4-a-q08", "blueprintSlotId": "C4-L-08", "number": 8, "section": "listening", "group": "L2", "theme": "technology", "cognitiveTarget": "integrate", "designDifficulty": "standard", "materialId": "C4A-L2b", "target": "比较两段反馈中的不同限制，选择符合双方条件的改进", "promptEn": "Which improvement best addresses both reports?", "options": {"A": {"zh-Hans": "原文译文并排，修改留标记，确认后发布", "zh-Hant": "原文譯文並排，修改留標記，確認後發佈"}, "B": {"zh-Hans": "隐藏原文，自动发布全部译文", "zh-Hant": "隱藏原文，自動發佈全部譯文"}, "C": {"zh-Hans": "只提高发布速度，不保留修改记录", "zh-Hant": "只提高發布速度，不保留修改記錄"}}, "correctAnswer": "A", "evidence": {"materialId": "C4A-L2b", "quote": {"zh-Hans": "先看到中文原稿和英文并排的结果", "zh-Hant": "先看到中文原稿和英文並排的結果"}, "additionalQuotes": [{"zh-Hans": "给改过的地方作标记", "zh-Hant": "給改過的地方作標記"}]}, "explanation": {"en": "Side-by-side review and tracked edits address both users before release.", "zh": "并排核对回应甲，修改标记回应乙，人工确认符合双方限制。"}, "distractors": {"B": {"en": "Both want to retain the original and reject unchecked automatic release.", "zh": "两人都希望保留两种文字，且不能自动全发。"}, "C": {"en": "Speed alone ignores accuracy and revision tracking.", "zh": "只提速忽略准确性和修改记录。"}}, "languageTags": ["connected-discourse", "technology", "integrate"], "crossSourceIntegration": true, "reviewStatus": "author_checked_pending_independent_review"}, {"id": "course-zh4-a-q09", "blueprintSlotId": "C4-L-09", "number": 9, "section": "listening", "group": "L2", "theme": "society", "cognitiveTarget": "direct", "designDifficulty": "standard", "materialId": "C4A-L2c", "target": "辨识社区服务讨论中明确提出的规则", "promptEn": "Which rule is explicitly proposed for every group?", "options": {"A": {"zh-Hans": "不用预约的组可以一直使用", "zh-Hant": "不用預約的組可以一直使用"}, "B": {"zh-Hans": "每组最多使用三十分钟", "zh-Hant": "每組最多使用三十分鐘"}, "C": {"zh-Hans": "靠窗区域改为自由讨论区", "zh-Hant": "靠窗區域改爲自由討論區"}}, "correctAnswer": "B", "evidence": {"materialId": "C4A-L2c", "quote": {"zh-Hans": "每组仍然最多用三十分钟", "zh-Hant": "每組仍然最多用三十分鐘"}, "additionalQuotes": []}, "explanation": {"en": "The time limit applies even in the walk-in slot.", "zh": "不用预约的时段仍保留每组三十分钟限制。"}, "distractors": {"A": {"en": "The man explicitly rejects unlimited occupation.", "zh": "乙明确反对一直占用。"}, "C": {"en": "The window area remains quiet.", "zh": "靠窗区域继续安静。"}}, "languageTags": ["connected-discourse", "society", "direct"], "crossSourceIntegration": false, "reviewStatus": "author_checked_pending_independent_review"}, {"id": "course-zh4-a-q10", "blueprintSlotId": "C4-L-10", "number": 10, "section": "listening", "group": "L2", "theme": "society", "cognitiveTarget": "infer", "designDifficulty": "stretch", "materialId": "C4A-L2c", "target": "结合规则和个别需要，推断说话者为何接受有条件的安排", "promptEn": "Why does the man accept the trial conditionally?", "options": {"A": {"zh-Hans": "已经证明新规则对所有人都最好", "zh-Hant": "已經證明新規則對所有人都最好"}, "B": {"zh-Hans": "希望取消全部需要预约的时段", "zh-Hant": "希望取消全部需要預約的時段"}, "C": {"zh-Hans": "兼顾临时需要，并用时限和记录检查影响", "zh-Hant": "兼顧臨時需要，並用時限和記錄檢查影響"}}, "correctAnswer": "C", "evidence": {"materialId": "C4A-L2c", "quote": {"zh-Hans": "不用预约也不该表示可以一直占着房间", "zh-Hant": "不用預約也不該表示可以一直佔着房間"}, "additionalQuotes": [{"zh-Hans": "两周后再看等候记录", "zh-Hant": "兩週後再看等候記錄"}]}, "explanation": {"en": "He accepts a bounded trial with safeguards and later evidence, not a proven universal solution.", "zh": "他接受的是保留时限并查记录的试行，可据此评估影响。"}, "distractors": {"A": {"en": "The trial will be evaluated later; universal success is not established.", "zh": "两周后才评估，尚未证明对所有人最好。"}, "B": {"en": "He does not ask to cancel every reservation slot.", "zh": "他没有要求取消全部预约。"}}, "languageTags": ["connected-discourse", "society", "infer"], "crossSourceIntegration": false, "reviewStatus": "author_checked_pending_independent_review"}, {"id": "course-zh4-a-q11", "blueprintSlotId": "C4-L-11", "number": 11, "section": "listening", "group": "L3", "theme": "expression", "cognitiveTarget": "direct", "designDifficulty": "foundation", "materialId": "C4A-L3a", "target": "辨识原创节目或作品介绍的主要目的", "promptEn": "What is the main purpose of the screening?", "options": {"A": {"zh-Hans": "讨论细节如何支持不同理解", "zh-Hant": "討論細節如何支持不同理解"}, "B": {"zh-Hans": "教授照片分类的唯一方法", "zh-Hant": "教授照片分類的唯一方法"}, "C": {"zh-Hans": "让观众背出统一的感想", "zh-Hant": "讓觀衆背出統一的感想"}}, "correctAnswer": "A", "evidence": {"materialId": "C4A-L3a", "quote": {"zh-Hans": "看看这些细节怎样影响理解", "zh-Hant": "看看這些細節怎樣影響理解"}, "additionalQuotes": []}, "explanation": {"en": "The screening invites evidence-based discussion of differing interpretations.", "zh": "放映后的任务是根据细节讨论理解。"}, "distractors": {"B": {"en": "The introduction explicitly says this is not a photo-sorting lesson.", "zh": "开头明确不是教整理照片。"}, "C": {"en": "It explicitly rejects memorizing a standard reaction.", "zh": "结尾明确不要求标准感想。"}}, "languageTags": ["connected-discourse", "expression", "direct"], "crossSourceIntegration": false, "reviewStatus": "author_checked_pending_independent_review"}, {"id": "course-zh4-a-q12", "blueprintSlotId": "C4-L-12", "number": 12, "section": "listening", "group": "L3", "theme": "expression", "cognitiveTarget": "integrate", "designDifficulty": "standard", "materialId": "C4A-L3b", "target": "整合创作者的例子和说明，解释表达手法的作用", "promptEn": "How does the pause help communicate the character’s feelings?", "options": {"A": {"zh-Hans": "表明他已经决定不参加活动", "zh-Hant": "表明他已經決定不參加活動"}, "B": {"zh-Hans": "与不敢开口的前话相连，表现犹豫", "zh-Hant": "與不敢開口的前話相連，表現猶豫"}, "C": {"zh-Hans": "说明他一定在门外等朋友", "zh-Hant": "說明他一定在門外等朋友"}}, "correctAnswer": "B", "evidence": {"materialId": "C4A-L3b", "quote": {"zh-Hans": "怕进去以后不知道怎样开口", "zh-Hant": "怕進去以後不知道怎樣開口"}, "additionalQuotes": [{"zh-Hans": "他伸手又收回的一个动作", "zh-Hant": "他伸手又收回的一個動作"}]}, "explanation": {"en": "Earlier fear and the interrupted gesture support hesitation.", "zh": "前面怕开口与伸手又收回的动作相连，支持犹豫。"}, "distractors": {"A": {"en": "He eventually enters; there is no settled decision to withdraw.", "zh": "最后仍进去，不能据此说决定不参加。"}, "C": {"en": "Waiting for a friend is one audience reading, not a confirmed fact.", "zh": "等朋友只是部分观众解读，不是确定事实。"}}, "languageTags": ["connected-discourse", "expression", "integrate"], "crossSourceIntegration": false, "reviewStatus": "author_checked_pending_independent_review"}, {"id": "course-zh4-a-q13", "blueprintSlotId": "C4-L-13", "number": 13, "section": "listening", "group": "L3", "theme": "expression", "cognitiveTarget": "infer", "designDifficulty": "stretch", "materialId": "C4A-L3b", "target": "从行为及评价推断人物或创作者的态度，保留其限制", "promptEn": "Which view best represents the filmmaker’s attitude?", "options": {"A": {"zh-Hans": "允许不同理解，但需要画面依据", "zh-Hant": "允許不同理解，但需要畫面依據"}, "B": {"zh-Hans": "只接受导演本人说出的唯一答案", "zh-Hant": "只接受導演本人說出的唯一答案"}, "C": {"zh-Hans": "所有与画面无关的猜想都同样合理", "zh-Hant": "所有與畫面無關的猜想都同樣合理"}}, "correctAnswer": "A", "evidence": {"materialId": "C4A-L3b", "quote": {"zh-Hans": "希望大家的解释能联系画面", "zh-Hant": "希望大家的解釋能聯繫畫面"}, "additionalQuotes": []}, "explanation": {"en": "He allows variation but requires support in the film.", "zh": "他容许解读不同，同时要求联系画面。"}, "distractors": {"B": {"en": "He welcomes different interpretations.", "zh": "他说愿意有不同理解。"}, "C": {"en": "He rejects guesses that cannot be related to the images.", "zh": "他明确反对任何猜想都一样有道理。"}}, "languageTags": ["connected-discourse", "expression", "infer"], "crossSourceIntegration": false, "reviewStatus": "author_checked_pending_independent_review"}, {"id": "course-zh4-a-q14", "blueprintSlotId": "C4-L-14", "number": 14, "section": "listening", "group": "L3", "theme": "environment", "cognitiveTarget": "direct", "designDifficulty": "standard", "materialId": "C4A-L3c", "target": "辨识两个环保提案各自明确的资源需求", "promptEn": "What resource does Plan A explicitly have?", "options": {"A": {"zh-Hans": "周末全天开放的清洗室", "zh-Hant": "週末全天開放的清洗室"}, "B": {"zh-Hans": "周五可用的清洗室和两位清洗者", "zh-Hant": "週五可用的清洗室和兩位清洗者"}, "C": {"zh-Hans": "足够所有活动同时使用的杯子", "zh-Hant": "足夠所有活動同時使用的杯子"}}, "correctAnswer": "B", "evidence": {"materialId": "C4A-L3c", "quote": {"zh-Hans": "清洗室周五下午能用，两位同学愿意在结束后负责清洗", "zh-Hant": "清洗室週五下午能用，兩位同學願意在結束後負責清洗"}, "additionalQuotes": []}, "explanation": {"en": "A has a Friday washing slot and two volunteers.", "zh": "甲已明确清洗时间和人手。"}, "distractors": {"A": {"en": "The second proposal says the washing room is closed at weekends.", "zh": "乙说明周末不开。"}, "C": {"en": "Only a hundred cups are available; simultaneous use at every event is unproven.", "zh": "现有一百个，未证明够所有活动同时使用。"}}, "languageTags": ["connected-discourse", "environment", "direct"], "crossSourceIntegration": false, "reviewStatus": "author_checked_pending_independent_review"}, {"id": "course-zh4-a-q15", "blueprintSlotId": "C4-L-15", "number": 15, "section": "listening", "group": "L3", "theme": "environment", "cognitiveTarget": "integrate", "designDifficulty": "standard", "materialId": "C4A-L3c", "target": "对照两份口头提案，选择符合当前资源和期限的行动", "promptEn": "Which action is best supported by both proposals?", "options": {"A": {"zh-Hans": "只要杯子有一百个就立即全面推广", "zh-Hant": "只要杯子有一百個就立即全面推廣"}, "B": {"zh-Hans": "先按甲试一次，推广前补足清洗存放安排", "zh-Hant": "先按甲試一次，推廣前補足清洗存放安排"}, "C": {"zh-Hans": "先取消周五清洗，再增加周末活动", "zh-Hant": "先取消週五清洗，再增加週末活動"}}, "correctAnswer": "B", "evidence": {"materialId": "C4A-L3c", "quote": {"zh-Hans": "记录归还情况，再决定要不要扩大", "zh-Hant": "記錄歸還情況，再決定要不要擴大"}, "additionalQuotes": [{"zh-Hans": "先解决清洗和存放，再推广比较稳妥", "zh-Hant": "先解決清洗和存放，再推廣比較穩妥"}]}, "explanation": {"en": "A supplies a feasible pilot and B identifies missing conditions for expansion.", "zh": "甲具备单次试用条件，乙指出扩展所缺条件，支持先试再补足。"}, "distractors": {"A": {"en": "The second speaker explicitly rejects deciding on quantity alone.", "zh": "乙明确不能只看数量。"}, "C": {"en": "Removing Friday washing would undermine the feasible pilot.", "zh": "取消已有清洗条件会破坏甲的可行性。"}}, "languageTags": ["connected-discourse", "environment", "integrate"], "crossSourceIntegration": true, "reviewStatus": "author_checked_pending_independent_review"}, {"id": "course-zh4-a-q16", "blueprintSlotId": "C4-L-16", "number": 16, "section": "listening", "group": "L4", "theme": "environment", "cognitiveTarget": "direct", "designDifficulty": "foundation", "materialId": "C4A-L4a", "target": "定位环保行动修订后的实施条件", "promptEn": "What condition remains unchanged?", "options": {"A": {"zh-Hans": "每个人仍须自己排队送杯子", "zh-Hant": "每個人仍須自己排隊送杯子"}, "B": {"zh-Hans": "破损杯一律记成未归还", "zh-Hant": "破損杯一律記成未歸還"}, "C": {"zh-Hans": "仍须在周五下午清洗", "zh-Hant": "仍須在週五下午清洗"}}, "correctAnswer": "C", "evidence": {"materialId": "C4A-L4a", "quote": {"zh-Hans": "杯子仍然只在周五下午清洗", "zh-Hant": "杯子仍然只在週五下午清洗"}, "additionalQuotes": []}, "explanation": {"en": "The revised return method retains Friday washing.", "zh": "调整送回方式，清洗时间仍为周五下午。"}, "distractors": {"A": {"en": "Returns change to two representatives per class.", "zh": "改为各班两名代表送。"}, "B": {"en": "Damage and non-return are recorded separately.", "zh": "破损与未归还分别记录。"}}, "languageTags": ["connected-discourse", "environment", "direct"], "crossSourceIntegration": false, "reviewStatus": "author_checked_pending_independent_review"}, {"id": "course-zh4-a-q17", "blueprintSlotId": "C4-L-17", "number": 17, "section": "listening", "group": "L4", "theme": "technology", "cognitiveTarget": "integrate", "designDifficulty": "standard", "materialId": "C4A-L4b", "target": "连接工具试用前后表现与使用条件", "promptEn": "What helps explain the different trial results?", "options": {"A": {"zh-Hans": "工具在所有地点都从未出现错误", "zh-Hant": "工具在所有地點都從未出現錯誤"}, "B": {"zh-Hans": "新同学都拒绝接受操作说明", "zh-Hant": "新同學都拒絕接受操作說明"}, "C": {"zh-Hans": "标记亮度和使用者操作经验不同", "zh-Hant": "標記亮度和使用者操作經驗不同"}}, "correctAnswer": "C", "evidence": {"materialId": "C4A-L4b", "quote": {"zh-Hans": "地下活动室的牌子太暗", "zh-Hant": "地下活動室的牌子太暗"}, "additionalQuotes": [{"zh-Hans": "需要我先教他们怎么拍标记", "zh-Hant": "需要我先教他們怎麼拍標記"}]}, "explanation": {"en": "Environmental visibility and prior operating skill both affect the observed results.", "zh": "甲说明光线限制，乙说明操作经验影响，两者解释效果差异。"}, "distractors": {"A": {"en": "The first interview explicitly reports two reading errors.", "zh": "甲明确发生两次读错。"}, "B": {"en": "Two learners can use it after instruction; they did not all reject help.", "zh": "乙的两位同学学过后能找到地点。"}}, "languageTags": ["connected-discourse", "technology", "integrate"], "crossSourceIntegration": false, "reviewStatus": "author_checked_pending_independent_review"}, {"id": "course-zh4-a-q18", "blueprintSlotId": "C4-L-18", "number": 18, "section": "listening", "group": "L4", "theme": "technology", "cognitiveTarget": "infer", "designDifficulty": "stretch", "materialId": "C4A-L4b", "target": "比较两段访谈中的证据，推断哪一项结论超出了材料范围", "promptEn": "Which conclusion goes beyond the interview evidence?", "options": {"A": {"zh-Hans": "部分使用者学习操作后能找到地点", "zh-Hant": "部分使用者學習操作後能找到地點"}, "B": {"zh-Hans": "所有新生在任何地点都不再需要帮助", "zh-Hant": "所有新生在任何地點都不再需要幫助"}, "C": {"zh-Hans": "改善较暗地点的标记值得继续试验", "zh-Hant": "改善較暗地點的標記值得繼續試驗"}}, "correctAnswer": "B", "evidence": {"materialId": "C4A-L4b", "quote": {"zh-Hans": "三个人的经历不能说明所有新生都不用帮助", "zh-Hant": "三個人的經歷不能說明所有新生都不用幫助"}, "additionalQuotes": [{"zh-Hans": "更不能说工具已经在任何地方都准确", "zh-Hant": "更不能說工具已經在任何地方都準確"}]}, "explanation": {"en": "The universal claim exceeds a small, conditional trial.", "zh": "三人试用且有光线与操作限制，不能推出普遍无需帮助。"}, "distractors": {"A": {"en": "The second interview directly reports successful use after instruction.", "zh": "乙实际观察到教过后能找到地点。"}, "C": {"en": "The first interviewer explicitly proposes better signs and another trial.", "zh": "甲明确建议改善标记后再试。"}}, "languageTags": ["connected-discourse", "technology", "infer"], "crossSourceIntegration": true, "reviewStatus": "author_checked_pending_independent_review"}, {"id": "course-zh4-a-q19", "blueprintSlotId": "C4-L-19", "number": 19, "section": "listening", "group": "L4", "theme": "society", "cognitiveTarget": "integrate", "designDifficulty": "standard", "materialId": "C4A-L4c", "target": "综合社区行动中的异议、调整与结果说明协商过程", "promptEn": "How did the organizers respond to the objections?", "options": {"A": {"zh-Hans": "取消所有共同结构，只留下工作人员评论", "zh-Hant": "取消所有共同結構，只留下工作人員評論"}, "B": {"zh-Hans": "保留简表，同时加入经本人核对的故事录音", "zh-Hant": "保留簡表，同時加入經本人覈對的故事錄音"}, "C": {"zh-Hans": "要求每个家庭都承认做法从未改变", "zh-Hant": "要求每個家庭都承認做法從未改變"}}, "correctAnswer": "B", "evidence": {"materialId": "C4A-L4c", "quote": {"zh-Hans": "保留简短表格，让想讲经历的人加一段录音", "zh-Hant": "保留簡短表格，讓想講經歷的人加一段錄音"}, "additionalQuotes": [{"zh-Hans": "请本人检查", "zh-Hant": "請本人檢查"}]}, "explanation": {"en": "The solution keeps comparability and adds individually checked narratives.", "zh": "保留简表回应比较需要，增加本人核对的故事回应个体表达。"}, "distractors": {"A": {"en": "The shared structure remains and staff do not replace personal verification.", "zh": "共同结构保留，工作人员不代替本人确认。"}, "C": {"en": "The display explicitly allows practices to change.", "zh": "材料承认做法可能改变。"}}, "languageTags": ["connected-discourse", "society", "integrate"], "crossSourceIntegration": false, "reviewStatus": "author_checked_pending_independent_review"}, {"id": "course-zh4-a-q20", "blueprintSlotId": "C4-L-20", "number": 20, "section": "listening", "group": "L4", "theme": "heritage", "cognitiveTarget": "integrate", "designDifficulty": "standard", "materialId": "C4A-L4c", "target": "将交流后的反思与原有背景联系，解释对传统看法的变化", "promptEn": "How has the speaker’s understanding of tradition developed?", "options": {"A": {"zh-Hans": "开始重视讲述者、改变原因和仍保留的意义", "zh-Hant": "開始重視講述者、改變原因和仍保留的意義"}, "B": {"zh-Hans": "认为只要有变化就不再有任何传统意义", "zh-Hant": "認爲只要有變化就不再有任何傳統意義"}, "C": {"zh-Hans": "认为所有家庭最终都应该采用同一种做法", "zh-Hant": "認爲所有家庭最終都應該採用同一種做法"}}, "correctAnswer": "A", "evidence": {"materialId": "C4A-L4c", "quote": {"zh-Hans": "我原来觉得传统只要原样留下就好", "zh-Hant": "我原來覺得傳統只要原樣留下就好"}, "additionalQuotes": [{"zh-Hans": "现在更在意谁在讲、为什么改变，以及改变后哪些意义还在", "zh-Hant": "現在更在意誰在講、爲什麼改變，以及改變後哪些意義還在"}]}, "explanation": {"en": "Her reflection moves from unchanged form to people, reasons and continuing meaning.", "zh": "反思把形式不变扩展为讲述者、改变原因与意义延续。"}, "distractors": {"B": {"en": "She discusses meaning that can remain after a change.", "zh": "她明确关注改变后仍在的意义。"}, "C": {"en": "The display accommodates differences rather than one required practice.", "zh": "展览容纳个体差异，没有要求统一做法。"}}, "languageTags": ["connected-discourse", "heritage", "integrate"], "crossSourceIntegration": false, "reviewStatus": "author_checked_pending_independent_review"}, {"id": "course-zh4-a-q21", "blueprintSlotId": "C4-R-01", "number": 21, "section": "reading", "group": "R1", "theme": "heritage", "cognitiveTarget": "direct", "designDifficulty": "foundation", "materialId": "C4A-R1a", "target": "定位文化活动介绍中明确延续的环节", "promptEn": "Which element will definitely be retained on the label?", "options": {"A": {"zh-Hans": "讲述者选定的中文名字", "zh-Hant": "講述者選定的中文名字"}, "B": {"zh-Hans": "志愿者写的全部翻译意见", "zh-Hant": "志願者寫的全部翻譯意見"}, "C": {"zh-Hans": "只有英文而没有中文的标题", "zh-Hant": "只有英文而沒有中文的標題"}}, "correctAnswer": "A", "evidence": {"materialId": "C4A-R1a", "quote": {"zh-Hans": "仍把讲述者选定的中文名字印在旁边", "zh-Hant": "仍把講述者選定的中文名字印在旁邊"}, "additionalQuotes": []}, "explanation": {"en": "The chosen Chinese name remains beside the English title.", "zh": "中文名字明确保留在英文旁。"}, "distractors": {"B": {"en": "Volunteers' editing suggestions are discussion points, not all printed content.", "zh": "翻译意见是讨论内容，不是全部印上标签。"}, "C": {"en": "The decision explicitly keeps both languages.", "zh": "明确保留两种文字。"}}, "languageTags": ["connected-discourse", "heritage", "direct"], "crossSourceIntegration": false, "reviewStatus": "author_checked_pending_independent_review"}, {"id": "course-zh4-a-q22", "blueprintSlotId": "C4-R-02", "number": 22, "section": "reading", "group": "R1", "theme": "heritage", "cognitiveTarget": "direct", "designDifficulty": "foundation", "materialId": "C4A-R1b", "target": "辨识人物对身份和生活习惯的明确说明", "promptEn": "What does Xiaolan explicitly say her recording represents?", "options": {"A": {"zh-Hans": "她与外婆的一段个人经验", "zh-Hant": "她與外婆的一段個人經驗"}, "B": {"zh-Hans": "所有家庭都必须遵守的做法", "zh-Hant": "所有家庭都必須遵守的做法"}, "C": {"zh-Hans": "弟弟完整真实的聊天内容", "zh-Hant": "弟弟完整真實的聊天內容"}}, "correctAnswer": "A", "evidence": {"materialId": "C4A-R1b", "quote": {"zh-Hans": "这只是自己与外婆的经验", "zh-Hant": "這只是自己與外婆的經驗"}, "additionalQuotes": []}, "explanation": {"en": "She explicitly limits the account to her own experience.", "zh": "她主动限定为自己与外婆的经验。"}, "distractors": {"B": {"en": "She explicitly says the experience cannot represent all families.", "zh": "材料明确不能代表所有家庭。"}, "C": {"en": "Only invented examples, not private chat records, are displayed.", "zh": "展示只用编写示例，不公开真实聊天。"}}, "languageTags": ["connected-discourse", "heritage", "direct"], "crossSourceIntegration": false, "reviewStatus": "author_checked_pending_independent_review"}, {"id": "course-zh4-a-q23", "blueprintSlotId": "C4-R-03", "number": 23, "section": "reading", "group": "R1", "theme": "heritage", "cognitiveTarget": "integrate", "designDifficulty": "standard", "materialId": "C4A-R1b", "target": "结合两段经历说明同一做法在不同情境中的变化", "promptEn": "Why does she eventually accept the new illustration?", "options": {"A": {"zh-Hans": "旧菜单已经完全失去家庭意义", "zh-Hant": "舊菜單已經完全失去家庭意義"}, "B": {"zh-Hans": "工具改变仍可延续共同商量的习惯", "zh-Hant": "工具改變仍可延續共同商量的習慣"}, "C": {"zh-Hans": "手机工具能证明所有旧习惯都应取消", "zh-Hant": "手機工具能證明所有舊習慣都應取消"}}, "correctAnswer": "B", "evidence": {"materialId": "C4A-R1b", "quote": {"zh-Hans": "同意把两者并列", "zh-Hant": "同意把兩者並列"}, "additionalQuotes": [{"zh-Hans": "保留共同商量饭菜的习惯，不一定要求每次都使用同一种工具", "zh-Hant": "保留共同商量飯菜的習慣，不一定要求每次都使用同一種工具"}]}, "explanation": {"en": "She distinguishes the continuing practice from the tool used for it.", "zh": "她区分共同商量的习惯与使用的工具，允许新旧并列。"}, "distractors": {"A": {"en": "She retains the old menu and its remembered meaning.", "zh": "她仍展示旧菜单与回忆，未否定其意义。"}, "C": {"en": "The conclusion allows continuity, not cancellation of all old practices.", "zh": "结论是延续习惯，不是取消所有旧习惯。"}}, "languageTags": ["connected-discourse", "heritage", "integrate"], "crossSourceIntegration": false, "reviewStatus": "author_checked_pending_independent_review"}, {"id": "course-zh4-a-q24", "blueprintSlotId": "C4-R-04", "number": 24, "section": "reading", "group": "R1", "theme": "connections", "cognitiveTarget": "direct", "designDifficulty": "standard", "materialId": "C4A-R1c", "target": "辨识通知与回复中双方明确的交流目的", "promptEn": "What does the invitation explicitly require?", "options": {"A": {"zh-Hans": "代表先交完整翻译作品", "zh-Hant": "代表先交完整翻譯作品"}, "B": {"zh-Hans": "代表到场认识伙伴并确认分工", "zh-Hant": "代表到場認識夥伴並確認分工"}, "C": {"zh-Hans": "所有代表必须在碰面时演讲", "zh-Hant": "所有代表必須在碰面時演講"}}, "correctAnswer": "B", "evidence": {"materialId": "C4A-R1c", "quote": {"zh-Hans": "每位代表仍需到场", "zh-Hant": "每位代表仍需到場"}, "additionalQuotes": []}, "explanation": {"en": "Attendance is required even without a formal presentation.", "zh": "不正式展示并不取消代表到场要求。"}, "distractors": {"A": {"en": "The invitation explicitly says not to rush a finished product.", "zh": "邀请明确不用赶写成品。"}, "C": {"en": "Formal presentations are unnecessary.", "zh": "不需要正式展示。"}}, "languageTags": ["connected-discourse", "connections", "direct"], "crossSourceIntegration": false, "reviewStatus": "author_checked_pending_independent_review"}, {"id": "course-zh4-a-q25", "blueprintSlotId": "C4-R-05", "number": 25, "section": "reading", "group": "R1", "theme": "connections", "cognitiveTarget": "infer", "designDifficulty": "stretch", "materialId": "C4A-R1c", "target": "对照通知与回复，推断需要澄清的沟通误差", "promptEn": "Which clarification would best resolve the stated misunderstanding?", "options": {"A": {"zh-Hans": "区分不必展示和仍需到场，另确认时间冲突", "zh-Hant": "區分不必展示和仍需到場，另確認時間衝突"}, "B": {"zh-Hans": "说明翻译已经通过验收，无须再来", "zh-Hant": "說明翻譯已經通過驗收，無須再來"}, "C": {"zh-Hans": "要求伙伴删除全部排练安排", "zh-Hant": "要求夥伴刪除全部排練安排"}}, "correctAnswer": "A", "evidence": {"materialId": "C4A-R1c", "quote": {"zh-Hans": "以为午休那次可以不去", "zh-Hant": "以爲午休那次可以不去"}, "additionalQuotes": [{"zh-Hans": "每位代表仍需到场", "zh-Hant": "每位代表仍需到場"}]}, "explanation": {"en": "The reply misreads presentation requirements as attendance requirements.", "zh": "乙把不展示理解成可缺席，应先澄清并确认冲突处理。"}, "distractors": {"B": {"en": "No translation acceptance is reported.", "zh": "材料没有翻译验收。"}, "C": {"en": "A replacement representative may be negotiated; all rehearsals need not be cancelled.", "zh": "并未要求删除全部排练，可协调代表。"}}, "languageTags": ["connected-discourse", "connections", "infer"], "crossSourceIntegration": true, "reviewStatus": "author_checked_pending_independent_review"}, {"id": "course-zh4-a-q26", "blueprintSlotId": "C4-R-06", "number": 26, "section": "reading", "group": "R2", "theme": "connections", "cognitiveTarget": "direct", "designDifficulty": "foundation", "materialId": "C4A-R2a", "target": "定位跨文化交流计划的参与条件", "promptEn": "What preparation does the notice require?", "options": {"A": {"zh-Hans": "查询并背熟全部文化背景", "zh-Hant": "查詢並背熟全部文化背景"}, "B": {"zh-Hans": "读照片卡并准备一个相关问题", "zh-Hant": "讀照片卡並準備一個相關問題"}, "C": {"zh-Hans": "要求伙伴披露真实私人经历", "zh-Hant": "要求夥伴披露真實私人經歷"}}, "correctAnswer": "B", "evidence": {"materialId": "C4A-R2a", "quote": {"zh-Hans": "记下一个想进一步了解的问题", "zh-Hant": "記下一個想進一步瞭解的問題"}, "additionalQuotes": []}, "explanation": {"en": "The preparation is one question grounded in the supplied photo card.", "zh": "准备要求是根据照片卡提出一个问题。"}, "distractors": {"A": {"en": "Outside cultural research is explicitly unnecessary.", "zh": "明确不要求另外搜索文化知识。"}, "C": {"en": "The photographed person may decline private disclosure.", "zh": "人物可不回答私人经历。"}}, "languageTags": ["connected-discourse", "connections", "direct"], "crossSourceIntegration": false, "reviewStatus": "author_checked_pending_independent_review"}, {"id": "course-zh4-a-q27", "blueprintSlotId": "C4-R-07", "number": 27, "section": "reading", "group": "R2", "theme": "technology", "cognitiveTarget": "integrate", "designDifficulty": "standard", "materialId": "C4A-R2b", "target": "整合试用记录与反馈，解释工具的适用场景", "promptEn": "What is the tool’s demonstrated useful role?", "options": {"A": {"zh-Hans": "保证所有题材与口头对话都准确", "zh-Hant": "保證所有題材與口頭對話都準確"}, "B": {"zh-Hans": "让接待组完全不必再核对名字", "zh-Hant": "讓接待組完全不必再覈對名字"}, "C": {"zh-Hans": "快速提供供人工核对的英文初稿", "zh-Hant": "快速提供供人工覈對的英文初稿"}}, "correctAnswer": "C", "evidence": {"materialId": "C4A-R2b", "quote": {"zh-Hans": "很快有了英文初稿", "zh-Hant": "很快有了英文初稿"}, "additionalQuotes": [{"zh-Hans": "速度有帮助", "zh-Hant": "速度有幫助"}]}, "explanation": {"en": "Both texts support speed for drafts, with review still necessary.", "zh": "两份材料共同支持初稿提速，但仍须核对。"}, "distractors": {"A": {"en": "Other topics and oral conversation were not tested.", "zh": "甲未测试其他题材或对话。"}, "B": {"en": "Inconsistent names and outdated prints show checking is still needed.", "zh": "称呼不一致与旧版误印都说明仍需核对。"}}, "languageTags": ["connected-discourse", "technology", "integrate"], "crossSourceIntegration": false, "reviewStatus": "author_checked_pending_independent_review"}, {"id": "course-zh4-a-q28", "blueprintSlotId": "C4-R-08", "number": 28, "section": "reading", "group": "R2", "theme": "technology", "cognitiveTarget": "integrate", "designDifficulty": "standard", "materialId": "C4A-R2b", "target": "比较试用记录与反馈，筛选满足两项限制的改进", "promptEn": "Which revision addresses both documents?", "options": {"A": {"zh-Hans": "原译文并排，标改动与日期，确认后再印", "zh-Hant": "原譯文並排，標改動與日期，確認後再印"}, "B": {"zh-Hans": "删除原文，把所有初稿立即自动印出", "zh-Hant": "刪除原文，把所有初稿立即自動印出"}, "C": {"zh-Hans": "只统一页面颜色，不显示修改或日期", "zh-Hant": "只統一頁面顏色，不顯示修改或日期"}}, "correctAnswer": "A", "evidence": {"materialId": "C4A-R2b", "quote": {"zh-Hans": "先由熟悉内容的人确认，再公开", "zh-Hant": "先由熟悉內容的人確認，再公開"}, "additionalQuotes": [{"zh-Hans": "标出改动，并让确认后的版本有清楚日期", "zh-Hant": "標出改動，並讓確認後的版本有清楚日期"}]}, "explanation": {"en": "Review plus visible revision/version information addresses both identified problems.", "zh": "甲要确认内容，乙要修改和版本信息，组合办法回应两者。"}, "distractors": {"B": {"en": "This contradicts retaining the original and confirming the draft.", "zh": "违背保留原文与审核要求。"}, "C": {"en": "Page color cannot identify edits or the latest approved version.", "zh": "颜色不能解决旧版与修改来源问题。"}}, "languageTags": ["connected-discourse", "technology", "integrate"], "crossSourceIntegration": true, "reviewStatus": "author_checked_pending_independent_review"}, {"id": "course-zh4-a-q29", "blueprintSlotId": "C4-R-09", "number": 29, "section": "reading", "group": "R2", "theme": "society", "cognitiveTarget": "direct", "designDifficulty": "standard", "materialId": "C4A-R2c", "target": "定位公共服务规则及已说明的例外", "promptEn": "What explicit exception does the trial introduce?", "options": {"A": {"zh-Hans": "所有房间永远不再接受预约", "zh-Hant": "所有房間永遠不再接受預約"}, "B": {"zh-Hans": "靠窗阅读区可以自由大声讨论", "zh-Hant": "靠窗閱讀區可以自由大聲討論"}, "C": {"zh-Hans": "两天午休各有一间可排队使用的房间", "zh-Hant": "兩天午休各有一間可排隊使用的房間"}}, "correctAnswer": "C", "evidence": {"materialId": "C4A-R2c", "quote": {"zh-Hans": "周一与周四午休各留一个房间，不预约也可排队使用", "zh-Hant": "週一與週四午休各留一個房間，不預約也可排隊使用"}, "additionalQuotes": []}, "explanation": {"en": "The walk-in exception is restricted to one room in two lunch periods.", "zh": "例外限定在两天午休各一间房。"}, "distractors": {"A": {"en": "Other rooms remain reservable.", "zh": "其他房间继续预约。"}, "B": {"en": "The window reading zone stays quiet.", "zh": "靠窗区仍安静。"}}, "languageTags": ["connected-discourse", "society", "direct"], "crossSourceIntegration": false, "reviewStatus": "author_checked_pending_independent_review"}, {"id": "course-zh4-a-q30", "blueprintSlotId": "C4-R-10", "number": 30, "section": "reading", "group": "R2", "theme": "society", "cognitiveTarget": "infer", "designDifficulty": "stretch", "materialId": "C4A-R2c", "target": "从规则和个案依据推断建议的适用边界", "promptEn": "Under what condition is the supporting student’s view best understood?", "options": {"A": {"zh-Hans": "有使用时限并依据两类记录评估试行", "zh-Hant": "有使用時限並依據兩類記錄評估試行"}, "B": {"zh-Hans": "已经证明临时使用在所有情况下更公平", "zh-Hant": "已經證明臨時使用在所有情況下更公平"}, "C": {"zh-Hans": "只记录预约者，不需要了解临时使用者", "zh-Hant": "只記錄預約者，不需要了解臨時使用者"}}, "correctAnswer": "A", "evidence": {"materialId": "C4A-R2c", "quote": {"zh-Hans": "条件是把排队和超时情况记下来", "zh-Hant": "條件是把排隊和超時情況記下來"}, "additionalQuotes": [{"zh-Hans": "同时查看预约组与临时组的记录", "zh-Hant": "同時查看預約組與臨時組的記錄"}]}, "explanation": {"en": "His support depends on limits and evidence from both groups.", "zh": "支持有记录和时限条件，评估须兼顾两类使用者。"}, "distractors": {"B": {"en": "He proposes a trial rather than claiming universal proof.", "zh": "他只提出试行，没有普遍证明。"}, "C": {"en": "He asks for records from both groups, not only reserving users.", "zh": "他要求同时查看两类记录。"}}, "languageTags": ["connected-discourse", "society", "infer"], "crossSourceIntegration": false, "reviewStatus": "author_checked_pending_independent_review"}, {"id": "course-zh4-a-q31", "blueprintSlotId": "C4-R-11", "number": 31, "section": "reading", "group": "R3", "theme": "expression", "cognitiveTarget": "direct", "designDifficulty": "foundation", "materialId": "C4A-R3a", "target": "辨识原创短评或微型叙事的受众和目的", "promptEn": "Who is the discussion designed for, and what should they do?", "options": {"A": {"zh-Hans": "电影专家背诵统一术语和感想", "zh-Hant": "電影專家背誦統一術語和感想"}, "B": {"zh-Hans": "普通观众根据共同细节解释人物", "zh-Hant": "普通觀衆根據共同細節解釋人物"}, "C": {"zh-Hans": "只有同意创作者的人才能发言", "zh-Hant": "只有同意創作者的人才能發言"}}, "correctAnswer": "B", "evidence": {"materialId": "C4A-R3a", "quote": {"zh-Hans": "面向普通观众，不要求知道电影术语", "zh-Hant": "面向普通觀衆，不要求知道電影術語"}, "additionalQuotes": []}, "explanation": {"en": "Ordinary viewers are invited to use shared details for interpretation.", "zh": "活动面向普通观众，并要求联系画面细节。"}, "distractors": {"A": {"en": "Neither technical terms nor standard reactions are required.", "zh": "明确不要求术语或标准感想。"}, "C": {"en": "Different interpretations remain welcome.", "zh": "不同观点也可以讨论。"}}, "languageTags": ["connected-discourse", "expression", "direct"], "crossSourceIntegration": false, "reviewStatus": "author_checked_pending_independent_review"}, {"id": "course-zh4-a-q32", "blueprintSlotId": "C4-R-12", "number": 32, "section": "reading", "group": "R3", "theme": "expression", "cognitiveTarget": "integrate", "designDifficulty": "standard", "materialId": "C4A-R3b", "target": "把作品细节与评论中的主张对应", "promptEn": "Which change supports the commentary’s view of a new opening?", "options": {"A": {"zh-Hans": "删除全部问候且拒绝发送消息", "zh-Hant": "刪除全部問候且拒絕發送消息"}, "B": {"zh-Hans": "收到朋友道歉以后才参加活动", "zh-Hant": "收到朋友道歉以後才參加活動"}, "C": {"zh-Hans": "把猜测朋友态度的话改为共同经历", "zh-Hant": "把猜測朋友態度的話改爲共同經歷"}}, "correctAnswer": "C", "evidence": {"materialId": "C4A-R3b", "quote": {"zh-Hans": "删掉开头那句“你一定早就忘了”", "zh-Hant": "刪掉開頭那句“你一定早就忘了”"}, "additionalQuotes": [{"zh-Hans": "换成“我还记得我们一起做展板的下午”", "zh-Hant": "換成“我還記得我們一起做展板的下午”"}]}, "explanation": {"en": "The actual revision replaces an accusatory assumption with a shared memory.", "zh": "修改把指责式猜测换成共同记忆，支持重新开口。"}, "distractors": {"A": {"en": "The message is actually sent.", "zh": "消息最终发出。"}, "B": {"en": "No reply or apology is supplied in the story.", "zh": "故事未写回复，更未写道歉。"}}, "languageTags": ["connected-discourse", "expression", "integrate"], "crossSourceIntegration": false, "reviewStatus": "author_checked_pending_independent_review"}, {"id": "course-zh4-a-q33", "blueprintSlotId": "C4-R-13", "number": 33, "section": "reading", "group": "R3", "theme": "expression", "cognitiveTarget": "infer", "designDifficulty": "stretch", "materialId": "C4A-R3b", "target": "用叙事证据推断人物立场或评论语气，排除过度解释", "promptEn": "Which inference is supported while respecting the story’s limit?", "options": {"A": {"zh-Hans": "朋友已经明确原谅并马上回复", "zh-Hant": "朋友已經明確原諒並馬上回復"}, "B": {"zh-Hans": "把手机收起证明他再也不想联系", "zh-Hant": "把手機收起證明他再也不想聯繫"}, "C": {"zh-Hans": "阿宁尝试联系，但尚不能确认双方已经和好", "zh-Hant": "阿寧嘗試聯繫，但尚不能確認雙方已經和好"}}, "correctAnswer": "C", "evidence": {"materialId": "C4A-R3b", "quote": {"zh-Hans": "故事没有写朋友是否回复", "zh-Hant": "故事沒有寫朋友是否回覆"}, "additionalQuotes": []}, "explanation": {"en": "An attempt to reconnect is shown; the other person’s response remains unknown.", "zh": "已经发出问候，显示尝试联系；朋友态度和和好状态未知。"}, "distractors": {"A": {"en": "The story contains no response showing forgiveness.", "zh": "没有回复内容支持原谅。"}, "B": {"en": "Putting the phone away after sending does not establish permanent withdrawal.", "zh": "他刚发送问候，收手机不等于永不联系。"}}, "languageTags": ["connected-discourse", "expression", "infer"], "crossSourceIntegration": false, "reviewStatus": "author_checked_pending_independent_review"}, {"id": "course-zh4-a-q34", "blueprintSlotId": "C4-R-14", "number": 34, "section": "reading", "group": "R3", "theme": "environment", "cognitiveTarget": "direct", "designDifficulty": "standard", "materialId": "C4A-R3c", "target": "定位两种环境行动方案的明确目标和资源", "promptEn": "Which resources are explicitly secured for Friday?", "options": {"A": {"zh-Hans": "周末清洗地点与长期通道储存位置", "zh-Hant": "週末清洗地點與長期通道儲存位置"}, "B": {"zh-Hans": "归还箱、两位志愿者及当天清洗条件", "zh-Hant": "歸還箱、兩位志願者及當天清洗條件"}, "C": {"zh-Hans": "立即购买的新杯子和周六收杯人员", "zh-Hant": "立即購買的新杯子和週六收杯人員"}}, "correctAnswer": "B", "evidence": {"materialId": "C4A-R3c", "quote": {"zh-Hans": "两位志愿者愿意收齐并在当天清洗", "zh-Hant": "兩位志願者願意收齊並在當天清洗"}, "additionalQuotes": []}, "explanation": {"en": "Friday return and washing are arranged.", "zh": "甲已有归还箱和两人当天清洗，乙确认周五可用。"}, "distractors": {"A": {"en": "Weekend washing is unavailable and the corridor cannot hold the box permanently.", "zh": "乙说明周末关闭且不能长期占通道。"}, "C": {"en": "No new cups are being bought; Saturday collection is not arranged.", "zh": "甲暂不购买，周六安排未定。"}}, "languageTags": ["connected-discourse", "environment", "direct"], "crossSourceIntegration": false, "reviewStatus": "author_checked_pending_independent_review"}, {"id": "course-zh4-a-q35", "blueprintSlotId": "C4-R-15", "number": 35, "section": "reading", "group": "R3", "theme": "environment", "cognitiveTarget": "integrate", "designDifficulty": "standard", "materialId": "C4A-R3c", "target": "对照方案与补充记录，判断哪项修改得到材料支持", "promptEn": "Which modification is supported by both texts?", "options": {"A": {"zh-Hans": "立即借到周六，不必再明确归还时间", "zh-Hant": "立即借到週六，不必再明確歸還時間"}, "B": {"zh-Hans": "把箱子永久放在通道，取消记录", "zh-Hant": "把箱子永久放在通道，取消記錄"}, "C": {"zh-Hans": "先完成周五试用，跨日借用另定回收清洗", "zh-Hant": "先完成周五試用，跨日借用另定回收清洗"}}, "correctAnswer": "C", "evidence": {"materialId": "C4A-R3c", "quote": {"zh-Hans": "活动后再决定是否给其他小组使用", "zh-Hant": "活動後再決定是否給其他小組使用"}, "additionalQuotes": [{"zh-Hans": "还没有清洗地点和收回时间", "zh-Hant": "還沒有清洗地點和收回時間"}]}, "explanation": {"en": "Expansion is conditional on solving arrangements missing from the Saturday request.", "zh": "甲要先记录后决定，乙指出跨日所缺安排，应另行落实。"}, "distractors": {"A": {"en": "Saturday still lacks washing and return arrangements.", "zh": "周六缺地点与时间，不能跳过。"}, "B": {"en": "The corridor restriction and both texts' record requirements contradict this.", "zh": "通道不能长期占，且两材料都要求记录。"}}, "languageTags": ["connected-discourse", "environment", "integrate"], "crossSourceIntegration": true, "reviewStatus": "author_checked_pending_independent_review"}, {"id": "course-zh4-a-q36", "blueprintSlotId": "C4-R-16", "number": 36, "section": "reading", "group": "R4", "theme": "environment", "cognitiveTarget": "direct", "designDifficulty": "foundation", "materialId": "C4A-R4a", "target": "定位环保公告中的实施范围和条件", "promptEn": "Which limit is explicitly stated?", "options": {"A": {"zh-Hans": "本周试用只限周五活动，不跨日借用", "zh-Hant": "本週試用只限週五活動，不跨日借用"}, "B": {"zh-Hans": "所有学生以后都不得带自用杯", "zh-Hant": "所有學生以後都不得帶自用杯"}, "C": {"zh-Hans": "一次记录已经代表全校长期效果", "zh-Hant": "一次記錄已經代表全校長期效果"}}, "correctAnswer": "A", "evidence": {"materialId": "C4A-R4a", "quote": {"zh-Hans": "本周只在周五读书交流会使用共用杯", "zh-Hant": "本週只在週五讀書交流會使用共用杯"}, "additionalQuotes": []}, "explanation": {"en": "The trial is limited to Friday with no weekend carryover.", "zh": "通知明确限定周五，不接受周末跨日借用。"}, "distractors": {"B": {"en": "Personal cups remain allowed and do not count as non-returns.", "zh": "自用杯允许且不算未归还。"}, "C": {"en": "The notice explicitly forbids generalizing one event to long-term whole-school effects.", "zh": "明确不能概括全校长期效果。"}}, "languageTags": ["connected-discourse", "environment", "direct"], "crossSourceIntegration": false, "reviewStatus": "author_checked_pending_independent_review"}, {"id": "course-zh4-a-q37", "blueprintSlotId": "C4-R-17", "number": 37, "section": "reading", "group": "R4", "theme": "technology", "cognitiveTarget": "integrate", "designDifficulty": "standard", "materialId": "C4A-R4b", "target": "整合技术说明与用户反馈，解释效果差异", "promptEn": "What explains why some attempts succeed while others do not?", "options": {"A": {"zh-Hans": "只要工具上线就不会读错任何标记", "zh-Hant": "只要工具上線就不會讀錯任何標記"}, "B": {"zh-Hans": "所有临时封闭区域都可由工具自动处理", "zh-Hant": "所有臨時封閉區域都可由工具自動處理"}, "C": {"zh-Hans": "标记条件和操作经验会影响识别使用", "zh-Hant": "標記條件和操作經驗會影響識別使用"}}, "correctAnswer": "C", "evidence": {"materialId": "C4A-R4b", "quote": {"zh-Hans": "识别需要标记清楚、光线足够", "zh-Hant": "識別需要標記清楚、光線足夠"}, "additionalQuotes": [{"zh-Hans": "另一位同学不熟悉拍摄操作", "zh-Hant": "另一位同學不熟悉拍攝操作"}]}, "explanation": {"en": "Stated operating conditions and user skill account for the differing observations.", "zh": "甲的识别条件与乙的操作反馈共同解释差异。"}, "distractors": {"A": {"en": "The conditions are limited and an actual misreading is reported.", "zh": "说明不保证所有条件，反馈确有读错。"}, "B": {"en": "Staff must still handle temporarily closed areas.", "zh": "甲明确不代替工作人员处理封闭。"}}, "languageTags": ["connected-discourse", "technology", "integrate"], "crossSourceIntegration": false, "reviewStatus": "author_checked_pending_independent_review"}, {"id": "course-zh4-a-q38", "blueprintSlotId": "C4-R-18", "number": 38, "section": "reading", "group": "R4", "theme": "technology", "cognitiveTarget": "infer", "designDifficulty": "stretch", "materialId": "C4A-R4b", "target": "对照技术说明与反馈，推断不能据此推广的主张", "promptEn": "Which claim cannot be justified from these two sources?", "options": {"A": {"zh-Hans": "反光标记可能需要改善后再测试", "zh-Hant": "反光標記可能需要改善後再測試"}, "B": {"zh-Hans": "部分人学习操作以后能够使用工具", "zh-Hant": "部分人學習操作以後能夠使用工具"}, "C": {"zh-Hans": "所有新生已经可以在全校完全独立通行", "zh-Hant": "所有新生已經可以在全校完全獨立通行"}}, "correctAnswer": "C", "evidence": {"materialId": "C4A-R4b", "quote": {"zh-Hans": "试用范围包括教学楼一层和二层", "zh-Hant": "試用範圍包括教學樓一層和二層"}, "additionalQuotes": [{"zh-Hans": "不能据此声称所有新生都可以完全独立地在全校通行", "zh-Hant": "不能據此聲稱所有新生都可以完全獨立地在全校通行"}]}, "explanation": {"en": "A limited trial cannot establish universal independence across the whole campus.", "zh": "范围和人数都有限，不能推出所有人全校独立通行。"}, "distractors": {"A": {"en": "The reflective-sign problem and improvement suggestion support further testing.", "zh": "乙的反光问题和改进建议支持继续试。"}, "B": {"en": "The feedback explicitly reports use becoming possible after instruction.", "zh": "乙明确有人学习后才可用。"}}, "languageTags": ["connected-discourse", "technology", "infer"], "crossSourceIntegration": true, "reviewStatus": "author_checked_pending_independent_review"}, {"id": "course-zh4-a-q39", "blueprintSlotId": "C4-R-19", "number": 39, "section": "reading", "group": "R4", "theme": "society", "cognitiveTarget": "integrate", "designDifficulty": "standard", "materialId": "C4A-R4c", "target": "综合社区协作案例中的不同需要与解决步骤", "promptEn": "How did the organizers address different needs?", "options": {"A": {"zh-Hans": "取消图卡且强迫每个人提交私人录音", "zh-Hant": "取消圖卡且強迫每個人提交私人錄音"}, "B": {"zh-Hans": "保留图卡，补充可选录音并标明讲述者", "zh-Hant": "保留圖卡，補充可選錄音並標明講述者"}, "C": {"zh-Hans": "由工作人员替全部家庭决定唯一观点", "zh-Hant": "由工作人員替全部家庭決定唯一觀點"}}, "correctAnswer": "B", "evidence": {"materialId": "C4A-R4c", "quote": {"zh-Hans": "保留图卡，同时增加可选的短录音", "zh-Hant": "保留圖卡，同時增加可選的短錄音"}, "additionalQuotes": [{"zh-Hans": "把每张卡的讲述者写清楚", "zh-Hant": "把每張卡的講述者寫清楚"}]}, "explanation": {"en": "The revision preserves comparability, optional personal explanation and attribution.", "zh": "图卡保留比较便利，可选录音和署名回应个体理由与归属。"}, "distractors": {"A": {"en": "Cards remain and recordings are optional.", "zh": "录音可选，图卡保留。"}, "C": {"en": "The narrators verify content; staff do not impose one view on every family.", "zh": "内容交本人核对，未替所有家庭定观点。"}}, "languageTags": ["connected-discourse", "society", "integrate"], "crossSourceIntegration": false, "reviewStatus": "author_checked_pending_independent_review"}, {"id": "course-zh4-a-q40", "blueprintSlotId": "C4-R-20", "number": 40, "section": "reading", "group": "R4", "theme": "heritage", "cognitiveTarget": "integrate", "designDifficulty": "standard", "materialId": "C4A-R4c", "target": "连接个体经历、群体交流和反思，概括有证据支持的认识", "promptEn": "Which conclusion best combines the experience and the reflection?", "options": {"A": {"zh-Hans": "只要统一格式就能概括所有地区的生活", "zh-Hant": "只要統一格式就能概括所有地區的生活"}, "B": {"zh-Hans": "格式帮助查找，理解文化还需联系具体人物理由", "zh-Hant": "格式幫助查找，理解文化還需聯繫具體人物理由"}, "C": {"zh-Hans": "凡是改变形式的做法都失去文化意义", "zh-Hant": "凡是改變形式的做法都失去文化意義"}}, "correctAnswer": "B", "evidence": {"materialId": "C4A-R4c", "quote": {"zh-Hans": "统一格式有助于寻找信息", "zh-Hant": "統一格式有助於尋找信息"}, "additionalQuotes": [{"zh-Hans": "认识文化还要听具体人物的理由", "zh-Hant": "認識文化還要聽具體人物的理由"}]}, "explanation": {"en": "The reflection qualifies the value of format and grounds interpretation in individual reasons.", "zh": "总结承认格式价值，同时要求理解具体人物理由并限制概括。"}, "distractors": {"A": {"en": "The ending explicitly rejects generalization from one story to every region.", "zh": "最后明确一个故事不足概括所有地区。"}, "C": {"en": "The reflection permits both continuity and change.", "zh": "总结允许延续也允许变化。"}}, "languageTags": ["connected-discourse", "heritage", "integrate"], "crossSourceIntegration": false, "reviewStatus": "author_checked_pending_independent_review"}], "tasks": [{"id": "W1", "section": "writing", "type": "audience-specific-message-reply", "title": "Reply to an exhibition disagreement", "promptEn": "Reply in Chinese to Mei. Answer whether you can join Friday lunchtime and whether you prefer printed cards or audio. Explain your choice, address the new restriction with a feasible adjustment, and ask a relevant confirmation. Invented details are fine. About 80–120 Chinese characters is guidance, not a minimum.", "requirements": ["Answer whether you can join Friday lunchtime.", "Choose a suitable format.", "State a clear position.", "Give an audience-related reason.", "Adjust for no loudspeaker and no corridor queue.", "Ask a relevant confirmation."], "reference": {"zh-Hans": "小美，周五午休我能来。我建议先用图卡，因为路过的人能自己阅读，不会打扰旁边的活动。想听故事的人可以用耳机分批听，不能让全班同时排队。我们先统计人数，再安排时间。请确认现场能不能使用自己的耳机；如果不行，就先只展示图卡。", "zh-Hant": "小美，週五午休我能來。我建議先用圖卡，因爲路過的人能自己閱讀，不會打擾旁邊的活動。想聽故事的人可以用耳機分批聽，不能讓全班同時排隊。我們先統計人數，再安排時間。請確認現場能不能使用自己的耳機；如果不行，就先只展示圖卡。"}, "enforcedMinimum": null, "suggestedHanzi": [80, 120], "sharedTimingGroup": "writing", "alternateReference": {"zh-Hans": "小美，我周五午休有排练，不能到场。我更想保留录音，因为能听到讲述者的语气。可以先展示图卡，再让预约的同学戴耳机分批听，避免走廊排队。我能周四帮忙检查设备。请确认每批能接待几个人，如果耳机不能用，我同意暂时只用图卡。", "zh-Hant": "小美，我週五午休有排練，不能到場。我更想保留錄音，因爲能聽到講述者的語氣。可以先展示圖卡，再讓預約的同學戴耳機分批聽，避免走廊排隊。我能週四幫忙檢查設備。請確認每批能接待幾個人，如果耳機不能用，我同意暫時只用圖卡。"}, "stimulus": {"zh-Hans": "小安：故事展周五午休要最后检查，你能来吗？你觉得用印好的图卡，还是让大家听录音更合适？现在场地说不能外放声音，也不能把队伍排到走廊。我们原来想让全班同时听的办法行不通了。请说说你的选择和调整办法，也告诉我还有什么需要确认。小美", "zh-Hant": "小安：故事展週五午休要最後檢查，你能來嗎？你覺得用印好的圖卡，還是讓大家聽錄音更合適？現在場地說不能外放聲音，也不能把隊伍排到走廊。我們原來想讓全班同時聽的辦法行不通了。請說說你的選擇和調整辦法，也告訴我還有什麼需要確認。小美"}, "rubric": {"maxPoints": 8, "automaticGrade": false, "missing": "unsubmitted", "technicalFailure": "needs_rerecording", "reviewerOptions": ["self", "own_teacher"], "teacherServiceIncluded": false, "taskObservations": ["Answer whether you can join Friday lunchtime.", "Choose a suitable format.", "State a clear position.", "Give an audience-related reason.", "Adjust for no loudspeaker and no corridor queue.", "Ask a relevant confirmation."], "dimensions": [{"id": "completion", "name": "任务完成", "levels": {"0": "已提交内容没有提供与本任务要求相关的可评证据。", "1": "回应部分要求，但遗漏关键观察点或与给定条件冲突。", "2": "完成主要要求：Answer whether you can join Friday lunchtime.；Choose a suitable format.；State a clear position.；Give an audience-related reason.；Adjust for no loudspeaker and no corridor queue.；Ask a relevant confirmation."}}, {"id": "comprehensibility", "name": "可理解性", "levels": {"0": "主要意思无法恢复。", "1": "部分意思可理解，但数处关系或错误使读者／听者需要猜测。", "2": "主要意思清楚，证据、时间和人物可辨；允许不妨碍理解的错误和口音。"}}, {"id": "language", "name": "语言运用", "levels": {"0": "缺少能表达相关意思的中文词句。", "1": "词句能传达部分信息，但原因、条件或变化关系不清。", "2": "用中文准确表达观点归属、理由和适用条件；可用简单句连接，不要求指定句式或母语口音。"}}, {"id": "organization", "name": "组织或回应相关性", "levels": {"0": "缺少相关回应或可辨的内容联系。", "1": "部分相关但顺序、衔接或比较依据不够清楚。", "2": "回应与材料及受众相关，比较、证据、限制和行动有清楚联系。"}}], "notes": "Suggested length is guidance, not a score threshold. No prescribed grammar or native-like accent is required. Missing/technical failure is not an automatic zero; S1 is one /8 task across four responses."}, "reviewNotes": ["Different positions can receive full credit when supported and feasible.", "Evidence must be attributed accurately; copying source sentences alone does not complete the task.", "Missing or technically failed work remains a status, not an automatic zero."]}, {"id": "W2", "section": "writing", "type": "bounded-two-source-position-and-recommendation", "title": "Recommend an information display", "promptEn": "Write Chinese paragraphs for the student committee. Use at least one accurately attributed detail from EACH supplied source. Compare a benefit and a limitation, give your own conditional recommendation, and propose a practical next step. No outside research is needed. About 180–240 Chinese characters is guidance.", "requirements": ["Define the information-access problem.", "Use and accurately attribute one detail from each source.", "Compare a benefit and a limitation.", "Give a conditional recommendation.", "Propose a feasible next step.", "Organize connected paragraphs rather than copying."], "reference": {"zh-Hans": "我建议先用图卡公布稳定的信息，同时小范围试用电子页面。材料甲说，不用手机也能查看，制作费四十元，在五十元预算内，适合没有设备的访客。不过图卡改动后要重印，周一和周四以外还需要有人补充说明。材料乙的优点是能及时修改，也不用印刷费，但没有手机的人不方便，两位维护者缺席时也可能没人更新。因此，电子页面暂时不能成为唯一入口。委员会可以先确认图卡与页面显示相同的更新时间，再安排一位替补维护者，试用两周后收集不同访客的反馈。只有把缺席接替和无设备访问都解决，才考虑扩大电子页面的使用。", "zh-Hant": "我建議先用圖卡公佈穩定的信息，同時小範圍試用電子頁面。材料甲說，不用手機也能查看，製作費四十元，在五十元預算內，適合沒有設備的訪客。不過圖卡改動後要重印，週一和週四以外還需要有人補充說明。材料乙的優點是能及時修改，也不用印刷費，但沒有手機的人不方便，兩位維護者缺席時也可能沒人更新。因此，電子頁面暫時不能成爲唯一入口。委員會可以先確認圖卡與頁面顯示相同的更新時間，再安排一位替補維護者，試用兩週後收集不同訪客的反饋。只有把缺席接替和無設備訪問都解決，才考慮擴大電子頁面的使用。"}, "enforcedMinimum": null, "suggestedHanzi": [180, 240], "sharedTimingGroup": "writing", "stimulus": {"zh-Hans": "材料甲，图卡方案：把常用活动信息印在公告板旁，读者不用手机就能查看，初次制作费用四十元。若时间地点改变，需要重新印相应图卡。负责同学周一和周四可以检查更新，其他日子只能临时贴手写说明。\n材料乙，电子页面方案：把信息集中在一个页面，可及时修改，不花印刷费。读者需要能上网的设备；校内有些访客没有手机。两位同学愿意维护页面，但还没有安排缺席时谁接替。委员会希望不同使用者都能找到可靠信息，现有预算五十元。", "zh-Hant": "材料甲，圖卡方案：把常用活動信息印在公告板旁，讀者不用手機就能查看，初次製作費用四十元。若時間地點改變，需要重新印相應圖卡。負責同學週一和週四可以檢查更新，其他日子只能臨時貼手寫說明。\n材料乙，電子頁面方案：把信息集中在一個頁面，可及時修改，不花印刷費。讀者需要能上網的設備；校內有些訪客沒有手機。兩位同學願意維護頁面，但還沒有安排缺席時誰接替。委員會希望不同使用者都能找到可靠信息，現有預算五十元。"}, "rubric": {"maxPoints": 8, "automaticGrade": false, "missing": "unsubmitted", "technicalFailure": "needs_rerecording", "reviewerOptions": ["self", "own_teacher"], "teacherServiceIncluded": false, "taskObservations": ["Define the information-access problem.", "Use and accurately attribute one detail from each source.", "Compare a benefit and a limitation.", "Give a conditional recommendation.", "Propose a feasible next step.", "Organize connected paragraphs rather than copying."], "dimensions": [{"id": "completion", "name": "任务完成", "levels": {"0": "已提交内容没有提供与本任务要求相关的可评证据。", "1": "回应部分要求，但遗漏关键观察点或与给定条件冲突。", "2": "完成主要要求：Define the information-access problem.；Use and accurately attribute one detail from each source.；Compare a benefit and a limitation.；Give a conditional recommendation.；Propose a feasible next step.；Organize connected paragraphs rather than copying."}}, {"id": "comprehensibility", "name": "可理解性", "levels": {"0": "主要意思无法恢复。", "1": "部分意思可理解，但数处关系或错误使读者／听者需要猜测。", "2": "主要意思清楚，证据、时间和人物可辨；允许不妨碍理解的错误和口音。"}}, {"id": "language", "name": "语言运用", "levels": {"0": "缺少能表达相关意思的中文词句。", "1": "词句能传达部分信息，但原因、条件或变化关系不清。", "2": "用中文准确表达观点归属、理由和适用条件；可用简单句连接，不要求指定句式或母语口音。"}}, {"id": "organization", "name": "组织或回应相关性", "levels": {"0": "缺少相关回应或可辨的内容联系。", "1": "部分相关但顺序、衔接或比较依据不够清楚。", "2": "回应与材料及受众相关，比较、证据、限制和行动有清楚联系。"}}], "notes": "Suggested length is guidance, not a score threshold. No prescribed grammar or native-like accent is required. Missing/technical failure is not an automatic zero; S1 is one /8 task across four responses."}, "reviewNotes": ["Different positions can receive full credit when supported and feasible.", "Evidence must be attributed accurately; copying source sentences alone does not complete the task.", "Missing or technically failed work remains a status, not an automatic zero."]}, {"id": "S1", "section": "speaking", "type": "fixed-simulated-exchange", "title": "Negotiate a bilingual activity", "promptEn": "Respond to four fixed prompts about a bilingual school activity. Each audio file already contains two plays; play it once, prepare 15 seconds and respond up to 30 seconds. Explain needs, compare choices, respond to an objection and confirm a conditional next step. All four responses form ONE /8 task; prompts are not adaptive.", "requirements": ["State a position linked to the partner’s needs.", "Compare two choices with reasons.", "Respond to a new restriction and revise a plan.", "Explain a compromise and confirm the next step."], "reference": {"zh-Hans": "以下答法为示例，可作其他有依据且前后连贯的选择。", "zh-Hant": "以下答法爲示例，可作其他有依據且前後連貫的選擇。"}, "enforcedMinimum": null, "scenarioEn": "You are planning a bilingual story-sharing activity with a classmate. All personal details can be invented.", "playsPerPrompt": 2, "promptFileContainsPlays": 2, "promptFilePlaybackRepeats": 1, "preparationSecondsPerPrompt": 15, "responseSecondsPerPrompt": 30, "rubricScope": "all_four_responses_together", "exchanges": [{"id": "S1-1", "speaker": "female", "prompt": {"zh-Hans": "活动要让不同语言的同学都能参加。你最想先照顾谁的需要？为什么？", "zh-Hant": "活動要讓不同語言的同學都能參加。你最想先照顧誰的需要？爲什麼？"}, "reference": {"zh-Hans": "我想先照顾刚来学校、中文还不熟悉的同学。可以把关键词并排写出两种文字，让他们先知道故事在讲什么。", "zh-Hant": "我想先照顧剛來學校、中文還不熟悉的同學。可以把關鍵詞並排寫出兩種文字，讓他們先知道故事在講什麼。"}}, {"id": "S1-2", "speaker": "female", "prompt": {"zh-Hans": "有人提议只讲一种语言，有人希望两种语言并用。你怎样比较这两个办法？", "zh-Hant": "有人提議只講一種語言，有人希望兩種語言並用。你怎樣比較這兩個辦法？"}, "reference": {"zh-Hans": "一种语言安排简单，但有些人会听不懂。两种并用需要准备，不过可以让更多人参与。我建议先用短说明，不把每一句都翻译一遍。", "zh-Hant": "一種語言安排簡單，但有些人會聽不懂。兩種並用需要準備，不過可以讓更多人蔘與。我建議先用短說明，不把每一句都翻譯一遍。"}}, {"id": "S1-3", "speaker": "female", "prompt": {"zh-Hans": "现在有人担心翻译会改变故事意思，而且时间只有十分钟。你会怎样调整？", "zh-Hant": "現在有人擔心翻譯會改變故事意思，而且時間只有十分鐘。你會怎樣調整？"}, "reference": {"zh-Hans": "我们可以只选一个短故事，请讲述者先检查关键词。十分钟里保留原声，再用简短说明补充，不安排完整的逐句翻译。", "zh-Hant": "我們可以只選一個短故事，請講述者先檢查關鍵詞。十分鐘裏保留原聲，再用簡短說明補充，不安排完整的逐句翻譯。"}}, {"id": "S1-4", "speaker": "female", "prompt": {"zh-Hans": "如果讲述者仍不同意翻译，你能接受什么妥协？下一步要先确认什么？", "zh-Hant": "如果講述者仍不同意翻譯，你能接受什麼妥協？下一步要先確認什麼？"}, "reference": {"zh-Hans": "我可以接受先保留原声，只展示本人同意的背景说明。下一步先问清楚哪些内容可以公开；没确认前，不用别人替他作决定。", "zh-Hant": "我可以接受先保留原聲，只展示本人同意的背景說明。下一步先問清楚哪些內容可以公開；沒確認前，不用別人替他作決定。"}}], "rubric": {"maxPoints": 8, "automaticGrade": false, "missing": "unsubmitted", "technicalFailure": "needs_rerecording", "reviewerOptions": ["self", "own_teacher"], "teacherServiceIncluded": false, "taskObservations": ["State a position linked to the partner’s needs.", "Compare two choices with reasons.", "Respond to a new restriction and revise a plan.", "Explain a compromise and confirm the next step."], "dimensions": [{"id": "completion", "name": "任务完成", "levels": {"0": "已提交内容没有提供与本任务要求相关的可评证据。", "1": "回应部分要求，但遗漏关键观察点或与给定条件冲突。", "2": "完成主要要求：State a position linked to the partner’s needs.；Compare two choices with reasons.；Respond to a new restriction and revise a plan.；Explain a compromise and confirm the next step."}}, {"id": "comprehensibility", "name": "可理解性", "levels": {"0": "主要意思无法恢复。", "1": "部分意思可理解，但数处关系或错误使读者／听者需要猜测。", "2": "主要意思清楚，证据、时间和人物可辨；允许不妨碍理解的错误和口音。"}}, {"id": "language", "name": "语言运用", "levels": {"0": "缺少能表达相关意思的中文词句。", "1": "词句能传达部分信息，但原因、条件或变化关系不清。", "2": "用中文准确表达观点归属、理由和适用条件；可用简单句连接，不要求指定句式或母语口音。"}}, {"id": "organization", "name": "组织或回应相关性", "levels": {"0": "缺少相关回应或可辨的内容联系。", "1": "部分相关但顺序、衔接或比较依据不够清楚。", "2": "回应与材料及受众相关，比较、证据、限制和行动有清楚联系。"}}], "notes": "Suggested length is guidance, not a score threshold. No prescribed grammar or native-like accent is required. Missing/technical failure is not an automatic zero; S1 is one /8 task across four responses."}, "reviewNotes": ["Different positions can receive full credit when supported and feasible.", "Evidence must be attributed accurately; copying source sentences alone does not complete the task.", "Missing or technically failed work remains a status, not an automatic zero."]}, {"id": "S2", "section": "speaking", "type": "compare-qualify-recommend", "title": "Choose a community information service", "promptEn": "Recommend a plan to the community center. Compare BOTH options, use at least two card details covering both, explain one trade-off and the conditions for your recommendation, and give a feasible next step. Either plan may earn full credit. Prepare 60 seconds; speak up to 120 seconds.", "requirements": ["Compare both plans accurately.", "Use at least two details covering both options.", "Explain one trade-off and a condition.", "Give an audience-appropriate next step."], "reference": {"zh-Hans": "我建议先用乙的信息卡作主要入口。社区有四十位新访客，甲要一对一排队，下午两点以后还少一位志愿者；乙可以让多人同时阅读，也不用手机，八十元在预算内。这对不会用手机或中文不熟的访客比较方便。不过乙不能回答追问，而且信息变动后要重印，所以不能把它看成完全不需要维护的办法。中心可以先登记常见问题，把最重要的回答印清楚，并在印刷前确认时间地点。如果本次变动很多、问题难以预先整理，我会改为甲，并提前提醒大家两点后的等候可能更长。", "zh-Hant": "我建議先用乙的信息卡作主要入口。社區有四十位新訪客，甲要一對一排隊，下午兩點以後還少一位志願者；乙可以讓多人同時閱讀，也不用手機，八十元在預算內。這對不會用手機或中文不熟的訪客比較方便。不過乙不能回答追問，而且信息變動後要重印，所以不能把它看成完全不需要維護的辦法。中心可以先登記常見問題，把最重要的回答印清楚，並在印刷前確認時間地點。如果本次變動很多、問題難以預先整理，我會改爲甲，並提前提醒大家兩點後的等候可能更長。"}, "enforcedMinimum": null, "preparationSeconds": 60, "responseSeconds": 120, "alternateReference": {"zh-Hans": "我选择甲，前提是提前登记问题和到访时间，尽量把需要详细解释的人安排在两点前。乙能同时接待多人，但不能回答追问。甲的两位双语志愿者可以帮助不同语言的访客，不过人数少，会有队伍。中心应先说明等候安排，不能承诺四十个人都立刻得到接待。", "zh-Hant": "我選擇甲，前提是提前登記問題和到訪時間，儘量把需要詳細解釋的人安排在兩點前。乙能同時接待多人，但不能回答追問。甲的兩位雙語志願者可以幫助不同語言的訪客，不過人數少，會有隊伍。中心應先說明等候安排，不能承諾四十個人都立刻得到接待。"}, "stimulus": {"zh-Hans": "社区需求：本周六向四十位新访客介绍活动，部分访客不熟悉中文，也有人不用手机；预算一百元。\n甲，咨询桌：两位双语志愿者轮流接待，免费；每次一对一，需要排队；下午两点后一位志愿者离开。\n乙，自助信息卡：印刷八十元，有两种文字，可多人同时阅读；临时变动需要重新印；没有人专门回答追问。\n中心可提前登记常见问题，但本次不能增加工作人员。", "zh-Hant": "社區需求：本週六向四十位新訪客介紹活動，部分訪客不熟悉中文，也有人不用手機；預算一百元。\n甲，諮詢桌：兩位雙語志願者輪流接待，免費；每次一對一，需要排隊；下午兩點後一位志願者離開。\n乙，自助信息卡：印刷八十元，有兩種文字，可多人同時閱讀；臨時變動需要重新印；沒有人專門回答追問。\n中心可提前登記常見問題，但本次不能增加工作人員。"}, "rubric": {"maxPoints": 8, "automaticGrade": false, "missing": "unsubmitted", "technicalFailure": "needs_rerecording", "reviewerOptions": ["self", "own_teacher"], "teacherServiceIncluded": false, "taskObservations": ["Compare both plans accurately.", "Use at least two details covering both options.", "Explain one trade-off and a condition.", "Give an audience-appropriate next step."], "dimensions": [{"id": "completion", "name": "任务完成", "levels": {"0": "已提交内容没有提供与本任务要求相关的可评证据。", "1": "回应部分要求，但遗漏关键观察点或与给定条件冲突。", "2": "完成主要要求：Compare both plans accurately.；Use at least two details covering both options.；Explain one trade-off and a condition.；Give an audience-appropriate next step."}}, {"id": "comprehensibility", "name": "可理解性", "levels": {"0": "主要意思无法恢复。", "1": "部分意思可理解，但数处关系或错误使读者／听者需要猜测。", "2": "主要意思清楚，证据、时间和人物可辨；允许不妨碍理解的错误和口音。"}}, {"id": "language", "name": "语言运用", "levels": {"0": "缺少能表达相关意思的中文词句。", "1": "词句能传达部分信息，但原因、条件或变化关系不清。", "2": "用中文准确表达观点归属、理由和适用条件；可用简单句连接，不要求指定句式或母语口音。"}}, {"id": "organization", "name": "组织或回应相关性", "levels": {"0": "缺少相关回应或可辨的内容联系。", "1": "部分相关但顺序、衔接或比较依据不够清楚。", "2": "回应与材料及受众相关，比较、证据、限制和行动有清楚联系。"}}], "notes": "Suggested length is guidance, not a score threshold. No prescribed grammar or native-like accent is required. Missing/technical failure is not an automatic zero; S1 is one /8 task across four responses."}, "reviewNotes": ["Different positions can receive full credit when supported and feasible.", "Evidence must be attributed accurately; copying source sentences alone does not complete the task.", "Missing or technically failed work remains a status, not an automatic zero."]}], "instructions": {"en": "Choose one of A/B/C for each objective item. Each listening group has 1+2+2 questions across three sources, each played twice in the timed track. Writing tasks share 30 minutes. This content-review pack has no exam clock, answer saving or recording engine. Use your own recorder; self/own-teacher review only.", "zh": "听读每题三选一。每组听力三份材料，题量一加二加二；整轨每份材料两遍。写作共用30分钟。此内容审阅包不实现考试计时、作答保存或录音引擎；请用自己的录音工具，口写自评或交自己的教师。"}, "vocabularySupport": [{"term": {"zh-Hans": "标题", "zh-Hant": "標題"}, "meaningEn": "title"}, {"term": {"zh-Hans": "保留", "zh-Hant": "保留"}, "meaningEn": "retain"}, {"term": {"zh-Hans": "背景", "zh-Hant": "背景"}, "meaningEn": "background"}, {"term": {"zh-Hans": "规定", "zh-Hant": "規定"}, "meaningEn": "rule"}, {"term": {"zh-Hans": "值班", "zh-Hant": "值班"}, "meaningEn": "be on duty"}, {"term": {"zh-Hans": "成品", "zh-Hant": "成品"}, "meaningEn": "finished work"}, {"term": {"zh-Hans": "设备测试", "zh-Hant": "設備測試"}, "meaningEn": "device check"}, {"term": {"zh-Hans": "并排", "zh-Hant": "並排"}, "meaningEn": "side by side"}, {"term": {"zh-Hans": "译文", "zh-Hant": "譯文"}, "meaningEn": "translation"}, {"term": {"zh-Hans": "预约", "zh-Hant": "預約"}, "meaningEn": "reserve"}, {"term": {"zh-Hans": "试行", "zh-Hant": "試行"}, "meaningEn": "trial implementation"}, {"term": {"zh-Hans": "导演", "zh-Hant": "導演"}, "meaningEn": "director"}, {"term": {"zh-Hans": "放映", "zh-Hant": "放映"}, "meaningEn": "screening"}, {"term": {"zh-Hans": "旁白", "zh-Hant": "旁白"}, "meaningEn": "voice-over"}, {"term": {"zh-Hans": "停顿", "zh-Hant": "停頓"}, "meaningEn": "pause"}, {"term": {"zh-Hans": "归还", "zh-Hant": "歸還"}, "meaningEn": "return borrowed items"}, {"term": {"zh-Hans": "储存架", "zh-Hant": "儲存架"}, "meaningEn": "storage rack"}, {"term": {"zh-Hans": "破损", "zh-Hant": "破損"}, "meaningEn": "damaged"}, {"term": {"zh-Hans": "识别", "zh-Hant": "識別"}, "meaningEn": "recognize"}, {"term": {"zh-Hans": "导览", "zh-Hant": "導覽"}, "meaningEn": "navigation guide"}, {"term": {"zh-Hans": "勾选", "zh-Hant": "勾選"}, "meaningEn": "tick an option"}, {"term": {"zh-Hans": "个体", "zh-Hant": "個體"}, "meaningEn": "individual"}, {"term": {"zh-Hans": "展签", "zh-Hant": "展籤"}, "meaningEn": "exhibit label"}, {"term": {"zh-Hans": "并列", "zh-Hant": "並列"}, "meaningEn": "display alongside"}, {"term": {"zh-Hans": "模拟图", "zh-Hant": "模擬圖"}, "meaningEn": "illustrative mock-up"}, {"term": {"zh-Hans": "代表", "zh-Hant": "代表"}, "meaningEn": "representative"}, {"term": {"zh-Hans": "排练", "zh-Hant": "排練"}, "meaningEn": "rehearsal"}, {"term": {"zh-Hans": "主持人", "zh-Hant": "主持人"}, "meaningEn": "host"}, {"term": {"zh-Hans": "澄清", "zh-Hant": "澄清"}, "meaningEn": "clarify"}, {"term": {"zh-Hans": "版本", "zh-Hant": "版本"}, "meaningEn": "version"}, {"term": {"zh-Hans": "初稿", "zh-Hant": "初稿"}, "meaningEn": "first draft"}, {"term": {"zh-Hans": "超时", "zh-Hant": "超時"}, "meaningEn": "exceed the time limit"}, {"term": {"zh-Hans": "意见栏", "zh-Hant": "意見欄"}, "meaningEn": "feedback section"}, {"term": {"zh-Hans": "术语", "zh-Hant": "術語"}, "meaningEn": "technical terminology"}, {"term": {"zh-Hans": "创作者", "zh-Hant": "創作者"}, "meaningEn": "creator"}, {"term": {"zh-Hans": "指责", "zh-Hant": "指責"}, "meaningEn": "blame"}, {"term": {"zh-Hans": "短评", "zh-Hant": "短評"}, "meaningEn": "short commentary"}, {"term": {"zh-Hans": "跨日", "zh-Hant": "跨日"}, "meaningEn": "across different days"}, {"term": {"zh-Hans": "通道", "zh-Hant": "通道"}, "meaningEn": "passageway"}, {"term": {"zh-Hans": "评估", "zh-Hant": "評估"}, "meaningEn": "evaluate"}, {"term": {"zh-Hans": "反光", "zh-Hant": "反光"}, "meaningEn": "reflective glare"}, {"term": {"zh-Hans": "封闭", "zh-Hant": "封閉"}, "meaningEn": "closed off"}, {"term": {"zh-Hans": "持相同看法", "zh-Hant": "持相同看法"}, "meaningEn": "share the same view"}, {"term": {"zh-Hans": "格式", "zh-Hant": "格式"}, "meaningEn": "format"}], "supportPolicy": "Preparation support is separate from timed materials. Material glosses are visible in both scripts; no pinyin by default. Item-level lexical suitability remains subject to teacher review.", "nextAcceptance": ["Actual audio production and timeline validation", "ASR screening with retained differences", "Human listening acceptance", "Independent teacher review and learner pilot", "Separate product integration and release"]}</script><script id="audio-data" type="application/json">{"paperId": "course-chinese-4-a-v1", "provider": "Edge TTS at authoring time; no runtime TTS or Cloudflare generation", "rate": "-8%", "voices": {"female": "zh-CN-XiaoxiaoNeural", "male": "zh-CN-YunxiNeural"}, "humanListeningAcceptance": false, "units": [{"id": "C4A-L1a", "kind": "listening-source", "questionNumbers": [1], "sourcePlays": 1, "script": [{"speaker": "female", "text": {"zh-Hans": "社区故事展原来只用中文写标题。今年有同学建议全部换成英文，让更多邻居看懂。我认为可以保留中文，再加一句英文说明。这样不认识汉字的人也能了解内容，熟悉中文的老人仍然能看到原来的名字。两种文字不是只能选一种。我们还会请讲故事的人检查说明，免得意思变了。", "zh-Hant": "社區故事展原來只用中文寫標題。今年有同學建議全部換成英文，讓更多鄰居看懂。我認爲可以保留中文，再加一句英文說明。這樣不認識漢字的人也能瞭解內容，熟悉中文的老人仍然能看到原來的名字。兩種文字不是隻能選一種。我們還會請講故事的人檢查說明，免得意思變了。"}}], "sourceDurationSeconds": 29.256, "targetSeconds": [24, 32], "withinTarget": true, "src": "assets/audio/c4a-l1a.mp3", "durationSeconds": 29.808, "pcmSeconds": 29.756, "bytes": 238700, "sha256": "fb3034eea6da43efd2a04a38e03d66b0e7882a89a3b3a45ad74d92a0404d832b"}, {"id": "C4A-L1b", "kind": "listening-source", "questionNumbers": [2, 3], "sourcePlays": 1, "script": [{"speaker": "male", "text": {"zh-Hans": "我以前介绍家里的故事，总是先说我们家的人每年都这样做。后来妹妹提醒我，她在外地读书以后就换了做法，不能把我的经验说成全家的规定。", "zh-Hant": "我以前介紹家裏的故事，總是先說我們家的人每年都這樣做。後來妹妹提醒我，她在外地讀書以後就換了做法，不能把我的經驗說成全家的規定。"}}, {"speaker": "female", "text": {"zh-Hans": "那你在故事展里怎么介绍呢？", "zh-Hant": "那你在故事展裏怎麼介紹呢？"}}, {"speaker": "male", "text": {"zh-Hans": "我先说明这是我小时候和爷爷一起准备晚饭的经历，再请妹妹补充她现在的办法。原来的菜名仍然保留，做菜步骤却可以不同。我们想让观众听出两个人的生活背景，而不是判断谁的做法才算正确。妹妹也同意把两段录音放在一起。展签会写清楚是谁在讲，也请观众先听完，再提出自己的问题。", "zh-Hant": "我先說明這是我小時候和爺爺一起準備晚飯的經歷，再請妹妹補充她現在的辦法。原來的菜名仍然保留，做菜步驟卻可以不同。我們想讓觀衆聽出兩個人的生活背景，而不是判斷誰的做法纔算正確。妹妹也同意把兩段錄音放在一起。展籤會寫清楚是誰在講，也請觀衆先聽完，再提出自己的問題。"}}], "sourceDurationSeconds": 47.764, "targetSeconds": [45, 60], "withinTarget": true, "src": "assets/audio/c4a-l1b.mp3", "durationSeconds": 48.312, "pcmSeconds": 48.264, "bytes": 386732, "sha256": "a68047765cb37ee3680af77d39dbf83f3a89404226dfac7b3e52bc82c39683bb"}, {"id": "C4A-L1c", "kind": "listening-source", "questionNumbers": [4, 5], "sourcePlays": 1, "script": [{"speaker": "female", "text": {"zh-Hans": "留言甲。我邀请伙伴来故事展时说，周五先随便聊聊，不用准备正式发言。我想让第一次见面的同学轻松一些。标题翻译等大家熟悉后再一起商量，不需要他们先交成品。", "zh-Hant": "留言甲。我邀請夥伴來故事展時說，週五先隨便聊聊，不用準備正式發言。我想讓第一次見面的同學輕鬆一些。標題翻譯等大家熟悉後再一起商量，不需要他們先交成品。"}}, {"speaker": "male", "text": {"zh-Hans": "留言乙。我以为随便聊聊就是可以不参加，所以答应那天替朋友值班。我并不是不愿意合作。我现在才知道，那次见面是让双方认识、分配后面的工作。我可以换班，但想先确认见面的目的和结束时间，再答复。我希望以后邀请时把参加要求写清楚，不只是说气氛轻松，以免其他人也理解错。", "zh-Hant": "留言乙。我以爲隨便聊聊就是可以不參加，所以答應那天替朋友值班。我並不是不願意合作。我現在才知道，那次見面是讓雙方認識、分配後面的工作。我可以換班，但想先確認見面的目的和結束時間，再答覆。我希望以後邀請時把參加要求寫清楚，不只是說氣氛輕鬆，以免其他人也理解錯。"}}], "sourceDurationSeconds": 46.454, "targetSeconds": [45, 60], "withinTarget": true, "src": "assets/audio/c4a-l1c.mp3", "durationSeconds": 47.016, "pcmSeconds": 46.954, "bytes": 376364, "sha256": "9e80fb1b39356d1363027e30207b474fb6a49388c76b47cdaf9183d7ba218365"}, {"id": "C4A-L2a", "kind": "listening-source", "questionNumbers": [6], "sourcePlays": 1, "script": [{"speaker": "male", "text": {"zh-Hans": "这次线上交流已经确定在周四放学后进行，参加者要先看完对方发来的三张展览照片。老师会把不认识的词放在照片旁边。大家不用写完整报告，但每个人都要准备一个与照片有关的问题。交流时可以请对方解释，不必假装已经了解所有背景。设备测试另安排在周三午休。", "zh-Hant": "這次線上交流已經確定在週四放學後進行，參加者要先看完對方發來的三張展覽照片。老師會把不認識的詞放在照片旁邊。大家不用寫完整報告，但每個人都要準備一個與照片有關的問題。交流時可以請對方解釋，不必假裝已經瞭解所有背景。設備測試另安排在週三午休。"}}], "sourceDurationSeconds": 26.712, "targetSeconds": [24, 32], "withinTarget": true, "src": "assets/audio/c4a-l2a.mp3", "durationSeconds": 27.264, "pcmSeconds": 27.212, "bytes": 218348, "sha256": "bd76f8cc6f6701598a739054cb9f1156c7f3cd43de7af56c0a574b1c24a689d9"}, {"id": "C4A-L2b", "kind": "listening-source", "questionNumbers": [7, 8], "sourcePlays": 1, "script": [{"speaker": "female", "text": {"zh-Hans": "反馈甲。我用翻译工具给展品写英文简介，第一稿出来得很快。但是人物称呼有时不对。我希望先看到中文原稿和英文并排的结果，这样能请讲故事的人一起检查，再决定是否使用。", "zh-Hant": "反饋甲。我用翻譯工具給展品寫英文簡介，第一稿出來得很快。但是人物稱呼有時不對。我希望先看到中文原稿和英文並排的結果，這樣能請講故事的人一起檢查，再決定是否使用。"}}, {"speaker": "male", "text": {"zh-Hans": "反馈乙。我负责接待，不会把工具的结果直接印出来。工具省下了查普通词的时间，可是有些地方的名字译得不一致。我也想保留两种文字，还要给改过的地方作标记。现在有人建议把所有译文自动发布，我觉得还需要人工确认。确认过的内容才能给访客看，修改以后也要留下日期，避免误用旧稿。", "zh-Hant": "反饋乙。我負責接待，不會把工具的結果直接印出來。工具省下了查普通詞的時間，可是有些地方的名字譯得不一致。我也想保留兩種文字，還要給改過的地方作標記。現在有人建議把所有譯文自動發佈，我覺得還需要人工確認。確認過的內容才能給訪客看，修改以後也要留下日期，避免誤用舊稿。"}}], "sourceDurationSeconds": 48.974, "targetSeconds": [45, 60], "withinTarget": true, "src": "assets/audio/c4a-l2b.mp3", "durationSeconds": 49.536, "pcmSeconds": 49.474, "bytes": 396524, "sha256": "9bcc2e616dfd24019262741fe0b79e1882d6264180a30da6eaba734774422b86"}, {"id": "C4A-L2c", "kind": "listening-source", "questionNumbers": [9, 10], "sourcePlays": 1, "script": [{"speaker": "female", "text": {"zh-Hans": "图书馆下周开始试行新规则。靠窗的区域保持安静，讨论小组可以预约门口的房间，每次三十分钟。有人担心临时来的人没有位置，所以我们先把周三中午留作不用预约的时段。", "zh-Hant": "圖書館下週開始試行新規則。靠窗的區域保持安靜，討論小組可以預約門口的房間，每次三十分鐘。有人擔心臨時來的人沒有位置，所以我們先把週三中午留作不用預約的時段。"}}, {"speaker": "male", "text": {"zh-Hans": "那我接受先试两周。不过不用预约也不该表示可以一直占着房间。我们要写清楚，每组仍然最多用三十分钟，两周后再看等候记录。", "zh-Hant": "那我接受先試兩週。不過不用預約也不該表示可以一直佔着房間。我們要寫清楚，每組仍然最多用三十分鐘，兩週後再看等候記錄。"}}, {"speaker": "female", "text": {"zh-Hans": "同意。这样能听到临时使用者的意见，也不取消原来需要安静的人可以使用的区域。通知里会分别写出两种空间的用途，让第一次来的同学也容易理解。", "zh-Hant": "同意。這樣能聽到臨時使用者的意見，也不取消原來需要安靜的人可以使用的區域。通知裏會分別寫出兩種空間的用途，讓第一次來的同學也容易理解。"}}], "sourceDurationSeconds": 48.34, "targetSeconds": [45, 60], "withinTarget": true, "src": "assets/audio/c4a-l2c.mp3", "durationSeconds": 48.888, "pcmSeconds": 48.84, "bytes": 391340, "sha256": "4b4a1910dde1bf1b4a42f8e53e3b4f6f1b3847a4834032251aeaec381366e3af"}, {"id": "C4A-L3a", "kind": "listening-source", "questionNumbers": [11], "sourcePlays": 1, "script": [{"speaker": "female", "text": {"zh-Hans": "这部校园短片不是教大家怎样整理旧照片。导演拍的是两位同学看同一张照片时不同的反应。画面里没有解释谁记错了，而是让两个人分别讲述当时的感受。放映后，观众可以说自己注意到的细节，再看看这些细节怎样影响理解。我们希望大家学会听见不同的声音，不是背出标准感想。", "zh-Hant": "這部校園短片不是教大家怎樣整理舊照片。導演拍的是兩位同學看同一張照片時不同的反應。畫面裏沒有解釋誰記錯了，而是讓兩個人分別講述當時的感受。放映後，觀衆可以說自己注意到的細節，再看看這些細節怎樣影響理解。我們希望大家學會聽見不同的聲音，不是背出標準感想。"}}], "sourceDurationSeconds": 30.144, "targetSeconds": [24, 32], "withinTarget": true, "src": "assets/audio/c4a-l3a.mp3", "durationSeconds": 30.696, "pcmSeconds": 30.644, "bytes": 245804, "sha256": "ae0a62c675350ca0cc481c9c3fb7b62495d0a34ec092964c6df6de1b912d6352"}, {"id": "C4A-L3b", "kind": "listening-source", "questionNumbers": [12, 13], "sourcePlays": 1, "script": [{"speaker": "male", "text": {"zh-Hans": "短片里，小河站在门外很久才进去。我们剪第一版时，有人觉得这段停顿没用，应该删掉。我却想留下，因为前面他刚说过，怕进去以后不知道怎样开口。", "zh-Hant": "短片裏，小河站在門外很久才進去。我們剪第一版時，有人覺得這段停頓沒用，應該刪掉。我卻想留下，因爲前面他剛說過，怕進去以後不知道怎樣開口。"}}, {"speaker": "female", "text": {"zh-Hans": "留下以后，观众明白你的意思了吗？", "zh-Hant": "留下以後，觀衆明白你的意思了嗎？"}}, {"speaker": "male", "text": {"zh-Hans": "有的人说看出了他的紧张，也有人觉得他只是等朋友。我们后来加了他伸手又收回的一个动作，没有加旁白直接解释。我愿意让观众有不同理解，但希望大家的解释能联系画面，而不是说任何猜想都一样有道理。下一次放映时，我们会先让观众说出具体细节，再解释他们的判断。", "zh-Hant": "有的人說看出了他的緊張，也有人覺得他只是等朋友。我們後來加了他伸手又收回的一個動作，沒有加旁白直接解釋。我願意讓觀衆有不同理解，但希望大家的解釋能聯繫畫面，而不是說任何猜想都一樣有道理。下一次放映時，我們會先讓觀衆說出具體細節，再解釋他們的判斷。"}}], "sourceDurationSeconds": 46.636, "targetSeconds": [45, 60], "withinTarget": true, "src": "assets/audio/c4a-l3b.mp3", "durationSeconds": 47.184, "pcmSeconds": 47.136, "bytes": 377708, "sha256": "ae64f41d8d4665cd7db4e33c3d1d73885f36f96eb39aa6c9437183e4e3d917a6"}, {"id": "C4A-L3c", "kind": "listening-source", "questionNumbers": [14, 15], "sourcePlays": 1, "script": [{"speaker": "female", "text": {"zh-Hans": "方案甲。我们提议在校园活动中借用可重复使用的杯子。现有一百个杯子，清洗室周五下午能用，两位同学愿意在结束后负责清洗。先在这一次活动试用，记录归还情况，再决定要不要扩大。", "zh-Hant": "方案甲。我們提議在校園活動中借用可重複使用的杯子。現有一百個杯子，清洗室週五下午能用，兩位同學願意在結束後負責清洗。先在這一次活動試用，記錄歸還情況，再決定要不要擴大。"}}, {"speaker": "male", "text": {"zh-Hans": "方案乙。我们希望每个活动都立即使用这套杯子。可是周末清洗室不开，储存架也只够放这一百个。我们还没有找到周末能负责清洗的人。若能先解决清洗和存放，再推广比较稳妥，不应该只看杯子数量就决定。我们会先问清负责人的时间，再把完整的借还安排告诉其他活动组。", "zh-Hant": "方案乙。我們希望每個活動都立即使用這套杯子。可是週末清洗室不開，儲存架也只夠放這一百個。我們還沒有找到週末能負責清洗的人。若能先解決清洗和存放，再推廣比較穩妥，不應該只看杯子數量就決定。我們會先問清負責人的時間，再把完整的借還安排告訴其他活動組。"}}], "sourceDurationSeconds": 47.534, "targetSeconds": [45, 60], "withinTarget": true, "src": "assets/audio/c4a-l3c.mp3", "durationSeconds": 48.096, "pcmSeconds": 48.034, "bytes": 385004, "sha256": "7acab09856fc960ea099db14e1e71fd57b81fd2feb81183d3354bb5b41669e05"}, {"id": "C4A-L4a", "kind": "listening-source", "questionNumbers": [16], "sourcePlays": 1, "script": [{"speaker": "male", "text": {"zh-Hans": "关于周五活动的杯子归还，我们修改一项安排。原来所有人都要到食堂后门排队，现在每个班先收齐，再由两名代表送过去。杯子仍然只在周五下午清洗，不能留到周末。破损的杯子要单独放进有标记的盒子，不算作没有归还。试用记录会分别写清归还数量和破损数量，避免把两种情况混在一起。", "zh-Hant": "關於週五活動的杯子歸還，我們修改一項安排。原來所有人都要到食堂後門排隊，現在每個班先收齊，再由兩名代表送過去。杯子仍然只在週五下午清洗，不能留到週末。破損的杯子要單獨放進有標記的盒子，不算作沒有歸還。試用記錄會分別寫清歸還數量和破損數量，避免把兩種情況混在一起。"}}], "sourceDurationSeconds": 29.04, "targetSeconds": [24, 32], "withinTarget": true, "src": "assets/audio/c4a-l4a.mp3", "durationSeconds": 29.592, "pcmSeconds": 29.54, "bytes": 236972, "sha256": "bdedbaaa10131c2e6b76c1e58f66f944c4fdc24368afbe77c0c4fa755b19d59e"}, {"id": "C4A-L4b", "kind": "listening-source", "questionNumbers": [17, 18], "sourcePlays": 1, "script": [{"speaker": "female", "text": {"zh-Hans": "访谈甲。我试用导览工具后，找教室快了一些。因为主要路线的牌子都能识别，我不用每次问路。但是地下活动室的牌子太暗，工具两次都读错了。我建议先改善那里的标记，再请新同学试。", "zh-Hant": "訪談甲。我試用導覽工具後，找教室快了一些。因爲主要路線的牌子都能識別，我不用每次問路。但是地下活動室的牌子太暗，工具兩次都讀錯了。我建議先改善那裏的標記，再請新同學試。"}}, {"speaker": "male", "text": {"zh-Hans": "访谈乙。我带三位新同学试用，只有熟悉手机操作的一位一直顺利。另两位需要我先教他们怎么拍标记。教过以后，他们也能找到目的地。我赞成继续用，不过三个人的经历不能说明所有新生都不用帮助，更不能说工具已经在任何地方都准确。下一轮还需要让更多不同经验的同学试一试。", "zh-Hant": "訪談乙。我帶三位新同學試用，只有熟悉手機操作的一位一直順利。另兩位需要我先教他們怎麼拍標記。教過以後，他們也能找到目的地。我贊成繼續用，不過三個人的經歷不能說明所有新生都不用幫助，更不能說工具已經在任何地方都準確。下一輪還需要讓更多不同經驗的同學試一試。"}}], "sourceDurationSeconds": 48.71, "targetSeconds": [45, 60], "withinTarget": true, "src": "assets/audio/c4a-l4b.mp3", "durationSeconds": 49.272, "pcmSeconds": 49.21, "bytes": 394412, "sha256": "8989b429fe529f1917871f2320b39046b3236813413a05f5ccc5cb08196c1325"}, {"id": "C4A-L4c", "kind": "listening-source", "questionNumbers": [19, 20], "sourcePlays": 1, "script": [{"speaker": "female", "text": {"zh-Hans": "刚开始，社区展览要求每个家庭用同一张表介绍习惯。有位老人说表格能比较，可是写不出她为什么保留那个名字；一位年轻人也说自己的做法变过，不适合只勾选有或没有。", "zh-Hant": "剛開始，社區展覽要求每個家庭用同一張表介紹習慣。有位老人說表格能比較，可是寫不出她爲什麼保留那個名字；一位年輕人也說自己的做法變過，不適合只勾選有或沒有。"}}, {"speaker": "male", "text": {"zh-Hans": "所以后来你们怎样处理？", "zh-Hant": "所以後來你們怎樣處理？"}}, {"speaker": "female", "text": {"zh-Hans": "我们保留简短表格，让想讲经历的人加一段录音。工作人员帮忙整理，但请本人检查。这样没有取消共同的结构，也没有把个体故事压成一个选项。我原来觉得传统只要原样留下就好，现在更在意谁在讲、为什么改变，以及改变后哪些意义还在。", "zh-Hant": "我們保留簡短表格，讓想講經歷的人加一段錄音。工作人員幫忙整理，但請本人檢查。這樣沒有取消共同的結構，也沒有把個體故事壓成一個選項。我原來覺得傳統只要原樣留下就好，現在更在意誰在講、爲什麼改變，以及改變後哪些意義還在。"}}], "sourceDurationSeconds": 46.588, "targetSeconds": [45, 60], "withinTarget": true, "src": "assets/audio/c4a-l4c.mp3", "durationSeconds": 47.136, "pcmSeconds": 47.088, "bytes": 377324, "sha256": "3b15d53198ad68657d67a146504d02fb30a6cda62f438575804c6a35b79d07b6"}, {"id": "S1-1", "kind": "oral-prompt", "sourcePlays": 2, "singlePlayPcmSeconds": 8.136, "repeatGapSeconds": 1.5, "singlePlayPcmSha256": "6ad07a881893491e8bdf3f9dd1bad5f76331f9f4885f1f9e393356313f6dabf1", "script": {"zh-Hans": "活动要让不同语言的同学都能参加。你最想先照顾谁的需要？为什么？", "zh-Hant": "活動要讓不同語言的同學都能參加。你最想先照顧誰的需要？爲什麼？"}, "src": "assets/audio/s1-1.mp3", "durationSeconds": 17.832, "pcmSeconds": 17.772, "bytes": 142892, "sha256": "c92e8c5b23e3c534f0fd479a9efdf67b2e2b8ef188c506ef035414843b118b05"}, {"id": "S1-2", "kind": "oral-prompt", "sourcePlays": 2, "singlePlayPcmSeconds": 7.776, "repeatGapSeconds": 1.5, "singlePlayPcmSha256": "20e365cd0eabc1e9f042b0b56e5550c068f2fbb5ee427c05c2b5c77b1f060993", "script": {"zh-Hans": "有人提议只讲一种语言，有人希望两种语言并用。你怎样比较这两个办法？", "zh-Hant": "有人提議只講一種語言，有人希望兩種語言並用。你怎樣比較這兩個辦法？"}, "src": "assets/audio/s1-2.mp3", "durationSeconds": 17.112, "pcmSeconds": 17.052, "bytes": 137132, "sha256": "fc213d3a813285264f884889b8ad59d90ff9522fcab752838039452da8f50e19"}, {"id": "S1-3", "kind": "oral-prompt", "sourcePlays": 2, "singlePlayPcmSeconds": 8.4, "repeatGapSeconds": 1.5, "singlePlayPcmSha256": "e485e16e8bf3ac2f4529a17558df9afafafbd16f512e7f695b1c03db3084afcc", "script": {"zh-Hans": "现在有人担心翻译会改变故事意思，而且时间只有十分钟。你会怎样调整？", "zh-Hant": "現在有人擔心翻譯會改變故事意思，而且時間只有十分鐘。你會怎樣調整？"}, "src": "assets/audio/s1-3.mp3", "durationSeconds": 18.36, "pcmSeconds": 18.3, "bytes": 147116, "sha256": "e14ef3473bb7101c0b0ef582e93a7df0e1c5cb4ca492bdd2abe0ca1a6f8678eb"}, {"id": "S1-4", "kind": "oral-prompt", "sourcePlays": 2, "singlePlayPcmSeconds": 7.176, "repeatGapSeconds": 1.5, "singlePlayPcmSha256": "686af45303887026d1c98be477235f27d1c0b0ddf92740b9d2cedbaed00b5f66", "script": {"zh-Hans": "如果讲述者仍不同意翻译，你能接受什么妥协？下一步要先确认什么？", "zh-Hant": "如果講述者仍不同意翻譯，你能接受什麼妥協？下一步要先確認什麼？"}, "src": "assets/audio/s1-4.mp3", "durationSeconds": 15.912, "pcmSeconds": 15.852, "bytes": 127532, "sha256": "f066b901cb4f77a8280e20c0320a0c77da8fac9854320a1d836cce6bb5de7e0d"}], "groups": [{"id": "L1", "sourcePlays": 2, "questionNumbers": [1, 2, 3, 4, 5], "src": "assets/audio/listening-group-1.mp3", "durationSeconds": 450.048, "pcmSeconds": 450.0, "bytes": 3600620, "sha256": "d2e42a98cbc23e0fdc4c6f2908480e92970e22864b9a6a82e136b96d1c1011dc"}, {"id": "L2", "sourcePlays": 2, "questionNumbers": [6, 7, 8, 9, 10], "src": "assets/audio/listening-group-2.mp3", "durationSeconds": 450.048, "pcmSeconds": 450.0, "bytes": 3600620, "sha256": "ae7818cc6666b9b49acae5a65f72bc081b85148ad940696a356d72e7fd7e18ea"}, {"id": "L3", "sourcePlays": 2, "questionNumbers": [11, 12, 13, 14, 15], "src": "assets/audio/listening-group-3.mp3", "durationSeconds": 450.048, "pcmSeconds": 450.0, "bytes": 3600620, "sha256": "0a3d452388141386d6ff9b144a148d520713c45e6f878cc6a8fe2fa447965b7f"}, {"id": "L4", "sourcePlays": 2, "questionNumbers": [16, 17, 18, 19, 20], "src": "assets/audio/listening-group-4.mp3", "durationSeconds": 450.048, "pcmSeconds": 450.0, "bytes": 3600620, "sha256": "cd06937aeaebeb19261959abe0629e9d506eccd9abd61d13337df0ee7b0d8fb4"}], "timedTrack": {"src": "assets/audio/listening-full.mp3", "durationSeconds": 1800.048, "pcmSeconds": 1800.0, "bytes": 14400620, "sha256": "7ee752a4320cf238b44250a299ec73ef8a8f6ecc4aa46111e466e448be97f076"}, "timeline": [{"id": "C4A-L1a", "questionNumbers": [1], "shared": false, "previewStartSeconds": 0.0, "previewSeconds": 8, "labelStartSeconds": 8.0, "labelBudgetSeconds": 3, "firstPlayStartSeconds": 11.0, "secondPlayStartSeconds": 42.256, "speechEndSeconds": 71.512, "answerWindowSeconds": 16.488, "transitionSeconds": 2, "slotEndSeconds": 90.0, "sourcePlays": 2}, {"id": "C4A-L1b", "questionNumbers": [2, 3], "shared": true, "previewStartSeconds": 90.0, "previewSeconds": 18, "labelStartSeconds": 108.0, "labelBudgetSeconds": 6, "firstPlayStartSeconds": 114.0, "secondPlayStartSeconds": 163.764, "speechEndSeconds": 211.528, "answerWindowSeconds": 53.472, "transitionSeconds": 5, "slotEndSeconds": 270.0, "sourcePlays": 2}, {"id": "C4A-L1c", "questionNumbers": [4, 5], "shared": true, "previewStartSeconds": 270.0, "previewSeconds": 18, "labelStartSeconds": 288.0, "labelBudgetSeconds": 6, "firstPlayStartSeconds": 294.0, "secondPlayStartSeconds": 342.454, "speechEndSeconds": 388.908, "answerWindowSeconds": 56.092, "transitionSeconds": 5, "slotEndSeconds": 450.0, "sourcePlays": 2}, {"id": "C4A-L2a", "questionNumbers": [6], "shared": false, "previewStartSeconds": 450.0, "previewSeconds": 8, "labelStartSeconds": 458.0, "labelBudgetSeconds": 3, "firstPlayStartSeconds": 461.0, "secondPlayStartSeconds": 489.712, "speechEndSeconds": 516.424, "answerWindowSeconds": 21.576, "transitionSeconds": 2, "slotEndSeconds": 540.0, "sourcePlays": 2}, {"id": "C4A-L2b", "questionNumbers": [7, 8], "shared": true, "previewStartSeconds": 540.0, "previewSeconds": 18, "labelStartSeconds": 558.0, "labelBudgetSeconds": 6, "firstPlayStartSeconds": 564.0, "secondPlayStartSeconds": 614.974, "speechEndSeconds": 663.948, "answerWindowSeconds": 51.052, "transitionSeconds": 5, "slotEndSeconds": 720.0, "sourcePlays": 2}, {"id": "C4A-L2c", "questionNumbers": [9, 10], "shared": true, "previewStartSeconds": 720.0, "previewSeconds": 18, "labelStartSeconds": 738.0, "labelBudgetSeconds": 6, "firstPlayStartSeconds": 744.0, "secondPlayStartSeconds": 794.34, "speechEndSeconds": 842.68, "answerWindowSeconds": 52.32, "transitionSeconds": 5, "slotEndSeconds": 900.0, "sourcePlays": 2}, {"id": "C4A-L3a", "questionNumbers": [11], "shared": false, "previewStartSeconds": 900.0, "previewSeconds": 8, "labelStartSeconds": 908.0, "labelBudgetSeconds": 3, "firstPlayStartSeconds": 911.0, "secondPlayStartSeconds": 943.144, "speechEndSeconds": 973.288, "answerWindowSeconds": 14.712, "transitionSeconds": 2, "slotEndSeconds": 990.0, "sourcePlays": 2}, {"id": "C4A-L3b", "questionNumbers": [12, 13], "shared": true, "previewStartSeconds": 990.0, "previewSeconds": 18, "labelStartSeconds": 1008.0, "labelBudgetSeconds": 6, "firstPlayStartSeconds": 1014.0, "secondPlayStartSeconds": 1062.636, "speechEndSeconds": 1109.272, "answerWindowSeconds": 55.728, "transitionSeconds": 5, "slotEndSeconds": 1170.0, "sourcePlays": 2}, {"id": "C4A-L3c", "questionNumbers": [14, 15], "shared": true, "previewStartSeconds": 1170.0, "previewSeconds": 18, "labelStartSeconds": 1188.0, "labelBudgetSeconds": 6, "firstPlayStartSeconds": 1194.0, "secondPlayStartSeconds": 1243.534, "speechEndSeconds": 1291.068, "answerWindowSeconds": 53.932, "transitionSeconds": 5, "slotEndSeconds": 1350.0, "sourcePlays": 2}, {"id": "C4A-L4a", "questionNumbers": [16], "shared": false, "previewStartSeconds": 1350.0, "previewSeconds": 8, "labelStartSeconds": 1358.0, "labelBudgetSeconds": 3, "firstPlayStartSeconds": 1361.0, "secondPlayStartSeconds": 1392.04, "speechEndSeconds": 1421.08, "answerWindowSeconds": 16.92, "transitionSeconds": 2, "slotEndSeconds": 1440.0, "sourcePlays": 2}, {"id": "C4A-L4b", "questionNumbers": [17, 18], "shared": true, "previewStartSeconds": 1440.0, "previewSeconds": 18, "labelStartSeconds": 1458.0, "labelBudgetSeconds": 6, "firstPlayStartSeconds": 1464.0, "secondPlayStartSeconds": 1514.71, "speechEndSeconds": 1563.42, "answerWindowSeconds": 51.58, "transitionSeconds": 5, "slotEndSeconds": 1620.0, "sourcePlays": 2}, {"id": "C4A-L4c", "questionNumbers": [19, 20], "shared": true, "previewStartSeconds": 1620.0, "previewSeconds": 18, "labelStartSeconds": 1638.0, "labelBudgetSeconds": 6, "firstPlayStartSeconds": 1644.0, "secondPlayStartSeconds": 1692.588, "speechEndSeconds": 1739.176, "answerWindowSeconds": 55.824, "transitionSeconds": 5, "slotEndSeconds": 1800.0, "sourcePlays": 2}], "speakingPlannedMaximumSeconds": 466.976, "speakingReserveSeconds": 133.024, "cache": [{"key": "401171ab338f58ff026edda2", "speaker": "female", "text": "社区故事展原来只用中文写标题。今年有同学建议全部换成英文，让更多邻居看懂。我认为可以保留中文，再加一句英文说明。这样不认识汉字的人也能了解内容，熟悉中文的老人仍然能看到原来的名字。两种文字不是只能选一种。我们还会请讲故事的人检查说明，免得意思变了。", "sha256": "c6e7c74d4defaeebda89ff8ce5fa6b60c3af1b15e1148351f5bd103d2d16b98b"}, {"key": "34e89f8d03ace2b111d8dc37", "speaker": "female", "text": "第1题。", "sha256": "3895df58b8b6ce61365216490dcb339db3aa7ef168eef8d2098c469073a4cdc2"}, {"key": "e9372846a4e2b960a0a1a1a4", "speaker": "male", "text": "我以前介绍家里的故事，总是先说我们家的人每年都这样做。后来妹妹提醒我，她在外地读书以后就换了做法，不能把我的经验说成全家的规定。", "sha256": "5d69a437c01273137b39ca0085931972e0ee13dbfdf28f06a1e8f8a6eb7adfbb"}, {"key": "4fdc2b9d16c25e8f73b3c1e1", "speaker": "female", "text": "那你在故事展里怎么介绍呢？", "sha256": "faa5d045308948dddbace54d3dd3f39ad5e1da49bb671e4edb532834be8e1b84"}, {"key": "bba0576d5308dd1ce71f36bb", "speaker": "male", "text": "我先说明这是我小时候和爷爷一起准备晚饭的经历，再请妹妹补充她现在的办法。原来的菜名仍然保留，做菜步骤却可以不同。我们想让观众听出两个人的生活背景，而不是判断谁的做法才算正确。妹妹也同意把两段录音放在一起。展签会写清楚是谁在讲，也请观众先听完，再提出自己的问题。", "sha256": "5a4afbd440ea47ef1d6b5c0fcd0e72e4c3455fe8db2b83188cf9bc68cd5a00aa"}, {"key": "59a37835b5cee9f38c336089", "speaker": "female", "text": "第2题到第3题。", "sha256": "c5aa462a627f4025322935611b7bae282a9707cc5d99053588618b9151947c3f"}, {"key": "148b4a1f2e86a8517325f4aa", "speaker": "female", "text": "留言甲。我邀请伙伴来故事展时说，周五先随便聊聊，不用准备正式发言。我想让第一次见面的同学轻松一些。标题翻译等大家熟悉后再一起商量，不需要他们先交成品。", "sha256": "c43ad4c4044064853b58f1885afb65a34f3b87afad04b7e1bd18e118bf8d033f"}, {"key": "bdbb94352b514c4e26865ddf", "speaker": "male", "text": "留言乙。我以为随便聊聊就是可以不参加，所以答应那天替朋友值班。我并不是不愿意合作。我现在才知道，那次见面是让双方认识、分配后面的工作。我可以换班，但想先确认见面的目的和结束时间，再答复。我希望以后邀请时把参加要求写清楚，不只是说气氛轻松，以免其他人也理解错。", "sha256": "c957dc5b60086268f6e3d62e845861c3de101796c048aea4d76c5ebb298f9d5a"}, {"key": "57776ef6b9167b48c9682e35", "speaker": "female", "text": "第4题到第5题。", "sha256": "b1b9e81f6b43570946d2619a949b1119cb49d29689c181f957021a7da823ba1a"}, {"key": "f8caba734224e02881dd5552", "speaker": "male", "text": "这次线上交流已经确定在周四放学后进行，参加者要先看完对方发来的三张展览照片。老师会把不认识的词放在照片旁边。大家不用写完整报告，但每个人都要准备一个与照片有关的问题。交流时可以请对方解释，不必假装已经了解所有背景。设备测试另安排在周三午休。", "sha256": "2e4482aee1d1b098f55176b49fed0b9b50e4cb72a15e9bc38296ab324802805a"}, {"key": "5e6c5b336701fe2c48b7fa2f", "speaker": "female", "text": "第6题。", "sha256": "fcc5b0fabad8f1fa79148054a17b60ac8d2cb351d57ed0d5eb073df550e3ee93"}, {"key": "3bd713ba836f014a86d67550", "speaker": "female", "text": "反馈甲。我用翻译工具给展品写英文简介，第一稿出来得很快。但是人物称呼有时不对。我希望先看到中文原稿和英文并排的结果，这样能请讲故事的人一起检查，再决定是否使用。", "sha256": "0c9ec7bd09b095e398f7e68c6480fcee5049d9ae014344cdc5b502a3558e90a0"}, {"key": "6b42380fb0b10f7e74d4e30b", "speaker": "male", "text": "反馈乙。我负责接待，不会把工具的结果直接印出来。工具省下了查普通词的时间，可是有些地方的名字译得不一致。我也想保留两种文字，还要给改过的地方作标记。现在有人建议把所有译文自动发布，我觉得还需要人工确认。确认过的内容才能给访客看，修改以后也要留下日期，避免误用旧稿。", "sha256": "78eac95ae89446015fb3b6f2a3d11a5fb3205c104644083b5b7aedf4807ea449"}, {"key": "64c66b2840929c1c7f0a128c", "speaker": "female", "text": "第7题到第8题。", "sha256": "e68967a3ec70be7f22d0b224f111132969b5f86b19e9c18b08ec31874f504e59"}, {"key": "bf0a0fe1440c25137bfd43d3", "speaker": "female", "text": "图书馆下周开始试行新规则。靠窗的区域保持安静，讨论小组可以预约门口的房间，每次三十分钟。有人担心临时来的人没有位置，所以我们先把周三中午留作不用预约的时段。", "sha256": "553dc09c2a7e40c507ad23bbd278cc0ec86064e1344585b8a1a72c81524db70e"}, {"key": "a0ca281ae2446522a356db4d", "speaker": "male", "text": "那我接受先试两周。不过不用预约也不该表示可以一直占着房间。我们要写清楚，每组仍然最多用三十分钟，两周后再看等候记录。", "sha256": "3e1b1626cf997792916f9a1e679f0ad7fe232cc940cabaf89499dd3b5f098277"}, {"key": "4c84e3cdd41cc5d5a7e16fba", "speaker": "female", "text": "同意。这样能听到临时使用者的意见，也不取消原来需要安静的人可以使用的区域。通知里会分别写出两种空间的用途，让第一次来的同学也容易理解。", "sha256": "e39584a1828bc705cef1a112bb4eea301de205b112a48ba56378667c62f75d7e"}, {"key": "cb299aa387ffea4c204f4fd8", "speaker": "female", "text": "第9题到第10题。", "sha256": "156a13ef215d9abd3619c718ca13cadb0ae55714d67e1a7c354a48af38c18c14"}, {"key": "2daa14b2cd53eddd27da7c68", "speaker": "female", "text": "这部校园短片不是教大家怎样整理旧照片。导演拍的是两位同学看同一张照片时不同的反应。画面里没有解释谁记错了，而是让两个人分别讲述当时的感受。放映后，观众可以说自己注意到的细节，再看看这些细节怎样影响理解。我们希望大家学会听见不同的声音，不是背出标准感想。", "sha256": "d7436df65557d2cd3855a79c98de3c2aa965f2c732224046a5f9305d46623a55"}, {"key": "63d3dd3f27ad85dca9aa0606", "speaker": "female", "text": "第11题。", "sha256": "09609165ce7b5b5bbc80de6236e7726415e2ab45d65241e1ca3c75ec4a697f32"}, {"key": "50e6a76bb884ec42e101e4cb", "speaker": "male", "text": "短片里，小河站在门外很久才进去。我们剪第一版时，有人觉得这段停顿没用，应该删掉。我却想留下，因为前面他刚说过，怕进去以后不知道怎样开口。", "sha256": "f04ee01067471dea8093c4e13af22d807cfaef549780277e6ab7cc9da47ce123"}, {"key": "0e1dd3a23699cc570f750625", "speaker": "female", "text": "留下以后，观众明白你的意思了吗？", "sha256": "aa39eff684be7d49788fc93af606abc45238cdc5b3b0e391765203a45b8b0e3c"}, {"key": "e0616371a0236dbc160201cb", "speaker": "male", "text": "有的人说看出了他的紧张，也有人觉得他只是等朋友。我们后来加了他伸手又收回的一个动作，没有加旁白直接解释。我愿意让观众有不同理解，但希望大家的解释能联系画面，而不是说任何猜想都一样有道理。下一次放映时，我们会先让观众说出具体细节，再解释他们的判断。", "sha256": "1aa55a5806a37f2ffa25a8e265172041380a7a08f1bfbf811ad31a58bbf04fc5"}, {"key": "897d5f3dc3700eb43e7cbb5e", "speaker": "female", "text": "第12题到第13题。", "sha256": "c0764bbeffc04d14e861e97e76647ca832c7374a425f990051edfc4be7105283"}, {"key": "ae425ea8504375cd3aca1dd1", "speaker": "female", "text": "方案甲。我们提议在校园活动中借用可重复使用的杯子。现有一百个杯子，清洗室周五下午能用，两位同学愿意在结束后负责清洗。先在这一次活动试用，记录归还情况，再决定要不要扩大。", "sha256": "110ac3419f8007202493bd87685f0562fdeab5f7dabe0cd7b750d2aadfa84bca"}, {"key": "2882b3487f8700655e2ba55b", "speaker": "male", "text": "方案乙。我们希望每个活动都立即使用这套杯子。可是周末清洗室不开，储存架也只够放这一百个。我们还没有找到周末能负责清洗的人。若能先解决清洗和存放，再推广比较稳妥，不应该只看杯子数量就决定。我们会先问清负责人的时间，再把完整的借还安排告诉其他活动组。", "sha256": "55360df1fa41d85318f1175b014f907860eb43cdd8d6d6e273cfc2f1786a5d5e"}, {"key": "d2b1b6c44f506d7526503dfd", "speaker": "female", "text": "第14题到第15题。", "sha256": "0906d17c5251bf2008c56b4ace9b116fde0acd70c415b18aa7d1607319a3b61d"}, {"key": "a3cc0ff4118bef1e235f6c69", "speaker": "male", "text": "关于周五活动的杯子归还，我们修改一项安排。原来所有人都要到食堂后门排队，现在每个班先收齐，再由两名代表送过去。杯子仍然只在周五下午清洗，不能留到周末。破损的杯子要单独放进有标记的盒子，不算作没有归还。试用记录会分别写清归还数量和破损数量，避免把两种情况混在一起。", "sha256": "47accf3e655afb85d207c44b223f0f70c97d6dce808a9c15d7e6d60bb72930c4"}, {"key": "0cffbf1010d1e54023057ea9", "speaker": "female", "text": "第16题。", "sha256": "6cbe22b4463ef0127dbcb5957919648ee9b071c97d70d0b85edf327b6a0071df"}, {"key": "a5dfea655e874cfad76bce22", "speaker": "female", "text": "访谈甲。我试用导览工具后，找教室快了一些。因为主要路线的牌子都能识别，我不用每次问路。但是地下活动室的牌子太暗，工具两次都读错了。我建议先改善那里的标记，再请新同学试。", "sha256": "64b4a01119bd45a5257ada46b00fe08792f5dce9bcbc9656c357551a27f6e358"}, {"key": "2c295ce2bc2e4ec32f6c5dda", "speaker": "male", "text": "访谈乙。我带三位新同学试用，只有熟悉手机操作的一位一直顺利。另两位需要我先教他们怎么拍标记。教过以后，他们也能找到目的地。我赞成继续用，不过三个人的经历不能说明所有新生都不用帮助，更不能说工具已经在任何地方都准确。下一轮还需要让更多不同经验的同学试一试。", "sha256": "ace59e7c508b67442162a7d1b750a7ca3a3610334f4c702a5ac0b4461d2fecda"}, {"key": "39783cd7fc1f12c860740889", "speaker": "female", "text": "第17题到第18题。", "sha256": "01a9a45721addca80a07e682ec5e8610bb430ec1cbeedbbb220e9a65db18feb4"}, {"key": "354c0172a6394659f6a60563", "speaker": "female", "text": "刚开始，社区展览要求每个家庭用同一张表介绍习惯。有位老人说表格能比较，可是写不出她为什么保留那个名字；一位年轻人也说自己的做法变过，不适合只勾选有或没有。", "sha256": "9f9711b3710296307372ec70c468727dff18972d604e0c15096a7f616578ee79"}, {"key": "546521e6f0d7ba287e9ea4bd", "speaker": "male", "text": "所以后来你们怎样处理？", "sha256": "87c0877bc15752442ebd3d4ef503b848ab3f18ff2fff0ceb36288e2b52ccaae1"}, {"key": "1c63a4fec84c860de5d49257", "speaker": "female", "text": "我们保留简短表格，让想讲经历的人加一段录音。工作人员帮忙整理，但请本人检查。这样没有取消共同的结构，也没有把个体故事压成一个选项。我原来觉得传统只要原样留下就好，现在更在意谁在讲、为什么改变，以及改变后哪些意义还在。", "sha256": "9eda9beb8b05b7b93e83b828884f6703959c8debba3769387762e20bc31d738b"}, {"key": "f95c9b6602b74fc57bb96e4c", "speaker": "female", "text": "第19题到第20题。", "sha256": "7520f48462fd711504e5121ae27158508115a47849655c6a122f6d8b979678bf"}, {"key": "8adab662e144f6e0595bd1cd", "speaker": "female", "text": "活动要让不同语言的同学都能参加。你最想先照顾谁的需要？为什么？", "sha256": "165b84ff4e7222a639fa656245cf560400d1d2a6799cd2b88377e73269c39dd3"}, {"key": "add8e6b091e16caf5523c434", "speaker": "female", "text": "有人提议只讲一种语言，有人希望两种语言并用。你怎样比较这两个办法？", "sha256": "8894e5353af372c67615aa7e0ab3c89ef975c3019bfa3ed93cf5c6e4b2ee26b9"}, {"key": "4aaed70a415df10f86a6a4dc", "speaker": "female", "text": "现在有人担心翻译会改变故事意思，而且时间只有十分钟。你会怎样调整？", "sha256": "dff377c784a322c14834aaea5dd96e013b6faaf68bfd83217110eab8a9cc78e4"}, {"key": "4fd123ddcd57af486494601b", "speaker": "female", "text": "如果讲述者仍不同意翻译，你能接受什么妥协？下一步要先确认什么？", "sha256": "0c7398a56c66750435ed3efbd0e88be945ddfe57740efe74eb9abe9bcec6f05f"}]}</script><script src="workspace.js" defer></script><noscript>Use the learner PDF and audio review if JavaScript is unavailable.</noscript></body></html>