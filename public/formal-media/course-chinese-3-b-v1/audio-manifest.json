      "sha256": "05c22e9850bcefd2fbe50754a76a9124533e1249141aaa4005b3887f04b12ee9"
    },
    {
      "id": "C3B-L4c",
      "kind": "listening-source",
      "questionNumbers": [
        19,
        20
      ],
      "sourcePlays": 1,
      "script": [
        {
          "speaker": "male",
          "text": {
            "zh-Hans": "我第一次弹吉他给同学听时，总想一口气把整首曲子弹得完美，前一晚练到很晚，第二天却忘了一小段。我以为大家只记得那个错误。后来朋友说，他最喜欢的是我们一起跟着唱的部分。",
            "zh-Hant": "我第一次彈吉他給同學聽時，總想一口氣把整首曲子彈得完美，前一晚練到很晚，第二天卻忘了一小段。我以爲大家只記得那個錯誤。後來朋友說，他最喜歡的是我們一起跟着唱的部分。"
          }
        },
        {
          "speaker": "female",
          "text": {
            "zh-Hans": "我最近练画画，每周只有两次短时间，总觉得不画完整幅就没有进步。",
            "zh-Hant": "我最近練畫畫，每週只有兩次短時間，總覺得不畫完整幅就沒有進步。"
          }
        },
        {
          "speaker": "male",
          "text": {
            "zh-Hans": "可以每次先练一个小地方，结束后收好材料，留点时间休息。我后来也是一段一段练，再请朋友听。现在再看那次演出的照片，我先想起大家唱歌的样子，不再先数自己错了几个音。",
            "zh-Hant": "可以每次先練一個小地方，結束後收好材料，留點時間休息。我後來也是一段一段練，再請朋友聽。現在再看那次演出的照片，我先想起大家唱歌的樣子，不再先數自己錯了幾個音。"
          }
        }
      ],
      "sourceDurationSeconds": 41.044,
      "targetSeconds": [
        35,
        48
      ],
      "withinTarget": true,
