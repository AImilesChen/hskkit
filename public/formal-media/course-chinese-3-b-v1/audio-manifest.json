    {
      "id": "S1-1",
      "kind": "oral-prompt",
      "sourcePlays": 2,
      "singlePlayPcmSeconds": 6.36,
      "repeatGapSeconds": 1.5,
      "singlePlayPcmSha256": "3e8ee68d8c9ecd7e41e39995a196409c850c220a739ab299fc5f4d4b215fcbb5",
      "script": {
        "zh-Hans": "我们要一起推荐一本书。你最想让大家知道什么？为什么？",
        "zh-Hant": "我們要一起推薦一本書。你最想讓大家知道什麼？爲什麼？"
      },
      "src": "assets/audio/s1-1.mp3",
      "durationSeconds": 14.28,
      "pcmSeconds": 14.22,
      "bytes": 114476,
      "sha256": "6d0f9fac83dc54cdcb58e9ee4c86e60aa5a63b16cec5cdcaabfd45bffa1bce3e"
    },
    {
      "id": "S1-2",
