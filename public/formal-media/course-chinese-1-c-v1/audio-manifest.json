    },
    {
      "id": "C1C-M15",
      "kind": "listening-source",
      "sourcePlays": 1,
      "script": [
        {
          "speaker": "female",
          "text": {
            "zh-Hans": "这件小号上衣有点儿小。能试试中号吗？",
            "zh-Hant": "這件小號上衣有點兒小。能試試中號嗎？"
          }
        },
        {
          "speaker": "male",
          "text": {
            "zh-Hans": "可以，这里有中号和大号。",
            "zh-Hant": "可以，這裏有中號和大號。"
          }
        },
        {
          "speaker": "female",
          "text": {
            "zh-Hans": "中号正好，我就要中号的。",
            "zh-Hant": "中號正好，我就要中號的。"
          }
        }
      ],
      "sourceDurationSeconds": 11.884,
      "src": "assets/audio/c1c-m15.mp3",
