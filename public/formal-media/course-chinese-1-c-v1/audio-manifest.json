    {
      "id": "C1C-M13",
      "kind": "listening-source",
      "sourcePlays": 1,
      "script": [
        {
          "speaker": "female",
          "text": {
            "zh-Hans": "妈妈喜欢吃西瓜，爸爸喜欢苹果。我最喜欢橙子。今天我给他们买西瓜和苹果，也给自己买了几个橙子。",
            "zh-Hant": "媽媽喜歡喫西瓜，爸爸喜歡蘋果。我最喜歡橙子。今天我給他們買西瓜和蘋果，也給自己買了幾個橙子。"
          }
        }
      ],
      "sourceDurationSeconds": 11.04,
