    {
      "id": "C1C-M02",
      "kind": "listening-source",
      "sourcePlays": 1,
      "script": [
        {
          "speaker": "female",
          "text": {
            "zh-Hans": "奶奶一个人住在南京。明天我和爸爸坐车去看她，妈妈要工作，不能一起去。我们星期天晚上回来。",
            "zh-Hant": "奶奶一個人住在南京。明天我和爸爸坐車去看她，媽媽要工作，不能一起去。我們星期天晚上回來。"
          }
        }
      ],
      "sourceDurationSeconds": 10.872,
      "src": "assets/audio/c1c-m02.mp3",
      "durationSeconds": 11.424,
      "pcmSeconds": 11.372,
      "bytes": 91628,
      "sha256": "d8d01a526e2aca6556425c44ddf70941894238376054286bf44ca77e1e2e1b50"
    },
    {
      "id": "C1C-M03",
      "kind": "listening-source",
      "sourcePlays": 1,
      "script": [
        {
          "speaker": "male",
          "text": {
            "zh-Hans": "今天是妈妈的生日。我和爸爸买了一个蛋糕，姐姐准备晚饭。妈妈下班回家以后，我们一起给她唱生日歌。",
            "zh-Hant": "今天是媽媽的生日。我和爸爸買了一個蛋糕，姐姐準備晚飯。媽媽下班回家以後，我們一起給她唱生日歌。"
          }
        }
      ],
      "sourceDurationSeconds": 10.44,
      "src": "assets/audio/c1c-m03.mp3",
      "durationSeconds": 10.992,
      "pcmSeconds": 10.94,
      "bytes": 88172,
      "sha256": "6af77eeddb61f314aa015dca32b60c407d5d35ff54b1689d74cbdb14d6789a00"
    },
    {
      "id": "C1C-M04",
      "kind": "listening-source",
      "sourcePlays": 1,
      "script": [
        {
          "speaker": "female",
          "text": {
            "zh-Hans": "我现在和爸爸妈妈住在天津。哥哥在上海工作，爷爷奶奶住在北京。我们放假的时候常常去北京看他们。",
            "zh-Hant": "我現在和爸爸媽媽住在天津。哥哥在上海工作，爺爺奶奶住在北京。我們放假的時候常常去北京看他們。"
          }
        }
      ],
      "sourceDurationSeconds": 11.136,
      "src": "assets/audio/c1c-m04.mp3",
