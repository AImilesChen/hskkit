      "pcmSeconds": 11.516,
      "bytes": 92780,
      "sha256": "0f38b693f67c051ebdbe1ec912051b3247e247260295834f232a6da3e84c3e49"
    },
    {
      "id": "C1C-M10",
      "kind": "listening-source",
      "sourcePlays": 1,
      "script": [
        {
          "speaker": "female",
          "text": {
            "zh-Hans": "明天中文课几点下课？",
            "zh-Hant": "明天中文課幾點下課？"
          }
        },
        {
          "speaker": "male",
          "text": {
            "zh-Hans": "八点开始，八点四十结束。休息以后，九点上英语课。",
            "zh-Hant": "八點開始，八點四十結束。休息以後，九點上英語課。"
          }
        },
        {
          "speaker": "female",
          "text": {
            "zh-Hans": "好，我八点四十来找你。",
            "zh-Hant": "好，我八點四十來找你。"
          }
        }
      ],
      "sourceDurationSeconds": 12.82,
      "src": "assets/audio/c1c-m10.mp3",
      "durationSeconds": 13.368,
      "pcmSeconds": 13.32,
      "bytes": 107180,
      "sha256": "da27fca9fb198204d928438593514b6e8eacbc8201a03864be49a9abaf2feea0"
    },
    {
      "id": "C1C-M11",
      "kind": "listening-source",
      "sourcePlays": 1,
      "script": [
        {
          "speaker": "male",
          "text": {
            "zh-Hans": "这碗汤已经凉了，能换一碗热的吗？",
            "zh-Hant": "這碗湯已經涼了，能換一碗熱的嗎？"
          }
        },
        {
          "speaker": "female",
          "text": {
            "zh-Hans": "可以，我给您换热汤。",
            "zh-Hant": "可以，我給您換熱湯。"
          }
        },
        {
          "speaker": "male",
          "text": {
            "zh-Hans": "谢谢，天气有点儿冷，我想喝热的。",
            "zh-Hant": "謝謝，天氣有點兒冷，我想喝熱的。"
          }
        }
      ],
      "sourceDurationSeconds": 11.548,
      "src": "assets/audio/c1c-m11.mp3",
