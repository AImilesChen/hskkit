      "sha256": "99168043fe57dc73ec7a34d2094b45b9fb31eb2ab2901e034566fee52c221601"
    },
    {
      "id": "C1C-M12",
      "kind": "listening-source",
      "sourcePlays": 1,
      "script": [
        {
          "speaker": "female",
          "text": {
            "zh-Hans": "这份午饭在这儿吃吗？",
            "zh-Hant": "這份午飯在這兒喫嗎？"
          }
        },
        {
          "speaker": "male",
          "text": {
            "zh-Hans": "不，我要带回家吃。家里还有人在等我。请帮我装好，筷子我家里有，不用给了。",
            "zh-Hant": "不，我要帶回家喫。家裏還有人在等我。請幫我裝好，筷子我家裏有，不用給了。"
          }
        }
      ],
      "sourceDurationSeconds": 11.486,
      "src": "assets/audio/c1c-m12.mp3",
