    {
      "id": "C1C-M17",
      "kind": "listening-source",
      "sourcePlays": 1,
      "script": [
        {
          "speaker": "female",
          "text": {
            "zh-Hans": "这班车九点开。我们八点半从家里出发，八点四十到车站。到了以后先买票，再一起等车。",
            "zh-Hant": "這班車九點開。我們八點半從家裏出發，八點四十到車站。到了以後先買票，再一起等車。"
          }
        }
      ],
