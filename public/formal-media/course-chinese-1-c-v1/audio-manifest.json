        {
          "speaker": "female",
          "text": {
            "zh-Hans": "今天放学后一起去游泳吗？",
            "zh-Hant": "今天放學後一起去游泳嗎？"
          }
        },
        {
          "speaker": "male",
          "text": {
            "zh-Hans": "今天我不去游泳，我想在家看书。明天再去游泳。",
            "zh-Hant": "今天我不去游泳，我想在家看書。明天再去游泳。"
          }
        },
        {
          "speaker": "female",
          "text": {
            "zh-Hans": "好，那我们明天下午见。",
            "zh-Hant": "好，那我們明天下午見。"
          }
        }
      ],
