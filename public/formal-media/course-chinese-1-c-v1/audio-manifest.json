      "pcmSeconds": 11.636,
      "bytes": 93740,
      "sha256": "a686ecdc3950589a84dbbf3e2fef25bb2c48f0a61b18039105de05f49fed5604"
    },
    {
      "id": "C1C-M05",
      "kind": "listening-source",
      "sourcePlays": 1,
      "script": [
        {
          "speaker": "male",
          "text": {
            "zh-Hans": "星期一上午第一节是数学课，第二节才是中文课。下午有体育课。今天我先把数学书拿出来，中文书还放在书包里。",
            "zh-Hant": "星期一上午第一節是數學課，第二節纔是中文課。下午有體育課。今天我先把數學書拿出來，中文書還放在書包裏。"
          }
        }
      ],
      "sourceDurationSeconds": 11.52,
      "src": "assets/audio/c1c-m05.mp3",
      "durationSeconds": 12.072,
      "pcmSeconds": 12.02,
      "bytes": 96812,
      "sha256": "5eab491c7d884f8112649c6c6ed980356a5ced98753f4adea24f6f542987067f"
    },
    {
      "id": "C1C-M06",
      "kind": "listening-source",
      "sourcePlays": 1,
      "script": [
        {
          "speaker": "female",
          "text": {
            "zh-Hans": "老师，我的橡皮找不到了。",
            "zh-Hant": "老師，我的橡皮找不到了。"
          }
        },
        {
          "speaker": "male",
          "text": {
            "zh-Hans": "黑板旁边的红盒子里有橡皮，你拿一块吧。",
            "zh-Hant": "黑板旁邊的紅盒子裏有橡皮，你拿一塊吧。"
          }
        },
        {
          "speaker": "female",
          "text": {
            "zh-Hans": "谢谢，我用完以后放回盒子。",
            "zh-Hant": "謝謝，我用完以後放回盒子。"
          }
        }
      ],
      "sourceDurationSeconds": 11.596,
      "src": "assets/audio/c1c-m06.mp3",
      "durationSeconds": 12.144,
      "pcmSeconds": 12.096,
      "bytes": 97388,
      "sha256": "39670ba31bcce7fc521dcab8938b73f4b6df8547bef2984178fef5e93fca5c54"
    },
    {
      "id": "C1C-M07",
      "kind": "listening-source",
      "sourcePlays": 1,
      "script": [
        {
          "speaker": "male",
          "text": {
            "zh-Hans": "老师，今天的答案写在书上吗？",
            "zh-Hant": "老師，今天的答案寫在書上嗎？"
          }
        },
        {
          "speaker": "female",
          "text": {
            "zh-Hans": "不要写在书上，写在本子上。写完以后把本子交给我，书先放在桌子上。",
            "zh-Hant": "不要寫在書上，寫在本子上。寫完以後把本子交給我，書先放在桌子上。"
          }
        }
      ],
      "sourceDurationSeconds": 11.894,
      "src": "assets/audio/c1c-m07.mp3",
      "durationSeconds": 12.456,
      "pcmSeconds": 12.394,
      "bytes": 99884,
      "sha256": "3114485f1c3fa64f8c80dd77e1c80be6d242771861800a0c683761bba2055b73"
    },
    {
      "id": "C1C-M08",
      "kind": "listening-source",
      "sourcePlays": 1,
      "script": [
        {
          "speaker": "female",
          "text": {
            "zh-Hans": "老师，这本书是谁的？不是我的，我的在书包里。",
            "zh-Hant": "老師，這本書是誰的？不是我的，我的在書包裏。"
          }
        },
        {
          "speaker": "male",
          "text": {
            "zh-Hans": "我看看，上面写着小陈的名字。请你下课后把书给小陈。",
            "zh-Hant": "我看看，上面寫着小陳的名字。請你下課後把書給小陳。"
          }
        }
      ],
      "sourceDurationSeconds": 12.734,
      "src": "assets/audio/c1c-m08.mp3",
      "durationSeconds": 13.296,
      "pcmSeconds": 13.234,
      "bytes": 106604,
      "sha256": "eaaca7c8266ba317df3478056a6304a215c879a7250280b52f0bfe7e96015c25"
    },
    {
      "id": "C1C-M09",
      "kind": "listening-source",
      "sourcePlays": 1,
      "script": [
        {
          "speaker": "male",
          "text": {
            "zh-Hans": "明天体育课，每人带一瓶水和一条毛巾。不用自己带篮球，学校有。请大家穿运动鞋，准时到操场。",
            "zh-Hant": "明天體育課，每人帶一瓶水和一條毛巾。不用自己帶籃球，學校有。請大家穿運動鞋，準時到操場。"
          }
        }
      ],
      "sourceDurationSeconds": 11.016,
      "src": "assets/audio/c1c-m09.mp3",
