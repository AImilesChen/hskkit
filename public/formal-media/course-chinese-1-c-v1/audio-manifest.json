    {
      "id": "C1C-M14",
      "kind": "listening-source",
      "sourcePlays": 1,
      "script": [
        {
          "speaker": "male",
          "text": {
            "zh-Hans": "面条八块，加一个鸡蛋一共多少钱？",
            "zh-Hant": "麪條八塊，加一個雞蛋一共多少錢？"
          }
        },
        {
          "speaker": "female",
          "text": {
            "zh-Hans": "一共十块。",
            "zh-Hant": "一共十塊。"
          }
        },
        {
          "speaker": "male",
          "text": {
            "zh-Hans": "好，我给你十块。",
            "zh-Hant": "好，我給你十塊。"
          }
        },
        {
          "speaker": "female",
          "text": {
            "zh-Hans": "谢谢，请在旁边等一下。",
            "zh-Hant": "謝謝，請在旁邊等一下。"
          }
        }
      ],
      "sourceDurationSeconds": 12.81,
      "src": "assets/audio/c1c-m14.mp3",
