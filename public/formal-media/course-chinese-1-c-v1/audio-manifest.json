    {
      "id": "C1C-M16",
      "kind": "listening-source",
      "sourcePlays": 1,
      "script": [
        {
          "speaker": "male",
          "text": {
            "zh-Hans": "我们下午三点见，好吗？",
            "zh-Hant": "我們下午三點見，好嗎？"
          }
        },
        {
          "speaker": "female",
          "text": {
            "zh-Hans": "我两点半就到了，可以早一点见吗？",
            "zh-Hant": "我兩點半就到了，可以早一點見嗎？"
          }
        },
        {
          "speaker": "male",
          "text": {
            "zh-Hans": "可以，那我们两点半见，我也早点出门。",
            "zh-Hant": "可以，那我們兩點半見，我也早點出門。"
          }
        }
      ],
