    {
      "id": "C1C-M18",
      "kind": "listening-source",
      "sourcePlays": 1,
      "script": [
        {
          "speaker": "male",
          "text": {
            "zh-Hans": "明天学校活动，我们穿什么衣服？",
            "zh-Hant": "明天學校活動，我們穿什麼衣服？"
          }
        },
        {
          "speaker": "female",
          "text": {
            "zh-Hans": "白色上衣、黑色裤子。鞋子没有要求。",
            "zh-Hant": "白色上衣、黑色褲子。鞋子沒有要求。"
          }
        },
        {
          "speaker": "male",
          "text": {
            "zh-Hans": "好，我穿黑裤子和蓝色运动鞋。",
            "zh-Hant": "好，我穿黑褲子和藍色運動鞋。"
          }
        }
      ],
