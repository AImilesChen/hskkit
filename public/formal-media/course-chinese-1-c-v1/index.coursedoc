<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="robots" content="noindex,nofollow"><base href="/api/v1/course-tests/chinese-1/c/file/"><title>Chinese 1 · Paper C · HSKKit</title><link rel="stylesheet" href="workspace.css"></head><body><header class="bar"><a class="brand" href="/">HSKKit</a><a href="/chinese-course-tests">← Chinese 1 papers</a></header><div id="live" class="live" aria-live="polite"></div><div id="clockbar" class="clockbar" hidden><strong id="clock" role="timer"></strong><span id="oral-clock" role="timer"></span></div><div id="audio-dock" class="audio-dock" hidden><strong id="audio-label"></strong><audio id="listening-player" controls preload="metadata"></audio><p id="audio-error" role="alert" hidden>Audio could not load. Retry or open Audio review.</p></div><main id="app"></main><audio id="prompt-player" preload="none"></audio><footer><p>Independent HSKKit course review. Writing and speaking need manual review. Not an official school, HSK or ACTFL assessment.</p><a href="listening.html">Audio review</a> · <a href="teacher.html">Answer guide</a></footer><script id="paper-data" type="application/json">{"id": "course-chinese-1-c-v1", "product": "HSKKit Chinese 1 Course Review", "paperCode": "C", "version": "content-draft-v1", "authoredOn": "2026-11-09", "status": "content_complete_pending_audio_listening_and_teacher_pilot", "officialExam": false, "purpose": "New course-review content using the same Chinese 1 blueprint. No official school credit, ACTFL/HSK conversion or calibrated parallel-form equivalence.", "blueprint": {"id": "course-chinese-1-a-blueprint-v1", "source": "docs/course-level-stage1-20261109/chinese-1-blueprint.json", "sha256": "ac1b916e507d606ed48b308bf1f888f56d60d50dbe3437aa16984a32108d3856", "slotIdMapping": "Keep slot numbers/groups/themes; replace question id -a- with -c-."}, "provenance": {"original": true, "aiAssisted": true, "competitorQuestionsCopied": false, "relabelledHskQuestions": false, "humanListeningAcceptance": false, "teacherReview": false, "learnerPilot": false, "userAcceptance": false, "traditionalScript": "OpenCC s2t and author comparison only; independent editorial review pending"}, "order": ["listening", "reading", "writing", "speaking"], "sections": [{"id": "listening", "seconds": 900, "objectiveItems": 20, "groups": 4, "itemsPerGroup": 5, "sourcePlays": 2}, {"id": "reading", "seconds": 1200, "objectiveItems": 20, "groups": 4, "itemsPerGroup": 5}, {"id": "writing", "seconds": 900, "manualTasks": 2, "sharedClock": true}, {"id": "speaking", "seconds": 600, "manualTasks": 2}], "counts": {"listening": 20, "reading": 20, "writing": 2, "speaking": 2, "speakingRecordings": 5, "topLevelTasks": 44}, "scoring": {"listeningMax": 20, "readingMax": 20, "pointsPerObjectiveItem": 1, "incorrectOrUnansweredPoints": 0, "manualTaskMax": 8, "combinedScore": null, "passCutoff": null, "officialConversion": null, "unsubmittedManual": "unsubmitted", "technicalFailureManual": "needs_rerecording"}, "materials": [{"id": "C1C-M01", "title": "Practising Chinese at home", "section": "listening", "kind": "short-audio", "original": true, "script": [{"speaker": "male", "text": {"zh-Hans": "姐姐的中文很好。每天晚饭后，她陪我练中文。那时妈妈在厨房洗碗，弟弟在客厅看电视，不和我们一起练。", "zh-Hant": "姐姐的中文很好。每天晚飯後，她陪我練中文。那時媽媽在廚房洗碗，弟弟在客廳看電視，不和我們一起練。"}}]}, {"id": "C1C-M02", "title": "Visiting Grandmother", "section": "listening", "kind": "short-audio", "original": true, "script": [{"speaker": "female", "text": {"zh-Hans": "奶奶一个人住在南京。明天我和爸爸坐车去看她，妈妈要工作，不能一起去。我们星期天晚上回来。", "zh-Hant": "奶奶一個人住在南京。明天我和爸爸坐車去看她，媽媽要工作，不能一起去。我們星期天晚上回來。"}}]}, {"id": "C1C-M03", "title": "Preparing a birthday dinner", "section": "listening", "kind": "short-audio", "original": true, "script": [{"speaker": "male", "text": {"zh-Hans": "今天是妈妈的生日。我和爸爸买了一个蛋糕，姐姐准备晚饭。妈妈下班回家以后，我们一起给她唱生日歌。", "zh-Hant": "今天是媽媽的生日。我和爸爸買了一個蛋糕，姐姐準備晚飯。媽媽下班回家以後，我們一起給她唱生日歌。"}}]}, {"id": "C1C-M04", "title": "Where the speaker lives", "section": "listening", "kind": "short-audio", "original": true, "script": [{"speaker": "female", "text": {"zh-Hans": "我现在和爸爸妈妈住在天津。哥哥在上海工作，爷爷奶奶住在北京。我们放假的时候常常去北京看他们。", "zh-Hant": "我現在和爸爸媽媽住在天津。哥哥在上海工作，爺爺奶奶住在北京。我們放假的時候常常去北京看他們。"}}]}, {"id": "C1C-M05", "title": "Monday’s first lesson", "section": "listening", "kind": "short-audio", "original": true, "script": [{"speaker": "male", "text": {"zh-Hans": "星期一上午第一节是数学课，第二节才是中文课。下午有体育课。今天我先把数学书拿出来，中文书还放在书包里。", "zh-Hant": "星期一上午第一節是數學課，第二節纔是中文課。下午有體育課。今天我先把數學書拿出來，中文書還放在書包裏。"}}]}, {"id": "C1C-M06", "title": "Inside the red box", "section": "listening", "kind": "short-audio", "original": true, "script": [{"speaker": "female", "text": {"zh-Hans": "老师，我的橡皮找不到了。", "zh-Hant": "老師，我的橡皮找不到了。"}}, {"speaker": "male", "text": {"zh-Hans": "黑板旁边的红盒子里有橡皮，你拿一块吧。", "zh-Hant": "黑板旁邊的紅盒子裏有橡皮，你拿一塊吧。"}}, {"speaker": "female", "text": {"zh-Hans": "谢谢，我用完以后放回盒子。", "zh-Hant": "謝謝，我用完以後放回盒子。"}}]}, {"id": "C1C-M07", "title": "Where to write answers", "section": "listening", "kind": "short-audio", "original": true, "script": [{"speaker": "male", "text": {"zh-Hans": "老师，今天的答案写在书上吗？", "zh-Hant": "老師，今天的答案寫在書上嗎？"}}, {"speaker": "female", "text": {"zh-Hans": "不要写在书上，写在本子上。写完以后把本子交给我，书先放在桌子上。", "zh-Hant": "不要寫在書上，寫在本子上。寫完以後把本子交給我，書先放在桌子上。"}}]}, {"id": "C1C-M08", "title": "A book with a name", "section": "listening", "kind": "short-audio", "original": true, "script": [{"speaker": "female", "text": {"zh-Hans": "老师，这本书是谁的？不是我的，我的在书包里。", "zh-Hant": "老師，這本書是誰的？不是我的，我的在書包裏。"}}, {"speaker": "male", "text": {"zh-Hans": "我看看，上面写着小陈的名字。请你下课后把书给小陈。", "zh-Hant": "我看看，上面寫着小陳的名字。請你下課後把書給小陳。"}}]}, {"id": "C1C-M09", "title": "Equipment for PE", "section": "listening", "kind": "short-audio", "original": true, "script": [{"speaker": "male", "text": {"zh-Hans": "明天体育课，每人带一瓶水和一条毛巾。不用自己带篮球，学校有。请大家穿运动鞋，准时到操场。", "zh-Hant": "明天體育課，每人帶一瓶水和一條毛巾。不用自己帶籃球，學校有。請大家穿運動鞋，準時到操場。"}}]}, {"id": "C1C-M10", "title": "The end of Chinese class", "section": "listening", "kind": "short-audio", "original": true, "script": [{"speaker": "female", "text": {"zh-Hans": "明天中文课几点下课？", "zh-Hant": "明天中文課幾點下課？"}}, {"speaker": "male", "text": {"zh-Hans": "八点开始，八点四十结束。休息以后，九点上英语课。", "zh-Hant": "八點開始，八點四十結束。休息以後，九點上英語課。"}}, {"speaker": "female", "text": {"zh-Hans": "好，我八点四十来找你。", "zh-Hant": "好，我八點四十來找你。"}}]}, {"id": "C1C-M11", "title": "A bowl of soup", "section": "listening", "kind": "short-audio", "original": true, "script": [{"speaker": "male", "text": {"zh-Hans": "这碗汤已经凉了，能换一碗热的吗？", "zh-Hant": "這碗湯已經涼了，能換一碗熱的嗎？"}}, {"speaker": "female", "text": {"zh-Hans": "可以，我给您换热汤。", "zh-Hant": "可以，我給您換熱湯。"}}, {"speaker": "male", "text": {"zh-Hans": "谢谢，天气有点儿冷，我想喝热的。", "zh-Hant": "謝謝，天氣有點兒冷，我想喝熱的。"}}]}, {"id": "C1C-M12", "title": "Lunch to take home", "section": "listening", "kind": "short-audio", "original": true, "script": [{"speaker": "female", "text": {"zh-Hans": "这份午饭在这儿吃吗？", "zh-Hant": "這份午飯在這兒喫嗎？"}}, {"speaker": "male", "text": {"zh-Hans": "不，我要带回家吃。家里还有人在等我。请帮我装好，筷子我家里有，不用给了。", "zh-Hant": "不，我要帶回家喫。家裏還有人在等我。請幫我裝好，筷子我家裏有，不用給了。"}}]}, {"id": "C1C-M13", "title": "Different fruit preferences", "section": "listening", "kind": "short-audio", "original": true, "script": [{"speaker": "female", "text": {"zh-Hans": "妈妈喜欢吃西瓜，爸爸喜欢苹果。我最喜欢橙子。今天我给他们买西瓜和苹果，也给自己买了几个橙子。", "zh-Hant": "媽媽喜歡喫西瓜，爸爸喜歡蘋果。我最喜歡橙子。今天我給他們買西瓜和蘋果，也給自己買了幾個橙子。"}}]}, {"id": "C1C-M14", "title": "A complete order price", "section": "listening", "kind": "short-audio", "original": true, "script": [{"speaker": "male", "text": {"zh-Hans": "面条八块，加一个鸡蛋一共多少钱？", "zh-Hant": "麪條八塊，加一個雞蛋一共多少錢？"}}, {"speaker": "female", "text": {"zh-Hans": "一共十块。", "zh-Hant": "一共十塊。"}}, {"speaker": "male", "text": {"zh-Hans": "好，我给你十块。", "zh-Hant": "好，我給你十塊。"}}, {"speaker": "female", "text": {"zh-Hans": "谢谢，请在旁边等一下。", "zh-Hant": "謝謝，請在旁邊等一下。"}}]}, {"id": "C1C-M15", "title": "Trying a different size", "section": "listening", "kind": "short-audio", "original": true, "script": [{"speaker": "female", "text": {"zh-Hans": "这件小号上衣有点儿小。能试试中号吗？", "zh-Hant": "這件小號上衣有點兒小。能試試中號嗎？"}}, {"speaker": "male", "text": {"zh-Hans": "可以，这里有中号和大号。", "zh-Hant": "可以，這裏有中號和大號。"}}, {"speaker": "female", "text": {"zh-Hans": "中号正好，我就要中号的。", "zh-Hant": "中號正好，我就要中號的。"}}]}, {"id": "C1C-M16", "title": "Meeting a little earlier", "section": "listening", "kind": "short-audio", "original": true, "script": [{"speaker": "male", "text": {"zh-Hans": "我们下午三点见，好吗？", "zh-Hant": "我們下午三點見，好嗎？"}}, {"speaker": "female", "text": {"zh-Hans": "我两点半就到了，可以早一点见吗？", "zh-Hant": "我兩點半就到了，可以早一點見嗎？"}}, {"speaker": "male", "text": {"zh-Hans": "可以，那我们两点半见，我也早点出门。", "zh-Hant": "可以，那我們兩點半見，我也早點出門。"}}]}, {"id": "C1C-M17", "title": "Catching a bus", "section": "listening", "kind": "short-audio", "original": true, "script": [{"speaker": "female", "text": {"zh-Hans": "这班车九点开。我们八点半从家里出发，八点四十到车站。到了以后先买票，再一起等车。", "zh-Hant": "這班車九點開。我們八點半從家裏出發，八點四十到車站。到了以後先買票，再一起等車。"}}]}, {"id": "C1C-M18", "title": "Clothes for an activity", "section": "listening", "kind": "short-audio", "original": true, "script": [{"speaker": "male", "text": {"zh-Hans": "明天学校活动，我们穿什么衣服？", "zh-Hant": "明天學校活動，我們穿什麼衣服？"}}, {"speaker": "female", "text": {"zh-Hans": "白色上衣、黑色裤子。鞋子没有要求。", "zh-Hant": "白色上衣、黑色褲子。鞋子沒有要求。"}}, {"speaker": "male", "text": {"zh-Hans": "好，我穿黑裤子和蓝色运动鞋。", "zh-Hant": "好，我穿黑褲子和藍色運動鞋。"}}]}, {"id": "C1C-M19", "title": "What the speaker can do", "section": "listening", "kind": "short-audio", "original": true, "script": [{"speaker": "male", "text": {"zh-Hans": "姐姐很会唱歌，弟弟喜欢画画。我不会唱歌，可是会弹钢琴。周六下午，我们想一起给爸爸妈妈表演。", "zh-Hant": "姐姐很會唱歌，弟弟喜歡畫畫。我不會唱歌，可是會彈鋼琴。週六下午，我們想一起給爸爸媽媽表演。"}}]}, {"id": "C1C-M20", "title": "Today’s choice", "section": "listening", "kind": "short-audio", "original": true, "script": [{"speaker": "female", "text": {"zh-Hans": "今天放学后一起去游泳吗？", "zh-Hant": "今天放學後一起去游泳嗎？"}}, {"speaker": "male", "text": {"zh-Hans": "今天我不去游泳，我想在家看书。明天再去游泳。", "zh-Hant": "今天我不去游泳，我想在家看書。明天再去游泳。"}}, {"speaker": "female", "text": {"zh-Hans": "好，那我们明天下午见。", "zh-Hant": "好，那我們明天下午見。"}}]}, {"id": "C1C-M21", "title": "A nickname among friends", "section": "reading", "kind": "text-card", "original": true, "text": {"zh-Hans": "我叫陈乐。老师在学校叫我陈乐，朋友们喜欢叫我“小树”。我喜欢在树下看书，也喜欢和朋友打球。", "zh-Hant": "我叫陳樂。老師在學校叫我陳樂，朋友們喜歡叫我“小樹”。我喜歡在樹下看書，也喜歡和朋友打球。"}}, {"id": "C1C-M22", "title": "Helping after dinner", "section": "reading", "kind": "text-card", "original": true, "text": {"zh-Hans": "我叫小米。每天晚饭后，爷爷把桌子擦干净，我去洗碗，姐姐把椅子放好。妈妈说，大家一起做就很快。", "zh-Hant": "我叫小米。每天晚飯後，爺爺把桌子擦乾淨，我去洗碗，姐姐把椅子放好。媽媽說，大家一起做就很快。"}}, {"id": "C1C-M23", "title": "A short family letter", "section": "reading", "kind": "text-card", "original": true, "text": {"zh-Hans": "奶奶您好：\n谢谢您送我的书。我每天晚上都看。星期天我和妈妈去您家吃午饭，想听您讲以前的故事。\n孙女 小雨", "zh-Hant": "奶奶您好：\n謝謝您送我的書。我每天晚上都看。星期天我和媽媽去您家喫午飯，想聽您講以前的故事。\n孫女 小雨"}}, {"id": "C1C-M24", "title": "School in the family", "section": "reading", "kind": "text-card", "original": true, "text": {"zh-Hans": "我们家三个孩子。哥哥在大学读书，我在湖光学校上学。妹妹还没上学，每天和奶奶在家。明年她也要去学校了。", "zh-Hant": "我們家三個孩子。哥哥在大學讀書，我在湖光學校上學。妹妹還沒上學，每天和奶奶在家。明年她也要去學校了。"}}, {"id": "C1C-M25", "title": "Tuesday’s Chinese teacher", "section": "reading", "kind": "text-card", "original": true, "text": {"zh-Hans": "班级通知\n王老师星期二请假。那天林老师来上中文课，时间和教室不变。星期三王老师回来。请同学们带好中文书。", "zh-Hant": "班級通知\n王老師星期二請假。那天林老師來上中文課，時間和教室不變。星期三王老師回來。請同學們帶好中文書。"}}, {"id": "C1C-M26", "title": "Handing in homework", "section": "reading", "kind": "text-card", "original": true, "text": {"zh-Hans": "同学们：\n星期三上课前，请把作业本交给小何。小何收好以后送到老师办公室。小林负责拿新本子。不要把作业放在讲台上。", "zh-Hant": "同學們：\n星期三上課前，請把作業本交給小何。小何收好以後送到老師辦公室。小林負責拿新本子。不要把作業放在講臺上。"}}, {"id": "C1C-M27", "title": "Directions from the school gate", "section": "reading", "kind": "text-card", "original": true, "text": {"zh-Hans": "从学校大门往前看：\n左边是食堂，右边是办公室，大门对面是图书馆。图书馆后面是教室，新同学请先到办公室。", "zh-Hant": "從學校大門往前看：\n左邊是食堂，右邊是辦公室，大門對面是圖書館。圖書館後面是教室，新同學請先到辦公室。"}}, {"id": "C1C-M28", "title": "Reading-room rules", "section": "reading", "kind": "text-card", "original": true, "text": {"zh-Hans": "阅览室小提示\n这里可以安静看书，不可以吃东西，也不要大声说话。手机请关声音，放进包里。出去吃完东西以后可以再进来。", "zh-Hant": "閱覽室小提示\n這裏可以安靜看書，不可以喫東西，也不要大聲說話。手機請關聲音，放進包裏。出去喫完東西以後可以再進來。"}}, {"id": "C1C-M29", "title": "Belongings left in class", "section": "reading", "kind": "text-card", "original": true, "text": {"zh-Hans": "放学后留下的东西\n蓝帽子：小林。\n红书包：小何。\n黑外套：小康。\n都放在老师桌子下面，请明天来拿。", "zh-Hant": "放學後留下的東西\n藍帽子：小林。\n紅書包：小何。\n黑外套：小康。\n都放在老師桌子下面，請明天來拿。"}}, {"id": "C1C-M30", "title": "After-school weekly activities", "section": "reading", "kind": "text-card", "original": true, "text": {"zh-Hans": "本周放学后的安排\n周一15:00：画画。\n周四15:30：唱歌。\n周五14:00：看书。\n每次活动一个小时，请提前五分钟到。", "zh-Hant": "本週放學後的安排\n週一15:00：畫畫。\n週四15:30：唱歌。\n週五14:00：看書。\n每次活動一個小時，請提前五分鐘到。"}}, {"id": "C1C-M31", "title": "Choosing a set meal", "section": "reading", "kind": "text-card", "original": true, "text": {"zh-Hans": "今日午饭\n一号：米饭和青菜。\n二号：面条和牛肉。\n三号：包子和鸡肉。\n每份都有一杯热水，请先选好再点餐。", "zh-Hant": "今日午飯\n一號：米飯和青菜。\n二號：麪條和牛肉。\n三號：包子和雞肉。\n每份都有一杯熱水，請先選好再點餐。"}}, {"id": "C1C-M32", "title": "What the family needs", "section": "reading", "kind": "text-card", "original": true, "text": {"zh-Hans": "小陆：\n家里的茶还有很多，水也够。牛奶已经喝完了，请今天买两盒牛奶回来。不要买别的饮料。\n妈妈", "zh-Hant": "小陸：\n家裏的茶還有很多，水也夠。牛奶已經喝完了，請今天買兩盒牛奶回來。不要買別的飲料。\n媽媽"}}, {"id": "C1C-M33", "title": "Breakfast and lunch hours", "section": "reading", "kind": "text-card", "original": true, "text": {"zh-Hans": "小店营业时间\n早餐：早上七点到九点半。\n午饭：上午十一点开始。\n九点半到十一点不卖饭，只卖水。周日不开门。", "zh-Hant": "小店營業時間\n早餐：早上七點到九點半。\n午飯：上午十一點開始。\n九點半到十一點不賣飯，只賣水。週日不開門。"}}, {"id": "C1C-M34", "title": "Collecting the order", "section": "reading", "kind": "text-card", "original": true, "text": {"zh-Hans": "取餐提示\n一号窗口取米饭，二号窗口取面条，三号窗口取饮料。热茶和牛奶也在三号窗口，请带好小票。", "zh-Hant": "取餐提示\n一號窗口取米飯，二號窗口取麪條，三號窗口取飲料。熱茶和牛奶也在三號窗口，請帶好小票。"}}, {"id": "C1C-M35", "title": "Packing clothes for a visit", "section": "reading", "kind": "text-card", "original": true, "text": {"zh-Hans": "去奶奶家住两天\n请带：上衣两件，裤子一条，袜子三双。\n奶奶家有毛巾，不用带。把干净衣服放在蓝色包里。", "zh-Hant": "去奶奶家住兩天\n請帶：上衣兩件，褲子一條，襪子三雙。\n奶奶家有毛巾，不用帶。把乾淨衣服放在藍色包裏。"}}, {"id": "C1C-M36", "title": "A replacement cinema ticket", "section": "reading", "kind": "text-card", "original": true, "text": {"zh-Hans": "周六看电影\n旧票：下午四点开始。\n新票：下午五点开始，四点半可以进去。\n小田说：请带新票，别拿旧票。地点没有变。", "zh-Hant": "週六看電影\n舊票：下午四點開始。\n新票：下午五點開始，四點半可以進去。\n小田說：請帶新票，別拿舊票。地點沒有變。"}}, {"id": "C1C-M37", "title": "Sunday morning", "section": "reading", "kind": "text-card", "original": true, "text": {"zh-Hans": "我平时六点半起床，七点吃早饭。星期天不用上学，我八点才起床，八点半和爸爸一起吃早饭，然后看书。", "zh-Hant": "我平時六點半起牀，七點喫早飯。星期天不用上學，我八點才起牀，八點半和爸爸一起喫早飯，然後看書。"}}, {"id": "C1C-M38", "title": "Clothes for different activities", "section": "reading", "kind": "text-card", "original": true, "text": {"zh-Hans": "本周穿衣提示\n周二体育课：运动鞋。\n周三唱歌表演：黑色皮鞋。\n老师说，鞋子要干净，别把两天的安排记错。", "zh-Hant": "本週穿衣提示\n週二體育課：運動鞋。\n週三唱歌表演：黑色皮鞋。\n老師說，鞋子要乾淨，別把兩天的安排記錯。"}}, {"id": "C1C-M39", "title": "A rainy-day change", "section": "reading", "kind": "text-card", "original": true, "text": {"zh-Hans": "周日活动改了：\n因为下雨，不去公园打篮球了。我们下午三点在小方家听音乐。时间不变，想来的朋友请给小方发消息。", "zh-Hant": "週日活動改了：\n因爲下雨，不去公園打籃球了。我們下午三點在小方家聽音樂。時間不變，想來的朋友請給小方發消息。"}}, {"id": "C1C-M40", "title": "Preparing for a drawing group", "section": "reading", "kind": "text-card", "original": true, "text": {"zh-Hans": "画画小组\n周六上午九点在公园见。请自己带纸和笔，老师带颜色。画完后大家可以看别人的画，不用准备食物。", "zh-Hant": "畫畫小組\n週六上午九點在公園見。請自己帶紙和筆，老師帶顏色。畫完後大家可以看別人的畫，不用準備食物。"}}], "questions": [{"id": "course-zh1-c-q01", "number": 1, "section": "listening", "group": "L1", "theme": "identity", "materialId": "C1C-M01", "target": "Identify a family member’s role in a familiar routine.", "promptEn": "Who helps the speaker practise Chinese?", "options": {"A": {"zh-Hans": "姐姐", "zh-Hant": "姐姐"}, "B": {"zh-Hans": "弟弟", "zh-Hant": "弟弟"}, "C": {"zh-Hans": "妈妈", "zh-Hant": "媽媽"}}, "correctAnswer": "A", "evidence": {"materialId": "C1C-M01", "quote": {"zh-Hans": "每天晚饭后，她陪我练中文", "zh-Hant": "每天晚飯後，她陪我練中文"}}, "explanation": {"en": "The older sister practises Chinese with the speaker.", "zh": "姐姐晚饭后陪说话者练中文。"}, "distractors": {"B": {"en": "The younger brother watches television and does not join them.", "zh": "弟弟看电视，不和他们一起练。"}, "C": {"en": "The mother is washing dishes, not practising with the speaker.", "zh": "妈妈在厨房洗碗，没有陪说话者练中文。"}}, "reviewStatus": "author_self_checked_pending_teacher_and_user_review"}, {"id": "course-zh1-c-q02", "number": 2, "section": "listening", "group": "L1", "theme": "identity", "materialId": "C1C-M02", "target": "Identify the companion for a family visit.", "promptEn": "Who will go with the speaker to visit Grandmother?", "options": {"A": {"zh-Hans": "妈妈", "zh-Hant": "媽媽"}, "B": {"zh-Hans": "爷爷", "zh-Hant": "爺爺"}, "C": {"zh-Hans": "爸爸", "zh-Hant": "爸爸"}}, "correctAnswer": "C", "evidence": {"materialId": "C1C-M02", "quote": {"zh-Hans": "明天我和爸爸坐车去看她", "zh-Hant": "明天我和爸爸坐車去看她"}}, "explanation": {"en": "The speaker explicitly travels with Dad.", "zh": "说话者明确说和爸爸一起去。"}, "distractors": {"A": {"en": "The mother has work and cannot go.", "zh": "妈妈要工作，不能一起去。"}, "B": {"en": "The grandfather is not described as going.", "zh": "材料没有说爷爷同行。"}}, "reviewStatus": "author_self_checked_pending_teacher_and_user_review"}, {"id": "course-zh1-c-q03", "number": 3, "section": "listening", "group": "L1", "theme": "identity", "materialId": "C1C-M03", "target": "Distinguish a birthday person from other family participants.", "promptEn": "Whose birthday is it today?", "options": {"A": {"zh-Hans": "姐姐", "zh-Hant": "姐姐"}, "B": {"zh-Hans": "妈妈", "zh-Hant": "媽媽"}, "C": {"zh-Hans": "爸爸", "zh-Hant": "爸爸"}}, "correctAnswer": "B", "evidence": {"materialId": "C1C-M03", "quote": {"zh-Hans": "今天是妈妈的生日", "zh-Hant": "今天是媽媽的生日"}}, "explanation": {"en": "The opening sentence states that today is Mum’s birthday.", "zh": "开头直接说明今天是妈妈生日。"}, "distractors": {"A": {"en": "The sister prepares dinner; it is not her birthday.", "zh": "姐姐准备晚饭，今天不是她的生日。"}, "C": {"en": "Dad helps buy the cake but is not the birthday person.", "zh": "爸爸帮忙买蛋糕，不是过生日的人。"}}, "reviewStatus": "author_self_checked_pending_teacher_and_user_review"}, {"id": "course-zh1-c-q04", "number": 4, "section": "listening", "group": "L1", "theme": "identity", "materialId": "C1C-M04", "target": "Separate the speaker’s home city from relatives’ cities.", "promptEn": "In which city does the speaker live now?", "options": {"A": {"zh-Hans": "上海", "zh-Hant": "上海"}, "B": {"zh-Hans": "北京", "zh-Hant": "北京"}, "C": {"zh-Hans": "天津", "zh-Hant": "天津"}}, "correctAnswer": "C", "evidence": {"materialId": "C1C-M04", "quote": {"zh-Hans": "我现在和爸爸妈妈住在天津", "zh-Hant": "我現在和爸爸媽媽住在天津"}}, "explanation": {"en": "The speaker lives with the parents in Tianjin.", "zh": "说话者现在与父母住在天津。"}, "distractors": {"A": {"en": "The older brother works in Shanghai.", "zh": "上海是哥哥工作的城市。"}, "B": {"en": "The grandparents live in Beijing.", "zh": "爷爷奶奶住在北京。"}}, "reviewStatus": "author_self_checked_pending_teacher_and_user_review"}, {"id": "course-zh1-c-q05", "number": 5, "section": "listening", "group": "L1", "theme": "school", "materialId": "C1C-M05", "target": "Read the order of school subjects from a spoken plan.", "promptEn": "Which subject is the FIRST lesson on Monday?", "options": {"A": {"zh-Hans": "数学", "zh-Hant": "數學"}, "B": {"zh-Hans": "中文", "zh-Hant": "中文"}, "C": {"zh-Hans": "体育", "zh-Hant": "體育"}}, "correctAnswer": "A", "evidence": {"materialId": "C1C-M05", "quote": {"zh-Hans": "第一节是数学课", "zh-Hant": "第一節是數學課"}}, "explanation": {"en": "Mathematics is explicitly the first lesson.", "zh": "原文明确说第一节是数学课。"}, "distractors": {"B": {"en": "Chinese is the second lesson.", "zh": "中文是第二节课。"}, "C": {"en": "PE takes place in the afternoon, not first.", "zh": "体育课在下午，不是上午第一节。"}}, "reviewStatus": "author_self_checked_pending_teacher_and_user_review"}, {"id": "course-zh1-c-q06", "number": 6, "section": "listening", "group": "L2", "theme": "school", "materialId": "C1C-M06", "target": "Identify a classroom object in a spoken location description.", "promptEn": "What is in the red box?", "options": {"A": {"zh-Hans": "铅笔", "zh-Hant": "鉛筆"}, "B": {"zh-Hans": "橡皮", "zh-Hant": "橡皮"}, "C": {"zh-Hans": "尺子", "zh-Hant": "尺子"}}, "correctAnswer": "B", "evidence": {"materialId": "C1C-M06", "quote": {"zh-Hans": "红盒子里有橡皮", "zh-Hant": "紅盒子裏有橡皮"}}, "explanation": {"en": "The teacher says the red box contains erasers.", "zh": "老师说明红盒子里有橡皮。"}, "distractors": {"A": {"en": "The box is not described as containing pencils.", "zh": "老师没有说红盒子里有铅笔。"}, "C": {"en": "No ruler is mentioned as being in the box.", "zh": "老师没有提到盒子里有尺子。"}}, "reviewStatus": "author_self_checked_pending_teacher_and_user_review"}, {"id": "course-zh1-c-q07", "number": 7, "section": "listening", "group": "L2", "theme": "school", "materialId": "C1C-M07", "target": "Follow a classroom instruction and its explicit correction.", "promptEn": "Where should the student write the answers?", "options": {"A": {"zh-Hans": "书上", "zh-Hant": "書上"}, "B": {"zh-Hans": "黑板上", "zh-Hant": "黑板上"}, "C": {"zh-Hans": "本子上", "zh-Hant": "本子上"}}, "correctAnswer": "C", "evidence": {"materialId": "C1C-M07", "quote": {"zh-Hans": "写在本子上", "zh-Hant": "寫在本子上"}}, "explanation": {"en": "The answers should be written in the notebook.", "zh": "老师让学生写在本子上。"}, "distractors": {"A": {"en": "The teacher explicitly says not to write in the book.", "zh": "老师明确说不要写在书上。"}, "B": {"en": "The board is not the requested writing surface.", "zh": "老师没有要求写在黑板上。"}}, "reviewStatus": "author_self_checked_pending_teacher_and_user_review"}, {"id": "course-zh1-c-q08", "number": 8, "section": "listening", "group": "L2", "theme": "school", "materialId": "C1C-M08", "target": "Use a spoken name label to identify ownership.", "promptEn": "Whose book has been found?", "options": {"A": {"zh-Hans": "小陈", "zh-Hant": "小陳"}, "B": {"zh-Hans": "老师", "zh-Hant": "老師"}, "C": {"zh-Hans": "女同学", "zh-Hant": "女同學"}}, "correctAnswer": "A", "evidence": {"materialId": "C1C-M08", "quote": {"zh-Hans": "上面写着小陈的名字", "zh-Hant": "上面寫着小陳的名字"}}, "explanation": {"en": "The name on the book is Xiao Chen’s.", "zh": "书上写着小陈的名字。"}, "distractors": {"B": {"en": "The teacher checks the book but does not own it.", "zh": "老师只是查看书，没有说是老师的。"}, "C": {"en": "The girl explicitly says it is not her book.", "zh": "女生明确说这本不是自己的书。"}}, "reviewStatus": "author_self_checked_pending_teacher_and_user_review"}, {"id": "course-zh1-c-q09", "number": 9, "section": "listening", "group": "L2", "theme": "school", "materialId": "C1C-M09", "target": "Identify an exception in a short school equipment list.", "promptEn": "Which item do students NOT need to bring themselves?", "options": {"A": {"zh-Hans": "水", "zh-Hant": "水"}, "B": {"zh-Hans": "篮球", "zh-Hant": "籃球"}, "C": {"zh-Hans": "毛巾", "zh-Hant": "毛巾"}}, "correctAnswer": "B", "evidence": {"materialId": "C1C-M09", "quote": {"zh-Hans": "不用自己带篮球，学校有", "zh-Hant": "不用自己帶籃球，學校有"}}, "explanation": {"en": "The school has basketballs, so students need not bring their own.", "zh": "学校有篮球，因此学生不用自带。"}, "distractors": {"A": {"en": "Each student is asked to bring a bottle of water.", "zh": "老师要求每人带一瓶水。"}, "C": {"en": "Each student is asked to bring a towel.", "zh": "老师要求每人带一条毛巾。"}}, "reviewStatus": "author_self_checked_pending_teacher_and_user_review"}, {"id": "course-zh1-c-q10", "number": 10, "section": "listening", "group": "L2", "theme": "schedule", "materialId": "C1C-M10", "target": "Distinguish a lesson’s end from its start and the next lesson.", "promptEn": "When does the Chinese lesson END?", "options": {"A": {"zh-Hans": "八点", "zh-Hant": "八點"}, "B": {"zh-Hans": "九点", "zh-Hant": "九點"}, "C": {"zh-Hans": "八点四十", "zh-Hant": "八點四十"}}, "correctAnswer": "C", "evidence": {"materialId": "C1C-M10", "quote": {"zh-Hans": "八点四十结束", "zh-Hant": "八點四十結束"}}, "explanation": {"en": "Chinese ends at eight forty.", "zh": "中文课八点四十结束。"}, "distractors": {"A": {"en": "Eight is when Chinese begins.", "zh": "八点是中文课开始时间。"}, "B": {"en": "Nine is when English begins.", "zh": "九点是英语课开始时间。"}}, "reviewStatus": "author_self_checked_pending_teacher_and_user_review"}, {"id": "course-zh1-c-q11", "number": 11, "section": "listening", "group": "L3", "theme": "food", "materialId": "C1C-M11", "target": "Understand a simple request to change food temperature.", "promptEn": "What does the customer ask for?", "options": {"A": {"zh-Hans": "热汤", "zh-Hant": "熱湯"}, "B": {"zh-Hans": "凉汤", "zh-Hant": "涼湯"}, "C": {"zh-Hans": "冷水", "zh-Hant": "冷水"}}, "correctAnswer": "A", "evidence": {"materialId": "C1C-M11", "quote": {"zh-Hans": "能换一碗热的吗", "zh-Hant": "能換一碗熱的嗎"}}, "explanation": {"en": "The customer asks to replace the cool soup with hot soup.", "zh": "顾客要求把凉汤换成热汤。"}, "distractors": {"B": {"en": "The cool soup is what the customer wants to replace.", "zh": "凉汤是顾客不想继续喝的。"}, "C": {"en": "Cold water is not requested.", "zh": "顾客没有要求冷水。"}}, "reviewStatus": "author_self_checked_pending_teacher_and_user_review"}, {"id": "course-zh1-c-q12", "number": 12, "section": "listening", "group": "L3", "theme": "food", "materialId": "C1C-M12", "target": "Identify the eating location in a take-away request.", "promptEn": "Where will the customer eat the lunch?", "options": {"A": {"zh-Hans": "店里", "zh-Hant": "店裏"}, "B": {"zh-Hans": "家里", "zh-Hant": "家裏"}, "C": {"zh-Hans": "学校", "zh-Hant": "學校"}}, "correctAnswer": "B", "evidence": {"materialId": "C1C-M12", "quote": {"zh-Hans": "我要带回家吃", "zh-Hant": "我要帶回家喫"}}, "explanation": {"en": "The customer will take the meal home to eat.", "zh": "顾客要带回家吃。"}, "distractors": {"A": {"en": "The customer explicitly declines eating here.", "zh": "顾客明确说不在这里吃。"}, "C": {"en": "Eating at school is not part of the stated plan.", "zh": "顾客没有说去学校吃。"}}, "reviewStatus": "author_self_checked_pending_teacher_and_user_review"}, {"id": "course-zh1-c-q13", "number": 13, "section": "listening", "group": "L3", "theme": "food", "materialId": "C1C-M13", "target": "Separate a speaker’s own choice from family members’ choices.", "promptEn": "Which fruit does the speaker buy for herself?", "options": {"A": {"zh-Hans": "西瓜", "zh-Hant": "西瓜"}, "B": {"zh-Hans": "苹果", "zh-Hant": "蘋果"}, "C": {"zh-Hans": "橙子", "zh-Hant": "橙子"}}, "correctAnswer": "C", "evidence": {"materialId": "C1C-M13", "quote": {"zh-Hans": "也给自己买了几个橙子", "zh-Hant": "也給自己買了幾個橙子"}}, "explanation": {"en": "The speaker buys oranges for herself.", "zh": "说话者给自己买橙子。"}, "distractors": {"A": {"en": "Watermelon is for Mum.", "zh": "西瓜是给妈妈买的。"}, "B": {"en": "Apples are for Dad.", "zh": "苹果是给爸爸买的。"}}, "reviewStatus": "author_self_checked_pending_teacher_and_user_review"}, {"id": "course-zh1-c-q14", "number": 14, "section": "listening", "group": "L3", "theme": "food", "materialId": "C1C-M14", "target": "Identify a stated total without needing to calculate it.", "promptEn": "What is the TOTAL price including the egg?", "options": {"A": {"zh-Hans": "十块", "zh-Hant": "十塊"}, "B": {"zh-Hans": "八块", "zh-Hant": "八塊"}, "C": {"zh-Hans": "两块", "zh-Hant": "兩塊"}}, "correctAnswer": "A", "evidence": {"materialId": "C1C-M14", "quote": {"zh-Hans": "一共十块", "zh-Hant": "一共十塊"}}, "explanation": {"en": "The seller explicitly gives the total as ten.", "zh": "卖家直接说一共十块。"}, "distractors": {"B": {"en": "Eight is the noodles-only price.", "zh": "八块只是面条的价格。"}, "C": {"en": "Two is not stated as the total.", "zh": "两块不是对话给出的总价。"}}, "reviewStatus": "author_self_checked_pending_teacher_and_user_review"}, {"id": "course-zh1-c-q15", "number": 15, "section": "listening", "group": "L3", "theme": "clothing", "materialId": "C1C-M15", "target": "Follow a clothing-size change through to the final choice.", "promptEn": "Which size does the customer finally choose?", "options": {"A": {"zh-Hans": "小号", "zh-Hant": "小號"}, "B": {"zh-Hans": "中号", "zh-Hant": "中號"}, "C": {"zh-Hans": "大号", "zh-Hant": "大號"}}, "correctAnswer": "B", "evidence": {"materialId": "C1C-M15", "quote": {"zh-Hans": "中号正好，我就要中号的", "zh-Hant": "中號正好，我就要中號的"}}, "explanation": {"en": "The medium size fits and is selected.", "zh": "顾客说中号正好，决定要中号。"}, "distractors": {"A": {"en": "The small size is too small.", "zh": "小号上衣有点小，顾客没有选它。"}, "C": {"en": "Large is offered but not chosen.", "zh": "店员提供大号，但顾客没有选择。"}}, "reviewStatus": "author_self_checked_pending_teacher_and_user_review"}, {"id": "course-zh1-c-q16", "number": 16, "section": "listening", "group": "L4", "theme": "schedule", "materialId": "C1C-M16", "target": "Identify the final time after an explicitly agreed change.", "promptEn": "What is the FINAL meeting time?", "options": {"A": {"zh-Hans": "下午三点", "zh-Hant": "下午三點"}, "B": {"zh-Hans": "下午三点半", "zh-Hant": "下午三點半"}, "C": {"zh-Hans": "下午两点半", "zh-Hant": "下午兩點半"}}, "correctAnswer": "C", "evidence": {"materialId": "C1C-M16", "quote": {"zh-Hans": "那我们两点半见", "zh-Hant": "那我們兩點半見"}}, "explanation": {"en": "Both agree to the earlier time, two thirty.", "zh": "两人最后同意两点半见。"}, "distractors": {"A": {"en": "Three is the original proposal, later changed.", "zh": "三点是最初建议，后来改变了。"}, "B": {"en": "Three thirty is not suggested.", "zh": "双方没有提出三点半。"}}, "reviewStatus": "author_self_checked_pending_teacher_and_user_review"}, {"id": "course-zh1-c-q17", "number": 17, "section": "listening", "group": "L4", "theme": "schedule", "materialId": "C1C-M17", "target": "Separate vehicle departure from personal departure and arrival.", "promptEn": "When does the BUS leave?", "options": {"A": {"zh-Hans": "九点", "zh-Hant": "九點"}, "B": {"zh-Hans": "八点半", "zh-Hant": "八點半"}, "C": {"zh-Hans": "八点四十", "zh-Hant": "八點四十"}}, "correctAnswer": "A", "evidence": {"materialId": "C1C-M17", "quote": {"zh-Hans": "这班车九点开", "zh-Hant": "這班車九點開"}}, "explanation": {"en": "Nine is the stated bus departure time.", "zh": "九点是车开出的时间。"}, "distractors": {"B": {"en": "Eight thirty is when they leave home.", "zh": "八点半是从家里出发的时间。"}, "C": {"en": "Eight forty is when they reach the station.", "zh": "八点四十是到车站的时间。"}}, "reviewStatus": "author_self_checked_pending_teacher_and_user_review"}, {"id": "course-zh1-c-q18", "number": 18, "section": "listening", "group": "L4", "theme": "clothing", "materialId": "C1C-M18", "target": "Match a color to the correct clothing item.", "promptEn": "What color should the TROUSERS be?", "options": {"A": {"zh-Hans": "白色", "zh-Hant": "白色"}, "B": {"zh-Hans": "黑色", "zh-Hant": "黑色"}, "C": {"zh-Hans": "蓝色", "zh-Hant": "藍色"}}, "correctAnswer": "B", "evidence": {"materialId": "C1C-M18", "quote": {"zh-Hans": "白色上衣、黑色裤子", "zh-Hant": "白色上衣、黑色褲子"}}, "explanation": {"en": "The trousers should be black.", "zh": "裤子要求是黑色。"}, "distractors": {"A": {"en": "White is required for the top.", "zh": "白色是上衣的颜色要求。"}, "C": {"en": "Blue describes the boy’s shoes, not the trousers.", "zh": "蓝色指男生的鞋，不是裤子。"}}, "reviewStatus": "author_self_checked_pending_teacher_and_user_review"}, {"id": "course-zh1-c-q19", "number": 19, "section": "listening", "group": "L4", "theme": "leisure", "materialId": "C1C-M19", "target": "Distinguish a speaker’s ability from relatives’ interests.", "promptEn": "What can the speaker do?", "options": {"A": {"zh-Hans": "弹钢琴", "zh-Hant": "彈鋼琴"}, "B": {"zh-Hans": "唱歌", "zh-Hant": "唱歌"}, "C": {"zh-Hans": "画画", "zh-Hant": "畫畫"}}, "correctAnswer": "A", "evidence": {"materialId": "C1C-M19", "quote": {"zh-Hans": "可是会弹钢琴", "zh-Hant": "可是會彈鋼琴"}}, "explanation": {"en": "The speaker says he can play the piano.", "zh": "说话者说自己会弹钢琴。"}, "distractors": {"B": {"en": "The sister can sing; the speaker says he cannot.", "zh": "姐姐会唱歌，说话者说自己不会。"}, "C": {"en": "Drawing is the younger brother’s interest.", "zh": "画画是弟弟的爱好。"}}, "reviewStatus": "author_self_checked_pending_teacher_and_user_review"}, {"id": "course-zh1-c-q20", "number": 20, "section": "listening", "group": "L4", "theme": "leisure", "materialId": "C1C-M20", "target": "Distinguish today’s activity from tomorrow’s plan.", "promptEn": "What will the boy do TODAY after school?", "options": {"A": {"zh-Hans": "游泳", "zh-Hant": "游泳"}, "B": {"zh-Hans": "跳舞", "zh-Hant": "跳舞"}, "C": {"zh-Hans": "看书", "zh-Hant": "看書"}}, "correctAnswer": "C", "evidence": {"materialId": "C1C-M20", "quote": {"zh-Hans": "今天我不去游泳，我想在家看书", "zh-Hant": "今天我不去游泳，我想在家看書"}}, "explanation": {"en": "Today he plans to read at home.", "zh": "他今天想在家看书。"}, "distractors": {"A": {"en": "Swimming is planned for tomorrow.", "zh": "游泳安排在明天。"}, "B": {"en": "Dancing is not in the plan.", "zh": "对话没有安排跳舞。"}}, "reviewStatus": "author_self_checked_pending_teacher_and_user_review"}, {"id": "course-zh1-c-q21", "number": 21, "section": "reading", "group": "R1", "theme": "identity", "materialId": "C1C-M21", "target": "Distinguish a friend-used nickname from a full name.", "promptEn": "What do the writer’s FRIENDS call the writer?", "options": {"A": {"zh-Hans": "小陈", "zh-Hant": "小陳"}, "B": {"zh-Hans": "陈乐", "zh-Hant": "陳樂"}, "C": {"zh-Hans": "小树", "zh-Hant": "小樹"}}, "correctAnswer": "C", "evidence": {"materialId": "C1C-M21", "quote": {"zh-Hans": "朋友们喜欢叫我“小树”", "zh-Hant": "朋友們喜歡叫我“小樹”"}}, "explanation": {"en": "The friends call the writer Xiaoshu.", "zh": "朋友们喜欢叫作者小树。"}, "distractors": {"A": {"en": "Xiao Chen is not the nickname given.", "zh": "原文没有给出小陈这个称呼。"}, "B": {"en": "The teachers use the full name; the stated friends’ nickname differs.", "zh": "老师使用陈乐这个姓名，朋友的称呼不同。"}}, "reviewStatus": "author_self_checked_pending_teacher_and_user_review"}, {"id": "course-zh1-c-q22", "number": 22, "section": "reading", "group": "R1", "theme": "identity", "materialId": "C1C-M22", "target": "Identify a household task and the person doing it.", "promptEn": "Who washes the dishes?", "options": {"A": {"zh-Hans": "爷爷", "zh-Hant": "爺爺"}, "B": {"zh-Hans": "小米", "zh-Hant": "小米"}, "C": {"zh-Hans": "姐姐", "zh-Hant": "姐姐"}}, "correctAnswer": "B", "evidence": {"materialId": "C1C-M22", "quote": {"zh-Hans": "我去洗碗", "zh-Hant": "我去洗碗"}}, "explanation": {"en": "The writer, Xiaomi, says “I go wash the dishes.”", "zh": "作者小米说自己去洗碗。"}, "distractors": {"A": {"en": "Grandfather cleans the table.", "zh": "爷爷擦桌子。"}, "C": {"en": "The older sister puts the chairs away.", "zh": "姐姐把椅子放好。"}}, "reviewStatus": "author_self_checked_pending_teacher_and_user_review"}, {"id": "course-zh1-c-q23", "number": 23, "section": "reading", "group": "R1", "theme": "identity", "materialId": "C1C-M23", "target": "Recognize the recipient of a familiar personal letter.", "promptEn": "Who is this letter addressed to?", "options": {"A": {"zh-Hans": "奶奶", "zh-Hant": "奶奶"}, "B": {"zh-Hans": "妈妈", "zh-Hant": "媽媽"}, "C": {"zh-Hans": "姐姐", "zh-Hant": "姐姐"}}, "correctAnswer": "A", "evidence": {"materialId": "C1C-M23", "quote": {"zh-Hans": "奶奶您好", "zh-Hant": "奶奶您好"}}, "explanation": {"en": "The greeting addresses Grandmother directly.", "zh": "信的称呼直接写奶奶您好。"}, "distractors": {"B": {"en": "Mum will accompany the writer but is not the recipient.", "zh": "妈妈会陪作者一起去，但不是收信人。"}, "C": {"en": "An older sister is not the addressee.", "zh": "这封信不是写给姐姐的。"}}, "reviewStatus": "author_self_checked_pending_teacher_and_user_review"}, {"id": "course-zh1-c-q24", "number": 24, "section": "reading", "group": "R1", "theme": "identity", "materialId": "C1C-M24", "target": "Read an explicit school-status difference among family members.", "promptEn": "Who has NOT started school yet?", "options": {"A": {"zh-Hans": "哥哥", "zh-Hant": "哥哥"}, "B": {"zh-Hans": "妹妹", "zh-Hant": "妹妹"}, "C": {"zh-Hans": "说话的人", "zh-Hant": "說話的人"}}, "correctAnswer": "B", "evidence": {"materialId": "C1C-M24", "quote": {"zh-Hans": "妹妹还没上学", "zh-Hant": "妹妹還沒上學"}}, "explanation": {"en": "The younger sister has not started school yet.", "zh": "原文明确说妹妹还没上学。"}, "distractors": {"A": {"en": "The older brother already attends university.", "zh": "哥哥已经在大学读书。"}, "C": {"en": "The writer already attends Huguang School.", "zh": "作者已经在湖光学校上学。"}}, "reviewStatus": "author_self_checked_pending_teacher_and_user_review"}, {"id": "course-zh1-c-q25", "number": 25, "section": "reading", "group": "R1", "theme": "school", "materialId": "C1C-M25", "target": "Read a temporary teacher change without changing time or room.", "promptEn": "Who will teach Chinese on TUESDAY?", "options": {"A": {"zh-Hans": "王老师", "zh-Hant": "王老師"}, "B": {"zh-Hans": "刘老师", "zh-Hant": "劉老師"}, "C": {"zh-Hans": "林老师", "zh-Hant": "林老師"}}, "correctAnswer": "C", "evidence": {"materialId": "C1C-M25", "quote": {"zh-Hans": "那天林老师来上中文课", "zh-Hant": "那天林老師來上中文課"}}, "explanation": {"en": "Teacher Lin will teach the Tuesday lesson.", "zh": "周二中文课由林老师来上。"}, "distractors": {"A": {"en": "Teacher Wang is away on Tuesday and returns Wednesday.", "zh": "王老师周二请假，周三才回来。"}, "B": {"en": "Teacher Liu is not mentioned.", "zh": "通知没有提到刘老师。"}}, "reviewStatus": "author_self_checked_pending_teacher_and_user_review"}, {"id": "course-zh1-c-q26", "number": 26, "section": "reading", "group": "R2", "theme": "school", "materialId": "C1C-M26", "target": "Follow the first recipient in a school submission process.", "promptEn": "Who should receive students’ homework FIRST?", "options": {"A": {"zh-Hans": "小林", "zh-Hant": "小林"}, "B": {"zh-Hans": "小何", "zh-Hant": "小何"}, "C": {"zh-Hans": "老师", "zh-Hant": "老師"}}, "correctAnswer": "B", "evidence": {"materialId": "C1C-M26", "quote": {"zh-Hans": "请把作业本交给小何", "zh-Hant": "請把作業本交給小何"}}, "explanation": {"en": "Students first hand their work to Xiaohe.", "zh": "通知要求先把作业本交给小何。"}, "distractors": {"A": {"en": "Xiaolin collects new notebooks, not the submitted homework.", "zh": "小林负责拿新本子，不是先收作业。"}, "C": {"en": "The teacher receives it only after Xiaohe collects it.", "zh": "老师是在小何收齐以后收到作业。"}}, "reviewStatus": "author_self_checked_pending_teacher_and_user_review"}, {"id": "course-zh1-c-q27", "number": 27, "section": "reading", "group": "R2", "theme": "school", "materialId": "C1C-M27", "target": "Use written school directions without an unstated map.", "promptEn": "What is DIRECTLY opposite the school gate?", "options": {"A": {"zh-Hans": "食堂", "zh-Hant": "食堂"}, "B": {"zh-Hans": "办公室", "zh-Hant": "辦公室"}, "C": {"zh-Hans": "图书馆", "zh-Hant": "圖書館"}}, "correctAnswer": "C", "evidence": {"materialId": "C1C-M27", "quote": {"zh-Hans": "大门对面是图书馆", "zh-Hant": "大門對面是圖書館"}}, "explanation": {"en": "The library directly faces the gate.", "zh": "图书馆正对学校大门。"}, "distractors": {"A": {"en": "The canteen is on the left.", "zh": "食堂在左边。"}, "B": {"en": "The office is on the right.", "zh": "办公室在右边。"}}, "reviewStatus": "author_self_checked_pending_teacher_and_user_review"}, {"id": "course-zh1-c-q28", "number": 28, "section": "reading", "group": "R2", "theme": "school", "materialId": "C1C-M28", "target": "Distinguish a permitted action from two stated restrictions.", "promptEn": "Which activity is allowed INSIDE the reading room?", "options": {"A": {"zh-Hans": "安静看书", "zh-Hant": "安靜看書"}, "B": {"zh-Hans": "吃东西", "zh-Hant": "喫東西"}, "C": {"zh-Hans": "大声说话", "zh-Hant": "大聲說話"}}, "correctAnswer": "A", "evidence": {"materialId": "C1C-M28", "quote": {"zh-Hans": "这里可以安静看书", "zh-Hant": "這裏可以安靜看書"}}, "explanation": {"en": "Quiet reading is explicitly allowed.", "zh": "提示明确允许安静看书。"}, "distractors": {"B": {"en": "Eating inside is explicitly prohibited in the notice.", "zh": "提示明确说室内不可以吃东西。"}, "C": {"en": "The notice says not to speak loudly.", "zh": "提示说不要大声说话。"}}, "reviewStatus": "author_self_checked_pending_teacher_and_user_review"}, {"id": "course-zh1-c-q29", "number": 29, "section": "reading", "group": "R2", "theme": "school", "materialId": "C1C-M29", "target": "Read ownership from a brief school lost-property list.", "promptEn": "Who owns the RED SCHOOLBAG?", "options": {"A": {"zh-Hans": "小林", "zh-Hant": "小林"}, "B": {"zh-Hans": "小何", "zh-Hant": "小何"}, "C": {"zh-Hans": "小康", "zh-Hant": "小康"}}, "correctAnswer": "B", "evidence": {"materialId": "C1C-M29", "quote": {"zh-Hans": "红书包：小何", "zh-Hant": "紅書包：小何"}}, "explanation": {"en": "Xiaohe is the labelled owner of the red schoolbag.", "zh": "红书包对应小何。"}, "distractors": {"A": {"en": "Xiaolin owns the blue hat.", "zh": "小林的物品是蓝帽子。"}, "C": {"en": "Xiaokang owns the black coat.", "zh": "小康的物品是黑外套。"}}, "reviewStatus": "author_self_checked_pending_teacher_and_user_review"}, {"id": "course-zh1-c-q30", "number": 30, "section": "reading", "group": "R2", "theme": "schedule", "materialId": "C1C-M30", "target": "Find an activity’s day and start time in a weekly plan.", "promptEn": "When does the SINGING activity start?", "options": {"A": {"zh-Hans": "周一下午三点", "zh-Hant": "週一下午三點"}, "B": {"zh-Hans": "周五下午两点", "zh-Hant": "週五下午兩點"}, "C": {"zh-Hans": "周四下午三点半", "zh-Hant": "週四下午三點半"}}, "correctAnswer": "C", "evidence": {"materialId": "C1C-M30", "quote": {"zh-Hans": "周四15:30：唱歌", "zh-Hant": "週四15:30：唱歌"}}, "explanation": {"en": "Singing starts Thursday at three thirty.", "zh": "唱歌活动周四下午三点半开始。"}, "distractors": {"A": {"en": "Monday at three is the drawing activity.", "zh": "周一三点是画画活动。"}, "B": {"en": "Friday at two is the reading activity.", "zh": "周五两点是看书活动。"}}, "reviewStatus": "author_self_checked_pending_teacher_and_user_review"}, {"id": "course-zh1-c-q31", "number": 31, "section": "reading", "group": "R3", "theme": "food", "materialId": "C1C-M31", "target": "Match an explicitly requested combination to a menu set.", "promptEn": "Which set includes RICE and VEGETABLES?", "options": {"A": {"zh-Hans": "一号", "zh-Hant": "一號"}, "B": {"zh-Hans": "二号", "zh-Hant": "二號"}, "C": {"zh-Hans": "三号", "zh-Hant": "三號"}}, "correctAnswer": "A", "evidence": {"materialId": "C1C-M31", "quote": {"zh-Hans": "一号：米饭和青菜", "zh-Hant": "一號：米飯和青菜"}}, "explanation": {"en": "Set One lists rice and vegetables.", "zh": "一号套餐列的是米饭和青菜。"}, "distractors": {"B": {"en": "Set Two has noodles and beef.", "zh": "二号套餐是面条和牛肉。"}, "C": {"en": "Set Three has buns and chicken.", "zh": "三号套餐是包子和鸡肉。"}}, "reviewStatus": "author_self_checked_pending_teacher_and_user_review"}, {"id": "course-zh1-c-q32", "number": 32, "section": "reading", "group": "R3", "theme": "food", "materialId": "C1C-M32", "target": "Identify a needed purchase rather than items already available.", "promptEn": "Which drink should Xiaolu BUY?", "options": {"A": {"zh-Hans": "茶", "zh-Hant": "茶"}, "B": {"zh-Hans": "牛奶", "zh-Hant": "牛奶"}, "C": {"zh-Hans": "水", "zh-Hant": "水"}}, "correctAnswer": "B", "evidence": {"materialId": "C1C-M32", "quote": {"zh-Hans": "请今天买两盒牛奶回来", "zh-Hant": "請今天買兩盒牛奶回來"}}, "explanation": {"en": "Milk has run out and is explicitly requested.", "zh": "牛奶喝完了，妈妈明确要求购买。"}, "distractors": {"A": {"en": "There is already plenty of tea.", "zh": "家里还有很多茶。"}, "C": {"en": "There is enough water already.", "zh": "家里的水已经够了。"}}, "reviewStatus": "author_self_checked_pending_teacher_and_user_review"}, {"id": "course-zh1-c-q33", "number": 33, "section": "reading", "group": "R3", "theme": "food", "materialId": "C1C-M33", "target": "Use explicit opening hours to identify an available meal time.", "promptEn": "At which time can you buy BREAKFAST on Monday?", "options": {"A": {"zh-Hans": "上午十点", "zh-Hant": "上午十點"}, "B": {"zh-Hans": "上午十一点", "zh-Hant": "上午十一點"}, "C": {"zh-Hans": "上午九点", "zh-Hant": "上午九點"}}, "correctAnswer": "C", "evidence": {"materialId": "C1C-M33", "quote": {"zh-Hans": "早餐：早上七点到九点半", "zh-Hant": "早餐：早上七點到九點半"}}, "explanation": {"en": "Nine is within the seven-to-nine-thirty breakfast hours.", "zh": "九点在七点到九点半的早餐营业时段内。"}, "distractors": {"A": {"en": "Ten is in the water-only interval.", "zh": "十点属于只卖水的时段。"}, "B": {"en": "Eleven is when lunch begins, after breakfast ends.", "zh": "十一点开始卖午饭，早餐已结束。"}}, "reviewStatus": "author_self_checked_pending_teacher_and_user_review"}, {"id": "course-zh1-c-q34", "number": 34, "section": "reading", "group": "R3", "theme": "food", "materialId": "C1C-M34", "target": "Follow a food-service collection instruction.", "promptEn": "At which window should a customer collect HOT TEA?", "options": {"A": {"zh-Hans": "三号窗口", "zh-Hant": "三號窗口"}, "B": {"zh-Hans": "一号窗口", "zh-Hant": "一號窗口"}, "C": {"zh-Hans": "二号窗口", "zh-Hant": "二號窗口"}}, "correctAnswer": "A", "evidence": {"materialId": "C1C-M34", "quote": {"zh-Hans": "热茶和牛奶也在三号窗口", "zh-Hant": "熱茶和牛奶也在三號窗口"}}, "explanation": {"en": "The notice explicitly places hot tea at Window Three.", "zh": "提示明确说热茶在三号窗口。"}, "distractors": {"B": {"en": "Window One is for rice.", "zh": "一号窗口取米饭。"}, "C": {"en": "Window Two is for noodles.", "zh": "二号窗口取面条。"}}, "reviewStatus": "author_self_checked_pending_teacher_and_user_review"}, {"id": "course-zh1-c-q35", "number": 35, "section": "reading", "group": "R3", "theme": "clothing", "materialId": "C1C-M35", "target": "Read the quantity and measure word attached to clothing.", "promptEn": "How many pairs of SOCKS should be packed?", "options": {"A": {"zh-Hans": "两双", "zh-Hant": "兩雙"}, "B": {"zh-Hans": "三双", "zh-Hant": "三雙"}, "C": {"zh-Hans": "一双", "zh-Hant": "一雙"}}, "correctAnswer": "B", "evidence": {"materialId": "C1C-M35", "quote": {"zh-Hans": "袜子三双", "zh-Hant": "襪子三雙"}}, "explanation": {"en": "The packing list specifies three pairs of socks.", "zh": "清单要求带袜子三双。"}, "distractors": {"A": {"en": "Two is the number of tops, not pairs of socks.", "zh": "两件是上衣数量，不是袜子数量。"}, "C": {"en": "One refers to the trousers, not the socks.", "zh": "一条指裤子，不是袜子。"}}, "reviewStatus": "author_self_checked_pending_teacher_and_user_review"}, {"id": "course-zh1-c-q36", "number": 36, "section": "reading", "group": "R4", "theme": "schedule", "materialId": "C1C-M36", "target": "Compare old and new ticket information and distinguish entry from start time.", "promptEn": "When does the film start according to the NEW ticket?", "options": {"A": {"zh-Hans": "下午四点", "zh-Hant": "下午四點"}, "B": {"zh-Hans": "下午四点半", "zh-Hant": "下午四點半"}, "C": {"zh-Hans": "下午五点", "zh-Hant": "下午五點"}}, "correctAnswer": "C", "evidence": {"materialId": "C1C-M36", "quote": {"zh-Hans": "新票：下午五点开始", "zh-Hant": "新票：下午五點開始"}}, "explanation": {"en": "The new ticket gives five as the starting time.", "zh": "新票写下午五点开始。"}, "distractors": {"A": {"en": "Four is printed on the old ticket.", "zh": "四点是旧票上的开始时间。"}, "B": {"en": "Four thirty is the entry time, not the film start.", "zh": "四点半是可以进去的时间，不是开始放映时间。"}}, "reviewStatus": "author_self_checked_pending_teacher_and_user_review"}, {"id": "course-zh1-c-q37", "number": 37, "section": "reading", "group": "R4", "theme": "schedule", "materialId": "C1C-M37", "target": "Distinguish a weekend routine from the usual one.", "promptEn": "When does the writer get up on SUNDAY?", "options": {"A": {"zh-Hans": "八点", "zh-Hant": "八點"}, "B": {"zh-Hans": "六点半", "zh-Hant": "六點半"}, "C": {"zh-Hans": "八点半", "zh-Hant": "八點半"}}, "correctAnswer": "A", "evidence": {"materialId": "C1C-M37", "quote": {"zh-Hans": "星期天不用上学，我八点才起床", "zh-Hant": "星期天不用上學，我八點才起牀"}}, "explanation": {"en": "The Sunday waking time is eight.", "zh": "星期天八点才起床。"}, "distractors": {"B": {"en": "Six thirty is the usual waking time on other days.", "zh": "六点半是平时起床时间。"}, "C": {"en": "Eight thirty is Sunday breakfast time.", "zh": "八点半是星期天吃早饭时间。"}}, "reviewStatus": "author_self_checked_pending_teacher_and_user_review"}, {"id": "course-zh1-c-q38", "number": 38, "section": "reading", "group": "R4", "theme": "clothing", "materialId": "C1C-M38", "target": "Match clothing to the specified activity and day.", "promptEn": "Which shoes are requested for TUESDAY?", "options": {"A": {"zh-Hans": "黑色皮鞋", "zh-Hant": "黑色皮鞋"}, "B": {"zh-Hans": "运动鞋", "zh-Hant": "運動鞋"}, "C": {"zh-Hans": "拖鞋", "zh-Hant": "拖鞋"}}, "correctAnswer": "B", "evidence": {"materialId": "C1C-M38", "quote": {"zh-Hans": "周二体育课：运动鞋", "zh-Hant": "週二體育課：運動鞋"}}, "explanation": {"en": "Tuesday’s PE lesson requires sports shoes in this notice.", "zh": "通知要求周二体育课穿运动鞋。"}, "distractors": {"A": {"en": "Black leather shoes are for Wednesday’s performance.", "zh": "黑色皮鞋用于周三唱歌表演。"}, "C": {"en": "Slippers are not requested for either day.", "zh": "提示没有要求穿拖鞋。"}}, "reviewStatus": "author_self_checked_pending_teacher_and_user_review"}, {"id": "course-zh1-c-q39", "number": 39, "section": "reading", "group": "R4", "theme": "leisure", "materialId": "C1C-M39", "target": "Follow a weather-related change of leisure activity.", "promptEn": "What is the NEW activity on Sunday?", "options": {"A": {"zh-Hans": "去公园", "zh-Hant": "去公園"}, "B": {"zh-Hans": "打篮球", "zh-Hant": "打籃球"}, "C": {"zh-Hans": "听音乐", "zh-Hant": "聽音樂"}}, "correctAnswer": "C", "evidence": {"materialId": "C1C-M39", "quote": {"zh-Hans": "我们下午三点在小方家听音乐", "zh-Hant": "我們下午三點在小方家聽音樂"}}, "explanation": {"en": "The new indoor plan is listening to music.", "zh": "新安排是在小方家听音乐。"}, "distractors": {"A": {"en": "Going to the park is the cancelled plan.", "zh": "去公园的计划取消了。"}, "B": {"en": "Basketball is explicitly no longer the activity.", "zh": "通知明确说不打篮球了。"}}, "reviewStatus": "author_self_checked_pending_teacher_and_user_review"}, {"id": "course-zh1-c-q40", "number": 40, "section": "reading", "group": "R4", "theme": "leisure", "materialId": "C1C-M40", "target": "Identify what to bring for a leisure activity.", "promptEn": "What should participants BRING for the drawing activity?", "options": {"A": {"zh-Hans": "纸和笔", "zh-Hant": "紙和筆"}, "B": {"zh-Hans": "球", "zh-Hant": "球"}, "C": {"zh-Hans": "食物", "zh-Hant": "食物"}}, "correctAnswer": "A", "evidence": {"materialId": "C1C-M40", "quote": {"zh-Hans": "请自己带纸和笔", "zh-Hant": "請自己帶紙和筆"}}, "explanation": {"en": "Participants are explicitly asked to bring paper and pens.", "zh": "通知明确要求自带纸和笔。"}, "distractors": {"B": {"en": "A ball is not requested for the drawing group.", "zh": "画画活动没有要求带球。"}, "C": {"en": "The notice says food does not need to be prepared.", "zh": "通知说明不用准备食物。"}}, "reviewStatus": "author_self_checked_pending_teacher_and_user_review"}], "tasks": [{"id": "W1", "section": "writing", "type": "short-message-reply", "title": "Reply to an outdoor drawing invitation", "promptEn": "Reply in Chinese to your classmate. Say whether you can join the Sunday drawing activity, give a time or another day that works, and ask one question about the activity. About 20-40 Chinese characters is a guide, not a minimum. You may invent your schedule.", "stimulus": {"zh-Hans": "小陆：你好！周日下午一起去公园画画，好吗？你一点还是两点有空？\n小陶", "zh-Hant": "小陸：你好！週日下午一起去公園畫畫，好嗎？你一點還是兩點有空？\n小陶"}, "requirements": ["Respond to the Sunday invitation.", "Give a workable time or an alternative day.", "Ask one question relevant to the drawing activity."], "reference": {"zh-Hans": "小陶，你好！周日可以，我两点有空。我们要带什么东西？", "zh-Hant": "小陶，你好！週日可以，我兩點有空。我們要帶什麼東西？"}, "alternateReference": {"zh-Hans": "你好！周日我有事，周六两点可以吗？我们在哪个公园见？", "zh-Hant": "你好！週日我有事，週六兩點可以嗎？我們在哪個公園見？"}, "reviewNotes": ["Accepting or declining with an alternative can meet the task.", "A question about supplies, meeting point, park or weather arrangements is relevant.", "Invented details are acceptable. Do not penalize a response solely for being shorter than the suggested range."], "suggestedHanzi": [20, 40], "enforcedMinimum": null, "sharedTimingGroup": "writing", "rubric": {"maxPoints": 8, "dimensions": [{"id": "completion", "name": "任务完成", "levels": {"0": "无相关可评内容。", "1": "回应部分要求，遗漏关键信息。", "2": "以初阶表达回应主要要求。"}}, {"id": "comprehensibility", "name": "可理解性", "levels": {"0": "大部分意思无法恢复。", "1": "部分需借助上下文猜测。", "2": "主要意思能够理解。"}}, {"id": "language", "name": "基础语言运用", "levels": {"0": "缺少可用于表达目标意思的中文。", "1": "有限词句传达部分意思，错误有时干扰。", "2": "简单词句基本适合情境，允许初阶错误。"}}, {"id": "organization", "name": "组织／相关回应", "levels": {"0": "缺乏可辨关系或相关回应。", "1": "有部分顺序或相关回应。", "2": "简单但连贯，回应相关、易于跟随。"}}], "missing": "unsubmitted", "technicalFailure": "needs_rerecording", "automaticGrade": false, "reviewerOptions": ["self", "own_teacher"], "teacherServiceIncluded": false, "notes": "One profile per task. Suggested length and a native-like accent are not scoring criteria. Review submitted S1 responses as a partial task if necessary; no responses means unsubmitted. Technical failure needs rerecording, not an automatic zero."}}, {"id": "W2", "section": "writing", "type": "profile-or-day-description", "title": "Introduce a student and a Tuesday lesson", "promptEn": "Use BOTH parts of the fictional information below to introduce Chen Miao in Chinese. Include name and age, school and the Tuesday class starting time, and at least one preference. About 40-70 Chinese characters is a guide, not a minimum. Simple connected sentences are enough.", "stimulus": {"zh-Hans": "学生卡\n陈苗，十五岁，湖光学校。\n喜欢：跳舞、牛奶。不喜欢：茶。\n\n周二上午课表\n9:15—10:00：中文课。\n10:15—11:00：数学课。", "zh-Hant": "學生卡\n陳苗，十五歲，湖光學校。\n喜歡：跳舞、牛奶。不喜歡：茶。\n\n週二上午課表\n9:15—10:00：中文課。\n10:15—11:00：數學課。"}, "requirements": ["Identify Chen Miao by name and age.", "Give the school and the Chinese lesson starting time on Tuesday.", "State at least one preference consistent with the card."], "reference": {"zh-Hans": "这位同学叫陈苗，今年十五岁，在湖光学校上学。星期二上午九点十五分开始上中文课。陈苗喜欢跳舞，也喜欢喝牛奶，不喜欢喝茶。", "zh-Hant": "這位同學叫陳苗，今年十五歲，在湖光學校上學。星期二上午九點十五分開始上中文課。陳苗喜歡跳舞，也喜歡喝牛奶，不喜歡喝茶。"}, "reviewNotes": ["The required class time is the Chinese lesson start, not the mathematics start or an ending time.", "Use the name without inferring gender.", "Any one stated preference meets that requirement; do not require every timetable entry."], "suggestedHanzi": [40, 70], "enforcedMinimum": null, "sharedTimingGroup": "writing", "rubric": {"maxPoints": 8, "dimensions": [{"id": "completion", "name": "任务完成", "levels": {"0": "无相关可评内容。", "1": "回应部分要求，遗漏关键信息。", "2": "以初阶表达回应主要要求。"}}, {"id": "comprehensibility", "name": "可理解性", "levels": {"0": "大部分意思无法恢复。", "1": "部分需借助上下文猜测。", "2": "主要意思能够理解。"}}, {"id": "language", "name": "基础语言运用", "levels": {"0": "缺少可用于表达目标意思的中文。", "1": "有限词句传达部分意思，错误有时干扰。", "2": "简单词句基本适合情境，允许初阶错误。"}}, {"id": "organization", "name": "组织／相关回应", "levels": {"0": "缺乏可辨关系或相关回应。", "1": "有部分顺序或相关回应。", "2": "简单但连贯，回应相关、易于跟随。"}}], "missing": "unsubmitted", "technicalFailure": "needs_rerecording", "automaticGrade": false, "reviewerOptions": ["self", "own_teacher"], "teacherServiceIncluded": false, "notes": "One profile per task. Suggested length and a native-like accent are not scoring criteria. Review submitted S1 responses as a partial task if necessary; no responses means unsubmitted. Technical failure needs rerecording, not an automatic zero."}}, {"id": "S1", "section": "speaking", "type": "simulated-guided-exchange", "title": "Talk about school and make a plan", "promptEn": "Answer four recorded prompts in Chinese. Each plays twice, followed by 10 seconds to prepare and up to 20 seconds to record. Real or invented details are acceptable. All four responses form ONE /8 task. These are fixed prompts, not an adaptive conversation.", "scenarioEn": "A classmate asks about your school, clothing preferences and weekend routine, then invites you to sing together.", "exchanges": [{"id": "S1-1", "speaker": "female", "prompt": {"zh-Hans": "你在哪个学校上学？你是哪个班的学生？", "zh-Hant": "你在哪個學校上學？你是哪個班的學生？"}, "reference": {"zh-Hans": "我在湖光学校上学，在三班。", "zh-Hant": "我在湖光學校上學，在三班。"}, "checklist": ["Give a school and a class; invented details are acceptable."]}, {"id": "S1-2", "speaker": "female", "prompt": {"zh-Hans": "你喜欢什么颜色？喜欢穿什么衣服？", "zh-Hant": "你喜歡什麼顏色？喜歡穿什麼衣服？"}, "reference": {"zh-Hans": "我喜欢绿色，喜欢穿绿色的上衣。", "zh-Hant": "我喜歡綠色，喜歡穿綠色的上衣。"}, "checklist": ["Give a color preference and a clothing preference."]}, {"id": "S1-3", "speaker": "female", "prompt": {"zh-Hans": "周末你几点吃午饭？吃完饭做什么？", "zh-Hant": "週末你幾點喫午飯？喫完飯做什麼？"}, "reference": {"zh-Hans": "我十二点吃午饭，吃完饭以后看书。", "zh-Hant": "我十二點喫午飯，喫完飯以後看書。"}, "checklist": ["Give a lunch time and a subsequent activity."]}, {"id": "S1-4", "speaker": "female", "prompt": {"zh-Hans": "星期六一起唱歌，好吗？我们在哪儿见面？", "zh-Hant": "星期六一起唱歌，好嗎？我們在哪兒見面？"}, "reference": {"zh-Hans": "好啊，我们在学校门口见吧。", "zh-Hant": "好啊，我們在學校門口見吧。"}, "alternateReference": {"zh-Hans": "对不起，星期六我要上课。星期天在公园见，可以吗？", "zh-Hant": "對不起，星期六我要上課。星期天在公園見，可以嗎？"}, "checklist": ["Accept and suggest a meeting place, or decline and suggest another workable plan."]}], "playsPerPrompt": 2, "preparationSecondsPerPrompt": 10, "responseSecondsPerPrompt": 20, "rubricScope": "all_four_responses_together", "rubric": {"maxPoints": 8, "dimensions": [{"id": "completion", "name": "任务完成", "levels": {"0": "无相关可评内容。", "1": "回应部分要求，遗漏关键信息。", "2": "以初阶表达回应主要要求。"}}, {"id": "comprehensibility", "name": "可理解性", "levels": {"0": "大部分意思无法恢复。", "1": "部分需借助上下文猜测。", "2": "主要意思能够理解。"}}, {"id": "language", "name": "基础语言运用", "levels": {"0": "缺少可用于表达目标意思的中文。", "1": "有限词句传达部分意思，错误有时干扰。", "2": "简单词句基本适合情境，允许初阶错误。"}}, {"id": "organization", "name": "组织／相关回应", "levels": {"0": "缺乏可辨关系或相关回应。", "1": "有部分顺序或相关回应。", "2": "简单但连贯，回应相关、易于跟随。"}}], "missing": "unsubmitted", "technicalFailure": "needs_rerecording", "automaticGrade": false, "reviewerOptions": ["self", "own_teacher"], "teacherServiceIncluded": false, "notes": "One profile per task. Suggested length and a native-like accent are not scoring criteria. Review submitted S1 responses as a partial task if necessary; no responses means unsubmitted. Technical failure needs rerecording, not an automatic zero."}}, {"id": "S2", "section": "speaking", "type": "short-presentation", "title": "Describe a student’s Tuesday", "promptEn": "Use the fictional note to describe Xu Xing’s Tuesday in Chinese. Include who the student is, the school and at least one class time, and the after-school activity. You have 60 seconds to prepare and up to 60 seconds to speak. No minimum recording length is enforced.", "stimulus": {"zh-Hans": "许星的周二\n学校：湖光学校\n7:45：到学校\n8:10：开始上课\n12:00：和朋友吃午饭\n16:30：下课\n下课后：在音乐教室和同学唱歌", "zh-Hant": "許星的週二\n學校：湖光學校\n7:45：到學校\n8:10：開始上課\n12:00：和朋友喫午飯\n16:30：下課\n下課後：在音樂教室和同學唱歌"}, "requirements": ["Identify Xu Xing.", "Give the school and at least one class time.", "Describe the after-school activity in the note."], "reference": {"zh-Hans": "这是许星的星期二。许星在湖光学校上学，七点四十五到学校，八点十分开始上课。中午和朋友吃饭。下午四点半下课以后，许星在音乐教室和同学唱歌。", "zh-Hant": "這是許星的星期二。許星在湖光學校上學，七點四十五到學校，八點十分開始上課。中午和朋友喫飯。下午四點半下課以後，許星在音樂教室和同學唱歌。"}, "reviewNotes": ["Arrival at 7:45 and lessons starting at 8:10 are different facts.", "Give the class start or end time to meet the class-time requirement; not every time is required.", "Simple intelligible sentences are sufficient; do not grade by accent similarity or by filling the whole minute."], "preparationSeconds": 60, "responseSeconds": 60, "rubric": {"maxPoints": 8, "dimensions": [{"id": "completion", "name": "任务完成", "levels": {"0": "无相关可评内容。", "1": "回应部分要求，遗漏关键信息。", "2": "以初阶表达回应主要要求。"}}, {"id": "comprehensibility", "name": "可理解性", "levels": {"0": "大部分意思无法恢复。", "1": "部分需借助上下文猜测。", "2": "主要意思能够理解。"}}, {"id": "language", "name": "基础语言运用", "levels": {"0": "缺少可用于表达目标意思的中文。", "1": "有限词句传达部分意思，错误有时干扰。", "2": "简单词句基本适合情境，允许初阶错误。"}}, {"id": "organization", "name": "组织／相关回应", "levels": {"0": "缺乏可辨关系或相关回应。", "1": "有部分顺序或相关回应。", "2": "简单但连贯，回应相关、易于跟随。"}}], "missing": "unsubmitted", "technicalFailure": "needs_rerecording", "automaticGrade": false, "reviewerOptions": ["self", "own_teacher"], "teacherServiceIncluded": false, "notes": "One profile per task. Suggested length and a native-like accent are not scoring criteria. Review submitted S1 responses as a partial task if necessary; no responses means unsubmitted. Technical failure needs rerecording, not an automatic zero."}}], "instructions": {"en": "Choose one of A, B, C per objective question. Listening sources play twice in the timed track. Writing tasks share fifteen minutes. Written and oral tasks require self-review or review by your own teacher; no automatic grade or included teacher-marking service. Invented personal details are acceptable.", "zh": "听读每题三选一，整轨每段播放两遍。写作两题共用十五分钟。口写按量表自评或交给自己的教师评阅，不自动批改，不包含本站教师代评。可以使用虚构个人资料。"}, "vocabularySupport": [{"term": {"zh-Hans": "陪", "zh-Hant": "陪"}, "pinyin": "péi", "meaningEn": "accompany"}, {"term": {"zh-Hans": "练", "zh-Hant": "練"}, "pinyin": "liàn", "meaningEn": "practise"}, {"term": {"zh-Hans": "厨房", "zh-Hant": "廚房"}, "pinyin": "chúfáng", "meaningEn": "kitchen"}, {"term": {"zh-Hans": "客厅", "zh-Hant": "客廳"}, "pinyin": "kètīng", "meaningEn": "living room"}, {"term": {"zh-Hans": "上衣", "zh-Hant": "上衣"}, "pinyin": "shàngyī", "meaningEn": "top / upper-body garment"}, {"term": {"zh-Hans": "橡皮", "zh-Hant": "橡皮"}, "pinyin": "xiàngpí", "meaningEn": "eraser"}, {"term": {"zh-Hans": "毛巾", "zh-Hant": "毛巾"}, "pinyin": "máojīn", "meaningEn": "towel"}, {"term": {"zh-Hans": "筷子", "zh-Hant": "筷子"}, "pinyin": "kuàizi", "meaningEn": "chopsticks"}, {"term": {"zh-Hans": "汤", "zh-Hant": "湯"}, "pinyin": "tāng", "meaningEn": "soup"}, {"term": {"zh-Hans": "袜子", "zh-Hant": "襪子"}, "pinyin": "wàzi", "meaningEn": "socks"}, {"term": {"zh-Hans": "皮鞋", "zh-Hant": "皮鞋"}, "pinyin": "píxié", "meaningEn": "leather shoes"}, {"term": {"zh-Hans": "讲台", "zh-Hant": "講臺"}, "pinyin": "jiǎngtái", "meaningEn": "teacher’s desk / platform"}, {"term": {"zh-Hans": "阅览室", "zh-Hant": "閱覽室"}, "pinyin": "yuèlǎnshì", "meaningEn": "reading room"}, {"term": {"zh-Hans": "擦", "zh-Hant": "擦"}, "pinyin": "cā", "meaningEn": "wipe"}, {"term": {"zh-Hans": "洗碗", "zh-Hant": "洗碗"}, "pinyin": "xǐ wǎn", "meaningEn": "wash dishes"}, {"term": {"zh-Hans": "弹钢琴", "zh-Hant": "彈鋼琴"}, "pinyin": "tán gāngqín", "meaningEn": "play the piano"}, {"term": {"zh-Hans": "窗口", "zh-Hant": "窗口"}, "pinyin": "chuāngkǒu", "meaningEn": "service window"}, {"term": {"zh-Hans": "请假", "zh-Hant": "請假"}, "pinyin": "qǐngjià", "meaningEn": "take leave"}], "supportPolicy": "Optional preparation/practice aid. Not printed in the timed learner paper; assisted and unassisted attempts differ.", "nextAcceptance": ["Human listening to this C paper", "Independent teacher review of scope and wording", "Learner timing/difficulty pilot", "Separate runtime integration and release validation"]}</script><script id="audio-data" type="application/json">{"paperId": "course-chinese-1-c-v1", "provider": "Edge TTS used at authoring time; playback uses local MP3 files, no runtime TTS service", "rate": "-8%", "voices": {"female": "zh-CN-XiaoxiaoNeural", "male": "zh-CN-YunxiNeural"}, "humanListeningAcceptance": false, "units": [{"id": "C1C-M01", "kind": "listening-source", "sourcePlays": 1, "script": [{"speaker": "male", "text": {"zh-Hans": "姐姐的中文很好。每天晚饭后，她陪我练中文。那时妈妈在厨房洗碗，弟弟在客厅看电视，不和我们一起练。", "zh-Hant": "姐姐的中文很好。每天晚飯後，她陪我練中文。那時媽媽在廚房洗碗，弟弟在客廳看電視，不和我們一起練。"}}], "sourceDurationSeconds": 11.232, "src": "assets/audio/c1c-m01.mp3", "durationSeconds": 11.784, "pcmSeconds": 11.732, "bytes": 94508, "sha256": "5c92f11bc55b1752ae8b3f3ef73602c186b96272f6ce7a811b9d16feb7cd6f49"}, {"id": "C1C-M02", "kind": "listening-source", "sourcePlays": 1, "script": [{"speaker": "female", "text": {"zh-Hans": "奶奶一个人住在南京。明天我和爸爸坐车去看她，妈妈要工作，不能一起去。我们星期天晚上回来。", "zh-Hant": "奶奶一個人住在南京。明天我和爸爸坐車去看她，媽媽要工作，不能一起去。我們星期天晚上回來。"}}], "sourceDurationSeconds": 10.872, "src": "assets/audio/c1c-m02.mp3", "durationSeconds": 11.424, "pcmSeconds": 11.372, "bytes": 91628, "sha256": "d8d01a526e2aca6556425c44ddf70941894238376054286bf44ca77e1e2e1b50"}, {"id": "C1C-M03", "kind": "listening-source", "sourcePlays": 1, "script": [{"speaker": "male", "text": {"zh-Hans": "今天是妈妈的生日。我和爸爸买了一个蛋糕，姐姐准备晚饭。妈妈下班回家以后，我们一起给她唱生日歌。", "zh-Hant": "今天是媽媽的生日。我和爸爸買了一個蛋糕，姐姐準備晚飯。媽媽下班回家以後，我們一起給她唱生日歌。"}}], "sourceDurationSeconds": 10.44, "src": "assets/audio/c1c-m03.mp3", "durationSeconds": 10.992, "pcmSeconds": 10.94, "bytes": 88172, "sha256": "6af77eeddb61f314aa015dca32b60c407d5d35ff54b1689d74cbdb14d6789a00"}, {"id": "C1C-M04", "kind": "listening-source", "sourcePlays": 1, "script": [{"speaker": "female", "text": {"zh-Hans": "我现在和爸爸妈妈住在天津。哥哥在上海工作，爷爷奶奶住在北京。我们放假的时候常常去北京看他们。", "zh-Hant": "我現在和爸爸媽媽住在天津。哥哥在上海工作，爺爺奶奶住在北京。我們放假的時候常常去北京看他們。"}}], "sourceDurationSeconds": 11.136, "src": "assets/audio/c1c-m04.mp3", "durationSeconds": 11.688, "pcmSeconds": 11.636, "bytes": 93740, "sha256": "a686ecdc3950589a84dbbf3e2fef25bb2c48f0a61b18039105de05f49fed5604"}, {"id": "C1C-M05", "kind": "listening-source", "sourcePlays": 1, "script": [{"speaker": "male", "text": {"zh-Hans": "星期一上午第一节是数学课，第二节才是中文课。下午有体育课。今天我先把数学书拿出来，中文书还放在书包里。", "zh-Hant": "星期一上午第一節是數學課，第二節纔是中文課。下午有體育課。今天我先把數學書拿出來，中文書還放在書包裏。"}}], "sourceDurationSeconds": 11.52, "src": "assets/audio/c1c-m05.mp3", "durationSeconds": 12.072, "pcmSeconds": 12.02, "bytes": 96812, "sha256": "5eab491c7d884f8112649c6c6ed980356a5ced98753f4adea24f6f542987067f"}, {"id": "C1C-M06", "kind": "listening-source", "sourcePlays": 1, "script": [{"speaker": "female", "text": {"zh-Hans": "老师，我的橡皮找不到了。", "zh-Hant": "老師，我的橡皮找不到了。"}}, {"speaker": "male", "text": {"zh-Hans": "黑板旁边的红盒子里有橡皮，你拿一块吧。", "zh-Hant": "黑板旁邊的紅盒子裏有橡皮，你拿一塊吧。"}}, {"speaker": "female", "text": {"zh-Hans": "谢谢，我用完以后放回盒子。", "zh-Hant": "謝謝，我用完以後放回盒子。"}}], "sourceDurationSeconds": 11.596, "src": "assets/audio/c1c-m06.mp3", "durationSeconds": 12.144, "pcmSeconds": 12.096, "bytes": 97388, "sha256": "39670ba31bcce7fc521dcab8938b73f4b6df8547bef2984178fef5e93fca5c54"}, {"id": "C1C-M07", "kind": "listening-source", "sourcePlays": 1, "script": [{"speaker": "male", "text": {"zh-Hans": "老师，今天的答案写在书上吗？", "zh-Hant": "老師，今天的答案寫在書上嗎？"}}, {"speaker": "female", "text": {"zh-Hans": "不要写在书上，写在本子上。写完以后把本子交给我，书先放在桌子上。", "zh-Hant": "不要寫在書上，寫在本子上。寫完以後把本子交給我，書先放在桌子上。"}}], "sourceDurationSeconds": 11.894, "src": "assets/audio/c1c-m07.mp3", "durationSeconds": 12.456, "pcmSeconds": 12.394, "bytes": 99884, "sha256": "3114485f1c3fa64f8c80dd77e1c80be6d242771861800a0c683761bba2055b73"}, {"id": "C1C-M08", "kind": "listening-source", "sourcePlays": 1, "script": [{"speaker": "female", "text": {"zh-Hans": "老师，这本书是谁的？不是我的，我的在书包里。", "zh-Hant": "老師，這本書是誰的？不是我的，我的在書包裏。"}}, {"speaker": "male", "text": {"zh-Hans": "我看看，上面写着小陈的名字。请你下课后把书给小陈。", "zh-Hant": "我看看，上面寫着小陳的名字。請你下課後把書給小陳。"}}], "sourceDurationSeconds": 12.734, "src": "assets/audio/c1c-m08.mp3", "durationSeconds": 13.296, "pcmSeconds": 13.234, "bytes": 106604, "sha256": "eaaca7c8266ba317df3478056a6304a215c879a7250280b52f0bfe7e96015c25"}, {"id": "C1C-M09", "kind": "listening-source", "sourcePlays": 1, "script": [{"speaker": "male", "text": {"zh-Hans": "明天体育课，每人带一瓶水和一条毛巾。不用自己带篮球，学校有。请大家穿运动鞋，准时到操场。", "zh-Hant": "明天體育課，每人帶一瓶水和一條毛巾。不用自己帶籃球，學校有。請大家穿運動鞋，準時到操場。"}}], "sourceDurationSeconds": 11.016, "src": "assets/audio/c1c-m09.mp3", "durationSeconds": 11.568, "pcmSeconds": 11.516, "bytes": 92780, "sha256": "0f38b693f67c051ebdbe1ec912051b3247e247260295834f232a6da3e84c3e49"}, {"id": "C1C-M10", "kind": "listening-source", "sourcePlays": 1, "script": [{"speaker": "female", "text": {"zh-Hans": "明天中文课几点下课？", "zh-Hant": "明天中文課幾點下課？"}}, {"speaker": "male", "text": {"zh-Hans": "八点开始，八点四十结束。休息以后，九点上英语课。", "zh-Hant": "八點開始，八點四十結束。休息以後，九點上英語課。"}}, {"speaker": "female", "text": {"zh-Hans": "好，我八点四十来找你。", "zh-Hant": "好，我八點四十來找你。"}}], "sourceDurationSeconds": 12.82, "src": "assets/audio/c1c-m10.mp3", "durationSeconds": 13.368, "pcmSeconds": 13.32, "bytes": 107180, "sha256": "da27fca9fb198204d928438593514b6e8eacbc8201a03864be49a9abaf2feea0"}, {"id": "C1C-M11", "kind": "listening-source", "sourcePlays": 1, "script": [{"speaker": "male", "text": {"zh-Hans": "这碗汤已经凉了，能换一碗热的吗？", "zh-Hant": "這碗湯已經涼了，能換一碗熱的嗎？"}}, {"speaker": "female", "text": {"zh-Hans": "可以，我给您换热汤。", "zh-Hant": "可以，我給您換熱湯。"}}, {"speaker": "male", "text": {"zh-Hans": "谢谢，天气有点儿冷，我想喝热的。", "zh-Hant": "謝謝，天氣有點兒冷，我想喝熱的。"}}], "sourceDurationSeconds": 11.548, "src": "assets/audio/c1c-m11.mp3", "durationSeconds": 12.096, "pcmSeconds": 12.048, "bytes": 97004, "sha256": "99168043fe57dc73ec7a34d2094b45b9fb31eb2ab2901e034566fee52c221601"}, {"id": "C1C-M12", "kind": "listening-source", "sourcePlays": 1, "script": [{"speaker": "female", "text": {"zh-Hans": "这份午饭在这儿吃吗？", "zh-Hant": "這份午飯在這兒喫嗎？"}}, {"speaker": "male", "text": {"zh-Hans": "不，我要带回家吃。家里还有人在等我。请帮我装好，筷子我家里有，不用给了。", "zh-Hant": "不，我要帶回家喫。家裏還有人在等我。請幫我裝好，筷子我家裏有，不用給了。"}}], "sourceDurationSeconds": 11.486, "src": "assets/audio/c1c-m12.mp3", "durationSeconds": 12.048, "pcmSeconds": 11.986, "bytes": 96620, "sha256": "46e637f136919e8d0ba78f70cd016e827de305b4af3e7fb91db79ddacbdb403d"}, {"id": "C1C-M13", "kind": "listening-source", "sourcePlays": 1, "script": [{"speaker": "female", "text": {"zh-Hans": "妈妈喜欢吃西瓜，爸爸喜欢苹果。我最喜欢橙子。今天我给他们买西瓜和苹果，也给自己买了几个橙子。", "zh-Hant": "媽媽喜歡喫西瓜，爸爸喜歡蘋果。我最喜歡橙子。今天我給他們買西瓜和蘋果，也給自己買了幾個橙子。"}}], "sourceDurationSeconds": 11.04, "src": "assets/audio/c1c-m13.mp3", "durationSeconds": 11.592, "pcmSeconds": 11.54, "bytes": 92972, "sha256": "44916b90da0dbd88df20a1224aa1104ab85a225d00592c67a802a653db06863c"}, {"id": "C1C-M14", "kind": "listening-source", "sourcePlays": 1, "script": [{"speaker": "male", "text": {"zh-Hans": "面条八块，加一个鸡蛋一共多少钱？", "zh-Hant": "麪條八塊，加一個雞蛋一共多少錢？"}}, {"speaker": "female", "text": {"zh-Hans": "一共十块。", "zh-Hant": "一共十塊。"}}, {"speaker": "male", "text": {"zh-Hans": "好，我给你十块。", "zh-Hant": "好，我給你十塊。"}}, {"speaker": "female", "text": {"zh-Hans": "谢谢，请在旁边等一下。", "zh-Hant": "謝謝，請在旁邊等一下。"}}], "sourceDurationSeconds": 12.81, "src": "assets/audio/c1c-m14.mp3", "durationSeconds": 13.368, "pcmSeconds": 13.31, "bytes": 107180, "sha256": "326767ff280dd88f5b87b4cd53707df1d06acbe18a3502666b5c2673f26ec51c"}, {"id": "C1C-M15", "kind": "listening-source", "sourcePlays": 1, "script": [{"speaker": "female", "text": {"zh-Hans": "这件小号上衣有点儿小。能试试中号吗？", "zh-Hant": "這件小號上衣有點兒小。能試試中號嗎？"}}, {"speaker": "male", "text": {"zh-Hans": "可以，这里有中号和大号。", "zh-Hant": "可以，這裏有中號和大號。"}}, {"speaker": "female", "text": {"zh-Hans": "中号正好，我就要中号的。", "zh-Hant": "中號正好，我就要中號的。"}}], "sourceDurationSeconds": 11.884, "src": "assets/audio/c1c-m15.mp3", "durationSeconds": 12.432, "pcmSeconds": 12.384, "bytes": 99692, "sha256": "9890fd1880075f261b6092614f1170cfb1f40a6d50c6102cd68659bff293f136"}, {"id": "C1C-M16", "kind": "listening-source", "sourcePlays": 1, "script": [{"speaker": "male", "text": {"zh-Hans": "我们下午三点见，好吗？", "zh-Hant": "我們下午三點見，好嗎？"}}, {"speaker": "female", "text": {"zh-Hans": "我两点半就到了，可以早一点见吗？", "zh-Hant": "我兩點半就到了，可以早一點見嗎？"}}, {"speaker": "male", "text": {"zh-Hans": "可以，那我们两点半见，我也早点出门。", "zh-Hant": "可以，那我們兩點半見，我也早點出門。"}}], "sourceDurationSeconds": 12.316, "src": "assets/audio/c1c-m16.mp3", "durationSeconds": 12.864, "pcmSeconds": 12.816, "bytes": 103148, "sha256": "e0114b8f9d1dc18ca38c9373226d671bff3ec789d102ba87739b4c09824d884a"}, {"id": "C1C-M17", "kind": "listening-source", "sourcePlays": 1, "script": [{"speaker": "female", "text": {"zh-Hans": "这班车九点开。我们八点半从家里出发，八点四十到车站。到了以后先买票，再一起等车。", "zh-Hant": "這班車九點開。我們八點半從家裏出發，八點四十到車站。到了以後先買票，再一起等車。"}}], "sourceDurationSeconds": 9.912, "src": "assets/audio/c1c-m17.mp3", "durationSeconds": 10.464, "pcmSeconds": 10.412, "bytes": 83948, "sha256": "c665655a80210ed505fafac904307fc8fc2338679ee571d36f0e4773aa83073a"}, {"id": "C1C-M18", "kind": "listening-source", "sourcePlays": 1, "script": [{"speaker": "male", "text": {"zh-Hans": "明天学校活动，我们穿什么衣服？", "zh-Hant": "明天學校活動，我們穿什麼衣服？"}}, {"speaker": "female", "text": {"zh-Hans": "白色上衣、黑色裤子。鞋子没有要求。", "zh-Hant": "白色上衣、黑色褲子。鞋子沒有要求。"}}, {"speaker": "male", "text": {"zh-Hans": "好，我穿黑裤子和蓝色运动鞋。", "zh-Hant": "好，我穿黑褲子和藍色運動鞋。"}}], "sourceDurationSeconds": 13.684, "src": "assets/audio/c1c-m18.mp3", "durationSeconds": 14.232, "pcmSeconds": 14.184, "bytes": 114092, "sha256": "05b9f2636288b3e4bea398d26ba1971a4a26c2a46cb21d4808d633c30c0cfe1c"}, {"id": "C1C-M19", "kind": "listening-source", "sourcePlays": 1, "script": [{"speaker": "male", "text": {"zh-Hans": "姐姐很会唱歌，弟弟喜欢画画。我不会唱歌，可是会弹钢琴。周六下午，我们想一起给爸爸妈妈表演。", "zh-Hant": "姐姐很會唱歌，弟弟喜歡畫畫。我不會唱歌，可是會彈鋼琴。週六下午，我們想一起給爸爸媽媽表演。"}}], "sourceDurationSeconds": 10.416, "src": "assets/audio/c1c-m19.mp3", "durationSeconds": 10.968, "pcmSeconds": 10.916, "bytes": 87980, "sha256": "c8e51a03d78cc37c336cadd9630c67956c459b294c01b8b065efafdb26548baf"}, {"id": "C1C-M20", "kind": "listening-source", "sourcePlays": 1, "script": [{"speaker": "female", "text": {"zh-Hans": "今天放学后一起去游泳吗？", "zh-Hant": "今天放學後一起去游泳嗎？"}}, {"speaker": "male", "text": {"zh-Hans": "今天我不去游泳，我想在家看书。明天再去游泳。", "zh-Hant": "今天我不去游泳，我想在家看書。明天再去游泳。"}}, {"speaker": "female", "text": {"zh-Hans": "好，那我们明天下午见。", "zh-Hant": "好，那我們明天下午見。"}}], "sourceDurationSeconds": 12.412, "src": "assets/audio/c1c-m20.mp3", "durationSeconds": 12.96, "pcmSeconds": 12.912, "bytes": 103916, "sha256": "0452e3503a670045ea70282b13b71d46474a0d78202e889e0a79a01f7726482c"}, {"id": "S1-1", "kind": "oral-prompt", "sourcePlays": 2, "singlePlayPcmSeconds": 4.608, "repeatGapSeconds": 1.5, "singlePlayPcmSha256": "5cd925dbc6c78599e7837aedc6f8a7a66f560f0cc1f7349874034f7a18a0f400", "script": {"zh-Hans": "你在哪个学校上学？你是哪个班的学生？", "zh-Hant": "你在哪個學校上學？你是哪個班的學生？"}, "src": "assets/audio/s1-1.mp3", "durationSeconds": 10.776, "pcmSeconds": 10.716, "bytes": 86444, "sha256": "9fd61fe4e9850c97ded1f52fdfbc54807a394aa483ab78ae5132ca9428aaef1d"}, {"id": "S1-2", "kind": "oral-prompt", "sourcePlays": 2, "singlePlayPcmSeconds": 4.296, "repeatGapSeconds": 1.5, "singlePlayPcmSha256": "82cb34510b161e29e20d1dd03aad5a23c86c8d38d26d9380af285f8b10cf5db3", "script": {"zh-Hans": "你喜欢什么颜色？喜欢穿什么衣服？", "zh-Hant": "你喜歡什麼顏色？喜歡穿什麼衣服？"}, "src": "assets/audio/s1-2.mp3", "durationSeconds": 10.152, "pcmSeconds": 10.092, "bytes": 81452, "sha256": "98cdaf88c55d555036ca1e698977e19ccb374c6426839c0d6bfb9ee613c1c34f"}, {"id": "S1-3", "kind": "oral-prompt", "sourcePlays": 2, "singlePlayPcmSeconds": 4.296, "repeatGapSeconds": 1.5, "singlePlayPcmSha256": "400b341e372bff8697010b34607420c1224af54fb7866058ee408dc80c50f43c", "script": {"zh-Hans": "周末你几点吃午饭？吃完饭做什么？", "zh-Hant": "週末你幾點喫午飯？喫完飯做什麼？"}, "src": "assets/audio/s1-3.mp3", "durationSeconds": 10.152, "pcmSeconds": 10.092, "bytes": 81452, "sha256": "e235585dda1987a809ae66b8412950910fe2691d4c5cb6e6656161042523675f"}, {"id": "S1-4", "kind": "oral-prompt", "sourcePlays": 2, "singlePlayPcmSeconds": 4.728, "repeatGapSeconds": 1.5, "singlePlayPcmSha256": "2fb3efa8711e3fa386c8c5c7f32865ed1689eaaa01d3ec2ecc8124378c3749f5", "script": {"zh-Hans": "星期六一起唱歌，好吗？我们在哪儿见面？", "zh-Hant": "星期六一起唱歌，好嗎？我們在哪兒見面？"}, "src": "assets/audio/s1-4.mp3", "durationSeconds": 11.016, "pcmSeconds": 10.956, "bytes": 88364, "sha256": "67b10debe28384b2b027d051cd0ffc5d753432d3624c110ceea5a700022dae7d"}], "groups": [{"id": "L1", "sourcePlays": 2, "src": "assets/audio/listening-group-1.mp3", "durationSeconds": 225.072, "pcmSeconds": 225.0, "bytes": 1800812, "sha256": "846efb63235c7f99c546fab5043c6f23072e31b713a721b88b37e8f673122c02"}, {"id": "L2", "sourcePlays": 2, "src": "assets/audio/listening-group-2.mp3", "durationSeconds": 225.048, "pcmSeconds": 225.0, "bytes": 1800620, "sha256": "c90be24ab92ddf3ac524a516b7ee05b3f40d7d8fc2acf2f5b0f4ddc41e79c929"}, {"id": "L3", "sourcePlays": 2, "src": "assets/audio/listening-group-3.mp3", "durationSeconds": 225.048, "pcmSeconds": 225.0, "bytes": 1800620, "sha256": "df2b9fd8907b68cf6f98a3f540fc44432a97e60090bbce08fd7d2d1f6d45187f"}, {"id": "L4", "sourcePlays": 2, "src": "assets/audio/listening-group-4.mp3", "durationSeconds": 225.048, "pcmSeconds": 225.0, "bytes": 1800620, "sha256": "d5aca2fedab47f7f9a711e983a41aa032ef399d1dfb79d822d97e3378c53dc4b"}], "timedTrack": {"src": "assets/audio/listening-full.mp3", "durationSeconds": 900.072, "pcmSeconds": 900.0, "bytes": 7200812, "sha256": "f7c66185fb741e0bb6f3d7667e4930b685d90fdb63c3293c4f4762d65e088b6b"}, "timeline": [{"id": "C1C-M01", "questionNumber": 1, "labelStartSeconds": 7.984, "firstPlayStartSeconds": 10.02, "secondPlayStartSeconds": 22.752, "speechEndSeconds": 33.984, "answerWindowSeconds": 17.403, "slotEndSeconds": 51.387, "sourcePlays": 2}, {"id": "C1C-M02", "questionNumber": 2, "labelStartSeconds": 51.387, "firstPlayStartSeconds": 53.399, "secondPlayStartSeconds": 65.771, "speechEndSeconds": 76.643, "answerWindowSeconds": 18.147, "slotEndSeconds": 94.79, "sourcePlays": 2}, {"id": "C1C-M03", "questionNumber": 3, "labelStartSeconds": 94.79, "firstPlayStartSeconds": 96.922, "secondPlayStartSeconds": 108.862, "speechEndSeconds": 119.302, "answerWindowSeconds": 18.891, "slotEndSeconds": 138.194, "sourcePlays": 2}, {"id": "C1C-M04", "questionNumber": 4, "labelStartSeconds": 138.194, "firstPlayStartSeconds": 140.326, "secondPlayStartSeconds": 152.962, "speechEndSeconds": 164.098, "answerWindowSeconds": 17.499, "slotEndSeconds": 181.597, "sourcePlays": 2}, {"id": "C1C-M05", "questionNumber": 5, "labelStartSeconds": 181.597, "firstPlayStartSeconds": 183.657, "secondPlayStartSeconds": 196.677, "speechEndSeconds": 208.197, "answerWindowSeconds": 16.803, "slotEndSeconds": 225.0, "sourcePlays": 2}, {"id": "C1C-M06", "questionNumber": 6, "labelStartSeconds": 232.96, "firstPlayStartSeconds": 235.068, "secondPlayStartSeconds": 248.164, "speechEndSeconds": 259.76, "answerWindowSeconds": 16.608, "slotEndSeconds": 276.368, "sourcePlays": 2}, {"id": "C1C-M07", "questionNumber": 7, "labelStartSeconds": 276.368, "firstPlayStartSeconds": 278.476, "secondPlayStartSeconds": 291.87, "speechEndSeconds": 303.764, "answerWindowSeconds": 16.012, "slotEndSeconds": 319.776, "sourcePlays": 2}, {"id": "C1C-M08", "questionNumber": 8, "labelStartSeconds": 319.776, "firstPlayStartSeconds": 321.86, "secondPlayStartSeconds": 336.094, "speechEndSeconds": 348.828, "answerWindowSeconds": 14.356, "slotEndSeconds": 363.184, "sourcePlays": 2}, {"id": "C1C-M09", "questionNumber": 9, "labelStartSeconds": 363.184, "firstPlayStartSeconds": 365.268, "secondPlayStartSeconds": 377.784, "speechEndSeconds": 388.8, "answerWindowSeconds": 17.792, "slotEndSeconds": 406.592, "sourcePlays": 2}, {"id": "C1C-M10", "questionNumber": 10, "labelStartSeconds": 406.592, "firstPlayStartSeconds": 408.748, "secondPlayStartSeconds": 423.068, "speechEndSeconds": 435.888, "answerWindowSeconds": 14.112, "slotEndSeconds": 450.0, "sourcePlays": 2}, {"id": "C1C-M11", "questionNumber": 11, "labelStartSeconds": 458.08, "firstPlayStartSeconds": 460.356, "secondPlayStartSeconds": 473.404, "speechEndSeconds": 484.952, "answerWindowSeconds": 16.512, "slotEndSeconds": 501.464, "sourcePlays": 2}, {"id": "C1C-M12", "questionNumber": 12, "labelStartSeconds": 501.464, "firstPlayStartSeconds": 503.74, "secondPlayStartSeconds": 516.726, "speechEndSeconds": 528.212, "answerWindowSeconds": 16.636, "slotEndSeconds": 544.848, "sourcePlays": 2}, {"id": "C1C-M13", "questionNumber": 13, "labelStartSeconds": 544.848, "firstPlayStartSeconds": 547.172, "secondPlayStartSeconds": 559.712, "speechEndSeconds": 570.752, "answerWindowSeconds": 17.48, "slotEndSeconds": 588.232, "sourcePlays": 2}, {"id": "C1C-M14", "questionNumber": 14, "labelStartSeconds": 588.232, "firstPlayStartSeconds": 590.58, "secondPlayStartSeconds": 604.89, "speechEndSeconds": 617.7, "answerWindowSeconds": 13.916, "slotEndSeconds": 631.616, "sourcePlays": 2}, {"id": "C1C-M15", "questionNumber": 15, "labelStartSeconds": 631.616, "firstPlayStartSeconds": 633.892, "secondPlayStartSeconds": 647.276, "speechEndSeconds": 659.16, "answerWindowSeconds": 15.84, "slotEndSeconds": 675.0, "sourcePlays": 2}, {"id": "C1C-M16", "questionNumber": 16, "labelStartSeconds": 683.08, "firstPlayStartSeconds": 685.428, "secondPlayStartSeconds": 699.244, "speechEndSeconds": 711.56, "answerWindowSeconds": 14.904, "slotEndSeconds": 726.464, "sourcePlays": 2}, {"id": "C1C-M17", "questionNumber": 17, "labelStartSeconds": 726.464, "firstPlayStartSeconds": 728.812, "secondPlayStartSeconds": 740.224, "speechEndSeconds": 750.136, "answerWindowSeconds": 19.712, "slotEndSeconds": 769.848, "sourcePlays": 2}, {"id": "C1C-M18", "questionNumber": 18, "labelStartSeconds": 769.848, "firstPlayStartSeconds": 772.148, "secondPlayStartSeconds": 787.332, "speechEndSeconds": 801.016, "answerWindowSeconds": 12.216, "slotEndSeconds": 813.232, "sourcePlays": 2}, {"id": "C1C-M19", "questionNumber": 19, "labelStartSeconds": 813.232, "firstPlayStartSeconds": 815.556, "secondPlayStartSeconds": 827.472, "speechEndSeconds": 837.888, "answerWindowSeconds": 18.728, "slotEndSeconds": 856.616, "sourcePlays": 2}, {"id": "C1C-M20", "questionNumber": 20, "labelStartSeconds": 856.616, "firstPlayStartSeconds": 858.844, "secondPlayStartSeconds": 872.756, "speechEndSeconds": 885.168, "answerWindowSeconds": 14.832, "slotEndSeconds": 900.0, "sourcePlays": 2}], "cache": [{"key": "2fb4eae8b885ef642b255bc6", "speaker": "female", "text": "中文一，C卷，听力第1组。每段听两遍，请选择一个答案。", "sha256": "0ab6830cd375eb4abbea591894a35a621b9c99ed85de2df6195f4ae105b71cf6"}, {"key": "63c0a1e13e1cb1482d10c3d9", "speaker": "female", "text": "中文一，C卷，听力第2组。每段听两遍，请选择一个答案。", "sha256": "edcd261848b0ca603a2ea20849e4afdcb01afee2a03e0b6ec85137fe25eaf5d9"}, {"key": "b5324dcf2c17e37d6d625ea2", "speaker": "female", "text": "中文一，C卷，听力第3组。每段听两遍，请选择一个答案。", "sha256": "a5006d6674f6c298c775da0b0a614d18ece9f59653ad1c8495107638e2d9a586"}, {"key": "e81689c0dc0d9774cb645610", "speaker": "female", "text": "中文一，C卷，听力第4组。每段听两遍，请选择一个答案。", "sha256": "af2c23f9857e584bbb8f2b6fda85b9054061ab2d744ec9b527f7984da76ef0a4"}, {"key": "d7e61d66227feda91a33d470", "speaker": "male", "text": "姐姐的中文很好。每天晚饭后，她陪我练中文。那时妈妈在厨房洗碗，弟弟在客厅看电视，不和我们一起练。", "sha256": "c2e9b0fb4570184a9ea954fc2fbc1035af535ea92a883dda6dcd552552dcf8d7"}, {"key": "34e89f8d03ace2b111d8dc37", "speaker": "female", "text": "第1题。", "sha256": "3895df58b8b6ce61365216490dcb339db3aa7ef168eef8d2098c469073a4cdc2"}, {"key": "cb1d7ca8d8e85c66d02edacd", "speaker": "female", "text": "奶奶一个人住在南京。明天我和爸爸坐车去看她，妈妈要工作，不能一起去。我们星期天晚上回来。", "sha256": "f066b09e3f62b63b0e46d7a96ba3f3f260477865d18f9dce033ad6f92fa45531"}, {"key": "1741fb60958696627ba5f0ed", "speaker": "female", "text": "第2题。", "sha256": "39f2c75a46983608745be0da5fe2130f1e77b5cd88f7b9b3928a0a06485a2744"}, {"key": "e2548bf6b27d065a677373cf", "speaker": "male", "text": "今天是妈妈的生日。我和爸爸买了一个蛋糕，姐姐准备晚饭。妈妈下班回家以后，我们一起给她唱生日歌。", "sha256": "433f9bf3a017ff2fbed79a6eb101fd0241b071ac995326bcd62477e86e61ccd0"}, {"key": "97e9c8d06f3e0171388ee24b", "speaker": "female", "text": "第3题。", "sha256": "74d7fdba0fd9fae146470574deadbd8616eca796fece18aaf8190b3792f4225e"}, {"key": "98a77148e7648659525d68b4", "speaker": "female", "text": "我现在和爸爸妈妈住在天津。哥哥在上海工作，爷爷奶奶住在北京。我们放假的时候常常去北京看他们。", "sha256": "43dc72e6ec3950f54540b39c8846cc05d501d86cf6826a8c2465fa050a747fe5"}, {"key": "b25d3caab3d72c3d0347de4b", "speaker": "female", "text": "第4题。", "sha256": "cc38e6d168e0664b2b8f98558b26288abcea294390f4e9aa13d8f457ef5a7046"}, {"key": "d9ca38804ab000cec532cadc", "speaker": "male", "text": "星期一上午第一节是数学课，第二节才是中文课。下午有体育课。今天我先把数学书拿出来，中文书还放在书包里。", "sha256": "f9f6d4ac56a2aedd329188a07db4d02cc9289ef6a9946eeb6e745be2d46ebafe"}, {"key": "c5b1d9675aba74bbd668ea00", "speaker": "female", "text": "第5题。", "sha256": "057a4202f7d25216a190a84d6056c30f42be93ac60cdc21879a97aaaf19252d9"}, {"key": "691b9e8ae7c8b1be93206125", "speaker": "female", "text": "老师，我的橡皮找不到了。", "sha256": "0f63351bc2b7949d70470f0fffec821ea895169ed88baa8a6d60d3f12b701679"}, {"key": "be5322404921018d1664f522", "speaker": "male", "text": "黑板旁边的红盒子里有橡皮，你拿一块吧。", "sha256": "16b071281bca98365c72e685cd3523ed38831c3ec64d9be009fa289385f9b01a"}, {"key": "a14d88f747a8dbb6e9d425f6", "speaker": "female", "text": "谢谢，我用完以后放回盒子。", "sha256": "62edaf923d257a34abe74a9305cb6fcda0a93c6c87a3ae2acdc8a5561908821b"}, {"key": "5e6c5b336701fe2c48b7fa2f", "speaker": "female", "text": "第6题。", "sha256": "fcc5b0fabad8f1fa79148054a17b60ac8d2cb351d57ed0d5eb073df550e3ee93"}, {"key": "a69c18b2d45f36045733f753", "speaker": "male", "text": "老师，今天的答案写在书上吗？", "sha256": "d3230972456152213eae2ec90c49bd5e85eb2338f58c4803f3607860a9f6841a"}, {"key": "8e44cf44bc0651a8155e92ee", "speaker": "female", "text": "不要写在书上，写在本子上。写完以后把本子交给我，书先放在桌子上。", "sha256": "dbde56347e2685b38557208dfb4d8435f450d59c75605658fbecb5df2dcad3a2"}, {"key": "79e0bdfd02236c1d4253adc0", "speaker": "female", "text": "第7题。", "sha256": "5151859d99f51fb43c1c4ba74a72c7d8898fd12ebdb151ca350243f27169a52c"}, {"key": "fb7f28d69734c8ebbbf5a70f", "speaker": "female", "text": "老师，这本书是谁的？不是我的，我的在书包里。", "sha256": "8a1666b85ce5e14c87952bf5ea6bb9a18fc213fc67d86142ec04030e739554a2"}, {"key": "2a6ebbc483a8f9b330a27ff8", "speaker": "male", "text": "我看看，上面写着小陈的名字。请你下课后把书给小陈。", "sha256": "f04e2f75c799b3d22ee3a8e32f2d880bbac4d216da1439ddcaa784765ee984f3"}, {"key": "b431efe26b8c6cc712ef43b8", "speaker": "female", "text": "第8题。", "sha256": "65ff1f952179bc643f6b488a3150eee5a21667f5901053151fd7aeb53f0c7786"}, {"key": "9b2a30faedadb4fd1a96f40a", "speaker": "male", "text": "明天体育课，每人带一瓶水和一条毛巾。不用自己带篮球，学校有。请大家穿运动鞋，准时到操场。", "sha256": "8639f40be71f84ff8b7f7647ed5b72b49694daee773add694b0efa9a0c8ea34d"}, {"key": "76f9b7034e5801a6360f40bd", "speaker": "female", "text": "第9题。", "sha256": "439f37e4f9738e7ac1dc180f588ae4ed900731c0623d4038b9f3533da20c0ada"}, {"key": "752d69bc67e64c2df49c4e5e", "speaker": "female", "text": "明天中文课几点下课？", "sha256": "5e1d07e98d262cfdc5c0b1f4f8cef2dc45fb186e6e7a318687e288d297e81554"}, {"key": "03b435e4e6a91bef3ced2f0d", "speaker": "male", "text": "八点开始，八点四十结束。休息以后，九点上英语课。", "sha256": "91b9183fa0e65a1d15a21fa5c957e281fa1b63cb6907634b1b190cefd6c28f97"}, {"key": "782c251488ae1c05c6efcb17", "speaker": "female", "text": "好，我八点四十来找你。", "sha256": "aa6b7340146f6f987fba407537ad495c4cd86de1ef27dfb0db642f4e818f20e8"}, {"key": "86d64da7bc27367110de5cb7", "speaker": "female", "text": "第10题。", "sha256": "a443b83201af7bae91780e167c2fcd53ef523b448bf77dd4ad6b238de2e582d2"}, {"key": "1d4345766521131c98f64878", "speaker": "male", "text": "这碗汤已经凉了，能换一碗热的吗？", "sha256": "b2601c6e7c3dc71b35dd878d3b332982c42dfeba2e6354cc489ca501c2a84f0e"}, {"key": "8f063f9d6a748731a7d8f353", "speaker": "female", "text": "可以，我给您换热汤。", "sha256": "97712f23575ae007f1b4119a1b45c5c795ffb7df30629c0a19f0d706d26a8dfd"}, {"key": "093cf677a2e06c89f470e170", "speaker": "male", "text": "谢谢，天气有点儿冷，我想喝热的。", "sha256": "e86c0544ebe13f977ee8f3874cf8c1a06ca6a4b4cb5d19af72f95e4b5ad0f47b"}, {"key": "63d3dd3f27ad85dca9aa0606", "speaker": "female", "text": "第11题。", "sha256": "09609165ce7b5b5bbc80de6236e7726415e2ab45d65241e1ca3c75ec4a697f32"}, {"key": "5a60ba3c3bfc037ccb7cf7ef", "speaker": "female", "text": "这份午饭在这儿吃吗？", "sha256": "f7aecbe8731167914781120f2a2490fc7c75b74122834083e8803db995c7a205"}, {"key": "0f5492c576d9763a39bfc0e9", "speaker": "male", "text": "不，我要带回家吃。家里还有人在等我。请帮我装好，筷子我家里有，不用给了。", "sha256": "01f611589c00a8d42734b5d807351482a6cc1f58164245c6aabaf16f4eb95246"}, {"key": "2dbff9b332f7edc61b4c3c18", "speaker": "female", "text": "第12题。", "sha256": "f25ea7d43ed9f81b7dd1af25fa0339498c7d458e79931122755e838f8d314a83"}, {"key": "eb5c8ca888ee01fda3bd37f8", "speaker": "female", "text": "妈妈喜欢吃西瓜，爸爸喜欢苹果。我最喜欢橙子。今天我给他们买西瓜和苹果，也给自己买了几个橙子。", "sha256": "841924a7ee384f2d057f8aeeb365a1cf4ccae8b437a793a5810741782b8dded0"}, {"key": "ec1acc6c51d958bc6eb290a5", "speaker": "female", "text": "第13题。", "sha256": "e6515323a9eef38c0320124c2e99d81f002d229d597de7f44a76008521622c43"}, {"key": "3765789f563e054b5a55e897", "speaker": "male", "text": "面条八块，加一个鸡蛋一共多少钱？", "sha256": "0d1616a77c2a85c4fc15441cea254ac3e500ea048430e63b5733bf8ab0f03cf6"}, {"key": "ab3d5f89d4e69008a7c149d8", "speaker": "female", "text": "一共十块。", "sha256": "89693b60331188272281f332b11c302c1f5bf92a1dc90a99e1d35e77ebbe5b1d"}, {"key": "e9062bffbcb5a4bbdbef3dcc", "speaker": "male", "text": "好，我给你十块。", "sha256": "80e8be1c1ab51483575d0003f7bb215762af63b59572f088f145c982547d606c"}, {"key": "f15a422dc3d853029630f804", "speaker": "female", "text": "谢谢，请在旁边等一下。", "sha256": "9a31a8f47d667fe8158caf6a44c4c1ce8e10f1a62f0ec1ab004af4dea52a6983"}, {"key": "6a9458d981e42c448c56e5d7", "speaker": "female", "text": "第14题。", "sha256": "3c248ca1222db546caafa3ccef0afeb1d63689c8e501a91b906f7c38012bc8f4"}, {"key": "8f40d400fe094147ae1da6cb", "speaker": "female", "text": "这件小号上衣有点儿小。能试试中号吗？", "sha256": "131b5a75d8e9c31d4443b982c4313f96aaf8bffd6fb7d19313dcf8fd6c9831be"}, {"key": "fc071e8f7fd31df030e52072", "speaker": "male", "text": "可以，这里有中号和大号。", "sha256": "ba98b1248df350a439e3bca61630136876c3770b7ceed7562c917ad2c67c6e5c"}, {"key": "440ad801a18c08c033a50e73", "speaker": "female", "text": "中号正好，我就要中号的。", "sha256": "6e79673949b82488a0f2666e65f43d4416cb0ac4f7bb1f16ada9af790504940d"}, {"key": "9d1b8c046279c5b498214791", "speaker": "female", "text": "第15题。", "sha256": "774136cf8893575562e62fc53ca824d970e119df2986004fbc9a795341529ed7"}, {"key": "da3e6b1ca84d560c8c643c9a", "speaker": "male", "text": "我们下午三点见，好吗？", "sha256": "00f876f67142d98ef878c5c5299514f89dce15b5894d4d7c478dfc80604a20aa"}, {"key": "61644d2aa36b28f9c5564d96", "speaker": "female", "text": "我两点半就到了，可以早一点见吗？", "sha256": "1e3ac337f72adcfcd6e8431910eadb78b1878d379bb5903fe0104da21653ebb8"}, {"key": "ad96bff633d5bee65206b88e", "speaker": "male", "text": "可以，那我们两点半见，我也早点出门。", "sha256": "47aac3fad37fbd3da832e6510ce4746ebee934c2e8e1b35b88c84782342b829f"}, {"key": "0cffbf1010d1e54023057ea9", "speaker": "female", "text": "第16题。", "sha256": "6cbe22b4463ef0127dbcb5957919648ee9b071c97d70d0b85edf327b6a0071df"}, {"key": "10748e13eae548d0fa55f364", "speaker": "female", "text": "这班车九点开。我们八点半从家里出发，八点四十到车站。到了以后先买票，再一起等车。", "sha256": "07b150e30e598afc6badf186d46d576a2e7381aa7bcdc4922cc9e0fac05c4dad"}, {"key": "61f4d2e4e5f3e0536be36453", "speaker": "female", "text": "第17题。", "sha256": "7b303e3cdea4e6b338b981ca7d27218c5da50fd4e2ca1cb297c3ba0853fbff6b"}, {"key": "c6144255b5503089e10bb3d8", "speaker": "male", "text": "明天学校活动，我们穿什么衣服？", "sha256": "77613c98b8b0b936f8714bbd4f02b759ea4088427937019cbb800e3190a32afe"}, {"key": "c82b218c1abca3110a596984", "speaker": "female", "text": "白色上衣、黑色裤子。鞋子没有要求。", "sha256": "cafe25fc29397adccda85adbe475073a38d968f84cb3979555afa5a476909fbd"}, {"key": "ee920122b04dca0a1c5825b9", "speaker": "male", "text": "好，我穿黑裤子和蓝色运动鞋。", "sha256": "2195866c524c5fb1532b144a11b2b45bc4b49d635d03f7ec5376821ea65b344c"}, {"key": "2e9092b1191d42999a9f695d", "speaker": "female", "text": "第18题。", "sha256": "b0832c56a97774c35b538f689f08bf8314e263e14ab809871867bcdede27a70b"}, {"key": "161fdc5abef3c12a1dfc97e1", "speaker": "male", "text": "姐姐很会唱歌，弟弟喜欢画画。我不会唱歌，可是会弹钢琴。周六下午，我们想一起给爸爸妈妈表演。", "sha256": "7603c04c6a76c5ecf53a49bee10ffbf0d1965da1cb2fbb73ccebd6defff7bfbd"}, {"key": "ee9540a1a810afba0a3a7056", "speaker": "female", "text": "第19题。", "sha256": "91a1a230e642a4906da5e058c485a56cf6a1c77b67c899338da1843b7db5066e"}, {"key": "ad9f52fecc66d91d19bd49ff", "speaker": "female", "text": "今天放学后一起去游泳吗？", "sha256": "b6d1a79cfbe5eacb8b365acc2b6ef004646e3fdff4ee862c15835ceb37d8cc62"}, {"key": "9c6bbfaac03a6051e26ae40f", "speaker": "male", "text": "今天我不去游泳，我想在家看书。明天再去游泳。", "sha256": "ca9aa3a7854cb651627697dfb3bdfec56c0a64c4ae6b438dcd3fabe4988f5e98"}, {"key": "7c48946294cb8a996383b84a", "speaker": "female", "text": "好，那我们明天下午见。", "sha256": "95843f95e0a5efb39593a12f13f8947ab6dcfa914e8e0270b67a66f1fde5f4c6"}, {"key": "689adfbaa5b63ac16b96aac6", "speaker": "female", "text": "第20题。", "sha256": "f2a7aa65a74fad7dc9d19d81d6990ac99260287106ff304656efb599e75400e1"}, {"key": "b3a4528b2d4012d716d50b02", "speaker": "female", "text": "你在哪个学校上学？你是哪个班的学生？", "sha256": "cdc8f7186ae236eeb80d29c78f61d49bdbe693ba52c42a177b2765ce1cb7bc8d"}, {"key": "f9a6df4e96e9f82e8467d933", "speaker": "female", "text": "你喜欢什么颜色？喜欢穿什么衣服？", "sha256": "c9c6358a0b586be6c16e8754e405404bf69f3bcf88f4306cd9cd9ca13fba60d3"}, {"key": "a77fc71784c9848bc0d6da9d", "speaker": "female", "text": "周末你几点吃午饭？吃完饭做什么？", "sha256": "aff4adf6213bbed79f27249e32aa4999a3f44250de779d5fe9f75d5dae679a7e"}, {"key": "e1efb80a72fdc00c28ff83f4", "speaker": "female", "text": "星期六一起唱歌，好吗？我们在哪儿见面？", "sha256": "1b7e401b1019ddb42fd6d31f577a780b3e63fe75924ae53a108e36127f31a317"}]}</script><script src="workspace.js" defer></script><noscript>Use the learner PDF and audio review if JavaScript is unavailable.</noscript></body></html>