<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="robots" content="noindex,nofollow"><title>Optional practice support</title><base href="/api/v1/course-tests/chinese-1/c/file/"><link rel="stylesheet" href="paper.css"></head><body><main><header class="hero"><p class="eyebrow">HSKKit · Chinese 1 Course Review · Original Paper C</p><h1>Optional practice support</h1><p>40 listening/reading questions + 4 writing/speaking tasks. Independent course-review draft.</p><p class="note">Printable materials and answer references. Open the workspace to practise with section clocks and local recording. Writing and speaking need manual review.</p><nav class="links"><a href="index.html">Overview</a><a href="student.html">Learner paper</a><a href="teacher.html">Answers &amp; scripts</a><a href="listening.html">Listen to Paper C</a><a href="student.pdf">Learner PDF</a><a href="student-traditional.pdf">繁體 PDF</a><a href="teacher.pdf">Answer PDF</a></nav></header><section class="box"><p>This optional preparation list is not part of the timed paper. Using it during an attempt changes the support condition.</p><table><tr><th>Chinese</th><th>Pinyin</th><th>Meaning</th></tr><tr><td class="cn">陪</td><td>péi</td><td>accompany</td></tr><tr><td class="cn">练</td><td>liàn</td><td>practise</td></tr><tr><td class="cn">厨房</td><td>chúfáng</td><td>kitchen</td></tr><tr><td class="cn">客厅</td><td>kètīng</td><td>living room</td></tr><tr><td class="cn">上衣</td><td>shàngyī</td><td>top / upper-body garment</td></tr><tr><td class="cn">橡皮</td><td>xiàngpí</td><td>eraser</td></tr><tr><td class="cn">毛巾</td><td>máojīn</td><td>towel</td></tr><tr><td class="cn">筷子</td><td>kuàizi</td><td>chopsticks</td></tr><tr><td class="cn">汤</td><td>tāng</td><td>soup</td></tr><tr><td class="cn">袜子</td><td>wàzi</td><td>socks</td></tr><tr><td class="cn">皮鞋</td><td>píxié</td><td>leather shoes</td></tr><tr><td class="cn">讲台</td><td>jiǎngtái</td><td>teacher’s desk / platform</td></tr><tr><td class="cn">阅览室</td><td>yuèlǎnshì</td><td>reading room</td></tr><tr><td class="cn">擦</td><td>cā</td><td>wipe</td></tr><tr><td class="cn">洗碗</td><td>xǐ wǎn</td><td>wash dishes</td></tr><tr><td class="cn">弹钢琴</td><td>tán gāngqín</td><td>play the piano</td></tr><tr><td class="cn">窗口</td><td>chuāngkǒu</td><td>service window</td></tr><tr><td class="cn">请假</td><td>qǐngjià</td><td>take leave</td></tr></table></section></main></body></html>