  "humanListeningAcceptance": false,
  "units": [
    {
      "id": "C2C-M01",
      "kind": "listening-source",
      "sourcePlays": 1,
      "script": [
        {
          "speaker": "male",
          "text": {
            "zh-Hans": "姑妈今晚住我们家，客房还没整理。",
            "zh-Hant": "姑媽今晚住我們家，客房還沒整理。"
          }
        },
        {
          "speaker": "female",
          "text": {
            "zh-Hans": "你去车站接她吧，房间我来收拾。水果弟弟已经买好了。",
            "zh-Hant": "你去車站接她吧，房間我來收拾。水果弟弟已經買好了。"
          }
        },
        {
          "speaker": "male",
          "text": {
            "zh-Hans": "好，我现在去车站。",
            "zh-Hant": "好，我現在去車站。"
          }
        }
      ],
      "sourceDurationSeconds": 13.564,
      "src": "assets/audio/c2c-m01.mp3",
      "durationSeconds": 14.112,
      "pcmSeconds": 14.064,
      "bytes": 113132,
      "sha256": "f98a97c240cabf7508fda14f5ba8cb9799c6715ebc1d17838b78863aa1554957"
    },
    {
      "id": "C2C-M02",
      "kind": "listening-source",
      "sourcePlays": 1,
      "script": [
        {
          "speaker": "female",
          "text": {
            "zh-Hans": "舅舅的火车六点到站，是不是六点就吃晚饭？",
            "zh-Hant": "舅舅的火車六點到站，是不是六點就喫晚飯？"
          }
        },
        {
          "speaker": "male",
          "text": {
            "zh-Hans": "不行，从车站到家还要四十分钟。我们七点开饭，先让他把行李放好。",
            "zh-Hant": "不行，從車站到家還要四十分鐘。我們七點開飯，先讓他把行李放好。"
          }
        },
        {
          "speaker": "female",
          "text": {
            "zh-Hans": "好，七点一起吃。",
            "zh-Hant": "好，七點一起喫。"
          }
        }
      ],
      "sourceDurationSeconds": 15.892,
      "src": "assets/audio/c2c-m02.mp3",
      "durationSeconds": 16.44,
      "pcmSeconds": 16.392,
      "bytes": 131756,
      "sha256": "84c57823567184f4ec59a93e17b1033cb2b1d8299f6fff8085e7da8bf5d974b9"
    },
    {
      "id": "C2C-M03",
      "kind": "listening-source",
      "sourcePlays": 1,
      "script": [
        {
          "speaker": "male",
          "text": {
            "zh-Hans": "我们平时各自在家吃饭，每个月的第一个和第三个星期日，才去奶奶家一起吃。我每个月去两次，不是每个星期都去，也不是每天去。",
            "zh-Hant": "我們平時各自在家喫飯，每個月的第一個和第三個星期日，纔去奶奶家一起喫。我每個月去兩次，不是每個星期都去，也不是每天去。"
          }
        }
      ],
      "sourceDurationSeconds": 11.976,
      "src": "assets/audio/c2c-m03.mp3",
      "durationSeconds": 12.528,
      "pcmSeconds": 12.476,
      "bytes": 100460,
      "sha256": "637520c74cdfc6fd4bcc3691afca035f1aa673b35cc343df86308be5e0bdb9ae"
    },
    {
      "id": "C2C-M04",
      "kind": "listening-source",
      "sourcePlays": 1,
      "script": [
        {
          "speaker": "female",
          "text": {
            "zh-Hans": "我周日下午有空，想骑一段平路，不想上坡。",
            "zh-Hant": "我週日下午有空，想騎一段平路，不想上坡。"
          }
        },
        {
          "speaker": "male",
          "text": {
            "zh-Hans": "山边的路一直能骑，可是有坡；学校里的平路周日不开。河边的平路下午开放。",
            "zh-Hant": "山邊的路一直能騎，可是有坡；學校裏的平路週日不開。河邊的平路下午開放。"
          }
        },
        {
          "speaker": "female",
          "text": {
            "zh-Hans": "那就去河边。",
            "zh-Hant": "那就去河邊。"
          }
        }
      ],
      "sourceDurationSeconds": 15.772,
      "src": "assets/audio/c2c-m04.mp3",
      "durationSeconds": 16.32,
      "pcmSeconds": 16.272,
      "bytes": 130796,
      "sha256": "8c3b8383888fe9c6a3c40127156b93af97cb504ab7bf5d2790f22eda665b6d42"
    },
    {
      "id": "C2C-M05",
      "kind": "listening-source",
      "sourcePlays": 1,
      "script": [
        {
          "speaker": "male",
          "text": {
            "zh-Hans": "小林以前骑车总要和朋友比快。昨天他没有看用时，慢慢骑了一圈，还停下拍了几张照片。回家以后他说，这次比以前轻松，以后还想这样骑。",
            "zh-Hant": "小林以前騎車總要和朋友比快。昨天他沒有看用時，慢慢騎了一圈，還停下拍了幾張照片。回家以後他說，這次比以前輕鬆，以後還想這樣騎。"
          }
        }
      ],
      "sourceDurationSeconds": 13.752,
      "src": "assets/audio/c2c-m05.mp3",
      "durationSeconds": 14.304,
      "pcmSeconds": 14.252,
      "bytes": 114668,
      "sha256": "053b7232f1505f93098664f247f7e65ab4efd5904677fb8fde1585533120b0fe"
    },
    {
      "id": "C2C-M06",
      "kind": "listening-source",
      "sourcePlays": 1,
      "script": [
        {
          "speaker": "male",
          "text": {
            "zh-Hans": "我们在老菜市场门口见吗？",
            "zh-Hant": "我們在老菜市場門口見嗎？"
          }
        },
        {
          "speaker": "female",
          "text": {
            "zh-Hans": "今天要去的是社区新市场，在邮局旁边。老菜市场已经关了，别去错。",
            "zh-Hant": "今天要去的是社區新市場，在郵局旁邊。老菜市場已經關了，別去錯。"
          }
        },
        {
          "speaker": "male",
          "text": {
            "zh-Hans": "明白，我在新市场东门等你。",
            "zh-Hant": "明白，我在新市場東門等你。"
          }
        }
      ],
      "sourceDurationSeconds": 15.412,
      "src": "assets/audio/c2c-m06.mp3",
      "durationSeconds": 15.96,
      "pcmSeconds": 15.912,
      "bytes": 127916,
      "sha256": "9adcf689408fa8a1eba357041b14c26024479c020c7614ae6e7f7747f2e752f4"
    },
    {
      "id": "C2C-M07",
      "kind": "listening-source",
      "sourcePlays": 1,
      "script": [
        {
          "speaker": "female",
          "text": {
            "zh-Hans": "公交车去市场要绕路，得坐半个小时。",
            "zh-Hant": "公交車去市場要繞路，得坐半個小時。"
          }
        },
        {
          "speaker": "male",
          "text": {
            "zh-Hans": "从这里走过去只要十分钟，我今天也没带自行车。",
            "zh-Hant": "從這裏走過去只要十分鐘，我今天也沒帶自行車。"
          }
        },
        {
          "speaker": "female",
          "text": {
            "zh-Hans": "那我们走路去，买好东西再看怎么回来。",
            "zh-Hant": "那我們走路去，買好東西再看怎麼回來。"
          }
        }
      ],
      "sourceDurationSeconds": 14.524,
      "src": "assets/audio/c2c-m07.mp3",
      "durationSeconds": 15.072,
      "pcmSeconds": 15.024,
      "bytes": 120812,
      "sha256": "b28f963fa2f66e07a9a7e1edba725fd77135d2cc4a8acf5f9b9eaf1cad087416"
    },
    {
      "id": "C2C-M08",
      "kind": "listening-source",
      "sourcePlays": 1,
      "script": [
        {
          "speaker": "male",
          "text": {
            "zh-Hans": "市场南门前修路，从车站出来怎么走？",
            "zh-Hant": "市場南門前修路，從車站出來怎麼走？"
          }
        },
        {
          "speaker": "female",
          "text": {
            "zh-Hans": "先沿河向北走，到了小桥再过河。过桥后就是市场北门，不要从南门硬走过去。",
            "zh-Hant": "先沿河向北走，到了小橋再過河。過橋後就是市場北門，不要從南門硬走過去。"
          }
        },
        {
          "speaker": "male",
          "text": {
            "zh-Hans": "好，先往北。",
            "zh-Hant": "好，先往北。"
          }
        }
      ],
      "sourceDurationSeconds": 16.444,
      "src": "assets/audio/c2c-m08.mp3",
      "durationSeconds": 16.992,
      "pcmSeconds": 16.944,
      "bytes": 136172,
      "sha256": "a37235858ff9a64e9bb6c392ff4c16398bb8abf601294a7407903a43d98d086e"
    },
    {
      "id": "C2C-M09",
      "kind": "listening-source",
      "sourcePlays": 1,
      "script": [
        {
          "speaker": "female",
          "text": {
            "zh-Hans": "去市场的班车九点四十到，只收现金。公交车九点五十到，可以刷交通卡。",
            "zh-Hant": "去市場的班車九點四十到，只收現金。公交車九點五十到，可以刷交通卡。"
          }
        },
        {
          "speaker": "male",
          "text": {
            "zh-Hans": "我十点前要到，身上只有交通卡，没有现金，坐公交吧。",
            "zh-Hant": "我十點前要到，身上只有交通卡，沒有現金，坐公交吧。"
          }
        }
      ],
      "sourceDurationSeconds": 14.678,
      "src": "assets/audio/c2c-m09.mp3",
      "durationSeconds": 15.24,
      "pcmSeconds": 15.178,
      "bytes": 122156,
      "sha256": "2e1576d04ac9fce3fb3eff1d726e573b3d97a9241326107db52d588b732bafae"
    },
    {
      "id": "C2C-M10",
      "kind": "listening-source",
      "sourcePlays": 1,
      "script": [
        {
          "speaker": "male",
          "text": {
            "zh-Hans": "周日风太大，带客人去放风筝的事怎么办？",
            "zh-Hant": "週日風太大，帶客人去放風箏的事怎麼辦？"
          }
        },
        {
          "speaker": "female",
          "text": {
            "zh-Hans": "先在家教大家做纸风筝吧，做好留着，下星期天气合适再出去放。",
            "zh-Hant": "先在家教大家做紙風箏吧，做好留着，下星期天氣合適再出去放。"
          }
        },
        {
          "speaker": "male",
          "text": {
            "zh-Hans": "好，周日就在家做。",
            "zh-Hant": "好，週日就在家做。"
          }
        }
      ],
      "sourceDurationSeconds": 15.316,
      "src": "assets/audio/c2c-m10.mp3",
      "durationSeconds": 15.864,
      "pcmSeconds": 15.816,
      "bytes": 127148,
      "sha256": "a7d30f22dad383cd45a93f98213b789aabf5c4dc6ff9d5e5374c97e553879411"
    },
    {
      "id": "C2C-M11",
      "kind": "listening-source",
      "sourcePlays": 1,
      "script": [
        {
          "speaker": "female",
          "text": {
            "zh-Hans": "姑妈和叔叔两家都来，每个人都送一盒饼干吗？",
            "zh-Hant": "姑媽和叔叔兩家都來，每個人都送一盒餅乾嗎？"
          }
        },
        {
          "speaker": "male",
          "text": {
            "zh-Hans": "不用按人数送，每家一盒，一共两盒。茶叶另外带一袋，留在家里大家一起喝。",
            "zh-Hant": "不用按人數送，每家一盒，一共兩盒。茶葉另外帶一袋，留在家裏大家一起喝。"
          }
        }
      ],
      "sourceDurationSeconds": 13.79,
      "src": "assets/audio/c2c-m11.mp3",
      "durationSeconds": 14.352,
      "pcmSeconds": 14.29,
      "bytes": 115052,
      "sha256": "4bc56afe31f21e72cb7579e79e6d431ef8eeb6c0b12ab62ebe88ad943adf64a2"
    },
    {
      "id": "C2C-M12",
      "kind": "listening-source",
      "sourcePlays": 1,
      "script": [
        {
          "speaker": "male",
          "text": {
            "zh-Hans": "这三种杯子，你想送哪一种给叔叔？",
            "zh-Hant": "這三種杯子，你想送哪一種給叔叔？"
          }
        },
        {
          "speaker": "female",
          "text": {
            "zh-Hans": "叔叔喜欢小杯子，而且一定要有把手。这只小号带把手的就合适，大号和没把手的都不要。",
            "zh-Hant": "叔叔喜歡小杯子，而且一定要有把手。這隻小號帶把手的就合適，大號和沒把手的都不要。"
          }
        }
      ],
      "sourceDurationSeconds": 14.246,
      "src": "assets/audio/c2c-m12.mp3",
      "durationSeconds": 14.808,
      "pcmSeconds": 14.746,
      "bytes": 118700,
      "sha256": "1f5d6876d7d7ec33e5cb76084a1a350d34e1aeaea2506cac16a14f5f4ed85de7"
    },
    {
      "id": "C2C-M13",
      "kind": "listening-source",
      "sourcePlays": 1,
      "script": [
        {
          "speaker": "female",
          "text": {
            "zh-Hans": "茶叶一小袋六块，三袋散着买十八块。装成这套礼盒要二十五块，盒子和包装都算在里面。",
            "zh-Hant": "茶葉一小袋六塊，三袋散着買十八塊。裝成這套禮盒要二十五塊，盒子和包裝都算在裏面。"
          }
        },
        {
          "speaker": "male",
          "text": {
            "zh-Hans": "我要这套包好的礼盒，送给客人。",
            "zh-Hant": "我要這套包好的禮盒，送給客人。"
          }
        }
      ],
      "sourceDurationSeconds": 13.646,
      "src": "assets/audio/c2c-m13.mp3",
      "durationSeconds": 14.208,
      "pcmSeconds": 14.146,
      "bytes": 113900,
      "sha256": "fd6b6fda935f574847a8e41ad0b4ed752d7667033a5b39982feb86578874a092"
    },
    {
      "id": "C2C-M14",
      "kind": "listening-source",
      "sourcePlays": 1,
      "script": [
        {
          "speaker": "male",
          "text": {
            "zh-Hans": "客人明天坐火车走，想带一件轻又不容易碎的礼物。",
            "zh-Hant": "客人明天坐火車走，想帶一件輕又不容易碎的禮物。"
          }
        },
        {
          "speaker": "female",
          "text": {
            "zh-Hans": "玻璃杯不合适，大花瓶也重。围巾很轻，折起来就能放进包里，不用担心打碎。",
            "zh-Hant": "玻璃杯不合適，大花瓶也重。圍巾很輕，折起來就能放進包裏，不用擔心打碎。"
          }
        },
        {
          "speaker": "male",
          "text": {
            "zh-Hans": "那选围巾。",
            "zh-Hant": "那選圍巾。"
          }
        }
      ],
      "sourceDurationSeconds": 16.588,
      "src": "assets/audio/c2c-m14.mp3",
      "durationSeconds": 17.136,
      "pcmSeconds": 17.088,
      "bytes": 137324,
      "sha256": "b6410080939c9fa79cfd387b1926f7486e03049ed89bc7ae3e8a4909496c6c33"
    },
    {
      "id": "C2C-M15",
      "kind": "listening-source",
      "sourcePlays": 1,
      "script": [
        {
          "speaker": "female",
          "text": {
            "zh-Hans": "客人六点来，你几点能到家？",
            "zh-Hant": "客人六點來，你幾點能到家？"
          }
        },
        {
          "speaker": "male",
          "text": {
            "zh-Hans": "我六点才到，来不及准备。",
            "zh-Hant": "我六點纔到，來不及準備。"
          }
        },
        {
          "speaker": "female",
          "text": {
            "zh-Hans": "我五点就到。那我先把客厅椅子摆好，你回来陪客人聊天，晚饭弟弟已经订了。",
            "zh-Hant": "我五點就到。那我先把客廳椅子擺好，你回來陪客人聊天，晚飯弟弟已經訂了。"
          }
        }
      ],
      "sourceDurationSeconds": 15.244,
      "src": "assets/audio/c2c-m15.mp3",
      "durationSeconds": 15.792,
      "pcmSeconds": 15.744,
      "bytes": 126572,
      "sha256": "d363125c168207e4518bf3e05b57787ad76d7baffdbc4a36232f2ce1b3bd339e"
    },
    {
      "id": "C2C-M16",
      "kind": "listening-source",
      "sourcePlays": 1,
      "script": [
        {
          "speaker": "male",
          "text": {
            "zh-Hans": "早上外面几乎没有风，可是预报说下午风会大很多，晚上也不会马上停。今天气温变化不大，想骑车的同学要注意下午的风，别只看早上的天气。",
            "zh-Hant": "早上外面幾乎沒有風，可是預報說下午風會大很多，晚上也不會馬上停。今天氣溫變化不大，想騎車的同學要注意下午的風，別隻看早上的天氣。"
          }
        }
      ],
      "sourceDurationSeconds": 13.824,
      "src": "assets/audio/c2c-m16.mp3",
      "durationSeconds": 14.376,
      "pcmSeconds": 14.324,
      "bytes": 115244,
      "sha256": "8321421c62917085c61451196be5ee2d6b8949b74329f87214ae1558a1b6717e"
    },
    {
      "id": "C2C-M17",
      "kind": "listening-source",
      "sourcePlays": 1,
      "script": [
        {
          "speaker": "female",
          "text": {
            "zh-Hans": "今天为什么把写贺卡的桌子搬进屋？外面也没有下雨啊。",
            "zh-Hant": "今天爲什麼把寫賀卡的桌子搬進屋？外面也沒有下雨啊。"
          }
        },
        {
          "speaker": "male",
          "text": {
            "zh-Hans": "风太大，纸一直被吹走。我们在屋里写完，再拿出去给客人看，时间还是三点。",
            "zh-Hant": "風太大，紙一直被吹走。我們在屋裏寫完，再拿出去給客人看，時間還是三點。"
          }
        }
      ],
      "sourceDurationSeconds": 14.606,
      "src": "assets/audio/c2c-m17.mp3",
      "durationSeconds": 15.168,
      "pcmSeconds": 15.106,
      "bytes": 121580,
      "sha256": "1f4d6bc48b7aac2cd63621ce956b742c933f42617196c66068d87813e02d3408"
    },
    {
      "id": "C2C-M18",
      "kind": "listening-source",
      "sourcePlays": 1,
      "script": [
        {
          "speaker": "male",
          "text": {
            "zh-Hans": "明天骑车在广场集合，那里能装水吗？",
            "zh-Hant": "明天騎車在廣場集合，那裏能裝水嗎？"
          }
        },
        {
          "speaker": "female",
          "text": {
            "zh-Hans": "没有饮用水，来以前要在家装好一瓶。路上商店也没开，别到了广场才找水。",
            "zh-Hant": "沒有飲用水，來以前要在家裝好一瓶。路上商店也沒開，別到了廣場才找水。"
          }
        },
        {
          "speaker": "male",
          "text": {
            "zh-Hans": "好，我出门前装好。",
            "zh-Hant": "好，我出門前裝好。"
          }
        }
      ],
      "sourceDurationSeconds": 16.516,
      "src": "assets/audio/c2c-m18.mp3",
      "durationSeconds": 17.064,
      "pcmSeconds": 17.016,
      "bytes": 136748,
      "sha256": "a52a22935688140a8912c7e0d68a550816431cbf2e19a5bb4b49d6d5704146f8"
    },
    {
      "id": "C2C-M19",
      "kind": "listening-source",
      "sourcePlays": 1,
      "script": [
        {
          "speaker": "female",
          "text": {
            "zh-Hans": "去年中秋，我们先给住在外地的姐姐打电话。吃完晚饭，全家一起分月饼。后来月亮出来了，才到阳台拍照。姐姐看了照片，说好像也和我们坐在一起。",
            "zh-Hant": "去年中秋，我們先給住在外地的姐姐打電話。喫完晚飯，全家一起分月餅。後來月亮出來了，纔到陽臺拍照。姐姐看了照片，說好像也和我們坐在一起。"
          }
        }
      ],
      "sourceDurationSeconds": 16.128,
      "src": "assets/audio/c2c-m19.mp3",
      "durationSeconds": 16.68,
      "pcmSeconds": 16.628,
      "bytes": 133676,
      "sha256": "993b09147aab5fbbe0a18b3a62ca5ad0b8581eef178873352716c5a4c70e3d07"
    },
    {
      "id": "C2C-M20",
      "kind": "listening-source",
      "sourcePlays": 1,
      "script": [
        {
          "speaker": "male",
          "text": {
            "zh-Hans": "哥哥出差不能回来，奶奶起初说今年中秋少了一个人。后来我们接通视频，哥哥也在屏幕那边吃饭。奶奶一直笑，还请我们把手机放近一点儿，好让她看清哥哥。",
            "zh-Hant": "哥哥出差不能回來，奶奶起初說今年中秋少了一個人。後來我們接通視頻，哥哥也在屏幕那邊喫飯。奶奶一直笑，還請我們把手機放近一點兒，好讓她看清哥哥。"
          }
        }
      ],
      "sourceDurationSeconds": 15.312,
      "src": "assets/audio/c2c-m20.mp3",
      "durationSeconds": 15.864,
      "pcmSeconds": 15.812,
      "bytes": 127148,
      "sha256": "aae6cba3af83430e7924651c0e3222f42b5685401bd9a8030a99471ba5e2027c"
    },
    {
      "id": "S1-1",
      "kind": "oral-prompt",
      "sourcePlays": 2,
      "singlePlayPcmSeconds": 8.424,
      "repeatGapSeconds": 1.5,
      "singlePlayPcmSha256": "b1d5424ea8faa17674f6a9d9edb15c652354e028be2205524da08647493380b5",
      "script": {
        "zh-Hans": "家里明天有客人来，我们还需要买什么？请说一种东西，也可以说已经准备好了。",
        "zh-Hant": "家裏明天有客人來，我們還需要買什麼？請說一種東西，也可以說已經準備好了。"
      },
      "src": "assets/audio/s1-1.mp3",
      "durationSeconds": 18.408,
      "pcmSeconds": 18.348,
      "bytes": 147500,
      "sha256": "b3efa4d48e8862762c4c0e71b169e6812eebed10d9aa52de367fa1faf09d45eb"
    },
    {
      "id": "S1-2",
      "kind": "oral-prompt",
      "sourcePlays": 2,
      "singlePlayPcmSeconds": 6.144,
      "repeatGapSeconds": 1.5,
      "singlePlayPcmSha256": "deb190a6ad4106ca0a1490871d14638bec12b3714b86068fb90bddf0ef0fe437",
      "script": {
        "zh-Hans": "招待客人，你想选水果还是点心？也可以选别的东西。",
        "zh-Hant": "招待客人，你想選水果還是點心？也可以選別的東西。"
      },
      "src": "assets/audio/s1-2.mp3",
      "durationSeconds": 13.848,
      "pcmSeconds": 13.788,
      "bytes": 111020,
      "sha256": "591c1f261278b32ab8f8e3663bbb23832a4fae5b4fa53fa8a0a8924c03efc90d"
    },
    {
      "id": "S1-3",
      "kind": "oral-prompt",
      "sourcePlays": 2,
      "singlePlayPcmSeconds": 5.952,
      "repeatGapSeconds": 1.5,
      "singlePlayPcmSha256": "c1abe5f4577b1d06f6eca393e439c55cfacff91918f7535682f2666f4b81241c",
      "script": {
        "zh-Hans": "这个选择有什么好处？给我说一个和客人有关的理由吧。",
        "zh-Hant": "這個選擇有什麼好處？給我說一個和客人有關的理由吧。"
      },
      "src": "assets/audio/s1-3.mp3",
      "durationSeconds": 13.464,
      "pcmSeconds": 13.404,
      "bytes": 107948,
      "sha256": "409424f55284c387ed0a15f7c45367bf2667ed9b3942e5517d6f70ab22ea61a0"
    },
    {
      "id": "S1-4",
      "kind": "oral-prompt",
      "sourcePlays": 2,
      "singlePlayPcmSeconds": 6.864,
      "repeatGapSeconds": 1.5,
      "singlePlayPcmSha256": "9be4e3a1e0ffa84e2dba894958bf3dc0859258136818a6a3b9fe7c1c8396cc0f",
      "script": {
        "zh-Hans": "市场今天四点就关门，原来五点去来不及了。你准备怎么调整？",
        "zh-Hant": "市場今天四點就關門，原來五點去來不及了。你準備怎麼調整？"
      },
      "src": "assets/audio/s1-4.mp3",
      "durationSeconds": 15.288,
      "pcmSeconds": 15.228,
      "bytes": 122540,
      "sha256": "ef9e2d7c3186fb1502302688899be20e507390f149ee46eac38ed14f138de243"
    }
  ],
