<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="robots" content="noindex,nofollow"><base href="/api/v1/course-tests/chinese-2/c/file/"><title>Chinese 2 · Paper C · HSKKit</title><link rel="stylesheet" href="workspace.css"></head><body><header class="bar"><a class="brand" href="/">HSKKit</a><a href="/chinese-course-tests#chinese-2">← Chinese 2 papers</a></header><div id="live" class="live" aria-live="polite"></div><div id="clockbar" class="clockbar" hidden><strong id="clock" role="timer"></strong><span id="oral-clock" role="timer"></span></div><div id="audio-dock" class="audio-dock" hidden><strong id="audio-label"></strong><audio id="listening-player" controls preload="metadata"></audio><p id="audio-error" role="alert" hidden>Audio could not load. Retry or open Audio review.</p></div><main id="app"></main><audio id="prompt-player" preload="none"></audio><footer><p>Independent HSKKit course review. Writing and speaking need manual review. Not an official school, HSK or ACTFL assessment.</p><a href="listening.html">Audio review</a> · <a href="teacher.html">Answer guide</a></footer><script id="paper-data" type="application/json">{"id": "course-chinese-2-c-v1", "product": "HSKKit Chinese 2 Course Review", "paperCode": "C", "version": "content-draft-v1", "authoredOn": "2026-11-10", "status": "content_authored_independent_acceptance_pending", "officialExam": false, "purpose": "Review HSKKit Chinese 2 scope only; no school credit, placement or official level conversion.", "blueprint": {"id": "course-chinese-2-blueprint-v1", "source": "docs/course-chinese2-spec-20261110/blueprint.json", "sha256": "aa5a92d630a8e6063448555a90ce684a2b1569012b15be2b11f686e902575dae"}, "provenance": {"original": true, "aiAssisted": true, "competitorQuestionsCopied": false, "relabelledHskQuestions": false, "humanListeningAcceptance": false, "teacherReview": false, "learnerPilot": false, "userAcceptance": false, "traditionalScript": "OpenCC s2t with author comparison; independent review pending"}, "order": ["listening", "reading", "writing", "speaking"], "sections": [{"id": "listening", "seconds": 1200, "objectiveItems": 20, "groups": 4, "itemsPerGroup": 5, "sourcePlays": 2}, {"id": "reading", "seconds": 1500, "objectiveItems": 20, "groups": 4, "itemsPerGroup": 5}, {"id": "writing", "seconds": 1200, "manualTasks": 2, "sharedClock": true}, {"id": "speaking", "seconds": 600, "manualTasks": 2}], "counts": {"listening": 20, "reading": 20, "writing": 2, "speaking": 2, "speakingRecordings": 5, "topLevelTasks": 44}, "scoring": {"listeningMax": 20, "readingMax": 20, "pointsPerObjectiveItem": 1, "incorrectOrUnansweredPoints": 0, "manualTaskMax": 8, "combinedScore": null, "passCutoff": null, "officialConversion": null, "unsubmittedManual": "unsubmitted", "technicalFailureManual": "needs_rerecording"}, "materials": [{"id": "C2C-M01", "title": "Preparing for an overnight visitor", "section": "listening", "kind": "short-audio", "original": true, "script": [{"speaker": "male", "text": {"zh-Hans": "姑妈今晚住我们家，客房还没整理。", "zh-Hant": "姑媽今晚住我們家，客房還沒整理。"}}, {"speaker": "female", "text": {"zh-Hans": "你去车站接她吧，房间我来收拾。水果弟弟已经买好了。", "zh-Hant": "你去車站接她吧，房間我來收拾。水果弟弟已經買好了。"}}, {"speaker": "male", "text": {"zh-Hans": "好，我现在去车站。", "zh-Hant": "好，我現在去車站。"}}], "glossary": []}, {"id": "C2C-M02", "title": "Dinner after a train journey", "section": "listening", "kind": "short-audio", "original": true, "script": [{"speaker": "female", "text": {"zh-Hans": "舅舅的火车六点到站，是不是六点就吃晚饭？", "zh-Hant": "舅舅的火車六點到站，是不是六點就喫晚飯？"}}, {"speaker": "male", "text": {"zh-Hans": "不行，从车站到家还要四十分钟。我们七点开饭，先让他把行李放好。", "zh-Hant": "不行，從車站到家還要四十分鐘。我們七點開飯，先讓他把行李放好。"}}, {"speaker": "female", "text": {"zh-Hans": "好，七点一起吃。", "zh-Hant": "好，七點一起喫。"}}], "glossary": []}, {"id": "C2C-M03", "title": "A regular family meal", "section": "listening", "kind": "short-audio", "original": true, "script": [{"speaker": "male", "text": {"zh-Hans": "我们平时各自在家吃饭，每个月的第一个和第三个星期日，才去奶奶家一起吃。我每个月去两次，不是每个星期都去，也不是每天去。", "zh-Hant": "我們平時各自在家喫飯，每個月的第一個和第三個星期日，纔去奶奶家一起喫。我每個月去兩次，不是每個星期都去，也不是每天去。"}}], "glossary": []}, {"id": "C2C-M04", "title": "Choosing a place to ride", "section": "listening", "kind": "short-audio", "original": true, "script": [{"speaker": "female", "text": {"zh-Hans": "我周日下午有空，想骑一段平路，不想上坡。", "zh-Hant": "我週日下午有空，想騎一段平路，不想上坡。"}}, {"speaker": "male", "text": {"zh-Hans": "山边的路一直能骑，可是有坡；学校里的平路周日不开。河边的平路下午开放。", "zh-Hant": "山邊的路一直能騎，可是有坡；學校裏的平路週日不開。河邊的平路下午開放。"}}, {"speaker": "female", "text": {"zh-Hans": "那就去河边。", "zh-Hant": "那就去河邊。"}}], "glossary": []}, {"id": "C2C-M05", "title": "A different approach to cycling", "section": "listening", "kind": "short-audio", "original": true, "script": [{"speaker": "male", "text": {"zh-Hans": "小林以前骑车总要和朋友比快。昨天他没有看用时，慢慢骑了一圈，还停下拍了几张照片。回家以后他说，这次比以前轻松，以后还想这样骑。", "zh-Hant": "小林以前騎車總要和朋友比快。昨天他沒有看用時，慢慢騎了一圈，還停下拍了幾張照片。回家以後他說，這次比以前輕鬆，以後還想這樣騎。"}}], "glossary": []}, {"id": "C2C-M06", "title": "A market meeting point", "section": "listening", "kind": "short-audio", "original": true, "script": [{"speaker": "male", "text": {"zh-Hans": "我们在老菜市场门口见吗？", "zh-Hant": "我們在老菜市場門口見嗎？"}}, {"speaker": "female", "text": {"zh-Hans": "今天要去的是社区新市场，在邮局旁边。老菜市场已经关了，别去错。", "zh-Hant": "今天要去的是社區新市場，在郵局旁邊。老菜市場已經關了，別去錯。"}}, {"speaker": "male", "text": {"zh-Hans": "明白，我在新市场东门等你。", "zh-Hant": "明白，我在新市場東門等你。"}}], "glossary": []}, {"id": "C2C-M07", "title": "Walking instead of waiting", "section": "listening", "kind": "short-audio", "original": true, "script": [{"speaker": "female", "text": {"zh-Hans": "公交车去市场要绕路，得坐半个小时。", "zh-Hant": "公交車去市場要繞路，得坐半個小時。"}}, {"speaker": "male", "text": {"zh-Hans": "从这里走过去只要十分钟，我今天也没带自行车。", "zh-Hant": "從這裏走過去只要十分鐘，我今天也沒帶自行車。"}}, {"speaker": "female", "text": {"zh-Hans": "那我们走路去，买好东西再看怎么回来。", "zh-Hant": "那我們走路去，買好東西再看怎麼回來。"}}], "glossary": []}, {"id": "C2C-M08", "title": "A detour beside the river", "section": "listening", "kind": "short-audio", "original": true, "script": [{"speaker": "male", "text": {"zh-Hans": "市场南门前修路，从车站出来怎么走？", "zh-Hant": "市場南門前修路，從車站出來怎麼走？"}}, {"speaker": "female", "text": {"zh-Hans": "先沿河向北走，到了小桥再过河。过桥后就是市场北门，不要从南门硬走过去。", "zh-Hant": "先沿河向北走，到了小橋再過河。過橋後就是市場北門，不要從南門硬走過去。"}}, {"speaker": "male", "text": {"zh-Hans": "好，先往北。", "zh-Hant": "好，先往北。"}}], "glossary": []}, {"id": "C2C-M09", "title": "Transport with the right payment method", "section": "listening", "kind": "short-audio", "original": true, "script": [{"speaker": "female", "text": {"zh-Hans": "去市场的班车九点四十到，只收现金。公交车九点五十到，可以刷交通卡。", "zh-Hant": "去市場的班車九點四十到，只收現金。公交車九點五十到，可以刷交通卡。"}}, {"speaker": "male", "text": {"zh-Hans": "我十点前要到，身上只有交通卡，没有现金，坐公交吧。", "zh-Hant": "我十點前要到，身上只有交通卡，沒有現金，坐公交吧。"}}], "glossary": []}, {"id": "C2C-M10", "title": "Changing a windy-day activity", "section": "listening", "kind": "short-audio", "original": true, "script": [{"speaker": "male", "text": {"zh-Hans": "周日风太大，带客人去放风筝的事怎么办？", "zh-Hant": "週日風太大，帶客人去放風箏的事怎麼辦？"}}, {"speaker": "female", "text": {"zh-Hans": "先在家教大家做纸风筝吧，做好留着，下星期天气合适再出去放。", "zh-Hant": "先在家教大家做紙風箏吧，做好留着，下星期天氣合適再出去放。"}}, {"speaker": "male", "text": {"zh-Hans": "好，周日就在家做。", "zh-Hant": "好，週日就在家做。"}}], "glossary": []}, {"id": "C2C-M11", "title": "Packing gifts by household", "section": "listening", "kind": "short-audio", "original": true, "script": [{"speaker": "female", "text": {"zh-Hans": "姑妈和叔叔两家都来，每个人都送一盒饼干吗？", "zh-Hant": "姑媽和叔叔兩家都來，每個人都送一盒餅乾嗎？"}}, {"speaker": "male", "text": {"zh-Hans": "不用按人数送，每家一盒，一共两盒。茶叶另外带一袋，留在家里大家一起喝。", "zh-Hant": "不用按人數送，每家一盒，一共兩盒。茶葉另外帶一袋，留在家裏大家一起喝。"}}], "glossary": []}, {"id": "C2C-M12", "title": "A cup with the right features", "section": "listening", "kind": "short-audio", "original": true, "script": [{"speaker": "male", "text": {"zh-Hans": "这三种杯子，你想送哪一种给叔叔？", "zh-Hant": "這三種杯子，你想送哪一種給叔叔？"}}, {"speaker": "female", "text": {"zh-Hans": "叔叔喜欢小杯子，而且一定要有把手。这只小号带把手的就合适，大号和没把手的都不要。", "zh-Hant": "叔叔喜歡小杯子，而且一定要有把手。這隻小號帶把手的就合適，大號和沒把手的都不要。"}}], "glossary": []}, {"id": "C2C-M13", "title": "A packaged gift price", "section": "listening", "kind": "short-audio", "original": true, "script": [{"speaker": "female", "text": {"zh-Hans": "茶叶一小袋六块，三袋散着买十八块。装成这套礼盒要二十五块，盒子和包装都算在里面。", "zh-Hant": "茶葉一小袋六塊，三袋散着買十八塊。裝成這套禮盒要二十五塊，盒子和包裝都算在裏面。"}}, {"speaker": "male", "text": {"zh-Hans": "我要这套包好的礼盒，送给客人。", "zh-Hant": "我要這套包好的禮盒，送給客人。"}}], "glossary": []}, {"id": "C2C-M14", "title": "A gift for a train journey", "section": "listening", "kind": "short-audio", "original": true, "script": [{"speaker": "male", "text": {"zh-Hans": "客人明天坐火车走，想带一件轻又不容易碎的礼物。", "zh-Hant": "客人明天坐火車走，想帶一件輕又不容易碎的禮物。"}}, {"speaker": "female", "text": {"zh-Hans": "玻璃杯不合适，大花瓶也重。围巾很轻，折起来就能放进包里，不用担心打碎。", "zh-Hant": "玻璃杯不合適，大花瓶也重。圍巾很輕，折起來就能放進包裏，不用擔心打碎。"}}, {"speaker": "male", "text": {"zh-Hans": "那选围巾。", "zh-Hant": "那選圍巾。"}}], "glossary": []}, {"id": "C2C-M15", "title": "Getting the seating ready", "section": "listening", "kind": "short-audio", "original": true, "script": [{"speaker": "female", "text": {"zh-Hans": "客人六点来，你几点能到家？", "zh-Hant": "客人六點來，你幾點能到家？"}}, {"speaker": "male", "text": {"zh-Hans": "我六点才到，来不及准备。", "zh-Hant": "我六點纔到，來不及準備。"}}, {"speaker": "female", "text": {"zh-Hans": "我五点就到。那我先把客厅椅子摆好，你回来陪客人聊天，晚饭弟弟已经订了。", "zh-Hant": "我五點就到。那我先把客廳椅子擺好，你回來陪客人聊天，晚飯弟弟已經訂了。"}}], "glossary": []}, {"id": "C2C-M16", "title": "Wind in the afternoon", "section": "listening", "kind": "short-audio", "original": true, "script": [{"speaker": "male", "text": {"zh-Hans": "早上外面几乎没有风，可是预报说下午风会大很多，晚上也不会马上停。今天气温变化不大，想骑车的同学要注意下午的风，别只看早上的天气。", "zh-Hant": "早上外面幾乎沒有風，可是預報說下午風會大很多，晚上也不會馬上停。今天氣溫變化不大，想騎車的同學要注意下午的風，別隻看早上的天氣。"}}], "glossary": []}, {"id": "C2C-M17", "title": "Moving paper activities", "section": "listening", "kind": "short-audio", "original": true, "script": [{"speaker": "female", "text": {"zh-Hans": "今天为什么把写贺卡的桌子搬进屋？外面也没有下雨啊。", "zh-Hant": "今天爲什麼把寫賀卡的桌子搬進屋？外面也沒有下雨啊。"}}, {"speaker": "male", "text": {"zh-Hans": "风太大，纸一直被吹走。我们在屋里写完，再拿出去给客人看，时间还是三点。", "zh-Hant": "風太大，紙一直被吹走。我們在屋裏寫完，再拿出去給客人看，時間還是三點。"}}], "glossary": []}, {"id": "C2C-M18", "title": "Water before a bicycle outing", "section": "listening", "kind": "short-audio", "original": true, "script": [{"speaker": "male", "text": {"zh-Hans": "明天骑车在广场集合，那里能装水吗？", "zh-Hant": "明天騎車在廣場集合，那裏能裝水嗎？"}}, {"speaker": "female", "text": {"zh-Hans": "没有饮用水，来以前要在家装好一瓶。路上商店也没开，别到了广场才找水。", "zh-Hant": "沒有飲用水，來以前要在家裝好一瓶。路上商店也沒開，別到了廣場才找水。"}}, {"speaker": "male", "text": {"zh-Hans": "好，我出门前装好。", "zh-Hant": "好，我出門前裝好。"}}], "glossary": []}, {"id": "C2C-M19", "title": "A family festival evening", "section": "listening", "kind": "short-audio", "original": true, "script": [{"speaker": "female", "text": {"zh-Hans": "去年中秋，我们先给住在外地的姐姐打电话。吃完晚饭，全家一起分月饼。后来月亮出来了，才到阳台拍照。姐姐看了照片，说好像也和我们坐在一起。", "zh-Hant": "去年中秋，我們先給住在外地的姐姐打電話。喫完晚飯，全家一起分月餅。後來月亮出來了，纔到陽臺拍照。姐姐看了照片，說好像也和我們坐在一起。"}}], "glossary": []}, {"id": "C2C-M20", "title": "Together despite the distance", "section": "listening", "kind": "short-audio", "original": true, "script": [{"speaker": "male", "text": {"zh-Hans": "哥哥出差不能回来，奶奶起初说今年中秋少了一个人。后来我们接通视频，哥哥也在屏幕那边吃饭。奶奶一直笑，还请我们把手机放近一点儿，好让她看清哥哥。", "zh-Hant": "哥哥出差不能回來，奶奶起初說今年中秋少了一個人。後來我們接通視頻，哥哥也在屏幕那邊喫飯。奶奶一直笑，還請我們把手機放近一點兒，好讓她看清哥哥。"}}], "glossary": []}, {"id": "C2C-M21", "title": "A hallway note", "section": "reading", "kind": "text-card", "original": true, "text": {"zh-Hans": "给小周的留言\n客人上午就到，玄关的鞋子已经收好了，水果也洗过了。请你回家后先把餐桌上的课本放进书柜，给客人留出喝茶的地方。不要把书放到阳台，那里下午风大。\n妈妈", "zh-Hant": "給小周的留言\n客人上午就到，玄關的鞋子已經收好了，水果也洗過了。請你回家後先把餐桌上的課本放進書櫃，給客人留出喝茶的地方。不要把書放到陽臺，那裏下午風大。\n媽媽"}, "glossary": [{"term": {"zh-Hans": "玄关", "zh-Hant": "玄關"}, "meaningEn": "entrance area"}]}, {"id": "C2C-M22", "title": "A call with relatives far away", "section": "reading", "kind": "text-card", "original": true, "text": {"zh-Hans": "家庭视频安排\n今晚七点先吃饭，七点半检查手机和网络，八点正式和外地舅舅视频聊天。八点半再给他看客人带来的照片。请不要把设备检查时间当作正式聊天的开始时间。", "zh-Hant": "家庭視頻安排\n今晚七點先喫飯，七點半檢查手機和網絡，八點正式和外地舅舅視頻聊天。八點半再給他看客人帶來的照片。請不要把設備檢查時間當作正式聊天的開始時間。"}, "glossary": [{"term": {"zh-Hans": "设备", "zh-Hant": "設備"}, "meaningEn": "equipment"}]}, {"id": "C2C-M23", "title": "A manageable household routine", "section": "reading", "kind": "text-card", "original": true, "text": {"zh-Hans": "小安的家务记录\n客人住在我家这几天，我每天晚饭后整理客厅十五分钟。以前妈妈建议我整理半小时，现在家人分工以后，我只要十五分钟就能完成。客人走后会再讨论新的分工，不用每天做同样的事。", "zh-Hant": "小安的家務記錄\n客人住在我家這幾天，我每天晚飯後整理客廳十五分鐘。以前媽媽建議我整理半小時，現在家人分工以後，我只要十五分鐘就能完成。客人走後會再討論新的分工，不用每天做同樣的事。"}, "glossary": []}, {"id": "C2C-M24", "title": "Two opening windows", "section": "reading", "kind": "text-card", "original": true, "text": {"zh-Hans": "周日骑行信息\n公园骑行区上午十点到十一点开放；门口租车处九点半到十点半营业，车可以在十一点归还。小林九点五十分到公园，想当天先租车再进骑行区，上午十一点必须离开。", "zh-Hant": "週日騎行信息\n公園騎行區上午十點到十一點開放；門口租車處九點半到十點半營業，車可以在十一點歸還。小林九點五十分到公園，想當天先租車再進騎行區，上午十一點必須離開。"}, "glossary": [{"term": {"zh-Hans": "租", "zh-Hant": "租"}, "meaningEn": "rent"}]}, {"id": "C2C-M25", "title": "Choosing company over speed", "section": "reading", "kind": "text-card", "original": true, "text": {"zh-Hans": "小林的骑行记录\n妹妹刚学会骑车，跟不上原来那组快车队。我今天没有跟车队出发，而是陪妹妹慢慢骑，到她想休息的时候就一起停下。朋友问我骑了多远，我先给他看了和妹妹的合影。", "zh-Hant": "小林的騎行記錄\n妹妹剛學會騎車，跟不上原來那組快車隊。我今天沒有跟車隊出發，而是陪妹妹慢慢騎，到她想休息的時候就一起停下。朋友問我騎了多遠，我先給他看了和妹妹的合影。"}, "glossary": []}, {"id": "C2C-M26", "title": "A temporary market location", "section": "reading", "kind": "text-card", "original": true, "text": {"zh-Hans": "社区市场通知\n原来在旧车库里的周末市场暂停一周。本周的摊位搬到社区活动室旁边的小院，入口在邮局对面。不要再到旧车库排队，那里本周只接收工作人员的物资。", "zh-Hant": "社區市場通知\n原來在舊車庫裏的週末市場暫停一週。本週的攤位搬到社區活動室旁邊的小院，入口在郵局對面。不要再到舊車庫排隊，那裏本週只接收工作人員的物資。"}, "glossary": [{"term": {"zh-Hans": "摊位", "zh-Hant": "攤位"}, "meaningEn": "market stall"}]}, {"id": "C2C-M27", "title": "The host’s travel message", "section": "reading", "kind": "text-card", "original": true, "text": {"zh-Hans": "给来访客人的交通说明\n请从北站坐地铁二号线，到市场站下车。我们会在车站出口接你，行李多也不用走远路。不要买去南站的长途汽车票，南站离我们家很远。", "zh-Hant": "給來訪客人的交通說明\n請從北站坐地鐵二號線，到市場站下車。我們會在車站出口接你，行李多也不用走遠路。不要買去南站的長途汽車票，南站離我們家很遠。"}, "glossary": []}, {"id": "C2C-M28", "title": "The route around road works", "section": "reading", "kind": "text-card", "original": true, "text": {"zh-Hans": "市场绕行说明\n南门前正在修路。从车站出来，请先走地下通道到街对面，再顺着河边走到小桥。过桥后就是临时市场的北入口。不要在地下通道出口直接向南，那边围起来不能通行。", "zh-Hant": "市場繞行說明\n南門前正在修路。從車站出來，請先走地下通道到街對面，再順着河邊走到小橋。過橋後就是臨時市場的北入口。不要在地下通道出口直接向南，那邊圍起來不能通行。"}, "glossary": [{"term": {"zh-Hans": "地下通道", "zh-Hant": "地下通道"}, "meaningEn": "underpass"}]}, {"id": "C2C-M29", "title": "Cycling to the collection point", "section": "reading", "kind": "text-card", "original": true, "text": {"zh-Hans": "市场取货路线\n甲路线穿过步行街，不准骑车，只能下车推着走，终点是东门。乙路线沿外圈车道直达南门，可以一路骑行。小周的货在南门，他希望不用下车推车就到取货处。", "zh-Hant": "市場取貨路線\n甲路線穿過步行街，不準騎車，只能下車推着走，終點是東門。乙路線沿外圈車道直達南門，可以一路騎行。小周的貨在南門，他希望不用下車推車就到取貨處。"}, "glossary": [{"term": {"zh-Hans": "步行街", "zh-Hant": "步行街"}, "meaningEn": "pedestrian street"}]}, {"id": "C2C-M30", "title": "Joining a windy-day event online", "section": "reading", "kind": "text-card", "original": true, "text": {"zh-Hans": "中秋社区活动更新\n大风影响了户外布置，原定晚上七点在广场听故事，改为同一时间的视频故事会。大家在家参加，活动链接下午发到报名群，不用到广场，也不用去活动室占座。", "zh-Hant": "中秋社區活動更新\n大風影響了戶外佈置，原定晚上七點在廣場聽故事，改爲同一時間的視頻故事會。大家在家參加，活動鏈接下午發到報名羣，不用到廣場，也不用去活動室佔座。"}, "glossary": []}, {"id": "C2C-M31", "title": "A gift order for visitors", "section": "reading", "kind": "text-card", "original": true, "text": {"zh-Hans": "礼品取货单\n茶叶两份，贺卡六张，鲜花三束。六位客人每人收到一张贺卡；茶叶和鲜花另按家庭分。请按单取货，不要因为有三束花就只带三张卡，卡片上的名字已经写好了。", "zh-Hant": "禮品取貨單\n茶葉兩份，賀卡六張，鮮花三束。六位客人每人收到一張賀卡；茶葉和鮮花另按家庭分。請按單取貨，不要因爲有三束花就只帶三張卡，卡片上的名字已經寫好了。"}, "glossary": []}, {"id": "C2C-M32", "title": "A book gift preference", "section": "reading", "kind": "text-card", "original": true, "text": {"zh-Hans": "给奶奶选礼物\n奶奶说自己不缺茶叶，也不想要只有图片的画册。她最想要一本字比较大、能跟着唱的歌曲书。小周记下了这个愿望，准备在亲戚来访前去书店找。", "zh-Hant": "給奶奶選禮物\n奶奶說自己不缺茶葉，也不想要只有圖片的畫冊。她最想要一本字比較大、能跟着唱的歌曲書。小週記下了這個願望，準備在親戚來訪前去書店找。"}, "glossary": []}, {"id": "C2C-M33", "title": "Delivering flowers to school", "section": "reading", "kind": "text-card", "original": true, "text": {"zh-Hans": "花店送货单\n鲜花四十五元。送到学校门口加五元，送到家加八元。小周让店员送到学校，自己放学后带回家，所以这张单总共五十元。不要按送到家的运费付款。", "zh-Hant": "花店送貨單\n鮮花四十五元。送到學校門口加五元，送到家加八元。小周讓店員送到學校，自己放學後帶回家，所以這張單總共五十元。不要按送到家的運費付款。"}, "glossary": [{"term": {"zh-Hans": "运费", "zh-Hant": "運費"}, "meaningEn": "delivery charge"}]}, {"id": "C2C-M34", "title": "A meal collection deadline", "section": "reading", "kind": "text-card", "original": true, "text": {"zh-Hans": "便餐选择\n今天临时决定请客，没有提前预订，饭菜必须六点半前取到。甲店六点可取，但必须前一天订。乙店今天订，六点二十可取。丙店不用预订，但最早七点取。三家都有现做的便餐。", "zh-Hant": "便餐選擇\n今天臨時決定請客，沒有提前預訂，飯菜必須六點半前取到。甲店六點可取，但必須前一天訂。乙店今天訂，六點二十可取。丙店不用預訂，但最早七點取。三家都有現做的便餐。"}, "glossary": [{"term": {"zh-Hans": "预订", "zh-Hant": "預訂"}, "meaningEn": "book in advance"}]}, {"id": "C2C-M35", "title": "A visitor leaving sooner", "section": "reading", "kind": "text-card", "original": true, "text": {"zh-Hans": "家庭消息\n叔叔的车票从明天改到今晚，来不及留下吃晚饭。小林下午在家，妈妈请他把饭菜装进饭盒，六点交给叔叔带走。客房不用铺床了，叔叔今天不住下。小林答应先准备饭盒。", "zh-Hant": "家庭消息\n叔叔的車票從明天改到今晚，來不及留下喫晚飯。小林下午在家，媽媽請他把飯菜裝進飯盒，六點交給叔叔帶走。客房不用鋪牀了，叔叔今天不住下。小林答應先準備飯盒。"}, "glossary": [{"term": {"zh-Hans": "客房", "zh-Hant": "客房"}, "meaningEn": "guest room"}]}, {"id": "C2C-M36", "title": "An updated wind forecast", "section": "reading", "kind": "text-card", "original": true, "text": {"zh-Hans": "预报更新\n昨晚的消息说今天下午有大风。今早九点的新预报改为下午风弱，不下雨。负责人提醒小组以九点发布的预报为准，后续若再有变化会另发通知，先不要转发昨晚的旧消息。", "zh-Hant": "預報更新\n昨晚的消息說今天下午有大風。今早九點的新預報改爲下午風弱，不下雨。負責人提醒小組以九點發布的預報爲準，後續若再有變化會另發通知，先不要轉發昨晚的舊消息。"}, "glossary": [{"term": {"zh-Hans": "转发", "zh-Hant": "轉發"}, "meaningEn": "forward a message"}]}, {"id": "C2C-M37", "title": "Why the cycling group cancelled", "section": "reading", "kind": "text-card", "original": true, "text": {"zh-Hans": "骑行小组通知\n今天的河边骑行取消，原因是预报有大风，负责人决定不按原计划组织。报名人数足够，老师也有空，自行车检查正常。请大家等新的日期通知，不要自己按旧时间到河边集合。", "zh-Hant": "騎行小組通知\n今天的河邊騎行取消，原因是預報有大風，負責人決定不按原計劃組織。報名人數足夠，老師也有空，自行車檢查正常。請大家等新的日期通知，不要自己按舊時間到河邊集合。"}, "glossary": []}, {"id": "C2C-M38", "title": "A suitable drink container", "section": "reading", "kind": "text-card", "original": true, "text": {"zh-Hans": "骑行物品卡\n本次要求带普通白水，装在能盖紧的瓶子里。甲瓶装白水，有能拧紧的盖。乙杯也是白水，但没有盖。丙瓶有盖，里面却是果汁。小周要按物品卡选一份带走。", "zh-Hant": "騎行物品卡\n本次要求帶普通白水，裝在能蓋緊的瓶子裏。甲瓶裝白水，有能擰緊的蓋。乙杯也是白水，但沒有蓋。丙瓶有蓋，裏面卻是果汁。小周要按物品卡選一份帶走。"}, "glossary": [{"term": {"zh-Hans": "拧紧", "zh-Hant": "擰緊"}, "meaningEn": "screw tight"}]}, {"id": "C2C-M39", "title": "Making a family greeting card", "section": "reading", "kind": "text-card", "original": true, "text": {"zh-Hans": "中秋家庭贺卡步骤\n先把全家合影贴在卡片中间，再请每位家人写一句话。大家都写好以后，把卡放进信封，第二天寄给远方的叔叔。没有写齐以前不要封口，免得漏掉谁的祝福。", "zh-Hant": "中秋家庭賀卡步驟\n先把全家合影貼在卡片中間，再請每位家人寫一句話。大家都寫好以後，把卡放進信封，第二天寄給遠方的叔叔。沒有寫齊以前不要封口，免得漏掉誰的祝福。"}, "glossary": [{"term": {"zh-Hans": "信封", "zh-Hant": "信封"}, "meaningEn": "envelope"}, {"term": {"zh-Hans": "祝福", "zh-Hant": "祝福"}, "meaningEn": "good wishes"}]}, {"id": "C2C-M40", "title": "A photograph worth keeping", "section": "reading", "kind": "text-card", "original": true, "text": {"zh-Hans": "小林的中秋记录\n今年亲戚从外地赶来，我买菜做饭忙了一个下午，确实很累。吃饭时看到大家终于坐在同一张桌旁，我忍不住笑了。晚上把合影存好，第二天又拿出来看，还发给了没能来的姐姐。", "zh-Hant": "小林的中秋記錄\n今年親戚從外地趕來，我買菜做飯忙了一個下午，確實很累。喫飯時看到大家終於坐在同一張桌旁，我忍不住笑了。晚上把合影存好，第二天又拿出來看，還發給了沒能來的姐姐。"}, "glossary": []}], "questions": [{"id": "course-zh2-c-q01", "blueprintSlotId": "C2-L-01", "number": 1, "section": "listening", "group": "L1", "theme": "daily", "cognitiveTarget": "direct", "designDifficulty": "foundation", "materialId": "C2C-M01", "target": "identify the final household task", "promptEn": "What will the woman do?", "options": {"A": {"zh-Hans": "去车站接人", "zh-Hant": "去車站接人"}, "B": {"zh-Hans": "整理客房", "zh-Hant": "整理客房"}, "C": {"zh-Hans": "去买水果", "zh-Hant": "去買水果"}}, "correctAnswer": "B", "evidence": {"materialId": "C2C-M01", "quote": {"zh-Hans": "房间我来收拾", "zh-Hant": "房間我來收拾"}}, "explanation": {"en": "The woman takes responsibility for the guest room.", "zh": "女生负责整理客房。"}, "distractors": {"A": {"en": "The man is leaving for the station.", "zh": "去车站接人的是男生。"}, "C": {"en": "The younger brother has already bought the fruit.", "zh": "水果已经由弟弟买好。"}}, "languageTags": ["sequence", "frequency", "completed-action"], "reviewStatus": "author_checked_pending_independent_review"}, {"id": "course-zh2-c-q02", "blueprintSlotId": "C2-L-02", "number": 2, "section": "listening", "group": "L1", "theme": "daily", "cognitiveTarget": "direct", "designDifficulty": "foundation", "materialId": "C2C-M02", "target": "locate activity time", "promptEn": "When will the family begin dinner?", "options": {"A": {"zh-Hans": "晚上六点", "zh-Hant": "晚上六點"}, "B": {"zh-Hans": "晚上七点", "zh-Hant": "晚上七點"}, "C": {"zh-Hans": "晚上六点四十", "zh-Hant": "晚上六點四十"}}, "correctAnswer": "B", "evidence": {"materialId": "C2C-M02", "quote": {"zh-Hans": "我们七点开饭", "zh-Hant": "我們七點開飯"}}, "explanation": {"en": "They explicitly agree on dinner at seven.", "zh": "他们明确约定七点开饭。"}, "distractors": {"A": {"en": "Six is the train arrival time.", "zh": "六点是火车到站时间。"}, "C": {"en": "Six forty is the expected arrival home, before dinner.", "zh": "六点四十是预计到家时间，不是开饭时间。"}}, "languageTags": ["sequence", "frequency", "completed-action"], "reviewStatus": "author_checked_pending_independent_review"}, {"id": "course-zh2-c-q03", "blueprintSlotId": "C2-L-03", "number": 3, "section": "listening", "group": "L1", "theme": "daily", "cognitiveTarget": "direct", "designDifficulty": "standard", "materialId": "C2C-M03", "target": "identify duration or frequency", "promptEn": "How often does the speaker have this meal at Grandma’s home?", "options": {"A": {"zh-Hans": "每月两次", "zh-Hant": "每月兩次"}, "B": {"zh-Hans": "每周两次", "zh-Hant": "每週兩次"}, "C": {"zh-Hans": "每天一次", "zh-Hant": "每天一次"}}, "correctAnswer": "A", "evidence": {"materialId": "C2C-M03", "quote": {"zh-Hans": "我每个月去两次", "zh-Hant": "我每個月去兩次"}}, "explanation": {"en": "He explicitly states two visits per month.", "zh": "说话者明确每月去两次。"}, "distractors": {"B": {"en": "The interval is a month, not a week.", "zh": "两次的单位是每月，不是每周。"}, "C": {"en": "He says it is not a daily visit.", "zh": "他明确不是每天去。"}}, "languageTags": ["sequence", "frequency", "completed-action"], "reviewStatus": "author_checked_pending_independent_review"}, {"id": "course-zh2-c-q04", "blueprintSlotId": "C2-L-04", "number": 4, "section": "listening", "group": "L1", "theme": "health", "cognitiveTarget": "integrate", "designDifficulty": "standard", "materialId": "C2C-M04", "target": "combine routine and availability", "promptEn": "Where can the woman ride on a flat route during her free time?", "options": {"A": {"zh-Hans": "山边", "zh-Hant": "山邊"}, "B": {"zh-Hans": "河边", "zh-Hant": "河邊"}, "C": {"zh-Hans": "学校里面", "zh-Hant": "學校裏面"}}, "correctAnswer": "B", "evidence": {"materialId": "C2C-M04", "quote": {"zh-Hans": "河边的平路下午开放", "zh-Hant": "河邊的平路下午開放"}}, "explanation": {"en": "The riverside route is both flat and open on Sunday afternoon.", "zh": "河边既是平路，又在周日下午开放。"}, "distractors": {"A": {"en": "The hillside route has the slope she wants to avoid.", "zh": "山边有她想避开的坡。"}, "C": {"en": "The school route is closed on Sunday.", "zh": "学校的平路周日不开。"}}, "languageTags": ["duration", "simple-advice"], "reviewStatus": "author_checked_pending_independent_review"}, {"id": "course-zh2-c-q05", "blueprintSlotId": "C2-L-05", "number": 5, "section": "listening", "group": "L1", "theme": "health", "cognitiveTarget": "infer", "designDifficulty": "stretch", "materialId": "C2C-M05", "target": "infer one supported lifestyle choice", "promptEn": "Which approach does Xiaolin’s experience support choosing?", "options": {"A": {"zh-Hans": "每次都争取骑得最快", "zh-Hant": "每次都爭取騎得最快"}, "B": {"zh-Hans": "轻松骑车，不只比速度", "zh-Hant": "輕鬆騎車，不只比速度"}, "C": {"zh-Hans": "骑车时一直不许停", "zh-Hant": "騎車時一直不許停"}}, "correctAnswer": "B", "evidence": {"materialId": "C2C-M05", "quote": {"zh-Hans": "慢慢骑了一圈，还停下拍了几张照片", "zh-Hant": "慢慢騎了一圈，還停下拍了幾張照片"}}, "explanation": {"en": "His relaxed ride and positive reaction support a less competitive approach.", "zh": "轻松骑行后感觉更好，支持不只比速度。"}, "distractors": {"A": {"en": "Racing is the earlier pattern, not the one he now wants to repeat.", "zh": "争快是以前的方式，不是这次想继续的方式。"}, "C": {"en": "Stopping for photos is part of the enjoyable outing.", "zh": "他这次会停下拍照，并非一直不停。"}}, "languageTags": ["duration", "simple-advice"], "reviewStatus": "author_checked_pending_independent_review"}, {"id": "course-zh2-c-q06", "blueprintSlotId": "C2-L-06", "number": 6, "section": "listening", "group": "L2", "theme": "travel", "cognitiveTarget": "direct", "designDifficulty": "foundation", "materialId": "C2C-M06", "target": "locate destination", "promptEn": "Where will the man wait?", "options": {"A": {"zh-Hans": "老菜市场门口", "zh-Hant": "老菜市場門口"}, "B": {"zh-Hans": "邮局里面", "zh-Hant": "郵局裏面"}, "C": {"zh-Hans": "新市场东门", "zh-Hant": "新市場東門"}}, "correctAnswer": "C", "evidence": {"materialId": "C2C-M06", "quote": {"zh-Hans": "我在新市场东门等你", "zh-Hant": "我在新市場東門等你"}}, "explanation": {"en": "The final stated meeting point is the new market’s east entrance.", "zh": "最后明确在新市场东门等。"}, "distractors": {"A": {"en": "The old market is closed and explicitly ruled out.", "zh": "老市场已经关门，不是目的地。"}, "B": {"en": "The post office is a landmark, not the meeting place inside it.", "zh": "邮局只是旁边的地标，没有约定进入邮局。"}}, "languageTags": ["direction", "comparison", "sequence"], "reviewStatus": "author_checked_pending_independent_review"}, {"id": "course-zh2-c-q07", "blueprintSlotId": "C2-L-07", "number": 7, "section": "listening", "group": "L2", "theme": "travel", "cognitiveTarget": "direct", "designDifficulty": "foundation", "materialId": "C2C-M07", "target": "identify transport choice", "promptEn": "How will they travel to the market?", "options": {"A": {"zh-Hans": "坐公交车", "zh-Hant": "坐公交車"}, "B": {"zh-Hans": "骑自行车", "zh-Hant": "騎自行車"}, "C": {"zh-Hans": "走路", "zh-Hant": "走路"}}, "correctAnswer": "C", "evidence": {"materialId": "C2C-M07", "quote": {"zh-Hans": "那我们走路去", "zh-Hant": "那我們走路去"}}, "explanation": {"en": "They decide to walk to the market.", "zh": "他们决定走路去市场。"}, "distractors": {"A": {"en": "The bus takes a detour and is not chosen.", "zh": "公交绕路，没有被选中。"}, "B": {"en": "The man has no bicycle with him.", "zh": "男生今天没有带自行车。"}}, "languageTags": ["direction", "comparison", "sequence"], "reviewStatus": "author_checked_pending_independent_review"}, {"id": "course-zh2-c-q08", "blueprintSlotId": "C2-L-08", "number": 8, "section": "listening", "group": "L2", "theme": "travel", "cognitiveTarget": "direct", "designDifficulty": "standard", "materialId": "C2C-M08", "target": "identify route step", "promptEn": "What should the man do first after leaving the station?", "options": {"A": {"zh-Hans": "立即过桥", "zh-Hant": "立即過橋"}, "B": {"zh-Hans": "直接走向南门", "zh-Hant": "直接走向南門"}, "C": {"zh-Hans": "沿河向北走", "zh-Hant": "沿河向北走"}}, "correctAnswer": "C", "evidence": {"materialId": "C2C-M08", "quote": {"zh-Hans": "先沿河向北走，到了小桥再过河", "zh-Hant": "先沿河向北走，到了小橋再過河"}}, "explanation": {"en": "Walking north beside the river comes before crossing the bridge.", "zh": "先沿河向北，之后才到桥上过河。"}, "distractors": {"A": {"en": "He must first reach the bridge by walking north.", "zh": "不能马上过桥，要先往北到桥边。"}, "B": {"en": "The south entrance is obstructed by road works.", "zh": "南门前修路，明确不要直接硬走。"}}, "languageTags": ["direction", "comparison", "sequence"], "reviewStatus": "author_checked_pending_independent_review"}, {"id": "course-zh2-c-q09", "blueprintSlotId": "C2-L-09", "number": 9, "section": "listening", "group": "L2", "theme": "travel", "cognitiveTarget": "integrate", "designDifficulty": "standard", "materialId": "C2C-M09", "target": "compare two route constraints", "promptEn": "Which service meets the man’s arrival and payment needs?", "options": {"A": {"zh-Hans": "市场班车", "zh-Hant": "市場班車"}, "B": {"zh-Hans": "两种车都一定不能坐", "zh-Hant": "兩種車都一定不能坐"}, "C": {"zh-Hans": "公交车", "zh-Hant": "公交車"}}, "correctAnswer": "C", "evidence": {"materialId": "C2C-M09", "quote": {"zh-Hans": "公交车九点五十到，可以刷交通卡", "zh-Hant": "公交車九點五十到，可以刷交通卡"}}, "explanation": {"en": "The bus arrives before ten and accepts his transport card.", "zh": "公交十点前到，也能用他的交通卡。"}, "distractors": {"A": {"en": "The market shuttle requires cash he does not have.", "zh": "班车只收他没有带的现金。"}, "B": {"en": "The bus meets both stated conditions.", "zh": "公交满足两个条件，不能说都不能坐。"}}, "languageTags": ["direction", "comparison", "sequence"], "reviewStatus": "author_checked_pending_independent_review"}, {"id": "course-zh2-c-q10", "blueprintSlotId": "C2-L-10", "number": 10, "section": "listening", "group": "L2", "theme": "weather", "cognitiveTarget": "integrate", "designDifficulty": "standard", "materialId": "C2C-M10", "target": "select the final plan after a stated change", "promptEn": "What will they do this Sunday?", "options": {"A": {"zh-Hans": "照常去外面放风筝", "zh-Hant": "照常去外面放風箏"}, "B": {"zh-Hans": "先在家做纸风筝", "zh-Hant": "先在家做紙風箏"}, "C": {"zh-Hans": "把活动全部取消不再做", "zh-Hant": "把活動全部取消不再做"}}, "correctAnswer": "B", "evidence": {"materialId": "C2C-M10", "quote": {"zh-Hans": "先在家教大家做纸风筝吧", "zh-Hant": "先在家教大家做紙風箏吧"}}, "explanation": {"en": "They replace outdoor flying with making paper kites at home.", "zh": "周日改成在家做纸风筝。"}, "distractors": {"A": {"en": "Flying outside is postponed until suitable weather.", "zh": "外出放风筝推迟到天气合适时。"}, "C": {"en": "They keep an indoor activity rather than cancelling everything.", "zh": "保留了室内活动，没有全部取消。"}}, "languageTags": ["cause", "revised-plan"], "reviewStatus": "author_checked_pending_independent_review"}, {"id": "course-zh2-c-q11", "blueprintSlotId": "C2-L-11", "number": 11, "section": "listening", "group": "L3", "theme": "dining-shopping", "cognitiveTarget": "direct", "designDifficulty": "foundation", "materialId": "C2C-M11", "target": "identify order quantity", "promptEn": "How many boxes of biscuits will be given as gifts?", "options": {"A": {"zh-Hans": "两盒", "zh-Hant": "兩盒"}, "B": {"zh-Hans": "一盒", "zh-Hant": "一盒"}, "C": {"zh-Hans": "三盒", "zh-Hant": "三盒"}}, "correctAnswer": "A", "evidence": {"materialId": "C2C-M11", "quote": {"zh-Hans": "每家一盒，一共两盒", "zh-Hant": "每家一盒，一共兩盒"}}, "explanation": {"en": "There are two recipient households and the confirmed total is two boxes.", "zh": "两家每家一盒，明确一共两盒。"}, "distractors": {"B": {"en": "One box would cover only one household.", "zh": "一盒只够送给一家。"}, "C": {"en": "The separate bag of tea is not another box of biscuits.", "zh": "另外的茶叶不属于饼干盒数。"}}, "languageTags": ["quantity", "choice", "comparison"], "reviewStatus": "author_checked_pending_independent_review"}, {"id": "course-zh2-c-q12", "blueprintSlotId": "C2-L-12", "number": 12, "section": "listening", "group": "L3", "theme": "dining-shopping", "cognitiveTarget": "direct", "designDifficulty": "foundation", "materialId": "C2C-M12", "target": "identify size or stated preference", "promptEn": "Which cup matches the uncle’s stated preference?", "options": {"A": {"zh-Hans": "带把手的小杯子", "zh-Hant": "帶把手的小杯子"}, "B": {"zh-Hans": "带把手的大杯子", "zh-Hant": "帶把手的大杯子"}, "C": {"zh-Hans": "没有把手的小杯子", "zh-Hant": "沒有把手的小杯子"}}, "correctAnswer": "A", "evidence": {"materialId": "C2C-M12", "quote": {"zh-Hans": "叔叔喜欢小杯子，而且一定要有把手", "zh-Hant": "叔叔喜歡小杯子，而且一定要有把手"}}, "explanation": {"en": "The small cup with a handle matches the stated preference.", "zh": "小而有把手同时符合偏好。"}, "distractors": {"B": {"en": "A large cup fails the size preference.", "zh": "大杯子不符合喜欢小杯子的偏好。"}, "C": {"en": "The handle is explicitly required.", "zh": "材料明确要求有把手。"}}, "languageTags": ["quantity", "choice", "comparison"], "reviewStatus": "author_checked_pending_independent_review"}, {"id": "course-zh2-c-q13", "blueprintSlotId": "C2-L-13", "number": 13, "section": "listening", "group": "L3", "theme": "dining-shopping", "cognitiveTarget": "direct", "designDifficulty": "standard", "materialId": "C2C-M13", "target": "identify stated price or total", "promptEn": "What is the stated price of the packaged gift set?", "options": {"A": {"zh-Hans": "二十五块", "zh-Hant": "二十五塊"}, "B": {"zh-Hans": "十八块", "zh-Hant": "十八塊"}, "C": {"zh-Hans": "六块", "zh-Hant": "六塊"}}, "correctAnswer": "A", "evidence": {"materialId": "C2C-M13", "quote": {"zh-Hans": "装成这套礼盒要二十五块", "zh-Hant": "裝成這套禮盒要二十五塊"}}, "explanation": {"en": "The complete packaged set is priced at twenty-five.", "zh": "完整包装礼盒标价二十五块。"}, "distractors": {"B": {"en": "Eighteen is for three loose bags without this packaging.", "zh": "十八块是三袋散装茶叶的价格。"}, "C": {"en": "Six is the price of one small bag.", "zh": "六块只是一小袋的单价。"}}, "languageTags": ["quantity", "choice", "comparison"], "reviewStatus": "author_checked_pending_independent_review"}, {"id": "course-zh2-c-q14", "blueprintSlotId": "C2-L-14", "number": 14, "section": "listening", "group": "L3", "theme": "dining-shopping", "cognitiveTarget": "integrate", "designDifficulty": "standard", "materialId": "C2C-M14", "target": "choose an option satisfying two needs", "promptEn": "Which gift meets the journey-related requirements?", "options": {"A": {"zh-Hans": "围巾", "zh-Hant": "圍巾"}, "B": {"zh-Hans": "玻璃杯", "zh-Hant": "玻璃杯"}, "C": {"zh-Hans": "大花瓶", "zh-Hant": "大花瓶"}}, "correctAnswer": "A", "evidence": {"materialId": "C2C-M14", "quote": {"zh-Hans": "围巾很轻，折起来就能放进包里，不用担心打碎", "zh-Hant": "圍巾很輕，折起來就能放進包裏，不用擔心打碎"}}, "explanation": {"en": "The scarf is light and not breakable like the glass gifts.", "zh": "围巾轻，也不像玻璃制品那样易碎。"}, "distractors": {"B": {"en": "The glass cup does not meet the non-breakable requirement.", "zh": "玻璃杯不符合不容易碎的要求。"}, "C": {"en": "The vase is heavy as well as breakable.", "zh": "大花瓶既重又容易碎。"}}, "languageTags": ["quantity", "choice", "comparison"], "reviewStatus": "author_checked_pending_independent_review"}, {"id": "course-zh2-c-q15", "blueprintSlotId": "C2-L-15", "number": 15, "section": "listening", "group": "L3", "theme": "daily", "cognitiveTarget": "integrate", "designDifficulty": "standard", "materialId": "C2C-M15", "target": "combine a household request and availability", "promptEn": "What will the woman prepare before the guests arrive?", "options": {"A": {"zh-Hans": "重新订晚饭", "zh-Hant": "重新訂晚飯"}, "B": {"zh-Hans": "把客厅椅子摆好", "zh-Hant": "把客廳椅子擺好"}, "C": {"zh-Hans": "等男生到家再准备座位", "zh-Hant": "等男生到家再準備座位"}}, "correctAnswer": "B", "evidence": {"materialId": "C2C-M15", "quote": {"zh-Hans": "那我先把客厅椅子摆好", "zh-Hant": "那我先把客廳椅子擺好"}}, "explanation": {"en": "She is home earlier and will arrange the chairs.", "zh": "她先到家，负责把椅子摆好。"}, "distractors": {"A": {"en": "The younger brother has already ordered dinner.", "zh": "弟弟已订晚饭，不需要重新订。"}, "C": {"en": "She plans to prepare before the man gets home.", "zh": "她会提前准备，不是等男生回来。"}}, "languageTags": ["sequence", "frequency", "completed-action"], "reviewStatus": "author_checked_pending_independent_review"}, {"id": "course-zh2-c-q16", "blueprintSlotId": "C2-L-16", "number": 16, "section": "listening", "group": "L4", "theme": "weather", "cognitiveTarget": "direct", "designDifficulty": "foundation", "materialId": "C2C-M16", "target": "identify a weather change", "promptEn": "What change is forecast for the afternoon?", "options": {"A": {"zh-Hans": "风会完全停下来", "zh-Hant": "風會完全停下來"}, "B": {"zh-Hans": "会比早上热很多", "zh-Hant": "會比早上熱很多"}, "C": {"zh-Hans": "风会明显变大", "zh-Hant": "風會明顯變大"}}, "correctAnswer": "C", "evidence": {"materialId": "C2C-M16", "quote": {"zh-Hans": "下午风会大很多", "zh-Hant": "下午風會大很多"}}, "explanation": {"en": "The forecast is for much stronger afternoon wind.", "zh": "预报说下午风会大很多。"}, "distractors": {"A": {"en": "The wind is not expected to stop immediately, even at night.", "zh": "晚上也不会马上停，更不能说下午完全停。"}, "B": {"en": "The temperature is said to change little.", "zh": "材料说气温变化不大，不是明显更热。"}}, "languageTags": ["cause", "revised-plan"], "reviewStatus": "author_checked_pending_independent_review"}, {"id": "course-zh2-c-q17", "blueprintSlotId": "C2-L-17", "number": 17, "section": "listening", "group": "L4", "theme": "weather", "cognitiveTarget": "direct", "designDifficulty": "foundation", "materialId": "C2C-M17", "target": "identify an explicit activity reason", "promptEn": "Why are they writing the cards indoors?", "options": {"A": {"zh-Hans": "外面正在下雨", "zh-Hant": "外面正在下雨"}, "B": {"zh-Hans": "屋外的活动要到晚上才开始", "zh-Hant": "屋外的活動要到晚上纔開始"}, "C": {"zh-Hans": "外面的风会吹走纸", "zh-Hant": "外面的風會吹走紙"}}, "correctAnswer": "C", "evidence": {"materialId": "C2C-M17", "quote": {"zh-Hans": "风太大，纸一直被吹走", "zh-Hant": "風太大，紙一直被吹走"}}, "explanation": {"en": "Wind blows the paper away, so they move indoors.", "zh": "大风会吹走纸，因此改在屋里写。"}, "distractors": {"A": {"en": "The woman explicitly says there is no rain.", "zh": "女生明确说外面没有下雨。"}, "B": {"en": "The activity remains at three, not an evening start.", "zh": "时间仍是三点，没有推迟到晚上。"}}, "languageTags": ["cause", "revised-plan"], "reviewStatus": "author_checked_pending_independent_review"}, {"id": "course-zh2-c-q18", "blueprintSlotId": "C2-L-18", "number": 18, "section": "listening", "group": "L4", "theme": "health", "cognitiveTarget": "direct", "designDifficulty": "standard", "materialId": "C2C-M18", "target": "combine activity and health constraint", "promptEn": "Which plan fits the water availability during this outing?", "options": {"A": {"zh-Hans": "到广场再装水", "zh-Hant": "到廣場再裝水"}, "B": {"zh-Hans": "到路上商店再买水", "zh-Hant": "到路上商店再買水"}, "C": {"zh-Hans": "出门前在家装水", "zh-Hant": "出門前在家裝水"}}, "correctAnswer": "C", "evidence": {"materialId": "C2C-M18", "quote": {"zh-Hans": "来以前要在家装好一瓶。路上商店也没开", "zh-Hant": "來以前要在家裝好一瓶。路上商店也沒開"}}, "explanation": {"en": "Home is the available place before the meeting, unlike the square and closed shops.", "zh": "集合前应在家装水，广场无水且商店未开。"}, "distractors": {"A": {"en": "The square has no drinking-water supply.", "zh": "广场没有饮用水。"}, "B": {"en": "The shops on the route are closed.", "zh": "路上商店还没开。"}}, "languageTags": ["duration", "simple-advice"], "reviewStatus": "author_checked_pending_independent_review"}, {"id": "course-zh2-c-q19", "blueprintSlotId": "C2-L-19", "number": 19, "section": "listening", "group": "L4", "theme": "festival", "cognitiveTarget": "integrate", "designDifficulty": "standard", "materialId": "C2C-M19", "target": "order two stated event steps", "promptEn": "What did the family do immediately after dinner?", "options": {"A": {"zh-Hans": "一起分月饼", "zh-Hant": "一起分月餅"}, "B": {"zh-Hans": "先给姐姐打电话", "zh-Hant": "先給姐姐打電話"}, "C": {"zh-Hans": "马上去阳台拍照", "zh-Hant": "馬上去陽臺拍照"}}, "correctAnswer": "A", "evidence": {"materialId": "C2C-M19", "quote": {"zh-Hans": "吃完晚饭，全家一起分月饼", "zh-Hant": "喫完晚飯，全家一起分月餅"}}, "explanation": {"en": "Sharing mooncakes directly follows dinner in this family’s sequence.", "zh": "这家人的安排是晚饭后紧接着分月饼。"}, "distractors": {"B": {"en": "The phone call happens before dinner.", "zh": "电话在晚饭之前打。"}, "C": {"en": "Photos come later when the moon appears.", "zh": "等后来月亮出来才拍照。"}}, "languageTags": ["experience", "sequence", "feeling"], "reviewStatus": "author_checked_pending_independent_review"}, {"id": "course-zh2-c-q20", "blueprintSlotId": "C2-L-20", "number": 20, "section": "listening", "group": "L4", "theme": "festival", "cognitiveTarget": "infer", "designDifficulty": "stretch", "materialId": "C2C-M20", "target": "infer a feeling from stated evidence", "promptEn": "How does Grandma appear to feel after the video call starts?", "options": {"A": {"zh-Hans": "很高兴能和哥哥联系", "zh-Hant": "很高興能和哥哥聯繫"}, "B": {"zh-Hans": "完全不想看哥哥", "zh-Hant": "完全不想看哥哥"}, "C": {"zh-Hans": "生气得不肯吃饭", "zh-Hant": "生氣得不肯喫飯"}}, "correctAnswer": "A", "evidence": {"materialId": "C2C-M20", "quote": {"zh-Hans": "奶奶一直笑，还请我们把手机放近一点儿", "zh-Hant": "奶奶一直笑，還請我們把手機放近一點兒"}}, "explanation": {"en": "Smiling and wanting a closer view support pleasure at the contact.", "zh": "一直笑又想看清，支持能联系上家人的高兴。"}, "distractors": {"B": {"en": "She asks to see him more clearly.", "zh": "她想看得更清楚，不是不想看。"}, "C": {"en": "No anger or refusal to eat is reported.", "zh": "材料没有说生气或拒绝吃饭。"}}, "languageTags": ["experience", "sequence", "feeling"], "reviewStatus": "author_checked_pending_independent_review"}, {"id": "course-zh2-c-q21", "blueprintSlotId": "C2-R-01", "number": 21, "section": "reading", "group": "R1", "theme": "daily", "cognitiveTarget": "direct", "designDifficulty": "foundation", "materialId": "C2C-M21", "target": "identify the final household task", "promptEn": "What does the mother ask Xiaozhou to do first?", "options": {"A": {"zh-Hans": "把课本放进书柜", "zh-Hant": "把課本放進書櫃"}, "B": {"zh-Hans": "再洗一次水果", "zh-Hant": "再洗一次水果"}, "C": {"zh-Hans": "把课本搬到阳台", "zh-Hant": "把課本搬到陽臺"}}, "correctAnswer": "A", "evidence": {"materialId": "C2C-M21", "quote": {"zh-Hans": "先把餐桌上的课本放进书柜", "zh-Hant": "先把餐桌上的課本放進書櫃"}}, "explanation": {"en": "The requested task is to put the textbooks in the bookcase.", "zh": "要求先把课本放进书柜。"}, "distractors": {"B": {"en": "The fruit has already been washed.", "zh": "水果已经洗过。"}, "C": {"en": "The note explicitly says not to put the books on the balcony.", "zh": "留言明确不要放阳台。"}}, "languageTags": ["sequence", "frequency", "completed-action"], "reviewStatus": "author_checked_pending_independent_review"}, {"id": "course-zh2-c-q22", "blueprintSlotId": "C2-R-02", "number": 22, "section": "reading", "group": "R1", "theme": "daily", "cognitiveTarget": "direct", "designDifficulty": "foundation", "materialId": "C2C-M22", "target": "locate activity time", "promptEn": "When does the formal video conversation begin?", "options": {"A": {"zh-Hans": "晚上七点半", "zh-Hant": "晚上七點半"}, "B": {"zh-Hans": "晚上八点半", "zh-Hant": "晚上八點半"}, "C": {"zh-Hans": "晚上八点", "zh-Hant": "晚上八點"}}, "correctAnswer": "C", "evidence": {"materialId": "C2C-M22", "quote": {"zh-Hans": "八点正式和外地舅舅视频聊天", "zh-Hant": "八點正式和外地舅舅視頻聊天"}}, "explanation": {"en": "The formal conversation starts at eight.", "zh": "正式聊天八点开始。"}, "distractors": {"A": {"en": "Seven thirty is for checking the phone and connection.", "zh": "七点半是检查手机和网络。"}, "B": {"en": "Eight thirty is when they start showing photos.", "zh": "八点半是之后展示照片的时间。"}}, "languageTags": ["sequence", "frequency", "completed-action"], "reviewStatus": "author_checked_pending_independent_review"}, {"id": "course-zh2-c-q23", "blueprintSlotId": "C2-R-03", "number": 23, "section": "reading", "group": "R1", "theme": "daily", "cognitiveTarget": "direct", "designDifficulty": "standard", "materialId": "C2C-M23", "target": "identify duration or frequency", "promptEn": "How long does Xiao’an spend tidying each evening under the current arrangement?", "options": {"A": {"zh-Hans": "十五分钟", "zh-Hant": "十五分鐘"}, "B": {"zh-Hans": "半小时", "zh-Hant": "半小時"}, "C": {"zh-Hans": "一小时", "zh-Hant": "一小時"}}, "correctAnswer": "A", "evidence": {"materialId": "C2C-M23", "quote": {"zh-Hans": "我每天晚饭后整理客厅十五分钟", "zh-Hant": "我每天晚飯後整理客廳十五分鐘"}}, "explanation": {"en": "The current routine takes fifteen minutes each evening.", "zh": "现在每天晚饭后整理十五分钟。"}, "distractors": {"B": {"en": "Half an hour was an earlier suggestion before sharing the work.", "zh": "半小时是分工前的建议。"}, "C": {"en": "One hour is not stated.", "zh": "材料没有说需要一小时。"}}, "languageTags": ["sequence", "frequency", "completed-action"], "reviewStatus": "author_checked_pending_independent_review"}, {"id": "course-zh2-c-q24", "blueprintSlotId": "C2-R-04", "number": 24, "section": "reading", "group": "R1", "theme": "health", "cognitiveTarget": "integrate", "designDifficulty": "standard", "materialId": "C2C-M24", "target": "combine routine and availability", "promptEn": "Which riding period fits Xiaolin’s arrival and both opening windows?", "options": {"A": {"zh-Hans": "九点半到十点", "zh-Hant": "九點半到十點"}, "B": {"zh-Hans": "十点到十点半", "zh-Hant": "十點到十點半"}, "C": {"zh-Hans": "十一点到十一点半", "zh-Hant": "十一點到十一點半"}}, "correctAnswer": "B", "evidence": {"materialId": "C2C-M24", "quote": {"zh-Hans": "公园骑行区上午十点到十一点开放", "zh-Hant": "公園騎行區上午十點到十一點開放"}}, "explanation": {"en": "At ten he has arrived, can rent a bike, and the riding area is open.", "zh": "十点已到场，也能租车，骑行区已开放。"}, "distractors": {"A": {"en": "He has not arrived at nine thirty and the riding area is still closed.", "zh": "九点半他还没到，骑行区也没有开放。"}, "C": {"en": "At eleven he must leave and the riding window ends.", "zh": "十一点他必须离开，骑行区也结束开放。"}}, "languageTags": ["duration", "simple-advice"], "reviewStatus": "author_checked_pending_independent_review"}, {"id": "course-zh2-c-q25", "blueprintSlotId": "C2-R-05", "number": 25, "section": "reading", "group": "R1", "theme": "health", "cognitiveTarget": "infer", "designDifficulty": "stretch", "materialId": "C2C-M25", "target": "infer one supported lifestyle choice", "promptEn": "What does Xiaolin’s choice suggest mattered most on this outing?", "options": {"A": {"zh-Hans": "陪家人一起骑车", "zh-Hant": "陪家人一起騎車"}, "B": {"zh-Hans": "一定要比朋友骑得远", "zh-Hant": "一定要比朋友騎得遠"}, "C": {"zh-Hans": "完全不愿意停下来", "zh-Hant": "完全不願意停下來"}}, "correctAnswer": "A", "evidence": {"materialId": "C2C-M25", "quote": {"zh-Hans": "而是陪妹妹慢慢骑，到她想休息的时候就一起停下", "zh-Hant": "而是陪妹妹慢慢騎，到她想休息的時候就一起停下"}}, "explanation": {"en": "He changes his usual group plan to share the ride with his sister.", "zh": "他改变原来的车队安排来陪妹妹，支持重视陪伴。"}, "distractors": {"B": {"en": "Distance is not what he emphasizes when asked.", "zh": "被问距离时他先展示合影，并未强调比远。"}, "C": {"en": "He explicitly stops when his sister wants a rest.", "zh": "妹妹想休息时会一起停下。"}}, "languageTags": ["duration", "simple-advice"], "reviewStatus": "author_checked_pending_independent_review"}, {"id": "course-zh2-c-q26", "blueprintSlotId": "C2-R-06", "number": 26, "section": "reading", "group": "R2", "theme": "travel", "cognitiveTarget": "direct", "designDifficulty": "foundation", "materialId": "C2C-M26", "target": "locate destination", "promptEn": "Where should shoppers go for this week’s market?", "options": {"A": {"zh-Hans": "旧车库里面", "zh-Hant": "舊車庫裏面"}, "B": {"zh-Hans": "邮局营业厅里面", "zh-Hant": "郵局營業廳裏面"}, "C": {"zh-Hans": "社区活动室旁的小院", "zh-Hant": "社區活動室旁的小院"}}, "correctAnswer": "C", "evidence": {"materialId": "C2C-M26", "quote": {"zh-Hans": "本周的摊位搬到社区活动室旁边的小院", "zh-Hant": "本週的攤位搬到社區活動室旁邊的小院"}}, "explanation": {"en": "The temporary stalls are in the courtyard beside the activity room.", "zh": "临时摊位在活动室旁边的小院。"}, "distractors": {"A": {"en": "The former location is not open to shoppers this week.", "zh": "旧位置本周不对顾客开放。"}, "B": {"en": "The post office is across from the entrance, not the market venue.", "zh": "邮局在入口对面，不是市场设在营业厅。"}}, "languageTags": ["direction", "comparison", "sequence"], "reviewStatus": "author_checked_pending_independent_review"}, {"id": "course-zh2-c-q27", "blueprintSlotId": "C2-R-07", "number": 27, "section": "reading", "group": "R2", "theme": "travel", "cognitiveTarget": "direct", "designDifficulty": "foundation", "materialId": "C2C-M27", "target": "identify transport choice", "promptEn": "Which transport does the host ask the guest to use from North Station?", "options": {"A": {"zh-Hans": "去南站的长途汽车", "zh-Hant": "去南站的長途汽車"}, "B": {"zh-Hans": "自己骑车过来", "zh-Hant": "自己騎車過來"}, "C": {"zh-Hans": "地铁二号线", "zh-Hant": "地鐵二號線"}}, "correctAnswer": "C", "evidence": {"materialId": "C2C-M27", "quote": {"zh-Hans": "请从北站坐地铁二号线", "zh-Hant": "請從北站坐地鐵二號線"}}, "explanation": {"en": "The host specifically requests subway line two from North Station.", "zh": "主人明确要求从北站坐地铁二号线。"}, "distractors": {"A": {"en": "The message warns against buying the long-distance bus ticket.", "zh": "留言提醒不要买去南站的汽车票。"}, "B": {"en": "No cycling instruction is given.", "zh": "没有要求客人自己骑车。"}}, "languageTags": ["direction", "comparison", "sequence"], "reviewStatus": "author_checked_pending_independent_review"}, {"id": "course-zh2-c-q28", "blueprintSlotId": "C2-R-08", "number": 28, "section": "reading", "group": "R2", "theme": "travel", "cognitiveTarget": "direct", "designDifficulty": "standard", "materialId": "C2C-M28", "target": "identify route step", "promptEn": "What is the first step after leaving the station?", "options": {"A": {"zh-Hans": "马上向南走", "zh-Hant": "馬上向南走"}, "B": {"zh-Hans": "先过河上的小桥", "zh-Hant": "先過河上的小橋"}, "C": {"zh-Hans": "走地下通道到街对面", "zh-Hant": "走地下通道到街對面"}}, "correctAnswer": "C", "evidence": {"materialId": "C2C-M28", "quote": {"zh-Hans": "请先走地下通道到街对面", "zh-Hant": "請先走地下通道到街對面"}}, "explanation": {"en": "The underpass is the first required part of the detour.", "zh": "绕行第一步是通过地下通道。"}, "distractors": {"A": {"en": "The southward route is blocked.", "zh": "向南的路围起来不能通行。"}, "B": {"en": "The bridge comes after the underpass and riverside path.", "zh": "先通道再河边走，之后才到桥。"}}, "languageTags": ["direction", "comparison", "sequence"], "reviewStatus": "author_checked_pending_independent_review"}, {"id": "course-zh2-c-q29", "blueprintSlotId": "C2-R-09", "number": 29, "section": "reading", "group": "R2", "theme": "travel", "cognitiveTarget": "integrate", "designDifficulty": "standard", "materialId": "C2C-M29", "target": "compare two route constraints", "promptEn": "Which route meets the collection-point and cycling requirements?", "options": {"A": {"zh-Hans": "甲路线", "zh-Hant": "甲路線"}, "B": {"zh-Hans": "两条都直接到南门", "zh-Hant": "兩條都直接到南門"}, "C": {"zh-Hans": "乙路线", "zh-Hant": "乙路線"}}, "correctAnswer": "C", "evidence": {"materialId": "C2C-M29", "quote": {"zh-Hans": "乙路线沿外圈车道直达南门，可以一路骑行", "zh-Hant": "乙路線沿外圈車道直達南門，可以一路騎行"}}, "explanation": {"en": "Route B reaches the correct gate while allowing continuous cycling.", "zh": "乙既到南门，又可以一直骑到取货处。"}, "distractors": {"A": {"en": "Route A ends at the wrong gate and requires pushing the bike.", "zh": "甲到东门且需要推车，两点都不符。"}, "B": {"en": "Only route B is described as going directly to the south gate.", "zh": "只有乙直接到南门，不能说两条都是。"}}, "languageTags": ["direction", "comparison", "sequence"], "reviewStatus": "author_checked_pending_independent_review"}, {"id": "course-zh2-c-q30", "blueprintSlotId": "C2-R-10", "number": 30, "section": "reading", "group": "R2", "theme": "weather", "cognitiveTarget": "integrate", "designDifficulty": "standard", "materialId": "C2C-M30", "target": "select the final plan after a stated change", "promptEn": "How will participants now join the seven-o’clock event?", "options": {"A": {"zh-Hans": "到广场听故事", "zh-Hant": "到廣場聽故事"}, "B": {"zh-Hans": "在家参加视频故事会", "zh-Hant": "在家參加視頻故事會"}, "C": {"zh-Hans": "先去活动室占座", "zh-Hant": "先去活動室佔座"}}, "correctAnswer": "B", "evidence": {"materialId": "C2C-M30", "quote": {"zh-Hans": "大家在家参加，活动链接下午发到报名群", "zh-Hant": "大家在家參加，活動鏈接下午發到報名羣"}}, "explanation": {"en": "The update changes participation to a video session from home.", "zh": "新安排是在家参加视频故事会。"}, "distractors": {"A": {"en": "The outdoor square event has been replaced.", "zh": "广场的户外活动已经被替代。"}, "C": {"en": "The notice explicitly says not to reserve a seat in the activity room.", "zh": "通知明确不用去活动室占座。"}}, "languageTags": ["cause", "revised-plan"], "reviewStatus": "author_checked_pending_independent_review"}, {"id": "course-zh2-c-q31", "blueprintSlotId": "C2-R-11", "number": 31, "section": "reading", "group": "R3", "theme": "dining-shopping", "cognitiveTarget": "direct", "designDifficulty": "foundation", "materialId": "C2C-M31", "target": "identify order quantity", "promptEn": "How many greeting cards are on the order?", "options": {"A": {"zh-Hans": "三张", "zh-Hant": "三張"}, "B": {"zh-Hans": "六张", "zh-Hant": "六張"}, "C": {"zh-Hans": "两张", "zh-Hant": "兩張"}}, "correctAnswer": "B", "evidence": {"materialId": "C2C-M31", "quote": {"zh-Hans": "贺卡六张", "zh-Hant": "賀卡六張"}}, "explanation": {"en": "The order lists six greeting cards.", "zh": "取货单列出贺卡六张。"}, "distractors": {"A": {"en": "Three is the number of flower bouquets.", "zh": "三是鲜花束数，不是卡片数。"}, "C": {"en": "Two is the number of tea gifts.", "zh": "两份指茶叶。"}}, "languageTags": ["quantity", "choice", "comparison"], "reviewStatus": "author_checked_pending_independent_review"}, {"id": "course-zh2-c-q32", "blueprintSlotId": "C2-R-12", "number": 32, "section": "reading", "group": "R3", "theme": "dining-shopping", "cognitiveTarget": "direct", "designDifficulty": "foundation", "materialId": "C2C-M32", "target": "identify size or stated preference", "promptEn": "Which gift matches Grandma’s stated wish?", "options": {"A": {"zh-Hans": "只有图片的画册", "zh-Hant": "只有圖片的畫冊"}, "B": {"zh-Hans": "茶叶礼盒", "zh-Hant": "茶葉禮盒"}, "C": {"zh-Hans": "大字歌曲书", "zh-Hant": "大字歌曲書"}}, "correctAnswer": "C", "evidence": {"materialId": "C2C-M32", "quote": {"zh-Hans": "她最想要一本字比较大、能跟着唱的歌曲书", "zh-Hant": "她最想要一本字比較大、能跟着唱的歌曲書"}}, "explanation": {"en": "The stated wish is for a songbook with large print.", "zh": "愿望明确是大字歌曲书。"}, "distractors": {"A": {"en": "She says she does not want a picture-only album.", "zh": "她明确不想要只有图片的画册。"}, "B": {"en": "She says she has enough tea.", "zh": "她说自己不缺茶叶。"}}, "languageTags": ["quantity", "choice", "comparison"], "reviewStatus": "author_checked_pending_independent_review"}, {"id": "course-zh2-c-q33", "blueprintSlotId": "C2-R-13", "number": 33, "section": "reading", "group": "R3", "theme": "dining-shopping", "cognitiveTarget": "direct", "designDifficulty": "standard", "materialId": "C2C-M33", "target": "identify stated price or total", "promptEn": "Which delivery charge applies to Xiaozhou’s order?", "options": {"A": {"zh-Hans": "八元", "zh-Hant": "八元"}, "B": {"zh-Hans": "五十元", "zh-Hant": "五十元"}, "C": {"zh-Hans": "五元", "zh-Hant": "五元"}}, "correctAnswer": "C", "evidence": {"materialId": "C2C-M33", "quote": {"zh-Hans": "小周让店员送到学校", "zh-Hant": "小周讓店員送到學校"}}, "explanation": {"en": "School delivery costs five yuan according to the preceding price line.", "zh": "前面价格行说明送到学校的运费是五元。"}, "distractors": {"A": {"en": "Eight is for home delivery, which is not ordered.", "zh": "八元是未采用的到家运费。"}, "B": {"en": "Fifty is the complete order total, not the delivery component.", "zh": "五十元是整张单金额，不只是运费。"}}, "languageTags": ["quantity", "choice", "comparison"], "reviewStatus": "author_checked_pending_independent_review"}, {"id": "course-zh2-c-q34", "blueprintSlotId": "C2-R-14", "number": 34, "section": "reading", "group": "R3", "theme": "dining-shopping", "cognitiveTarget": "integrate", "designDifficulty": "standard", "materialId": "C2C-M34", "target": "choose an option satisfying two needs", "promptEn": "Which shop meets both the booking situation and collection deadline?", "options": {"A": {"zh-Hans": "甲店", "zh-Hant": "甲店"}, "B": {"zh-Hans": "乙店", "zh-Hant": "乙店"}, "C": {"zh-Hans": "丙店", "zh-Hant": "丙店"}}, "correctAnswer": "B", "evidence": {"materialId": "C2C-M34", "quote": {"zh-Hans": "乙店今天订，六点二十可取", "zh-Hant": "乙店今天訂，六點二十可取"}}, "explanation": {"en": "Shop B accepts a same-day order and collection before six thirty.", "zh": "乙可当天订，又能六点半前取。"}, "distractors": {"A": {"en": "Shop A requires a prior-day booking that has not been made.", "zh": "甲需要昨天预订，与没有提前订不符。"}, "C": {"en": "Shop C cannot provide collection early enough.", "zh": "丙最早七点，超过期限。"}}, "languageTags": ["quantity", "choice", "comparison"], "reviewStatus": "author_checked_pending_independent_review"}, {"id": "course-zh2-c-q35", "blueprintSlotId": "C2-R-15", "number": 35, "section": "reading", "group": "R3", "theme": "daily", "cognitiveTarget": "integrate", "designDifficulty": "standard", "materialId": "C2C-M35", "target": "combine a household request and availability", "promptEn": "What will Xiaolin prepare for the visitor’s revised plan?", "options": {"A": {"zh-Hans": "先给客房铺床", "zh-Hant": "先給客房鋪牀"}, "B": {"zh-Hans": "装好可以带走的饭菜", "zh-Hant": "裝好可以帶走的飯菜"}, "C": {"zh-Hans": "等待明天再准备饭菜", "zh-Hant": "等待明天再準備飯菜"}}, "correctAnswer": "B", "evidence": {"materialId": "C2C-M35", "quote": {"zh-Hans": "妈妈请他把饭菜装进饭盒，六点交给叔叔带走", "zh-Hant": "媽媽請他把飯菜裝進飯盒，六點交給叔叔帶走"}}, "explanation": {"en": "The earlier departure requires a packed meal to take away.", "zh": "提前离开，所以要准备能带走的饭菜。"}, "distractors": {"A": {"en": "The message says the guest room no longer needs a bed prepared.", "zh": "消息明确不住下，不用铺床。"}, "C": {"en": "The train is tonight, so waiting until tomorrow misses the need.", "zh": "车票改为今晚，不能等明天。"}}, "languageTags": ["sequence", "frequency", "completed-action"], "reviewStatus": "author_checked_pending_independent_review"}, {"id": "course-zh2-c-q36", "blueprintSlotId": "C2-R-16", "number": 36, "section": "reading", "group": "R4", "theme": "weather", "cognitiveTarget": "direct", "designDifficulty": "foundation", "materialId": "C2C-M36", "target": "identify a weather change", "promptEn": "According to the latest forecast shown, what is expected this afternoon?", "options": {"A": {"zh-Hans": "风弱，不下雨", "zh-Hant": "風弱，不下雨"}, "B": {"zh-Hans": "仍有昨晚说的大风", "zh-Hant": "仍有昨晚說的大風"}, "C": {"zh-Hans": "一定会下大雨", "zh-Hant": "一定會下大雨"}}, "correctAnswer": "A", "evidence": {"materialId": "C2C-M36", "quote": {"zh-Hans": "今早九点的新预报改为下午风弱，不下雨", "zh-Hant": "今早九點的新預報改爲下午風弱，不下雨"}}, "explanation": {"en": "The newer nine-o’clock forecast states weak wind and no rain.", "zh": "更新的九点预报说风弱、不下雨。"}, "distractors": {"B": {"en": "Strong wind is the older forecast that has been replaced.", "zh": "大风属于被替代的昨晚旧预报。"}, "C": {"en": "The new forecast says no rain, not heavy rain.", "zh": "新预报明确不下雨。"}}, "languageTags": ["cause", "revised-plan"], "reviewStatus": "author_checked_pending_independent_review"}, {"id": "course-zh2-c-q37", "blueprintSlotId": "C2-R-17", "number": 37, "section": "reading", "group": "R4", "theme": "weather", "cognitiveTarget": "direct", "designDifficulty": "foundation", "materialId": "C2C-M37", "target": "identify an explicit activity reason", "promptEn": "Why is the group not proceeding with today’s ride?", "options": {"A": {"zh-Hans": "预报有大风", "zh-Hant": "預報有大風"}, "B": {"zh-Hans": "报名的人太少", "zh-Hant": "報名的人太少"}, "C": {"zh-Hans": "自行车没有检查好", "zh-Hant": "自行車沒有檢查好"}}, "correctAnswer": "A", "evidence": {"materialId": "C2C-M37", "quote": {"zh-Hans": "原因是预报有大风", "zh-Hant": "原因是預報有大風"}}, "explanation": {"en": "The stated reason is the strong-wind forecast.", "zh": "通知明确说明原因是预报大风。"}, "distractors": {"B": {"en": "The notice says enough people registered.", "zh": "通知说报名人数足够。"}, "C": {"en": "The bicycles have passed their check.", "zh": "自行车检查正常。"}}, "languageTags": ["cause", "revised-plan"], "reviewStatus": "author_checked_pending_independent_review"}, {"id": "course-zh2-c-q38", "blueprintSlotId": "C2-R-18", "number": 38, "section": "reading", "group": "R4", "theme": "health", "cognitiveTarget": "direct", "designDifficulty": "standard", "materialId": "C2C-M38", "target": "combine activity and health constraint", "promptEn": "Which option meets both requirements on the card?", "options": {"A": {"zh-Hans": "甲瓶", "zh-Hant": "甲瓶"}, "B": {"zh-Hans": "乙杯", "zh-Hant": "乙杯"}, "C": {"zh-Hans": "丙瓶", "zh-Hant": "丙瓶"}}, "correctAnswer": "A", "evidence": {"materialId": "C2C-M38", "quote": {"zh-Hans": "甲瓶装白水，有能拧紧的盖", "zh-Hant": "甲瓶裝白水，有能擰緊的蓋"}}, "explanation": {"en": "Bottle A has the specified drink and a secure lid.", "zh": "甲既是白水，又有能盖紧的盖。"}, "distractors": {"B": {"en": "Cup B lacks the required lid.", "zh": "乙没有要求的盖子。"}, "C": {"en": "Bottle C contains juice instead of plain water.", "zh": "丙装的是果汁，不是要求的白水。"}}, "languageTags": ["duration", "simple-advice"], "reviewStatus": "author_checked_pending_independent_review"}, {"id": "course-zh2-c-q39", "blueprintSlotId": "C2-R-19", "number": 39, "section": "reading", "group": "R4", "theme": "festival", "cognitiveTarget": "integrate", "designDifficulty": "standard", "materialId": "C2C-M39", "target": "order two stated event steps", "promptEn": "What follows attaching the family photo to the card?", "options": {"A": {"zh-Hans": "马上封好信封", "zh-Hant": "馬上封好信封"}, "B": {"zh-Hans": "请每位家人写一句话", "zh-Hant": "請每位家人寫一句話"}, "C": {"zh-Hans": "当天直接寄出", "zh-Hant": "當天直接寄出"}}, "correctAnswer": "B", "evidence": {"materialId": "C2C-M39", "quote": {"zh-Hans": "再请每位家人写一句话", "zh-Hant": "再請每位家人寫一句話"}}, "explanation": {"en": "The next step is collecting each family member’s message.", "zh": "贴好照片后接着请每人写话。"}, "distractors": {"A": {"en": "The envelope should not be sealed until all messages are included.", "zh": "写齐前不要封口。"}, "C": {"en": "Mailing is planned for the next day after the card is complete.", "zh": "卡完成后第二天才寄，不是当场直接寄。"}}, "languageTags": ["experience", "sequence", "feeling"], "reviewStatus": "author_checked_pending_independent_review"}, {"id": "course-zh2-c-q40", "blueprintSlotId": "C2-R-20", "number": 40, "section": "reading", "group": "R4", "theme": "festival", "cognitiveTarget": "infer", "designDifficulty": "stretch", "materialId": "C2C-M40", "target": "infer a feeling from stated evidence", "promptEn": "What does Xiaolin’s behaviour suggest about the gathering?", "options": {"A": {"zh-Hans": "他很珍惜这次团聚", "zh-Hant": "他很珍惜這次團聚"}, "B": {"zh-Hans": "他完全不愿意留下照片", "zh-Hant": "他完全不願意留下照片"}, "C": {"zh-Hans": "他只记得自己累，没有开心过", "zh-Hant": "他只記得自己累，沒有開心過"}}, "correctAnswer": "A", "evidence": {"materialId": "C2C-M40", "quote": {"zh-Hans": "我忍不住笑了。晚上把合影存好，第二天又拿出来看", "zh-Hant": "我忍不住笑了。晚上把合影存好，第二天又拿出來看"}}, "explanation": {"en": "Smiling, saving and revisiting the photograph support valuing the reunion.", "zh": "笑着保存并重看照片，支持珍惜团聚。"}, "distractors": {"B": {"en": "He deliberately saves and shares the photograph.", "zh": "他主动保存并分享合影。"}, "C": {"en": "The passage includes clear signs of pleasure despite tiredness.", "zh": "虽然累，材料仍有明确的开心表现。"}}, "languageTags": ["experience", "sequence", "feeling"], "reviewStatus": "author_checked_pending_independent_review"}], "tasks": [{"id": "W1", "section": "writing", "type": "message-reply", "title": "Reply to changed shopping and dinner plans", "promptEn": "Reply to Xiaozhou in Chinese. Say whether you can collect the gift from the flower shop after six and whether dinner should be at home or at a restaurant near the market. Give a reason for your plan. Suggest another workable arrangement or ask one relevant question. You may invent details. About 40-60 Chinese characters is a guide, not a minimum.", "stimulus": {"zh-Hans": "小林：客人改到六点到站，还带着行李。我去接站，花店的礼物六点以后才能取。你能帮忙取吗？晚饭在家吃还是在市场旁的餐馆吃？我们重新安排一下吧。\n小周", "zh-Hant": "小林：客人改到六點到站，還帶着行李。我去接站，花店的禮物六點以後才能取。你能幫忙取嗎？晚飯在家喫還是在市場旁的餐館喫？我們重新安排一下吧。\n小周"}, "requirements": ["Say whether you can collect the gift after six.", "Choose dinner at home or a restaurant, or explain a feasible alternative.", "Give a reason related to the plan.", "Suggest an alternative arrangement or ask a relevant question."], "reference": {"zh-Hans": "小周，我六点十分能取礼物，先送回家。晚饭在家吃吧，因为客人带着行李，在家方便些。你们几点能到家？我提前摆好桌子。", "zh-Hant": "小周，我六點十分能取禮物，先送回家。晚飯在家喫吧，因爲客人帶着行李，在家方便些。你們幾點能到家？我提前擺好桌子。"}, "alternateReference": {"zh-Hans": "小周，我六点有课，不能去取。能请花店送来吗？晚饭选市场旁的餐馆吧，离车站近，客人不用等我们做饭。", "zh-Hant": "小周，我六點有課，不能去取。能請花店送來嗎？晚飯選市場旁的餐館吧，離車站近，客人不用等我們做飯。"}, "suggestedHanzi": [40, 60], "enforcedMinimum": null, "sharedTimingGroup": "writing", "rubric": {"maxPoints": 8, "automaticGrade": false, "missing": "unsubmitted", "technicalFailure": "needs_rerecording", "reviewerOptions": ["self", "own_teacher"], "teacherServiceIncluded": false, "dimensions": [{"id": "completion", "name": "任务完成", "levels": {"0": "已提交内容没有回应相关任务。", "1": "回应部分要求，但遗漏或误解关键信息。", "2": "完成本任务主要观察点：Say whether you can collect the gift after six.；Choose dinner at home or a restaurant, or explain a feasible alternative.；Give a reason related to the plan.；Suggest an alternative arrangement or ask a relevant question."}}, {"id": "comprehensibility", "name": "可理解性", "levels": {"0": "主要意思无法恢复。", "1": "部分意思需猜测，个别错误影响理解。", "2": "主要意思清楚；允许不影响理解的错误和口音。"}}, {"id": "language", "name": "语言运用", "levels": {"0": "缺少可表达任务意思的中文。", "1": "有限词句可表达部分意思，但关系不够清楚。", "2": "能用简单中文和必要连接表达多项信息，不要求指定句型。"}}, {"id": "organization", "name": "组织和相关回应", "levels": {"0": "缺少可辨顺序或相关回应。", "1": "部分顺序或回应相关，但连接不清。", "2": "多句内容易于跟随，先后或比较关系清楚，回应相关。"}}], "notes": "Suggested length and native-like accent are not scoring criteria. S1 is ONE profile across four responses; a missing turn is partial submission.", "taskObservations": ["Say whether you can collect the gift after six.", "Choose dinner at home or a restaurant, or explain a feasible alternative.", "Give a reason related to the plan.", "Suggest an alternative arrangement or ask a relevant question."]}, "reviewNotes": ["A refusal with a workable handover suggestion is acceptable.", "Do not require dinner at home; a restaurant choice can be justified.", "Added personal details may be fictional and must not contradict the collection time."]}, {"id": "W2", "section": "writing", "type": "short-experience-narrative", "title": "Describe a family festival gathering", "promptEn": "Use the fictional card to describe last year’s family Mid-Autumn gathering. Include when and where, at least two actions in a consistent sequence, and a feeling or reason. Connected simple Chinese sentences are enough. About 80-120 Chinese characters is a guide, not a minimum.", "stimulus": {"zh-Hans": "时间：去年中秋晚上\n地点：家里\n饭前：全家一起摆桌子\n晚饭时：接通视频，和外地姐姐聊天\n饭后：分月饼、看全家照片\n结束前：给姐姐拍一段祝福视频\n感受：自己选择并说明", "zh-Hant": "時間：去年中秋晚上\n地點：家裏\n飯前：全家一起擺桌子\n晚飯時：接通視頻，和外地姐姐聊天\n飯後：分月餅、看全家照片\n結束前：給姐姐拍一段祝福視頻\n感受：自己選擇並說明"}, "requirements": ["Identify last year’s Mid-Autumn evening.", "Identify the family home.", "Describe one action on the card.", "Describe a second action in a consistent sequence.", "Give a feeling or reason."], "reference": {"zh-Hans": "去年中秋晚上，我们全家在家里团聚。饭前大家先一起摆好桌子。姐姐在外地，晚饭时我们接通视频，一边吃饭一边和她聊天。饭后，我们分了月饼，还看了以前的全家照片。结束前，大家给姐姐拍了一段祝福视频。我觉得这次团聚很温暖，因为远方的家人也能一起参加。", "zh-Hant": "去年中秋晚上，我們全家在家裏團聚。飯前大家先一起擺好桌子。姐姐在外地，晚飯時我們接通視頻，一邊喫飯一邊和她聊天。飯後，我們分了月餅，還看了以前的全家照片。結束前，大家給姐姐拍了一段祝福視頻。我覺得這次團聚很溫暖，因爲遠方的家人也能一起參加。"}, "suggestedHanzi": [80, 120], "enforcedMinimum": null, "sharedTimingGroup": "writing", "rubric": {"maxPoints": 8, "automaticGrade": false, "missing": "unsubmitted", "technicalFailure": "needs_rerecording", "reviewerOptions": ["self", "own_teacher"], "teacherServiceIncluded": false, "dimensions": [{"id": "completion", "name": "任务完成", "levels": {"0": "已提交内容没有回应相关任务。", "1": "回应部分要求，但遗漏或误解关键信息。", "2": "完成本任务主要观察点：Identify last year’s Mid-Autumn evening.；Identify the family home.；Describe one action on the card.；Describe a second action in a consistent sequence.；Give a feeling or reason."}}, {"id": "comprehensibility", "name": "可理解性", "levels": {"0": "主要意思无法恢复。", "1": "部分意思需猜测，个别错误影响理解。", "2": "主要意思清楚；允许不影响理解的错误和口音。"}}, {"id": "language", "name": "语言运用", "levels": {"0": "缺少可表达任务意思的中文。", "1": "有限词句可表达部分意思，但关系不够清楚。", "2": "能用简单中文和必要连接表达多项信息，不要求指定句型。"}}, {"id": "organization", "name": "组织和相关回应", "levels": {"0": "缺少可辨顺序或相关回应。", "1": "部分顺序或回应相关，但连接不清。", "2": "多句内容易于跟随，先后或比较关系清楚，回应相关。"}}], "notes": "Suggested length and native-like accent are not scoring criteria. S1 is ONE profile across four responses; a missing turn is partial submission.", "taskObservations": ["Identify last year’s Mid-Autumn evening.", "Identify the family home.", "Describe one action on the card.", "Describe a second action in a consistent sequence.", "Give a feeling or reason."]}, "reviewNotes": ["Feelings may differ if coherent with the described events.", "Not every event must be included.", "Do not demand a specific grammar pattern or any real family information."]}, {"id": "S1", "section": "speaking", "type": "simulated-guided-exchange", "title": "Plan purchases before visitors arrive", "promptEn": "A family member is planning shopping before guests arrive. Answer four fixed recorded prompts in Chinese. Each prompt plays twice, then allow 15 seconds to prepare and up to 25 seconds to record. Use real or invented details. All four responses form one task out of eight; the prompts do not adapt to your answer.", "scenarioEn": "State a shopping need, choose something for the guests, explain the choice, and handle an earlier market closing time.", "exchanges": [{"id": "S1-1", "speaker": "female", "prompt": {"zh-Hans": "家里明天有客人来，我们还需要买什么？请说一种东西，也可以说已经准备好了。", "zh-Hant": "家裏明天有客人來，我們還需要買什麼？請說一種東西，也可以說已經準備好了。"}, "reference": {"zh-Hans": "还需要买一点儿水果，茶叶已经有了。", "zh-Hant": "還需要買一點兒水果，茶葉已經有了。"}, "checklist": ["Name a needed purchase or explain that preparations are complete."]}, {"id": "S1-2", "speaker": "female", "prompt": {"zh-Hans": "招待客人，你想选水果还是点心？也可以选别的东西。", "zh-Hant": "招待客人，你想選水果還是點心？也可以選別的東西。"}, "reference": {"zh-Hans": "我想选水果，买一些橙子和苹果。", "zh-Hant": "我想選水果，買一些橙子和蘋果。"}, "checklist": ["Choose fruit, snacks or another relevant option."]}, {"id": "S1-3", "speaker": "female", "prompt": {"zh-Hans": "这个选择有什么好处？给我说一个和客人有关的理由吧。", "zh-Hant": "這個選擇有什麼好處？給我說一個和客人有關的理由吧。"}, "reference": {"zh-Hans": "因为客人坐了很久的车，想吃一点儿新鲜水果。", "zh-Hant": "因爲客人坐了很久的車，想喫一點兒新鮮水果。"}, "checklist": ["Give a guest-related reason for the learner’s own choice."]}, {"id": "S1-4", "speaker": "female", "prompt": {"zh-Hans": "市场今天四点就关门，原来五点去来不及了。你准备怎么调整？", "zh-Hant": "市場今天四點就關門，原來五點去來不及了。你準備怎麼調整？"}, "reference": {"zh-Hans": "那我们三点去，先买好东西再回家等客人。", "zh-Hant": "那我們三點去，先買好東西再回家等客人。"}, "alternateReference": {"zh-Hans": "我三点有课，能去旁边晚上也营业的商店买吗？", "zh-Hant": "我三點有課，能去旁邊晚上也營業的商店買嗎？"}, "checklist": ["Propose an earlier visit, another source or another feasible solution."]}], "playsPerPrompt": 2, "preparationSecondsPerPrompt": 15, "responseSecondsPerPrompt": 25, "rubricScope": "all_four_responses_together", "rubric": {"maxPoints": 8, "automaticGrade": false, "missing": "unsubmitted", "technicalFailure": "needs_rerecording", "reviewerOptions": ["self", "own_teacher"], "teacherServiceIncluded": false, "dimensions": [{"id": "completion", "name": "任务完成", "levels": {"0": "已提交内容没有回应相关任务。", "1": "回应部分要求，但遗漏或误解关键信息。", "2": "完成本任务主要观察点：Name a needed purchase or explain that preparations are complete.；Choose fruit, snacks or another relevant option.；Give a guest-related reason for the learner’s own choice.；Propose an earlier visit, another source or another feasible solution."}}, {"id": "comprehensibility", "name": "可理解性", "levels": {"0": "主要意思无法恢复。", "1": "部分意思需猜测，个别错误影响理解。", "2": "主要意思清楚；允许不影响理解的错误和口音。"}}, {"id": "language", "name": "语言运用", "levels": {"0": "缺少可表达任务意思的中文。", "1": "有限词句可表达部分意思，但关系不够清楚。", "2": "能用简单中文和必要连接表达多项信息，不要求指定句型。"}}, {"id": "organization", "name": "组织和相关回应", "levels": {"0": "缺少可辨顺序或相关回应。", "1": "部分顺序或回应相关，但连接不清。", "2": "多句内容易于跟随，先后或比较关系清楚，回应相关。"}}], "notes": "Suggested length and native-like accent are not scoring criteria. S1 is ONE profile across four responses; a missing turn is partial submission.", "taskObservations": ["Name a needed purchase or explain that preparations are complete.", "Choose fruit, snacks or another relevant option.", "Give a guest-related reason for the learner’s own choice.", "Propose an earlier visit, another source or another feasible solution."]}}, {"id": "S2", "section": "speaking", "type": "compare-and-plan-presentation", "title": "Compare two community activities", "promptEn": "Recommend one activity to a classmate who is free only on Sunday morning, wants to make a greeting card for a visiting grandparent and has no craft materials at home. Compare the options, state a choice, give two reasons using the cards and describe a short plan. If your choice changes the original goal, explain that change. Prepare for 60 seconds and speak for up to 90 seconds.", "stimulus": {"zh-Hans": "社区周日活动\n甲：手工教室贺卡课，上午九点到十点，二十元含全部材料；老师可以帮助写字，做好的卡可以带回家。\n乙：阅览室故事会，上午九点到十点，免费；可以借一本故事书回家，没有手工材料，也不安排制作贺卡。\n同学：只有上午有空，想亲手做贺卡送给来访的外婆，家中没有材料，两项活动的费用都能接受。", "zh-Hant": "社區週日活動\n甲：手工教室賀卡課，上午九點到十點，二十元含全部材料；老師可以幫助寫字，做好的卡可以帶回家。\n乙：閱覽室故事會，上午九點到十點，免費；可以借一本故事書回家，沒有手工材料，也不安排製作賀卡。\n同學：只有上午有空，想親手做賀卡送給來訪的外婆，家中沒有材料，兩項活動的費用都能接受。"}, "requirements": ["Compare one or more features of both activities.", "Choose an activity.", "Give a first reason supported by the cards.", "Give a second distinct reason supported by the cards.", "Describe a feasible plan and explain any change to the original goal."], "reference": {"zh-Hans": "我建议参加甲。两个活动的时间都合适，乙免费，也能借书，但是没有做贺卡的环节。甲正好能让同学亲手做礼物，而且二十元已经包括材料，不用另外准备。我们可以八点五十分到手工教室，九点上课，十点带着卡回家送给外婆。", "zh-Hant": "我建議參加甲。兩個活動的時間都合適，乙免費，也能借書，但是沒有做賀卡的環節。甲正好能讓同學親手做禮物，而且二十元已經包括材料，不用另外準備。我們可以八點五十分到手工教室，九點上課，十點帶着卡回家送給外婆。"}, "alternateReference": {"zh-Hans": "如果同学愿意先陪外婆读故事，把做贺卡另作安排，可以考虑乙，因为免费，时间也合适。但这改变了当天亲手做贺卡的目标，要先确认同学同意。借回的书读完需要归还，不是买下的礼物。", "zh-Hant": "如果同學願意先陪外婆讀故事，把做賀卡另作安排，可以考慮乙，因爲免費，時間也合適。但這改變了當天親手做賀卡的目標，要先確認同學同意。借回的書讀完需要歸還，不是買下的禮物。"}, "preparationSeconds": 60, "responseSeconds": 90, "rubric": {"maxPoints": 8, "automaticGrade": false, "missing": "unsubmitted", "technicalFailure": "needs_rerecording", "reviewerOptions": ["self", "own_teacher"], "teacherServiceIncluded": false, "dimensions": [{"id": "completion", "name": "任务完成", "levels": {"0": "已提交内容没有回应相关任务。", "1": "回应部分要求，但遗漏或误解关键信息。", "2": "完成本任务主要观察点：Compare one or more features of both activities.；Choose an activity.；Give a first reason supported by the cards.；Give a second distinct reason supported by the cards.；Describe a feasible plan and explain any change to the original goal."}}, {"id": "comprehensibility", "name": "可理解性", "levels": {"0": "主要意思无法恢复。", "1": "部分意思需猜测，个别错误影响理解。", "2": "主要意思清楚；允许不影响理解的错误和口音。"}}, {"id": "language", "name": "语言运用", "levels": {"0": "缺少可表达任务意思的中文。", "1": "有限词句可表达部分意思，但关系不够清楚。", "2": "能用简单中文和必要连接表达多项信息，不要求指定句型。"}}, {"id": "organization", "name": "组织和相关回应", "levels": {"0": "缺少可辨顺序或相关回应。", "1": "部分顺序或回应相关，但连接不清。", "2": "多句内容易于跟随，先后或比较关系清楚，回应相关。"}}], "notes": "Suggested length and native-like accent are not scoring criteria. S1 is ONE profile across four responses; a missing turn is partial submission.", "taskObservations": ["Compare one or more features of both activities.", "Choose an activity.", "Give a first reason supported by the cards.", "Give a second distinct reason supported by the cards.", "Describe a feasible plan and explain any change to the original goal."]}, "reviewNotes": ["A directly meets the original card-making goal and materials need.", "B can support a shared reading visit if the goal changes; a library book cannot be assumed to become an owned gift.", "Shorter complete responses can earn full rubric credit; no native-accent requirement."]}], "instructions": {"en": "Choose one answer per listening/reading item. Full listening sources play twice. Writing tasks share 20 minutes. Use your own recorder for speaking; this preview does not time or save work. Self/own-teacher marking only; no included marking service.", "zh": "听读每题三选一，整轨听力每段两遍。写作共用二十分钟。口语用自己的录音工具；此审阅页不计时或保存作答。口写自评或交自己的教师评阅，不包含本站代评。"}, "vocabularySupport": [{"term": {"zh-Hans": "客房", "zh-Hant": "客房"}, "pinyin": "kèfáng", "meaningEn": "guest room"}, {"term": {"zh-Hans": "行李", "zh-Hant": "行李"}, "pinyin": "xíngli", "meaningEn": "luggage"}, {"term": {"zh-Hans": "绕路", "zh-Hant": "繞路"}, "pinyin": "rào lù", "meaningEn": "take a detour"}, {"term": {"zh-Hans": "地下通道", "zh-Hant": "地下通道"}, "pinyin": "dìxià tōngdào", "meaningEn": "underpass"}, {"term": {"zh-Hans": "交通卡", "zh-Hant": "交通卡"}, "pinyin": "jiāotōngkǎ", "meaningEn": "transport card"}, {"term": {"zh-Hans": "礼盒", "zh-Hant": "禮盒"}, "pinyin": "lǐhé", "meaningEn": "gift box"}, {"term": {"zh-Hans": "把手", "zh-Hant": "把手"}, "pinyin": "bǎshou", "meaningEn": "handle"}, {"term": {"zh-Hans": "围巾", "zh-Hant": "圍巾"}, "pinyin": "wéijīn", "meaningEn": "scarf"}, {"term": {"zh-Hans": "摆好", "zh-Hant": "擺好"}, "pinyin": "bǎi hǎo", "meaningEn": "set out neatly"}, {"term": {"zh-Hans": "饮用水", "zh-Hant": "飲用水"}, "pinyin": "yǐnyòngshuǐ", "meaningEn": "drinking water"}, {"term": {"zh-Hans": "摊位", "zh-Hant": "攤位"}, "pinyin": "tānwèi", "meaningEn": "market stall"}, {"term": {"zh-Hans": "运费", "zh-Hant": "運費"}, "pinyin": "yùnfèi", "meaningEn": "delivery charge"}, {"term": {"zh-Hans": "信封", "zh-Hant": "信封"}, "pinyin": "xìnfēng", "meaningEn": "envelope"}, {"term": {"zh-Hans": "团聚", "zh-Hant": "團聚"}, "pinyin": "tuánjù", "meaningEn": "reunion"}], "supportPolicy": "Preparation support is separate from timed papers. Per-item lexical audit and teacher suitability review remain separate.", "nextAcceptance": ["Actual media timing and structural validation", "ASR screening and retained flags", "Human listening acceptance", "Independent teacher and learner pilot", "Separate product integration and release"]}</script><script id="audio-data" type="application/json">{"paperId": "course-chinese-2-c-v1", "provider": "Edge TTS at authoring time; local MP3 playback, no runtime TTS", "rate": "-8%", "voices": {"female": "zh-CN-XiaoxiaoNeural", "male": "zh-CN-YunxiNeural"}, "humanListeningAcceptance": false, "units": [{"id": "C2C-M01", "kind": "listening-source", "sourcePlays": 1, "script": [{"speaker": "male", "text": {"zh-Hans": "姑妈今晚住我们家，客房还没整理。", "zh-Hant": "姑媽今晚住我們家，客房還沒整理。"}}, {"speaker": "female", "text": {"zh-Hans": "你去车站接她吧，房间我来收拾。水果弟弟已经买好了。", "zh-Hant": "你去車站接她吧，房間我來收拾。水果弟弟已經買好了。"}}, {"speaker": "male", "text": {"zh-Hans": "好，我现在去车站。", "zh-Hant": "好，我現在去車站。"}}], "sourceDurationSeconds": 13.564, "src": "assets/audio/c2c-m01.mp3", "durationSeconds": 14.112, "pcmSeconds": 14.064, "bytes": 113132, "sha256": "f98a97c240cabf7508fda14f5ba8cb9799c6715ebc1d17838b78863aa1554957"}, {"id": "C2C-M02", "kind": "listening-source", "sourcePlays": 1, "script": [{"speaker": "female", "text": {"zh-Hans": "舅舅的火车六点到站，是不是六点就吃晚饭？", "zh-Hant": "舅舅的火車六點到站，是不是六點就喫晚飯？"}}, {"speaker": "male", "text": {"zh-Hans": "不行，从车站到家还要四十分钟。我们七点开饭，先让他把行李放好。", "zh-Hant": "不行，從車站到家還要四十分鐘。我們七點開飯，先讓他把行李放好。"}}, {"speaker": "female", "text": {"zh-Hans": "好，七点一起吃。", "zh-Hant": "好，七點一起喫。"}}], "sourceDurationSeconds": 15.892, "src": "assets/audio/c2c-m02.mp3", "durationSeconds": 16.44, "pcmSeconds": 16.392, "bytes": 131756, "sha256": "84c57823567184f4ec59a93e17b1033cb2b1d8299f6fff8085e7da8bf5d974b9"}, {"id": "C2C-M03", "kind": "listening-source", "sourcePlays": 1, "script": [{"speaker": "male", "text": {"zh-Hans": "我们平时各自在家吃饭，每个月的第一个和第三个星期日，才去奶奶家一起吃。我每个月去两次，不是每个星期都去，也不是每天去。", "zh-Hant": "我們平時各自在家喫飯，每個月的第一個和第三個星期日，纔去奶奶家一起喫。我每個月去兩次，不是每個星期都去，也不是每天去。"}}], "sourceDurationSeconds": 11.976, "src": "assets/audio/c2c-m03.mp3", "durationSeconds": 12.528, "pcmSeconds": 12.476, "bytes": 100460, "sha256": "637520c74cdfc6fd4bcc3691afca035f1aa673b35cc343df86308be5e0bdb9ae"}, {"id": "C2C-M04", "kind": "listening-source", "sourcePlays": 1, "script": [{"speaker": "female", "text": {"zh-Hans": "我周日下午有空，想骑一段平路，不想上坡。", "zh-Hant": "我週日下午有空，想騎一段平路，不想上坡。"}}, {"speaker": "male", "text": {"zh-Hans": "山边的路一直能骑，可是有坡；学校里的平路周日不开。河边的平路下午开放。", "zh-Hant": "山邊的路一直能騎，可是有坡；學校裏的平路週日不開。河邊的平路下午開放。"}}, {"speaker": "female", "text": {"zh-Hans": "那就去河边。", "zh-Hant": "那就去河邊。"}}], "sourceDurationSeconds": 15.772, "src": "assets/audio/c2c-m04.mp3", "durationSeconds": 16.32, "pcmSeconds": 16.272, "bytes": 130796, "sha256": "8c3b8383888fe9c6a3c40127156b93af97cb504ab7bf5d2790f22eda665b6d42"}, {"id": "C2C-M05", "kind": "listening-source", "sourcePlays": 1, "script": [{"speaker": "male", "text": {"zh-Hans": "小林以前骑车总要和朋友比快。昨天他没有看用时，慢慢骑了一圈，还停下拍了几张照片。回家以后他说，这次比以前轻松，以后还想这样骑。", "zh-Hant": "小林以前騎車總要和朋友比快。昨天他沒有看用時，慢慢騎了一圈，還停下拍了幾張照片。回家以後他說，這次比以前輕鬆，以後還想這樣騎。"}}], "sourceDurationSeconds": 13.752, "src": "assets/audio/c2c-m05.mp3", "durationSeconds": 14.304, "pcmSeconds": 14.252, "bytes": 114668, "sha256": "053b7232f1505f93098664f247f7e65ab4efd5904677fb8fde1585533120b0fe"}, {"id": "C2C-M06", "kind": "listening-source", "sourcePlays": 1, "script": [{"speaker": "male", "text": {"zh-Hans": "我们在老菜市场门口见吗？", "zh-Hant": "我們在老菜市場門口見嗎？"}}, {"speaker": "female", "text": {"zh-Hans": "今天要去的是社区新市场，在邮局旁边。老菜市场已经关了，别去错。", "zh-Hant": "今天要去的是社區新市場，在郵局旁邊。老菜市場已經關了，別去錯。"}}, {"speaker": "male", "text": {"zh-Hans": "明白，我在新市场东门等你。", "zh-Hant": "明白，我在新市場東門等你。"}}], "sourceDurationSeconds": 15.412, "src": "assets/audio/c2c-m06.mp3", "durationSeconds": 15.96, "pcmSeconds": 15.912, "bytes": 127916, "sha256": "9adcf689408fa8a1eba357041b14c26024479c020c7614ae6e7f7747f2e752f4"}, {"id": "C2C-M07", "kind": "listening-source", "sourcePlays": 1, "script": [{"speaker": "female", "text": {"zh-Hans": "公交车去市场要绕路，得坐半个小时。", "zh-Hant": "公交車去市場要繞路，得坐半個小時。"}}, {"speaker": "male", "text": {"zh-Hans": "从这里走过去只要十分钟，我今天也没带自行车。", "zh-Hant": "從這裏走過去只要十分鐘，我今天也沒帶自行車。"}}, {"speaker": "female", "text": {"zh-Hans": "那我们走路去，买好东西再看怎么回来。", "zh-Hant": "那我們走路去，買好東西再看怎麼回來。"}}], "sourceDurationSeconds": 14.524, "src": "assets/audio/c2c-m07.mp3", "durationSeconds": 15.072, "pcmSeconds": 15.024, "bytes": 120812, "sha256": "b28f963fa2f66e07a9a7e1edba725fd77135d2cc4a8acf5f9b9eaf1cad087416"}, {"id": "C2C-M08", "kind": "listening-source", "sourcePlays": 1, "script": [{"speaker": "male", "text": {"zh-Hans": "市场南门前修路，从车站出来怎么走？", "zh-Hant": "市場南門前修路，從車站出來怎麼走？"}}, {"speaker": "female", "text": {"zh-Hans": "先沿河向北走，到了小桥再过河。过桥后就是市场北门，不要从南门硬走过去。", "zh-Hant": "先沿河向北走，到了小橋再過河。過橋後就是市場北門，不要從南門硬走過去。"}}, {"speaker": "male", "text": {"zh-Hans": "好，先往北。", "zh-Hant": "好，先往北。"}}], "sourceDurationSeconds": 16.444, "src": "assets/audio/c2c-m08.mp3", "durationSeconds": 16.992, "pcmSeconds": 16.944, "bytes": 136172, "sha256": "a37235858ff9a64e9bb6c392ff4c16398bb8abf601294a7407903a43d98d086e"}, {"id": "C2C-M09", "kind": "listening-source", "sourcePlays": 1, "script": [{"speaker": "female", "text": {"zh-Hans": "去市场的班车九点四十到，只收现金。公交车九点五十到，可以刷交通卡。", "zh-Hant": "去市場的班車九點四十到，只收現金。公交車九點五十到，可以刷交通卡。"}}, {"speaker": "male", "text": {"zh-Hans": "我十点前要到，身上只有交通卡，没有现金，坐公交吧。", "zh-Hant": "我十點前要到，身上只有交通卡，沒有現金，坐公交吧。"}}], "sourceDurationSeconds": 14.678, "src": "assets/audio/c2c-m09.mp3", "durationSeconds": 15.24, "pcmSeconds": 15.178, "bytes": 122156, "sha256": "2e1576d04ac9fce3fb3eff1d726e573b3d97a9241326107db52d588b732bafae"}, {"id": "C2C-M10", "kind": "listening-source", "sourcePlays": 1, "script": [{"speaker": "male", "text": {"zh-Hans": "周日风太大，带客人去放风筝的事怎么办？", "zh-Hant": "週日風太大，帶客人去放風箏的事怎麼辦？"}}, {"speaker": "female", "text": {"zh-Hans": "先在家教大家做纸风筝吧，做好留着，下星期天气合适再出去放。", "zh-Hant": "先在家教大家做紙風箏吧，做好留着，下星期天氣合適再出去放。"}}, {"speaker": "male", "text": {"zh-Hans": "好，周日就在家做。", "zh-Hant": "好，週日就在家做。"}}], "sourceDurationSeconds": 15.316, "src": "assets/audio/c2c-m10.mp3", "durationSeconds": 15.864, "pcmSeconds": 15.816, "bytes": 127148, "sha256": "a7d30f22dad383cd45a93f98213b789aabf5c4dc6ff9d5e5374c97e553879411"}, {"id": "C2C-M11", "kind": "listening-source", "sourcePlays": 1, "script": [{"speaker": "female", "text": {"zh-Hans": "姑妈和叔叔两家都来，每个人都送一盒饼干吗？", "zh-Hant": "姑媽和叔叔兩家都來，每個人都送一盒餅乾嗎？"}}, {"speaker": "male", "text": {"zh-Hans": "不用按人数送，每家一盒，一共两盒。茶叶另外带一袋，留在家里大家一起喝。", "zh-Hant": "不用按人數送，每家一盒，一共兩盒。茶葉另外帶一袋，留在家裏大家一起喝。"}}], "sourceDurationSeconds": 13.79, "src": "assets/audio/c2c-m11.mp3", "durationSeconds": 14.352, "pcmSeconds": 14.29, "bytes": 115052, "sha256": "4bc56afe31f21e72cb7579e79e6d431ef8eeb6c0b12ab62ebe88ad943adf64a2"}, {"id": "C2C-M12", "kind": "listening-source", "sourcePlays": 1, "script": [{"speaker": "male", "text": {"zh-Hans": "这三种杯子，你想送哪一种给叔叔？", "zh-Hant": "這三種杯子，你想送哪一種給叔叔？"}}, {"speaker": "female", "text": {"zh-Hans": "叔叔喜欢小杯子，而且一定要有把手。这只小号带把手的就合适，大号和没把手的都不要。", "zh-Hant": "叔叔喜歡小杯子，而且一定要有把手。這隻小號帶把手的就合適，大號和沒把手的都不要。"}}], "sourceDurationSeconds": 14.246, "src": "assets/audio/c2c-m12.mp3", "durationSeconds": 14.808, "pcmSeconds": 14.746, "bytes": 118700, "sha256": "1f5d6876d7d7ec33e5cb76084a1a350d34e1aeaea2506cac16a14f5f4ed85de7"}, {"id": "C2C-M13", "kind": "listening-source", "sourcePlays": 1, "script": [{"speaker": "female", "text": {"zh-Hans": "茶叶一小袋六块，三袋散着买十八块。装成这套礼盒要二十五块，盒子和包装都算在里面。", "zh-Hant": "茶葉一小袋六塊，三袋散着買十八塊。裝成這套禮盒要二十五塊，盒子和包裝都算在裏面。"}}, {"speaker": "male", "text": {"zh-Hans": "我要这套包好的礼盒，送给客人。", "zh-Hant": "我要這套包好的禮盒，送給客人。"}}], "sourceDurationSeconds": 13.646, "src": "assets/audio/c2c-m13.mp3", "durationSeconds": 14.208, "pcmSeconds": 14.146, "bytes": 113900, "sha256": "fd6b6fda935f574847a8e41ad0b4ed752d7667033a5b39982feb86578874a092"}, {"id": "C2C-M14", "kind": "listening-source", "sourcePlays": 1, "script": [{"speaker": "male", "text": {"zh-Hans": "客人明天坐火车走，想带一件轻又不容易碎的礼物。", "zh-Hant": "客人明天坐火車走，想帶一件輕又不容易碎的禮物。"}}, {"speaker": "female", "text": {"zh-Hans": "玻璃杯不合适，大花瓶也重。围巾很轻，折起来就能放进包里，不用担心打碎。", "zh-Hant": "玻璃杯不合適，大花瓶也重。圍巾很輕，折起來就能放進包裏，不用擔心打碎。"}}, {"speaker": "male", "text": {"zh-Hans": "那选围巾。", "zh-Hant": "那選圍巾。"}}], "sourceDurationSeconds": 16.588, "src": "assets/audio/c2c-m14.mp3", "durationSeconds": 17.136, "pcmSeconds": 17.088, "bytes": 137324, "sha256": "b6410080939c9fa79cfd387b1926f7486e03049ed89bc7ae3e8a4909496c6c33"}, {"id": "C2C-M15", "kind": "listening-source", "sourcePlays": 1, "script": [{"speaker": "female", "text": {"zh-Hans": "客人六点来，你几点能到家？", "zh-Hant": "客人六點來，你幾點能到家？"}}, {"speaker": "male", "text": {"zh-Hans": "我六点才到，来不及准备。", "zh-Hant": "我六點纔到，來不及準備。"}}, {"speaker": "female", "text": {"zh-Hans": "我五点就到。那我先把客厅椅子摆好，你回来陪客人聊天，晚饭弟弟已经订了。", "zh-Hant": "我五點就到。那我先把客廳椅子擺好，你回來陪客人聊天，晚飯弟弟已經訂了。"}}], "sourceDurationSeconds": 15.244, "src": "assets/audio/c2c-m15.mp3", "durationSeconds": 15.792, "pcmSeconds": 15.744, "bytes": 126572, "sha256": "d363125c168207e4518bf3e05b57787ad76d7baffdbc4a36232f2ce1b3bd339e"}, {"id": "C2C-M16", "kind": "listening-source", "sourcePlays": 1, "script": [{"speaker": "male", "text": {"zh-Hans": "早上外面几乎没有风，可是预报说下午风会大很多，晚上也不会马上停。今天气温变化不大，想骑车的同学要注意下午的风，别只看早上的天气。", "zh-Hant": "早上外面幾乎沒有風，可是預報說下午風會大很多，晚上也不會馬上停。今天氣溫變化不大，想騎車的同學要注意下午的風，別隻看早上的天氣。"}}], "sourceDurationSeconds": 13.824, "src": "assets/audio/c2c-m16.mp3", "durationSeconds": 14.376, "pcmSeconds": 14.324, "bytes": 115244, "sha256": "8321421c62917085c61451196be5ee2d6b8949b74329f87214ae1558a1b6717e"}, {"id": "C2C-M17", "kind": "listening-source", "sourcePlays": 1, "script": [{"speaker": "female", "text": {"zh-Hans": "今天为什么把写贺卡的桌子搬进屋？外面也没有下雨啊。", "zh-Hant": "今天爲什麼把寫賀卡的桌子搬進屋？外面也沒有下雨啊。"}}, {"speaker": "male", "text": {"zh-Hans": "风太大，纸一直被吹走。我们在屋里写完，再拿出去给客人看，时间还是三点。", "zh-Hant": "風太大，紙一直被吹走。我們在屋裏寫完，再拿出去給客人看，時間還是三點。"}}], "sourceDurationSeconds": 14.606, "src": "assets/audio/c2c-m17.mp3", "durationSeconds": 15.168, "pcmSeconds": 15.106, "bytes": 121580, "sha256": "1f4d6bc48b7aac2cd63621ce956b742c933f42617196c66068d87813e02d3408"}, {"id": "C2C-M18", "kind": "listening-source", "sourcePlays": 1, "script": [{"speaker": "male", "text": {"zh-Hans": "明天骑车在广场集合，那里能装水吗？", "zh-Hant": "明天騎車在廣場集合，那裏能裝水嗎？"}}, {"speaker": "female", "text": {"zh-Hans": "没有饮用水，来以前要在家装好一瓶。路上商店也没开，别到了广场才找水。", "zh-Hant": "沒有飲用水，來以前要在家裝好一瓶。路上商店也沒開，別到了廣場才找水。"}}, {"speaker": "male", "text": {"zh-Hans": "好，我出门前装好。", "zh-Hant": "好，我出門前裝好。"}}], "sourceDurationSeconds": 16.516, "src": "assets/audio/c2c-m18.mp3", "durationSeconds": 17.064, "pcmSeconds": 17.016, "bytes": 136748, "sha256": "a52a22935688140a8912c7e0d68a550816431cbf2e19a5bb4b49d6d5704146f8"}, {"id": "C2C-M19", "kind": "listening-source", "sourcePlays": 1, "script": [{"speaker": "female", "text": {"zh-Hans": "去年中秋，我们先给住在外地的姐姐打电话。吃完晚饭，全家一起分月饼。后来月亮出来了，才到阳台拍照。姐姐看了照片，说好像也和我们坐在一起。", "zh-Hant": "去年中秋，我們先給住在外地的姐姐打電話。喫完晚飯，全家一起分月餅。後來月亮出來了，纔到陽臺拍照。姐姐看了照片，說好像也和我們坐在一起。"}}], "sourceDurationSeconds": 16.128, "src": "assets/audio/c2c-m19.mp3", "durationSeconds": 16.68, "pcmSeconds": 16.628, "bytes": 133676, "sha256": "993b09147aab5fbbe0a18b3a62ca5ad0b8581eef178873352716c5a4c70e3d07"}, {"id": "C2C-M20", "kind": "listening-source", "sourcePlays": 1, "script": [{"speaker": "male", "text": {"zh-Hans": "哥哥出差不能回来，奶奶起初说今年中秋少了一个人。后来我们接通视频，哥哥也在屏幕那边吃饭。奶奶一直笑，还请我们把手机放近一点儿，好让她看清哥哥。", "zh-Hant": "哥哥出差不能回來，奶奶起初說今年中秋少了一個人。後來我們接通視頻，哥哥也在屏幕那邊喫飯。奶奶一直笑，還請我們把手機放近一點兒，好讓她看清哥哥。"}}], "sourceDurationSeconds": 15.312, "src": "assets/audio/c2c-m20.mp3", "durationSeconds": 15.864, "pcmSeconds": 15.812, "bytes": 127148, "sha256": "aae6cba3af83430e7924651c0e3222f42b5685401bd9a8030a99471ba5e2027c"}, {"id": "S1-1", "kind": "oral-prompt", "sourcePlays": 2, "singlePlayPcmSeconds": 8.424, "repeatGapSeconds": 1.5, "singlePlayPcmSha256": "b1d5424ea8faa17674f6a9d9edb15c652354e028be2205524da08647493380b5", "script": {"zh-Hans": "家里明天有客人来，我们还需要买什么？请说一种东西，也可以说已经准备好了。", "zh-Hant": "家裏明天有客人來，我們還需要買什麼？請說一種東西，也可以說已經準備好了。"}, "src": "assets/audio/s1-1.mp3", "durationSeconds": 18.408, "pcmSeconds": 18.348, "bytes": 147500, "sha256": "b3efa4d48e8862762c4c0e71b169e6812eebed10d9aa52de367fa1faf09d45eb"}, {"id": "S1-2", "kind": "oral-prompt", "sourcePlays": 2, "singlePlayPcmSeconds": 6.144, "repeatGapSeconds": 1.5, "singlePlayPcmSha256": "deb190a6ad4106ca0a1490871d14638bec12b3714b86068fb90bddf0ef0fe437", "script": {"zh-Hans": "招待客人，你想选水果还是点心？也可以选别的东西。", "zh-Hant": "招待客人，你想選水果還是點心？也可以選別的東西。"}, "src": "assets/audio/s1-2.mp3", "durationSeconds": 13.848, "pcmSeconds": 13.788, "bytes": 111020, "sha256": "591c1f261278b32ab8f8e3663bbb23832a4fae5b4fa53fa8a0a8924c03efc90d"}, {"id": "S1-3", "kind": "oral-prompt", "sourcePlays": 2, "singlePlayPcmSeconds": 5.952, "repeatGapSeconds": 1.5, "singlePlayPcmSha256": "c1abe5f4577b1d06f6eca393e439c55cfacff91918f7535682f2666f4b81241c", "script": {"zh-Hans": "这个选择有什么好处？给我说一个和客人有关的理由吧。", "zh-Hant": "這個選擇有什麼好處？給我說一個和客人有關的理由吧。"}, "src": "assets/audio/s1-3.mp3", "durationSeconds": 13.464, "pcmSeconds": 13.404, "bytes": 107948, "sha256": "409424f55284c387ed0a15f7c45367bf2667ed9b3942e5517d6f70ab22ea61a0"}, {"id": "S1-4", "kind": "oral-prompt", "sourcePlays": 2, "singlePlayPcmSeconds": 6.864, "repeatGapSeconds": 1.5, "singlePlayPcmSha256": "9be4e3a1e0ffa84e2dba894958bf3dc0859258136818a6a3b9fe7c1c8396cc0f", "script": {"zh-Hans": "市场今天四点就关门，原来五点去来不及了。你准备怎么调整？", "zh-Hant": "市場今天四點就關門，原來五點去來不及了。你準備怎麼調整？"}, "src": "assets/audio/s1-4.mp3", "durationSeconds": 15.288, "pcmSeconds": 15.228, "bytes": 122540, "sha256": "ef9e2d7c3186fb1502302688899be20e507390f149ee46eac38ed14f138de243"}], "groups": [{"id": "L1", "sourcePlays": 2, "src": "assets/audio/listening-group-1.mp3", "durationSeconds": 300.048, "pcmSeconds": 300.0, "bytes": 2400620, "sha256": "a4ca85716427e2c7d77f83a513e550bf16e6c40d7ee8025675103a35038a9b2d"}, {"id": "L2", "sourcePlays": 2, "src": "assets/audio/listening-group-2.mp3", "durationSeconds": 300.048, "pcmSeconds": 300.0, "bytes": 2400620, "sha256": "8e79b287486d601f7b99439f8cc5aac1c842280c11d6c35b61a3145ac6710b7c"}, {"id": "L3", "sourcePlays": 2, "src": "assets/audio/listening-group-3.mp3", "durationSeconds": 300.048, "pcmSeconds": 300.0, "bytes": 2400620, "sha256": "914830a370acb46f95aba8d14a670403838263b3f7bebe0358dbe04c3e08db17"}, {"id": "L4", "sourcePlays": 2, "src": "assets/audio/listening-group-4.mp3", "durationSeconds": 300.048, "pcmSeconds": 300.0, "bytes": 2400620, "sha256": "e2fe3dd1915ebef63006d9609c09eec9c8bbbaa757294b8996bdd8b11cfd1b50"}], "timedTrack": {"src": "assets/audio/listening-full.mp3", "durationSeconds": 1200.048, "pcmSeconds": 1200.0, "bytes": 9600620, "sha256": "193ef48938dbb7e07cb8ed60d9bf5394df4658427cd86c23f2352aff33bdd2e2"}, "timeline": [{"id": "C2C-M01", "questionNumber": 1, "previewStartSeconds": 0.0, "labelStartSeconds": 5.0, "firstPlayStartSeconds": 8.0, "secondPlayStartSeconds": 23.064, "speechEndSeconds": 36.628, "answerWindowSeconds": 21.872, "transitionSeconds": 1.5, "slotEndSeconds": 60.0, "sourcePlays": 2}, {"id": "C2C-M02", "questionNumber": 2, "previewStartSeconds": 60.0, "labelStartSeconds": 65.0, "firstPlayStartSeconds": 68.0, "secondPlayStartSeconds": 85.392, "speechEndSeconds": 101.284, "answerWindowSeconds": 17.216, "transitionSeconds": 1.5, "slotEndSeconds": 120.0, "sourcePlays": 2}, {"id": "C2C-M03", "questionNumber": 3, "previewStartSeconds": 120.0, "labelStartSeconds": 125.0, "firstPlayStartSeconds": 128.0, "secondPlayStartSeconds": 141.476, "speechEndSeconds": 153.452, "answerWindowSeconds": 25.048, "transitionSeconds": 1.5, "slotEndSeconds": 180.0, "sourcePlays": 2}, {"id": "C2C-M04", "questionNumber": 4, "previewStartSeconds": 180.0, "labelStartSeconds": 185.0, "firstPlayStartSeconds": 188.0, "secondPlayStartSeconds": 205.272, "speechEndSeconds": 221.044, "answerWindowSeconds": 17.456, "transitionSeconds": 1.5, "slotEndSeconds": 240.0, "sourcePlays": 2}, {"id": "C2C-M05", "questionNumber": 5, "previewStartSeconds": 240.0, "labelStartSeconds": 245.0, "firstPlayStartSeconds": 248.0, "secondPlayStartSeconds": 263.252, "speechEndSeconds": 277.004, "answerWindowSeconds": 21.496, "transitionSeconds": 1.5, "slotEndSeconds": 300.0, "sourcePlays": 2}, {"id": "C2C-M06", "questionNumber": 6, "previewStartSeconds": 300.0, "labelStartSeconds": 305.0, "firstPlayStartSeconds": 308.0, "secondPlayStartSeconds": 324.912, "speechEndSeconds": 340.324, "answerWindowSeconds": 18.176, "transitionSeconds": 1.5, "slotEndSeconds": 360.0, "sourcePlays": 2}, {"id": "C2C-M07", "questionNumber": 7, "previewStartSeconds": 360.0, "labelStartSeconds": 365.0, "firstPlayStartSeconds": 368.0, "secondPlayStartSeconds": 384.024, "speechEndSeconds": 398.548, "answerWindowSeconds": 19.952, "transitionSeconds": 1.5, "slotEndSeconds": 420.0, "sourcePlays": 2}, {"id": "C2C-M08", "questionNumber": 8, "previewStartSeconds": 420.0, "labelStartSeconds": 425.0, "firstPlayStartSeconds": 428.0, "secondPlayStartSeconds": 445.944, "speechEndSeconds": 462.388, "answerWindowSeconds": 16.112, "transitionSeconds": 1.5, "slotEndSeconds": 480.0, "sourcePlays": 2}, {"id": "C2C-M09", "questionNumber": 9, "previewStartSeconds": 480.0, "labelStartSeconds": 485.0, "firstPlayStartSeconds": 488.0, "secondPlayStartSeconds": 504.178, "speechEndSeconds": 518.856, "answerWindowSeconds": 19.644, "transitionSeconds": 1.5, "slotEndSeconds": 540.0, "sourcePlays": 2}, {"id": "C2C-M10", "questionNumber": 10, "previewStartSeconds": 540.0, "labelStartSeconds": 545.0, "firstPlayStartSeconds": 548.0, "secondPlayStartSeconds": 564.816, "speechEndSeconds": 580.132, "answerWindowSeconds": 18.368, "transitionSeconds": 1.5, "slotEndSeconds": 600.0, "sourcePlays": 2}, {"id": "C2C-M11", "questionNumber": 11, "previewStartSeconds": 600.0, "labelStartSeconds": 605.0, "firstPlayStartSeconds": 608.0, "secondPlayStartSeconds": 623.29, "speechEndSeconds": 637.08, "answerWindowSeconds": 21.42, "transitionSeconds": 1.5, "slotEndSeconds": 660.0, "sourcePlays": 2}, {"id": "C2C-M12", "questionNumber": 12, "previewStartSeconds": 660.0, "labelStartSeconds": 665.0, "firstPlayStartSeconds": 668.0, "secondPlayStartSeconds": 683.746, "speechEndSeconds": 697.992, "answerWindowSeconds": 20.508, "transitionSeconds": 1.5, "slotEndSeconds": 720.0, "sourcePlays": 2}, {"id": "C2C-M13", "questionNumber": 13, "previewStartSeconds": 720.0, "labelStartSeconds": 725.0, "firstPlayStartSeconds": 728.0, "secondPlayStartSeconds": 743.146, "speechEndSeconds": 756.792, "answerWindowSeconds": 21.708, "transitionSeconds": 1.5, "slotEndSeconds": 780.0, "sourcePlays": 2}, {"id": "C2C-M14", "questionNumber": 14, "previewStartSeconds": 780.0, "labelStartSeconds": 785.0, "firstPlayStartSeconds": 788.0, "secondPlayStartSeconds": 806.088, "speechEndSeconds": 822.676, "answerWindowSeconds": 15.824, "transitionSeconds": 1.5, "slotEndSeconds": 840.0, "sourcePlays": 2}, {"id": "C2C-M15", "questionNumber": 15, "previewStartSeconds": 840.0, "labelStartSeconds": 845.0, "firstPlayStartSeconds": 848.0, "secondPlayStartSeconds": 864.744, "speechEndSeconds": 879.988, "answerWindowSeconds": 18.512, "transitionSeconds": 1.5, "slotEndSeconds": 900.0, "sourcePlays": 2}, {"id": "C2C-M16", "questionNumber": 16, "previewStartSeconds": 900.0, "labelStartSeconds": 905.0, "firstPlayStartSeconds": 908.0, "secondPlayStartSeconds": 923.324, "speechEndSeconds": 937.148, "answerWindowSeconds": 21.352, "transitionSeconds": 1.5, "slotEndSeconds": 960.0, "sourcePlays": 2}, {"id": "C2C-M17", "questionNumber": 17, "previewStartSeconds": 960.0, "labelStartSeconds": 965.0, "firstPlayStartSeconds": 968.0, "secondPlayStartSeconds": 984.106, "speechEndSeconds": 998.712, "answerWindowSeconds": 19.788, "transitionSeconds": 1.5, "slotEndSeconds": 1020.0, "sourcePlays": 2}, {"id": "C2C-M18", "questionNumber": 18, "previewStartSeconds": 1020.0, "labelStartSeconds": 1025.0, "firstPlayStartSeconds": 1028.0, "secondPlayStartSeconds": 1046.016, "speechEndSeconds": 1062.532, "answerWindowSeconds": 15.968, "transitionSeconds": 1.5, "slotEndSeconds": 1080.0, "sourcePlays": 2}, {"id": "C2C-M19", "questionNumber": 19, "previewStartSeconds": 1080.0, "labelStartSeconds": 1085.0, "firstPlayStartSeconds": 1088.0, "secondPlayStartSeconds": 1105.628, "speechEndSeconds": 1121.756, "answerWindowSeconds": 16.744, "transitionSeconds": 1.5, "slotEndSeconds": 1140.0, "sourcePlays": 2}, {"id": "C2C-M20", "questionNumber": 20, "previewStartSeconds": 1140.0, "labelStartSeconds": 1145.0, "firstPlayStartSeconds": 1148.0, "secondPlayStartSeconds": 1164.812, "speechEndSeconds": 1180.124, "answerWindowSeconds": 18.376, "transitionSeconds": 1.5, "slotEndSeconds": 1200.0, "sourcePlays": 2}], "speakingPlannedMaximumSeconds": 414.768, "cache": [{"key": "fbe23c00330a26ff2fb57a1b", "speaker": "male", "text": "姑妈今晚住我们家，客房还没整理。", "sha256": "21b3fc3dc792418170482b14f6dd892ef71cd9bac8fb7c7e0bfb5cb9ac368dae"}, {"key": "b120077acc90c6bfd8a37f0b", "speaker": "female", "text": "你去车站接她吧，房间我来收拾。水果弟弟已经买好了。", "sha256": "77ffab185fd3221eb92a8e83f06026aaa124c4069ed7999979a4fd9d4097f758"}, {"key": "0d00ba1d042507d88ee562c5", "speaker": "male", "text": "好，我现在去车站。", "sha256": "785b778a5de3166dfbd20fd9559b8466014cc284bb2ea50aed722f34de4eeb13"}, {"key": "34e89f8d03ace2b111d8dc37", "speaker": "female", "text": "第1题。", "sha256": "3895df58b8b6ce61365216490dcb339db3aa7ef168eef8d2098c469073a4cdc2"}, {"key": "a2961bfcb96e494ee2da6313", "speaker": "female", "text": "舅舅的火车六点到站，是不是六点就吃晚饭？", "sha256": "f9f6e0eb120f7501f522ef54cf4d3feec17fc0dbad6bf76a73f9019f05036ada"}, {"key": "9f8f0667d03be80cfc463f11", "speaker": "male", "text": "不行，从车站到家还要四十分钟。我们七点开饭，先让他把行李放好。", "sha256": "5345cac684bff8007d40e9026eac2622575bc008f76e533e6670f31ea842f75c"}, {"key": "966bdc512495a86e6157211e", "speaker": "female", "text": "好，七点一起吃。", "sha256": "a6cefcfb460ded6be88efdc6f02523618a84b03413d9d4c5459b12aa11ed1cba"}, {"key": "1741fb60958696627ba5f0ed", "speaker": "female", "text": "第2题。", "sha256": "39f2c75a46983608745be0da5fe2130f1e77b5cd88f7b9b3928a0a06485a2744"}, {"key": "e7dab079d8eb381aa022fd9a", "speaker": "male", "text": "我们平时各自在家吃饭，每个月的第一个和第三个星期日，才去奶奶家一起吃。我每个月去两次，不是每个星期都去，也不是每天去。", "sha256": "b496a64706dcbe2dbf7887113482ad77909d90c9d70014ab32bc1d90b6ee4330"}, {"key": "97e9c8d06f3e0171388ee24b", "speaker": "female", "text": "第3题。", "sha256": "74d7fdba0fd9fae146470574deadbd8616eca796fece18aaf8190b3792f4225e"}, {"key": "2d1709e886102b0dc19b0bde", "speaker": "female", "text": "我周日下午有空，想骑一段平路，不想上坡。", "sha256": "c9f7078c15bc8d82bd4204c3c0a4f6eadb45b0671296e9b4c03a46edfdca01e0"}, {"key": "693f13a747e3d114b2568056", "speaker": "male", "text": "山边的路一直能骑，可是有坡；学校里的平路周日不开。河边的平路下午开放。", "sha256": "faeb121d5cd765be822e6b29295dc7bc6c54ff714cef477292302d6810becb86"}, {"key": "2de0e7db5741406df3869ad8", "speaker": "female", "text": "那就去河边。", "sha256": "9854ba377b4ae29eba40a5ddf4691a3a469b800b7ac3860d2aef585189664168"}, {"key": "b25d3caab3d72c3d0347de4b", "speaker": "female", "text": "第4题。", "sha256": "cc38e6d168e0664b2b8f98558b26288abcea294390f4e9aa13d8f457ef5a7046"}, {"key": "281dde99b69f7b50c3f772c9", "speaker": "male", "text": "小林以前骑车总要和朋友比快。昨天他没有看用时，慢慢骑了一圈，还停下拍了几张照片。回家以后他说，这次比以前轻松，以后还想这样骑。", "sha256": "90bb458c833e8aa0f227cb4256d10ed9493952b4aba03593351edcecc568ac39"}, {"key": "c5b1d9675aba74bbd668ea00", "speaker": "female", "text": "第5题。", "sha256": "057a4202f7d25216a190a84d6056c30f42be93ac60cdc21879a97aaaf19252d9"}, {"key": "ff5ebef5f272704eb400c925", "speaker": "male", "text": "我们在老菜市场门口见吗？", "sha256": "2d5b69eedd232fe296b6c4ed9f012c9275fee6e07c2ad4310b7ea4e60a60c5d7"}, {"key": "43d42f3931b2273155e520db", "speaker": "female", "text": "今天要去的是社区新市场，在邮局旁边。老菜市场已经关了，别去错。", "sha256": "d71e45119d53ffc8dbc48fa0fcf37f1fed830a606733289d683cefef0cca9ebf"}, {"key": "56bdce8244dadaec73ba6ec8", "speaker": "male", "text": "明白，我在新市场东门等你。", "sha256": "36d02dbf126c672b120d5dad6391ad013e112726585c5e9444d379e61042ba44"}, {"key": "5e6c5b336701fe2c48b7fa2f", "speaker": "female", "text": "第6题。", "sha256": "fcc5b0fabad8f1fa79148054a17b60ac8d2cb351d57ed0d5eb073df550e3ee93"}, {"key": "db6672dae559d27eb0dd43b8", "speaker": "female", "text": "公交车去市场要绕路，得坐半个小时。", "sha256": "c411464a6348aedca57d72f043ad64e4004effbd286279007ecc2a1d9e70bfb3"}, {"key": "84b58909a47bc5df18f8a3ba", "speaker": "male", "text": "从这里走过去只要十分钟，我今天也没带自行车。", "sha256": "3a94cc94d71d395f6fb0fb06324125fc7c689b09dd65f15ce09f0c2731fcc10d"}, {"key": "bee5fdc2b4d8b5e80c911b06", "speaker": "female", "text": "那我们走路去，买好东西再看怎么回来。", "sha256": "8f279498bfbff5e30591dcec10c74fde001387995eedb8780fec8b74fb795831"}, {"key": "79e0bdfd02236c1d4253adc0", "speaker": "female", "text": "第7题。", "sha256": "5151859d99f51fb43c1c4ba74a72c7d8898fd12ebdb151ca350243f27169a52c"}, {"key": "0b06138d6f9820a1335eb595", "speaker": "male", "text": "市场南门前修路，从车站出来怎么走？", "sha256": "d1bf10c8dffdf90cef133e7944ed7cca05d1f7c74caad85c1b59fa2337aa4d5d"}, {"key": "4bd0c2db41da16624cafe65f", "speaker": "female", "text": "先沿河向北走，到了小桥再过河。过桥后就是市场北门，不要从南门硬走过去。", "sha256": "77bcb4db9c2e849cd696098515340355789f9f6a98d0cdf9c9b9fbc65799444a"}, {"key": "5a9e20c041b360da9df469fa", "speaker": "male", "text": "好，先往北。", "sha256": "73214813937baa584c572f6d223edb04ae1a0efdb7b565408e14be421b03fdcb"}, {"key": "b431efe26b8c6cc712ef43b8", "speaker": "female", "text": "第8题。", "sha256": "65ff1f952179bc643f6b488a3150eee5a21667f5901053151fd7aeb53f0c7786"}, {"key": "78e8c8eb7b651f4421c75455", "speaker": "female", "text": "去市场的班车九点四十到，只收现金。公交车九点五十到，可以刷交通卡。", "sha256": "c5bdcb5f0b0eeacaa65455fc0facc3a4713217ff6435f9c84bf805e8a66e73c0"}, {"key": "f586125917b4a196efb77086", "speaker": "male", "text": "我十点前要到，身上只有交通卡，没有现金，坐公交吧。", "sha256": "66a2da5d3e3fb16819a13cb1f7e65e9f42a5852240c5cf2c256921bffe36c873"}, {"key": "76f9b7034e5801a6360f40bd", "speaker": "female", "text": "第9题。", "sha256": "439f37e4f9738e7ac1dc180f588ae4ed900731c0623d4038b9f3533da20c0ada"}, {"key": "adec1074da030ede325f59c5", "speaker": "male", "text": "周日风太大，带客人去放风筝的事怎么办？", "sha256": "b8c40f71ba7c11487af9a3033b212b8cadbaff0c56bef99246bd9bc8722cdbd0"}, {"key": "43fd96fb6486c128293a55fc", "speaker": "female", "text": "先在家教大家做纸风筝吧，做好留着，下星期天气合适再出去放。", "sha256": "32eb17cf8d064865b00ca37d138c0b3a0701d79b90e30dcf20fbea068f4623a1"}, {"key": "443ff98bb44015240f24b1e2", "speaker": "male", "text": "好，周日就在家做。", "sha256": "a9e717131a7639f650a45b29441ffacff7460fc090519d546f5bb0e5a1ef23cb"}, {"key": "86d64da7bc27367110de5cb7", "speaker": "female", "text": "第10题。", "sha256": "a443b83201af7bae91780e167c2fcd53ef523b448bf77dd4ad6b238de2e582d2"}, {"key": "4c69aa9e5ca3ccaed9f8de70", "speaker": "female", "text": "姑妈和叔叔两家都来，每个人都送一盒饼干吗？", "sha256": "432acb33601cd582e7a1ec5f1ef97be42dabb9baa2c7ddbb7d05b0ff1d341f30"}, {"key": "082a2cb05d11d36c4f1e4aef", "speaker": "male", "text": "不用按人数送，每家一盒，一共两盒。茶叶另外带一袋，留在家里大家一起喝。", "sha256": "e17ca9e7c4297b76f75d96764cad2bef42512379e4abf883102c750da97895c2"}, {"key": "63d3dd3f27ad85dca9aa0606", "speaker": "female", "text": "第11题。", "sha256": "09609165ce7b5b5bbc80de6236e7726415e2ab45d65241e1ca3c75ec4a697f32"}, {"key": "7d34672c85fa234459cf7596", "speaker": "male", "text": "这三种杯子，你想送哪一种给叔叔？", "sha256": "72acef6ab205a72acedff7073713af0aa19522a6af88d32f8c853c6f25aac847"}, {"key": "aaef832589c93c4d0e3f8658", "speaker": "female", "text": "叔叔喜欢小杯子，而且一定要有把手。这只小号带把手的就合适，大号和没把手的都不要。", "sha256": "7fab672ba547331491aa3769f319229b5a0a20ca4db69da56429bdf3d8bfbc02"}, {"key": "2dbff9b332f7edc61b4c3c18", "speaker": "female", "text": "第12题。", "sha256": "f25ea7d43ed9f81b7dd1af25fa0339498c7d458e79931122755e838f8d314a83"}, {"key": "cbd0fe2529e23cd11c7b472b", "speaker": "female", "text": "茶叶一小袋六块，三袋散着买十八块。装成这套礼盒要二十五块，盒子和包装都算在里面。", "sha256": "ffe6c2e557be0895d6d129bdd013ab12b618f34827c93fae19d6377d9dd89f7e"}, {"key": "307034b42565b548fea69457", "speaker": "male", "text": "我要这套包好的礼盒，送给客人。", "sha256": "5a0f0e66e31f6bb4a4fd5f110cc2a931e0c83743f75bc96858164e1744389b35"}, {"key": "ec1acc6c51d958bc6eb290a5", "speaker": "female", "text": "第13题。", "sha256": "e6515323a9eef38c0320124c2e99d81f002d229d597de7f44a76008521622c43"}, {"key": "4d57b4d36f8b78743eb81489", "speaker": "male", "text": "客人明天坐火车走，想带一件轻又不容易碎的礼物。", "sha256": "8262d0d7a0b86f9751573178b3b48cbe8efb2302ce2c09ce6c0298d3085fbcec"}, {"key": "bc2d94a3aba05411c150e814", "speaker": "female", "text": "玻璃杯不合适，大花瓶也重。围巾很轻，折起来就能放进包里，不用担心打碎。", "sha256": "bd0f49acdb74a3ff0dd7f0934af2937e69ad40d1ab7eb164bb788793657626a7"}, {"key": "95e8cc86dee76159d7ff87fe", "speaker": "male", "text": "那选围巾。", "sha256": "d4ad2004f0df5db9f5fa601b8aea83e67adca75e86fa6a2777270ca9fb488421"}, {"key": "6a9458d981e42c448c56e5d7", "speaker": "female", "text": "第14题。", "sha256": "3c248ca1222db546caafa3ccef0afeb1d63689c8e501a91b906f7c38012bc8f4"}, {"key": "c260529b88bbea9bf8eb898c", "speaker": "female", "text": "客人六点来，你几点能到家？", "sha256": "bad29fa48a2c0133a3940224cf274e8ed5239298491f4f3b98486e0683241893"}, {"key": "3a15a1c642977117cab9f9b9", "speaker": "male", "text": "我六点才到，来不及准备。", "sha256": "230ffbab4815062f0645ac4fdf87394a5074370d1499b8ebe107f13c7a7b9e3f"}, {"key": "4eba54c7e3707af4e7e5430b", "speaker": "female", "text": "我五点就到。那我先把客厅椅子摆好，你回来陪客人聊天，晚饭弟弟已经订了。", "sha256": "9d765f39c7c0df4e3b26f3b46df3fdefc438b20507e12f2cb6057ab20c957f63"}, {"key": "9d1b8c046279c5b498214791", "speaker": "female", "text": "第15题。", "sha256": "774136cf8893575562e62fc53ca824d970e119df2986004fbc9a795341529ed7"}, {"key": "06a138b9938da2105fa0e493", "speaker": "male", "text": "早上外面几乎没有风，可是预报说下午风会大很多，晚上也不会马上停。今天气温变化不大，想骑车的同学要注意下午的风，别只看早上的天气。", "sha256": "1f9dcc3bb46c2a09e73ccc8552d30fc8d809bf75d6f31c27b8d2ad2b445feef2"}, {"key": "0cffbf1010d1e54023057ea9", "speaker": "female", "text": "第16题。", "sha256": "6cbe22b4463ef0127dbcb5957919648ee9b071c97d70d0b85edf327b6a0071df"}, {"key": "68e4deea1d9b891e930de8fa", "speaker": "female", "text": "今天为什么把写贺卡的桌子搬进屋？外面也没有下雨啊。", "sha256": "4b323678b082b0bc6c0a23863fb9c960da89a29df7ebef8193fb06fae9f5dd2a"}, {"key": "d856758fd11c888437e08cc9", "speaker": "male", "text": "风太大，纸一直被吹走。我们在屋里写完，再拿出去给客人看，时间还是三点。", "sha256": "150902fab11617e278577cfa12443e5bfad07b572874a1bb12014f4a7799b624"}, {"key": "61f4d2e4e5f3e0536be36453", "speaker": "female", "text": "第17题。", "sha256": "7b303e3cdea4e6b338b981ca7d27218c5da50fd4e2ca1cb297c3ba0853fbff6b"}, {"key": "893649c0196c42a7d458fee2", "speaker": "male", "text": "明天骑车在广场集合，那里能装水吗？", "sha256": "b08b51fe64fca564801c1c4a9c6ab6fd7c77e94720f46dc658526946e84f1709"}, {"key": "4d21d6c12d6ac53d8edba71a", "speaker": "female", "text": "没有饮用水，来以前要在家装好一瓶。路上商店也没开，别到了广场才找水。", "sha256": "598dc2c4f1d96670d31aba94b00a8db06ce9bd3dc99de337d66e7ddfddf47257"}, {"key": "f96b66fea62b5e0e8e09b119", "speaker": "male", "text": "好，我出门前装好。", "sha256": "c5ef83dec8463e54418aa1f0cdd41234be2eeb2675ac30f6be55a8dec5f7be1d"}, {"key": "2e9092b1191d42999a9f695d", "speaker": "female", "text": "第18题。", "sha256": "b0832c56a97774c35b538f689f08bf8314e263e14ab809871867bcdede27a70b"}, {"key": "82cc1c2bc39c25b41b4e76bd", "speaker": "female", "text": "去年中秋，我们先给住在外地的姐姐打电话。吃完晚饭，全家一起分月饼。后来月亮出来了，才到阳台拍照。姐姐看了照片，说好像也和我们坐在一起。", "sha256": "dedf14c22346db6b032d19af33ef1deb927d99c6d9ec4dfd96b5c8e1c0a4df2c"}, {"key": "ee9540a1a810afba0a3a7056", "speaker": "female", "text": "第19题。", "sha256": "91a1a230e642a4906da5e058c485a56cf6a1c77b67c899338da1843b7db5066e"}, {"key": "bd5acf998e30010e749998c4", "speaker": "male", "text": "哥哥出差不能回来，奶奶起初说今年中秋少了一个人。后来我们接通视频，哥哥也在屏幕那边吃饭。奶奶一直笑，还请我们把手机放近一点儿，好让她看清哥哥。", "sha256": "53903b02837a20035ca58f1b4fe13f412e501fb7612e5f869df9ffb1fc404c18"}, {"key": "689adfbaa5b63ac16b96aac6", "speaker": "female", "text": "第20题。", "sha256": "f2a7aa65a74fad7dc9d19d81d6990ac99260287106ff304656efb599e75400e1"}, {"key": "92be713b27b4a37a485ba0ed", "speaker": "female", "text": "家里明天有客人来，我们还需要买什么？请说一种东西，也可以说已经准备好了。", "sha256": "6c7b23b0f2cf8de87feee593fab87ba00af42fe8fb1303cac343c182a28a8fe4"}, {"key": "7eb01901729f4ce398b37aa5", "speaker": "female", "text": "招待客人，你想选水果还是点心？也可以选别的东西。", "sha256": "87b3ccbd4bbfa4404b3a62e0feb41e9d766666e628d66d0059ba28dc0b7fbbf4"}, {"key": "787a0759bbf12b2bfe8b98d0", "speaker": "female", "text": "这个选择有什么好处？给我说一个和客人有关的理由吧。", "sha256": "fd2fa3a5b0f299fed51c1a883991a825dc9842030da94d1516bae8e7425676f5"}, {"key": "732ef551138527ce0e61acca", "speaker": "female", "text": "市场今天四点就关门，原来五点去来不及了。你准备怎么调整？", "sha256": "9a7b4041db90f5d31db115d0537a40748e2811619744f8405ddd53eafd38c69d"}]}</script><script src="workspace.js" defer></script><noscript>Use the learner PDF and audio review if JavaScript is unavailable.</noscript></body></html>