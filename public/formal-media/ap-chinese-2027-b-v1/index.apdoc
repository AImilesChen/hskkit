<script id="paper-data" type="application/json">{"id": "ap-chinese-2027-b-v1", "examYear": 2027, "paperCode": "B", "version": "editorial-draft-v1", "authoredOn": "2026-11-09", "status": "content_complete_pending_user_audio_and_editorial_acceptance", "title": "AP Chinese · Paper B", "scope": "Complete independent B practice paper: 55 original multiple-choice questions and four free-response tasks. Speaking uses a new music-learning research scenario, not the unreleased official 2027 project packet.", "provenance": {"original": true, "aiAssisted": true, "officialQuestionsCopied": false, "competitorQuestionsCopied": false, "humanListeningAcceptance": false, "nativeTeacherReview": false, "userAcceptance": false, "traditionalScript": "OpenCC s2t with content/terminology comparison; not independent native-editor certification"}, "order": ["speaking", "writing", "listening", "reading"], "timing": {"speaking": {"presentationPreparationSeconds": 180, "presentationResponseSeconds": 180, "qaPlays": 2, "qaResponseSeconds": 40}, "writing": 1800, "listening": 1500, "reading": 2400, "globalDuration": null, "note": "Shared writing clock; original HSKKit listening pacing and navigation, not a certified Bluebook reproduction."}, "counts": {"listening": 25, "reading": 30, "freeResponse": 4, "qaExchanges": 4}, "sets": [{"id": "L1", "section": "listening", "type": "audio-chart", "unit": 5, "title": "Reaching an island lecture on time", "paragraphs": [], "questions": [{"prompt": "Which departure fits Chen’s stated budget and the registration deadline?", "options": {"A": "The 08:40 departure from Coastal Pier.", "B": "The 09:20 departure from Coastal Pier.", "C": "The 10:10 departure from River Mouth Pier.", "D": "The 08:30 departure from River Mouth Pier."}, "correctAnswer": "D", "evidence": [{"paragraphId": "audio", "quote": {"zh-Hans": "单程船票预算不超过二十元", "zh-Hant": "單程船票預算不超過二十元"}}, {"paragraphId": "audio", "quote": {"zh-Hans": "要在九点五十分以前到会场登记，码头到会场还要走五分钟", "zh-Hant": "要在九點五十分以前到會場登記，碼頭到會場還要走五分鐘"}}, {"paragraphId": "chart", "quote": {"zh-Hans": "09:40", "zh-Hant": "09:40"}}, {"paragraphId": "chart", "quote": {"zh-Hans": "18元", "zh-Hant": "18元"}}], "explanation": {"en": "The 08:30 River Mouth boat costs 18 yuan and arrives at 09:40, leaving five minutes to walk before the 09:50 deadline.", "zh": "河口八点半班次票价18元，九点四十分到岛，步行五分钟后仍赶得上登记。"}, "distractors": {"A": {"en": "The 30-yuan fare exceeds his budget.", "zh": "30元票价超过预算。"}, "B": {"en": "It is over budget and arrives too late for registration.", "zh": "它既超预算，也赶不上登记。"}, "C": {"en": "It departs after registration has already ended.", "zh": "它开船时登记已经结束。"}}, "number": 1, "id": "ap2027-b-q01", "skill": "listening.chart_integration"}, {"prompt": "For the 08:30 River Mouth departure, when must ticket purchase be completed?", "options": {"A": "By 08:30 at the automatic ticket machine.", "B": "By 08:15 at the staffed counter.", "C": "By 09:40 after arriving on the island.", "D": "By 09:50 at the lecture registration desk."}, "correctAnswer": "B", "evidence": [{"paragraphId": "audio", "quote": {"zh-Hans": "窗口在每班开船前十五分钟停止售票", "zh-Hant": "窗口在每班開船前十五分鐘停止售票"}}], "explanation": {"en": "Fifteen minutes before 08:30 is 08:15, and the machine is under repair.", "zh": "八点半前十五分钟是八点十五分，而且机器维修，需要到人工窗口。"}, "distractors": {"A": {"en": "The machine is unavailable, and sales stop before departure.", "zh": "机器不能用，售票也早于开船停止。"}, "C": {"en": "Arrival time is not a ticket-purchase deadline.", "zh": "抵达时间不是购票期限。"}, "D": {"en": "Lecture registration and boat ticketing are different steps.", "zh": "讲座登记与购船票是不同环节。"}}, "number": 2, "id": "ap2027-b-q02", "skill": "listening.sequence_timing"}, {"prompt": "What does the listed fare cover?", "options": {"A": "Both the outward and return crossings.", "B": "The crossing and all transport on the island.", "C": "Only the one-way boat journey shown in the table.", "D": "The lecture admission and a reserved return sailing."}, "correctAnswer": "C", "evidence": [{"paragraphId": "audio", "quote": {"zh-Hans": "票价也不包含岛上的交通", "zh-Hant": "票價也不包含島上的交通"}}], "explanation": {"en": "The chart labels the fare as one-way, and the speaker excludes island transport and provides no return booking.", "zh": "表中注明单程票价，讲话者也说明不含岛上交通，没有提供返航预订。"}, "distractors": {"A": {"en": "The chart does not list a round-trip fare.", "zh": "表中不是往返票价。"}, "B": {"en": "Island transport is explicitly excluded.", "zh": "明确不包含岛上交通。"}, "D": {"en": "Neither lecture admission nor a return reservation is included.", "zh": "没有包含讲座入场或返航预订的说明。"}}, "number": 3, "id": "ap2027-b-q03", "skill": "listening.scope_detail"}, {"prompt": "How should travelers interpret a rain symbol on a weather app?", "options": {"A": "Check the pier’s operational notice before assuming a cancellation.", "B": "Assume all sailings are cancelled regardless of any pier notice.", "C": "Choose the most expensive departure to avoid weather restrictions.", "D": "Treat the return sailing time as unchanged without checking it."}, "correctAnswer": "A", "evidence": [{"paragraphId": "audio", "quote": {"zh-Hans": "要看码头发布的运行通知", "zh-Hant": "要看碼頭髮布的運行通知"}}], "explanation": {"en": "Weather forecasts are useful, but an operating notice determines the actual sailing adjustment.", "zh": "天气预报可参考，但实际航班调整要看运行通知。"}, "distractors": {"B": {"en": "The speaker warns against making that assumption.", "zh": "讲话者提醒不要这样直接推断。"}, "C": {"en": "Price does not determine whether a sailing operates.", "zh": "票价不能决定航班是否运行。"}, "D": {"en": "Return details must be checked separately.", "zh": "回程安排仍要另查。"}}, "number": 4, "id": "ap2027-b-q04", "skill": "listening.instruction_interpretation"}, {"prompt": "Why does the speaker discuss several steps beyond the crossing itself?", "options": {"A": "To persuade everyone to choose the fastest and most expensive route.", "B": "To show that registration can be completed at any time after the lecture.", "C": "To imply that walking time is included in the chart’s arrival time.", "D": "To help students plan a feasible journey rather than just select a sailing."}, "correctAnswer": "D", "evidence": [{"paragraphId": "audio", "quote": {"zh-Hans": "把登记、步行和买票所需的时间都算进去", "zh-Hant": "把登記、步行和買票所需的時間都算進去"}}], "explanation": {"en": "A workable plan must account for the activities surrounding the boat trip as well as its arrival time.", "zh": "可行行程还要包含乘船前后环节，不能只选一个班次。"}, "distractors": {"A": {"en": "Chen’s suitable route is the cheaper, longer one.", "zh": "小陈适合的是较便宜、航程较长的一班。"}, "B": {"en": "The registration deadline is explicitly earlier than the lecture.", "zh": "登记截止时间明确早于开讲。"}, "C": {"en": "The five-minute walk is additional to arrival.", "zh": "五分钟步行需要另外计算。"}}, "number": 5, "id": "ap2027-b-q05", "skill": "listening.communicative_purpose"}], "chart": {"title": {"zh-Hans": "周六上午开往海岛的客船", "zh-Hant": "週六上午開往海島的客船"}, "headers": [{"zh-Hans": "出发码头", "zh-Hant": "出發碼頭"}, {"zh-Hans": "开船时间", "zh-Hant": "開船時間"}, {"zh-Hans": "抵达时间", "zh-Hant": "抵達時間"}, {"zh-Hans": "单程票价", "zh-Hant": "單程票價"}], "rows": [[{"zh-Hans": "滨海码头", "zh-Hant": "濱海碼頭"}, {"zh-Hans": "08:40", "zh-Hant": "08:40"}, {"zh-Hans": "09:20", "zh-Hant": "09:20"}, {"zh-Hans": "30元", "zh-Hant": "30元"}], [{"zh-Hans": "河口码头", "zh-Hant": "河口碼頭"}, {"zh-Hans": "08:30", "zh-Hant": "08:30"}, {"zh-Hans": "09:40", "zh-Hant": "09:40"}, {"zh-Hans": "18元", "zh-Hant": "18元"}], [{"zh-Hans": "滨海码头", "zh-Hant": "濱海碼頭"}, {"zh-Hans": "09:20", "zh-Hant": "09:20"}, {"zh-Hans": "10:00", "zh-Hant": "10:00"}, {"zh-Hans": "30元", "zh-Hant": "30元"}], [{"zh-Hans": "河口码头", "zh-Hant": "河口碼頭"}, {"zh-Hans": "10:10", "zh-Hant": "10:10"}, {"zh-Hans": "11:20", "zh-Hant": "11:20"}, {"zh-Hans": "18元", "zh-Hant": "18元"}]], "note": {"zh-Hans": "航班与价格均为本卷原创模拟资料。", "zh-Hant": "航班與價格均爲本卷原創模擬資料。"}}, "script": [{"speaker": "female", "text": {"zh-Hans": "各位参加海岛讲座的同学，请先看周六客船表。讲座十点开始，但大家要在九点五十分以前到会场登记，码头到会场还要走五分钟。所以不能只看哪班船赶得上十点。小陈说，他八点以前就能到河口码头，单程船票预算不超过二十元。我建议他坐河口码头八点半的船，虽然航程长一些，仍有时间登记，也符合预算。今天河口码头的自动售票机维修，请去人工窗口买票，窗口在每班开船前十五分钟停止售票。表中只列去程，不能把到岛时间当成返航时间；回程请另外查表。票价也不包含岛上的交通。最后，手机显示可能下雨，不等于客船一定停航。当天是否调整航班，要看码头发布的运行通知。可以提前查看消息，但不要只凭天气图标判断。请把登记、步行和买票所需的时间都算进去，给行程留出余地。", "zh-Hant": "各位參加海島講座的同學，請先看週六客船表。講座十點開始，但大家要在九點五十分以前到會場登記，碼頭到會場還要走五分鐘。所以不能只看哪班船趕得上十點。小陳說，他八點以前就能到河口碼頭，單程船票預算不超過二十元。我建議他坐河口碼頭八點半的船，雖然航程長一些，仍有時間登記，也符合預算。今天河口碼頭的自動售票機維修，請去人工窗口買票，窗口在每班開船前十五分鐘停止售票。表中只列去程，不能把到島時間當成返航時間；回程請另外查表。票價也不包含島上的交通。最後，手機顯示可能下雨，不等於客船一定停航。當天是否調整航班，要看碼頭髮布的運行通知。可以提前查看消息，但不要只憑天氣圖標判斷。請把登記、步行和買票所需的時間都算進去，給行程留出餘地。"}}]}, {"id": "L2", "section": "listening", "type": "audio-report", "unit": 6, "title": "A neighborhood tests a night-lighting plan", "paragraphs": [], "questions": [{"prompt": "What is the report primarily describing?", "options": {"A": "A trial that adjusts decorative lighting while responding to different users.", "B": "A plan to remove all lighting from the commercial street after sunset.", "C": "A competition to choose the brightest shop sign in the neighborhood.", "D": "A decision to make every shop remain open through the night."}, "correctAnswer": "A", "evidence": [{"paragraphId": "audio", "quote": {"zh-Hans": "调低装饰灯亮度，但公交站和人行道的基本照明不变", "zh-Hant": "調低裝飾燈亮度，但公交站和人行道的基本照明不變"}}], "explanation": {"en": "The plan distinguishes decorative lighting from basic lighting and responds to residents, late workers, and shops.", "zh": "方案区分装饰灯与基本照明，并回应住户、晚归者和店铺的不同需要。"}, "distractors": {"B": {"en": "Basic lighting is explicitly retained.", "zh": "基本照明明确保留。"}, "C": {"en": "No brightness contest is proposed.", "zh": "没有举办招牌亮度比赛。"}, "D": {"en": "Shop opening hours are not being extended.", "zh": "没有延长商店营业时间。"}}, "number": 6, "id": "ap2027-b-q06", "skill": "listening.main_idea"}, {"prompt": "Which lighting is explicitly left unchanged in the initial trial?", "options": {"A": "All lights directed toward residential windows.", "B": "Every decorative lamp outside shops.", "C": "Basic lighting at bus stops and along pedestrian paths.", "D": "Only the illuminated lettering on commercial signs."}, "correctAnswer": "C", "evidence": [{"paragraphId": "audio", "quote": {"zh-Hans": "公交站和人行道的基本照明不变", "zh-Hant": "公交站和人行道的基本照明不變"}}], "explanation": {"en": "The initial reduction targets decoration, not these essential walking and transit areas.", "zh": "最初调低的是装饰照明，不是公交站与人行道基本照明。"}, "distractors": {"A": {"en": "Light entering windows is a concern to be reduced.", "zh": "照进住宅的光线正是需要处理的问题。"}, "B": {"en": "Decorative lamps are the target of dimming.", "zh": "装饰灯就是调暗对象。"}, "D": {"en": "The report does not identify lettering as the protected category.", "zh": "原文并未把招牌文字列为保持不变的类别。"}}, "number": 7, "id": "ap2027-b-q07", "skill": "listening.detail"}, {"prompt": "What does the night-shift worker’s comment add to the discussion?", "options": {"A": "Evidence that no residents go to sleep before eleven.", "B": "A reminder that less common schedules still create legitimate needs.", "C": "A request to measure electricity only during shop opening hours.", "D": "Proof that every resident wants the same lighting level."}, "correctAnswer": "B", "evidence": [{"paragraphId": "audio", "quote": {"zh-Hans": "不能因为多数人已经睡觉，就忽略少数晚归者", "zh-Hant": "不能因爲多數人已經睡覺，就忽略少數晚歸者"}}], "explanation": {"en": "The comment challenges the assumption that majority routines cover everyone’s use of the street.", "zh": "这条意见指出多数人的作息不能代表所有道路使用者。"}, "distractors": {"A": {"en": "The worker does not describe everyone’s bedtime.", "zh": "没有说明所有人的入睡时间。"}, "C": {"en": "The comment concerns access, not meter timing.", "zh": "重点是晚归通行，不是电表统计时段。"}, "D": {"en": "The report highlights differing needs.", "zh": "报道强调需要不同。"}}, "number": 8, "id": "ap2027-b-q08", "skill": "listening.inference"}, {"prompt": "Why is a low pedestrian count on one night not enough to remove a route’s lighting?", "options": {"A": "It proves that the route is used only by shop owners.", "B": "It means the electricity meter cannot record that night.", "C": "It shows that all feedback must be collected online.", "D": "It does not establish that the route has no important users."}, "correctAnswer": "D", "evidence": [{"paragraphId": "audio", "quote": {"zh-Hans": "没有把一晚经过的人数少，直接理解成那条路没人需要", "zh-Hant": "沒有把一晚經過的人數少，直接理解成那條路沒人需要"}}], "explanation": {"en": "A single count can miss occasional or minority use that still matters.", "zh": "一次统计可能遗漏偶发但重要的使用需要。"}, "distractors": {"A": {"en": "The identity of all users cannot be inferred from a low count.", "zh": "人数少不能推出使用者都是什么身份。"}, "B": {"en": "Pedestrian counts do not disable an electricity meter.", "zh": "行人数不会使电表失效。"}, "C": {"en": "The team conducts on-site interviews.", "zh": "小组实际进行了现场访谈。"}}, "number": 9, "id": "ap2027-b-q09", "skill": "listening.evidence_limit"}, {"prompt": "How does the project leader propose evaluating the changes?", "options": {"A": "Combine electricity records with location-specific feedback.", "B": "Choose whichever shop uses the least electricity as the sole model.", "C": "Stop revising the plan once a majority has voted.", "D": "Treat a reduction in power use as proof that every route is convenient."}, "correctAnswer": "A", "evidence": [{"paragraphId": "audio", "quote": {"zh-Hans": "数字与现场反馈都要保留", "zh-Hant": "數字與現場反饋都要保留"}}], "explanation": {"en": "Meter data address electricity use, while feedback addresses how the space works for people.", "zh": "电表说明用电，反馈说明实际使用体验，两者回答不同问题。"}, "distractors": {"B": {"en": "No single shop is selected as the only model.", "zh": "没有选一家店作为唯一模式。"}, "C": {"en": "The leader says revision continues after a vote.", "zh": "负责人明确表示投票后仍需调整。"}, "D": {"en": "Power use alone cannot establish convenient access.", "zh": "用电减少不能单独证明通行方便。"}}, "number": 10, "id": "ap2027-b-q10", "skill": "listening.evaluation"}], "script": [{"speaker": "male", "text": {"zh-Hans": "青石街最近试行新的夜间照明安排。以前，商店关门后，店外装饰灯仍亮到天明，有居民觉得窗外太亮。街道先在一小段商业路上试行：晚上十一点以后调低装饰灯亮度，但公交站和人行道的基本照明不变。消息公布后，一位夜班下班的居民提出，不能因为多数人已经睡觉，就忽略少数晚归者。项目小组于是增加了晚间步行访谈，邀请店员、保安和附近住户一起看哪些位置需要补充标识。他们没有把一晚经过的人数少，直接理解成那条路没人需要。与此同时，几家店铺担心调暗以后招牌不明显。小组决定先调整照射方向，减少灯光直接进入住宅，再比较不同时间的使用情况。本月收到的意见中，有人说睡觉更舒服，也有人仍觉得转弯处看不清。负责人表示，试行不是一次投票后就结束，而是要根据具体位置继续修改。电表记录能说明用电变化，却不能单独回答每个人走路是否方便，因此数字与现场反馈都要保留。", "zh-Hant": "青石街最近試行新的夜間照明安排。以前，商店關門後，店外裝飾燈仍亮到天明，有居民覺得窗外太亮。街道先在一小段商業路上試行：晚上十一點以後調低裝飾燈亮度，但公交站和人行道的基本照明不變。消息公佈後，一位夜班下班的居民提出，不能因爲多數人已經睡覺，就忽略少數晚歸者。項目小組於是增加了晚間步行訪談，邀請店員、保安和附近住戶一起看哪些位置需要補充標識。他們沒有把一晚經過的人數少，直接理解成那條路沒人需要。與此同時，幾家店鋪擔心調暗以後招牌不明顯。小組決定先調整照射方向，減少燈光直接進入住宅，再比較不同時間的使用情況。本月收到的意見中，有人說睡覺更舒服，也有人仍覺得轉彎處看不清。負責人表示，試行不是一次投票後就結束，而是要根據具體位置繼續修改。電錶記錄能說明用電變化，卻不能單獨回答每個人走路是否方便，因此數字與現場反饋都要保留。"}}]}, {"id": "L3", "section": "listening", "type": "conversation", "unit": 2, "title": "What does an invitation to participate really mean?", "paragraphs": [], "questions": [{"prompt": "What problem does the male speaker identify in the proposed translation?", "options": {"A": "It makes the club sound as if it offers only technical roles.", "B": "It suggests that performances will take place without a stage.", "C": "It turns an invitation to participate into an obligation to perform.", "D": "It gives rehearsal times that conflict with the Chinese poster."}, "correctAnswer": "C", "evidence": [{"paragraphId": "audio", "quote": {"zh-Hans": "听起来像是强制表演了", "zh-Hant": "聽起來像是強制表演了"}}], "explanation": {"en": "The original slogan welcomes different forms of participation; “must” wrongly suggests compulsory acting.", "zh": "原口号欢迎多种参与方式，“必须”却让人以为被强制表演。"}, "distractors": {"A": {"en": "The draft does not limit people to technical work.", "zh": "草稿没有限定只能做技术工作。"}, "B": {"en": "The stage is figurative here, not a venue claim.", "zh": "这里的问题不是有没有实际舞台。"}, "D": {"en": "The first draft contains no rehearsal schedule.", "zh": "最初译法尚未涉及排练时间。"}}, "number": 11, "id": "ap2027-b-q11", "skill": "listening.communicative_misunderstanding"}, {"prompt": "Which example would best reassure the student who is nervous about speaking?", "options": {"A": "A beginner can try a backstage role with guidance.", "B": "Every participant must deliver a speech at the first rehearsal.", "C": "Only experienced performers may attend the open rehearsal.", "D": "Signing up removes all expectations about attendance."}, "correctAnswer": "A", "evidence": [{"paragraphId": "audio", "quote": {"zh-Hans": "新手做灯光时，会有学长带着", "zh-Hant": "新手做燈光時，會有學長帶着"}}], "explanation": {"en": "A supported backstage option addresses anxiety more concretely than a vague assurance.", "zh": "有人指导的幕后角色，比笼统安慰更能回应怕开口的顾虑。"}, "distractors": {"B": {"en": "A compulsory speech would repeat the original misunderstanding.", "zh": "强制演讲反而延续误解。"}, "C": {"en": "The open rehearsal is intended to welcome inexperienced participants.", "zh": "开放排练也欢迎没有经验的人。"}, "D": {"en": "Participation still involves scheduling responsibilities.", "zh": "参加活动仍有时间责任。"}}, "number": 12, "id": "ap2027-b-q12", "skill": "listening.inference"}, {"prompt": "In this conversation, what does “门槛不高” suggest?", "options": {"A": "The entrance to the theater has been physically lowered.", "B": "The performance space has a limited number of seats.", "C": "The club’s budget is smaller than last year’s budget.", "D": "A high level of prior experience is not required."}, "correctAnswer": "D", "evidence": [{"paragraphId": "audio", "quote": {"zh-Hans": "没有演出经验也能找到参与的方式", "zh-Hant": "沒有演出經驗也能找到參與的方式"}}], "explanation": {"en": "The phrase concerns entry requirements, but the speakers want to replace vagueness with concrete information.", "zh": "这里指经验要求不高，不过讲话者认为还需具体说明。"}, "distractors": {"A": {"en": "The context is recruitment, not building access.", "zh": "语境是招募，不是建筑入口。"}, "B": {"en": "Seating capacity is not discussed.", "zh": "没有讨论座位数量。"}, "C": {"en": "No year-to-year budget comparison appears.", "zh": "没有年度预算比较。"}}, "number": 13, "id": "ap2027-b-q13", "skill": "listening.context_meaning", "promptByScript": {"zh-Hans": "In this conversation, what does “门槛不高” suggest?", "zh-Hant": "In this conversation, what does “門檻不高” suggest?"}}, {"prompt": "What qualification do the speakers add to the idea of free choice?", "options": {"A": "Participants should choose roles solely according to the shortest title.", "B": "Choosing a role still requires meeting stated commitments.", "C": "Every participant may change the performance date independently.", "D": "The English poster should omit scheduling details to stay brief."}, "correctAnswer": "B", "evidence": [{"paragraphId": "audio", "quote": {"zh-Hans": "选择角色不等于没有责任", "zh-Hant": "選擇角色不等於沒有責任"}}], "explanation": {"en": "The club offers role choice while requiring coordination around rehearsals and the performance.", "zh": "角色可以选择，但排练和演出的时间仍需配合。"}, "distractors": {"A": {"en": "Title length is irrelevant to role selection.", "zh": "角色名称长短不是选择依据。"}, "C": {"en": "Dates cannot be set independently by each participant.", "zh": "参与者不能各自更改演出日期。"}, "D": {"en": "They decide to add the rehearsal times.", "zh": "他们决定补上排练时间。"}}, "number": 14, "id": "ap2027-b-q14", "skill": "listening.requirement_detail"}, {"prompt": "What broader approach to translation do the speakers support?", "options": {"A": "Follow the literal wording even if readers misunderstand the invitation.", "B": "Use the shortest possible phrase regardless of missing information.", "C": "Communicate the intended choices and responsibilities in context.", "D": "Remove the Chinese slogan because figurative language cannot be explained."}, "correctAnswer": "C", "evidence": [{"paragraphId": "audio", "quote": {"zh-Hans": "解释应该帮助读者作决定，而不是只追求字面上对应", "zh-Hant": "解釋應該幫助讀者作決定，而不是隻追求字面上對應"}}], "explanation": {"en": "They prioritize practical understanding of the message over word-for-word matching.", "zh": "他们重视读者理解实际含义，而不只追求逐字对应。"}, "distractors": {"A": {"en": "Literal matching caused the misunderstanding.", "zh": "逐字对应已经造成误解。"}, "B": {"en": "Brevity alone does not ensure clarity.", "zh": "简短不必然清楚。"}, "D": {"en": "They explicitly allow the Chinese slogan to remain.", "zh": "他们明确可以保留中文口号。"}}, "number": 15, "id": "ap2027-b-q15", "skill": "listening.communicative_purpose"}], "script": [{"speaker": "female", "text": {"zh-Hans": "戏剧社的海报上写“把舞台交给每个人”，我想翻译成“每个人都必须上台”，你觉得可以吗？", "zh-Hant": "戲劇社的海報上寫“把舞臺交給每個人”，我想翻譯成“每個人都必須上臺”，你覺得可以嗎？"}}, {"speaker": "male", "text": {"zh-Hans": "听起来像是强制表演了。我们本来想说，没有演出经验也能找到参与的方式。有人喜欢演戏，也有人想做灯光、服装或者接待。", "zh-Hant": "聽起來像是強制表演了。我們本來想說，沒有演出經驗也能找到參與的方式。有人喜歡演戲，也有人想做燈光、服裝或者接待。"}}, {"speaker": "female", "text": {"zh-Hans": "难怪昨天一位同学说，他一紧张就说不出话，所以不敢报名。我只告诉他“门槛不高”，他还是担心。", "zh-Hant": "難怪昨天一位同學說，他一緊張就說不出話，所以不敢報名。我只告訴他“門檻不高”，他還是擔心。"}}, {"speaker": "male", "text": {"zh-Hans": "“门槛不高”太笼统了。我们可以具体写出来：不用先准备试演，报名后先参加一次开放排练，再选想尝试的角色。新手做灯光时，会有学长带着。", "zh-Hant": "“門檻不高”太籠統了。我們可以具體寫出來：不用先準備試演，報名後先參加一次開放排練，再選想嘗試的角色。新手做燈光時，會有學長帶着。"}}, {"speaker": "female", "text": {"zh-Hans": "那英文口号可以写“按自己的方式参与”，旁边再列几种角色。不过只写“自由选择”，会不会让人以为任何时间来都行？", "zh-Hant": "那英文口號可以寫“按自己的方式參與”，旁邊再列幾種角色。不過只寫“自由選擇”，會不會讓人以爲任何時間來都行？"}}, {"speaker": "male", "text": {"zh-Hans": "对，选择角色不等于没有责任。周四排练和演出当天的时间要写清楚。如果时间冲突，要先联系协调人，不要答应了又没人到场。", "zh-Hant": "對，選擇角色不等於沒有責任。週四排練和演出當天的時間要寫清楚。如果時間衝突，要先聯繫協調人，不要答應了又沒人到場。"}}, {"speaker": "female", "text": {"zh-Hans": "我明白了。海报不是越短越好，而是要让人看懂，哪些地方有选择，哪些安排需要配合。我会把原来的强制语气改掉，也补上排练时间。", "zh-Hant": "我明白了。海報不是越短越好，而是要讓人看懂，哪些地方有選擇，哪些安排需要配合。我會把原來的強制語氣改掉，也補上排練時間。"}}, {"speaker": "male", "text": {"zh-Hans": "这样才符合我们要表达的意思。中文口号可以保留，但解释应该帮助读者作决定，而不是只追求字面上对应。", "zh-Hant": "這樣才符合我們要表達的意思。中文口號可以保留，但解釋應該幫助讀者作決定，而不是隻追求字面上對應。"}}]}, {"id": "L4", "section": "listening", "type": "instructional-guidance", "unit": 4, "title": "Preparing a map for a digital exhibition", "paragraphs": [], "questions": [{"prompt": "Why should the map’s recording date appear near its title?", "options": {"A": "To make clear that the map documents a past situation.", "B": "To guarantee that every street still follows the same layout.", "C": "To replace the need to provide a title for the exhibition.", "D": "To indicate the exact time every future visitor will arrive."}, "correctAnswer": "A", "evidence": [{"paragraphId": "audio", "quote": {"zh-Hans": "不是实时导航图，标题旁要写清记录时间", "zh-Hant": "不是實時導航圖，標題旁要寫清記錄時間"}}], "explanation": {"en": "The date prevents a historical record from being mistaken for current navigation information.", "zh": "日期能避免把过去的记录误当成实时导航。"}, "distractors": {"B": {"en": "The date does not guarantee that streets remain unchanged.", "zh": "标日期不能保证街区未变。"}, "C": {"en": "A recording date does not replace a meaningful title.", "zh": "日期不能代替标题。"}, "D": {"en": "The date concerns the source, not visitor arrival.", "zh": "日期说明材料时间，不是访客到达时间。"}}, "number": 16, "id": "ap2027-b-q16", "skill": "listening.communicative_purpose"}, {"prompt": "What should be done before reducing the size of a scanned map?", "options": {"A": "Delete the original so the computer uses less storage.", "B": "Publish the largest version and resize it only after complaints.", "C": "Create an upload copy while retaining the original file.", "D": "Remove all small writing regardless of its meaning."}, "correctAnswer": "C", "evidence": [{"paragraphId": "audio", "quote": {"zh-Hans": "保留一份原始文件，再复制一份作为上传版本", "zh-Hant": "保留一份原始文件，再複製一份作爲上傳版本"}}], "explanation": {"en": "Working on a copy preserves information and makes later corrections possible.", "zh": "在副本上处理能保留信息，也方便后续修改。"}, "distractors": {"A": {"en": "The speaker explicitly says to keep the original.", "zh": "讲话者明确要求保留原始文件。"}, "B": {"en": "Checks are required before publication.", "zh": "发布前就要检查。"}, "D": {"en": "Small writing must remain legible, not be discarded automatically.", "zh": "小字应保持可读，不能一律删除。"}}, "number": 17, "id": "ap2027-b-q17", "skill": "listening.sequence_detail"}, {"prompt": "What would best satisfy the instruction about the red and green routes?", "options": {"A": "Make both routes thinner and leave the legend blank.", "B": "Use different line patterns or labels as well as color.", "C": "Choose darker colors without adding any other distinction.", "D": "Explain only that one color is more attractive than the other."}, "correctAnswer": "B", "evidence": [{"paragraphId": "audio", "quote": {"zh-Hans": "不能只靠颜色区分", "zh-Hant": "不能只靠顏色區分"}}], "explanation": {"en": "Additional patterns or text allow the routes to be distinguished without relying solely on color.", "zh": "补充线型或文字，让路线区分不只依赖颜色。"}, "distractors": {"A": {"en": "Thinner lines and no legend reduce clarity.", "zh": "细线且无图例会降低清晰度。"}, "C": {"en": "Changing shades still relies only on color.", "zh": "只换深浅仍然只靠颜色。"}, "D": {"en": "Aesthetic preference does not identify the routes.", "zh": "美观偏好不能说明路线区别。"}}, "number": 18, "id": "ap2027-b-q18", "skill": "listening.instruction_application"}, {"prompt": "What is the correct response if the legend was cut off during scanning?", "options": {"A": "Assume visitors can infer the symbols from the title alone.", "B": "Hide all route lines to avoid explaining their meaning.", "C": "Add an unrelated sample legend copied from another map.", "D": "Scan the complete page again so the original legend is included."}, "correctAnswer": "D", "evidence": [{"paragraphId": "audio", "quote": {"zh-Hans": "请重新扫描完整页面", "zh-Hant": "請重新掃描完整頁面"}}], "explanation": {"en": "The original legend supplies the intended meaning of the symbols and should not be guessed or substituted.", "zh": "原图例说明符号本意，应完整呈现，不能猜测或替换。"}, "distractors": {"A": {"en": "The title does not establish the meaning of every symbol.", "zh": "标题不能说明每个符号。"}, "B": {"en": "Removing routes would remove relevant exhibition content.", "zh": "删掉路线会丢失展示内容。"}, "C": {"en": "Another map’s legend may describe different symbols.", "zh": "别的地图图例可能表示不同内容。"}}, "number": 19, "id": "ap2027-b-q19", "skill": "listening.detail"}, {"prompt": "What is the purpose of the draft stage after submission?", "options": {"A": "It lets the author check the presentation before making it public.", "B": "It proves the map will automatically update as streets change.", "C": "It allows the original file to be discarded without consequence.", "D": "It prevents the author from correcting links once they are entered."}, "correctAnswer": "A", "evidence": [{"paragraphId": "audio", "quote": {"zh-Hans": "不会立刻公开", "zh-Hant": "不會立刻公開"}}], "explanation": {"en": "The draft stage permits device previews, cropping checks, link checks, and corrections before publication.", "zh": "草稿阶段能先核对不同设备上的裁切与链接，再决定公开。"}, "distractors": {"B": {"en": "There is no automatic map-update function.", "zh": "没有自动更新街区信息的功能。"}, "C": {"en": "The source file remains useful for corrections.", "zh": "原文件仍有助于修改。"}, "D": {"en": "The author can return to the draft to make changes.", "zh": "作者可以回草稿修改。"}}, "number": 20, "id": "ap2027-b-q20", "skill": "listening.review_process"}], "script": [{"speaker": "female", "text": {"zh-Hans": "今天的培训是把手绘街区地图放进学校的数字展览。先提醒大家，这张图记录的是去年暑假的街区，不是实时导航图，标题旁要写清记录时间。扫描以后，请保留一份原始文件，再复制一份作为上传版本；不要为了缩小文件，直接覆盖唯一的原图。系统要求上传文件不超过五兆，如果图片过大，可以在副本上缩小尺寸，但要检查小字是否还能读清。地图上的红线和绿线表示两条不同路线，不能只靠颜色区分，请再加实线、虚线或文字标记。接下来填写图片说明，不必把图上每个字都抄一遍，应先说明地图展示什么，再描述两条路线的主要差别。如果扫描时漏掉图例，请重新扫描完整页面，别让参观者猜线条是什么意思。提交后会先进入草稿区，不会立刻公开。请在手机和电脑上各预览一次，确认边缘没有被裁掉，链接也指向你想展示的内容，再点“发布”。如果发现错误，可以回草稿修改，保留原始文件会让这一步容易得多。", "zh-Hant": "今天的培訓是把手繪街區地圖放進學校的數字展覽。先提醒大家，這張圖記錄的是去年暑假的街區，不是實時導航圖，標題旁要寫清記錄時間。掃描以後，請保留一份原始文件，再複製一份作爲上傳版本；不要爲了縮小文件，直接覆蓋唯一的原圖。系統要求上傳文件不超過五兆，如果圖片過大，可以在副本上縮小尺寸，但要檢查小字是否還能讀清。地圖上的紅線和綠線表示兩條不同路線，不能只靠顏色區分，請再加實線、虛線或文字標記。接下來填寫圖片說明，不必把圖上每個字都抄一遍，應先說明地圖展示什麼，再描述兩條路線的主要差別。如果掃描時漏掉圖例，請重新掃描完整頁面，別讓參觀者猜線條是什麼意思。提交後會先進入草稿區，不會立刻公開。請在手機和電腦上各預覽一次，確認邊緣沒有被裁掉，鏈接也指向你想展示的內容，再點“發佈”。如果發現錯誤，可以回草稿修改，保留原始文件會讓這一步容易得多。"}}]}, {"id": "L5", "section": "listening", "type": "presentation", "unit": 1, "title": "What a household task chart could not count", "paragraphs": [], "questions": [{"prompt": "What does the speaker’s experience suggest about the original point system?", "options": {"A": "It accurately measured every kind of contribution from the beginning.", "B": "It made visible results comparable while overlooking important differences.", "C": "It failed because the family refused to record any completed tasks.", "D": "It showed that preparation takes no time and needs no recognition."}, "correctAnswer": "B", "evidence": [{"paragraphId": "audio", "quote": {"zh-Hans": "妹妹洗一次碗得一分，外公花一个小时买菜也只得一分", "zh-Hant": "妹妹洗一次碗得一分，外公花一個小時買菜也只得一分"}}], "explanation": {"en": "Equal points did not reflect differences in effort or the less visible work of planning.", "zh": "相同分数没有体现投入差异，也遗漏较不显眼的准备工作。"}, "distractors": {"A": {"en": "The family identifies several things the system missed.", "zh": "家人发现制度漏算了多项贡献。"}, "C": {"en": "They did record tasks; the problem was how to interpret the record.", "zh": "他们确实记录，问题在于怎样衡量。"}, "D": {"en": "Preparation is precisely what they begin to recognize.", "zh": "准备工作正是后来开始被看见的部分。"}}, "number": 21, "id": "ap2027-b-q21", "skill": "listening.main_idea"}, {"prompt": "Which contribution illustrates the work that timing alone initially missed?", "options": {"A": "Recording the exact number of dishes after washing.", "B": "Comparing who accumulated the highest monthly total.", "C": "Watching the clock while another person shops.", "D": "Anticipating what the household will need during the week."}, "correctAnswer": "D", "evidence": [{"paragraphId": "audio", "quote": {"zh-Hans": "谁提前想好一周吃什么", "zh-Hant": "誰提前想好一週喫什麼"}}], "explanation": {"en": "Planning and remembering needs may support a visible task without appearing in its timed duration.", "zh": "计划和记住需求支持着具体任务，却不一定体现在操作时长中。"}, "distractors": {"A": {"en": "Dish counts remain a visible output, not the planning discussed.", "zh": "碗的数量是可见结果，不是所说的计划工作。"}, "B": {"en": "Ranking totals does not recognize planning.", "zh": "比较总分不能识别准备工作。"}, "C": {"en": "Watching a clock is not the omitted contribution described.", "zh": "看时间不是原文指出的遗漏贡献。"}}, "number": 22, "id": "ap2027-b-q22", "skill": "listening.detail"}, {"prompt": "Why does the family ask the sister to accompany her grandfather to the market?", "options": {"A": "To help her learn a responsibility rather than fixing her permanently in one task.", "B": "To prove that only older people can understand how to buy food.", "C": "To replace all planning with a rule that everyone buys the same items.", "D": "To remove her from the discussion of how household work is shared."}, "correctAnswer": "A", "evidence": [{"paragraphId": "audio", "quote": {"zh-Hans": "下周试着列清单", "zh-Hant": "下週試着列清單"}}], "explanation": {"en": "Guided experience creates a path toward learning and taking on another role.", "zh": "先跟着做，再尝试列清单，提供了学习与承担新角色的机会。"}, "distractors": {"B": {"en": "Both younger and older members are learning.", "zh": "年轻人和长辈都在学习。"}, "C": {"en": "The family wants to avoid duplicate purchases, not enforce identical lists.", "zh": "家人想避免买重复，不是统一采购同样物品。"}, "D": {"en": "The arrangement includes her in the shared responsibilities.", "zh": "这个安排让她参与共同责任。"}}, "number": 23, "id": "ap2027-b-q23", "skill": "listening.inference"}, {"prompt": "In the final part, what does “搭把手” mean?", "options": {"A": "Record another person’s mistakes on the household chart.", "B": "Complete every task without consulting anyone else.", "C": "Offer practical help when another person needs support.", "D": "Let the person with the most points set all the rules."}, "correctAnswer": "C", "evidence": [{"paragraphId": "audio", "quote": {"zh-Hans": "在需要的时候搭把手", "zh-Hant": "在需要的時候搭把手"}}], "explanation": {"en": "The surrounding discussion of changing tasks when someone is busy or unwell gives the phrase its sense of helping.", "zh": "忙碌或不舒服时可以协商换手，说明这里指提供实际帮助。"}, "distractors": {"A": {"en": "The phrase concerns help, not fault-finding.", "zh": "这里说帮助，不是挑错。"}, "B": {"en": "The family emphasizes discussion rather than working without consultation.", "zh": "家庭强调协商，不是独自决定一切。"}, "D": {"en": "High scores are no longer the basis of fairness.", "zh": "高分已经不再是公平的唯一依据。"}}, "number": 24, "id": "ap2027-b-q24", "skill": "listening.context_meaning", "promptByScript": {"zh-Hans": "In the final part, what does “搭把手” mean?", "zh-Hant": "In the final part, what does “搭把手” mean?"}}, {"prompt": "What is the speaker’s final position on task charts?", "options": {"A": "A chart should replace conversation once every box has been filled in.", "B": "A chart can be useful if it supports discussion and changing needs.", "C": "A chart can guarantee the same arrangement will suit every household.", "D": "A chart is useful only when the family stops making changes to it."}, "correctAnswer": "B", "evidence": [{"paragraphId": "audio", "quote": {"zh-Hans": "定期说清彼此的需要，比一张看起来很精确的表更有用", "zh-Hant": "定期說清彼此的需要，比一張看起來很精確的表更有用"}}], "explanation": {"en": "The family retains the chart as a tool, while communication and flexibility determine how it is used.", "zh": "他们保留表格作为工具，同时靠沟通和弹性决定怎样使用。"}, "distractors": {"A": {"en": "Conversation remains essential.", "zh": "沟通仍然重要。"}, "C": {"en": "The speaker explicitly limits the example to their own family.", "zh": "讲话者明确说明这是自家做法。"}, "D": {"en": "Adjustments are part of the improved arrangement.", "zh": "调整本身就是改进的一部分。"}}, "number": 25, "id": "ap2027-b-q25", "skill": "listening.stance"}], "script": [{"speaker": "male", "text": {"zh-Hans": "上个月，我们家试着把家务写在表上，做一件事就记一分，月底看谁分数最多。起初我觉得很公平，因为每个人都看得见结果。后来，妹妹洗一次碗得一分，外公花一个小时买菜也只得一分，大家开始争论。我们改成按时间记，可新的问题又出现了：谁记得家里缺什么、谁提前想好一周吃什么，这些准备往往没有被算进去。妈妈说，表格能帮助提醒，却不该把照顾家人变成争分数。我们于是开了一次家庭讨论，不先问谁做得最多，而是问哪些事情总没人注意，哪些人最近特别忙。妹妹还不会安排采购，我们没有让她永远只洗碗，而是请她先跟外公去一次市场，下周试着列清单。外公也愿意学会用手机查看清单，免得买重复。现在，任务仍写在表上，但遇到考试、加班或身体不舒服时，可以提前商量换手。对我来说，公平不再只是数字相等，也包括看见没被记录的准备、让人有机会学习，以及在需要的时候搭把手。这是我们家的做法，不一定适合每一个家庭，但定期说清彼此的需要，比一张看起来很精确的表更有用。", "zh-Hant": "上個月，我們家試着把家務寫在表上，做一件事就記一分，月底看誰分數最多。起初我覺得很公平，因爲每個人都看得見結果。後來，妹妹洗一次碗得一分，外公花一個小時買菜也只得一分，大家開始爭論。我們改成按時間記，可新的問題又出現了：誰記得家裏缺什麼、誰提前想好一週喫什麼，這些準備往往沒有被算進去。媽媽說，表格能幫助提醒，卻不該把照顧家人變成爭分數。我們於是開了一次家庭討論，不先問誰做得最多，而是問哪些事情總沒人注意，哪些人最近特別忙。妹妹還不會安排採購，我們沒有讓她永遠只洗碗，而是請她先跟外公去一次市場，下週試着列清單。外公也願意學會用手機查看清單，免得買重複。現在，任務仍寫在表上，但遇到考試、加班或身體不舒服時，可以提前商量換手。對我來說，公平不再只是數字相等，也包括看見沒被記錄的準備、讓人有機會學習，以及在需要的時候搭把手。這是我們家的做法，不一定適合每一個家庭，但定期說清彼此的需要，比一張看起來很精確的表更有用。"}}]}, {"id": "R1", "section": "reading", "type": "correspondence", "unit": 2, "title": "Revising a language-partner program", "paragraphs": [{"id": "p1", "text": {"zh-Hans": "邮件一｜协调员致学生志愿者\n各位同学：下个月的语言伙伴计划原定每周二晚上见面一小时，整个学期固定搭档。报名者中有人想练习日常交谈，也有人主要想了解课堂讨论的表达方式。我们准备让每次活动都按同一份话题表进行，方便统一管理。请大家周五前提出意见，并说明自己能负责的工作。", "zh-Hant": "郵件一｜協調員致學生志願者\n各位同學：下個月的語言夥伴計劃原定每週二晚上見面一小時，整個學期固定搭檔。報名者中有人想練習日常交談，也有人主要想了解課堂討論的表達方式。我們準備讓每次活動都按同一份話題表進行，方便統一管理。請大家週五前提出意見，並說明自己能負責的工作。"}}, {"id": "p2", "text": {"zh-Hans": "邮件二｜志愿者顾岚回复\n老师您好！固定时间和搭档有助于熟悉彼此，不过有几位报名者周二要实习，照这个安排，他们还没开始就会被排除。我建议保留周二活动，同时增加一个可预约的周末小组。搭档可以先固定两次，再根据双方目标协商是否调整，而不是每次都随机换人。", "zh-Hant": "郵件二｜志願者顧嵐回覆\n老師您好！固定時間和搭檔有助於熟悉彼此，不過有幾位報名者週二要實習，照這個安排，他們還沒開始就會被排除。我建議保留週二活動，同時增加一個可預約的週末小組。搭檔可以先固定兩次，再根據雙方目標協商是否調整，而不是每次都隨機換人。"}}, {"id": "p3", "text": {"zh-Hans": "话题表可以作为备用，不必要求每个人按顺序谈完。日常交谈组可用具体生活情境，课堂讨论组则可以练习提问和说明理由。我可以整理两类活动卡，并在首次见面时帮助大家写下自己的目标。是否能先试行四周，再收集参与者对安排的反馈？另外，我想确认，周末活动室是否已经有人负责开门。这个问题解决后，我就能联系小组成员。", "zh-Hant": "話題表可以作爲備用，不必要求每個人按順序談完。日常交談組可用具體生活情境，課堂討論組則可以練習提問和說明理由。我可以整理兩類活動卡，並在首次見面時幫助大家寫下自己的目標。是否能先試行四周，再收集參與者對安排的反饋？另外，我想確認，週末活動室是否已經有人負責開門。這個問題解決後，我就能聯繫小組成員。"}}], "questions": [{"prompt": "What is Gu Lan’s main purpose in replying?", "options": {"A": "To suggest a more flexible plan while offering specific help.", "B": "To ask that all organized meetings be replaced by unscheduled encounters.", "C": "To reject both fixed partners and any record of participants’ goals.", "D": "To confirm that every applicant has already agreed to Tuesday evenings."}, "correctAnswer": "A", "evidence": [{"paragraphId": "p3", "quote": {"zh-Hans": "我可以整理两类活动卡", "zh-Hant": "我可以整理兩類活動卡"}}], "explanation": {"en": "She proposes targeted changes to timing, pairing, and activities and offers to prepare materials.", "zh": "她提出时间、配对和活动内容上的具体调整，也说明自己能做什么。"}, "distractors": {"B": {"en": "She retains organized meetings and adds a booked group.", "zh": "她保留有组织的活动，并增加预约小组。"}, "C": {"en": "She supports initial pairing and writing down goals.", "zh": "她支持先固定搭档，也建议记录目标。"}, "D": {"en": "Some applicants have Tuesday internships.", "zh": "部分报名者周二要实习。"}}, "number": 26, "id": "ap2027-b-q26", "skill": "reading.communicative_purpose"}, {"prompt": "What does Gu propose for matching partners?", "options": {"A": "Assign a different partner randomly at every meeting.", "B": "Keep the original partner for the entire term regardless of goals.", "C": "Let only the coordinator decide changes without consulting participants.", "D": "Keep partners initially, then discuss changes based on their aims."}, "correctAnswer": "D", "evidence": [{"paragraphId": "p2", "quote": {"zh-Hans": "搭档可以先固定两次，再根据双方目标协商是否调整", "zh-Hant": "搭檔可以先固定兩次，再根據雙方目標協商是否調整"}}], "explanation": {"en": "The plan balances continuity with a chance to reconsider whether the pairing works.", "zh": "先稳定两次，再协商调整，兼顾熟悉感与目标匹配。"}, "distractors": {"A": {"en": "She explicitly rejects random changes every time.", "zh": "她明确不赞成每次随机换人。"}, "B": {"en": "She proposes a review after the first two meetings.", "zh": "她建议前两次后再看是否需要调整。"}, "C": {"en": "Both participants’ goals matter in the discussion.", "zh": "协商需要考虑双方目标。"}}, "number": 27, "id": "ap2027-b-q27", "skill": "reading.detail"}, {"prompt": "Why does Gu suggest a weekend group?", "options": {"A": "The Tuesday room is permanently unavailable.", "B": "The topic cards cannot be used in evening sessions.", "C": "Some interested applicants have commitments on Tuesdays.", "D": "The participants have requested that every meeting become longer."}, "correctAnswer": "C", "evidence": [{"paragraphId": "p2", "quote": {"zh-Hans": "有几位报名者周二要实习", "zh-Hant": "有幾位報名者週二要實習"}}], "explanation": {"en": "A weekend option makes the program accessible to people excluded by the original schedule.", "zh": "周末选项让原时间安排无法参加的人也有机会参与。"}, "distractors": {"A": {"en": "No permanent room closure is mentioned.", "zh": "没有说周二场地永久不可用。"}, "B": {"en": "The cards are not restricted by time of day.", "zh": "活动卡没有时段限制。"}, "D": {"en": "Longer sessions are not the reason given.", "zh": "给出的理由不是延长活动。"}}, "number": 28, "id": "ap2027-b-q28", "skill": "reading.inference"}, {"prompt": "How would the topic list function under Gu’s proposal?", "options": {"A": "As a required sequence that every pair must complete.", "B": "As optional support adapted to different learning goals.", "C": "As a test that ranks participants before assigning partners.", "D": "As a replacement for discussing what participants hope to practice."}, "correctAnswer": "B", "evidence": [{"paragraphId": "p3", "quote": {"zh-Hans": "话题表可以作为备用", "zh-Hant": "話題表可以作爲備用"}}], "explanation": {"en": "She wants a supporting resource rather than a uniform script that overrides individual aims.", "zh": "她把话题表当作辅助资源，不让统一流程压过个人目标。"}, "distractors": {"A": {"en": "She says there is no need to complete it in order.", "zh": "她说不必按顺序谈完。"}, "C": {"en": "There is no ranking test.", "zh": "没有排名测试。"}, "D": {"en": "She proposes explicitly recording participants’ goals.", "zh": "她明确建议记录个人目标。"}}, "number": 29, "id": "ap2027-b-q29", "skill": "reading.context_meaning"}, {"prompt": "What needs to be confirmed before Gu contacts the weekend group?", "options": {"A": "Whether every Tuesday applicant can move to weekends.", "B": "Whether a new term-long fixed pairing list has been approved.", "C": "Whether someone is responsible for opening the activity room.", "D": "Whether all daily-life cards have been translated into every language."}, "correctAnswer": "C", "evidence": [{"paragraphId": "p3", "quote": {"zh-Hans": "周末活动室是否已经有人负责开门", "zh-Hant": "週末活動室是否已經有人負責開門"}}], "explanation": {"en": "The unresolved practical step is room access, not the design of all learning materials.", "zh": "尚待确认的实际环节是开门安排，不是完成所有教材设计。"}, "distractors": {"A": {"en": "She retains Tuesday sessions rather than moving everyone.", "zh": "她保留周二活动，不是全员改时间。"}, "B": {"en": "She proposes flexible pairing rather than a final term-long list.", "zh": "她建议弹性配对，不是最终固定一学期名单。"}, "D": {"en": "No requirement for translation into every language appears.", "zh": "没有把所有语言翻译列为条件。"}}, "number": 30, "id": "ap2027-b-q30", "skill": "reading.detail"}]}, {"id": "R2", "section": "reading", "type": "article-chart", "unit": 6, "title": "More than a smaller portion", "paragraphs": [{"id": "p1", "text": {"zh-Hans": "晴川中学食堂过去只有一种饭菜分量。几位学生反映，有时吃不完，却不好意思提出少盛一点。食堂于是试行普通份和小份两种选择，价格相同，小份吃完仍可以免费添饭。工作人员希望先让学生选择，再了解剩餐变化，而不是统一把每份都缩小。", "zh-Hant": "晴川中學食堂過去只有一種飯菜分量。幾位學生反映，有時喫不完，卻不好意思提出少盛一點。食堂於是試行普通份和小份兩種選擇，價格相同，小份喫完仍可以免費添飯。工作人員希望先讓學生選擇，再瞭解剩餐變化，而不是統一把每份都縮小。"}}, {"id": "p2", "text": {"zh-Hans": "表中记录了试行前一周和试行两周的每日平均数据。“剩餐”只计算用餐后盘中未吃完的食物，不包括厨房备餐时产生的部分。第二周参加校内活动的人增加，供餐数比前一周多；各周菜单也不完全相同。", "zh-Hant": "表中記錄了試行前一週和試行兩週的每日平均數據。“剩餐”只計算用餐後盤中未喫完的食物，不包括廚房備餐時產生的部分。第二週參加校內活動的人增加，供餐數比前一週多；各周菜單也不完全相同。"}}, {"id": "p3", "text": {"zh-Hans": "试行第二周的剩餐总量比第一周上升，有人因此说方案失败了。学生观察组认为，不能忽略供餐人数的变化；与试行前相比，第二周供餐更多，剩餐仍更少。不过，这些数据还不能证明每一种菜都会同样减少浪费。小组建议继续记录，并分别询问选择小份和普通份的学生，看看添饭是否方便、分量是否合适。", "zh-Hant": "試行第二週的剩餐總量比第一週上升，有人因此說方案失敗了。學生觀察組認爲，不能忽略供餐人數的變化；與試行前相比，第二週供餐更多，剩餐仍更少。不過，這些數據還不能證明每一種菜都會同樣減少浪費。小組建議繼續記錄，並分別詢問選擇小份和普通份的學生，看看添飯是否方便、分量是否合適。"}}, {"id": "p4", "text": {"zh-Hans": "一位食堂工作人员说，如果只是把剩餐数字降下来，却让学生不敢添饭，就偏离了目的。下一轮会把添饭窗口标识做得更清楚，并保留两种分量，让“吃多少盛多少”成为可以实际选择的做法。", "zh-Hant": "一位食堂工作人員說，如果只是把剩餐數字降下來，卻讓學生不敢添飯，就偏離了目的。下一輪會把添飯窗口標識做得更清楚，並保留兩種分量，讓“喫多少盛多少”成爲可以實際選擇的做法。"}}], "questions": [{"prompt": "What distinguishes the trial from simply reducing every meal’s size?", "options": {"A": "Everyone must choose a small portion and pay to add more.", "B": "Students can choose a portion and add food without an extra charge.", "C": "The school has removed all standard portions from the menu.", "D": "Kitchen preparation waste is counted as a student’s unfinished meal."}, "correctAnswer": "B", "evidence": [{"paragraphId": "p1", "quote": {"zh-Hans": "小份吃完仍可以免费添饭", "zh-Hant": "小份喫完仍可以免費添飯"}}], "explanation": {"en": "The trial preserves a choice of size and access to additional food.", "zh": "试行保留大小份选择，也允许免费添饭。"}, "distractors": {"A": {"en": "A small portion is optional, and extra food is free.", "zh": "小份是自选，添饭免费。"}, "C": {"en": "Standard portions remain available.", "zh": "普通份仍然保留。"}, "D": {"en": "Preparation waste is explicitly excluded from this measure.", "zh": "这个指标明确排除备餐产生的部分。"}}, "number": 31, "id": "ap2027-b-q31", "skill": "reading.detail"}, {"prompt": "What does the reported “leftover food” measure include?", "options": {"A": "All waste produced by the school throughout the day.", "B": "Only unused ingredients left in the kitchen after preparation.", "C": "The weight of meals students bought but had not yet collected.", "D": "Food remaining on diners’ plates after they have eaten."}, "correctAnswer": "D", "evidence": [{"paragraphId": "p2", "quote": {"zh-Hans": "只计算用餐后盘中未吃完的食物", "zh-Hant": "只計算用餐後盤中未喫完的食物"}}], "explanation": {"en": "The definition is deliberately limited to unfinished food on plates.", "zh": "定义限于用餐后盘中未吃完的食物。"}, "distractors": {"A": {"en": "It is not a schoolwide all-day waste total.", "zh": "不是全校全天垃圾总量。"}, "B": {"en": "Kitchen preparation waste is excluded.", "zh": "厨房备餐部分不计入。"}, "C": {"en": "Uncollected purchases are not the defined measure.", "zh": "定义没有包含未领取的饭菜。"}}, "number": 32, "id": "ap2027-b-q32", "skill": "reading.definition"}, {"prompt": "Which comparison is directly supported by the table?", "options": {"A": "The second trial week served fewer meals than before the trial.", "B": "The first trial week produced the same leftovers as the baseline week.", "C": "The second trial week served more meals but left less food than the baseline week.", "D": "The two trial weeks had identical meal counts and leftover totals."}, "correctAnswer": "C", "evidence": [{"paragraphId": "chart", "quote": {"zh-Hans": "480份", "zh-Hant": "480份"}}, {"paragraphId": "chart", "quote": {"zh-Hans": "15千克", "zh-Hant": "15千克"}}, {"paragraphId": "chart", "quote": {"zh-Hans": "400份", "zh-Hant": "400份"}}, {"paragraphId": "chart", "quote": {"zh-Hans": "18千克", "zh-Hant": "18千克"}}], "explanation": {"en": "Week two records 480 meals and 15 kg, compared with 400 meals and 18 kg before the trial.", "zh": "第二周480份、15千克；试行前400份、18千克，所以供餐更多而剩餐更少。"}, "distractors": {"A": {"en": "480 is greater than 400.", "zh": "480大于400。"}, "B": {"en": "12 kg differs from 18 kg.", "zh": "12千克与18千克不同。"}, "D": {"en": "The trial weeks record different counts and totals.", "zh": "两周的份数与剩餐总量都不同。"}}, "number": 33, "id": "ap2027-b-q33", "skill": "reading.chart_comparison"}, {"prompt": "Why can these three weeks not establish the same effect for every dish?", "options": {"A": "The menus and attendance conditions were not identical across weeks.", "B": "The observers refused to count the number of meals served.", "C": "The table combines measurements taken at different schools.", "D": "The trial did not offer students any real choice of portion."}, "correctAnswer": "A", "evidence": [{"paragraphId": "p2", "quote": {"zh-Hans": "各周菜单也不完全相同", "zh-Hant": "各周菜單也不完全相同"}}], "explanation": {"en": "Changing menus and diner numbers limit what can be attributed to one rule or extended to every dish.", "zh": "菜单与人数不同，限制了归因和推广到所有菜品的结论。"}, "distractors": {"B": {"en": "Meal counts are included in the table.", "zh": "表中记录了供餐数。"}, "C": {"en": "All records concern one school.", "zh": "记录来自同一学校。"}, "D": {"en": "The trial offers two sizes.", "zh": "试行提供两种分量。"}}, "number": 34, "id": "ap2027-b-q34", "skill": "reading.evidence_limit"}, {"prompt": "What would best match the staff member’s understanding of success?", "options": {"A": "Discourage additional servings so that the waste total is always low.", "B": "Close the standard-portion line to make everyone’s plate identical.", "C": "Reward only the week with the lowest total regardless of attendance.", "D": "Make portion choices and additional servings clear and usable."}, "correctAnswer": "D", "evidence": [{"paragraphId": "p4", "quote": {"zh-Hans": "就偏离了目的", "zh-Hant": "就偏離了目的"}}], "explanation": {"en": "The goal is appropriate eating with practical choice, not a low number produced by discouraging enough food.", "zh": "目标是让分量选择可实行，而不是靠不敢添饭得到低数字。"}, "distractors": {"A": {"en": "The staff member explicitly rejects discouraging additional food.", "zh": "工作人员明确反对让学生不敢添饭。"}, "B": {"en": "Both portion sizes are retained.", "zh": "两种分量都保留。"}, "C": {"en": "Attendance and students’ experience remain relevant.", "zh": "人数和使用体验仍需考虑。"}}, "number": 35, "id": "ap2027-b-q35", "skill": "reading.inference"}], "chart": {"title": {"zh-Hans": "晴川中学食堂三周记录", "zh-Hant": "晴川中學食堂三週記錄"}, "headers": [{"zh-Hans": "时段", "zh-Hant": "時段"}, {"zh-Hans": "每日平均供餐数", "zh-Hant": "每日平均供餐數"}, {"zh-Hans": "每日平均剩餐", "zh-Hant": "每日平均剩餐"}], "rows": [[{"zh-Hans": "试行前一周", "zh-Hant": "試行前一週"}, {"zh-Hans": "400份", "zh-Hant": "400份"}, {"zh-Hans": "18千克", "zh-Hant": "18千克"}], [{"zh-Hans": "试行第一周", "zh-Hant": "試行第一週"}, {"zh-Hans": "400份", "zh-Hant": "400份"}, {"zh-Hans": "12千克", "zh-Hant": "12千克"}], [{"zh-Hans": "试行第二周", "zh-Hant": "試行第二週"}, {"zh-Hans": "480份", "zh-Hant": "480份"}, {"zh-Hans": "15千克", "zh-Hant": "15千克"}]], "note": {"zh-Hans": "本表为原创模拟数据。各周均按实际开放日计算平均值；并非对所有学校的调查。", "zh-Hant": "本表爲原創模擬數據。各周均按實際開放日計算平均值；並非對所有學校的調查。"}}}, {"id": "R3", "section": "reading", "type": "article", "unit": 4, "title": "When one missing word changes a caption", "paragraphs": [{"id": "p1", "text": {"zh-Hans": "校刊科技组第一次试用课堂自动字幕时，给出的结论很简单：一百个字只错一个，已经足够可靠。后来他们发现，字幕把老师说的“不要马上交卷”漏掉了一个“不”字，剩下的字虽然都对，学生理解的行动却完全相反。", "zh-Hant": "校刊科技組第一次試用課堂自動字幕時，給出的結論很簡單：一百個字只錯一個，已經足夠可靠。後來他們發現，字幕把老師說的“不要馬上交卷”漏掉了一個“不”字，剩下的字雖然都對，學生理解的行動卻完全相反。"}}, {"id": "p2", "text": {"zh-Hans": "小组于是改变了检查方式。除了记录错字数，他们还把人名、数字、否定词和转折关系单独标出来，看看错误是否改变主要信息。同样错一个字，姓名中的错字可能使人认错对象，普通语气词的差异却未必影响任务。一个总分不能说明所有错误的重要程度。", "zh-Hant": "小組於是改變了檢查方式。除了記錄錯字數，他們還把人名、數字、否定詞和轉折關係單獨標出來，看看錯誤是否改變主要信息。同樣錯一個字，姓名中的錯字可能使人認錯對象，普通語氣詞的差異卻未必影響任務。一個總分不能說明所有錯誤的重要程度。"}}, {"id": "p3", "text": {"zh-Hans": "有同学建议直接把字幕全部改得通顺，再公开最终版本。编辑认为，这样读起来方便，但会让后来的使用者看不见哪里曾经不确定。最后，展示页面保留原始字幕，并用另一栏列出核对后的版本，注明修改依据。遇到没有听清的地方，不为了版面完整而补写一个看似合理的词，而是回听录音、请说话者确认，或者保留“待核实”的标记。", "zh-Hant": "有同學建議直接把字幕全部改得通順，再公開最終版本。編輯認爲，這樣讀起來方便，但會讓後來的使用者看不見哪裏曾經不確定。最後，展示頁面保留原始字幕，並用另一欄列出覈對後的版本，註明修改依據。遇到沒有聽清的地方，不爲了版面完整而補寫一個看似合理的詞，而是回聽錄音、請說話者確認，或者保留“待覈實”的標記。"}}, {"id": "p4", "text": {"zh-Hans": "这次试用只涉及两堂课，课堂讨论的声音条件和正式讲台讲话也不同。小组不再用“准确率很高，所以处处都能放心用”作结，而把使用场景、检查方法和仍未解决的问题写进报告。他们认为，技术工具有价值，但负责任的使用也包括知道什么时候需要停下来核对。", "zh-Hant": "這次試用只涉及兩堂課，課堂討論的聲音條件和正式講臺講話也不同。小組不再用“準確率很高，所以處處都能放心用”作結，而把使用場景、檢查方法和仍未解決的問題寫進報告。他們認爲，技術工具有價值，但負責任的使用也包括知道什麼時候需要停下來覈對。"}}], "questions": [{"prompt": "How does the group’s evaluation of automatic captions change?", "options": {"A": "It shifts from checking meaning to judging only the elegance of sentences.", "B": "It stops considering any error once the overall accuracy seems high.", "C": "It treats every wrong character as equally important in every situation.", "D": "It begins examining how particular errors affect the intended information."}, "correctAnswer": "D", "evidence": [{"paragraphId": "p2", "quote": {"zh-Hans": "看看错误是否改变主要信息", "zh-Hant": "看看錯誤是否改變主要信息"}}], "explanation": {"en": "The group adds meaning-sensitive checks instead of relying only on an overall character count.", "zh": "小组增加了针对意义影响的检查，不再只依赖总错字数。"}, "distractors": {"A": {"en": "Meaning becomes more important, not less.", "zh": "意义反而变得更重要。"}, "B": {"en": "A high total accuracy no longer ends the evaluation.", "zh": "总准确率高不再意味着停止检查。"}, "C": {"en": "They explicitly distinguish the importance of different errors.", "zh": "他们明确区分不同错误的重要程度。"}}, "number": 36, "id": "ap2027-b-q36", "skill": "reading.main_idea"}, {"prompt": "What does the missing “不” in the opening example demonstrate?", "options": {"A": "A subtitle can be useful only if every speaker uses exactly one sentence.", "B": "A single omission can reverse the action a listener is asked to take.", "C": "Negation words have no effect on the practical meaning of instructions.", "D": "Counting correct characters always identifies the most serious misunderstanding."}, "correctAnswer": "B", "evidence": [{"paragraphId": "p1", "quote": {"zh-Hans": "学生理解的行动却完全相反", "zh-Hant": "學生理解的行動卻完全相反"}}], "explanation": {"en": "Most characters remain correct, yet dropping the negation reverses what students think they should do.", "zh": "多数文字都正确，但少一个否定词就改变了行动要求。"}, "distractors": {"A": {"en": "The example does not require one-sentence speech.", "zh": "例子没有提出只能说一句话。"}, "C": {"en": "The example shows the opposite: negation changes meaning.", "zh": "例子恰好说明否定词会改变意思。"}, "D": {"en": "A character total alone failed to reveal the issue.", "zh": "只看字符总数并没有揭示严重程度。"}}, "number": 37, "id": "ap2027-b-q37", "skill": "reading.inference", "promptByScript": {"zh-Hans": "What does the missing “不” in the opening example demonstrate?", "zh-Hant": "What does the missing “不” in the opening example demonstrate?"}}, {"prompt": "Why does the final page keep an original caption column alongside corrections?", "options": {"A": "So readers can trace uncertainty and the basis of revisions.", "B": "So the group can avoid explaining why any change was made.", "C": "So every original error will be treated as the speaker’s intended meaning.", "D": "So a fluent final sentence can replace evidence from the recording."}, "correctAnswer": "A", "evidence": [{"paragraphId": "p3", "quote": {"zh-Hans": "注明修改依据", "zh-Hant": "註明修改依據"}}], "explanation": {"en": "The parallel versions make the editing process visible and reviewable.", "zh": "并列版本让修改过程和依据可见，方便复核。"}, "distractors": {"B": {"en": "Explaining changes is part of the adopted method.", "zh": "说明修改依据正是采用的做法。"}, "C": {"en": "Corrections distinguish errors from verified speech.", "zh": "核对版本正是为了区分错误与已确认内容。"}, "D": {"en": "The recording remains a source for verification.", "zh": "录音仍是核查依据。"}}, "number": 38, "id": "ap2027-b-q38", "skill": "reading.communicative_purpose"}, {"prompt": "If a word cannot be heard clearly, which action follows the group’s approach?", "options": {"A": "Insert the most fluent guess and remove all signs of doubt.", "B": "Copy a likely word from an unrelated class’s transcript.", "C": "Seek confirmation or leave the uncertainty explicitly marked.", "D": "Assume the word is unimportant because only one character is missing."}, "correctAnswer": "C", "evidence": [{"paragraphId": "p3", "quote": {"zh-Hans": "保留“待核实”的标记", "zh-Hant": "保留“待覈實”的標記"}}], "explanation": {"en": "The article accepts unresolved uncertainty rather than filling a gap without evidence.", "zh": "文章允许保留不确定，而不是无依据地填满空缺。"}, "distractors": {"A": {"en": "Plausibility is not a substitute for confirmation.", "zh": "看起来合理不能代替确认。"}, "B": {"en": "Another class is not evidence for this utterance.", "zh": "别的课堂不能证明这句话的内容。"}, "D": {"en": "One character can change crucial information.", "zh": "一个字也可能改变关键信息。"}}, "number": 39, "id": "ap2027-b-q39", "skill": "reading.application"}, {"prompt": "Which statement would be most appropriate in the group’s final report?", "options": {"A": "The two-class trial proves the same performance in every speaking environment.", "B": "A polished final transcript makes the original conditions irrelevant.", "C": "High overall accuracy eliminates the need to identify remaining problems.", "D": "The observed performance should be interpreted with its setting and checks described."}, "correctAnswer": "D", "evidence": [{"paragraphId": "p4", "quote": {"zh-Hans": "使用场景、检查方法和仍未解决的问题写进报告", "zh-Hant": "使用場景、檢查方法和仍未解決的問題寫進報告"}}], "explanation": {"en": "The report must show the scope and process behind its conclusions rather than universalize a small trial.", "zh": "报告应交代结论的范围和过程，不把小规模试用推广为普遍保证。"}, "distractors": {"A": {"en": "The article explicitly limits the trial to two classes.", "zh": "文章明确说明只涉及两堂课。"}, "B": {"en": "Sound conditions matter to interpretation.", "zh": "声音条件会影响判断。"}, "C": {"en": "Remaining problems are included, not eliminated.", "zh": "未解决问题需要列明。"}}, "number": 40, "id": "ap2027-b-q40", "skill": "reading.evaluation"}]}, {"id": "R4", "section": "reading", "type": "literary-text", "unit": 3, "title": "A guide’s blank page", "paragraphs": [{"id": "p1", "text": {"zh-Hans": "第一次在学生画展做讲解，我把每幅画的介绍背得很熟，连停顿都写在纸上。我最怕有人突然提问，因为一旦离开准备好的句子，就不知道该说什么。开场前，老师只对我说：“别急着把所有空白填满。”我以为她嫌我写得太多。", "zh-Hant": "第一次在學生畫展做講解，我把每幅畫的介紹背得很熟，連停頓都寫在紙上。我最怕有人突然提問，因爲一旦離開準備好的句子，就不知道該說什麼。開場前，老師只對我說：“別急着把所有空白填滿。”我以爲她嫌我寫得太多。"}}, {"id": "p2", "text": {"zh-Hans": "讲到一幅画着半开门的作品时，一个孩子问：“门后面的人为什么不出来？”我的纸上只有作者、尺寸和创作年份，没有这个问题的答案。我差点随口编一个故事，看到孩子认真等着，又停住了。我说：“我没有问过画这幅画的人，不能替他回答。你觉得门后面会是什么？”", "zh-Hant": "講到一幅畫着半開門的作品時，一個孩子問：“門後面的人爲什麼不出來？”我的紙上只有作者、尺寸和創作年份，沒有這個問題的答案。我差點隨口編一個故事，看到孩子認真等着，又停住了。我說：“我沒有問過畫這幅畫的人，不能替他回答。你覺得門後面會是什麼？”"}}, {"id": "p3", "text": {"zh-Hans": "孩子说，也许有人正在等朋友。旁边一位阿姨却想到，门半开着，可能是一个人想出去又犹豫。大家开始指着画里的光线讨论，原来安静跟着走的观众也凑近了一些。我把讲解纸翻到背面，在空白处记下他们的话，忽然不再急着接回原来的段落。", "zh-Hant": "孩子說，也許有人正在等朋友。旁邊一位阿姨卻想到，門半開着，可能是一個人想出去又猶豫。大家開始指着畫裏的光線討論，原來安靜跟着走的觀衆也湊近了一些。我把講解紙翻到背面，在空白處記下他們的話，忽然不再急着接回原來的段落。"}}, {"id": "p4", "text": {"zh-Hans": "结束后，我仍然把作品资料查得很仔细，却在每段介绍旁留出一块空白。那不是忘记准备，而是提醒自己：有些事实需要准确说明，有些问题可以一起想。下一次讲解前，我的纸比以前空了，心里反而没有那么慌。", "zh-Hant": "結束後，我仍然把作品資料查得很仔細，卻在每段介紹旁留出一塊空白。那不是忘記準備，而是提醒自己：有些事實需要準確說明，有些問題可以一起想。下一次講解前，我的紙比以前空了，心裏反而沒有那麼慌。"}}], "questions": [{"prompt": "What makes the narrator anxious at the beginning?", "options": {"A": "The exhibition has no labels identifying any of the artists.", "B": "The teacher has forbidden the use of notes during the tour.", "C": "An unexpected question might take the narrator beyond the rehearsed script.", "D": "Visitors have been told that every guide must invent a story for each painting."}, "correctAnswer": "C", "evidence": [{"paragraphId": "p1", "quote": {"zh-Hans": "一旦离开准备好的句子，就不知道该说什么", "zh-Hant": "一旦離開準備好的句子，就不知道該說什麼"}}], "explanation": {"en": "The fear concerns losing the security of a prepared script, not missing exhibition information.", "zh": "焦虑来自离开预先准备的句子，而不是展览没有资料。"}, "distractors": {"A": {"en": "The narrator has researched identifying information.", "zh": "叙述者已经准备了作品资料。"}, "B": {"en": "Notes are still used throughout the account.", "zh": "叙述者始终在使用纸上的笔记。"}, "D": {"en": "Inventing a story is a temptation the narrator resists, not a tour rule.", "zh": "编故事是叙述者克制的冲动，不是参观规则。"}}, "number": 41, "id": "ap2027-b-q41", "skill": "reading.character_motivation"}, {"prompt": "Why is the narrator’s reply to the child a turning point?", "options": {"A": "It acknowledges a limit of knowledge and opens a shared discussion.", "B": "It establishes that the child’s interpretation is the painter’s confirmed intention.", "C": "It shows that dates and dimensions can answer every question about art.", "D": "It prevents the other visitors from expressing a different view."}, "correctAnswer": "A", "evidence": [{"paragraphId": "p2", "quote": {"zh-Hans": "不能替他回答", "zh-Hant": "不能替他回答"}}], "explanation": {"en": "Instead of inventing the artist’s intention, the narrator acknowledges uncertainty and invites interpretation.", "zh": "叙述者没有编造作者意图，而是承认未知，再邀请讨论。"}, "distractors": {"B": {"en": "The artist’s intention is not confirmed.", "zh": "没有确认作者原意。"}, "C": {"en": "The prepared facts did not answer this question.", "zh": "已准备的事实恰好回答不了这个问题。"}, "D": {"en": "Other visitors begin offering different views.", "zh": "其他观众随后表达了不同看法。"}}, "number": 42, "id": "ap2027-b-q42", "skill": "reading.narrative_turn"}, {"prompt": "What does writing on the back of the paper reveal about the narrator?", "options": {"A": "The narrator has decided that the original factual research was worthless.", "B": "The narrator wants to replace all visitor comments with a single official answer.", "C": "The narrator is trying to hide the painting from further questions.", "D": "The narrator is beginning to treat visitors’ contributions as part of the experience."}, "correctAnswer": "D", "evidence": [{"paragraphId": "p3", "quote": {"zh-Hans": "在空白处记下他们的话", "zh-Hant": "在空白處記下他們的話"}}], "explanation": {"en": "Recording their ideas shows a shift from delivering a monologue to attending to the audience’s responses.", "zh": "记下观众的话，表现出从单向讲述转向重视观众参与。"}, "distractors": {"A": {"en": "The ending says factual checking continues.", "zh": "结尾说明仍认真查资料。"}, "B": {"en": "Different ideas are recorded rather than reduced to one official answer.", "zh": "不同意见被记录，没有统一成官方答案。"}, "C": {"en": "The discussion continues around the painting.", "zh": "大家仍围绕画作讨论。"}}, "number": 43, "id": "ap2027-b-q43", "skill": "reading.inference"}, {"prompt": "How does the final paragraph reinterpret the blank spaces in the notes?", "options": {"A": "As proof that preparation is unnecessary for any guide.", "B": "As deliberate room for inquiry alongside accurate information.", "C": "As a method for making visitors finish the guide’s homework.", "D": "As evidence that factual descriptions should be replaced by guesses."}, "correctAnswer": "B", "evidence": [{"paragraphId": "p4", "quote": {"zh-Hans": "有些事实需要准确说明，有些问题可以一起想", "zh-Hant": "有些事實需要準確說明，有些問題可以一起想"}}], "explanation": {"en": "Blank space becomes a reminder to distinguish verified information from questions open to discussion.", "zh": "空白提醒叙述者区分已核实的信息与可以共同思考的问题。"}, "distractors": {"A": {"en": "The narrator still prepares carefully.", "zh": "叙述者仍认真准备。"}, "C": {"en": "Visitors are not assigned homework.", "zh": "没有让观众替讲解员做作业。"}, "D": {"en": "The narrator specifically avoids unsupported guesses.", "zh": "叙述者恰好避免了无依据猜测。"}}, "number": 44, "id": "ap2027-b-q44", "skill": "reading.symbolic_meaning"}, {"prompt": "What relationship between a guide and an audience does the story favor?", "options": {"A": "The audience should remain silent whenever a guide has prepared enough material.", "B": "The guide should agree that all interpretations are established historical facts.", "C": "Accurate guidance can coexist with listening and open-ended participation.", "D": "A guide should answer every question immediately even without evidence."}, "correctAnswer": "C", "evidence": [{"paragraphId": "p4", "quote": {"zh-Hans": "那不是忘记准备", "zh-Hant": "那不是忘記準備"}}], "explanation": {"en": "The story combines reliable factual preparation with a willingness to listen and think with others.", "zh": "故事把可靠准备与愿意倾听、共同思考结合起来。"}, "distractors": {"A": {"en": "The shared discussion is presented positively.", "zh": "共同讨论被积极呈现。"}, "B": {"en": "Interpretations are not turned into verified facts.", "zh": "解释没有被当成已核实事实。"}, "D": {"en": "The narrator’s restraint is a positive turning point.", "zh": "不急于无依据回答是积极转折。"}}, "number": 45, "id": "ap2027-b-q45", "skill": "reading.main_idea"}]}, {"id": "R5", "section": "reading", "type": "promotional-material", "unit": 5, "title": "A walking route with room for everyone", "paragraphs": [{"id": "p1", "text": {"zh-Hans": "城市慢行工作室｜街角发现计划\n周日上午九点至十一点，从青石广场出发。我们不比谁走得快，而是一起观察日常经过却没有留意的地方。路线约两公里，中途有两处可休息的地点；如果不想走完全程，可在第一处休息点结束。名额十五人，活动免费，但请提前登记，以便准备材料。", "zh-Hant": "城市慢行工作室｜街角發現計劃\n週日上午九點至十一點，從青石廣場出發。我們不比誰走得快，而是一起觀察日常經過卻沒有留意的地方。路線約兩公里，中途有兩處可休息的地點；如果不想走完全程，可在第一處休息點結束。名額十五人，活動免費，但請提前登記，以便準備材料。"}}, {"id": "p2", "text": {"zh-Hans": "带一支笔和愿意观察的心即可，不需要专业相机。工作室会提供简图；愿意的话，也可以画画、写关键词或录一段自己的口头笔记。我们不要求把每个站点都拍下来，更不以照片数量评选“最佳参与者”。", "zh-Hant": "帶一支筆和願意觀察的心即可，不需要專業相機。工作室會提供簡圖；願意的話，也可以畫畫、寫關鍵詞或錄一段自己的口頭筆記。我們不要求把每個站點都拍下來，更不以照片數量評選“最佳參與者”。"}}, {"id": "p3", "text": {"zh-Hans": "报名时可以说明是否需要大字号路线图。路线信息会提前两天发给大家，其中注明坡道、台阶和休息点。请根据自己的需要判断是否适合；如果某一段不方便通过，联系组织者商量替代路段，不必为了跟上队伍勉强完成。", "zh-Hant": "報名時可以說明是否需要大字號路線圖。路線信息會提前兩天發給大家，其中註明坡道、臺階和休息點。請根據自己的需要判斷是否適合；如果某一段不方便通過，聯繫組織者商量替代路段，不必爲了跟上隊伍勉強完成。"}}, {"id": "p4", "text": {"zh-Hans": "若预报有较强降雨，工作室会在前一天晚上六点前通知是否改期；没有收到变更通知时，按原计划集合。活动后，参与者可自愿提交一段不超过一百字的观察，用于小册子。未经本人确认，我们不会把你的笔记和姓名一起公开。", "zh-Hant": "若預報有較強降雨，工作室會在前一天晚上六點前通知是否改期；沒有收到變更通知時，按原計劃集合。活動後，參與者可自願提交一段不超過一百字的觀察，用於小冊子。未經本人確認，我們不會把你的筆記和姓名一起公開。"}}], "questions": [{"prompt": "What would most closely match the purpose of this walk?", "options": {"A": "Finish all stops before anyone else in the group.", "B": "Collect more photographs than the other participants.", "C": "Notice details in familiar surroundings without competing over speed.", "D": "Use a professional camera to document every point on the route."}, "correctAnswer": "C", "evidence": [{"paragraphId": "p1", "quote": {"zh-Hans": "一起观察日常经过却没有留意的地方", "zh-Hant": "一起觀察日常經過卻沒有留意的地方"}}], "explanation": {"en": "The activity prioritizes attentive observation over speed or equipment.", "zh": "活动关注日常环境中的细节，不以速度或器材作为重点。"}, "distractors": {"A": {"en": "The notice explicitly rejects a speed contest.", "zh": "通知明确不比速度。"}, "B": {"en": "Photo totals are not used to rank participants.", "zh": "不按照片数量排名。"}, "D": {"en": "Professional equipment and photographing every stop are unnecessary.", "zh": "不要求专业器材或拍完每个站点。"}}, "number": 46, "id": "ap2027-b-q46", "skill": "reading.main_purpose"}, {"prompt": "A participant expects difficulty with a section containing steps. What does the notice suggest?", "options": {"A": "Discuss an alternative segment with the organizers.", "B": "Complete the entire route anyway to avoid delaying the group.", "C": "Wait until after the event to request any route information.", "D": "Withdraw automatically without considering other options."}, "correctAnswer": "A", "evidence": [{"paragraphId": "p3", "quote": {"zh-Hans": "联系组织者商量替代路段", "zh-Hant": "聯繫組織者商量替代路段"}}], "explanation": {"en": "Advance information and discussion support an appropriate alternative rather than forced completion.", "zh": "提前了解路线并协商替代段落，比勉强完成更符合安排。"}, "distractors": {"B": {"en": "Participants are explicitly told not to force completion.", "zh": "原文明确不必勉强完成。"}, "C": {"en": "Route details are provided before the event.", "zh": "路线资料在活动前发放。"}, "D": {"en": "Alternatives can be discussed; automatic withdrawal is not required.", "zh": "可以协商，并非自动退出。"}}, "number": 47, "id": "ap2027-b-q47", "skill": "reading.instruction_application"}, {"prompt": "Why is advance registration requested for a free event?", "options": {"A": "To charge a camera rental fee before departure.", "B": "To rank applicants according to how fast they can walk.", "C": "To guarantee that every person will complete the full route.", "D": "To let the organizers prepare the needed materials."}, "correctAnswer": "D", "evidence": [{"paragraphId": "p1", "quote": {"zh-Hans": "以便准备材料", "zh-Hant": "以便準備材料"}}], "explanation": {"en": "Registration supports preparation even though participation carries no fee.", "zh": "免费参加仍需登记，是为了准备材料。"}, "distractors": {"A": {"en": "No camera rental is offered or required.", "zh": "没有相机租赁收费。"}, "B": {"en": "Speed is not a selection criterion.", "zh": "速度不是报名排名标准。"}, "C": {"en": "Completing the full route is explicitly optional.", "zh": "走完全程明确是可选的。"}}, "number": 48, "id": "ap2027-b-q48", "skill": "reading.requirement_detail"}, {"prompt": "What should participants do if they receive no rescheduling notice?", "options": {"A": "Assume any mention of rain automatically cancels the event.", "B": "Meet according to the original plan.", "C": "Choose a new date independently and inform the group afterward.", "D": "Send in their observation notes instead of attending."}, "correctAnswer": "B", "evidence": [{"paragraphId": "p4", "quote": {"zh-Hans": "按原计划集合", "zh-Hant": "按原計劃集合"}}], "explanation": {"en": "The notice sets an explicit default: follow the original plan unless a change is announced.", "zh": "通知明确了默认安排：没有变更通知就按原计划集合。"}, "distractors": {"A": {"en": "A forecast does not itself constitute a cancellation notice.", "zh": "天气预报本身不等于取消通知。"}, "C": {"en": "Participants do not individually set the event date.", "zh": "参与者不能各自决定活动日期。"}, "D": {"en": "Submitting a note is optional and follows the activity.", "zh": "观察投稿在活动后自愿进行。"}}, "number": 49, "id": "ap2027-b-q49", "skill": "reading.conditional_instruction"}, {"prompt": "Which publication practice is promised for the booklet?", "options": {"A": "All registration details will automatically be printed with each note.", "B": "Only people who use full names may participate in the walk.", "C": "Publishing a note together with its author’s name requires confirmation.", "D": "Every participant must contribute exactly one hundred words."}, "correctAnswer": "C", "evidence": [{"paragraphId": "p4", "quote": {"zh-Hans": "未经本人确认", "zh-Hant": "未經本人確認"}}], "explanation": {"en": "Participation does not automatically authorize publication of a named contribution.", "zh": "参加活动不等于自动同意公开署名笔记。"}, "distractors": {"A": {"en": "Registration details are not promised for publication.", "zh": "没有承诺公开报名信息。"}, "B": {"en": "The notice does not make full-name publication a condition of walking.", "zh": "公开全名不是参加条件。"}, "D": {"en": "Submission is voluntary and has a maximum, not an exact length.", "zh": "投稿自愿，字数是上限，不是精确要求。"}}, "number": 50, "id": "ap2027-b-q50", "skill": "reading.publication_scope"}]}, {"id": "R6", "section": "reading", "type": "correspondence", "unit": 1, "title": "A handover that leaves room to learn", "paragraphs": [{"id": "p1", "text": {"zh-Hans": "留言一｜社区工具室管理员赵叔\n小宋，下周我外出三天，工具室想请你和两位新志愿者代管。开门时间照旧。借用记录里要写工具名称、借出时间和预计归还日；归还时先核对数量，再放回对应格子。遇到自己不能确认的问题，请记下来联系我，不要凭印象答应。桌上有一本旧记录册，你们可以参考。", "zh-Hant": "留言一｜社區工具室管理員趙叔\n小宋，下週我外出三天，工具室想請你和兩位新志願者代管。開門時間照舊。借用記錄裏要寫工具名稱、借出時間和預計歸還日；歸還時先覈對數量，再放回對應格子。遇到自己不能確認的問題，請記下來聯繫我，不要憑印象答應。桌上有一本舊記錄冊，你們可以參考。"}}, {"id": "p2", "text": {"zh-Hans": "留言二｜小宋回复\n赵叔，安排收到了。我们看了旧册，发现有些工具写的是简称，新同学分不清“长夹”和“短夹”各放哪里。我想在格子旁加一张名称与照片对照表，再把借用登记的三项要求印在桌面卡片上，这样不用每次都来问您。", "zh-Hant": "留言二｜小宋回覆\n趙叔，安排收到了。我們看了舊冊，發現有些工具寫的是簡稱，新同學分不清“長夾”和“短夾”各放哪裏。我想在格子旁加一張名稱與照片對照表，再把借用登記的三項要求印在桌面卡片上，這樣不用每次都來問您。"}}, {"id": "p3", "text": {"zh-Hans": "不过，旧册上有一件工具已超过原定归还日，旁边只有“等回信”三个字。我们不知道是否已经协商延期，所以先不自行认定借用者违约。我会联系您核实之前的沟通。明天开门前，我们三人想一起走一遍借出和归还流程，请问您是否方便留十分钟带我们练习？如果来不及，我们可以先演练，把不确定的地方集中发给您。", "zh-Hant": "不過，舊冊上有一件工具已超過原定歸還日，旁邊只有“等回信”三個字。我們不知道是否已經協商延期，所以先不自行認定借用者違約。我會聯繫您覈實之前的溝通。明天開門前，我們三人想一起走一遍借出和歸還流程，請問您是否方便留十分鐘帶我們練習？如果來不及，我們可以先演練，把不確定的地方集中發給您。"}}], "questions": [{"prompt": "Which responsibility remains unchanged while Zhao is away?", "options": {"A": "Volunteers may open the room whenever someone requests it.", "B": "The room continues to follow its usual opening hours.", "C": "All borrowed tools must be returned on the day they are borrowed.", "D": "Only the senior volunteer is allowed to record a loan."}, "correctAnswer": "B", "evidence": [{"paragraphId": "p1", "quote": {"zh-Hans": "开门时间照旧", "zh-Hant": "開門時間照舊"}}], "explanation": {"en": "The message explicitly preserves the established opening schedule.", "zh": "留言明确保留原来的开门时间。"}, "distractors": {"A": {"en": "No on-demand opening arrangement is introduced.", "zh": "没有按需要随时开门的新安排。"}, "C": {"en": "An expected return date is recorded; same-day return is not required.", "zh": "需要登记预计归还日，并未要求当天归还。"}, "D": {"en": "The task is delegated to the group, with no exclusive recorder specified.", "zh": "任务交给小组，没有限定谁独自登记。"}}, "number": 51, "id": "ap2027-b-q51", "skill": "reading.detail"}, {"prompt": "What practical problem would Song’s proposed photo chart address?", "options": {"A": "The tool room has no available storage spaces.", "B": "The current borrowing rules require too many return dates.", "C": "Experienced volunteers are prohibited from naming tools.", "D": "Abbreviated names are unclear to volunteers unfamiliar with the tools."}, "correctAnswer": "D", "evidence": [{"paragraphId": "p2", "quote": {"zh-Hans": "新同学分不清", "zh-Hant": "新同學分不清"}}], "explanation": {"en": "A name-and-photo reference connects unfamiliar shorthand to the correct object and location.", "zh": "名称照片对照可帮助新手把简称与具体工具、位置联系起来。"}, "distractors": {"A": {"en": "The issue is identification, not a shortage of space.", "zh": "问题在辨认，不是格子不够。"}, "B": {"en": "The proposal does not change the return-date requirement.", "zh": "建议没有改变归还日要求。"}, "C": {"en": "No ban on naming tools is mentioned.", "zh": "没有禁止老志愿者说工具名称。"}}, "number": 52, "id": "ap2027-b-q52", "skill": "reading.problem_solution"}, {"prompt": "Why does Song avoid immediately declaring the overdue borrower at fault?", "options": {"A": "The note may reflect an extension or communication not yet understood.", "B": "The tool’s name does not appear anywhere in the old records.", "C": "Volunteers have been told to disregard all expected return dates.", "D": "The borrower has already confirmed that the tool was returned."}, "correctAnswer": "A", "evidence": [{"paragraphId": "p3", "quote": {"zh-Hans": "不知道是否已经协商延期", "zh-Hant": "不知道是否已經協商延期"}}], "explanation": {"en": "The available note is incomplete, so the status should be verified before drawing a judgment.", "zh": "现有备注不完整，应先核实是否有延期沟通，再作判断。"}, "distractors": {"B": {"en": "The text does not say the tool is unnamed.", "zh": "原文没有说工具未写名称。"}, "C": {"en": "Expected return dates remain part of the procedure.", "zh": "预计归还日仍需记录。"}, "D": {"en": "A confirmed return is not reported.", "zh": "没有报告已经确认归还。"}}, "number": 53, "id": "ap2027-b-q53", "skill": "reading.inference"}, {"prompt": "What does the request for a short joint rehearsal suggest about the volunteers?", "options": {"A": "They intend to replace every rule with an informal agreement.", "B": "They believe written instructions make practice unnecessary.", "C": "They want to test the process and identify gaps before managing it alone.", "D": "They will refuse the task unless Zhao remains for all three days."}, "correctAnswer": "C", "evidence": [{"paragraphId": "p3", "quote": {"zh-Hans": "一起走一遍借出和归还流程", "zh-Hant": "一起走一遍借出和歸還流程"}}], "explanation": {"en": "A rehearsal turns written instructions into an opportunity to clarify uncertainties before the handover.", "zh": "演练能把书面说明变成实际操作，提前找出不确定之处。"}, "distractors": {"A": {"en": "The proposed cards reinforce the existing requirements.", "zh": "卡片是在强化现有要求。"}, "B": {"en": "They explicitly request practice.", "zh": "他们明确提出演练。"}, "D": {"en": "They offer an alternative if Zhao cannot attend.", "zh": "赵叔若没时间，他们也提供替代办法。"}}, "number": 54, "id": "ap2027-b-q54", "skill": "reading.communicative_intent"}, {"prompt": "How do the two messages together portray a useful handover?", "options": {"A": "It depends on memorizing abbreviations without asking questions.", "B": "It requires new volunteers to make uncertain judgments immediately.", "C": "It is complete as soon as the old notebook is placed on the desk.", "D": "It combines clear procedures, accessible references, practice, and a way to verify uncertainty."}, "correctAnswer": "D", "evidence": [{"paragraphId": "p3", "quote": {"zh-Hans": "把不确定的地方集中发给您", "zh-Hant": "把不確定的地方集中發給您"}}], "explanation": {"en": "The exchange connects instructions with reference aids, rehearsal, and escalation of unresolved questions.", "zh": "两段交流把流程、辅助资料、演练与不确定问题的核实结合起来。"}, "distractors": {"A": {"en": "The newcomers need clearer references, not blind memorization.", "zh": "新手需要更清晰的资料，不是死记简称。"}, "B": {"en": "They are told to check matters they cannot confirm.", "zh": "不确定事项应核实。"}, "C": {"en": "The follow-up reveals gaps that the notebook alone does not resolve.", "zh": "回复显示旧册本身还不能解决所有问题。"}}, "number": 55, "id": "ap2027-b-q55", "skill": "reading.synthesis"}]}], "project": {"status": "independent_music_practice_not_official_2027_project_packet", "title": "How music is learned and passed on", "instructionsEn": "Before speaking, investigate how a musical tradition in a Chinese-speaking community is learned or passed to new participants. Consult at least two identifiable sources. Connect a specific learning practice with a cultural perspective, and distinguish documented information from your interpretation. The source leads below support independent research; they are not an official course-project packet.", "instructionsZh": {"zh-Hans": "口语开始前，请研究一种华语文化情境中的音乐传统怎样被学习或传给新参与者。使用至少两份可辨认来源，把具体学习实践与文化观念联系起来，并区分资料记载和自己的解释。下面的来源是自主研究起点，不是官方年度项目材料包。", "zh-Hant": "口語開始前，請研究一種華語文化情境中的音樂傳統怎樣被學習或傳給新參與者。使用至少兩份可辨認來源，把具體學習實踐與文化觀念聯繫起來，並區分資料記載和自己的解釋。下面的來源是自主研究起點，不是官方年度項目材料包。"}, "sources": [{"id": "U-DONG", "title": "UNESCO: Grand song of the Dong ethnic group", "url": "https://ich.unesco.org/en/RL/00202", "verifiedOn": "2026-11-09", "starter": {"zh-Hans": "UNESCO 的侗族大歌条目介绍了没有乐器伴奏或指挥的多声部歌唱，也说明歌师向合唱群体中的学习者传授歌曲。可继续研究：演出时不设指挥，与学习时接受指导有什么不同？共同聆听、记忆和配合可能怎样参与传承？后一个问题是研究方向，不是对所有参与者感受的既定结论。", "zh-Hant": "UNESCO 的侗族大歌條目介紹了沒有樂器伴奏或指揮的多聲部歌唱，也說明歌師向合唱羣體中的學習者傳授歌曲。可繼續研究：演出時不設指揮，與學習時接受指導有什麼不同？共同聆聽、記憶和配合可能怎樣參與傳承？後一個問題是研究方向，不是對所有參與者感受的既定結論。"}}, {"id": "U-XIAN", "title": "UNESCO: Xi’an wind and percussion ensemble", "url": "https://ich.unesco.org/en/RL/xi-an-wind-and-percussion-ensemble-00212", "verifiedOn": "2026-11-09", "starter": {"zh-Hans": "UNESCO 的西安鼓乐条目介绍了鼓与管乐器结合的音乐形式，提到师徒传承，也提到保存并使用的手写曲谱。可继续研究：曲谱、示范和群体练习各能帮助新手理解什么？不要仅凭一种记录方式，就判断所有学习者的能力或所有当代团体的教学做法。", "zh-Hant": "UNESCO 的西安鼓樂條目介紹了鼓與管樂器結合的音樂形式，提到師徒傳承，也提到保存並使用的手寫曲譜。可繼續研究：曲譜、示範和羣體練習各能幫助新手理解什麼？不要僅憑一種記錄方式，就判斷所有學習者的能力或所有當代團體的教學做法。"}}], "noteFields": ["Learning practice and participants", "Evidence from two sources", "Practice / perspective relationship", "A comparison", "A limit in the available evidence"], "officialPacketExpected": "January 2027", "officialPprCharacterLimit": null, "sourceScope": "Original research questions and concise fact-based starting points. No UNESCO recordings or images copied; source pages checked through their indexed official text where the direct page required human verification."}, "freeResponse": [{"id": "S1", "number": 1, "type": "project-presentation", "title": "Project presentation", "preparationSeconds": 180, "responseSeconds": 180, "promptEn": "Present your research on how a musical tradition in a Chinese-speaking community is learned or passed on. Explain a specific learning practice and its relationship to a cultural perspective. Use identifiable evidence, include a comparison or reflection, and discuss one limit of what your sources establish. Speak in Chinese.", "prompt": {"zh-Hans": "请介绍你研究的一种华语文化情境中的音乐传统怎样被学习或传承。说明一种具体学习实践及其与文化观念的关系，结合可辨认的资料证据，作适当比较或反思，并指出来源所能说明的问题有哪些局限。请用中文作答。", "zh-Hant": "請介紹你研究的一種華語文化情境中的音樂傳統怎樣被學習或傳承。說明一種具體學習實踐及其與文化觀念的關係，結合可辨認的資料證據，作適當比較或反思，並指出來源所能說明的問題有哪些侷限。請用中文作答。"}, "reference": {"zh-Hans": "我的研究问题是，学习一种音乐传统，除了记住旋律，还需要学会什么。我查阅了联合国教科文组织关于侗族大歌和西安鼓乐的介绍。侗族大歌是没有乐器伴奏或指挥的多声部歌唱，但资料也说，歌曲由歌师传授给学习者。因此，演出时没有指挥，并不等于学习过程中没有指导。\n西安鼓乐的介绍则提到鼓与管乐器、师徒传承，以及保存并使用的手写曲谱。这让我想到，曲谱可以记录某些内容，示范和共同练习又可能帮助人理解怎样与别人配合。不同方式未必互相排斥。这里关于各方式作用的说明，是我根据资料提出的理解，还需要更多具体教学记录支持。\n我熟悉的学校音乐课有时先让学生独自练熟，再合起来演奏。把这种经验与资料比较，我开始注意到，个人学会自己的部分，不一定就掌握了群体中的聆听和回应。传承也可能包括怎样参加一个群体、怎样理解活动场合，而不只是保存一首曲子的音符。\n如果向初学者介绍这些音乐，我会请有经验的参与者示范一个短片段，再解释学习和演出时各自怎样配合。短视频能呈现声音，却不一定显示长期练习的过程。我的两份资料也不是对所有当代团体的调查，下一步我想补充教师和学习者的访谈，检验自己的推测。", "zh-Hant": "我的研究問題是，學習一種音樂傳統，除了記住旋律，還需要學會什麼。我查閱了聯合國教科文組織關於侗族大歌和西安鼓樂的介紹。侗族大歌是沒有樂器伴奏或指揮的多聲部歌唱，但資料也說，歌曲由歌師傳授給學習者。因此，演出時沒有指揮，並不等於學習過程中沒有指導。\n西安鼓樂的介紹則提到鼓與管樂器、師徒傳承，以及保存並使用的手寫曲譜。這讓我想到，曲譜可以記錄某些內容，示範和共同練習又可能幫助人理解怎樣與別人配合。不同方式未必互相排斥。這裏關於各方式作用的說明，是我根據資料提出的理解，還需要更多具體教學記錄支持。\n我熟悉的學校音樂課有時先讓學生獨自練熟，再合起來演奏。把這種經驗與資料比較，我開始注意到，個人學會自己的部分，不一定就掌握了羣體中的聆聽和回應。傳承也可能包括怎樣參加一個羣體、怎樣理解活動場合，而不只是保存一首曲子的音符。\n如果向初學者介紹這些音樂，我會請有經驗的參與者示範一個短片段，再解釋學習和演出時各自怎樣配合。短視頻能呈現聲音，卻不一定顯示長期練習的過程。我的兩份資料也不是對所有當代團體的調查，下一步我想補充教師和學習者的訪談，檢驗自己的推測。"}, "referenceNote": "An illustrative research-based response, not a required script or an official project submission. It is not a calibrated three-minute recording.", "checklist": ["Identify a specific musical tradition and learning practice.", "Connect a product/practice with a perspective using sources rather than stereotypes.", "Distinguish a documented statement from an interpretation; include a comparison.", "Organize a comprehensible Chinese presentation and acknowledge evidence limits."], "rubric": {"maxPoints": 11, "rows": [{"id": "task", "nameZh": "任务完成", "maxPoints": 2}, {"id": "culture", "nameZh": "文化理解", "maxPoints": 2}, {"id": "organization", "nameZh": "组织", "maxPoints": 2}, {"id": "language", "nameZh": "语言控制", "maxPoints": 3}, {"id": "delivery", "nameZh": "表达呈现", "maxPoints": 2}], "printedPages": [131, 132, 133, 134, 135]}}, {"id": "S2", "number": 2, "type": "project-qa", "title": "Project Q&A", "playsPerPrompt": 2, "responseSecondsPerExchange": 40, "promptEn": "Answer four questions in Chinese about your research into learning and transmitting a musical tradition. Each question is heard twice, followed by a forty-second response window. The whole four-response exchange receives one analytic review.", "exchanges": [{"id": "S2-1", "prompt": {"zh-Hans": "你研究的音乐传统是怎样让新参与者学习的？请介绍一个有资料支持的具体做法。", "zh-Hant": "你研究的音樂傳統是怎樣讓新參與者學習的？請介紹一個有資料支持的具體做法。"}, "reference": {"zh-Hans": "侗族大歌资料提到歌师向学习者传授歌曲，也介绍演出时没有指挥的多声部歌唱。我据此注意到，学习时的指导和演出时的配合是两个环节，不能因为演出没有指挥，就认为不用学习或练习。", "zh-Hant": "侗族大歌資料提到歌師向學習者傳授歌曲，也介紹演出時沒有指揮的多聲部歌唱。我據此注意到，學習時的指導和演出時的配合是兩個環節，不能因爲演出沒有指揮，就認爲不用學習或練習。"}}, {"id": "S2-2", "prompt": {"zh-Hans": "请从你的研究中举一个例子，分清哪些是资料明确记载的，哪些是你自己的解释。", "zh-Hant": "請從你的研究中舉一個例子，分清哪些是資料明確記載的，哪些是你自己的解釋。"}, "reference": {"zh-Hans": "西安鼓乐条目明确提到师徒传承和手写曲谱。我认为，曲谱与示范可能提供不同的学习帮助，这是我的解释。要进一步确认，我需要具体教学过程的记录，不能把推测直接说成所有团体都这样做。", "zh-Hant": "西安鼓樂條目明確提到師徒傳承和手寫曲譜。我認爲，曲譜與示範可能提供不同的學習幫助，這是我的解釋。要進一步確認，我需要具體教學過程的記錄，不能把推測直接說成所有團體都這樣做。"}}, {"id": "S2-3", "prompt": {"zh-Hans": "把这种学习方式与你熟悉的一种音乐学习经历比较，你发现什么值得思考的相似或不同？", "zh-Hant": "把這種學習方式與你熟悉的一種音樂學習經歷比較，你發現什麼值得思考的相似或不同？"}, "reference": {"zh-Hans": "我熟悉的学校音乐课常先个人练习，再一起演奏，两者都需要示范和反复练习。资料让我进一步想到，合奏不只是把个人声音加起来，还涉及听别人和理解活动场合。这个比较提醒我注意群体中的学习。", "zh-Hant": "我熟悉的學校音樂課常先個人練習，再一起演奏，兩者都需要示範和反覆練習。資料讓我進一步想到，合奏不只是把個人聲音加起來，還涉及聽別人和理解活動場合。這個比較提醒我注意羣體中的學習。"}}, {"id": "S2-4", "prompt": {"zh-Hans": "如果只用一段很短的网络视频介绍这种音乐，观众可能漏掉什么？你会怎样补充？", "zh-Hant": "如果只用一段很短的網絡視頻介紹這種音樂，觀衆可能漏掉什麼？你會怎樣補充？"}, "reference": {"zh-Hans": "观众可能听见一次演出的声音，却看不到练习、指导和参与者之间长期形成的配合。我会补充一小段教学过程或参与者的说明，标明来源，并说明一个片段不能代表所有场合。这样能给声音更多背景。", "zh-Hant": "觀衆可能聽見一次演出的聲音，卻看不到練習、指導和參與者之間長期形成的配合。我會補充一小段教學過程或參與者的說明，標明來源，並說明一個片段不能代表所有場合。這樣能給聲音更多背景。"}}], "rubric": {"maxPoints": 9, "rows": [{"id": "task", "nameZh": "任务完成", "maxPoints": 2}, {"id": "culture", "nameZh": "文化理解", "maxPoints": 2}, {"id": "language", "nameZh": "语言控制", "maxPoints": 3}, {"id": "fluency", "nameZh": "流利度", "maxPoints": 2}], "printedPages": [136, 137, 138, 139]}, "rubricScope": "One 9-point profile for all four responses together, not 9 points per response."}, {"id": "W1", "number": 3, "type": "story-narration", "title": "Story narration", "sharedTimingGroup": "writing", "promptEn": "Write a complete story in Chinese using all four pictures in order. Explain what happens before, during, and after the problem. You may choose names and add plausible details that fit the sequence.", "prompt": {"zh-Hans": "请按顺序使用全部四幅图，用中文写一个完整故事，交代问题出现前、发生时和解决后的情节。可以自定人物姓名，并补充符合画面顺序的合理细节。", "zh-Hant": "請按順序使用全部四幅圖，用中文寫一個完整故事，交代問題出現前、發生時和解決後的情節。可以自定人物姓名，並補充符合畫面順序的合理細節。"}, "pictures": [{"src": "assets/images/story-1.svg", "alt": "Two volunteers load four potted seedlings onto a cart beside the community garden."}, {"src": "assets/images/story-2.svg", "alt": "A wheel comes off the loaded cart; the volunteers notice the problem before moving farther."}, {"src": "assets/images/story-3.svg", "alt": "The volunteers lift the seedling tray together and carry it toward the planting beds."}, {"src": "assets/images/story-4.svg", "alt": "The seedlings are planted in the garden beds; the empty tray and stopped cart are set aside."}], "reference": {"zh-Hans": "周末上午，小雨和同学参加社区种植活动。他们把四盆小苗放在手推车上，准备送到花园另一边的种植区。小雨扶好盆，同学推动车子，两人一边走一边讨论先种在哪里。\n刚走几步，一只车轮突然松脱，车子歪向一旁。他们赶紧停下，扶住托盘，没有继续硬推。检查以后，两人发现暂时找不到合适的工具修车，便决定换一种运送办法。\n小雨把花盆重新摆稳，同学握住托盘另一侧。两个人一起慢慢抬起，一人提醒前面的路况，另一人照看小苗。虽然比推车费力，他们还是把四盆苗完整送到了种植区。\n后来，大家挖好小坑，把苗种进土里，将空托盘和坏车放到一旁，等活动后再处理。看着整齐的新苗，小雨觉得，遇到问题时先停下来判断，再和同伴合作，比急着照原计划往前走更重要。", "zh-Hant": "週末上午，小雨和同學參加社區種植活動。他們把四盆小苗放在手推車上，準備送到花園另一邊的種植區。小雨扶好盆，同學推動車子，兩人一邊走一邊討論先種在哪裏。\n剛走幾步，一隻車輪突然鬆脫，車子歪向一旁。他們趕緊停下，扶住托盤，沒有繼續硬推。檢查以後，兩人發現暫時找不到合適的工具修車，便決定換一種運送辦法。\n小雨把花盆重新擺穩，同學握住托盤另一側。兩個人一起慢慢抬起，一人提醒前面的路況，另一人照看小苗。雖然比推車費力，他們還是把四盆苗完整送到了種植區。\n後來，大家挖好小坑，把苗種進土裏，將空托盤和壞車放到一旁，等活動後再處理。看着整齊的新苗，小雨覺得，遇到問題時先停下來判斷，再和同伴合作，比急着照原計劃往前走更重要。"}, "checklist": ["Use all four panels in order and maintain continuity of the seedlings, cart, and volunteers.", "Explain the wheel problem, the alternative carrying method, and the planted outcome.", "Add plausible actions without inventing a different pictured problem.", "Write a coherent Chinese story rather than a list of objects."], "rubric": {"maxPoints": 8, "rows": [{"id": "narrative", "nameZh": "叙事展开", "maxPoints": 3}, {"id": "organization", "nameZh": "组织", "maxPoints": 2}, {"id": "language", "nameZh": "语言控制", "maxPoints": 3}], "printedPages": [115, 116, 117, 118]}}, {"id": "W2", "number": 4, "type": "email-response", "title": "Email response", "sharedTimingGroup": "writing", "promptEn": "Reply in Chinese to the coordinator’s email. Address each request and ask a relevant preparation question. Use an appropriate greeting, organization, and closing.", "prompt": {"zh-Hans": "学校交流办公室｜学生版校园指南\n同学你好！下个月有一组短期交流学生来校，我们想请学生编一份简短的双语校园指南。你认为最值得加入哪类信息？请说明理由，以及你愿意负责的工作。\n有些信息，例如活动时间和联系人，可能会变化。你建议怎样保持资料可靠？纸面篇幅有限，但读者的中文水平不同，你会怎样兼顾清楚和简短？最后，请提出一个你开始准备前需要向办公室确认的问题。\n期待你的建议！\n协调员 周老师", "zh-Hant": "學校交流辦公室｜學生版校園指南\n同學你好！下個月有一組短期交流學生來校，我們想請學生編一份簡短的雙語校園指南。你認爲最值得加入哪類信息？請說明理由，以及你願意負責的工作。\n有些信息，例如活動時間和聯繫人，可能會變化。你建議怎樣保持資料可靠？紙面篇幅有限，但讀者的中文水平不同，你會怎樣兼顧清楚和簡短？最後，請提出一個你開始準備前需要向辦公室確認的問題。\n期待你的建議！\n協調員 周老師"}, "reference": {"zh-Hans": "周老师您好！\n我很愿意参与。我建议优先加入交流学生刚到学校最常需要的办事信息，例如怎样找教室、借用设备和参加社团。短期来校的同学时间有限，清楚的入口能帮助他们尽快独立安排学习和生活。\n我可以先收集几个常见问题，再向相关负责人核对办理地点和步骤，负责整理这一部分。对于可能变化的信息，建议每项都标明核对日期，并指定一位联系人定期确认；纸上保留稳定的办理入口，易变的活动时间则放在可更新的网页上。\n为了兼顾中文水平不同的读者，可以用短句、清楚标题和简单示意图，把最重要的操作步骤配上简短英文。更多解释另放补充页，不把全部内容挤在一张纸上。\n开始前我想确认，办公室希望指南主要帮助学生自己办理事务，还是也供带队教师使用？明确读者以后，我就能更合适地选择内容。\n谢谢您的信任，期待回复！\n顾岚", "zh-Hant": "周老師您好！\n我很願意參與。我建議優先加入交流學生剛到學校最常需要的辦事信息，例如怎樣找教室、借用設備和參加社團。短期來校的同學時間有限，清楚的入口能幫助他們儘快獨立安排學習和生活。\n我可以先收集幾個常見問題，再向相關負責人覈對辦理地點和步驟，負責整理這一部分。對於可能變化的信息，建議每項都標明覈對日期，並指定一位聯繫人定期確認；紙上保留穩定的辦理入口，易變的活動時間則放在可更新的網頁上。\n爲了兼顧中文水平不同的讀者，可以用短句、清楚標題和簡單示意圖，把最重要的操作步驟配上簡短英文。更多解釋另放補充頁，不把全部內容擠在一張紙上。\n開始前我想確認，辦公室希望指南主要幫助學生自己辦理事務，還是也供帶隊教師使用？明確讀者以後，我就能更合適地選擇內容。\n謝謝您的信任，期待回覆！\n顧嵐"}, "checklist": ["Recommend a useful information category and explain the choice.", "Offer a concrete contribution and a way to verify changing information.", "Address limited space and readers with different Chinese levels.", "Ask a relevant preparation question and maintain an appropriate email register."], "rubric": {"maxPoints": 8, "rows": [{"id": "message", "nameZh": "信息展开", "maxPoints": 3}, {"id": "organization", "nameZh": "组织", "maxPoints": 2}, {"id": "language", "nameZh": "语言控制", "maxPoints": 3}], "printedPages": [119, 120, 121, 122]}}], "scoring": {"objective": "one raw point per correct MCQ; report listening /25 and reading /30 separately", "freeResponse": "manual analytic review; Q1 /11, complete Q2 exchange /9, Q3 /8, Q4 /8; no automatic grades", "officialScoreConversion": null}, "references": [{"title": "College Board exam structure", "url": "https://apcentral.collegeboard.org/courses/ap-chinese-language-and-culture/exam", "checkedOn": "2026-11-09"}, {"title": "2026–27 music project direction; packet due January 2027", "url": "https://apcentral.collegeboard.org/help-center/what-project-theme-2026-27", "checkedOn": "2026-11-09"}, {"title": "CED task models and rubric categories", "url": "https://apcentral.collegeboard.org/media/pdf/ap-chinese-language-and-culture-course-and-exam-description.pdf", "checkedOn": "2026-11-09"}]}</script><script id="audio-data" type="application/json">{"paperId": "ap-chinese-2027-b-v1", "voices": {"female": "zh-CN-XiaoxiaoNeural", "male": "zh-CN-YunxiNeural"}, "rate": "-4%", "provider": "Edge TTS, generated during authoring; local MP3 playback has no runtime provider dependency", "humanListeningAcceptance": false, "timedTrack": {"src": "assets/audio/listening-full.mp3", "sha256": "4f4c4374c2c144d3b4fdb56fded4276f2515d7412c021d173bd1f7502b3bfdba", "bytes": 12000620, "durationSeconds": 1500.048, "pcmSeconds": 1500.0}, "timeline": [{"setId": "L1", "startSeconds": 0, "speechEndSeconds": 96.68, "endSeconds": 300, "answerWindowSeconds": 203.32, "note": "Original HSKKit equal-length practice pacing, not asserted as official Bluebook pacing."}, {"setId": "L2", "startSeconds": 300, "speechEndSeconds": 385.0, "endSeconds": 600, "answerWindowSeconds": 215.0, "note": "Original HSKKit equal-length practice pacing, not asserted as official Bluebook pacing."}, {"setId": "L3", "startSeconds": 600, "speechEndSeconds": 702.31, "endSeconds": 900, "answerWindowSeconds": 197.69, "note": "Original HSKKit equal-length practice pacing, not asserted as official Bluebook pacing."}, {"setId": "L4", "startSeconds": 900, "speechEndSeconds": 988.528, "endSeconds": 1200, "answerWindowSeconds": 211.472, "note": "Original HSKKit equal-length practice pacing, not asserted as official Bluebook pacing."}, {"setId": "L5", "startSeconds": 1200, "speechEndSeconds": 1288.864, "endSeconds": 1500, "answerWindowSeconds": 211.136, "note": "Original HSKKit equal-length practice pacing, not asserted as official Bluebook pacing."}], "units": [{"id": "L1", "kind": "listening-source", "questionNumbers": [1, 2, 3, 4, 5], "sourcePlays": 1, "script": [{"speaker": "female", "text": {"zh-Hans": "各位参加海岛讲座的同学，请先看周六客船表。讲座十点开始，但大家要在九点五十分以前到会场登记，码头到会场还要走五分钟。所以不能只看哪班船赶得上十点。小陈说，他八点以前就能到河口码头，单程船票预算不超过二十元。我建议他坐河口码头八点半的船，虽然航程长一些，仍有时间登记，也符合预算。今天河口码头的自动售票机维修，请去人工窗口买票，窗口在每班开船前十五分钟停止售票。表中只列去程，不能把到岛时间当成返航时间；回程请另外查表。票价也不包含岛上的交通。最后，手机显示可能下雨，不等于客船一定停航。当天是否调整航班，要看码头发布的运行通知。可以提前查看消息，但不要只凭天气图标判断。请把登记、步行和买票所需的时间都算进去，给行程留出余地。", "zh-Hant": "各位參加海島講座的同學，請先看週六客船表。講座十點開始，但大家要在九點五十分以前到會場登記，碼頭到會場還要走五分鐘。所以不能只看哪班船趕得上十點。小陳說，他八點以前就能到河口碼頭，單程船票預算不超過二十元。我建議他坐河口碼頭八點半的船，雖然航程長一些，仍有時間登記，也符合預算。今天河口碼頭的自動售票機維修，請去人工窗口買票，窗口在每班開船前十五分鐘停止售票。表中只列去程，不能把到島時間當成返航時間；回程請另外查表。票價也不包含島上的交通。最後，手機顯示可能下雨，不等於客船一定停航。當天是否調整航班，要看碼頭髮布的運行通知。可以提前查看消息，但不要只憑天氣圖標判斷。請把登記、步行和買票所需的時間都算進去，給行程留出餘地。"}}], "src": "assets/audio/l1.mp3", "sha256": "1aa6065185e06aeb3fef0ba6d269cfa635349763cc337d6c470f56a1757622c3", "bytes": 622892, "durationSeconds": 77.832, "pcmSeconds": 77.776}, {"id": "L2", "kind": "listening-source", "questionNumbers": [6, 7, 8, 9, 10], "sourcePlays": 1, "script": [{"speaker": "male", "text": {"zh-Hans": "青石街最近试行新的夜间照明安排。以前，商店关门后，店外装饰灯仍亮到天明，有居民觉得窗外太亮。街道先在一小段商业路上试行：晚上十一点以后调低装饰灯亮度，但公交站和人行道的基本照明不变。消息公布后，一位夜班下班的居民提出，不能因为多数人已经睡觉，就忽略少数晚归者。项目小组于是增加了晚间步行访谈，邀请店员、保安和附近住户一起看哪些位置需要补充标识。他们没有把一晚经过的人数少，直接理解成那条路没人需要。与此同时，几家店铺担心调暗以后招牌不明显。小组决定先调整照射方向，减少灯光直接进入住宅，再比较不同时间的使用情况。本月收到的意见中，有人说睡觉更舒服，也有人仍觉得转弯处看不清。负责人表示，试行不是一次投票后就结束，而是要根据具体位置继续修改。电表记录能说明用电变化，却不能单独回答每个人走路是否方便，因此数字与现场反馈都要保留。", "zh-Hant": "青石街最近試行新的夜間照明安排。以前，商店關門後，店外裝飾燈仍亮到天明，有居民覺得窗外太亮。街道先在一小段商業路上試行：晚上十一點以後調低裝飾燈亮度，但公交站和人行道的基本照明不變。消息公佈後，一位夜班下班的居民提出，不能因爲多數人已經睡覺，就忽略少數晚歸者。項目小組於是增加了晚間步行訪談，邀請店員、保安和附近住戶一起看哪些位置需要補充標識。他們沒有把一晚經過的人數少，直接理解成那條路沒人需要。與此同時，幾家店鋪擔心調暗以後招牌不明顯。小組決定先調整照射方向，減少燈光直接進入住宅，再比較不同時間的使用情況。本月收到的意見中，有人說睡覺更舒服，也有人仍覺得轉彎處看不清。負責人表示，試行不是一次投票後就結束，而是要根據具體位置繼續修改。電錶記錄能說明用電變化，卻不能單獨回答每個人走路是否方便，因此數字與現場反饋都要保留。"}}], "src": "assets/audio/l2.mp3", "sha256": "e77ac7a0a3fa193c32f83f695c13e4319169b6f5b5e2f125670e051a18bfc057", "bytes": 680684, "durationSeconds": 85.056, "pcmSeconds": 85.0}, {"id": "L3", "kind": "listening-source", "questionNumbers": [11, 12, 13, 14, 15], "sourcePlays": 1, "script": [{"speaker": "female", "text": {"zh-Hans": "戏剧社的海报上写“把舞台交给每个人”，我想翻译成“每个人都必须上台”，你觉得可以吗？", "zh-Hant": "戲劇社的海報上寫“把舞臺交給每個人”，我想翻譯成“每個人都必須上臺”，你覺得可以嗎？"}}, {"speaker": "male", "text": {"zh-Hans": "听起来像是强制表演了。我们本来想说，没有演出经验也能找到参与的方式。有人喜欢演戏，也有人想做灯光、服装或者接待。", "zh-Hant": "聽起來像是強制表演了。我們本來想說，沒有演出經驗也能找到參與的方式。有人喜歡演戲，也有人想做燈光、服裝或者接待。"}}, {"speaker": "female", "text": {"zh-Hans": "难怪昨天一位同学说，他一紧张就说不出话，所以不敢报名。我只告诉他“门槛不高”，他还是担心。", "zh-Hant": "難怪昨天一位同學說，他一緊張就說不出話，所以不敢報名。我只告訴他“門檻不高”，他還是擔心。"}}, {"speaker": "male", "text": {"zh-Hans": "“门槛不高”太笼统了。我们可以具体写出来：不用先准备试演，报名后先参加一次开放排练，再选想尝试的角色。新手做灯光时，会有学长带着。", "zh-Hant": "“門檻不高”太籠統了。我們可以具體寫出來：不用先準備試演，報名後先參加一次開放排練，再選想嘗試的角色。新手做燈光時，會有學長帶着。"}}, {"speaker": "female", "text": {"zh-Hans": "那英文口号可以写“按自己的方式参与”，旁边再列几种角色。不过只写“自由选择”，会不会让人以为任何时间来都行？", "zh-Hant": "那英文口號可以寫“按自己的方式參與”，旁邊再列幾種角色。不過只寫“自由選擇”，會不會讓人以爲任何時間來都行？"}}, {"speaker": "male", "text": {"zh-Hans": "对，选择角色不等于没有责任。周四排练和演出当天的时间要写清楚。如果时间冲突，要先联系协调人，不要答应了又没人到场。", "zh-Hant": "對，選擇角色不等於沒有責任。週四排練和演出當天的時間要寫清楚。如果時間衝突，要先聯繫協調人，不要答應了又沒人到場。"}}, {"speaker": "female", "text": {"zh-Hans": "我明白了。海报不是越短越好，而是要让人看懂，哪些地方有选择，哪些安排需要配合。我会把原来的强制语气改掉，也补上排练时间。", "zh-Hant": "我明白了。海報不是越短越好，而是要讓人看懂，哪些地方有選擇，哪些安排需要配合。我會把原來的強制語氣改掉，也補上排練時間。"}}, {"speaker": "male", "text": {"zh-Hans": "这样才符合我们要表达的意思。中文口号可以保留，但解释应该帮助读者作决定，而不是只追求字面上对应。", "zh-Hant": "這樣才符合我們要表達的意思。中文口號可以保留，但解釋應該幫助讀者作決定，而不是隻追求字面上對應。"}}], "src": "assets/audio/l3.mp3", "sha256": "ae3f9cb78e69534417d69f531f8d0ab41968e44f35b3147f136e5f160139403c", "bytes": 819116, "durationSeconds": 102.36, "pcmSeconds": 102.31}, {"id": "L4", "kind": "listening-source", "questionNumbers": [16, 17, 18, 19, 20], "sourcePlays": 1, "script": [{"speaker": "female", "text": {"zh-Hans": "今天的培训是把手绘街区地图放进学校的数字展览。先提醒大家，这张图记录的是去年暑假的街区，不是实时导航图，标题旁要写清记录时间。扫描以后，请保留一份原始文件，再复制一份作为上传版本；不要为了缩小文件，直接覆盖唯一的原图。系统要求上传文件不超过五兆，如果图片过大，可以在副本上缩小尺寸，但要检查小字是否还能读清。地图上的红线和绿线表示两条不同路线，不能只靠颜色区分，请再加实线、虚线或文字标记。接下来填写图片说明，不必把图上每个字都抄一遍，应先说明地图展示什么，再描述两条路线的主要差别。如果扫描时漏掉图例，请重新扫描完整页面，别让参观者猜线条是什么意思。提交后会先进入草稿区，不会立刻公开。请在手机和电脑上各预览一次，确认边缘没有被裁掉，链接也指向你想展示的内容，再点“发布”。如果发现错误，可以回草稿修改，保留原始文件会让这一步容易得多。", "zh-Hant": "今天的培訓是把手繪街區地圖放進學校的數字展覽。先提醒大家，這張圖記錄的是去年暑假的街區，不是實時導航圖，標題旁要寫清記錄時間。掃描以後，請保留一份原始文件，再複製一份作爲上傳版本；不要爲了縮小文件，直接覆蓋唯一的原圖。系統要求上傳文件不超過五兆，如果圖片過大，可以在副本上縮小尺寸，但要檢查小字是否還能讀清。地圖上的紅線和綠線表示兩條不同路線，不能只靠顏色區分，請再加實線、虛線或文字標記。接下來填寫圖片說明，不必把圖上每個字都抄一遍，應先說明地圖展示什麼，再描述兩條路線的主要差別。如果掃描時漏掉圖例，請重新掃描完整頁面，別讓參觀者猜線條是什麼意思。提交後會先進入草稿區，不會立刻公開。請在手機和電腦上各預覽一次，確認邊緣沒有被裁掉，鏈接也指向你想展示的內容，再點“發佈”。如果發現錯誤，可以回草稿修改，保留原始文件會讓這一步容易得多。"}}], "src": "assets/audio/l4.mp3", "sha256": "1936cff0459fb6ebe8386ec51a78def7a1f07f816ed3a8a0a1b685fac13da888", "bytes": 708908, "durationSeconds": 88.584, "pcmSeconds": 88.528}, {"id": "L5", "kind": "listening-source", "questionNumbers": [21, 22, 23, 24, 25], "sourcePlays": 1, "script": [{"speaker": "male", "text": {"zh-Hans": "上个月，我们家试着把家务写在表上，做一件事就记一分，月底看谁分数最多。起初我觉得很公平，因为每个人都看得见结果。后来，妹妹洗一次碗得一分，外公花一个小时买菜也只得一分，大家开始争论。我们改成按时间记，可新的问题又出现了：谁记得家里缺什么、谁提前想好一周吃什么，这些准备往往没有被算进去。妈妈说，表格能帮助提醒，却不该把照顾家人变成争分数。我们于是开了一次家庭讨论，不先问谁做得最多，而是问哪些事情总没人注意，哪些人最近特别忙。妹妹还不会安排采购，我们没有让她永远只洗碗，而是请她先跟外公去一次市场，下周试着列清单。外公也愿意学会用手机查看清单，免得买重复。现在，任务仍写在表上，但遇到考试、加班或身体不舒服时，可以提前商量换手。对我来说，公平不再只是数字相等，也包括看见没被记录的准备、让人有机会学习，以及在需要的时候搭把手。这是我们家的做法，不一定适合每一个家庭，但定期说清彼此的需要，比一张看起来很精确的表更有用。", "zh-Hant": "上個月，我們家試着把家務寫在表上，做一件事就記一分，月底看誰分數最多。起初我覺得很公平，因爲每個人都看得見結果。後來，妹妹洗一次碗得一分，外公花一個小時買菜也只得一分，大家開始爭論。我們改成按時間記，可新的問題又出現了：誰記得家裏缺什麼、誰提前想好一週喫什麼，這些準備往往沒有被算進去。媽媽說，表格能幫助提醒，卻不該把照顧家人變成爭分數。我們於是開了一次家庭討論，不先問誰做得最多，而是問哪些事情總沒人注意，哪些人最近特別忙。妹妹還不會安排採購，我們沒有讓她永遠只洗碗，而是請她先跟外公去一次市場，下週試着列清單。外公也願意學會用手機查看清單，免得買重複。現在，任務仍寫在表上，但遇到考試、加班或身體不舒服時，可以提前商量換手。對我來說，公平不再只是數字相等，也包括看見沒被記錄的準備、讓人有機會學習，以及在需要的時候搭把手。這是我們家的做法，不一定適合每一個家庭，但定期說清彼此的需要，比一張看起來很精確的表更有用。"}}], "src": "assets/audio/l5.mp3", "sha256": "4b0f38e2f034b1d8c89963f7bcb9775ca2bad8284fe6848948f11017e2391497", "bytes": 711596, "durationSeconds": 88.92, "pcmSeconds": 88.864}, {"id": "S1", "kind": "presentation-prompt", "src": "assets/audio/s1-prompt.mp3", "sha256": "bdc1ab8717b14572501d950eec479f55a100c27dbc16480181cc82210a52b0f6", "bytes": 175724, "durationSeconds": 21.936, "pcmSeconds": 21.888}, {"id": "S2-1", "kind": "qa-prompt", "promptPlays": 2, "script": {"zh-Hans": "你研究的音乐传统是怎样让新参与者学习的？请介绍一个有资料支持的具体做法。", "zh-Hant": "你研究的音樂傳統是怎樣讓新參與者學習的？請介紹一個有資料支持的具體做法。"}, "src": "assets/audio/s2-1.mp3", "sha256": "221954b97b056a10f18bf1217c277695c3d4290edd026d022983a5cb5fa3ead7", "bytes": 142124, "durationSeconds": 17.736, "pcmSeconds": 17.676}, {"id": "S2-2", "kind": "qa-prompt", "promptPlays": 2, "script": {"zh-Hans": "请从你的研究中举一个例子，分清哪些是资料明确记载的，哪些是你自己的解释。", "zh-Hant": "請從你的研究中舉一個例子，分清哪些是資料明確記載的，哪些是你自己的解釋。"}, "src": "assets/audio/s2-2.mp3", "sha256": "4138064107aa22c2dad155e916c159410171555c81fff9b7d046dc2b6b9ffb20", "bytes": 140972, "durationSeconds": 17.592, "pcmSeconds": 17.532}, {"id": "S2-3", "kind": "qa-prompt", "promptPlays": 2, "script": {"zh-Hans": "把这种学习方式与你熟悉的一种音乐学习经历比较，你发现什么值得思考的相似或不同？", "zh-Hant": "把這種學習方式與你熟悉的一種音樂學習經歷比較，你發現什麼值得思考的相似或不同？"}, "src": "assets/audio/s2-3.mp3", "sha256": "5b5464d66d00731544e1e8a9d79bfbe3854bb019079f866e78df629d07ff477a", "bytes": 149420, "durationSeconds": 18.648, "pcmSeconds": 18.588}, {"id": "S2-4", "kind": "qa-prompt", "promptPlays": 2, "script": {"zh-Hans": "如果只用一段很短的网络视频介绍这种音乐，观众可能漏掉什么？你会怎样补充？", "zh-Hant": "如果只用一段很短的網絡視頻介紹這種音樂，觀衆可能漏掉什麼？你會怎樣補充？"}, "src": "assets/audio/s2-4.mp3", "sha256": "10ada2a259d34c2f12a073d9f18cd769b0c91e2b233f2cde70ca0a1c112ad1e5", "bytes": 142124, "durationSeconds": 17.736, "pcmSeconds": 17.676}], "cache": [{"key": "f9121cc7284fbeecb63b1bc9", "speaker": "female", "text": "这是 HSKKit AP 中文原创模拟练习，B卷。听力部分二十五道选择题，分五组。本练习整轨为二十五分钟，各组材料播放一遍，之后留有阅读题目和作答的时间。此播放安排为本站练习设置。现在开始第一组。", "sha256": "738cd368f6c795a89793ca8a3645186ace24f13e27cf307edfd986143c9156b1"}, {"key": "49ef1840042f83124ffff59a", "speaker": "female", "text": "AP 中文，B卷，第1组，第1到第5题。", "sha256": "2e2bf6ece6582f4a5b7d934e385997bc0638781d181cfbb651b078a663e704db"}, {"key": "88abdfc836fe0e88fd0cddc0", "speaker": "female", "text": "各位参加海岛讲座的同学，请先看周六客船表。讲座十点开始，但大家要在九点五十分以前到会场登记，码头到会场还要走五分钟。所以不能只看哪班船赶得上十点。小陈说，他八点以前就能到河口码头，单程船票预算不超过二十元。我建议他坐河口码头八点半的船，虽然航程长一些，仍有时间登记，也符合预算。今天河口码头的自动售票机维修，请去人工窗口买票，窗口在每班开船前十五分钟停止售票。表中只列去程，不能把到岛时间当成返航时间；回程请另外查表。票价也不包含岛上的交通。最后，手机显示可能下雨，不等于客船一定停航。当天是否调整航班，要看码头发布的运行通知。可以提前查看消息，但不要只凭天气图标判断。请把登记、步行和买票所需的时间都算进去，给行程留出余地。", "sha256": "a1659da99dd81fed545a81d5d46e660b657125f670c2283f6e5cebf78e1dfaee"}, {"key": "4fe921f4ef842f3b103225db", "speaker": "female", "text": "AP 中文，B卷，第2组，第6到第10题。", "sha256": "e173e97f5c49d238ab00551cafcc0ce30a42322292a532562da9535221325bb0"}, {"key": "c8f1a97c6b3c8f201c481727", "speaker": "male", "text": "青石街最近试行新的夜间照明安排。以前，商店关门后，店外装饰灯仍亮到天明，有居民觉得窗外太亮。街道先在一小段商业路上试行：晚上十一点以后调低装饰灯亮度，但公交站和人行道的基本照明不变。消息公布后，一位夜班下班的居民提出，不能因为多数人已经睡觉，就忽略少数晚归者。项目小组于是增加了晚间步行访谈，邀请店员、保安和附近住户一起看哪些位置需要补充标识。他们没有把一晚经过的人数少，直接理解成那条路没人需要。与此同时，几家店铺担心调暗以后招牌不明显。小组决定先调整照射方向，减少灯光直接进入住宅，再比较不同时间的使用情况。本月收到的意见中，有人说睡觉更舒服，也有人仍觉得转弯处看不清。负责人表示，试行不是一次投票后就结束，而是要根据具体位置继续修改。电表记录能说明用电变化，却不能单独回答每个人走路是否方便，因此数字与现场反馈都要保留。", "sha256": "01de4e03c9c046442de4e25821d3b57ba2b4a977668a8aeb84a3990d38a7c9ce"}, {"key": "135d60f2a2f40f7297e4a4c3", "speaker": "female", "text": "AP 中文，B卷，第3组，第11到第15题。", "sha256": "c1d2095cd2a155ba02f528cd299d1c59ff58bbfb83b0e4201751ac52e529952c"}, {"key": "51bdcbee081ea5fd0969bef3", "speaker": "female", "text": "戏剧社的海报上写“把舞台交给每个人”，我想翻译成“每个人都必须上台”，你觉得可以吗？", "sha256": "d33ea0403506c948a4040a59fe3ea0ce29092cde053cacc10874d9bbec18cbde"}, {"key": "68f24abadb1119ff7d584467", "speaker": "male", "text": "听起来像是强制表演了。我们本来想说，没有演出经验也能找到参与的方式。有人喜欢演戏，也有人想做灯光、服装或者接待。", "sha256": "e9d16d8ffe1cfc02e419ab51929b1ebd58928dad603be6d96d7693dd2ebe388f"}, {"key": "f6b85a5ba4494810a2efdec3", "speaker": "female", "text": "难怪昨天一位同学说，他一紧张就说不出话，所以不敢报名。我只告诉他“门槛不高”，他还是担心。", "sha256": "df8a23ee6a44916dbc6fc60662197ac2f3cdb0833dea7db7c19e76bcd0a53248"}, {"key": "bd0fa550e33e52c17cd666a5", "speaker": "male", "text": "“门槛不高”太笼统了。我们可以具体写出来：不用先准备试演，报名后先参加一次开放排练，再选想尝试的角色。新手做灯光时，会有学长带着。", "sha256": "c7c92f016069a108581c71d175dc962f034f9de509030920043ab009f6b92df9"}, {"key": "184f9601927c2fb8b92660e2", "speaker": "female", "text": "那英文口号可以写“按自己的方式参与”，旁边再列几种角色。不过只写“自由选择”，会不会让人以为任何时间来都行？", "sha256": "a20ff66c772cea88bf39f45c3e8e18f2b560325e82f9c7da5788faf9ad860a40"}, {"key": "04d649d616fdfcd3951b64fd", "speaker": "male", "text": "对，选择角色不等于没有责任。周四排练和演出当天的时间要写清楚。如果时间冲突，要先联系协调人，不要答应了又没人到场。", "sha256": "13cf90daa36de249c4121a468f05740357eabdb2ce65385c68c590cc42acfe5b"}, {"key": "c1aec49a425b79529b488804", "speaker": "female", "text": "我明白了。海报不是越短越好，而是要让人看懂，哪些地方有选择，哪些安排需要配合。我会把原来的强制语气改掉，也补上排练时间。", "sha256": "b8e64d8da0097f5930d781afe40bc37f67f15af9e6501f8cf4771da173f4d674"}, {"key": "3c5a8a089e7d45fe72bf961c", "speaker": "male", "text": "这样才符合我们要表达的意思。中文口号可以保留，但解释应该帮助读者作决定，而不是只追求字面上对应。", "sha256": "ee87de07f81630e22ceb5be4fc01b8bbcc175f2d1bd4caa6b48aa3aa6e868e71"}, {"key": "2275cb7cfec5cd904cf20b7e", "speaker": "female", "text": "AP 中文，B卷，第4组，第16到第20题。", "sha256": "2527068a217f2bcc838f3e78f06f8b3e5dea0087cb9e97018bd8b58f01759387"}, {"key": "bffe2317ab298507a5b67fbb", "speaker": "female", "text": "今天的培训是把手绘街区地图放进学校的数字展览。先提醒大家，这张图记录的是去年暑假的街区，不是实时导航图，标题旁要写清记录时间。扫描以后，请保留一份原始文件，再复制一份作为上传版本；不要为了缩小文件，直接覆盖唯一的原图。系统要求上传文件不超过五兆，如果图片过大，可以在副本上缩小尺寸，但要检查小字是否还能读清。地图上的红线和绿线表示两条不同路线，不能只靠颜色区分，请再加实线、虚线或文字标记。接下来填写图片说明，不必把图上每个字都抄一遍，应先说明地图展示什么，再描述两条路线的主要差别。如果扫描时漏掉图例，请重新扫描完整页面，别让参观者猜线条是什么意思。提交后会先进入草稿区，不会立刻公开。请在手机和电脑上各预览一次，确认边缘没有被裁掉，链接也指向你想展示的内容，再点“发布”。如果发现错误，可以回草稿修改，保留原始文件会让这一步容易得多。", "sha256": "740624505e2c0dcc78244585a11a9df2191855299541010a94414849e255dc99"}, {"key": "9a5ccfcb245c5931e3c65f0a", "speaker": "female", "text": "AP 中文，B卷，第5组，第21到第25题。", "sha256": "9bc77330bf09d0d951fea820f613d90b58319a404dfdf0bb2f60582a3607ea8f"}, {"key": "d46d08a298b54fa93ef93214", "speaker": "male", "text": "上个月，我们家试着把家务写在表上，做一件事就记一分，月底看谁分数最多。起初我觉得很公平，因为每个人都看得见结果。后来，妹妹洗一次碗得一分，外公花一个小时买菜也只得一分，大家开始争论。我们改成按时间记，可新的问题又出现了：谁记得家里缺什么、谁提前想好一周吃什么，这些准备往往没有被算进去。妈妈说，表格能帮助提醒，却不该把照顾家人变成争分数。我们于是开了一次家庭讨论，不先问谁做得最多，而是问哪些事情总没人注意，哪些人最近特别忙。妹妹还不会安排采购，我们没有让她永远只洗碗，而是请她先跟外公去一次市场，下周试着列清单。外公也愿意学会用手机查看清单，免得买重复。现在，任务仍写在表上，但遇到考试、加班或身体不舒服时，可以提前商量换手。对我来说，公平不再只是数字相等，也包括看见没被记录的准备、让人有机会学习，以及在需要的时候搭把手。这是我们家的做法，不一定适合每一个家庭，但定期说清彼此的需要，比一张看起来很精确的表更有用。", "sha256": "d4d33c48203c7b6384eaa335d5ddd18facdd8abea5491a5422309d96feed72c8"}, {"key": "9069fc0b3561c6be1006563d", "speaker": "female", "text": "你研究的音乐传统是怎样让新参与者学习的？请介绍一个有资料支持的具体做法。", "sha256": "757715bdffefedf6ef5c7585283424f4e1d2e962dac850a80e8cedf7ea260d82"}, {"key": "48f187b298e691d3e03dfcea", "speaker": "female", "text": "请从你的研究中举一个例子，分清哪些是资料明确记载的，哪些是你自己的解释。", "sha256": "9838a52b5fa73e11359df87237804ab92c958eb39e4eec3ae4992db0d26e5cce"}, {"key": "cef5790bc5571ccaf43af85a", "speaker": "female", "text": "把这种学习方式与你熟悉的一种音乐学习经历比较，你发现什么值得思考的相似或不同？", "sha256": "0350f9f87331da4ab391990218c9e4bdc2f1004772d83b26471b8707cbc203a1"}, {"key": "665aeebda46ce9302af8efcf", "speaker": "female", "text": "如果只用一段很短的网络视频介绍这种音乐，观众可能漏掉什么？你会怎样补充？", "sha256": "30c7625c79530e7cdd26971faf35bf4172db84fe62bf80e8a3525bf01d8c47c7"}, {"key": "1ded3ddcc72a9f90101e99d2", "speaker": "female", "text": "请介绍你研究的一种华语文化情境中的音乐传统怎样被学习或传承。说明一种具体学习实践及其与文化观念的关系，结合可辨认的资料证据，作适当比较或反思，并指出来源所能说明的问题有哪些局限。请用中文作答。", "sha256": "350602bcf4cb47b82dfb02c20154919ad05a603f405fb0d149c9bc4e5a4191db"}]}</script><script src="paper.js" defer></script><noscript>Use student.pdf and the audio review files if JavaScript is unavailable.</noscript></body></html>
