<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="robots" content="noindex,nofollow"><base href="/api/v1/course-tests/chinese-2/a/file/"><title>Chinese 2 · Paper A · HSKKit</title><link rel="stylesheet" href="workspace.css"></head><body><header class="bar"><a class="brand" href="/">HSKKit</a><a href="/chinese-course-tests#chinese-2">← Chinese 2 papers</a></header><div id="live" class="live" aria-live="polite"></div><div id="clockbar" class="clockbar" hidden><strong id="clock" role="timer"></strong><span id="oral-clock" role="timer"></span></div><div id="audio-dock" class="audio-dock" hidden><strong id="audio-label"></strong><audio id="listening-player" controls preload="metadata"></audio><p id="audio-error" role="alert" hidden>Audio could not load. Retry or open Audio review.</p></div><main id="app"></main><audio id="prompt-player" preload="none"></audio><footer><p>Independent HSKKit course review. Writing and speaking need manual review. Not an official school, HSK or ACTFL assessment.</p><a href="listening.html">Audio review</a> · <a href="teacher.html">Answer guide</a></footer><script id="paper-data" type="application/json">{"id": "course-chinese-2-a-v1", "product": "HSKKit Chinese 2 Course Review", "paperCode": "A", "version": "content-draft-v1", "authoredOn": "2026-11-10", "status": "content_authored_independent_acceptance_pending", "officialExam": false, "purpose": "Review HSKKit Chinese 2 scope only; no school credit, placement or official level conversion.", "blueprint": {"id": "course-chinese-2-blueprint-v1", "source": "docs/course-chinese2-spec-20261110/blueprint.json", "sha256": "aa5a92d630a8e6063448555a90ce684a2b1569012b15be2b11f686e902575dae"}, "provenance": {"original": true, "aiAssisted": true, "competitorQuestionsCopied": false, "relabelledHskQuestions": false, "humanListeningAcceptance": false, "teacherReview": false, "learnerPilot": false, "userAcceptance": false, "traditionalScript": "OpenCC s2t with author comparison; independent review pending"}, "order": ["listening", "reading", "writing", "speaking"], "sections": [{"id": "listening", "seconds": 1200, "objectiveItems": 20, "groups": 4, "itemsPerGroup": 5, "sourcePlays": 2}, {"id": "reading", "seconds": 1500, "objectiveItems": 20, "groups": 4, "itemsPerGroup": 5}, {"id": "writing", "seconds": 1200, "manualTasks": 2, "sharedClock": true}, {"id": "speaking", "seconds": 600, "manualTasks": 2}], "counts": {"listening": 20, "reading": 20, "writing": 2, "speaking": 2, "speakingRecordings": 5, "topLevelTasks": 44}, "scoring": {"listeningMax": 20, "readingMax": 20, "pointsPerObjectiveItem": 1, "incorrectOrUnansweredPoints": 0, "manualTaskMax": 8, "combinedScore": null, "passCutoff": null, "officialConversion": null, "unsubmittedManual": "unsubmitted", "technicalFailureManual": "needs_rerecording"}, "materials": [{"id": "C2A-M01", "title": "A shared household task", "section": "listening", "kind": "short-audio", "original": true, "script": [{"speaker": "female", "text": {"zh-Hans": "今天的家务怎么分？你打扫客厅，我洗碗，好吗？", "zh-Hant": "今天的家務怎麼分？你打掃客廳，我洗碗，好嗎？"}}, {"speaker": "male", "text": {"zh-Hans": "我更想洗碗，客厅请你打扫，可以吗？", "zh-Hant": "我更想洗碗，客廳請你打掃，可以嗎？"}}, {"speaker": "female", "text": {"zh-Hans": "好，那就这样。", "zh-Hant": "好，那就這樣。"}}], "glossary": []}, {"id": "C2A-M02", "title": "When the activity begins", "section": "listening", "kind": "short-audio", "original": true, "script": [{"speaker": "male", "text": {"zh-Hans": "社区活动星期六十点开始。我九点要在家打扫厨房，九点半出门。活动十二点结束以后，我再去买菜。", "zh-Hant": "社區活動星期六十點開始。我九點要在家打掃廚房，九點半出門。活動十二點結束以後，我再去買菜。"}}], "glossary": []}, {"id": "C2A-M03", "title": "A regular household job", "section": "listening", "kind": "short-audio", "original": true, "script": [{"speaker": "female", "text": {"zh-Hans": "我平时每天晚上洗碗，星期六和星期日不用洗，因为这两天爸爸做家务。我每个星期洗五次，每次大约十分钟。", "zh-Hant": "我平時每天晚上洗碗，星期六和星期日不用洗，因爲這兩天爸爸做家務。我每個星期洗五次，每次大約十分鐘。"}}], "glossary": []}, {"id": "C2A-M04", "title": "A walk after work", "section": "listening", "kind": "short-audio", "original": true, "script": [{"speaker": "male", "text": {"zh-Hans": "你平时六点散步，今天也一样吗？", "zh-Hant": "你平時六點散步，今天也一樣嗎？"}}, {"speaker": "female", "text": {"zh-Hans": "今天六点要开会，七点才下班。我想下班后走半个小时。", "zh-Hant": "今天六點要開會，七點才下班。我想下班後走半個小時。"}}, {"speaker": "male", "text": {"zh-Hans": "那我七点在楼下等你。", "zh-Hant": "那我七點在樓下等你。"}}], "glossary": []}, {"id": "C2A-M05", "title": "A change to the evening", "section": "listening", "kind": "short-audio", "original": true, "script": [{"speaker": "female", "text": {"zh-Hans": "小安最近每天晚上看电视到十二点，第二天起床总觉得累。昨天她十点就关了电视，今天早上起床的时候觉得舒服多了。", "zh-Hant": "小安最近每天晚上看電視到十二點，第二天起牀總覺得累。昨天她十點就關了電視，今天早上起牀的時候覺得舒服多了。"}}], "glossary": []}, {"id": "C2A-M06", "title": "A destination before lunch", "section": "listening", "kind": "short-audio", "original": true, "script": [{"speaker": "male", "text": {"zh-Hans": "你现在去市场吗？", "zh-Hant": "你現在去市場嗎？"}}, {"speaker": "female", "text": {"zh-Hans": "不是，我先去图书馆还书。还完书再到对面的市场买菜，中午回家做饭。", "zh-Hant": "不是，我先去圖書館還書。還完書再到對面的市場買菜，中午回家做飯。"}}, {"speaker": "male", "text": {"zh-Hans": "那我在图书馆门口等你。", "zh-Hant": "那我在圖書館門口等你。"}}], "glossary": []}, {"id": "C2A-M07", "title": "Choosing transport", "section": "listening", "kind": "short-audio", "original": true, "script": [{"speaker": "female", "text": {"zh-Hans": "去图书馆坐地铁只要十分钟，我们坐地铁吧。", "zh-Hant": "去圖書館坐地鐵只要十分鐘，我們坐地鐵吧。"}}, {"speaker": "male", "text": {"zh-Hans": "今天地铁站不开门，还是坐公交车吧，二十分钟能到。", "zh-Hant": "今天地鐵站不開門，還是坐公交車吧，二十分鐘能到。"}}, {"speaker": "female", "text": {"zh-Hans": "好，我去车站等你。", "zh-Hant": "好，我去車站等你。"}}], "glossary": []}, {"id": "C2A-M08", "title": "After leaving the bus", "section": "listening", "kind": "short-audio", "original": true, "script": [{"speaker": "male", "text": {"zh-Hans": "从车站到图书馆怎么走？", "zh-Hant": "從車站到圖書館怎麼走？"}}, {"speaker": "female", "text": {"zh-Hans": "下车后先向右走，到第一个路口再向左。图书馆就在银行旁边，不用过马路。", "zh-Hant": "下車後先向右走，到第一個路口再向左。圖書館就在銀行旁邊，不用過馬路。"}}, {"speaker": "male", "text": {"zh-Hans": "好，我记住了。", "zh-Hant": "好，我記住了。"}}], "glossary": []}, {"id": "C2A-M09", "title": "A route with two needs", "section": "listening", "kind": "short-audio", "original": true, "script": [{"speaker": "female", "text": {"zh-Hans": "去图书馆有两条路。走河边比较近，可是没有灯；走商店那边远五分钟，但是一路都有灯。", "zh-Hant": "去圖書館有兩條路。走河邊比較近，可是沒有燈；走商店那邊遠五分鐘，但是一路都有燈。"}}, {"speaker": "male", "text": {"zh-Hans": "现在天黑了，我不着急，走商店那边吧。", "zh-Hant": "現在天黑了，我不着急，走商店那邊吧。"}}], "glossary": []}, {"id": "C2A-M10", "title": "Rain changes a plan", "section": "listening", "kind": "short-audio", "original": true, "script": [{"speaker": "male", "text": {"zh-Hans": "明天上午下雨，原来九点在公园见的活动怎么办？", "zh-Hant": "明天上午下雨，原來九點在公園見的活動怎麼辦？"}}, {"speaker": "female", "text": {"zh-Hans": "改在图书馆吧。不过图书馆十点才开门，我们十点半见。", "zh-Hant": "改在圖書館吧。不過圖書館十點纔開門，我們十點半見。"}}, {"speaker": "male", "text": {"zh-Hans": "好，就这么定了。", "zh-Hant": "好，就這麼定了。"}}], "glossary": []}, {"id": "C2A-M11", "title": "How much food", "section": "listening", "kind": "short-audio", "original": true, "script": [{"speaker": "female", "text": {"zh-Hans": "我们四个人，一人一碗面，好吗？", "zh-Hant": "我們四個人，一人一碗麪，好嗎？"}}, {"speaker": "male", "text": {"zh-Hans": "我和哥哥想吃米饭，妈妈和妹妹吃面。", "zh-Hant": "我和哥哥想喫米飯，媽媽和妹妹喫麪。"}}, {"speaker": "female", "text": {"zh-Hans": "那就两碗面、两份米饭，再点一个菜。", "zh-Hant": "那就兩碗麪、兩份米飯，再點一個菜。"}}], "glossary": []}, {"id": "C2A-M12", "title": "Choosing a size", "section": "listening", "kind": "short-audio", "original": true, "script": [{"speaker": "male", "text": {"zh-Hans": "这件小号的衣服好看，你试过了吗？", "zh-Hant": "這件小號的衣服好看，你試過了嗎？"}}, {"speaker": "female", "text": {"zh-Hans": "试过了，太小。我想买大号，颜色还是蓝色，不要红色。", "zh-Hant": "試過了，太小。我想買大號，顏色還是藍色，不要紅色。"}}, {"speaker": "male", "text": {"zh-Hans": "好，我帮你找蓝色大号。", "zh-Hant": "好，我幫你找藍色大號。"}}], "glossary": []}, {"id": "C2A-M13", "title": "The price on the order", "section": "listening", "kind": "short-audio", "original": true, "script": [{"speaker": "female", "text": {"zh-Hans": "这份午饭十五块，汤另外三块。", "zh-Hant": "這份午飯十五塊，湯另外三塊。"}}, {"speaker": "male", "text": {"zh-Hans": "我只要午饭，不要汤。给你二十块。", "zh-Hant": "我只要午飯，不要湯。給你二十塊。"}}, {"speaker": "female", "text": {"zh-Hans": "好的，午饭十五块，找你五块。", "zh-Hant": "好的，午飯十五塊，找你五塊。"}}], "glossary": []}, {"id": "C2A-M14", "title": "A suitable shared dish", "section": "listening", "kind": "short-audio", "original": true, "script": [{"speaker": "male", "text": {"zh-Hans": "小林不吃辣，小周不吃肉，晚上点什么好？", "zh-Hant": "小林不喫辣，小周不喫肉，晚上點什麼好？"}}, {"speaker": "female", "text": {"zh-Hans": "辣牛肉不行。鸡蛋面没有肉，也不辣，十八块；白菜汤虽然便宜，但大家想吃面。", "zh-Hant": "辣牛肉不行。雞蛋麪沒有肉，也不辣，十八塊；白菜湯雖然便宜，但大家想喫麪。"}}, {"speaker": "male", "text": {"zh-Hans": "那就点鸡蛋面。", "zh-Hant": "那就點雞蛋麪。"}}], "glossary": []}, {"id": "C2A-M15", "title": "After the grocery order", "section": "listening", "kind": "short-audio", "original": true, "script": [{"speaker": "female", "text": {"zh-Hans": "家里没有牛奶了，你下班后去买两瓶吧。", "zh-Hant": "家裏沒有牛奶了，你下班後去買兩瓶吧。"}}, {"speaker": "male", "text": {"zh-Hans": "我今天五点要开会，商店六点关门，恐怕来不及。", "zh-Hant": "我今天五點要開會，商店六點關門，恐怕來不及。"}}, {"speaker": "female", "text": {"zh-Hans": "那我现在去，你晚上回来洗碗就好。", "zh-Hant": "那我現在去，你晚上回來洗碗就好。"}}], "glossary": []}, {"id": "C2A-M16", "title": "The afternoon weather", "section": "listening", "kind": "short-audio", "original": true, "script": [{"speaker": "male", "text": {"zh-Hans": "今天早上有点儿冷，还下了小雨。天气预报说下午不下雨了，会出太阳，最高二十度。我们下午再去公园，不用现在出门。", "zh-Hant": "今天早上有點兒冷，還下了小雨。天氣預報說下午不下雨了，會出太陽，最高二十度。我們下午再去公園，不用現在出門。"}}], "glossary": []}, {"id": "C2A-M17", "title": "Why the activity moved", "section": "listening", "kind": "short-audio", "original": true, "script": [{"speaker": "female", "text": {"zh-Hans": "周日天气很好，为什么不在公园做活动？", "zh-Hant": "週日天氣很好，爲什麼不在公園做活動？"}}, {"speaker": "male", "text": {"zh-Hans": "公园的门坏了，周日不开。我们改在社区中心，时间还是下午两点。", "zh-Hant": "公園的門壞了，週日不開。我們改在社區中心，時間還是下午兩點。"}}, {"speaker": "female", "text": {"zh-Hans": "原来是这样。", "zh-Hant": "原來是這樣。"}}], "glossary": []}, {"id": "C2A-M18", "title": "Enough time to walk", "section": "listening", "kind": "short-audio", "original": true, "script": [{"speaker": "male", "text": {"zh-Hans": "我今天想散步，但是只能走二十分钟。", "zh-Hant": "我今天想散步，但是隻能走二十分鐘。"}}, {"speaker": "female", "text": {"zh-Hans": "去湖边来回要四十分钟，小区里的路来回十五分钟。你走完以后还可以休息一会儿。", "zh-Hant": "去湖邊來回要四十分鐘，小區裏的路來回十五分鐘。你走完以後還可以休息一會兒。"}}, {"speaker": "male", "text": {"zh-Hans": "好，就在小区里走。", "zh-Hant": "好，就在小區裏走。"}}], "glossary": []}, {"id": "C2A-M19", "title": "The order of festival activities", "section": "listening", "kind": "short-audio", "original": true, "script": [{"speaker": "female", "text": {"zh-Hans": "上周我们去社区参加春节活动。先看小朋友唱歌，再跟老师写汉字。写完字以后，大家一起吃午饭。我第一次参加这样的活动，觉得很有意思。", "zh-Hant": "上週我們去社區參加春節活動。先看小朋友唱歌，再跟老師寫漢字。寫完字以後，大家一起喫午飯。我第一次參加這樣的活動，覺得很有意思。"}}], "glossary": []}, {"id": "C2A-M20", "title": "A small sign of enjoyment", "section": "listening", "kind": "short-audio", "original": true, "script": [{"speaker": "male", "text": {"zh-Hans": "第一次去社区春节活动的时候，小雨只想待半个小时。后来活动结束了，她还在问下次什么时候再办，又告诉妹妹下次一定要一起来。", "zh-Hant": "第一次去社區春節活動的時候，小雨只想待半個小時。後來活動結束了，她還在問下次什麼時候再辦，又告訴妹妹下次一定要一起來。"}}], "glossary": []}, {"id": "C2A-M21", "title": "A note on the kitchen door", "section": "reading", "kind": "text-card", "original": true, "text": {"zh-Hans": "家务留言\n小林：我今天要带奶奶去社区中心，不能擦桌子了。请你下午把桌子擦一下，我晚上回来再洗衣服。地已经扫过，你不用再扫。谢谢！\n妈妈", "zh-Hant": "家務留言\n小林：我今天要帶奶奶去社區中心，不能擦桌子了。請你下午把桌子擦一下，我晚上回來再洗衣服。地已經掃過，你不用再掃。謝謝！\n媽媽"}, "glossary": [{"term": {"zh-Hans": "擦", "zh-Hant": "擦"}, "meaningEn": "wipe"}]}, {"id": "C2A-M22", "title": "A changed neighbourhood notice", "section": "reading", "kind": "text-card", "original": true, "text": {"zh-Hans": "社区通知\n原定星期六上午九点的做饭活动改为下午两点开始，四点结束。请一点半以后到一楼厨房，不要去二楼教室。上午厨房要打扫，不能提前使用。", "zh-Hant": "社區通知\n原定星期六上午九點的做飯活動改爲下午兩點開始，四點結束。請一點半以後到一樓廚房，不要去二樓教室。上午廚房要打掃，不能提前使用。"}, "glossary": []}, {"id": "C2A-M23", "title": "A household calendar", "section": "reading", "kind": "text-card", "original": true, "text": {"zh-Hans": "小宁家的安排\n周一、周三、周五：小宁给花浇水，每次十分钟。\n周二、周四：爸爸浇水。\n周末：妈妈浇水。\n小宁这周在家，也按这个安排做，没有和家人交换。", "zh-Hant": "小寧家的安排\n週一、週三、週五：小寧給花澆水，每次十分鐘。\n週二、週四：爸爸澆水。\n週末：媽媽澆水。\n小寧這周在家，也按這個安排做，沒有和家人交換。"}, "glossary": [{"term": {"zh-Hans": "浇水", "zh-Hant": "澆水"}, "meaningEn": "water plants"}]}, {"id": "C2A-M24", "title": "Walking before dinner", "section": "reading", "kind": "text-card", "original": true, "text": {"zh-Hans": "林安的记录\n这周下班后六点半到家，七点吃晚饭。附近的公园每天晚上六点关门，小区里的路一直可以走。林安想在晚饭前散步二十分钟，也想留十分钟休息。", "zh-Hant": "林安的記錄\n這周下班後六點半到家，七點喫晚飯。附近的公園每天晚上六點關門，小區裏的路一直可以走。林安想在晚飯前散步二十分鐘，也想留十分鐘休息。"}, "glossary": []}, {"id": "C2A-M25", "title": "An exercise diary", "section": "reading", "kind": "text-card", "original": true, "text": {"zh-Hans": "小周的运动日记\n以前我一周只运动一次，每次跑一个小时，第二天很累。从上周开始，我每周二、周四、周六各走二十分钟。三次都没有觉得累，我想下周继续这样做。", "zh-Hant": "小周的運動日記\n以前我一週只運動一次，每次跑一個小時，第二天很累。從上週開始，我每週二、週四、週六各走二十分鐘。三次都沒有覺得累，我想下週繼續這樣做。"}, "glossary": []}, {"id": "C2A-M26", "title": "A message before leaving home", "section": "reading", "kind": "text-card", "original": true, "text": {"zh-Hans": "小陈：今天先到社区中心帮忙吧，图书馆的书明天还也可以。我们在社区中心门口见。活动结束后，我再陪你去市场。别先去图书馆，我怕在那里找不到你。\n小许", "zh-Hant": "小陳：今天先到社區中心幫忙吧，圖書館的書明天還也可以。我們在社區中心門口見。活動結束後，我再陪你去市場。別先去圖書館，我怕在那裏找不到你。\n小許"}, "glossary": []}, {"id": "C2A-M27", "title": "Transport information", "section": "reading", "kind": "text-card", "original": true, "text": {"zh-Hans": "图书馆交通提醒\n本周六地铁二号线不开，去图书馆请坐十路公交车，在书店站下车。十路车每十五分钟一班。图书馆旁边没有停车的地方，请不要开车来。", "zh-Hant": "圖書館交通提醒\n本週六地鐵二號線不開，去圖書館請坐十路公交車，在書店站下車。十路車每十五分鐘一班。圖書館旁邊沒有停車的地方，請不要開車來。"}, "glossary": []}, {"id": "C2A-M28", "title": "Directions from a bus stop", "section": "reading", "kind": "text-card", "original": true, "text": {"zh-Hans": "从书店站到图书馆\n下车后，先沿着书店前面的路往左走。到第二个路口再向右，经过一家小商店就能看见图书馆。不要在第一个路口转弯，那里通向学校。", "zh-Hant": "從書店站到圖書館\n下車後，先沿着書店前面的路往左走。到第二個路口再向右，經過一家小商店就能看見圖書館。不要在第一個路口轉彎，那裏通向學校。"}, "glossary": []}, {"id": "C2A-M29", "title": "Two routes to the library", "section": "reading", "kind": "text-card", "original": true, "text": {"zh-Hans": "路线卡\n甲：走河边，十分钟到，中间没有可以坐的地方。\n乙：走商店街，二十分钟到，中间有三张长椅。\n小方今天有四十分钟空闲，想陪走路容易累的爷爷去图书馆。", "zh-Hant": "路線卡\n甲：走河邊，十分鐘到，中間沒有可以坐的地方。\n乙：走商店街，二十分鐘到，中間有三張長椅。\n小方今天有四十分鐘空閒，想陪走路容易累的爺爺去圖書館。"}, "glossary": [{"term": {"zh-Hans": "长椅", "zh-Hant": "長椅"}, "meaningEn": "bench"}]}, {"id": "C2A-M30", "title": "A notice with a new location", "section": "reading", "kind": "text-card", "original": true, "text": {"zh-Hans": "活动更新\n明天有大雨，原来上午十点在河边画画的活动改到社区中心三楼。三楼上午有课，只能下午使用，所以请大家下午一点到。画画材料不用自己带。", "zh-Hant": "活動更新\n明天有大雨，原來上午十點在河邊畫畫的活動改到社區中心三樓。三樓上午有課，只能下午使用，所以請大家下午一點到。畫畫材料不用自己帶。"}, "glossary": []}, {"id": "C2A-M31", "title": "A lunch order", "section": "reading", "kind": "text-card", "original": true, "text": {"zh-Hans": "订单确认\n米饭三份、面条一碗、青菜两份、热茶一壶。四位客人里只有小安吃面条，其他三位吃米饭。店员请大家检查数量，确认后再开始做饭。", "zh-Hant": "訂單確認\n米飯三份、麪條一碗、青菜兩份、熱茶一壺。四位客人裏只有小安喫麪條，其他三位喫米飯。店員請大家檢查數量，確認後再開始做飯。"}, "glossary": []}, {"id": "C2A-M32", "title": "A shopping message", "section": "reading", "kind": "text-card", "original": true, "text": {"zh-Hans": "小方：你上次买的白色小号围裙我试过了，做饭时太紧。这次请帮我买中号，颜色还是白色，不要黄色。店里如果没有白色中号，就先别买。\n小安", "zh-Hant": "小方：你上次買的白色小號圍裙我試過了，做飯時太緊。這次請幫我買中號，顏色還是白色，不要黃色。店裏如果沒有白色中號，就先別買。\n小安"}, "glossary": [{"term": {"zh-Hans": "围裙", "zh-Hant": "圍裙"}, "meaningEn": "apron"}]}, {"id": "C2A-M33", "title": "A meal receipt", "section": "reading", "kind": "text-card", "original": true, "text": {"zh-Hans": "午饭账单\n面条：十六元。\n青菜：六元。\n热茶：免费。\n应付：二十二元。\n客人付了三十元，店员找回八元。客人没有另外买饮料，账单已经结清。", "zh-Hant": "午飯賬單\n麪條：十六元。\n青菜：六元。\n熱茶：免費。\n應付：二十二元。\n客人付了三十元，店員找回八元。客人沒有另外買飲料，賬單已經結清。"}, "glossary": [{"term": {"zh-Hans": "账单", "zh-Hant": "賬單"}, "meaningEn": "bill"}]}, {"id": "C2A-M34", "title": "Buying enough drinks", "section": "reading", "kind": "text-card", "original": true, "text": {"zh-Hans": "采购卡\n周末四个人来家里，每人需要一瓶水。甲店四瓶八元，乙店三瓶六元，丙店四瓶十二元。小周最多带十元，只能去一家店，不想有人没有水喝。", "zh-Hant": "採購卡\n週末四個人來家裏，每人需要一瓶水。甲店四瓶八元，乙店三瓶六元，丙店四瓶十二元。小周最多帶十元，只能去一家店，不想有人沒有水喝。"}, "glossary": [{"term": {"zh-Hans": "采购", "zh-Hant": "採購"}, "meaningEn": "purchase supplies"}]}, {"id": "C2A-M35", "title": "A task before visitors arrive", "section": "reading", "kind": "text-card", "original": true, "text": {"zh-Hans": "爸爸的留言\n客人六点来，家里的杯子不够。小宁五点下课，回家路上的商店五点半关门。请小宁下课先买杯子再回家。我五点半回来做饭，买菜已经办好了。", "zh-Hant": "爸爸的留言\n客人六點來，家裏的杯子不夠。小寧五點下課，回家路上的商店五點半關門。請小寧下課先買杯子再回家。我五點半回來做飯，買菜已經辦好了。"}, "glossary": []}, {"id": "C2A-M36", "title": "A forecast for an outing", "section": "reading", "kind": "text-card", "original": true, "text": {"zh-Hans": "周六天气\n上午：多云，十八度。\n下午：下雨，十六度。\n晚上：雨停，有风。\n公园活动负责人提醒：想在外面拍照的同学请上午来，下午的活动改在室内。", "zh-Hant": "週六天氣\n上午：多雲，十八度。\n下午：下雨，十六度。\n晚上：雨停，有風。\n公園活動負責人提醒：想在外面拍照的同學請上午來，下午的活動改在室內。"}, "glossary": []}, {"id": "C2A-M37", "title": "Why the afternoon was chosen", "section": "reading", "kind": "text-card", "original": true, "text": {"zh-Hans": "小林：周日上午天气很好，我们上午去公园吧。\n小方：我上午要在家照顾弟弟，妈妈十二点才回来。下午我有空，公园也开门。\n小林：好，那下午两点在公园门口见。", "zh-Hant": "小林：週日上午天氣很好，我們上午去公園吧。\n小方：我上午要在家照顧弟弟，媽媽十二點纔回來。下午我有空，公園也開門。\n小林：好，那下午兩點在公園門口見。"}, "glossary": []}, {"id": "C2A-M38", "title": "A walk with room to rest", "section": "reading", "kind": "text-card", "original": true, "text": {"zh-Hans": "散步选择\n小安午饭后一共只有三十分钟，还想留十分钟坐着休息。公园路线要走二十五分钟，小区路线要走十五分钟。两条路都平坦，今天也都开放。", "zh-Hant": "散步選擇\n小安午飯後一共只有三十分鐘，還想留十分鐘坐着休息。公園路線要走二十五分鐘，小區路線要走十五分鐘。兩條路都平坦，今天也都開放。"}, "glossary": [{"term": {"zh-Hans": "平坦", "zh-Hant": "平坦"}, "meaningEn": "flat, even"}]}, {"id": "C2A-M39", "title": "A festival diary", "section": "reading", "kind": "text-card", "original": true, "text": {"zh-Hans": "社区春节日记\n星期日我们九点到社区中心，先跟老师做红色的小纸灯，再把灯放到门口。十点大家坐下来听故事，十一点一起包饺子。午饭后我把自己做的灯带回家了。", "zh-Hant": "社區春節日記\n星期日我們九點到社區中心，先跟老師做紅色的小紙燈，再把燈放到門口。十點大家坐下來聽故事，十一點一起包餃子。午飯後我把自己做的燈帶回家了。"}, "glossary": []}, {"id": "C2A-M40", "title": "An invitation after a first visit", "section": "reading", "kind": "text-card", "original": true, "text": {"zh-Hans": "小安的消息\n昨天第一次去社区的春节活动，我原来怕自己听不懂。回来后，我把活动照片发给朋友，还问老师下次能不能带朋友一起参加。我已经把下次活动的日期写进日历了。", "zh-Hant": "小安的消息\n昨天第一次去社區的春節活動，我原來怕自己聽不懂。回來後，我把活動照片發給朋友，還問老師下次能不能帶朋友一起參加。我已經把下次活動的日期寫進日曆了。"}, "glossary": []}], "questions": [{"id": "course-zh2-a-q01", "blueprintSlotId": "C2-L-01", "number": 1, "section": "listening", "group": "L1", "theme": "daily", "cognitiveTarget": "direct", "designDifficulty": "foundation", "materialId": "C2A-M01", "target": "identify the final household task", "promptEn": "What will the man do?", "options": {"A": {"zh-Hans": "打扫客厅", "zh-Hant": "打掃客廳"}, "B": {"zh-Hans": "洗碗", "zh-Hant": "洗碗"}, "C": {"zh-Hans": "买菜", "zh-Hant": "買菜"}}, "correctAnswer": "B", "evidence": {"materialId": "C2A-M01", "quote": {"zh-Hans": "我更想洗碗，客厅请你打扫", "zh-Hant": "我更想洗碗，客廳請你打掃"}}, "explanation": {"en": "The man proposes washing the dishes and the woman agrees.", "zh": "男生提出自己洗碗，女生同意了。"}, "distractors": {"A": {"en": "Cleaning the living room was his first assignment, then they changed it.", "zh": "打扫客厅是原先分工，后来改变了。"}, "C": {"en": "Buying groceries is not assigned.", "zh": "材料没有分配买菜任务。"}}, "languageTags": ["sequence", "frequency", "completed-action"], "reviewStatus": "author_checked_pending_independent_review"}, {"id": "course-zh2-a-q02", "blueprintSlotId": "C2-L-02", "number": 2, "section": "listening", "group": "L1", "theme": "daily", "cognitiveTarget": "direct", "designDifficulty": "foundation", "materialId": "C2A-M02", "target": "locate activity time", "promptEn": "When does the community activity begin?", "options": {"A": {"zh-Hans": "十点", "zh-Hant": "十點"}, "B": {"zh-Hans": "九点半", "zh-Hant": "九點半"}, "C": {"zh-Hans": "十二点", "zh-Hant": "十二點"}}, "correctAnswer": "A", "evidence": {"materialId": "C2A-M02", "quote": {"zh-Hans": "社区活动星期六十点开始", "zh-Hant": "社區活動星期六十點開始"}}, "explanation": {"en": "The activity begins at ten.", "zh": "活动十点开始。"}, "distractors": {"B": {"en": "Nine thirty is his departure time.", "zh": "九点半是出门时间。"}, "C": {"en": "Twelve is the finishing time.", "zh": "十二点是活动结束时间。"}}, "languageTags": ["sequence", "frequency", "completed-action"], "reviewStatus": "author_checked_pending_independent_review"}, {"id": "course-zh2-a-q03", "blueprintSlotId": "C2-L-03", "number": 3, "section": "listening", "group": "L1", "theme": "daily", "cognitiveTarget": "direct", "designDifficulty": "standard", "materialId": "C2A-M03", "target": "identify duration or frequency", "promptEn": "How often does the speaker wash dishes each week?", "options": {"A": {"zh-Hans": "两次", "zh-Hant": "兩次"}, "B": {"zh-Hans": "十次", "zh-Hant": "十次"}, "C": {"zh-Hans": "五次", "zh-Hant": "五次"}}, "correctAnswer": "C", "evidence": {"materialId": "C2A-M03", "quote": {"zh-Hans": "我每个星期洗五次", "zh-Hant": "我每個星期洗五次"}}, "explanation": {"en": "She explicitly says five times a week.", "zh": "她明确说每周洗五次。"}, "distractors": {"A": {"en": "Two refers to the days her father takes over.", "zh": "两天是爸爸接手家务的周末。"}, "B": {"en": "Ten is the number of minutes per occasion.", "zh": "十是每次所需的分钟数。"}}, "languageTags": ["sequence", "frequency", "completed-action"], "reviewStatus": "author_checked_pending_independent_review"}, {"id": "course-zh2-a-q04", "blueprintSlotId": "C2-L-04", "number": 4, "section": "listening", "group": "L1", "theme": "health", "cognitiveTarget": "integrate", "designDifficulty": "standard", "materialId": "C2A-M04", "target": "combine routine and availability", "promptEn": "Which walking plan fits the woman’s work schedule?", "options": {"A": {"zh-Hans": "七点到七点半", "zh-Hant": "七點到七點半"}, "B": {"zh-Hans": "六点到六点半", "zh-Hant": "六點到六點半"}, "C": {"zh-Hans": "七点到八点", "zh-Hant": "七點到八點"}}, "correctAnswer": "A", "evidence": {"materialId": "C2A-M04", "quote": {"zh-Hans": "七点才下班。我想下班后走半个小时", "zh-Hant": "七點才下班。我想下班後走半個小時"}}, "explanation": {"en": "She finishes at seven and wants a half-hour walk.", "zh": "七点下班，走半小时，到七点半。"}, "distractors": {"B": {"en": "She has a meeting at six.", "zh": "六点她要开会。"}, "C": {"en": "An hour is longer than her stated half hour.", "zh": "七点到八点是一小时，不是半小时。"}}, "languageTags": ["duration", "simple-advice"], "reviewStatus": "author_checked_pending_independent_review"}, {"id": "course-zh2-a-q05", "blueprintSlotId": "C2-L-05", "number": 5, "section": "listening", "group": "L1", "theme": "health", "cognitiveTarget": "infer", "designDifficulty": "stretch", "materialId": "C2A-M05", "target": "infer one supported lifestyle choice", "promptEn": "Which change is supported by Xiao’an’s experience?", "options": {"A": {"zh-Hans": "每天晚些起床", "zh-Hant": "每天晚些起牀"}, "B": {"zh-Hans": "晚上早点休息", "zh-Hant": "晚上早點休息"}, "C": {"zh-Hans": "每天多看电视", "zh-Hant": "每天多看電視"}}, "correctAnswer": "B", "evidence": {"materialId": "C2A-M05", "quote": {"zh-Hans": "昨天她十点就关了电视，今天早上起床的时候觉得舒服多了", "zh-Hant": "昨天她十點就關了電視，今天早上起牀的時候覺得舒服多了"}}, "explanation": {"en": "Her reported improvement follows an earlier end to the evening; resting earlier fits that evidence.", "zh": "早点结束晚间活动后感觉改善，支持早点休息。"}, "distractors": {"A": {"en": "The source does not say she changed her waking time.", "zh": "材料没有说改变起床时间。"}, "C": {"en": "More television is contrary to the change associated with feeling better.", "zh": "感觉改善对应的是早点关电视，不是多看。"}}, "languageTags": ["duration", "simple-advice"], "reviewStatus": "author_checked_pending_independent_review"}, {"id": "course-zh2-a-q06", "blueprintSlotId": "C2-L-06", "number": 6, "section": "listening", "group": "L2", "theme": "travel", "cognitiveTarget": "direct", "designDifficulty": "foundation", "materialId": "C2A-M06", "target": "locate destination", "promptEn": "Where will the woman go first?", "options": {"A": {"zh-Hans": "市场", "zh-Hant": "市場"}, "B": {"zh-Hans": "家里", "zh-Hant": "家裏"}, "C": {"zh-Hans": "图书馆", "zh-Hant": "圖書館"}}, "correctAnswer": "C", "evidence": {"materialId": "C2A-M06", "quote": {"zh-Hans": "我先去图书馆还书", "zh-Hant": "我先去圖書館還書"}}, "explanation": {"en": "She first goes to the library to return books.", "zh": "她先去图书馆还书。"}, "distractors": {"A": {"en": "The market comes after the library.", "zh": "市场在图书馆之后去。"}, "B": {"en": "She returns home at midday, after the errands.", "zh": "中午办完事后才回家。"}}, "languageTags": ["direction", "comparison", "sequence"], "reviewStatus": "author_checked_pending_independent_review"}, {"id": "course-zh2-a-q07", "blueprintSlotId": "C2-L-07", "number": 7, "section": "listening", "group": "L2", "theme": "travel", "cognitiveTarget": "direct", "designDifficulty": "foundation", "materialId": "C2A-M07", "target": "identify transport choice", "promptEn": "How will they get to the library?", "options": {"A": {"zh-Hans": "坐公交车", "zh-Hant": "坐公交車"}, "B": {"zh-Hans": "坐地铁", "zh-Hant": "坐地鐵"}, "C": {"zh-Hans": "走路", "zh-Hant": "走路"}}, "correctAnswer": "A", "evidence": {"materialId": "C2A-M07", "quote": {"zh-Hans": "还是坐公交车吧，二十分钟能到", "zh-Hant": "還是坐公交車吧，二十分鐘能到"}}, "explanation": {"en": "The final accepted choice is the bus.", "zh": "最后同意坐公交车。"}, "distractors": {"B": {"en": "The subway is the rejected initial proposal because the station is closed.", "zh": "地铁是最初建议，但站点不开门。"}, "C": {"en": "Walking is not their agreed method.", "zh": "双方没有约定走路。"}}, "languageTags": ["direction", "comparison", "sequence"], "reviewStatus": "author_checked_pending_independent_review"}, {"id": "course-zh2-a-q08", "blueprintSlotId": "C2-L-08", "number": 8, "section": "listening", "group": "L2", "theme": "travel", "cognitiveTarget": "direct", "designDifficulty": "standard", "materialId": "C2A-M08", "target": "identify route step", "promptEn": "What should the man do just after getting off the bus?", "options": {"A": {"zh-Hans": "向左走", "zh-Hant": "向左走"}, "B": {"zh-Hans": "向右走", "zh-Hant": "向右走"}, "C": {"zh-Hans": "过马路", "zh-Hant": "過馬路"}}, "correctAnswer": "B", "evidence": {"materialId": "C2A-M08", "quote": {"zh-Hans": "下车后先向右走", "zh-Hant": "下車後先向右走"}}, "explanation": {"en": "The first step is to walk right.", "zh": "下车后的第一步是向右走。"}, "distractors": {"A": {"en": "Turning left happens at the first intersection later.", "zh": "向左是在之后到达第一个路口时。"}, "C": {"en": "He is told that crossing the road is unnecessary.", "zh": "材料明确说不用过马路。"}}, "languageTags": ["direction", "comparison", "sequence"], "reviewStatus": "author_checked_pending_independent_review"}, {"id": "course-zh2-a-q09", "blueprintSlotId": "C2-L-09", "number": 9, "section": "listening", "group": "L2", "theme": "travel", "cognitiveTarget": "integrate", "designDifficulty": "standard", "materialId": "C2A-M09", "target": "compare two route constraints", "promptEn": "Which route meets the man’s stated needs tonight?", "options": {"A": {"zh-Hans": "河边的路", "zh-Hant": "河邊的路"}, "B": {"zh-Hans": "两条路都不走", "zh-Hant": "兩條路都不走"}, "C": {"zh-Hans": "商店那边的路", "zh-Hant": "商店那邊的路"}}, "correctAnswer": "C", "evidence": {"materialId": "C2A-M09", "quote": {"zh-Hans": "走商店那边远五分钟，但是一路都有灯", "zh-Hant": "走商店那邊遠五分鐘，但是一路都有燈"}}, "explanation": {"en": "It is dark, he has time, and the shop route has lights.", "zh": "天黑又不着急，有灯的商店路线符合条件。"}, "distractors": {"A": {"en": "The river route is shorter but unlit.", "zh": "河边近但没有灯，不符合晚上的选择依据。"}, "B": {"en": "He chooses a route rather than cancelling the trip.", "zh": "男生已经选择路线，没有取消出行。"}}, "languageTags": ["direction", "comparison", "sequence"], "reviewStatus": "author_checked_pending_independent_review"}, {"id": "course-zh2-a-q10", "blueprintSlotId": "C2-L-10", "number": 10, "section": "listening", "group": "L2", "theme": "weather", "cognitiveTarget": "integrate", "designDifficulty": "standard", "materialId": "C2A-M10", "target": "select the final plan after a stated change", "promptEn": "What is the final meeting arrangement?", "options": {"A": {"zh-Hans": "九点在公园", "zh-Hant": "九點在公園"}, "B": {"zh-Hans": "十点半在图书馆", "zh-Hant": "十點半在圖書館"}, "C": {"zh-Hans": "十点在公园", "zh-Hant": "十點在公園"}}, "correctAnswer": "B", "evidence": {"materialId": "C2A-M10", "quote": {"zh-Hans": "改在图书馆吧。不过图书馆十点才开门，我们十点半见", "zh-Hant": "改在圖書館吧。不過圖書館十點纔開門，我們十點半見"}}, "explanation": {"en": "They change both the place and meeting time to ten thirty at the library.", "zh": "地点改为图书馆，见面时间改为十点半。"}, "distractors": {"A": {"en": "Nine in the park is the original arrangement replaced because of rain.", "zh": "九点公园见是因下雨而改变的原安排。"}, "C": {"en": "Ten is opening time, and the park is no longer the location.", "zh": "十点是图书馆开门时间，地点也不是公园。"}}, "languageTags": ["cause", "revised-plan"], "reviewStatus": "author_checked_pending_independent_review"}, {"id": "course-zh2-a-q11", "blueprintSlotId": "C2-L-11", "number": 11, "section": "listening", "group": "L3", "theme": "dining-shopping", "cognitiveTarget": "direct", "designDifficulty": "foundation", "materialId": "C2A-M11", "target": "identify order quantity", "promptEn": "How many bowls of noodles will they order?", "options": {"A": {"zh-Hans": "两碗", "zh-Hant": "兩碗"}, "B": {"zh-Hans": "四碗", "zh-Hant": "四碗"}, "C": {"zh-Hans": "一碗", "zh-Hant": "一碗"}}, "correctAnswer": "A", "evidence": {"materialId": "C2A-M11", "quote": {"zh-Hans": "那就两碗面、两份米饭", "zh-Hant": "那就兩碗麪、兩份米飯"}}, "explanation": {"en": "The final order contains two bowls of noodles.", "zh": "最后点两碗面。"}, "distractors": {"B": {"en": "Four was the earlier proposal for all four people.", "zh": "四碗是原先让四个人都吃面的建议。"}, "C": {"en": "One is the number of additional dishes, not bowls of noodles.", "zh": "一个指另外点的菜，不是面的数量。"}}, "languageTags": ["quantity", "choice", "comparison"], "reviewStatus": "author_checked_pending_independent_review"}, {"id": "course-zh2-a-q12", "blueprintSlotId": "C2-L-12", "number": 12, "section": "listening", "group": "L3", "theme": "dining-shopping", "cognitiveTarget": "direct", "designDifficulty": "foundation", "materialId": "C2A-M12", "target": "identify size or stated preference", "promptEn": "Which item does the woman want?", "options": {"A": {"zh-Hans": "蓝色小号", "zh-Hant": "藍色小號"}, "B": {"zh-Hans": "红色大号", "zh-Hant": "紅色大號"}, "C": {"zh-Hans": "蓝色大号", "zh-Hant": "藍色大號"}}, "correctAnswer": "C", "evidence": {"materialId": "C2A-M12", "quote": {"zh-Hans": "我想买大号，颜色还是蓝色，不要红色", "zh-Hant": "我想買大號，顏色還是藍色，不要紅色"}}, "explanation": {"en": "She wants the large size in blue.", "zh": "她要蓝色大号。"}, "distractors": {"A": {"en": "The small blue item is too small.", "zh": "蓝色小号已经试过，太小。"}, "B": {"en": "She explicitly rejects red.", "zh": "她明确不要红色。"}}, "languageTags": ["quantity", "choice", "comparison"], "reviewStatus": "author_checked_pending_independent_review"}, {"id": "course-zh2-a-q13", "blueprintSlotId": "C2-L-13", "number": 13, "section": "listening", "group": "L3", "theme": "dining-shopping", "cognitiveTarget": "direct", "designDifficulty": "standard", "materialId": "C2A-M13", "target": "identify stated price or total", "promptEn": "How much does the man’s order cost?", "options": {"A": {"zh-Hans": "十八块", "zh-Hant": "十八塊"}, "B": {"zh-Hans": "十五块", "zh-Hant": "十五塊"}, "C": {"zh-Hans": "二十块", "zh-Hant": "二十塊"}}, "correctAnswer": "B", "evidence": {"materialId": "C2A-M13", "quote": {"zh-Hans": "午饭十五块，找你五块", "zh-Hant": "午飯十五塊，找你五塊"}}, "explanation": {"en": "His meal costs fifteen; he does not order soup.", "zh": "他只买十五块的午饭，没有要汤。"}, "distractors": {"A": {"en": "Eighteen would include the soup he declined.", "zh": "十八块包含他不要的汤。"}, "C": {"en": "Twenty is the money handed over, not the bill.", "zh": "二十块是付出的金额，不是账单。"}}, "languageTags": ["quantity", "choice", "comparison"], "reviewStatus": "author_checked_pending_independent_review"}, {"id": "course-zh2-a-q14", "blueprintSlotId": "C2-L-14", "number": 14, "section": "listening", "group": "L3", "theme": "dining-shopping", "cognitiveTarget": "integrate", "designDifficulty": "standard", "materialId": "C2A-M14", "target": "choose an option satisfying two needs", "promptEn": "Which dish meets both guests’ food requirements?", "options": {"A": {"zh-Hans": "鸡蛋面", "zh-Hant": "雞蛋麪"}, "B": {"zh-Hans": "辣牛肉", "zh-Hant": "辣牛肉"}, "C": {"zh-Hans": "白菜汤", "zh-Hant": "白菜湯"}}, "correctAnswer": "A", "evidence": {"materialId": "C2A-M14", "quote": {"zh-Hans": "鸡蛋面没有肉，也不辣", "zh-Hant": "雞蛋麪沒有肉，也不辣"}}, "explanation": {"en": "Egg noodles satisfy both no-meat and no-spice needs and match the preference for noodles.", "zh": "鸡蛋面既不辣又没有肉，也符合想吃面的偏好。"}, "distractors": {"B": {"en": "Spicy beef violates both stated requirements.", "zh": "辣牛肉同时不符合不辣和不吃肉的要求。"}, "C": {"en": "Cabbage soup does not match the stated desire for noodles.", "zh": "白菜汤不符合大家想吃面的要求。"}}, "languageTags": ["quantity", "choice", "comparison"], "reviewStatus": "author_checked_pending_independent_review"}, {"id": "course-zh2-a-q15", "blueprintSlotId": "C2-L-15", "number": 15, "section": "listening", "group": "L3", "theme": "daily", "cognitiveTarget": "integrate", "designDifficulty": "standard", "materialId": "C2A-M15", "target": "combine a household request and availability", "promptEn": "What is the man’s final household job this evening?", "options": {"A": {"zh-Hans": "下班后买牛奶", "zh-Hant": "下班後買牛奶"}, "B": {"zh-Hans": "现在去商店", "zh-Hant": "現在去商店"}, "C": {"zh-Hans": "洗碗", "zh-Hant": "洗碗"}}, "correctAnswer": "C", "evidence": {"materialId": "C2A-M15", "quote": {"zh-Hans": "那我现在去，你晚上回来洗碗就好", "zh-Hant": "那我現在去，你晚上回來洗碗就好"}}, "explanation": {"en": "The final reassignment is for him to wash dishes after returning.", "zh": "最后分工是男生回来洗碗。"}, "distractors": {"A": {"en": "The purchase request is reassigned because of his meeting and closing time.", "zh": "买牛奶因开会和关门时间被重新分配。"}, "B": {"en": "The woman says she will go now.", "zh": "现在去商店的是女生。"}}, "languageTags": ["sequence", "frequency", "completed-action"], "reviewStatus": "author_checked_pending_independent_review"}, {"id": "course-zh2-a-q16", "blueprintSlotId": "C2-L-16", "number": 16, "section": "listening", "group": "L4", "theme": "weather", "cognitiveTarget": "direct", "designDifficulty": "foundation", "materialId": "C2A-M16", "target": "identify a weather change", "promptEn": "What weather is expected this afternoon?", "options": {"A": {"zh-Hans": "晴天", "zh-Hant": "晴天"}, "B": {"zh-Hans": "继续下雨", "zh-Hant": "繼續下雨"}, "C": {"zh-Hans": "下雪", "zh-Hant": "下雪"}}, "correctAnswer": "A", "evidence": {"materialId": "C2A-M16", "quote": {"zh-Hans": "下午不下雨了，会出太阳", "zh-Hant": "下午不下雨了，會出太陽"}}, "explanation": {"en": "The forecast says the sun will come out in the afternoon.", "zh": "预报说下午会出太阳。"}, "distractors": {"B": {"en": "Rain belongs to the morning, not the afternoon forecast.", "zh": "下雨是早上的情况，不是下午预报。"}, "C": {"en": "Snow is not forecast.", "zh": "材料没有预报下雪。"}}, "languageTags": ["cause", "revised-plan"], "reviewStatus": "author_checked_pending_independent_review"}, {"id": "course-zh2-a-q17", "blueprintSlotId": "C2-L-17", "number": 17, "section": "listening", "group": "L4", "theme": "weather", "cognitiveTarget": "direct", "designDifficulty": "foundation", "materialId": "C2A-M17", "target": "identify an explicit activity reason", "promptEn": "Why was the activity moved to the community centre?", "options": {"A": {"zh-Hans": "周日会下雨", "zh-Hant": "週日會下雨"}, "B": {"zh-Hans": "公园周日不开", "zh-Hant": "公園週日不開"}, "C": {"zh-Hans": "大家上午没空", "zh-Hant": "大家上午沒空"}}, "correctAnswer": "B", "evidence": {"materialId": "C2A-M17", "quote": {"zh-Hans": "公园的门坏了，周日不开", "zh-Hant": "公園的門壞了，週日不開"}}, "explanation": {"en": "The park is closed on Sunday because of the broken gate.", "zh": "公园因门坏了周日不开。"}, "distractors": {"A": {"en": "The woman says the weather will be good.", "zh": "女生说天气很好，没有下雨的原因。"}, "C": {"en": "The move is not attributed to anyone being busy in the morning.", "zh": "材料没有以大家上午忙解释改地点。"}}, "languageTags": ["cause", "revised-plan"], "reviewStatus": "author_checked_pending_independent_review"}, {"id": "course-zh2-a-q18", "blueprintSlotId": "C2-L-18", "number": 18, "section": "listening", "group": "L4", "theme": "health", "cognitiveTarget": "direct", "designDifficulty": "standard", "materialId": "C2A-M18", "target": "combine activity and health constraint", "promptEn": "Which walk fits the man’s available time?", "options": {"A": {"zh-Hans": "湖边来回四十分钟", "zh-Hant": "湖邊來回四十分鐘"}, "B": {"zh-Hans": "两个地方都走一遍", "zh-Hant": "兩個地方都走一遍"}, "C": {"zh-Hans": "小区里来回十五分钟", "zh-Hant": "小區裏來回十五分鐘"}}, "correctAnswer": "C", "evidence": {"materialId": "C2A-M18", "quote": {"zh-Hans": "我今天想散步，但是只能走二十分钟。", "zh-Hant": "我今天想散步，但是隻能走二十分鐘。"}}, "explanation": {"en": "The fifteen-minute neighbourhood walk fits within twenty minutes.", "zh": "小区十五分钟的来回路线在二十分钟以内。"}, "distractors": {"A": {"en": "Forty minutes exceeds his limit.", "zh": "四十分钟超过他的时间。"}, "B": {"en": "Doing both would exceed the limit too.", "zh": "两条都走也超过时间。"}}, "languageTags": ["duration", "simple-advice"], "reviewStatus": "author_checked_pending_independent_review"}, {"id": "course-zh2-a-q19", "blueprintSlotId": "C2-L-19", "number": 19, "section": "listening", "group": "L4", "theme": "festival", "cognitiveTarget": "integrate", "designDifficulty": "standard", "materialId": "C2A-M19", "target": "order two stated event steps", "promptEn": "What did the group do immediately after watching the singing?", "options": {"A": {"zh-Hans": "跟老师写汉字", "zh-Hant": "跟老師寫漢字"}, "B": {"zh-Hans": "一起吃午饭", "zh-Hant": "一起喫午飯"}, "C": {"zh-Hans": "先回家", "zh-Hant": "先回家"}}, "correctAnswer": "A", "evidence": {"materialId": "C2A-M19", "quote": {"zh-Hans": "先看小朋友唱歌，再跟老师写汉字", "zh-Hant": "先看小朋友唱歌，再跟老師寫漢字"}}, "explanation": {"en": "Writing characters follows the singing.", "zh": "唱歌后紧接着跟老师写字。"}, "distractors": {"B": {"en": "Lunch is after writing, not immediately after singing.", "zh": "午饭在写字之后。"}, "C": {"en": "Going home is not the next stated step.", "zh": "材料没有说之后先回家。"}}, "languageTags": ["experience", "sequence", "feeling"], "reviewStatus": "author_checked_pending_independent_review"}, {"id": "course-zh2-a-q20", "blueprintSlotId": "C2-L-20", "number": 20, "section": "listening", "group": "L4", "theme": "festival", "cognitiveTarget": "infer", "designDifficulty": "stretch", "materialId": "C2A-M20", "target": "infer a feeling from stated evidence", "promptEn": "What can we infer about Xiaoyu’s view of the activity?", "options": {"A": {"zh-Hans": "她一直不想参加", "zh-Hant": "她一直不想參加"}, "B": {"zh-Hans": "她后来很喜欢这个活动", "zh-Hant": "她後來很喜歡這個活動"}, "C": {"zh-Hans": "她只想知道回家的路", "zh-Hant": "她只想知道回家的路"}}, "correctAnswer": "B", "evidence": {"materialId": "C2A-M20", "quote": {"zh-Hans": "还在问下次什么时候再办，又告诉妹妹下次一定要一起来", "zh-Hant": "還在問下次什麼時候再辦，又告訴妹妹下次一定要一起來"}}, "explanation": {"en": "Asking to return and inviting her sister support enjoyment after her initial hesitation.", "zh": "问下一次并邀请妹妹，支持后来喜欢活动的推断。"}, "distractors": {"A": {"en": "Her later behaviour contradicts continuing unwillingness.", "zh": "后来的表现不支持一直不想参加。"}, "C": {"en": "Her questions concern a future event, not a route home.", "zh": "她问的是下次活动，不是回家路线。"}}, "languageTags": ["experience", "sequence", "feeling"], "reviewStatus": "author_checked_pending_independent_review"}, {"id": "course-zh2-a-q21", "blueprintSlotId": "C2-R-01", "number": 21, "section": "reading", "group": "R1", "theme": "daily", "cognitiveTarget": "direct", "designDifficulty": "foundation", "materialId": "C2A-M21", "target": "identify the final household task", "promptEn": "What does the mother ask Xiaolin to do?", "options": {"A": {"zh-Hans": "擦桌子", "zh-Hant": "擦桌子"}, "B": {"zh-Hans": "洗衣服", "zh-Hant": "洗衣服"}, "C": {"zh-Hans": "扫地", "zh-Hant": "掃地"}}, "correctAnswer": "A", "evidence": {"materialId": "C2A-M21", "quote": {"zh-Hans": "请你下午把桌子擦一下", "zh-Hant": "請你下午把桌子擦一下"}}, "explanation": {"en": "The request to Xiaolin is to wipe the table.", "zh": "妈妈请小林擦桌子。"}, "distractors": {"B": {"en": "The mother will wash clothes herself that evening.", "zh": "洗衣服是妈妈晚上回来的安排。"}, "C": {"en": "The floor has already been swept and needs no repeat.", "zh": "地已经扫过，明确不用再扫。"}}, "languageTags": ["sequence", "frequency", "completed-action"], "reviewStatus": "author_checked_pending_independent_review"}, {"id": "course-zh2-a-q22", "blueprintSlotId": "C2-R-02", "number": 22, "section": "reading", "group": "R1", "theme": "daily", "cognitiveTarget": "direct", "designDifficulty": "foundation", "materialId": "C2A-M22", "target": "locate activity time", "promptEn": "When does the cooking activity now begin?", "options": {"A": {"zh-Hans": "上午九点", "zh-Hant": "上午九點"}, "B": {"zh-Hans": "下午两点", "zh-Hant": "下午兩點"}, "C": {"zh-Hans": "下午一点半", "zh-Hant": "下午一點半"}}, "correctAnswer": "B", "evidence": {"materialId": "C2A-M22", "quote": {"zh-Hans": "改为下午两点开始", "zh-Hant": "改爲下午兩點開始"}}, "explanation": {"en": "Two in the afternoon is the new starting time.", "zh": "新的开始时间是下午两点。"}, "distractors": {"A": {"en": "Nine was the original time, now replaced.", "zh": "上午九点是被更改的原时间。"}, "C": {"en": "One thirty is the earliest arrival time, not the start.", "zh": "一点半是可以到场的时间，不是开始时间。"}}, "languageTags": ["sequence", "frequency", "completed-action"], "reviewStatus": "author_checked_pending_independent_review"}, {"id": "course-zh2-a-q23", "blueprintSlotId": "C2-R-03", "number": 23, "section": "reading", "group": "R1", "theme": "daily", "cognitiveTarget": "direct", "designDifficulty": "standard", "materialId": "C2A-M23", "target": "identify duration or frequency", "promptEn": "How many times will Xiaoning water the plants this week?", "options": {"A": {"zh-Hans": "两次", "zh-Hant": "兩次"}, "B": {"zh-Hans": "五次", "zh-Hant": "五次"}, "C": {"zh-Hans": "三次", "zh-Hant": "三次"}}, "correctAnswer": "C", "evidence": {"materialId": "C2A-M23", "quote": {"zh-Hans": "周一、周三、周五：小宁给花浇水", "zh-Hant": "週一、週三、週五：小寧給花澆水"}}, "explanation": {"en": "Monday, Wednesday and Friday make three occasions.", "zh": "周一、三、五共三次。"}, "distractors": {"A": {"en": "Two is the father’s weekday allocation.", "zh": "两次是爸爸的安排。"}, "B": {"en": "Five combines the child’s and father’s weekdays.", "zh": "五次把小宁和爸爸的工作日都加上了。"}}, "languageTags": ["sequence", "frequency", "completed-action"], "reviewStatus": "author_checked_pending_independent_review"}, {"id": "course-zh2-a-q24", "blueprintSlotId": "C2-R-04", "number": 24, "section": "reading", "group": "R1", "theme": "health", "cognitiveTarget": "integrate", "designDifficulty": "standard", "materialId": "C2A-M24", "target": "combine routine and availability", "promptEn": "Which walk fits Lin An’s time and the opening information?", "options": {"A": {"zh-Hans": "六点半到六点五十分在公园走", "zh-Hant": "六點半到六點五十分在公園走"}, "B": {"zh-Hans": "六点半到六点五十分在小区走", "zh-Hant": "六點半到六點五十分在小區走"}, "C": {"zh-Hans": "六点半到七点十分在小区走", "zh-Hant": "六點半到七點十分在小區走"}}, "correctAnswer": "B", "evidence": {"materialId": "C2A-M24", "quote": {"zh-Hans": "六点半到家，七点吃晚饭", "zh-Hant": "六點半到家，七點喫晚飯"}}, "explanation": {"en": "The neighbourhood is open; a twenty-minute walk leaves ten minutes before dinner.", "zh": "小区可以走，走二十分钟后还剩十分钟到晚饭。"}, "distractors": {"A": {"en": "The park is already closed when Lin An gets home.", "zh": "六点半到家时公园已经关门。"}, "C": {"en": "This walk lasts forty minutes and extends past dinner time.", "zh": "该路线四十分钟，超过七点晚饭时间。"}}, "languageTags": ["duration", "simple-advice"], "reviewStatus": "author_checked_pending_independent_review"}, {"id": "course-zh2-a-q25", "blueprintSlotId": "C2-R-05", "number": 25, "section": "reading", "group": "R1", "theme": "health", "cognitiveTarget": "infer", "designDifficulty": "stretch", "materialId": "C2A-M25", "target": "infer one supported lifestyle choice", "promptEn": "Which plan does Xiaozhou’s diary support continuing?", "options": {"A": {"zh-Hans": "每周走三次，每次二十分钟", "zh-Hant": "每週走三次，每次二十分鐘"}, "B": {"zh-Hans": "每次跑一个小时", "zh-Hant": "每次跑一個小時"}, "C": {"zh-Hans": "一周完全不运动", "zh-Hant": "一週完全不運動"}}, "correctAnswer": "A", "evidence": {"materialId": "C2A-M25", "quote": {"zh-Hans": "每周二、周四、周六各走二十分钟。三次都没有觉得累", "zh-Hant": "每週二、週四、週六各走二十分鐘。三次都沒有覺得累"}}, "explanation": {"en": "The new three-short-walk pattern is comfortable and is what the writer wants to repeat.", "zh": "三次短走后不累，作者想继续这个安排。"}, "distractors": {"B": {"en": "The earlier hour-long run left the writer tired.", "zh": "过去跑一小时后第二天很累。"}, "C": {"en": "The writer wants to continue activity, not stop it.", "zh": "作者想继续运动，不是完全停止。"}}, "languageTags": ["duration", "simple-advice"], "reviewStatus": "author_checked_pending_independent_review"}, {"id": "course-zh2-a-q26", "blueprintSlotId": "C2-R-06", "number": 26, "section": "reading", "group": "R2", "theme": "travel", "cognitiveTarget": "direct", "designDifficulty": "foundation", "materialId": "C2A-M26", "target": "locate destination", "promptEn": "Where should Xiaochen go first?", "options": {"A": {"zh-Hans": "图书馆", "zh-Hant": "圖書館"}, "B": {"zh-Hans": "市场", "zh-Hant": "市場"}, "C": {"zh-Hans": "社区中心", "zh-Hant": "社區中心"}}, "correctAnswer": "C", "evidence": {"materialId": "C2A-M26", "quote": {"zh-Hans": "今天先到社区中心帮忙吧", "zh-Hant": "今天先到社區中心幫忙吧"}}, "explanation": {"en": "The message explicitly says to go first to the community centre.", "zh": "留言明确要求先到社区中心。"}, "distractors": {"A": {"en": "The library visit can wait until tomorrow.", "zh": "图书馆还书可以等明天。"}, "B": {"en": "The market visit follows the activity.", "zh": "市场在活动结束后才去。"}}, "languageTags": ["direction", "comparison", "sequence"], "reviewStatus": "author_checked_pending_independent_review"}, {"id": "course-zh2-a-q27", "blueprintSlotId": "C2-R-07", "number": 27, "section": "reading", "group": "R2", "theme": "travel", "cognitiveTarget": "direct", "designDifficulty": "foundation", "materialId": "C2A-M27", "target": "identify transport choice", "promptEn": "Which transport does the notice ask visitors to use?", "options": {"A": {"zh-Hans": "地铁二号线", "zh-Hant": "地鐵二號線"}, "B": {"zh-Hans": "十路公交车", "zh-Hant": "十路公交車"}, "C": {"zh-Hans": "自己开车", "zh-Hant": "自己開車"}}, "correctAnswer": "B", "evidence": {"materialId": "C2A-M27", "quote": {"zh-Hans": "去图书馆请坐十路公交车", "zh-Hant": "去圖書館請坐十路公交車"}}, "explanation": {"en": "The instruction is to take bus number ten.", "zh": "通知要求坐十路公交车。"}, "distractors": {"A": {"en": "Subway line two is not running that Saturday.", "zh": "周六地铁二号线不开。"}, "C": {"en": "Drivers are asked not to come by car because there is no parking.", "zh": "没有停车的地方，通知请大家不要开车。"}}, "languageTags": ["direction", "comparison", "sequence"], "reviewStatus": "author_checked_pending_independent_review"}, {"id": "course-zh2-a-q28", "blueprintSlotId": "C2-R-08", "number": 28, "section": "reading", "group": "R2", "theme": "travel", "cognitiveTarget": "direct", "designDifficulty": "standard", "materialId": "C2A-M28", "target": "identify route step", "promptEn": "What is the first direction after leaving the bus?", "options": {"A": {"zh-Hans": "往左走", "zh-Hant": "往左走"}, "B": {"zh-Hans": "在第一个路口右转", "zh-Hant": "在第一個路口右轉"}, "C": {"zh-Hans": "先走进学校", "zh-Hant": "先走進學校"}}, "correctAnswer": "A", "evidence": {"materialId": "C2A-M28", "quote": {"zh-Hans": "下车后，先沿着书店前面的路往左走", "zh-Hant": "下車後，先沿着書店前面的路往左走"}}, "explanation": {"en": "The first instruction is to walk left.", "zh": "第一步是往左走。"}, "distractors": {"B": {"en": "The notice explicitly says not to turn at the first intersection.", "zh": "通知明确说不要在第一个路口转弯。"}, "C": {"en": "The school is a wrong destination off that first intersection.", "zh": "学校是第一个路口通向的地方，不是先去的目的地。"}}, "languageTags": ["direction", "comparison", "sequence"], "reviewStatus": "author_checked_pending_independent_review"}, {"id": "course-zh2-a-q29", "blueprintSlotId": "C2-R-09", "number": 29, "section": "reading", "group": "R2", "theme": "travel", "cognitiveTarget": "integrate", "designDifficulty": "standard", "materialId": "C2A-M29", "target": "compare two route constraints", "promptEn": "Which route best fits Xiaofang’s stated situation?", "options": {"A": {"zh-Hans": "甲，河边", "zh-Hant": "甲，河邊"}, "B": {"zh-Hans": "两条都一定来不及", "zh-Hant": "兩條都一定來不及"}, "C": {"zh-Hans": "乙，商店街", "zh-Hant": "乙，商店街"}}, "correctAnswer": "C", "evidence": {"materialId": "C2A-M29", "quote": {"zh-Hans": "乙：走商店街，二十分钟到，中间有三张长椅", "zh-Hant": "乙：走商店街，二十分鐘到，中間有三張長椅"}}, "explanation": {"en": "The shop route fits the available time and offers places for the grandfather to rest.", "zh": "商店街二十分钟在可用时间内，也有地方让爷爷休息。"}, "distractors": {"A": {"en": "The shorter route has no resting places for the stated need.", "zh": "河边虽近，却没有符合需要的休息位置。"}, "B": {"en": "Both listed one-way travel times are below forty minutes.", "zh": "两条所列单程时间都少于四十分钟，不能说一定来不及。"}}, "languageTags": ["direction", "comparison", "sequence"], "reviewStatus": "author_checked_pending_independent_review"}, {"id": "course-zh2-a-q30", "blueprintSlotId": "C2-R-10", "number": 30, "section": "reading", "group": "R2", "theme": "weather", "cognitiveTarget": "integrate", "designDifficulty": "standard", "materialId": "C2A-M30", "target": "select the final plan after a stated change", "promptEn": "What is the updated time and place?", "options": {"A": {"zh-Hans": "下午一点，社区中心三楼", "zh-Hant": "下午一點，社區中心三樓"}, "B": {"zh-Hans": "上午十点，河边", "zh-Hant": "上午十點，河邊"}, "C": {"zh-Hans": "上午十点，社区中心三楼", "zh-Hant": "上午十點，社區中心三樓"}}, "correctAnswer": "A", "evidence": {"materialId": "C2A-M30", "quote": {"zh-Hans": "所以请大家下午一点到", "zh-Hant": "所以請大家下午一點到"}}, "explanation": {"en": "Rain moves the event indoors, and the morning class means it starts at one.", "zh": "因大雨改到三楼，又因上午有课改为下午一点。"}, "distractors": {"B": {"en": "This is the original outdoor arrangement.", "zh": "这是原来的户外安排。"}, "C": {"en": "The third floor is occupied by a class in the morning.", "zh": "三楼上午有课，不能十点使用。"}}, "languageTags": ["cause", "revised-plan"], "reviewStatus": "author_checked_pending_independent_review"}, {"id": "course-zh2-a-q31", "blueprintSlotId": "C2-R-11", "number": 31, "section": "reading", "group": "R3", "theme": "dining-shopping", "cognitiveTarget": "direct", "designDifficulty": "foundation", "materialId": "C2A-M31", "target": "identify order quantity", "promptEn": "How many portions of rice are on the order?", "options": {"A": {"zh-Hans": "一份", "zh-Hant": "一份"}, "B": {"zh-Hans": "三份", "zh-Hant": "三份"}, "C": {"zh-Hans": "四份", "zh-Hant": "四份"}}, "correctAnswer": "B", "evidence": {"materialId": "C2A-M31", "quote": {"zh-Hans": "米饭三份、面条一碗", "zh-Hant": "米飯三份、麪條一碗"}}, "explanation": {"en": "The order lists three portions of rice.", "zh": "订单列出三份米饭。"}, "distractors": {"A": {"en": "One is the bowl of noodles.", "zh": "一碗指面条。"}, "C": {"en": "Four is the number of diners, one of whom eats noodles instead.", "zh": "四是客人人数，其中一人吃面。"}}, "languageTags": ["quantity", "choice", "comparison"], "reviewStatus": "author_checked_pending_independent_review"}, {"id": "course-zh2-a-q32", "blueprintSlotId": "C2-R-12", "number": 32, "section": "reading", "group": "R3", "theme": "dining-shopping", "cognitiveTarget": "direct", "designDifficulty": "foundation", "materialId": "C2A-M32", "target": "identify size or stated preference", "promptEn": "Which apron does Xiao’an request?", "options": {"A": {"zh-Hans": "白色小号", "zh-Hant": "白色小號"}, "B": {"zh-Hans": "黄色中号", "zh-Hant": "黃色中號"}, "C": {"zh-Hans": "白色中号", "zh-Hant": "白色中號"}}, "correctAnswer": "C", "evidence": {"materialId": "C2A-M32", "quote": {"zh-Hans": "这次请帮我买中号，颜色还是白色，不要黄色", "zh-Hant": "這次請幫我買中號，顏色還是白色，不要黃色"}}, "explanation": {"en": "The request is for a white medium apron.", "zh": "留言要求白色中号围裙。"}, "distractors": {"A": {"en": "The small apron was tried and is too tight.", "zh": "小号已经试过，太紧。"}, "B": {"en": "Yellow is explicitly rejected.", "zh": "留言明确不要黄色。"}}, "languageTags": ["quantity", "choice", "comparison"], "reviewStatus": "author_checked_pending_independent_review"}, {"id": "course-zh2-a-q33", "blueprintSlotId": "C2-R-13", "number": 33, "section": "reading", "group": "R3", "theme": "dining-shopping", "cognitiveTarget": "direct", "designDifficulty": "standard", "materialId": "C2A-M33", "target": "identify stated price or total", "promptEn": "What is the total cost of the meal?", "options": {"A": {"zh-Hans": "二十二元", "zh-Hant": "二十二元"}, "B": {"zh-Hans": "三十元", "zh-Hant": "三十元"}, "C": {"zh-Hans": "八元", "zh-Hant": "八元"}}, "correctAnswer": "A", "evidence": {"materialId": "C2A-M33", "quote": {"zh-Hans": "应付：二十二元", "zh-Hant": "應付：二十二元"}}, "explanation": {"en": "The amount due is twenty-two yuan.", "zh": "应付金额是二十二元。"}, "distractors": {"B": {"en": "Thirty yuan is the amount handed over.", "zh": "三十元是客人付出的金额。"}, "C": {"en": "Eight yuan is the change returned.", "zh": "八元是找回的钱。"}}, "languageTags": ["quantity", "choice", "comparison"], "reviewStatus": "author_checked_pending_independent_review"}, {"id": "course-zh2-a-q34", "blueprintSlotId": "C2-R-14", "number": 34, "section": "reading", "group": "R3", "theme": "dining-shopping", "cognitiveTarget": "integrate", "designDifficulty": "standard", "materialId": "C2A-M34", "target": "choose an option satisfying two needs", "promptEn": "Which purchase meets the quantity and budget requirements?", "options": {"A": {"zh-Hans": "乙店三瓶六元", "zh-Hant": "乙店三瓶六元"}, "B": {"zh-Hans": "甲店四瓶八元", "zh-Hant": "甲店四瓶八元"}, "C": {"zh-Hans": "丙店四瓶十二元", "zh-Hant": "丙店四瓶十二元"}}, "correctAnswer": "B", "evidence": {"materialId": "C2A-M34", "quote": {"zh-Hans": "甲店四瓶八元", "zh-Hant": "甲店四瓶八元"}}, "explanation": {"en": "Four bottles cover four people, and eight yuan stays within ten.", "zh": "四瓶够四个人，八元不超过十元。"}, "distractors": {"A": {"en": "Three bottles leave one person without a bottle.", "zh": "三瓶不够四个人每人一瓶。"}, "C": {"en": "Twelve yuan exceeds the ten-yuan budget.", "zh": "十二元超过十元预算。"}}, "languageTags": ["quantity", "choice", "comparison"], "reviewStatus": "author_checked_pending_independent_review"}, {"id": "course-zh2-a-q35", "blueprintSlotId": "C2-R-15", "number": 35, "section": "reading", "group": "R3", "theme": "daily", "cognitiveTarget": "integrate", "designDifficulty": "standard", "materialId": "C2A-M35", "target": "combine a household request and availability", "promptEn": "What should Xiaoning do first after class?", "options": {"A": {"zh-Hans": "先回家等爸爸", "zh-Hant": "先回家等爸爸"}, "B": {"zh-Hans": "先去买菜", "zh-Hant": "先去買菜"}, "C": {"zh-Hans": "在回家路上买杯子", "zh-Hant": "在回家路上買杯子"}}, "correctAnswer": "C", "evidence": {"materialId": "C2A-M35", "quote": {"zh-Hans": "请小宁下课先买杯子再回家", "zh-Hant": "請小寧下課先買杯子再回家"}}, "explanation": {"en": "The requested sequence is to buy cups before returning home.", "zh": "明确要求先买杯子再回家。"}, "distractors": {"A": {"en": "Waiting at home first risks missing the shop’s closing time.", "zh": "先回家等爸爸会错过商店关门前的安排。"}, "B": {"en": "Groceries have already been bought.", "zh": "买菜已经办好，无需小宁再买。"}}, "languageTags": ["sequence", "frequency", "completed-action"], "reviewStatus": "author_checked_pending_independent_review"}, {"id": "course-zh2-a-q36", "blueprintSlotId": "C2-R-16", "number": 36, "section": "reading", "group": "R4", "theme": "weather", "cognitiveTarget": "direct", "designDifficulty": "foundation", "materialId": "C2A-M36", "target": "identify a weather change", "promptEn": "What is the forecast for Saturday afternoon?", "options": {"A": {"zh-Hans": "有太阳", "zh-Hant": "有太陽"}, "B": {"zh-Hans": "下雨", "zh-Hant": "下雨"}, "C": {"zh-Hans": "雨停了", "zh-Hant": "雨停了"}}, "correctAnswer": "B", "evidence": {"materialId": "C2A-M36", "quote": {"zh-Hans": "下午：下雨，十六度", "zh-Hant": "下午：下雨，十六度"}}, "explanation": {"en": "The afternoon forecast explicitly says rain.", "zh": "下午预报明确是下雨。"}, "distractors": {"A": {"en": "Sunshine is not the afternoon forecast.", "zh": "下午没有预报太阳。"}, "C": {"en": "The rain stops in the evening, not the afternoon.", "zh": "雨停是在晚上，不是下午。"}}, "languageTags": ["cause", "revised-plan"], "reviewStatus": "author_checked_pending_independent_review"}, {"id": "course-zh2-a-q37", "blueprintSlotId": "C2-R-17", "number": 37, "section": "reading", "group": "R4", "theme": "weather", "cognitiveTarget": "direct", "designDifficulty": "foundation", "materialId": "C2A-M37", "target": "identify an explicit activity reason", "promptEn": "Why did they choose the afternoon?", "options": {"A": {"zh-Hans": "小方上午要照顾弟弟", "zh-Hant": "小方上午要照顧弟弟"}, "B": {"zh-Hans": "公园上午不开", "zh-Hant": "公園上午不開"}, "C": {"zh-Hans": "上午天气不好", "zh-Hant": "上午天氣不好"}}, "correctAnswer": "A", "evidence": {"materialId": "C2A-M37", "quote": {"zh-Hans": "我上午要在家照顾弟弟，妈妈十二点才回来", "zh-Hant": "我上午要在家照顧弟弟，媽媽十二點纔回來"}}, "explanation": {"en": "Xiaofang has a family duty until the mother returns at noon.", "zh": "小方上午要照顾弟弟，妈妈中午才回来。"}, "distractors": {"B": {"en": "The text does not state a morning closure.", "zh": "材料没有说公园上午不开。"}, "C": {"en": "The morning weather is explicitly described as good.", "zh": "材料明确说上午天气很好。"}}, "languageTags": ["cause", "revised-plan"], "reviewStatus": "author_checked_pending_independent_review"}, {"id": "course-zh2-a-q38", "blueprintSlotId": "C2-R-18", "number": 38, "section": "reading", "group": "R4", "theme": "health", "cognitiveTarget": "direct", "designDifficulty": "standard", "materialId": "C2A-M38", "target": "combine activity and health constraint", "promptEn": "Which route leaves the requested resting time?", "options": {"A": {"zh-Hans": "公园二十五分钟路线", "zh-Hant": "公園二十五分鐘路線"}, "B": {"zh-Hans": "两条路线都走", "zh-Hant": "兩條路線都走"}, "C": {"zh-Hans": "小区十五分钟路线", "zh-Hant": "小區十五分鐘路線"}}, "correctAnswer": "C", "evidence": {"materialId": "C2A-M38", "quote": {"zh-Hans": "一共只有三十分钟，还想留十分钟坐着休息", "zh-Hant": "一共只有三十分鐘，還想留十分鐘坐着休息"}}, "explanation": {"en": "Fifteen minutes walking leaves fifteen minutes, enough for the requested ten-minute rest.", "zh": "走十五分钟还剩十五分钟，足够休息十分钟。"}, "distractors": {"A": {"en": "A twenty-five-minute walk leaves only five minutes.", "zh": "走二十五分钟只剩五分钟，不够休息十分钟。"}, "B": {"en": "Walking both takes forty minutes before any rest.", "zh": "两条都走需四十分钟，尚未包含休息。"}}, "languageTags": ["duration", "simple-advice"], "reviewStatus": "author_checked_pending_independent_review"}, {"id": "course-zh2-a-q39", "blueprintSlotId": "C2-R-19", "number": 39, "section": "reading", "group": "R4", "theme": "festival", "cognitiveTarget": "integrate", "designDifficulty": "standard", "materialId": "C2A-M39", "target": "order two stated event steps", "promptEn": "What did the group do just after making the little paper lanterns?", "options": {"A": {"zh-Hans": "一起包饺子", "zh-Hant": "一起包餃子"}, "B": {"zh-Hans": "把灯放到门口", "zh-Hant": "把燈放到門口"}, "C": {"zh-Hans": "把灯带回家", "zh-Hant": "把燈帶回家"}}, "correctAnswer": "B", "evidence": {"materialId": "C2A-M39", "quote": {"zh-Hans": "先跟老师做红色的小纸灯，再把灯放到门口", "zh-Hant": "先跟老師做紅色的小紙燈，再把燈放到門口"}}, "explanation": {"en": "Putting lanterns by the entrance directly follows making them.", "zh": "做灯后紧接着把灯放到门口。"}, "distractors": {"A": {"en": "Dumpling-making is later, at eleven.", "zh": "包饺子在之后十一点。"}, "C": {"en": "Taking the lantern home is after lunch.", "zh": "把灯带回家在午饭之后。"}}, "languageTags": ["experience", "sequence", "feeling"], "reviewStatus": "author_checked_pending_independent_review"}, {"id": "course-zh2-a-q40", "blueprintSlotId": "C2-R-20", "number": 40, "section": "reading", "group": "R4", "theme": "festival", "cognitiveTarget": "infer", "designDifficulty": "stretch", "materialId": "C2A-M40", "target": "infer a feeling from stated evidence", "promptEn": "What does Xiao’an’s behaviour suggest about a future visit?", "options": {"A": {"zh-Hans": "她愿意再去参加", "zh-Hant": "她願意再去參加"}, "B": {"zh-Hans": "她决定不再参加", "zh-Hant": "她決定不再參加"}, "C": {"zh-Hans": "她忘记活动日期了", "zh-Hant": "她忘記活動日期了"}}, "correctAnswer": "A", "evidence": {"materialId": "C2A-M40", "quote": {"zh-Hans": "问老师下次能不能带朋友一起参加。我已经把下次活动的日期写进日历了", "zh-Hant": "問老師下次能不能帶朋友一起參加。我已經把下次活動的日期寫進日曆了"}}, "explanation": {"en": "Inviting a friend and recording the next date support wanting to return.", "zh": "问能否带朋友又记下日期，支持愿意再参加。"}, "distractors": {"B": {"en": "The later actions do not support deciding never to return.", "zh": "后来的行为不支持决定不再去。"}, "C": {"en": "She explicitly recorded the next date.", "zh": "她明确已经记下日期。"}}, "languageTags": ["experience", "sequence", "feeling"], "reviewStatus": "author_checked_pending_independent_review"}], "tasks": [{"id": "W1", "section": "writing", "type": "message-reply", "title": "Reply to a rainy-weekend change", "promptEn": "Reply to Xiaolin in Chinese. Say whether you can meet at the community centre at two on Saturday and whether you prefer cooking or drawing. Give a reason for your activity choice. Suggest another workable arrangement or ask one relevant question. You may invent details. About 40-60 Chinese characters is a guide, not a minimum.", "stimulus": {"zh-Hans": "小周：星期六下雨，公园活动改在社区中心，下午两点开始。你能来吗？你想参加做饭还是画画？我两种都可以。\n小林", "zh-Hant": "小周：星期六下雨，公園活動改在社區中心，下午兩點開始。你能來嗎？你想參加做飯還是畫畫？我兩種都可以。\n小林"}, "requirements": ["Answer whether you can meet at the stated time and place.", "Choose cooking or drawing, or explain a feasible alternative.", "Give a reason related to the activity choice.", "Suggest a workable alternative or ask a relevant question."], "reference": {"zh-Hans": "小林，我周六两点能到社区中心。我想画画，因为我喜欢画花。请问要自己带纸和笔吗？谢谢你告诉我活动的变化。", "zh-Hant": "小林，我週六兩點能到社區中心。我想畫畫，因爲我喜歡畫花。請問要自己帶紙和筆嗎？謝謝你告訴我活動的變化。"}, "alternateReference": {"zh-Hans": "小林，我周六两点有课，三点到可以吗？我想学做饭，因为平时很少自己做。活动三点以后还可以参加吗？", "zh-Hant": "小林，我週六兩點有課，三點到可以嗎？我想學做飯，因爲平時很少自己做。活動三點以後還可以參加嗎？"}, "suggestedHanzi": [40, 60], "enforcedMinimum": null, "sharedTimingGroup": "writing", "rubric": {"maxPoints": 8, "automaticGrade": false, "missing": "unsubmitted", "technicalFailure": "needs_rerecording", "reviewerOptions": ["self", "own_teacher"], "teacherServiceIncluded": false, "dimensions": [{"id": "completion", "name": "任务完成", "levels": {"0": "已提交内容没有回应相关任务。", "1": "回应部分要求，但遗漏或误解关键信息。", "2": "完成本任务主要观察点：Answer whether you can meet at the stated time and place.；Choose cooking or drawing, or explain a feasible alternative.；Give a reason related to the activity choice.；Suggest a workable alternative or ask a relevant question."}}, {"id": "comprehensibility", "name": "可理解性", "levels": {"0": "主要意思无法恢复。", "1": "部分意思需猜测，个别错误影响理解。", "2": "主要意思清楚；允许不影响理解的错误和口音。"}}, {"id": "language", "name": "语言运用", "levels": {"0": "缺少可表达任务意思的中文。", "1": "有限词句可表达部分意思，但关系不够清楚。", "2": "能用简单中文和必要连接表达多项信息，不要求指定句型。"}}, {"id": "organization", "name": "组织和相关回应", "levels": {"0": "缺少可辨顺序或相关回应。", "1": "部分顺序或回应相关，但连接不清。", "2": "多句内容易于跟随，先后或比较关系清楚，回应相关。"}}], "notes": "Suggested length and native-like accent are not scoring criteria. S1 is ONE profile across four responses; a missing turn is partial submission.", "taskObservations": ["Answer whether you can meet at the stated time and place.", "Choose cooking or drawing, or explain a feasible alternative.", "Give a reason related to the activity choice.", "Suggest a workable alternative or ask a relevant question."]}, "reviewNotes": ["A polite decline with a feasible alternative is valid.", "Do not require a preferred activity or a fixed grammar pattern.", "Check all four observations; the sample is not the only answer."]}, {"id": "W2", "section": "writing", "type": "short-experience-narrative", "title": "Describe a community activity", "promptEn": "Use the fictional activity card to tell a classmate about last Saturday. Include when and where it happened, describe at least two activities in sequence, and give one feeling or reason. Write connected Chinese sentences. About 80-120 Chinese characters is a guide, not a minimum. You may add plausible details without contradicting the card.", "stimulus": {"zh-Hans": "时间：上周六上午\n地点：社区中心\n九点：和老师做小纸灯\n十点：和同学学做面条\n十二点：一起吃午饭\n结束后：把纸灯送给家人\n感受：自己选择，也可以写不喜欢的地方并说明原因", "zh-Hant": "時間：上週六上午\n地點：社區中心\n九點：和老師做小紙燈\n十點：和同學學做麪條\n十二點：一起喫午飯\n結束後：把紙燈送給家人\n感受：自己選擇，也可以寫不喜歡的地方並說明原因"}, "requirements": ["Identify last Saturday morning.", "Identify the community centre.", "Describe one activity from the card.", "Describe a second activity with a consistent sequence.", "Give one feeling or a reason."], "reference": {"zh-Hans": "上周六上午，我和同学去社区中心参加活动。我们九点先跟老师做小纸灯，十点再学做面条。第一次做面条不太容易，但是大家一起帮忙。十二点，我们吃了自己做的午饭。活动结束后，我把纸灯送给家人。我觉得这一天很有意思，因为我学会了新的东西。", "zh-Hant": "上週六上午，我和同學去社區中心參加活動。我們九點先跟老師做小紙燈，十點再學做麪條。第一次做麪條不太容易，但是大家一起幫忙。十二點，我們喫了自己做的午飯。活動結束後，我把紙燈送給家人。我覺得這一天很有意思，因爲我學會了新的東西。"}, "suggestedHanzi": [80, 120], "enforcedMinimum": null, "sharedTimingGroup": "writing", "rubric": {"maxPoints": 8, "automaticGrade": false, "missing": "unsubmitted", "technicalFailure": "needs_rerecording", "reviewerOptions": ["self", "own_teacher"], "teacherServiceIncluded": false, "dimensions": [{"id": "completion", "name": "任务完成", "levels": {"0": "已提交内容没有回应相关任务。", "1": "回应部分要求，但遗漏或误解关键信息。", "2": "完成本任务主要观察点：Identify last Saturday morning.；Identify the community centre.；Describe one activity from the card.；Describe a second activity with a consistent sequence.；Give one feeling or a reason."}}, {"id": "comprehensibility", "name": "可理解性", "levels": {"0": "主要意思无法恢复。", "1": "部分意思需猜测，个别错误影响理解。", "2": "主要意思清楚；允许不影响理解的错误和口音。"}}, {"id": "language", "name": "语言运用", "levels": {"0": "缺少可表达任务意思的中文。", "1": "有限词句可表达部分意思，但关系不够清楚。", "2": "能用简单中文和必要连接表达多项信息，不要求指定句型。"}}, {"id": "organization", "name": "组织和相关回应", "levels": {"0": "缺少可辨顺序或相关回应。", "1": "部分顺序或回应相关，但连接不清。", "2": "多句内容易于跟随，先后或比较关系清楚，回应相关。"}}], "notes": "Suggested length and native-like accent are not scoring criteria. S1 is ONE profile across four responses; a missing turn is partial submission.", "taskObservations": ["Identify last Saturday morning.", "Identify the community centre.", "Describe one activity from the card.", "Describe a second activity with a consistent sequence.", "Give one feeling or a reason."]}, "reviewNotes": ["Allow any supported feeling, including a negative one with a reason.", "No need to reproduce every clock time.", "Copied labels alone give limited evidence of connected expression."]}, {"id": "S1", "section": "speaking", "type": "simulated-guided-exchange", "title": "Arrange a meal and a meeting", "promptEn": "A classmate is arranging Saturday lunch with you. Respond in Chinese to four fixed audio prompts. Each prompt plays twice; then allow 15 seconds to prepare and up to 25 seconds to record. Invent details if you wish. Four responses form one task out of eight; the recording does not adapt to your answers.", "scenarioEn": "The classmate asks about food needs, offers two meals, asks for your reason, and then introduces a later meeting time.", "exchanges": [{"id": "S1-1", "speaker": "female", "prompt": {"zh-Hans": "星期六一起吃午饭吧。你有什么不想吃的，或者不能吃的东西？", "zh-Hant": "星期六一起喫午飯吧。你有什麼不想喫的，或者不能喫的東西？"}, "reference": {"zh-Hans": "我不想吃太辣的东西。我想吃清淡一点儿的菜。", "zh-Hant": "我不想喫太辣的東西。我想喫清淡一點兒的菜。"}, "checklist": ["State a food need or say there is no restriction."]}, {"id": "S1-2", "speaker": "female", "prompt": {"zh-Hans": "店里有米饭，也有面条。你想选哪一种？也可以选别的。", "zh-Hant": "店裏有米飯，也有面條。你想選哪一種？也可以選別的。"}, "reference": {"zh-Hans": "我想选面条。鸡蛋面就可以。", "zh-Hant": "我想選麪條。雞蛋麪就可以。"}, "checklist": ["Choose rice, noodles or another relevant option."]}, {"id": "S1-3", "speaker": "female", "prompt": {"zh-Hans": "你为什么想这样选？请给我说一个理由。", "zh-Hant": "你爲什麼想這樣選？請給我說一個理由。"}, "reference": {"zh-Hans": "因为我昨天吃过米饭了，今天想换一种。", "zh-Hant": "因爲我昨天喫過米飯了，今天想換一種。"}, "checklist": ["Give a reason; judge relevance to the learner’s own previous choice."]}, {"id": "S1-4", "speaker": "female", "prompt": {"zh-Hans": "我十二点有事，一点才能到。你方便吗？不方便的话，可以怎么改？", "zh-Hant": "我十二點有事，一點才能到。你方便嗎？不方便的話，可以怎麼改？"}, "reference": {"zh-Hans": "一点可以，我一点在饭店门口等你。", "zh-Hant": "一點可以，我一點在飯店門口等你。"}, "alternateReference": {"zh-Hans": "一点我有课，我们改到星期日中午，好吗？", "zh-Hant": "一點我有課，我們改到星期日中午，好嗎？"}, "checklist": ["Accept the new time with a workable arrangement or propose an alternative."]}], "playsPerPrompt": 2, "preparationSecondsPerPrompt": 15, "responseSecondsPerPrompt": 25, "rubricScope": "all_four_responses_together", "rubric": {"maxPoints": 8, "automaticGrade": false, "missing": "unsubmitted", "technicalFailure": "needs_rerecording", "reviewerOptions": ["self", "own_teacher"], "teacherServiceIncluded": false, "dimensions": [{"id": "completion", "name": "任务完成", "levels": {"0": "已提交内容没有回应相关任务。", "1": "回应部分要求，但遗漏或误解关键信息。", "2": "完成本任务主要观察点：State a food need or say there is no restriction.；Choose rice, noodles or another relevant option.；Give a reason; judge relevance to the learner’s own previous choice.；Accept the new time with a workable arrangement or propose an alternative."}}, {"id": "comprehensibility", "name": "可理解性", "levels": {"0": "主要意思无法恢复。", "1": "部分意思需猜测，个别错误影响理解。", "2": "主要意思清楚；允许不影响理解的错误和口音。"}}, {"id": "language", "name": "语言运用", "levels": {"0": "缺少可表达任务意思的中文。", "1": "有限词句可表达部分意思，但关系不够清楚。", "2": "能用简单中文和必要连接表达多项信息，不要求指定句型。"}}, {"id": "organization", "name": "组织和相关回应", "levels": {"0": "缺少可辨顺序或相关回应。", "1": "部分顺序或回应相关，但连接不清。", "2": "多句内容易于跟随，先后或比较关系清楚，回应相关。"}}], "notes": "Suggested length and native-like accent are not scoring criteria. S1 is ONE profile across four responses; a missing turn is partial submission.", "taskObservations": ["State a food need or say there is no restriction.", "Choose rice, noodles or another relevant option.", "Give a reason; judge relevance to the learner’s own previous choice.", "Accept the new time with a workable arrangement or propose an alternative."]}}, {"id": "S2", "section": "speaking", "type": "compare-and-plan-presentation", "title": "Choose a weekend activity", "promptEn": "Use the two activity cards to recommend one plan to a classmate who is free from one to five on Saturday, has at most thirty yuan, and prefers not to be outside in the rain. Compare the options, state your choice, give two reasons based on the cards, and describe a short workable plan. You have 60 seconds to prepare and up to 90 seconds to speak. Other choices are valid if you explain how their constraints can be managed.", "stimulus": {"zh-Hans": "周六下午可能下雨。\n甲：社区中心做饭课，下午两点到四点，室内，二十五元；从车站走五分钟。\n乙：公园散步，下午一点半到三点，室外，免费；从车站走十五分钟；可借伞。\n同学：一点到五点有空，最多三十元，希望不在雨里活动。", "zh-Hant": "週六下午可能下雨。\n甲：社區中心做飯課，下午兩點到四點，室內，二十五元；從車站走五分鐘。\n乙：公園散步，下午一點半到三點，室外，免費；從車站走十五分鐘；可借傘。\n同學：一點到五點有空，最多三十元，希望不在雨裏活動。"}, "requirements": ["Compare at least one feature of both options.", "Choose a plan.", "Give a first evidence-based reason.", "Give a second evidence-based reason.", "Describe a short plan consistent with the time and place."], "reference": {"zh-Hans": "我建议选甲。两个活动我们都有时间参加，乙不用花钱，甲要二十五元。不过甲在室内，下午可能下雨，在社区中心更方便。二十五元也没有超过三十元。我们可以一点半在车站见，先走到社区中心，两点上课，四点结束。", "zh-Hant": "我建議選甲。兩個活動我們都有時間參加，乙不用花錢，甲要二十五元。不過甲在室內，下午可能下雨，在社區中心更方便。二十五元也沒有超過三十元。我們可以一點半在車站見，先走到社區中心，兩點上課，四點結束。"}, "alternateReference": {"zh-Hans": "如果同学愿意借伞，也可以选乙，因为免费，时间也合适。不过乙在室外，可能会淋雨，要先问同学是否愿意改变偏好。我们一点在车站见，一点半开始散步。", "zh-Hant": "如果同學願意借傘，也可以選乙，因爲免費，時間也合適。不過乙在室外，可能會淋雨，要先問同學是否願意改變偏好。我們一點在車站見，一點半開始散步。"}, "preparationSeconds": 60, "responseSeconds": 90, "rubric": {"maxPoints": 8, "automaticGrade": false, "missing": "unsubmitted", "technicalFailure": "needs_rerecording", "reviewerOptions": ["self", "own_teacher"], "teacherServiceIncluded": false, "dimensions": [{"id": "completion", "name": "任务完成", "levels": {"0": "已提交内容没有回应相关任务。", "1": "回应部分要求，但遗漏或误解关键信息。", "2": "完成本任务主要观察点：Compare at least one feature of both options.；Choose a plan.；Give a first evidence-based reason.；Give a second evidence-based reason.；Describe a short plan consistent with the time and place."}}, {"id": "comprehensibility", "name": "可理解性", "levels": {"0": "主要意思无法恢复。", "1": "部分意思需猜测，个别错误影响理解。", "2": "主要意思清楚；允许不影响理解的错误和口音。"}}, {"id": "language", "name": "语言运用", "levels": {"0": "缺少可表达任务意思的中文。", "1": "有限词句可表达部分意思，但关系不够清楚。", "2": "能用简单中文和必要连接表达多项信息，不要求指定句型。"}}, {"id": "organization", "name": "组织和相关回应", "levels": {"0": "缺少可辨顺序或相关回应。", "1": "部分顺序或回应相关，但连接不清。", "2": "多句内容易于跟随，先后或比较关系清楚，回应相关。"}}], "notes": "Suggested length and native-like accent are not scoring criteria. S1 is ONE profile across four responses; a missing turn is partial submission.", "taskObservations": ["Compare at least one feature of both options.", "Choose a plan.", "Give a first evidence-based reason.", "Give a second evidence-based reason.", "Describe a short plan consistent with the time and place."]}, "reviewNotes": ["A is straightforward; B is acceptable only with explicit handling of the rain preference.", "Do not judge accent similarity to a native speaker.", "A recording shorter than ninety seconds can fully complete the task."]}], "instructions": {"en": "Choose one answer per listening/reading item. Full listening sources play twice. Writing tasks share 20 minutes. Use your own recorder for speaking; this preview does not time or save work. Self/own-teacher marking only; no included marking service.", "zh": "听读每题三选一，整轨听力每段两遍。写作共用二十分钟。口语用自己的录音工具；此审阅页不计时或保存作答。口写自评或交自己的教师评阅，不包含本站代评。"}, "vocabularySupport": [{"term": {"zh-Hans": "家务", "zh-Hant": "家務"}, "pinyin": "jiāwù", "meaningEn": "housework"}, {"term": {"zh-Hans": "洗碗", "zh-Hant": "洗碗"}, "pinyin": "xǐ wǎn", "meaningEn": "wash dishes"}, {"term": {"zh-Hans": "社区", "zh-Hant": "社區"}, "pinyin": "shèqū", "meaningEn": "community"}, {"term": {"zh-Hans": "路口", "zh-Hant": "路口"}, "pinyin": "lùkǒu", "meaningEn": "intersection"}, {"term": {"zh-Hans": "长椅", "zh-Hant": "長椅"}, "pinyin": "chángyǐ", "meaningEn": "bench"}, {"term": {"zh-Hans": "围裙", "zh-Hant": "圍裙"}, "pinyin": "wéiqún", "meaningEn": "apron"}, {"term": {"zh-Hans": "清淡", "zh-Hant": "清淡"}, "pinyin": "qīngdàn", "meaningEn": "mild, lightly seasoned"}, {"term": {"zh-Hans": "采购", "zh-Hant": "採購"}, "pinyin": "cǎigòu", "meaningEn": "purchase supplies"}, {"term": {"zh-Hans": "开放", "zh-Hant": "開放"}, "pinyin": "kāifàng", "meaningEn": "open to visitors"}, {"term": {"zh-Hans": "账单", "zh-Hant": "賬單"}, "pinyin": "zhàngdān", "meaningEn": "bill"}, {"term": {"zh-Hans": "浇水", "zh-Hant": "澆水"}, "pinyin": "jiāo shuǐ", "meaningEn": "water plants"}, {"term": {"zh-Hans": "平坦", "zh-Hant": "平坦"}, "pinyin": "píngtǎn", "meaningEn": "flat, even"}, {"term": {"zh-Hans": "纸灯", "zh-Hant": "紙燈"}, "pinyin": "zhǐdēng", "meaningEn": "paper lantern"}, {"term": {"zh-Hans": "内外", "zh-Hant": "內外"}, "pinyin": "nèi wài", "meaningEn": "inside and outside"}], "supportPolicy": "Preparation support is separate from timed papers. Per-item lexical audit and teacher suitability review remain separate.", "nextAcceptance": ["Actual media timing and structural validation", "ASR screening and retained flags", "Human listening acceptance", "Independent teacher and learner pilot", "Separate product integration and release"]}</script><script id="audio-data" type="application/json">{"paperId": "course-chinese-2-a-v1", "provider": "Edge TTS at authoring time; local MP3 playback, no runtime TTS", "rate": "-8%", "voices": {"female": "zh-CN-XiaoxiaoNeural", "male": "zh-CN-YunxiNeural"}, "humanListeningAcceptance": false, "units": [{"id": "C2A-M01", "kind": "listening-source", "sourcePlays": 1, "script": [{"speaker": "female", "text": {"zh-Hans": "今天的家务怎么分？你打扫客厅，我洗碗，好吗？", "zh-Hant": "今天的家務怎麼分？你打掃客廳，我洗碗，好嗎？"}}, {"speaker": "male", "text": {"zh-Hans": "我更想洗碗，客厅请你打扫，可以吗？", "zh-Hant": "我更想洗碗，客廳請你打掃，可以嗎？"}}, {"speaker": "female", "text": {"zh-Hans": "好，那就这样。", "zh-Hant": "好，那就這樣。"}}], "sourceDurationSeconds": 12.748, "src": "assets/audio/c2a-m01.mp3", "durationSeconds": 13.296, "pcmSeconds": 13.248, "bytes": 106604, "sha256": "7895ed5d3dc367050073cc81ce8ad6982b2e1883bd26deb9435527a318035aa8"}, {"id": "C2A-M02", "kind": "listening-source", "sourcePlays": 1, "script": [{"speaker": "male", "text": {"zh-Hans": "社区活动星期六十点开始。我九点要在家打扫厨房，九点半出门。活动十二点结束以后，我再去买菜。", "zh-Hant": "社區活動星期六十點開始。我九點要在家打掃廚房，九點半出門。活動十二點結束以後，我再去買菜。"}}], "sourceDurationSeconds": 11.184, "src": "assets/audio/c2a-m02.mp3", "durationSeconds": 11.736, "pcmSeconds": 11.684, "bytes": 94124, "sha256": "bd36a1e77e221c23e16bc46408770da9252696df35d91f89b00447f862d802c6"}, {"id": "C2A-M03", "kind": "listening-source", "sourcePlays": 1, "script": [{"speaker": "female", "text": {"zh-Hans": "我平时每天晚上洗碗，星期六和星期日不用洗，因为这两天爸爸做家务。我每个星期洗五次，每次大约十分钟。", "zh-Hant": "我平時每天晚上洗碗，星期六和星期日不用洗，因爲這兩天爸爸做家務。我每個星期洗五次，每次大約十分鐘。"}}], "sourceDurationSeconds": 11.64, "src": "assets/audio/c2a-m03.mp3", "durationSeconds": 12.192, "pcmSeconds": 12.14, "bytes": 97772, "sha256": "b4471f32b9782763774c89148270697469518b8820fbee03464e3229955c95be"}, {"id": "C2A-M04", "kind": "listening-source", "sourcePlays": 1, "script": [{"speaker": "male", "text": {"zh-Hans": "你平时六点散步，今天也一样吗？", "zh-Hant": "你平時六點散步，今天也一樣嗎？"}}, {"speaker": "female", "text": {"zh-Hans": "今天六点要开会，七点才下班。我想下班后走半个小时。", "zh-Hant": "今天六點要開會，七點才下班。我想下班後走半個小時。"}}, {"speaker": "male", "text": {"zh-Hans": "那我七点在楼下等你。", "zh-Hant": "那我七點在樓下等你。"}}], "sourceDurationSeconds": 13.468, "src": "assets/audio/c2a-m04.mp3", "durationSeconds": 14.016, "pcmSeconds": 13.968, "bytes": 112364, "sha256": "31b878b86a5071202e02fd9994575ad8eb5b31b793435a18242c5300f09b0e77"}, {"id": "C2A-M05", "kind": "listening-source", "sourcePlays": 1, "script": [{"speaker": "female", "text": {"zh-Hans": "小安最近每天晚上看电视到十二点，第二天起床总觉得累。昨天她十点就关了电视，今天早上起床的时候觉得舒服多了。", "zh-Hant": "小安最近每天晚上看電視到十二點，第二天起牀總覺得累。昨天她十點就關了電視，今天早上起牀的時候覺得舒服多了。"}}], "sourceDurationSeconds": 12.84, "src": "assets/audio/c2a-m05.mp3", "durationSeconds": 13.392, "pcmSeconds": 13.34, "bytes": 107372, "sha256": "542286a8837f37b8d49bf410974968a83bd36f04fb7ee0b9f0d9d63bea34cce4"}, {"id": "C2A-M06", "kind": "listening-source", "sourcePlays": 1, "script": [{"speaker": "male", "text": {"zh-Hans": "你现在去市场吗？", "zh-Hant": "你現在去市場嗎？"}}, {"speaker": "female", "text": {"zh-Hans": "不是，我先去图书馆还书。还完书再到对面的市场买菜，中午回家做饭。", "zh-Hant": "不是，我先去圖書館還書。還完書再到對面的市場買菜，中午回家做飯。"}}, {"speaker": "male", "text": {"zh-Hans": "那我在图书馆门口等你。", "zh-Hant": "那我在圖書館門口等你。"}}], "sourceDurationSeconds": 14.236, "src": "assets/audio/c2a-m06.mp3", "durationSeconds": 14.784, "pcmSeconds": 14.736, "bytes": 118508, "sha256": "bef63088807953db05979880e534a4b1002dabe47ca35dc2ba202ad7050dea73"}, {"id": "C2A-M07", "kind": "listening-source", "sourcePlays": 1, "script": [{"speaker": "female", "text": {"zh-Hans": "去图书馆坐地铁只要十分钟，我们坐地铁吧。", "zh-Hant": "去圖書館坐地鐵只要十分鐘，我們坐地鐵吧。"}}, {"speaker": "male", "text": {"zh-Hans": "今天地铁站不开门，还是坐公交车吧，二十分钟能到。", "zh-Hant": "今天地鐵站不開門，還是坐公交車吧，二十分鐘能到。"}}, {"speaker": "female", "text": {"zh-Hans": "好，我去车站等你。", "zh-Hant": "好，我去車站等你。"}}], "sourceDurationSeconds": 13.852, "src": "assets/audio/c2a-m07.mp3", "durationSeconds": 14.4, "pcmSeconds": 14.352, "bytes": 115436, "sha256": "e1720cacb5e79fe349ff78c3d2712ddd080c185be0d26fa831cf8c7eeaf42e0b"}, {"id": "C2A-M08", "kind": "listening-source", "sourcePlays": 1, "script": [{"speaker": "male", "text": {"zh-Hans": "从车站到图书馆怎么走？", "zh-Hant": "從車站到圖書館怎麼走？"}}, {"speaker": "female", "text": {"zh-Hans": "下车后先向右走，到第一个路口再向左。图书馆就在银行旁边，不用过马路。", "zh-Hant": "下車後先向右走，到第一個路口再向左。圖書館就在銀行旁邊，不用過馬路。"}}, {"speaker": "male", "text": {"zh-Hans": "好，我记住了。", "zh-Hant": "好，我記住了。"}}], "sourceDurationSeconds": 14.308, "src": "assets/audio/c2a-m08.mp3", "durationSeconds": 14.856, "pcmSeconds": 14.808, "bytes": 119084, "sha256": "5a528401ec6b5d8ddedea786cff982f47fa2c1b71587855c09f0424e71223709"}, {"id": "C2A-M09", "kind": "listening-source", "sourcePlays": 1, "script": [{"speaker": "female", "text": {"zh-Hans": "去图书馆有两条路。走河边比较近，可是没有灯；走商店那边远五分钟，但是一路都有灯。", "zh-Hant": "去圖書館有兩條路。走河邊比較近，可是沒有燈；走商店那邊遠五分鐘，但是一路都有燈。"}}, {"speaker": "male", "text": {"zh-Hans": "现在天黑了，我不着急，走商店那边吧。", "zh-Hant": "現在天黑了，我不着急，走商店那邊吧。"}}], "sourceDurationSeconds": 14.414, "src": "assets/audio/c2a-m09.mp3", "durationSeconds": 14.976, "pcmSeconds": 14.914, "bytes": 120044, "sha256": "0d2cf26fcea8a18b8e7b92b386584eaef32d437a1d3c60c505f7907da603ab7d"}, {"id": "C2A-M10", "kind": "listening-source", "sourcePlays": 1, "script": [{"speaker": "male", "text": {"zh-Hans": "明天上午下雨，原来九点在公园见的活动怎么办？", "zh-Hant": "明天上午下雨，原來九點在公園見的活動怎麼辦？"}}, {"speaker": "female", "text": {"zh-Hans": "改在图书馆吧。不过图书馆十点才开门，我们十点半见。", "zh-Hant": "改在圖書館吧。不過圖書館十點纔開門，我們十點半見。"}}, {"speaker": "male", "text": {"zh-Hans": "好，就这么定了。", "zh-Hant": "好，就這麼定了。"}}], "sourceDurationSeconds": 14.524, "src": "assets/audio/c2a-m10.mp3", "durationSeconds": 15.072, "pcmSeconds": 15.024, "bytes": 120812, "sha256": "fa0a458fd3297e402d74074ebb7ccb1e0360dc974cba31e07714918de6f9017d"}, {"id": "C2A-M11", "kind": "listening-source", "sourcePlays": 1, "script": [{"speaker": "female", "text": {"zh-Hans": "我们四个人，一人一碗面，好吗？", "zh-Hant": "我們四個人，一人一碗麪，好嗎？"}}, {"speaker": "male", "text": {"zh-Hans": "我和哥哥想吃米饭，妈妈和妹妹吃面。", "zh-Hant": "我和哥哥想喫米飯，媽媽和妹妹喫麪。"}}, {"speaker": "female", "text": {"zh-Hans": "那就两碗面、两份米饭，再点一个菜。", "zh-Hant": "那就兩碗麪、兩份米飯，再點一個菜。"}}], "sourceDurationSeconds": 12.436, "src": "assets/audio/c2a-m11.mp3", "durationSeconds": 12.984, "pcmSeconds": 12.936, "bytes": 104108, "sha256": "4e23783dc6229e44f04af79234fb5902440518ec3d6f81ad214b51a019509a2c"}, {"id": "C2A-M12", "kind": "listening-source", "sourcePlays": 1, "script": [{"speaker": "male", "text": {"zh-Hans": "这件小号的衣服好看，你试过了吗？", "zh-Hant": "這件小號的衣服好看，你試過了嗎？"}}, {"speaker": "female", "text": {"zh-Hans": "试过了，太小。我想买大号，颜色还是蓝色，不要红色。", "zh-Hant": "試過了，太小。我想買大號，顏色還是藍色，不要紅色。"}}, {"speaker": "male", "text": {"zh-Hans": "好，我帮你找蓝色大号。", "zh-Hant": "好，我幫你找藍色大號。"}}], "sourceDurationSeconds": 14.716, "src": "assets/audio/c2a-m12.mp3", "durationSeconds": 15.264, "pcmSeconds": 15.216, "bytes": 122348, "sha256": "a092dcc6338474dc9b0232a465d6f175d4ba68216585879a8ca16b3ecae639b4"}, {"id": "C2A-M13", "kind": "listening-source", "sourcePlays": 1, "script": [{"speaker": "female", "text": {"zh-Hans": "这份午饭十五块，汤另外三块。", "zh-Hant": "這份午飯十五塊，湯另外三塊。"}}, {"speaker": "male", "text": {"zh-Hans": "我只要午饭，不要汤。给你二十块。", "zh-Hant": "我只要午飯，不要湯。給你二十塊。"}}, {"speaker": "female", "text": {"zh-Hans": "好的，午饭十五块，找你五块。", "zh-Hant": "好的，午飯十五塊，找你五塊。"}}], "sourceDurationSeconds": 12.388, "src": "assets/audio/c2a-m13.mp3", "durationSeconds": 12.936, "pcmSeconds": 12.888, "bytes": 103724, "sha256": "7493aaf23ce35d97d0c7be3deb17c8fac14c7bcad999574766cc6d83f85b52b3"}, {"id": "C2A-M14", "kind": "listening-source", "sourcePlays": 1, "script": [{"speaker": "male", "text": {"zh-Hans": "小林不吃辣，小周不吃肉，晚上点什么好？", "zh-Hant": "小林不喫辣，小周不喫肉，晚上點什麼好？"}}, {"speaker": "female", "text": {"zh-Hans": "辣牛肉不行。鸡蛋面没有肉，也不辣，十八块；白菜汤虽然便宜，但大家想吃面。", "zh-Hant": "辣牛肉不行。雞蛋麪沒有肉，也不辣，十八塊；白菜湯雖然便宜，但大家想喫麪。"}}, {"speaker": "male", "text": {"zh-Hans": "那就点鸡蛋面。", "zh-Hant": "那就點雞蛋麪。"}}], "sourceDurationSeconds": 16.756, "src": "assets/audio/c2a-m14.mp3", "durationSeconds": 17.304, "pcmSeconds": 17.256, "bytes": 138668, "sha256": "b87f27d3baea4bc9e190fb3eb5d14590c6a20e0169bd4a0127fcb04e838ac911"}, {"id": "C2A-M15", "kind": "listening-source", "sourcePlays": 1, "script": [{"speaker": "female", "text": {"zh-Hans": "家里没有牛奶了，你下班后去买两瓶吧。", "zh-Hant": "家裏沒有牛奶了，你下班後去買兩瓶吧。"}}, {"speaker": "male", "text": {"zh-Hans": "我今天五点要开会，商店六点关门，恐怕来不及。", "zh-Hant": "我今天五點要開會，商店六點關門，恐怕來不及。"}}, {"speaker": "female", "text": {"zh-Hans": "那我现在去，你晚上回来洗碗就好。", "zh-Hant": "那我現在去，你晚上回來洗碗就好。"}}], "sourceDurationSeconds": 14.404, "src": "assets/audio/c2a-m15.mp3", "durationSeconds": 14.952, "pcmSeconds": 14.904, "bytes": 119852, "sha256": "711b054caf3cacc5f689f768db2bbf426132b683e8b1bc399371411f62a7c4f3"}, {"id": "C2A-M16", "kind": "listening-source", "sourcePlays": 1, "script": [{"speaker": "male", "text": {"zh-Hans": "今天早上有点儿冷，还下了小雨。天气预报说下午不下雨了，会出太阳，最高二十度。我们下午再去公园，不用现在出门。", "zh-Hant": "今天早上有點兒冷，還下了小雨。天氣預報說下午不下雨了，會出太陽，最高二十度。我們下午再去公園，不用現在出門。"}}], "sourceDurationSeconds": 11.688, "src": "assets/audio/c2a-m16.mp3", "durationSeconds": 12.24, "pcmSeconds": 12.188, "bytes": 98156, "sha256": "02732a8f2c52881684d591d975958e286abd11d9e6475fa4cfa390041d845534"}, {"id": "C2A-M17", "kind": "listening-source", "sourcePlays": 1, "script": [{"speaker": "female", "text": {"zh-Hans": "周日天气很好，为什么不在公园做活动？", "zh-Hant": "週日天氣很好，爲什麼不在公園做活動？"}}, {"speaker": "male", "text": {"zh-Hans": "公园的门坏了，周日不开。我们改在社区中心，时间还是下午两点。", "zh-Hant": "公園的門壞了，週日不開。我們改在社區中心，時間還是下午兩點。"}}, {"speaker": "female", "text": {"zh-Hans": "原来是这样。", "zh-Hant": "原來是這樣。"}}], "sourceDurationSeconds": 14.044, "src": "assets/audio/c2a-m17.mp3", "durationSeconds": 14.592, "pcmSeconds": 14.544, "bytes": 116972, "sha256": "e2e4679bbb843b368e88da91b07e511619f25f46bc53027c0fa5a74f27f1a1b0"}, {"id": "C2A-M18", "kind": "listening-source", "sourcePlays": 1, "script": [{"speaker": "male", "text": {"zh-Hans": "我今天想散步，但是只能走二十分钟。", "zh-Hant": "我今天想散步，但是隻能走二十分鐘。"}}, {"speaker": "female", "text": {"zh-Hans": "去湖边来回要四十分钟，小区里的路来回十五分钟。你走完以后还可以休息一会儿。", "zh-Hant": "去湖邊來回要四十分鐘，小區裏的路來回十五分鐘。你走完以後還可以休息一會兒。"}}, {"speaker": "male", "text": {"zh-Hans": "好，就在小区里走。", "zh-Hant": "好，就在小區裏走。"}}], "sourceDurationSeconds": 16.012, "src": "assets/audio/c2a-m18.mp3", "durationSeconds": 16.56, "pcmSeconds": 16.512, "bytes": 132716, "sha256": "5808081b745368913b829a3890b55e8f89738b4037f65b834221b30da6a03638"}, {"id": "C2A-M19", "kind": "listening-source", "sourcePlays": 1, "script": [{"speaker": "female", "text": {"zh-Hans": "上周我们去社区参加春节活动。先看小朋友唱歌，再跟老师写汉字。写完字以后，大家一起吃午饭。我第一次参加这样的活动，觉得很有意思。", "zh-Hant": "上週我們去社區參加春節活動。先看小朋友唱歌，再跟老師寫漢字。寫完字以後，大家一起喫午飯。我第一次參加這樣的活動，覺得很有意思。"}}], "sourceDurationSeconds": 14.928, "src": "assets/audio/c2a-m19.mp3", "durationSeconds": 15.48, "pcmSeconds": 15.428, "bytes": 124076, "sha256": "5272f242d49ce298af6d8329fb30395badba8d6e9407fd791afe3d56760f9f3c"}, {"id": "C2A-M20", "kind": "listening-source", "sourcePlays": 1, "script": [{"speaker": "male", "text": {"zh-Hans": "第一次去社区春节活动的时候，小雨只想待半个小时。后来活动结束了，她还在问下次什么时候再办，又告诉妹妹下次一定要一起来。", "zh-Hant": "第一次去社區春節活動的時候，小雨只想待半個小時。後來活動結束了，她還在問下次什麼時候再辦，又告訴妹妹下次一定要一起來。"}}], "sourceDurationSeconds": 12.792, "src": "assets/audio/c2a-m20.mp3", "durationSeconds": 13.344, "pcmSeconds": 13.292, "bytes": 106988, "sha256": "1bb7ff8c552dc52a3c3394d610416311be159425ce1a0d295113463ce7f21d05"}, {"id": "S1-1", "kind": "oral-prompt", "sourcePlays": 2, "singlePlayPcmSeconds": 6.552, "repeatGapSeconds": 1.5, "singlePlayPcmSha256": "eac4e7bc454fe478aed3046c6d39b4ab0e34ec30ce0ad90fa3e284aa553a236f", "script": {"zh-Hans": "星期六一起吃午饭吧。你有什么不想吃的，或者不能吃的东西？", "zh-Hant": "星期六一起喫午飯吧。你有什麼不想喫的，或者不能喫的東西？"}, "src": "assets/audio/s1-1.mp3", "durationSeconds": 14.664, "pcmSeconds": 14.604, "bytes": 117548, "sha256": "b10c255930b9d575c5bec85b52629a157dd150a7e2bbc4429d2134a54027e922"}, {"id": "S1-2", "kind": "oral-prompt", "sourcePlays": 2, "singlePlayPcmSeconds": 6.648, "repeatGapSeconds": 1.5, "singlePlayPcmSha256": "8cb8a84dd115ecaf41a3787d03f3bd09fab3ea6dfeda384af17d61418a144bd8", "script": {"zh-Hans": "店里有米饭，也有面条。你想选哪一种？也可以选别的。", "zh-Hant": "店裏有米飯，也有面條。你想選哪一種？也可以選別的。"}, "src": "assets/audio/s1-2.mp3", "durationSeconds": 14.856, "pcmSeconds": 14.796, "bytes": 119084, "sha256": "c43a6bcad726fda2b6a2c0642b29063e6262fc31598bf0358414d8d31679d10a"}, {"id": "S1-3", "kind": "oral-prompt", "sourcePlays": 2, "singlePlayPcmSeconds": 4.416, "repeatGapSeconds": 1.5, "singlePlayPcmSha256": "a4b3dbeb42038c83575db7c9c6f9d072e0dde0c6b4ea63626f47a33dd6f5603b", "script": {"zh-Hans": "你为什么想这样选？请给我说一个理由。", "zh-Hant": "你爲什麼想這樣選？請給我說一個理由。"}, "src": "assets/audio/s1-3.mp3", "durationSeconds": 10.392, "pcmSeconds": 10.332, "bytes": 83372, "sha256": "bcd910c84c65b640d56fb45038c2acbad6cc71ff09d24a7b14bcc80b64a94c6c"}, {"id": "S1-4", "kind": "oral-prompt", "sourcePlays": 2, "singlePlayPcmSeconds": 7.536, "repeatGapSeconds": 1.5, "singlePlayPcmSha256": "517551d3c9ab4156273306feeb05c61ab88a6fc9b16ad87061764ea67c63ddc4", "script": {"zh-Hans": "我十二点有事，一点才能到。你方便吗？不方便的话，可以怎么改？", "zh-Hant": "我十二點有事，一點才能到。你方便嗎？不方便的話，可以怎麼改？"}, "src": "assets/audio/s1-4.mp3", "durationSeconds": 16.632, "pcmSeconds": 16.572, "bytes": 133292, "sha256": "cd6183a50ba0cfeb64bb8e3830fbb6d67e911bab110895628f80bd20103ab8d6"}], "groups": [{"id": "L1", "sourcePlays": 2, "src": "assets/audio/listening-group-1.mp3", "durationSeconds": 300.048, "pcmSeconds": 300.0, "bytes": 2400620, "sha256": "31385213e5034f08682d083d2812eb13be9ef08e1e2fdfa59b2d7ea904a5361e"}, {"id": "L2", "sourcePlays": 2, "src": "assets/audio/listening-group-2.mp3", "durationSeconds": 300.048, "pcmSeconds": 300.0, "bytes": 2400620, "sha256": "ef2421a4286380c9b7d3fcbafdf023b70bdbd9747e516b6bd514287439a6b0da"}, {"id": "L3", "sourcePlays": 2, "src": "assets/audio/listening-group-3.mp3", "durationSeconds": 300.048, "pcmSeconds": 300.0, "bytes": 2400620, "sha256": "44f3971711759938f67732f254977d221d41f45de11ec3a7945b5975f19ea06f"}, {"id": "L4", "sourcePlays": 2, "src": "assets/audio/listening-group-4.mp3", "durationSeconds": 300.048, "pcmSeconds": 300.0, "bytes": 2400620, "sha256": "6b0b94ecb621b486aab4f7e08427eeb3c382c3b1b5c31061b0218b1a3aefb4a2"}], "timedTrack": {"src": "assets/audio/listening-full.mp3", "durationSeconds": 1200.048, "pcmSeconds": 1200.0, "bytes": 9600620, "sha256": "994d7668da781224e7e6c07bdc5ff6e7d1b8a59d9b55b6d0d85c990e135ed3d2"}, "timeline": [{"id": "C2A-M01", "questionNumber": 1, "previewStartSeconds": 0.0, "labelStartSeconds": 5.0, "firstPlayStartSeconds": 8.0, "secondPlayStartSeconds": 22.248, "speechEndSeconds": 34.996, "answerWindowSeconds": 23.504, "transitionSeconds": 1.5, "slotEndSeconds": 60.0, "sourcePlays": 2}, {"id": "C2A-M02", "questionNumber": 2, "previewStartSeconds": 60.0, "labelStartSeconds": 65.0, "firstPlayStartSeconds": 68.0, "secondPlayStartSeconds": 80.684, "speechEndSeconds": 91.868, "answerWindowSeconds": 26.632, "transitionSeconds": 1.5, "slotEndSeconds": 120.0, "sourcePlays": 2}, {"id": "C2A-M03", "questionNumber": 3, "previewStartSeconds": 120.0, "labelStartSeconds": 125.0, "firstPlayStartSeconds": 128.0, "secondPlayStartSeconds": 141.14, "speechEndSeconds": 152.78, "answerWindowSeconds": 25.72, "transitionSeconds": 1.5, "slotEndSeconds": 180.0, "sourcePlays": 2}, {"id": "C2A-M04", "questionNumber": 4, "previewStartSeconds": 180.0, "labelStartSeconds": 185.0, "firstPlayStartSeconds": 188.0, "secondPlayStartSeconds": 202.968, "speechEndSeconds": 216.436, "answerWindowSeconds": 22.064, "transitionSeconds": 1.5, "slotEndSeconds": 240.0, "sourcePlays": 2}, {"id": "C2A-M05", "questionNumber": 5, "previewStartSeconds": 240.0, "labelStartSeconds": 245.0, "firstPlayStartSeconds": 248.0, "secondPlayStartSeconds": 262.34, "speechEndSeconds": 275.18, "answerWindowSeconds": 23.32, "transitionSeconds": 1.5, "slotEndSeconds": 300.0, "sourcePlays": 2}, {"id": "C2A-M06", "questionNumber": 6, "previewStartSeconds": 300.0, "labelStartSeconds": 305.0, "firstPlayStartSeconds": 308.0, "secondPlayStartSeconds": 323.736, "speechEndSeconds": 337.972, "answerWindowSeconds": 20.528, "transitionSeconds": 1.5, "slotEndSeconds": 360.0, "sourcePlays": 2}, {"id": "C2A-M07", "questionNumber": 7, "previewStartSeconds": 360.0, "labelStartSeconds": 365.0, "firstPlayStartSeconds": 368.0, "secondPlayStartSeconds": 383.352, "speechEndSeconds": 397.204, "answerWindowSeconds": 21.296, "transitionSeconds": 1.5, "slotEndSeconds": 420.0, "sourcePlays": 2}, {"id": "C2A-M08", "questionNumber": 8, "previewStartSeconds": 420.0, "labelStartSeconds": 425.0, "firstPlayStartSeconds": 428.0, "secondPlayStartSeconds": 443.808, "speechEndSeconds": 458.116, "answerWindowSeconds": 20.384, "transitionSeconds": 1.5, "slotEndSeconds": 480.0, "sourcePlays": 2}, {"id": "C2A-M09", "questionNumber": 9, "previewStartSeconds": 480.0, "labelStartSeconds": 485.0, "firstPlayStartSeconds": 488.0, "secondPlayStartSeconds": 503.914, "speechEndSeconds": 518.328, "answerWindowSeconds": 20.172, "transitionSeconds": 1.5, "slotEndSeconds": 540.0, "sourcePlays": 2}, {"id": "C2A-M10", "questionNumber": 10, "previewStartSeconds": 540.0, "labelStartSeconds": 545.0, "firstPlayStartSeconds": 548.0, "secondPlayStartSeconds": 564.024, "speechEndSeconds": 578.548, "answerWindowSeconds": 19.952, "transitionSeconds": 1.5, "slotEndSeconds": 600.0, "sourcePlays": 2}, {"id": "C2A-M11", "questionNumber": 11, "previewStartSeconds": 600.0, "labelStartSeconds": 605.0, "firstPlayStartSeconds": 608.0, "secondPlayStartSeconds": 621.936, "speechEndSeconds": 634.372, "answerWindowSeconds": 24.128, "transitionSeconds": 1.5, "slotEndSeconds": 660.0, "sourcePlays": 2}, {"id": "C2A-M12", "questionNumber": 12, "previewStartSeconds": 660.0, "labelStartSeconds": 665.0, "firstPlayStartSeconds": 668.0, "secondPlayStartSeconds": 684.216, "speechEndSeconds": 698.932, "answerWindowSeconds": 19.568, "transitionSeconds": 1.5, "slotEndSeconds": 720.0, "sourcePlays": 2}, {"id": "C2A-M13", "questionNumber": 13, "previewStartSeconds": 720.0, "labelStartSeconds": 725.0, "firstPlayStartSeconds": 728.0, "secondPlayStartSeconds": 741.888, "speechEndSeconds": 754.276, "answerWindowSeconds": 24.224, "transitionSeconds": 1.5, "slotEndSeconds": 780.0, "sourcePlays": 2}, {"id": "C2A-M14", "questionNumber": 14, "previewStartSeconds": 780.0, "labelStartSeconds": 785.0, "firstPlayStartSeconds": 788.0, "secondPlayStartSeconds": 806.256, "speechEndSeconds": 823.012, "answerWindowSeconds": 15.488, "transitionSeconds": 1.5, "slotEndSeconds": 840.0, "sourcePlays": 2}, {"id": "C2A-M15", "questionNumber": 15, "previewStartSeconds": 840.0, "labelStartSeconds": 845.0, "firstPlayStartSeconds": 848.0, "secondPlayStartSeconds": 863.904, "speechEndSeconds": 878.308, "answerWindowSeconds": 20.192, "transitionSeconds": 1.5, "slotEndSeconds": 900.0, "sourcePlays": 2}, {"id": "C2A-M16", "questionNumber": 16, "previewStartSeconds": 900.0, "labelStartSeconds": 905.0, "firstPlayStartSeconds": 908.0, "secondPlayStartSeconds": 921.188, "speechEndSeconds": 932.876, "answerWindowSeconds": 25.624, "transitionSeconds": 1.5, "slotEndSeconds": 960.0, "sourcePlays": 2}, {"id": "C2A-M17", "questionNumber": 17, "previewStartSeconds": 960.0, "labelStartSeconds": 965.0, "firstPlayStartSeconds": 968.0, "secondPlayStartSeconds": 983.544, "speechEndSeconds": 997.588, "answerWindowSeconds": 20.912, "transitionSeconds": 1.5, "slotEndSeconds": 1020.0, "sourcePlays": 2}, {"id": "C2A-M18", "questionNumber": 18, "previewStartSeconds": 1020.0, "labelStartSeconds": 1025.0, "firstPlayStartSeconds": 1028.0, "secondPlayStartSeconds": 1045.512, "speechEndSeconds": 1061.524, "answerWindowSeconds": 16.976, "transitionSeconds": 1.5, "slotEndSeconds": 1080.0, "sourcePlays": 2}, {"id": "C2A-M19", "questionNumber": 19, "previewStartSeconds": 1080.0, "labelStartSeconds": 1085.0, "firstPlayStartSeconds": 1088.0, "secondPlayStartSeconds": 1104.428, "speechEndSeconds": 1119.356, "answerWindowSeconds": 19.144, "transitionSeconds": 1.5, "slotEndSeconds": 1140.0, "sourcePlays": 2}, {"id": "C2A-M20", "questionNumber": 20, "previewStartSeconds": 1140.0, "labelStartSeconds": 1145.0, "firstPlayStartSeconds": 1148.0, "secondPlayStartSeconds": 1162.292, "speechEndSeconds": 1175.084, "answerWindowSeconds": 23.416, "transitionSeconds": 1.5, "slotEndSeconds": 1200.0, "sourcePlays": 2}], "speakingPlannedMaximumSeconds": 410.304, "cache": [{"key": "9163d9feb9943551ec8e642a", "speaker": "female", "text": "今天的家务怎么分？你打扫客厅，我洗碗，好吗？", "sha256": "5a85fa0233dba7513e224dcd7c78e9ae19dfbfd9b50acb392ea091e7e1bc32a2"}, {"key": "fadb9c11b3247441b8b69dbe", "speaker": "male", "text": "我更想洗碗，客厅请你打扫，可以吗？", "sha256": "3e3f8a2e14bde08c29eacb5d433ee44d8e7d3a47d45664496b27ac8137f10da8"}, {"key": "31f216067e7eee9b4dee63f4", "speaker": "female", "text": "好，那就这样。", "sha256": "7d58431d0f2fd5c9b978cbe542d7d1ae69c73f924822372e7e1190c17fa1a582"}, {"key": "34e89f8d03ace2b111d8dc37", "speaker": "female", "text": "第1题。", "sha256": "3895df58b8b6ce61365216490dcb339db3aa7ef168eef8d2098c469073a4cdc2"}, {"key": "73cee90fde862b484c30d9c6", "speaker": "male", "text": "社区活动星期六十点开始。我九点要在家打扫厨房，九点半出门。活动十二点结束以后，我再去买菜。", "sha256": "b7fa782a60199e7ff280ae9f15a0b91d759bd756998ca33dc46dc518fd17186b"}, {"key": "1741fb60958696627ba5f0ed", "speaker": "female", "text": "第2题。", "sha256": "39f2c75a46983608745be0da5fe2130f1e77b5cd88f7b9b3928a0a06485a2744"}, {"key": "a73f53c0b9952ffb157c5cbf", "speaker": "female", "text": "我平时每天晚上洗碗，星期六和星期日不用洗，因为这两天爸爸做家务。我每个星期洗五次，每次大约十分钟。", "sha256": "6ffe63c176a773fd2dac5dfb740c08d7c70d9108a12ef7a01840ceb4a58f1a0d"}, {"key": "97e9c8d06f3e0171388ee24b", "speaker": "female", "text": "第3题。", "sha256": "74d7fdba0fd9fae146470574deadbd8616eca796fece18aaf8190b3792f4225e"}, {"key": "471e78af96c5cc573d97a7e3", "speaker": "male", "text": "你平时六点散步，今天也一样吗？", "sha256": "33a25f33b3024197eda8edac7167004d7fbfd181f9ab3753a8126bc438cdc1d8"}, {"key": "b41deb550cf0223eb687cc19", "speaker": "female", "text": "今天六点要开会，七点才下班。我想下班后走半个小时。", "sha256": "d138700765dc9619d3b4ccfb9f85d5c6b471fed62b6fc6ade0f78bcedd1d8cb3"}, {"key": "ce11862c436a80257829e484", "speaker": "male", "text": "那我七点在楼下等你。", "sha256": "cc620b9edb692e9d8560ead8b9616c69ef9d5051be181917bf32bc3e6f1a0a94"}, {"key": "b25d3caab3d72c3d0347de4b", "speaker": "female", "text": "第4题。", "sha256": "cc38e6d168e0664b2b8f98558b26288abcea294390f4e9aa13d8f457ef5a7046"}, {"key": "13961070c6573d13721f2771", "speaker": "female", "text": "小安最近每天晚上看电视到十二点，第二天起床总觉得累。昨天她十点就关了电视，今天早上起床的时候觉得舒服多了。", "sha256": "41875f3a34de98c111c4d150b83c6d88d1e9193f17b9ae08af77f2255ddbaf92"}, {"key": "c5b1d9675aba74bbd668ea00", "speaker": "female", "text": "第5题。", "sha256": "057a4202f7d25216a190a84d6056c30f42be93ac60cdc21879a97aaaf19252d9"}, {"key": "501dc6bae82e12c45c68d8bc", "speaker": "male", "text": "你现在去市场吗？", "sha256": "ca18717cd641333ba9b31a7c9748f4983ec6e988d18a941c4e327f7944a5a8c4"}, {"key": "51978713ea184fd659998ddc", "speaker": "female", "text": "不是，我先去图书馆还书。还完书再到对面的市场买菜，中午回家做饭。", "sha256": "e40cc6c53a194c2403f8e9aa51ac15c8840c743e12f4967b921fd10d5d33eb0d"}, {"key": "24feb3e3b704b7d30cde46e1", "speaker": "male", "text": "那我在图书馆门口等你。", "sha256": "bdc8715a0cb5479c9ac1e3b143bf2306a47bab07058083c914898b5e754db4cc"}, {"key": "5e6c5b336701fe2c48b7fa2f", "speaker": "female", "text": "第6题。", "sha256": "fcc5b0fabad8f1fa79148054a17b60ac8d2cb351d57ed0d5eb073df550e3ee93"}, {"key": "1bf111f9759687c1876828e9", "speaker": "female", "text": "去图书馆坐地铁只要十分钟，我们坐地铁吧。", "sha256": "f3709d650f07b3226864acfe6ae6f5a836108a380b114f2422e74f4ed419026f"}, {"key": "9ea7b49be8a54beedcd7af2e", "speaker": "male", "text": "今天地铁站不开门，还是坐公交车吧，二十分钟能到。", "sha256": "65a53a04e379fffbc5eaf4542e1907ad97928a05c10029731cfe3c6a0c3b532d"}, {"key": "b3f8c76fb0bacb3569dc2d72", "speaker": "female", "text": "好，我去车站等你。", "sha256": "d3c248f9d676b649094db8e4ccc20dcfd0175a08baa40a50345f5ab9e7321c24"}, {"key": "79e0bdfd02236c1d4253adc0", "speaker": "female", "text": "第7题。", "sha256": "5151859d99f51fb43c1c4ba74a72c7d8898fd12ebdb151ca350243f27169a52c"}, {"key": "9284d6e7f473235f50e46837", "speaker": "male", "text": "从车站到图书馆怎么走？", "sha256": "d0c50f4ff2c5b6eb23f71a4e7cde0d427b614606b3a44d9752be07fbeacdf673"}, {"key": "6c6fbcb55e42683894caa583", "speaker": "female", "text": "下车后先向右走，到第一个路口再向左。图书馆就在银行旁边，不用过马路。", "sha256": "fd0795546726817d721ecd9457ebd2d305cc836cb5df5a4e65eaa761979694fe"}, {"key": "7f1c230ce8401805a0b97608", "speaker": "male", "text": "好，我记住了。", "sha256": "54766fff917cffa8f9333bd1e38b56217521f8183efd10cc2d03328e2fef8e14"}, {"key": "b431efe26b8c6cc712ef43b8", "speaker": "female", "text": "第8题。", "sha256": "65ff1f952179bc643f6b488a3150eee5a21667f5901053151fd7aeb53f0c7786"}, {"key": "1cc90468b2f04bf4af78de1b", "speaker": "female", "text": "去图书馆有两条路。走河边比较近，可是没有灯；走商店那边远五分钟，但是一路都有灯。", "sha256": "4e93d8884b75b00003a2934991996db37dd987ce0a4e020560414b9897715610"}, {"key": "cf277f723e733731f3369646", "speaker": "male", "text": "现在天黑了，我不着急，走商店那边吧。", "sha256": "0cb485daf724c1a8b20a39a1ccb718135e8745b69cfb9eae67aa2186ab2a0ff8"}, {"key": "76f9b7034e5801a6360f40bd", "speaker": "female", "text": "第9题。", "sha256": "439f37e4f9738e7ac1dc180f588ae4ed900731c0623d4038b9f3533da20c0ada"}, {"key": "55b4933690b3a948281e5207", "speaker": "male", "text": "明天上午下雨，原来九点在公园见的活动怎么办？", "sha256": "1678dd12d690865a8413638edd776dd2bf2c184ec7f4b270fbabe03e8641edcb"}, {"key": "9f347a14fac2314f57c25084", "speaker": "female", "text": "改在图书馆吧。不过图书馆十点才开门，我们十点半见。", "sha256": "0e212e8c9c94dcc55502e64ce60131fde21e1da51b5833197bcf2a8cb2df7193"}, {"key": "9ef6358c2b9f04e60fdc89e0", "speaker": "male", "text": "好，就这么定了。", "sha256": "812ea31e0eef554456b22a1b25c0928bca1d85c41b09b30a20057b8efe020ac7"}, {"key": "86d64da7bc27367110de5cb7", "speaker": "female", "text": "第10题。", "sha256": "a443b83201af7bae91780e167c2fcd53ef523b448bf77dd4ad6b238de2e582d2"}, {"key": "40ac5923c2a7d175815397e4", "speaker": "female", "text": "我们四个人，一人一碗面，好吗？", "sha256": "170763e5838c820419ac3d407b6a14e7e11b04d3a5b318d18d22ef81008371b1"}, {"key": "ec1e4eec79d04e5c0b250a2e", "speaker": "male", "text": "我和哥哥想吃米饭，妈妈和妹妹吃面。", "sha256": "9c86223350733d35ec2ddb8b2ab095066c9c733129794f4bcc8324ee7675e9aa"}, {"key": "afdeab3306418808bc20d8cf", "speaker": "female", "text": "那就两碗面、两份米饭，再点一个菜。", "sha256": "e8ce68f9221f11a0734c8b6ba2e300cc512ab768727fefd1389e7ccfb958afc6"}, {"key": "63d3dd3f27ad85dca9aa0606", "speaker": "female", "text": "第11题。", "sha256": "09609165ce7b5b5bbc80de6236e7726415e2ab45d65241e1ca3c75ec4a697f32"}, {"key": "7e8db33982de2aba80369ee2", "speaker": "male", "text": "这件小号的衣服好看，你试过了吗？", "sha256": "002fedccac608fc9ae374ebe5de51166e72b0f050e094db2277840117c7cb422"}, {"key": "9149195ca33c0d6370755367", "speaker": "female", "text": "试过了，太小。我想买大号，颜色还是蓝色，不要红色。", "sha256": "a6df79089a9341eef9fe8712b27de885614dc149d1b74c4a4e99f64ba8f8c057"}, {"key": "5ed19b6e38a0868bc01e52df", "speaker": "male", "text": "好，我帮你找蓝色大号。", "sha256": "84370faf3048bcd2166dd392aa44452a3e3d3a06427cdf4a62d462db2177255e"}, {"key": "2dbff9b332f7edc61b4c3c18", "speaker": "female", "text": "第12题。", "sha256": "f25ea7d43ed9f81b7dd1af25fa0339498c7d458e79931122755e838f8d314a83"}, {"key": "19364a1ebfc4ce71072f7671", "speaker": "female", "text": "这份午饭十五块，汤另外三块。", "sha256": "3610762560a6725ce9e3de226e0278eeb78abcca244b9396ee47a42463d58dce"}, {"key": "5a29adfe2bfaedae377964f2", "speaker": "male", "text": "我只要午饭，不要汤。给你二十块。", "sha256": "fd986c4a22a56198c2ce65af195ac9b7179be30cff54f7c4dd56279fc1f3b613"}, {"key": "47d0ada06acc42e801f6a614", "speaker": "female", "text": "好的，午饭十五块，找你五块。", "sha256": "ea073575801ae67e489f2262527bdd97808a658d3c33d753d7ce79bb998fc13c"}, {"key": "ec1acc6c51d958bc6eb290a5", "speaker": "female", "text": "第13题。", "sha256": "e6515323a9eef38c0320124c2e99d81f002d229d597de7f44a76008521622c43"}, {"key": "609e4e810667e6bb060ff8fb", "speaker": "male", "text": "小林不吃辣，小周不吃肉，晚上点什么好？", "sha256": "7f2f6054c0aa290f9d259f7973db8823abda0ad142d176ab4703ff94b3f849c2"}, {"key": "356e2e62e6aef40c5ad387de", "speaker": "female", "text": "辣牛肉不行。鸡蛋面没有肉，也不辣，十八块；白菜汤虽然便宜，但大家想吃面。", "sha256": "0b13d3c935aedcbc83c7996fdcd7b79afab03dbb92b81ec8c112e652eb9ef5c9"}, {"key": "ee145cdd15b4fee78c2041ca", "speaker": "male", "text": "那就点鸡蛋面。", "sha256": "2c7d7b951f822ad03ba57bf6862ba9092d7512ba30c080bab954cecd55419027"}, {"key": "6a9458d981e42c448c56e5d7", "speaker": "female", "text": "第14题。", "sha256": "3c248ca1222db546caafa3ccef0afeb1d63689c8e501a91b906f7c38012bc8f4"}, {"key": "0b22c0ed8e55ce41005562de", "speaker": "female", "text": "家里没有牛奶了，你下班后去买两瓶吧。", "sha256": "e05977626b50db20a650f831abc16abc9e083aeba88e9303a93edff72b231191"}, {"key": "88de3deff03cd4fc7c8d8ac5", "speaker": "male", "text": "我今天五点要开会，商店六点关门，恐怕来不及。", "sha256": "79d0010b6738422f17fc5c406e89c060ba6f80b409fc6d8fbbba4da283d7f332"}, {"key": "000f943da5168cd46536caa5", "speaker": "female", "text": "那我现在去，你晚上回来洗碗就好。", "sha256": "1d15a45b1bdad54dd485b6e48939ce913500d8def933a87233ff5e74222ca581"}, {"key": "9d1b8c046279c5b498214791", "speaker": "female", "text": "第15题。", "sha256": "774136cf8893575562e62fc53ca824d970e119df2986004fbc9a795341529ed7"}, {"key": "58e9fddd77d9dc20eb848d88", "speaker": "male", "text": "今天早上有点儿冷，还下了小雨。天气预报说下午不下雨了，会出太阳，最高二十度。我们下午再去公园，不用现在出门。", "sha256": "7d8226effd137dbb4a202147c11a281aaeff209a7819f6d494969f4845b35b4e"}, {"key": "0cffbf1010d1e54023057ea9", "speaker": "female", "text": "第16题。", "sha256": "6cbe22b4463ef0127dbcb5957919648ee9b071c97d70d0b85edf327b6a0071df"}, {"key": "cb24394001fa9b237510da37", "speaker": "female", "text": "周日天气很好，为什么不在公园做活动？", "sha256": "a08f5bd66eee7f5fc6de62f79a6cb0456b046143b73cfbbb1df0acadb75dede4"}, {"key": "abb97a21622d2df148434df5", "speaker": "male", "text": "公园的门坏了，周日不开。我们改在社区中心，时间还是下午两点。", "sha256": "95a190609323c7ddfb95a7845aee2269a044a786cfcd6ab89c8d4cb22b3d1fbf"}, {"key": "fb11e97b5f64c93800e0e987", "speaker": "female", "text": "原来是这样。", "sha256": "de807918c11ea142f13c43526c6330485344cebbce607e1c734b2073d7b98745"}, {"key": "61f4d2e4e5f3e0536be36453", "speaker": "female", "text": "第17题。", "sha256": "7b303e3cdea4e6b338b981ca7d27218c5da50fd4e2ca1cb297c3ba0853fbff6b"}, {"key": "dbf795f0ef3f6cff38b51cd1", "speaker": "male", "text": "我今天想散步，但是只能走二十分钟。", "sha256": "c77d846bcd47b62b39edcb176f21210864c9150a58ac188f354cd625cb7652a6"}, {"key": "594ff42bc015edd51e401da0", "speaker": "female", "text": "去湖边来回要四十分钟，小区里的路来回十五分钟。你走完以后还可以休息一会儿。", "sha256": "29a38b10fb7d502270758387aa1e9f5acbf22aa5280cbce12371681a3678fcd0"}, {"key": "d947b2ac1067644ac4328ebe", "speaker": "male", "text": "好，就在小区里走。", "sha256": "b7642b21e64cc15286e021df43b9f1ae536570b097e669edf49d4e5faedec1a6"}, {"key": "2e9092b1191d42999a9f695d", "speaker": "female", "text": "第18题。", "sha256": "b0832c56a97774c35b538f689f08bf8314e263e14ab809871867bcdede27a70b"}, {"key": "579ee9832eba919808e5eb7b", "speaker": "female", "text": "上周我们去社区参加春节活动。先看小朋友唱歌，再跟老师写汉字。写完字以后，大家一起吃午饭。我第一次参加这样的活动，觉得很有意思。", "sha256": "3370f705081e296f86d670bb54ae150b7aa557ddbbaf8268ce023a70f62664b8"}, {"key": "ee9540a1a810afba0a3a7056", "speaker": "female", "text": "第19题。", "sha256": "91a1a230e642a4906da5e058c485a56cf6a1c77b67c899338da1843b7db5066e"}, {"key": "9d8b68093b15057923f3e018", "speaker": "male", "text": "第一次去社区春节活动的时候，小雨只想待半个小时。后来活动结束了，她还在问下次什么时候再办，又告诉妹妹下次一定要一起来。", "sha256": "d47a356c8dabe4d1629dac8bde3b279ad1126066ca20fef8b70ee135c0856aeb"}, {"key": "689adfbaa5b63ac16b96aac6", "speaker": "female", "text": "第20题。", "sha256": "f2a7aa65a74fad7dc9d19d81d6990ac99260287106ff304656efb599e75400e1"}, {"key": "96b5bbdad65f524e21a45ce8", "speaker": "female", "text": "星期六一起吃午饭吧。你有什么不想吃的，或者不能吃的东西？", "sha256": "7ad49bef295f189668a631f1925f05a2e88242021dba176119ed747301687743"}, {"key": "2c3ae610698699cd0a8383f8", "speaker": "female", "text": "店里有米饭，也有面条。你想选哪一种？也可以选别的。", "sha256": "b426df711ce91f23cd74c7870aa5e87f6dec3b8839e2249b47462d0eecea7e80"}, {"key": "4be6c1a08eea387d6eec79f0", "speaker": "female", "text": "你为什么想这样选？请给我说一个理由。", "sha256": "c23c9f7888f31337e8dec78fccadd07152becd5f424efa0bf1371910f0b46eb5"}, {"key": "d08e31433bda2fffd692bcb3", "speaker": "female", "text": "我十二点有事，一点才能到。你方便吗？不方便的话，可以怎么改？", "sha256": "d406cf1c5cb526d1691d4dced01dbb277ca820447cece83a9469dcfe4ecf9d28"}]}</script><script src="workspace.js" defer></script><noscript>Use the learner PDF and audio review if JavaScript is unavailable.</noscript></body></html>