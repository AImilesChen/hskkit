  "units": [
    {
      "id": "C2A-M01",
      "kind": "listening-source",
      "sourcePlays": 1,
      "script": [
        {
          "speaker": "female",
          "text": {
            "zh-Hans": "今天的家务怎么分？你打扫客厅，我洗碗，好吗？",
            "zh-Hant": "今天的家務怎麼分？你打掃客廳，我洗碗，好嗎？"
          }
        },
        {
          "speaker": "male",
          "text": {
            "zh-Hans": "我更想洗碗，客厅请你打扫，可以吗？",
            "zh-Hant": "我更想洗碗，客廳請你打掃，可以嗎？"
          }
        },
        {
          "speaker": "female",
          "text": {
            "zh-Hans": "好，那就这样。",
            "zh-Hant": "好，那就這樣。"
          }
        }
      ],
      "sourceDurationSeconds": 12.748,
      "src": "assets/audio/c2a-m01.mp3",
      "durationSeconds": 13.296,
      "pcmSeconds": 13.248,
      "bytes": 106604,
      "sha256": "7895ed5d3dc367050073cc81ce8ad6982b2e1883bd26deb9435527a318035aa8"
    },
    {
      "id": "C2A-M02",
      "kind": "listening-source",
      "sourcePlays": 1,
      "script": [
        {
          "speaker": "male",
          "text": {
            "zh-Hans": "社区活动星期六十点开始。我九点要在家打扫厨房，九点半出门。活动十二点结束以后，我再去买菜。",
            "zh-Hant": "社區活動星期六十點開始。我九點要在家打掃廚房，九點半出門。活動十二點結束以後，我再去買菜。"
          }
        }
      ],
      "sourceDurationSeconds": 11.184,
      "src": "assets/audio/c2a-m02.mp3",
      "durationSeconds": 11.736,
      "pcmSeconds": 11.684,
      "bytes": 94124,
      "sha256": "bd36a1e77e221c23e16bc46408770da9252696df35d91f89b00447f862d802c6"
    },
    {
      "id": "C2A-M03",
      "kind": "listening-source",
      "sourcePlays": 1,
      "script": [
        {
          "speaker": "female",
          "text": {
            "zh-Hans": "我平时每天晚上洗碗，星期六和星期日不用洗，因为这两天爸爸做家务。我每个星期洗五次，每次大约十分钟。",
            "zh-Hant": "我平時每天晚上洗碗，星期六和星期日不用洗，因爲這兩天爸爸做家務。我每個星期洗五次，每次大約十分鐘。"
          }
        }
      ],
      "sourceDurationSeconds": 11.64,
      "src": "assets/audio/c2a-m03.mp3",
      "durationSeconds": 12.192,
      "pcmSeconds": 12.14,
      "bytes": 97772,
      "sha256": "b4471f32b9782763774c89148270697469518b8820fbee03464e3229955c95be"
    },
    {
      "id": "C2A-M04",
      "kind": "listening-source",
      "sourcePlays": 1,
      "script": [
        {
          "speaker": "male",
          "text": {
            "zh-Hans": "你平时六点散步，今天也一样吗？",
            "zh-Hant": "你平時六點散步，今天也一樣嗎？"
          }
        },
        {
          "speaker": "female",
          "text": {
            "zh-Hans": "今天六点要开会，七点才下班。我想下班后走半个小时。",
            "zh-Hant": "今天六點要開會，七點才下班。我想下班後走半個小時。"
          }
        },
        {
          "speaker": "male",
          "text": {
            "zh-Hans": "那我七点在楼下等你。",
            "zh-Hant": "那我七點在樓下等你。"
          }
        }
      ],
      "sourceDurationSeconds": 13.468,
      "src": "assets/audio/c2a-m04.mp3",
      "durationSeconds": 14.016,
      "pcmSeconds": 13.968,
      "bytes": 112364,
      "sha256": "31b878b86a5071202e02fd9994575ad8eb5b31b793435a18242c5300f09b0e77"
    },
    {
      "id": "C2A-M05",
      "kind": "listening-source",
      "sourcePlays": 1,
      "script": [
        {
          "speaker": "female",
          "text": {
            "zh-Hans": "小安最近每天晚上看电视到十二点，第二天起床总觉得累。昨天她十点就关了电视，今天早上起床的时候觉得舒服多了。",
            "zh-Hant": "小安最近每天晚上看電視到十二點，第二天起牀總覺得累。昨天她十點就關了電視，今天早上起牀的時候覺得舒服多了。"
          }
        }
      ],
      "sourceDurationSeconds": 12.84,
      "src": "assets/audio/c2a-m05.mp3",
      "durationSeconds": 13.392,
      "pcmSeconds": 13.34,
      "bytes": 107372,
      "sha256": "542286a8837f37b8d49bf410974968a83bd36f04fb7ee0b9f0d9d63bea34cce4"
    },
    {
      "id": "C2A-M06",
      "kind": "listening-source",
      "sourcePlays": 1,
      "script": [
        {
          "speaker": "male",
          "text": {
            "zh-Hans": "你现在去市场吗？",
            "zh-Hant": "你現在去市場嗎？"
          }
        },
        {
          "speaker": "female",
          "text": {
            "zh-Hans": "不是，我先去图书馆还书。还完书再到对面的市场买菜，中午回家做饭。",
            "zh-Hant": "不是，我先去圖書館還書。還完書再到對面的市場買菜，中午回家做飯。"
          }
        },
        {
          "speaker": "male",
          "text": {
            "zh-Hans": "那我在图书馆门口等你。",
            "zh-Hant": "那我在圖書館門口等你。"
          }
        }
      ],
      "sourceDurationSeconds": 14.236,
      "src": "assets/audio/c2a-m06.mp3",
      "durationSeconds": 14.784,
      "pcmSeconds": 14.736,
      "bytes": 118508,
      "sha256": "bef63088807953db05979880e534a4b1002dabe47ca35dc2ba202ad7050dea73"
    },
    {
      "id": "C2A-M07",
      "kind": "listening-source",
      "sourcePlays": 1,
      "script": [
        {
          "speaker": "female",
          "text": {
            "zh-Hans": "去图书馆坐地铁只要十分钟，我们坐地铁吧。",
            "zh-Hant": "去圖書館坐地鐵只要十分鐘，我們坐地鐵吧。"
          }
        },
        {
          "speaker": "male",
          "text": {
            "zh-Hans": "今天地铁站不开门，还是坐公交车吧，二十分钟能到。",
            "zh-Hant": "今天地鐵站不開門，還是坐公交車吧，二十分鐘能到。"
          }
        },
        {
          "speaker": "female",
          "text": {
            "zh-Hans": "好，我去车站等你。",
            "zh-Hant": "好，我去車站等你。"
          }
        }
      ],
      "sourceDurationSeconds": 13.852,
      "src": "assets/audio/c2a-m07.mp3",
      "durationSeconds": 14.4,
      "pcmSeconds": 14.352,
      "bytes": 115436,
      "sha256": "e1720cacb5e79fe349ff78c3d2712ddd080c185be0d26fa831cf8c7eeaf42e0b"
    },
    {
      "id": "C2A-M08",
      "kind": "listening-source",
      "sourcePlays": 1,
      "script": [
        {
          "speaker": "male",
          "text": {
            "zh-Hans": "从车站到图书馆怎么走？",
            "zh-Hant": "從車站到圖書館怎麼走？"
          }
        },
        {
          "speaker": "female",
          "text": {
            "zh-Hans": "下车后先向右走，到第一个路口再向左。图书馆就在银行旁边，不用过马路。",
            "zh-Hant": "下車後先向右走，到第一個路口再向左。圖書館就在銀行旁邊，不用過馬路。"
          }
        },
        {
          "speaker": "male",
          "text": {
            "zh-Hans": "好，我记住了。",
            "zh-Hant": "好，我記住了。"
          }
        }
      ],
      "sourceDurationSeconds": 14.308,
      "src": "assets/audio/c2a-m08.mp3",
      "durationSeconds": 14.856,
      "pcmSeconds": 14.808,
      "bytes": 119084,
      "sha256": "5a528401ec6b5d8ddedea786cff982f47fa2c1b71587855c09f0424e71223709"
    },
    {
      "id": "C2A-M09",
      "kind": "listening-source",
      "sourcePlays": 1,
      "script": [
        {
          "speaker": "female",
          "text": {
            "zh-Hans": "去图书馆有两条路。走河边比较近，可是没有灯；走商店那边远五分钟，但是一路都有灯。",
            "zh-Hant": "去圖書館有兩條路。走河邊比較近，可是沒有燈；走商店那邊遠五分鐘，但是一路都有燈。"
          }
        },
        {
          "speaker": "male",
          "text": {
            "zh-Hans": "现在天黑了，我不着急，走商店那边吧。",
            "zh-Hant": "現在天黑了，我不着急，走商店那邊吧。"
          }
        }
      ],
      "sourceDurationSeconds": 14.414,
      "src": "assets/audio/c2a-m09.mp3",
      "durationSeconds": 14.976,
      "pcmSeconds": 14.914,
      "bytes": 120044,
      "sha256": "0d2cf26fcea8a18b8e7b92b386584eaef32d437a1d3c60c505f7907da603ab7d"
    },
    {
      "id": "C2A-M10",
      "kind": "listening-source",
      "sourcePlays": 1,
      "script": [
        {
          "speaker": "male",
          "text": {
            "zh-Hans": "明天上午下雨，原来九点在公园见的活动怎么办？",
            "zh-Hant": "明天上午下雨，原來九點在公園見的活動怎麼辦？"
          }
        },
        {
          "speaker": "female",
          "text": {
            "zh-Hans": "改在图书馆吧。不过图书馆十点才开门，我们十点半见。",
            "zh-Hant": "改在圖書館吧。不過圖書館十點纔開門，我們十點半見。"
          }
        },
        {
          "speaker": "male",
          "text": {
            "zh-Hans": "好，就这么定了。",
            "zh-Hant": "好，就這麼定了。"
          }
        }
      ],
      "sourceDurationSeconds": 14.524,
      "src": "assets/audio/c2a-m10.mp3",
      "durationSeconds": 15.072,
      "pcmSeconds": 15.024,
      "bytes": 120812,
      "sha256": "fa0a458fd3297e402d74074ebb7ccb1e0360dc974cba31e07714918de6f9017d"
    },
    {
      "id": "C2A-M11",
      "kind": "listening-source",
      "sourcePlays": 1,
      "script": [
        {
          "speaker": "female",
          "text": {
            "zh-Hans": "我们四个人，一人一碗面，好吗？",
            "zh-Hant": "我們四個人，一人一碗麪，好嗎？"
          }
        },
        {
          "speaker": "male",
          "text": {
            "zh-Hans": "我和哥哥想吃米饭，妈妈和妹妹吃面。",
            "zh-Hant": "我和哥哥想喫米飯，媽媽和妹妹喫麪。"
          }
        },
        {
          "speaker": "female",
          "text": {
            "zh-Hans": "那就两碗面、两份米饭，再点一个菜。",
            "zh-Hant": "那就兩碗麪、兩份米飯，再點一個菜。"
          }
        }
      ],
      "sourceDurationSeconds": 12.436,
      "src": "assets/audio/c2a-m11.mp3",
      "durationSeconds": 12.984,
      "pcmSeconds": 12.936,
      "bytes": 104108,
      "sha256": "4e23783dc6229e44f04af79234fb5902440518ec3d6f81ad214b51a019509a2c"
    },
    {
      "id": "C2A-M12",
      "kind": "listening-source",
      "sourcePlays": 1,
      "script": [
        {
          "speaker": "male",
          "text": {
            "zh-Hans": "这件小号的衣服好看，你试过了吗？",
            "zh-Hant": "這件小號的衣服好看，你試過了嗎？"
          }
        },
        {
          "speaker": "female",
          "text": {
            "zh-Hans": "试过了，太小。我想买大号，颜色还是蓝色，不要红色。",
            "zh-Hant": "試過了，太小。我想買大號，顏色還是藍色，不要紅色。"
          }
        },
        {
          "speaker": "male",
          "text": {
            "zh-Hans": "好，我帮你找蓝色大号。",
            "zh-Hant": "好，我幫你找藍色大號。"
          }
        }
      ],
      "sourceDurationSeconds": 14.716,
      "src": "assets/audio/c2a-m12.mp3",
      "durationSeconds": 15.264,
      "pcmSeconds": 15.216,
      "bytes": 122348,
      "sha256": "a092dcc6338474dc9b0232a465d6f175d4ba68216585879a8ca16b3ecae639b4"
    },
    {
      "id": "C2A-M13",
      "kind": "listening-source",
      "sourcePlays": 1,
      "script": [
        {
          "speaker": "female",
          "text": {
            "zh-Hans": "这份午饭十五块，汤另外三块。",
            "zh-Hant": "這份午飯十五塊，湯另外三塊。"
          }
        },
        {
          "speaker": "male",
          "text": {
            "zh-Hans": "我只要午饭，不要汤。给你二十块。",
            "zh-Hant": "我只要午飯，不要湯。給你二十塊。"
          }
        },
        {
          "speaker": "female",
          "text": {
            "zh-Hans": "好的，午饭十五块，找你五块。",
            "zh-Hant": "好的，午飯十五塊，找你五塊。"
          }
        }
      ],
      "sourceDurationSeconds": 12.388,
      "src": "assets/audio/c2a-m13.mp3",
      "durationSeconds": 12.936,
      "pcmSeconds": 12.888,
      "bytes": 103724,
      "sha256": "7493aaf23ce35d97d0c7be3deb17c8fac14c7bcad999574766cc6d83f85b52b3"
    },
    {
      "id": "C2A-M14",
      "kind": "listening-source",
      "sourcePlays": 1,
      "script": [
        {
          "speaker": "male",
          "text": {
            "zh-Hans": "小林不吃辣，小周不吃肉，晚上点什么好？",
            "zh-Hant": "小林不喫辣，小周不喫肉，晚上點什麼好？"
          }
        },
        {
          "speaker": "female",
          "text": {
            "zh-Hans": "辣牛肉不行。鸡蛋面没有肉，也不辣，十八块；白菜汤虽然便宜，但大家想吃面。",
            "zh-Hant": "辣牛肉不行。雞蛋麪沒有肉，也不辣，十八塊；白菜湯雖然便宜，但大家想喫麪。"
          }
        },
        {
          "speaker": "male",
          "text": {
            "zh-Hans": "那就点鸡蛋面。",
            "zh-Hant": "那就點雞蛋麪。"
          }
        }
      ],
      "sourceDurationSeconds": 16.756,
      "src": "assets/audio/c2a-m14.mp3",
      "durationSeconds": 17.304,
      "pcmSeconds": 17.256,
      "bytes": 138668,
      "sha256": "b87f27d3baea4bc9e190fb3eb5d14590c6a20e0169bd4a0127fcb04e838ac911"
    },
    {
      "id": "C2A-M15",
      "kind": "listening-source",
      "sourcePlays": 1,
      "script": [
        {
          "speaker": "female",
          "text": {
            "zh-Hans": "家里没有牛奶了，你下班后去买两瓶吧。",
            "zh-Hant": "家裏沒有牛奶了，你下班後去買兩瓶吧。"
          }
        },
        {
          "speaker": "male",
          "text": {
            "zh-Hans": "我今天五点要开会，商店六点关门，恐怕来不及。",
            "zh-Hant": "我今天五點要開會，商店六點關門，恐怕來不及。"
          }
        },
        {
          "speaker": "female",
          "text": {
            "zh-Hans": "那我现在去，你晚上回来洗碗就好。",
            "zh-Hant": "那我現在去，你晚上回來洗碗就好。"
          }
        }
      ],
      "sourceDurationSeconds": 14.404,
      "src": "assets/audio/c2a-m15.mp3",
      "durationSeconds": 14.952,
      "pcmSeconds": 14.904,
      "bytes": 119852,
      "sha256": "711b054caf3cacc5f689f768db2bbf426132b683e8b1bc399371411f62a7c4f3"
    },
    {
      "id": "C2A-M16",
      "kind": "listening-source",
      "sourcePlays": 1,
      "script": [
        {
          "speaker": "male",
          "text": {
            "zh-Hans": "今天早上有点儿冷，还下了小雨。天气预报说下午不下雨了，会出太阳，最高二十度。我们下午再去公园，不用现在出门。",
            "zh-Hant": "今天早上有點兒冷，還下了小雨。天氣預報說下午不下雨了，會出太陽，最高二十度。我們下午再去公園，不用現在出門。"
          }
        }
      ],
      "sourceDurationSeconds": 11.688,
      "src": "assets/audio/c2a-m16.mp3",
      "durationSeconds": 12.24,
      "pcmSeconds": 12.188,
      "bytes": 98156,
      "sha256": "02732a8f2c52881684d591d975958e286abd11d9e6475fa4cfa390041d845534"
    },
    {
      "id": "C2A-M17",
      "kind": "listening-source",
      "sourcePlays": 1,
      "script": [
        {
          "speaker": "female",
          "text": {
            "zh-Hans": "周日天气很好，为什么不在公园做活动？",
            "zh-Hant": "週日天氣很好，爲什麼不在公園做活動？"
          }
        },
        {
          "speaker": "male",
          "text": {
            "zh-Hans": "公园的门坏了，周日不开。我们改在社区中心，时间还是下午两点。",
            "zh-Hant": "公園的門壞了，週日不開。我們改在社區中心，時間還是下午兩點。"
          }
        },
        {
          "speaker": "female",
          "text": {
            "zh-Hans": "原来是这样。",
            "zh-Hant": "原來是這樣。"
          }
        }
      ],
      "sourceDurationSeconds": 14.044,
      "src": "assets/audio/c2a-m17.mp3",
      "durationSeconds": 14.592,
      "pcmSeconds": 14.544,
      "bytes": 116972,
      "sha256": "e2e4679bbb843b368e88da91b07e511619f25f46bc53027c0fa5a74f27f1a1b0"
    },
    {
      "id": "C2A-M18",
      "kind": "listening-source",
      "sourcePlays": 1,
      "script": [
        {
          "speaker": "male",
          "text": {
            "zh-Hans": "我今天想散步，但是只能走二十分钟。",
            "zh-Hant": "我今天想散步，但是隻能走二十分鐘。"
          }
        },
        {
          "speaker": "female",
          "text": {
            "zh-Hans": "去湖边来回要四十分钟，小区里的路来回十五分钟。你走完以后还可以休息一会儿。",
            "zh-Hant": "去湖邊來回要四十分鐘，小區裏的路來回十五分鐘。你走完以後還可以休息一會兒。"
          }
        },
        {
          "speaker": "male",
          "text": {
            "zh-Hans": "好，就在小区里走。",
            "zh-Hant": "好，就在小區裏走。"
          }
        }
      ],
      "sourceDurationSeconds": 16.012,
      "src": "assets/audio/c2a-m18.mp3",
      "durationSeconds": 16.56,
      "pcmSeconds": 16.512,
      "bytes": 132716,
      "sha256": "5808081b745368913b829a3890b55e8f89738b4037f65b834221b30da6a03638"
    },
    {
      "id": "C2A-M19",
      "kind": "listening-source",
      "sourcePlays": 1,
      "script": [
        {
          "speaker": "female",
          "text": {
            "zh-Hans": "上周我们去社区参加春节活动。先看小朋友唱歌，再跟老师写汉字。写完字以后，大家一起吃午饭。我第一次参加这样的活动，觉得很有意思。",
            "zh-Hant": "上週我們去社區參加春節活動。先看小朋友唱歌，再跟老師寫漢字。寫完字以後，大家一起喫午飯。我第一次參加這樣的活動，覺得很有意思。"
          }
        }
      ],
      "sourceDurationSeconds": 14.928,
      "src": "assets/audio/c2a-m19.mp3",
      "durationSeconds": 15.48,
      "pcmSeconds": 15.428,
      "bytes": 124076,
      "sha256": "5272f242d49ce298af6d8329fb30395badba8d6e9407fd791afe3d56760f9f3c"
    },
    {
      "id": "C2A-M20",
      "kind": "listening-source",
      "sourcePlays": 1,
      "script": [
        {
          "speaker": "male",
          "text": {
            "zh-Hans": "第一次去社区春节活动的时候，小雨只想待半个小时。后来活动结束了，她还在问下次什么时候再办，又告诉妹妹下次一定要一起来。",
            "zh-Hant": "第一次去社區春節活動的時候，小雨只想待半個小時。後來活動結束了，她還在問下次什麼時候再辦，又告訴妹妹下次一定要一起來。"
          }
        }
      ],
      "sourceDurationSeconds": 12.792,
      "src": "assets/audio/c2a-m20.mp3",
      "durationSeconds": 13.344,
      "pcmSeconds": 13.292,
      "bytes": 106988,
      "sha256": "1bb7ff8c552dc52a3c3394d610416311be159425ce1a0d295113463ce7f21d05"
    },
    {
      "id": "S1-1",
      "kind": "oral-prompt",
      "sourcePlays": 2,
      "singlePlayPcmSeconds": 6.552,
      "repeatGapSeconds": 1.5,
      "singlePlayPcmSha256": "eac4e7bc454fe478aed3046c6d39b4ab0e34ec30ce0ad90fa3e284aa553a236f",
      "script": {
        "zh-Hans": "星期六一起吃午饭吧。你有什么不想吃的，或者不能吃的东西？",
        "zh-Hant": "星期六一起喫午飯吧。你有什麼不想喫的，或者不能喫的東西？"
      },
      "src": "assets/audio/s1-1.mp3",
      "durationSeconds": 14.664,
      "pcmSeconds": 14.604,
      "bytes": 117548,
      "sha256": "b10c255930b9d575c5bec85b52629a157dd150a7e2bbc4429d2134a54027e922"
    },
    {
      "id": "S1-2",
      "kind": "oral-prompt",
      "sourcePlays": 2,
      "singlePlayPcmSeconds": 6.648,
      "repeatGapSeconds": 1.5,
      "singlePlayPcmSha256": "8cb8a84dd115ecaf41a3787d03f3bd09fab3ea6dfeda384af17d61418a144bd8",
      "script": {
        "zh-Hans": "店里有米饭，也有面条。你想选哪一种？也可以选别的。",
        "zh-Hant": "店裏有米飯，也有面條。你想選哪一種？也可以選別的。"
      },
      "src": "assets/audio/s1-2.mp3",
      "durationSeconds": 14.856,
      "pcmSeconds": 14.796,
      "bytes": 119084,
      "sha256": "c43a6bcad726fda2b6a2c0642b29063e6262fc31598bf0358414d8d31679d10a"
    },
    {
      "id": "S1-3",
      "kind": "oral-prompt",
      "sourcePlays": 2,
      "singlePlayPcmSeconds": 4.416,
      "repeatGapSeconds": 1.5,
      "singlePlayPcmSha256": "a4b3dbeb42038c83575db7c9c6f9d072e0dde0c6b4ea63626f47a33dd6f5603b",
      "script": {
        "zh-Hans": "你为什么想这样选？请给我说一个理由。",
        "zh-Hant": "你爲什麼想這樣選？請給我說一個理由。"
      },
      "src": "assets/audio/s1-3.mp3",
      "durationSeconds": 10.392,
      "pcmSeconds": 10.332,
      "bytes": 83372,
      "sha256": "bcd910c84c65b640d56fb45038c2acbad6cc71ff09d24a7b14bcc80b64a94c6c"
    },
    {
      "id": "S1-4",
      "kind": "oral-prompt",
      "sourcePlays": 2,
      "singlePlayPcmSeconds": 7.536,
      "repeatGapSeconds": 1.5,
      "singlePlayPcmSha256": "517551d3c9ab4156273306feeb05c61ab88a6fc9b16ad87061764ea67c63ddc4",
      "script": {
        "zh-Hans": "我十二点有事，一点才能到。你方便吗？不方便的话，可以怎么改？",
        "zh-Hant": "我十二點有事，一點才能到。你方便嗎？不方便的話，可以怎麼改？"
      },
      "src": "assets/audio/s1-4.mp3",
