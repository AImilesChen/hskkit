    },
    {
      "id": "C1B-M17",
      "kind": "listening-source",
      "sourcePlays": 1,
      "script": [
        {
          "speaker": "female",
          "text": {
            "zh-Hans": "今天下午什么时候能给你打电话？",
            "zh-Hant": "今天下午什麼時候能給你打電話？"
          }
        },
        {
          "speaker": "male",
          "text": {
            "zh-Hans": "三点我在上课，四点到家，五点出去。你四点打给我吧。",
            "zh-Hant": "三點我在上課，四點到家，五點出去。你四點打給我吧。"
          }
        }
      ],
      "sourceDurationSeconds": 10.526,
      "src": "assets/audio/c1b-m17.mp3",
      "durationSeconds": 11.088,
      "pcmSeconds": 11.026,
      "bytes": 88940,
      "sha256": "84e6aa2d3eeb32a3eced2b094916c7c2765c6c4954c3463c43e628faeabc4b64"
    },
    {
      "id": "C1B-M18",
      "kind": "listening-source",
      "sourcePlays": 1,
      "script": [
        {
          "speaker": "male",
          "text": {
            "zh-Hans": "我的白色运动鞋找不到了，你看见了吗？",
            "zh-Hant": "我的白色運動鞋找不到了，你看見了嗎？"
          }
        },
        {
          "speaker": "female",
          "text": {
            "zh-Hans": "门口有一双黑色的。",
            "zh-Hant": "門口有一雙黑色的。"
          }
        },
        {
          "speaker": "male",
          "text": {
            "zh-Hans": "黑色的是爸爸的，我的白鞋在床下面。",
            "zh-Hant": "黑色的是爸爸的，我的白鞋在牀下面。"
          }
        }
      ],
      "sourceDurationSeconds": 11.26,
      "src": "assets/audio/c1b-m18.mp3",
