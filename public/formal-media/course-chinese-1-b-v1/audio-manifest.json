    {
      "id": "C1B-M20",
      "kind": "listening-source",
      "sourcePlays": 1,
      "script": [
        {
          "speaker": "male",
          "text": {
            "zh-Hans": "下午先去打球，好吗？",
            "zh-Hant": "下午先去打球，好嗎？"
          }
        },
        {
          "speaker": "female",
          "text": {
            "zh-Hans": "我想先把这张画画完，然后去打球。",
            "zh-Hant": "我想先把這張畫畫完，然後去打球。"
          }
        },
        {
          "speaker": "male",
          "text": {
            "zh-Hans": "好的，你画完以后叫我，我在家等你。",
            "zh-Hant": "好的，你畫完以後叫我，我在家等你。"
          }
        }
      ],
