    {
      "id": "C1B-M01",
      "kind": "listening-source",
      "sourcePlays": 1,
      "script": [
        {
          "speaker": "male",
          "text": {
            "zh-Hans": "我家有五个人：爷爷、爸爸、妈妈、姐姐和我。姐姐在大学读书，我在中学上学。我们都住在一起。",
            "zh-Hant": "我家有五個人：爺爺、爸爸、媽媽、姐姐和我。姐姐在大學讀書，我在中學上學。我們都住在一起。"
          }
        }
      ],
      "sourceDurationSeconds": 10.728,
      "src": "assets/audio/c1b-m01.mp3",
