    },
    {
      "id": "C1B-M04",
      "kind": "listening-source",
      "sourcePlays": 1,
      "script": [
        {
          "speaker": "female",
          "text": {
            "zh-Hans": "你们好，我姓马，叫马文。我的中文老师姓林。今天王老师带我来这个班，我很高兴认识大家。",
            "zh-Hant": "你們好，我姓馬，叫馬文。我的中文老師姓林。今天王老師帶我來這個班，我很高興認識大家。"
          }
        }
      ],
      "sourceDurationSeconds": 10.272,
      "src": "assets/audio/c1b-m04.mp3",
      "durationSeconds": 10.824,
      "pcmSeconds": 10.772,
      "bytes": 86828,
      "sha256": "8c839062046c8f8f7da2412704f1fb80f1ac86b669b2e400ac929a29b1dfc91a"
    },
    {
      "id": "C1B-M05",
      "kind": "listening-source",
      "sourcePlays": 1,
      "script": [
        {
          "speaker": "male",
          "text": {
            "zh-Hans": "我们上午在教室上课，中午去学校食堂吃饭。下午下课后，大家常常去操场运动。今天我也去。",
            "zh-Hant": "我們上午在教室上課，中午去學校食堂喫飯。下午下課後，大家常常去操場運動。今天我也去。"
          }
        }
      ],
      "sourceDurationSeconds": 10.056,
      "src": "assets/audio/c1b-m05.mp3",
      "durationSeconds": 10.608,
      "pcmSeconds": 10.556,
      "bytes": 85100,
      "sha256": "59e7072218e64b7170b4202ae7132cb588131715d4939a439b89a8e97177658f"
    },
    {
      "id": "C1B-M06",
      "kind": "listening-source",
      "sourcePlays": 1,
      "script": [
        {
          "speaker": "female",
          "text": {
            "zh-Hans": "同学们，请把书包放在椅子上，不要放在地上。桌子上只放书和本子。现在我们开始上课。",
            "zh-Hant": "同學們，請把書包放在椅子上，不要放在地上。桌子上只放書和本子。現在我們開始上課。"
          }
        }
      ],
      "sourceDurationSeconds": 9.936,
      "src": "assets/audio/c1b-m06.mp3",
      "durationSeconds": 10.488,
      "pcmSeconds": 10.436,
      "bytes": 84140,
      "sha256": "be6e970ab7d6e12840575066daa3d4c1e0a95c01f8f5f0e5078a9c1ae547d201"
    },
    {
      "id": "C1B-M07",
      "kind": "listening-source",
      "sourcePlays": 1,
      "script": [
        {
          "speaker": "male",
          "text": {
            "zh-Hans": "老师，我今天能借三本书吗？",
            "zh-Hant": "老師，我今天能借三本書嗎？"
          }
        },
        {
          "speaker": "female",
          "text": {
            "zh-Hans": "每人一次只能借两本。你可以先选两本，明天还书以后再借。",
            "zh-Hant": "每人一次只能借兩本。你可以先選兩本，明天還書以後再借。"
          }
        }
      ],
      "sourceDurationSeconds": 11.222,
      "src": "assets/audio/c1b-m07.mp3",
      "durationSeconds": 11.784,
      "pcmSeconds": 11.722,
      "bytes": 94508,
      "sha256": "56423c2a538f6e5e4834230a135fb6070b3c1f98aa07df1091b9b2c0543b3e80"
    },
    {
      "id": "C1B-M08",
      "kind": "listening-source",
      "sourcePlays": 1,
      "script": [
        {
          "speaker": "female",
          "text": {
            "zh-Hans": "今天体育课还在教室吗？",
            "zh-Hant": "今天體育課還在教室嗎？"
          }
        },
        {
          "speaker": "male",
          "text": {
            "zh-Hans": "不，今天不下雨，我们去操场上课。",
            "zh-Hant": "不，今天不下雨，我們去操場上課。"
          }
        },
        {
          "speaker": "female",
          "text": {
            "zh-Hans": "好的，我叫同学们一起去操场。",
            "zh-Hant": "好的，我叫同學們一起去操場。"
          }
        }
      ],
      "sourceDurationSeconds": 11.332,
      "src": "assets/audio/c1b-m08.mp3",
      "durationSeconds": 11.88,
      "pcmSeconds": 11.832,
      "bytes": 95276,
      "sha256": "785ef3cd2aa9ef79b9f0856ce739f821fc8b47d2a451a3f1a3adecc63f8216ab"
    },
    {
      "id": "C1B-M09",
      "kind": "listening-source",
      "sourcePlays": 1,
      "script": [
        {
          "speaker": "female",
          "text": {
            "zh-Hans": "大家拿到纸了吗？请先在纸上写名字，再打开书。今天的练习很短，下课前我们一起看答案。",
            "zh-Hant": "大家拿到紙了嗎？請先在紙上寫名字，再打開書。今天的練習很短，下課前我們一起看答案。"
          }
        }
      ],
      "sourceDurationSeconds": 10.224,
      "src": "assets/audio/c1b-m09.mp3",
      "durationSeconds": 10.776,
      "pcmSeconds": 10.724,
      "bytes": 86444,
      "sha256": "7d48ae8144b436af73dbbb473e475226d39f564a4d50d9028f87815ee8af7d1d"
    },
    {
      "id": "C1B-M10",
      "kind": "listening-source",
      "sourcePlays": 1,
      "script": [
        {
          "speaker": "male",
          "text": {
            "zh-Hans": "老师，下午两点上课，我想课前问一个问题。",
            "zh-Hant": "老師，下午兩點上課，我想課前問一個問題。"
          }
        },
        {
          "speaker": "female",
          "text": {
            "zh-Hans": "可以，一点四十五来办公室吧。",
            "zh-Hant": "可以，一點四十五來辦公室吧。"
          }
        },
        {
          "speaker": "male",
          "text": {
            "zh-Hans": "好，我一点四十五到。",
            "zh-Hant": "好，我一點四十五到。"
          }
        }
      ],
      "sourceDurationSeconds": 12.364,
      "src": "assets/audio/c1b-m10.mp3",
      "durationSeconds": 12.912,
      "pcmSeconds": 12.864,
      "bytes": 103532,
      "sha256": "3a1dc0d8727513c9b242d3b62a9b97bedaa91dd1feea8b8fbc67465dfbdd2869"
    },
    {
      "id": "C1B-M11",
      "kind": "listening-source",
      "sourcePlays": 1,
      "script": [
        {
          "speaker": "male",
          "text": {
            "zh-Hans": "我要两个面包和一杯牛奶。",
            "zh-Hant": "我要兩個麪包和一杯牛奶。"
          }
        },
        {
          "speaker": "female",
          "text": {
            "zh-Hans": "面包卖完了，还有包子。",
            "zh-Hant": "麪包賣完了，還有包子。"
          }
        },
        {
          "speaker": "male",
          "text": {
            "zh-Hans": "那我要两个包子吧，牛奶还是一杯。",
            "zh-Hant": "那我要兩個包子吧，牛奶還是一杯。"
          }
        }
      ],
      "sourceDurationSeconds": 10.996,
      "src": "assets/audio/c1b-m11.mp3",
      "durationSeconds": 11.544,
      "pcmSeconds": 11.496,
      "bytes": 92588,
      "sha256": "fda72ae91b422b87243c208b83183ad4909b0a5da3ff973f9d9fae2173703df6"
    },
    {
      "id": "C1B-M12",
      "kind": "listening-source",
      "sourcePlays": 1,
      "script": [
        {
          "speaker": "female",
          "text": {
            "zh-Hans": "我们这桌要三杯热茶、两杯冷水。热茶给爸爸妈妈和奶奶，冷水给我和弟弟。请不要拿错了。",
            "zh-Hant": "我們這桌要三杯熱茶、兩杯冷水。熱茶給爸爸媽媽和奶奶，冷水給我和弟弟。請不要拿錯了。"
          }
        }
      ],
      "sourceDurationSeconds": 10.248,
      "src": "assets/audio/c1b-m12.mp3",
      "durationSeconds": 10.8,
      "pcmSeconds": 10.748,
      "bytes": 86636,
      "sha256": "db4916185c4477ba0c6748146f0049e90134747a83a6d5bef10891dba955e934"
    },
    {
      "id": "C1B-M13",
      "kind": "listening-source",
      "sourcePlays": 1,
      "script": [
        {
          "speaker": "male",
          "text": {
            "zh-Hans": "今天这些苹果怎么样？",
            "zh-Hant": "今天這些蘋果怎麼樣？"
          }
        },
        {
          "speaker": "female",
          "text": {
            "zh-Hans": "有点儿酸，香蕉很甜。",
            "zh-Hant": "有點兒酸，香蕉很甜。"
          }
        },
        {
          "speaker": "male",
          "text": {
            "zh-Hans": "我想买甜的。那我不要苹果了，买香蕉吧。",
            "zh-Hant": "我想買甜的。那我不要蘋果了，買香蕉吧。"
          }
        }
      ],
      "sourceDurationSeconds": 11.572,
      "src": "assets/audio/c1b-m13.mp3",
      "durationSeconds": 12.12,
      "pcmSeconds": 12.072,
      "bytes": 97196,
      "sha256": "f2d8bdefcd2b5ab3798c143f0a3763d0100bdb2ba76a83e44c59e09c1f6e2185"
    },
    {
      "id": "C1B-M14",
      "kind": "listening-source",
      "sourcePlays": 1,
      "script": [
        {
          "speaker": "male",
          "text": {
            "zh-Hans": "这杯豆浆多少钱？",
            "zh-Hant": "這杯豆漿多少錢？"
          }
        },
        {
          "speaker": "female",
          "text": {
            "zh-Hans": "九块。",
            "zh-Hant": "九塊。"
          }
        },
        {
          "speaker": "male",
          "text": {
            "zh-Hans": "给你十块。",
            "zh-Hant": "給你十塊。"
          }
        },
        {
          "speaker": "female",
          "text": {
            "zh-Hans": "谢谢，找你一块。豆浆有点儿热，请小心。",
            "zh-Hant": "謝謝，找你一塊。豆漿有點兒熱，請小心。"
          }
        }
      ],
      "sourceDurationSeconds": 12.042,
      "src": "assets/audio/c1b-m14.mp3",
      "durationSeconds": 12.6,
      "pcmSeconds": 12.542,
      "bytes": 101036,
      "sha256": "5a19ebaaa9d74c9067743960b8bf3c96ef4bf05a9c39fdfe71050f66e8433f81"
    },
    {
      "id": "C1B-M15",
      "kind": "listening-source",
      "sourcePlays": 1,
      "script": [
        {
          "speaker": "female",
          "text": {
            "zh-Hans": "门口有一件外套、一条围巾和一顶帽子。外套是我的，围巾是姐姐的，帽子是弟弟的。我们都找到了。",
            "zh-Hant": "門口有一件外套、一條圍巾和一頂帽子。外套是我的，圍巾是姐姐的，帽子是弟弟的。我們都找到了。"
          }
        }
      ],
      "sourceDurationSeconds": 10.992,
      "src": "assets/audio/c1b-m15.mp3",
      "durationSeconds": 11.544,
      "pcmSeconds": 11.492,
      "bytes": 92588,
      "sha256": "7244f86e3de7416b9da63500c4a79bdf09494476c2862f774df468f4f92af11a"
    },
    {
      "id": "C1B-M16",
      "kind": "listening-source",
      "sourcePlays": 1,
      "script": [
        {
          "speaker": "male",
          "text": {
            "zh-Hans": "明天上午一起去买东西吧，十点见，好吗？",
            "zh-Hant": "明天上午一起去買東西吧，十點見，好嗎？"
          }
        },
        {
          "speaker": "female",
          "text": {
            "zh-Hans": "好，我八点吃早饭，十二点要回家。十点见正好。",
            "zh-Hant": "好，我八點喫早飯，十二點要回家。十點見正好。"
          }
        }
      ],
      "sourceDurationSeconds": 11.03,
      "src": "assets/audio/c1b-m16.mp3",
