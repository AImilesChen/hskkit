    },
    {
      "id": "C1B-M02",
      "kind": "listening-source",
      "sourcePlays": 1,
      "script": [
        {
          "speaker": "female",
          "text": {
            "zh-Hans": "我妈妈是医生，星期六也要去医院。爸爸星期六不工作，在家做饭。我和哥哥下午一起回家吃饭。",
            "zh-Hant": "我媽媽是醫生，星期六也要去醫院。爸爸星期六不工作，在家做飯。我和哥哥下午一起回家喫飯。"
          }
        }
      ],
      "sourceDurationSeconds": 10.512,
      "src": "assets/audio/c1b-m02.mp3",
      "durationSeconds": 11.064,
      "pcmSeconds": 11.012,
      "bytes": 88748,
      "sha256": "ff5476648428fdde4c063a9432900805f4c54b530ea88a61574122c1dea4c57d"
    },
    {
      "id": "C1B-M03",
      "kind": "listening-source",
      "sourcePlays": 1,
      "script": [
        {
          "speaker": "male",
          "text": {
            "zh-Hans": "我们拍全家照时，爷爷坐在中间。爸爸站在爷爷左边，妈妈在右边。姐姐和我站在后面。",
            "zh-Hant": "我們拍全家照時，爺爺坐在中間。爸爸站在爺爺左邊，媽媽在右邊。姐姐和我站在後面。"
          }
        }
      ],
      "sourceDurationSeconds": 9.12,
      "src": "assets/audio/c1b-m03.mp3",
