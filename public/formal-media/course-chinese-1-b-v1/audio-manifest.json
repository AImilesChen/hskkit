      "pcmSeconds": 11.76,
      "bytes": 94700,
      "sha256": "de33e0fe98aa162b174259b3ce6c68d73fca785199270d2991d105242db45739"
    },
    {
      "id": "C1B-M19",
      "kind": "listening-source",
      "sourcePlays": 1,
      "script": [
        {
          "speaker": "female",
          "text": {
            "zh-Hans": "你这周有什么活动？",
            "zh-Hant": "你這周有什麼活動？"
          }
        },
        {
          "speaker": "male",
          "text": {
            "zh-Hans": "星期三下午去游泳，星期五下午去公园。我喜欢游泳，也喜欢和朋友在公园走走。",
            "zh-Hant": "星期三下午去游泳，星期五下午去公園。我喜歡游泳，也喜歡和朋友在公園走走。"
          }
        }
      ],
      "sourceDurationSeconds": 11.174,
      "src": "assets/audio/c1b-m19.mp3",
