<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="robots" content="noindex,nofollow"><title>Optional practice support</title><base href="/api/v1/course-tests/chinese-1/b/file/"><link rel="stylesheet" href="paper.css"></head><body><main><header class="hero"><p class="eyebrow">HSKKit · Chinese 1 Course Review · Original Paper B</p><h1>Optional practice support</h1><p>40 listening/reading questions + 4 writing/speaking tasks. Independent course-review draft.</p><p class="note">Printable materials and answer references. Open the workspace to practise with section clocks and local recording. Writing and speaking need manual review.</p><nav class="links"><a href="index.html">Overview</a><a href="student.html">Learner paper</a><a href="teacher.html">Answers &amp; scripts</a><a href="listening.html">Listen to Paper B</a><a href="student.pdf">Learner PDF</a><a href="student-traditional.pdf">繁體 PDF</a><a href="teacher.pdf">Answer PDF</a></nav></header><section class="box"><p>This optional preparation list is not part of the timed paper. Using it during an attempt changes the support condition.</p><table><tr><th>Chinese</th><th>Pinyin</th><th>Meaning</th></tr><tr><td class="cn">围巾</td><td>wéijīn</td><td>scarf</td></tr><tr><td class="cn">运动鞋</td><td>yùndòngxié</td><td>sports shoes</td></tr><tr><td class="cn">毛衣</td><td>máoyī</td><td>sweater</td></tr><tr><td class="cn">T恤</td><td>T xù</td><td>T-shirt</td></tr><tr><td class="cn">包子</td><td>bāozi</td><td>steamed bun</td></tr><tr><td class="cn">豆浆</td><td>dòujiāng</td><td>soy milk</td></tr><tr><td class="cn">酸</td><td>suān</td><td>sour</td></tr><tr><td class="cn">甜</td><td>tián</td><td>sweet</td></tr><tr><td class="cn">青菜</td><td>qīngcài</td><td>green vegetables</td></tr><tr><td class="cn">书架</td><td>shūjià</td><td>bookshelf</td></tr><tr><td class="cn">体育馆</td><td>tǐyùguǎn</td><td>sports hall</td></tr><tr><td class="cn">操场</td><td>cāochǎng</td><td>playground / sports field</td></tr><tr><td class="cn">窗户</td><td>chuānghu</td><td>window</td></tr><tr><td class="cn">擦黑板</td><td>cā hēibǎn</td><td>clean the board</td></tr><tr><td class="cn">游泳</td><td>yóuyǒng</td><td>swim</td></tr><tr><td class="cn">跳舞</td><td>tiàowǔ</td><td>dance</td></tr><tr><td class="cn">散步</td><td>sànbù</td><td>take a walk</td></tr><tr><td class="cn">放学</td><td>fàngxué</td><td>finish school for the day</td></tr></table></section></main></body></html>