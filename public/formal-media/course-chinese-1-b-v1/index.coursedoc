<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="robots" content="noindex,nofollow"><base href="/api/v1/course-tests/chinese-1/b/file/"><title>Chinese 1 · Paper B · HSKKit</title><link rel="stylesheet" href="workspace.css"></head><body><header class="bar"><a class="brand" href="/">HSKKit</a><a href="/chinese-course-tests">← Chinese 1 papers</a></header><div id="live" class="live" aria-live="polite"></div><div id="clockbar" class="clockbar" hidden><strong id="clock" role="timer"></strong><span id="oral-clock" role="timer"></span></div><div id="audio-dock" class="audio-dock" hidden><strong id="audio-label"></strong><audio id="listening-player" controls preload="metadata"></audio><p id="audio-error" role="alert" hidden>Audio could not load. Retry or open Audio review.</p></div><main id="app"></main><audio id="prompt-player" preload="none"></audio><footer><p>Independent HSKKit course review. Writing and speaking need manual review. Not an official school, HSK or ACTFL assessment.</p><a href="listening.html">Audio review</a> · <a href="teacher.html">Answer guide</a></footer><script id="paper-data" type="application/json">{"id": "course-chinese-1-b-v1", "product": "HSKKit Chinese 1 Course Review", "paperCode": "B", "version": "content-draft-v1", "authoredOn": "2026-11-09", "status": "content_complete_pending_audio_listening_and_teacher_pilot", "officialExam": false, "purpose": "Review the same published Chinese 1 scope with newly authored contexts and decisions; not an official school, ACTFL or HSK exam. Parallel-form difficulty has not been statistically calibrated.", "blueprint": {"id": "course-chinese-1-a-blueprint-v1", "source": "docs/course-level-stage1-20261109/chinese-1-blueprint.json", "sha256": "ac1b916e507d606ed48b308bf1f888f56d60d50dbe3437aa16984a32108d3856", "slotIdMapping": "Use the same slot numbers and group/theme labels; replace question id -a- with -b-."}, "provenance": {"original": true, "aiAssisted": true, "competitorQuestionsCopied": false, "relabelledHskQuestions": false, "humanListeningAcceptance": false, "teacherReview": false, "learnerPilot": false, "userAcceptance": false, "traditionalScript": "OpenCC s2t with author comparison; not independent native editorial certification"}, "order": ["listening", "reading", "writing", "speaking"], "sections": [{"id": "listening", "seconds": 900, "objectiveItems": 20, "groups": 4, "itemsPerGroup": 5, "sourcePlays": 2}, {"id": "reading", "seconds": 1200, "objectiveItems": 20, "groups": 4, "itemsPerGroup": 5}, {"id": "writing", "seconds": 900, "manualTasks": 2, "sharedClock": true}, {"id": "speaking", "seconds": 600, "manualTasks": 2}], "counts": {"listening": 20, "reading": 20, "writing": 2, "speaking": 2, "speakingRecordings": 5, "topLevelTasks": 44}, "scoring": {"listeningMax": 20, "readingMax": 20, "pointsPerObjectiveItem": 1, "incorrectOrUnansweredPoints": 0, "manualTaskMax": 8, "combinedScore": null, "passCutoff": null, "officialConversion": null, "unsubmittedManual": "unsubmitted", "technicalFailureManual": "needs_rerecording"}, "materials": [{"id": "C1B-M01", "title": "People at home", "section": "listening", "kind": "short-audio", "original": true, "script": [{"speaker": "male", "text": {"zh-Hans": "我家有五个人：爷爷、爸爸、妈妈、姐姐和我。姐姐在大学读书，我在中学上学。我们都住在一起。", "zh-Hant": "我家有五個人：爺爺、爸爸、媽媽、姐姐和我。姐姐在大學讀書，我在中學上學。我們都住在一起。"}}]}, {"id": "C1B-M02", "title": "Weekend family routines", "section": "listening", "kind": "short-audio", "original": true, "script": [{"speaker": "female", "text": {"zh-Hans": "我妈妈是医生，星期六也要去医院。爸爸星期六不工作，在家做饭。我和哥哥下午一起回家吃饭。", "zh-Hant": "我媽媽是醫生，星期六也要去醫院。爸爸星期六不工作，在家做飯。我和哥哥下午一起回家喫飯。"}}]}, {"id": "C1B-M03", "title": "A family photograph", "section": "listening", "kind": "short-audio", "original": true, "script": [{"speaker": "male", "text": {"zh-Hans": "我们拍全家照时，爷爷坐在中间。爸爸站在爷爷左边，妈妈在右边。姐姐和我站在后面。", "zh-Hant": "我們拍全家照時，爺爺坐在中間。爸爸站在爺爺左邊，媽媽在右邊。姐姐和我站在後面。"}}]}, {"id": "C1B-M04", "title": "Introducing a family name", "section": "listening", "kind": "short-audio", "original": true, "script": [{"speaker": "female", "text": {"zh-Hans": "你们好，我姓马，叫马文。我的中文老师姓林。今天王老师带我来这个班，我很高兴认识大家。", "zh-Hant": "你們好，我姓馬，叫馬文。我的中文老師姓林。今天王老師帶我來這個班，我很高興認識大家。"}}]}, {"id": "C1B-M05", "title": "A school day", "section": "listening", "kind": "short-audio", "original": true, "script": [{"speaker": "male", "text": {"zh-Hans": "我们上午在教室上课，中午去学校食堂吃饭。下午下课后，大家常常去操场运动。今天我也去。", "zh-Hant": "我們上午在教室上課，中午去學校食堂喫飯。下午下課後，大家常常去操場運動。今天我也去。"}}]}, {"id": "C1B-M06", "title": "Putting bags away", "section": "listening", "kind": "short-audio", "original": true, "script": [{"speaker": "female", "text": {"zh-Hans": "同学们，请把书包放在椅子上，不要放在地上。桌子上只放书和本子。现在我们开始上课。", "zh-Hant": "同學們，請把書包放在椅子上，不要放在地上。桌子上只放書和本子。現在我們開始上課。"}}]}, {"id": "C1B-M07", "title": "A library rule", "section": "listening", "kind": "short-audio", "original": true, "script": [{"speaker": "male", "text": {"zh-Hans": "老师，我今天能借三本书吗？", "zh-Hant": "老師，我今天能借三本書嗎？"}}, {"speaker": "female", "text": {"zh-Hans": "每人一次只能借两本。你可以先选两本，明天还书以后再借。", "zh-Hant": "每人一次只能借兩本。你可以先選兩本，明天還書以後再借。"}}]}, {"id": "C1B-M08", "title": "A lesson outside", "section": "listening", "kind": "short-audio", "original": true, "script": [{"speaker": "female", "text": {"zh-Hans": "今天体育课还在教室吗？", "zh-Hant": "今天體育課還在教室嗎？"}}, {"speaker": "male", "text": {"zh-Hans": "不，今天不下雨，我们去操场上课。", "zh-Hant": "不，今天不下雨，我們去操場上課。"}}, {"speaker": "female", "text": {"zh-Hans": "好的，我叫同学们一起去操场。", "zh-Hant": "好的，我叫同學們一起去操場。"}}]}, {"id": "C1B-M09", "title": "Before opening the book", "section": "listening", "kind": "short-audio", "original": true, "script": [{"speaker": "female", "text": {"zh-Hans": "大家拿到纸了吗？请先在纸上写名字，再打开书。今天的练习很短，下课前我们一起看答案。", "zh-Hant": "大家拿到紙了嗎？請先在紙上寫名字，再打開書。今天的練習很短，下課前我們一起看答案。"}}]}, {"id": "C1B-M10", "title": "Meeting before class", "section": "listening", "kind": "short-audio", "original": true, "script": [{"speaker": "male", "text": {"zh-Hans": "老师，下午两点上课，我想课前问一个问题。", "zh-Hant": "老師，下午兩點上課，我想課前問一個問題。"}}, {"speaker": "female", "text": {"zh-Hans": "可以，一点四十五来办公室吧。", "zh-Hant": "可以，一點四十五來辦公室吧。"}}, {"speaker": "male", "text": {"zh-Hans": "好，我一点四十五到。", "zh-Hant": "好，我一點四十五到。"}}]}, {"id": "C1B-M11", "title": "Breakfast is changing", "section": "listening", "kind": "short-audio", "original": true, "script": [{"speaker": "male", "text": {"zh-Hans": "我要两个面包和一杯牛奶。", "zh-Hant": "我要兩個麪包和一杯牛奶。"}}, {"speaker": "female", "text": {"zh-Hans": "面包卖完了，还有包子。", "zh-Hant": "麪包賣完了，還有包子。"}}, {"speaker": "male", "text": {"zh-Hans": "那我要两个包子吧，牛奶还是一杯。", "zh-Hant": "那我要兩個包子吧，牛奶還是一杯。"}}]}, {"id": "C1B-M12", "title": "Drinks for the table", "section": "listening", "kind": "short-audio", "original": true, "script": [{"speaker": "female", "text": {"zh-Hans": "我们这桌要三杯热茶、两杯冷水。热茶给爸爸妈妈和奶奶，冷水给我和弟弟。请不要拿错了。", "zh-Hant": "我們這桌要三杯熱茶、兩杯冷水。熱茶給爸爸媽媽和奶奶，冷水給我和弟弟。請不要拿錯了。"}}]}, {"id": "C1B-M13", "title": "Choosing sweeter fruit", "section": "listening", "kind": "short-audio", "original": true, "script": [{"speaker": "male", "text": {"zh-Hans": "今天这些苹果怎么样？", "zh-Hant": "今天這些蘋果怎麼樣？"}}, {"speaker": "female", "text": {"zh-Hans": "有点儿酸，香蕉很甜。", "zh-Hant": "有點兒酸，香蕉很甜。"}}, {"speaker": "male", "text": {"zh-Hans": "我想买甜的。那我不要苹果了，买香蕉吧。", "zh-Hant": "我想買甜的。那我不要蘋果了，買香蕉吧。"}}]}, {"id": "C1B-M14", "title": "Receiving change", "section": "listening", "kind": "short-audio", "original": true, "script": [{"speaker": "male", "text": {"zh-Hans": "这杯豆浆多少钱？", "zh-Hant": "這杯豆漿多少錢？"}}, {"speaker": "female", "text": {"zh-Hans": "九块。", "zh-Hant": "九塊。"}}, {"speaker": "male", "text": {"zh-Hans": "给你十块。", "zh-Hant": "給你十塊。"}}, {"speaker": "female", "text": {"zh-Hans": "谢谢，找你一块。豆浆有点儿热，请小心。", "zh-Hant": "謝謝，找你一塊。豆漿有點兒熱，請小心。"}}]}, {"id": "C1B-M15", "title": "Whose scarf is it?", "section": "listening", "kind": "short-audio", "original": true, "script": [{"speaker": "female", "text": {"zh-Hans": "门口有一件外套、一条围巾和一顶帽子。外套是我的，围巾是姐姐的，帽子是弟弟的。我们都找到了。", "zh-Hant": "門口有一件外套、一條圍巾和一頂帽子。外套是我的，圍巾是姐姐的，帽子是弟弟的。我們都找到了。"}}]}, {"id": "C1B-M16", "title": "Shopping before lunch", "section": "listening", "kind": "short-audio", "original": true, "script": [{"speaker": "male", "text": {"zh-Hans": "明天上午一起去买东西吧，十点见，好吗？", "zh-Hant": "明天上午一起去買東西吧，十點見，好嗎？"}}, {"speaker": "female", "text": {"zh-Hans": "好，我八点吃早饭，十二点要回家。十点见正好。", "zh-Hant": "好，我八點喫早飯，十二點要回家。十點見正好。"}}]}, {"id": "C1B-M17", "title": "A time to call", "section": "listening", "kind": "short-audio", "original": true, "script": [{"speaker": "female", "text": {"zh-Hans": "今天下午什么时候能给你打电话？", "zh-Hant": "今天下午什麼時候能給你打電話？"}}, {"speaker": "male", "text": {"zh-Hans": "三点我在上课，四点到家，五点出去。你四点打给我吧。", "zh-Hant": "三點我在上課，四點到家，五點出去。你四點打給我吧。"}}]}, {"id": "C1B-M18", "title": "Looking for shoes", "section": "listening", "kind": "short-audio", "original": true, "script": [{"speaker": "male", "text": {"zh-Hans": "我的白色运动鞋找不到了，你看见了吗？", "zh-Hant": "我的白色運動鞋找不到了，你看見了嗎？"}}, {"speaker": "female", "text": {"zh-Hans": "门口有一双黑色的。", "zh-Hant": "門口有一雙黑色的。"}}, {"speaker": "male", "text": {"zh-Hans": "黑色的是爸爸的，我的白鞋在床下面。", "zh-Hant": "黑色的是爸爸的，我的白鞋在牀下面。"}}]}, {"id": "C1B-M19", "title": "Two weekly outings", "section": "listening", "kind": "short-audio", "original": true, "script": [{"speaker": "female", "text": {"zh-Hans": "你这周有什么活动？", "zh-Hant": "你這周有什麼活動？"}}, {"speaker": "male", "text": {"zh-Hans": "星期三下午去游泳，星期五下午去公园。我喜欢游泳，也喜欢和朋友在公园走走。", "zh-Hant": "星期三下午去游泳，星期五下午去公園。我喜歡游泳，也喜歡和朋友在公園走走。"}}]}, {"id": "C1B-M20", "title": "After finishing a drawing", "section": "listening", "kind": "short-audio", "original": true, "script": [{"speaker": "male", "text": {"zh-Hans": "下午先去打球，好吗？", "zh-Hant": "下午先去打球，好嗎？"}}, {"speaker": "female", "text": {"zh-Hans": "我想先把这张画画完，然后去打球。", "zh-Hant": "我想先把這張畫畫完，然後去打球。"}}, {"speaker": "male", "text": {"zh-Hans": "好的，你画完以后叫我，我在家等你。", "zh-Hant": "好的，你畫完以後叫我，我在家等你。"}}]}, {"id": "C1B-M21", "title": "A birthday profile", "section": "reading", "kind": "text-card", "original": true, "text": {"zh-Hans": "姓名：田乐\n学校：青禾学校\n生日：六月十日\n哥哥生日：十月五日\n喜欢：看书、打篮球\n想认识喜欢运动的朋友。", "zh-Hant": "姓名：田樂\n學校：青禾學校\n生日：六月十日\n哥哥生日：十月五日\n喜歡：看書、打籃球\n想認識喜歡運動的朋友。"}}, {"id": "C1B-M22", "title": "Introducing a household", "section": "reading", "kind": "text-card", "original": true, "text": {"zh-Hans": "我叫小夏。我家有六个人：爷爷、奶奶、爸爸、妈妈、弟弟和我。我们住在学校旁边。弟弟明年也要上学。", "zh-Hant": "我叫小夏。我家有六個人：爺爺、奶奶、爸爸、媽媽、弟弟和我。我們住在學校旁邊。弟弟明年也要上學。"}}, {"id": "C1B-M23", "title": "Where family members work", "section": "reading", "kind": "text-card", "original": true, "text": {"zh-Hans": "我们家的工作地点\n爸爸：饭店，做饭。\n妈妈：学校，教英语。\n姐姐：商店，卖衣服。\n星期日晚上，我们常在家一起吃饭。", "zh-Hant": "我們家的工作地點\n爸爸：飯店，做飯。\n媽媽：學校，教英語。\n姐姐：商店，賣衣服。\n星期日晚上，我們常在家一起喫飯。"}}, {"id": "C1B-M24", "title": "An evening at home", "section": "reading", "kind": "text-card", "original": true, "text": {"zh-Hans": "阿东：\n我今天晚上不去你家了。哥哥要工作，爸爸妈妈要去买东西。我在家和妹妹吃饭，饭后和妹妹一起散步。\n小武", "zh-Hant": "阿東：\n我今天晚上不去你家了。哥哥要工作，爸爸媽媽要去買東西。我在家和妹妹喫飯，飯後和妹妹一起散步。\n小武"}}, {"id": "C1B-M25", "title": "A classroom seating note", "section": "reading", "kind": "text-card", "original": true, "text": {"zh-Hans": "新座位\n小青：门旁边。\n马力：窗户旁边。\n田乐：老师前面的第一排。\n下周一请大家按这个安排坐，不要拿错别人的书。", "zh-Hant": "新座位\n小青：門旁邊。\n馬力：窗戶旁邊。\n田樂：老師前面的第一排。\n下週一請大家按這個安排坐，不要拿錯別人的書。"}}, {"id": "C1B-M26", "title": "School library hours", "section": "reading", "kind": "text-card", "original": true, "text": {"zh-Hans": "学校图书馆通知\n星期四上午不开门，下午两点到五点可以借书。还书也请在这个时间来。星期五上午九点正常开门。", "zh-Hant": "學校圖書館通知\n星期四上午不開門，下午兩點到五點可以借書。還書也請在這個時間來。星期五上午九點正常開門。"}}, {"id": "C1B-M27", "title": "Finding the right book", "section": "reading", "kind": "text-card", "original": true, "text": {"zh-Hans": "同桌：\n你的英语书在后面的书架上，中文书在桌子上，练习本在椅子上。我先去吃饭，你拿到书以后来找我。\n小苏", "zh-Hant": "同桌：\n你的英語書在後面的書架上，中文書在桌子上，練習本在椅子上。我先去喫飯，你拿到書以後來找我。\n小蘇"}}, {"id": "C1B-M28", "title": "Classroom duties", "section": "reading", "kind": "text-card", "original": true, "text": {"zh-Hans": "放学前的工作\n赵平：擦黑板。\n田明：关窗户。\n小苏：把书放到书架上。\n请做完以后再回家。今天老师在办公室。", "zh-Hant": "放學前的工作\n趙平：擦黑板。\n田明：關窗戶。\n小蘇：把書放到書架上。\n請做完以後再回家。今天老師在辦公室。"}}, {"id": "C1B-M29", "title": "Meeting for sports", "section": "reading", "kind": "text-card", "original": true, "text": {"zh-Hans": "二班通知\n明天体育课，请大家下午两点到操场，不要在教室等。带水，穿运动鞋。下雨就改在体育馆，时间不变。", "zh-Hant": "二班通知\n明天體育課，請大家下午兩點到操場，不要在教室等。帶水，穿運動鞋。下雨就改在體育館，時間不變。"}}, {"id": "C1B-M30", "title": "A morning at school", "section": "reading", "kind": "text-card", "original": true, "text": {"zh-Hans": "周五上午\n8:00—9:00 中文课\n9:00—10:00 英语课\n10:00—10:30 休息\n10:30—11:30 数学课\n十一点半以后吃午饭。", "zh-Hant": "週五上午\n8:00—9:00 中文課\n9:00—10:00 英語課\n10:00—10:30 休息\n10:30—11:30 數學課\n十一點半以後喫午飯。"}}, {"id": "C1B-M31", "title": "Breakfast for sale", "section": "reading", "kind": "text-card", "original": true, "text": {"zh-Hans": "青禾食堂早餐\n面包：三元一个\n包子：两元一个\n热茶：两元一杯\n牛奶：四元一杯\n早上七点开始卖。今天不卖咖啡。", "zh-Hant": "青禾食堂早餐\n麪包：三元一個\n包子：兩元一個\n熱茶：兩元一杯\n牛奶：四元一杯\n早上七點開始賣。今天不賣咖啡。"}}, {"id": "C1B-M32", "title": "A lunch receipt", "section": "reading", "kind": "text-card", "original": true, "text": {"zh-Hans": "午饭小票\n米饭：两份\n面条：一份\n水：一瓶\n两份米饭放在一起，面条另外装。请拿好小票，到窗口取餐。", "zh-Hant": "午飯小票\n米飯：兩份\n麪條：一份\n水：一瓶\n兩份米飯放在一起，麪條另外裝。請拿好小票，到窗口取餐。"}}, {"id": "C1B-M33", "title": "What not to add", "section": "reading", "kind": "text-card", "original": true, "text": {"zh-Hans": "爸爸：\n今天我想吃面条，不想吃鸡蛋。请给我加一些青菜，不要加鸡蛋。弟弟想吃米饭。我们十二点到家。\n小禾", "zh-Hant": "爸爸：\n今天我想喫麪條，不想喫雞蛋。請給我加一些青菜，不要加雞蛋。弟弟想喫米飯。我們十二點到家。\n小禾"}}, {"id": "C1B-M34", "title": "Drinks for the family", "section": "reading", "kind": "text-card", "original": true, "text": {"zh-Hans": "请按这个单子买饮料：\n爸爸：不加糖的茶。\n妈妈：热咖啡。\n弟弟：苹果汁。\n买好后放在桌上，别拿错了。谢谢！", "zh-Hant": "請按這個單子買飲料：\n爸爸：不加糖的茶。\n媽媽：熱咖啡。\n弟弟：蘋果汁。\n買好後放在桌上，別拿錯了。謝謝！"}}, {"id": "C1B-M35", "title": "Collecting a clothing order", "section": "reading", "kind": "text-card", "original": true, "text": {"zh-Hans": "小方：\n我在商店买了一件大号黄色T恤，请你帮我拿回来。中号绿色那件是小田的，不要拿错。我的名字在袋子上。\n阿平", "zh-Hant": "小方：\n我在商店買了一件大號黃色T恤，請你幫我拿回來。中號綠色那件是小田的，不要拿錯。我的名字在袋子上。\n阿平"}}, {"id": "C1B-M36", "title": "When to return", "section": "reading", "kind": "text-card", "original": true, "text": {"zh-Hans": "小田：\n周日我下午四点去你家看书。五点半我要回家吃饭，不能留到六点。你觉得四点去可以吗？\n小余", "zh-Hant": "小田：\n週日我下午四點去你家看書。五點半我要回家喫飯，不能留到六點。你覺得四點去可以嗎？\n小余"}}, {"id": "C1B-M37", "title": "An evening to meet", "section": "reading", "kind": "text-card", "original": true, "text": {"zh-Hans": "我的晚上安排\n周一：上画画课。\n周二：去游泳。\n周三：在家，有空，可以和朋友见面。\n周四：和家人一起吃饭。", "zh-Hant": "我的晚上安排\n週一：上畫畫課。\n週二：去游泳。\n週三：在家，有空，可以和朋友見面。\n週四：和家人一起喫飯。"}}, {"id": "C1B-M38", "title": "Lost clothing note", "section": "reading", "kind": "text-card", "original": true, "text": {"zh-Hans": "找衣服\n我把一件绿色毛衣忘在公园了，上面写着“小田”。门口的白外套是小方的，不是我的。看到绿毛衣请告诉我。\n小田", "zh-Hant": "找衣服\n我把一件綠色毛衣忘在公園了，上面寫着“小田”。門口的白外套是小方的，不是我的。看到綠毛衣請告訴我。\n小田"}}, {"id": "C1B-M39", "title": "Singing after school", "section": "reading", "kind": "text-card", "original": true, "text": {"zh-Hans": "唱歌小组\n喜欢唱歌的同学，周四下午四点到二楼教室。王老师教大家唱新歌。画画小组在一楼，不要走错地方。", "zh-Hant": "唱歌小組\n喜歡唱歌的同學，週四下午四點到二樓教室。王老師教大家唱新歌。畫畫小組在一樓，不要走錯地方。"}}, {"id": "C1B-M40", "title": "An activity both friends like", "section": "reading", "kind": "text-card", "original": true, "text": {"zh-Hans": "李平：我喜欢跳舞，不喜欢画画。\n周月：我喜欢画画，也喜欢跳舞。\n两人想找一个都喜欢的活动，星期天下午一起去。", "zh-Hant": "李平：我喜歡跳舞，不喜歡畫畫。\n周月：我喜歡畫畫，也喜歡跳舞。\n兩人想找一個都喜歡的活動，星期天下午一起去。"}}], "questions": [{"id": "course-zh1-b-q01", "number": 1, "section": "listening", "group": "L1", "theme": "identity", "materialId": "C1B-M01", "target": "Identify an explicitly stated household size.", "promptEn": "How many people are in the speaker’s family?", "options": {"A": {"zh-Hans": "三个人", "zh-Hant": "三個人"}, "B": {"zh-Hans": "四个人", "zh-Hant": "四個人"}, "C": {"zh-Hans": "五个人", "zh-Hant": "五個人"}}, "correctAnswer": "C", "evidence": {"materialId": "C1B-M01", "quote": {"zh-Hans": "我家有五个人", "zh-Hant": "我家有五個人"}}, "explanation": {"en": "The speaker gives the family size as five.", "zh": "开头直接说明家里有五个人。"}, "distractors": {"A": {"en": "Three omits two of the five family members.", "zh": "三个人少于原文明确给出的五个人。"}, "B": {"en": "The speaker explicitly counts five, including himself.", "zh": "说话者把自己也算在内，明确说五个人。"}}, "reviewStatus": "author_self_checked_pending_teacher_and_user_review"}, {"id": "course-zh1-b-q02", "number": 2, "section": "listening", "group": "L1", "theme": "identity", "materialId": "C1B-M02", "target": "Match a family member to a weekend routine.", "promptEn": "Who stays home and cooks on Saturday?", "options": {"A": {"zh-Hans": "妈妈", "zh-Hant": "媽媽"}, "B": {"zh-Hans": "爸爸", "zh-Hant": "爸爸"}, "C": {"zh-Hans": "哥哥", "zh-Hant": "哥哥"}}, "correctAnswer": "B", "evidence": {"materialId": "C1B-M02", "quote": {"zh-Hans": "爸爸星期六不工作，在家做饭", "zh-Hant": "爸爸星期六不工作，在家做飯"}}, "explanation": {"en": "The father stays home and cooks.", "zh": "爸爸星期六在家做饭。"}, "distractors": {"A": {"en": "The mother goes to the hospital that day.", "zh": "妈妈周六也要去医院。"}, "C": {"en": "The brother returns in the afternoon; he is not said to cook.", "zh": "哥哥下午回家，原文没有说他做饭。"}}, "reviewStatus": "author_self_checked_pending_teacher_and_user_review"}, {"id": "course-zh1-b-q03", "number": 3, "section": "listening", "group": "L1", "theme": "identity", "materialId": "C1B-M03", "target": "Understand a familiar relationship and a simple position.", "promptEn": "Who is on Grandfather’s left?", "options": {"A": {"zh-Hans": "爸爸", "zh-Hant": "爸爸"}, "B": {"zh-Hans": "妈妈", "zh-Hant": "媽媽"}, "C": {"zh-Hans": "姐姐", "zh-Hant": "姐姐"}}, "correctAnswer": "A", "evidence": {"materialId": "C1B-M03", "quote": {"zh-Hans": "爸爸站在爷爷左边", "zh-Hant": "爸爸站在爺爺左邊"}}, "explanation": {"en": "The father stands on Grandfather’s left.", "zh": "爸爸在爷爷左边。"}, "distractors": {"B": {"en": "The mother is on the right.", "zh": "妈妈在爷爷右边。"}, "C": {"en": "The sister is behind him, not on the left.", "zh": "姐姐站在后面，不是左边。"}}, "reviewStatus": "author_self_checked_pending_teacher_and_user_review"}, {"id": "course-zh1-b-q04", "number": 4, "section": "listening", "group": "L1", "theme": "identity", "materialId": "C1B-M04", "target": "Distinguish the speaker’s surname from teachers’ surnames.", "promptEn": "What is the new student’s family name?", "options": {"A": {"zh-Hans": "林", "zh-Hant": "林"}, "B": {"zh-Hans": "王", "zh-Hant": "王"}, "C": {"zh-Hans": "马", "zh-Hant": "馬"}}, "correctAnswer": "C", "evidence": {"materialId": "C1B-M04", "quote": {"zh-Hans": "我姓马，叫马文", "zh-Hant": "我姓馬，叫馬文"}}, "explanation": {"en": "The student introduces the surname Ma.", "zh": "学生说自己姓马。"}, "distractors": {"A": {"en": "Lin is the Chinese teacher’s surname.", "zh": "林是中文老师的姓。"}, "B": {"en": "Wang is the teacher who brought the student to class.", "zh": "王是带学生来班里的老师的姓。"}}, "reviewStatus": "author_self_checked_pending_teacher_and_user_review"}, {"id": "course-zh1-b-q05", "number": 5, "section": "listening", "group": "L1", "theme": "school", "materialId": "C1B-M05", "target": "Locate a familiar school activity in the right place.", "promptEn": "Where do the students eat lunch?", "options": {"A": {"zh-Hans": "教室", "zh-Hant": "教室"}, "B": {"zh-Hans": "食堂", "zh-Hant": "食堂"}, "C": {"zh-Hans": "操场", "zh-Hant": "操場"}}, "correctAnswer": "B", "evidence": {"materialId": "C1B-M05", "quote": {"zh-Hans": "中午去学校食堂吃饭", "zh-Hant": "中午去學校食堂喫飯"}}, "explanation": {"en": "They go to the school canteen for lunch.", "zh": "他们中午到学校食堂吃饭。"}, "distractors": {"A": {"en": "They have lessons in the classroom, not lunch.", "zh": "教室是上课的地点。"}, "C": {"en": "They use the playground for exercise after class.", "zh": "操场是下课后运动的地点。"}}, "reviewStatus": "author_self_checked_pending_teacher_and_user_review"}, {"id": "course-zh1-b-q06", "number": 6, "section": "listening", "group": "L2", "theme": "school", "materialId": "C1B-M06", "target": "Follow a classroom placement instruction.", "promptEn": "Where should students put their bags?", "options": {"A": {"zh-Hans": "椅子上", "zh-Hant": "椅子上"}, "B": {"zh-Hans": "桌子上", "zh-Hant": "桌子上"}, "C": {"zh-Hans": "地上", "zh-Hant": "地上"}}, "correctAnswer": "A", "evidence": {"materialId": "C1B-M06", "quote": {"zh-Hans": "请把书包放在椅子上", "zh-Hant": "請把書包放在椅子上"}}, "explanation": {"en": "The instruction places bags on chairs.", "zh": "老师要求把书包放在椅子上。"}, "distractors": {"B": {"en": "Only books and notebooks belong on the desk.", "zh": "桌子上只放书和本子。"}, "C": {"en": "The teacher explicitly says not on the floor.", "zh": "老师明确说不要放在地上。"}}, "reviewStatus": "author_self_checked_pending_teacher_and_user_review"}, {"id": "course-zh1-b-q07", "number": 7, "section": "listening", "group": "L2", "theme": "school", "materialId": "C1B-M07", "target": "Understand a simple school borrowing limit.", "promptEn": "How many books may the student borrow at one time?", "options": {"A": {"zh-Hans": "一本", "zh-Hant": "一本"}, "B": {"zh-Hans": "两本", "zh-Hant": "兩本"}, "C": {"zh-Hans": "三本", "zh-Hant": "三本"}}, "correctAnswer": "B", "evidence": {"materialId": "C1B-M07", "quote": {"zh-Hans": "每人一次只能借两本", "zh-Hant": "每人一次只能借兩本"}}, "explanation": {"en": "The teacher explicitly limits borrowing to two books.", "zh": "老师说明一次只能借两本。"}, "distractors": {"A": {"en": "One is not the stated limit.", "zh": "规则没有把上限设为一本。"}, "C": {"en": "Three is requested but not allowed.", "zh": "三本是学生的请求，不符合规则。"}}, "reviewStatus": "author_self_checked_pending_teacher_and_user_review"}, {"id": "course-zh1-b-q08", "number": 8, "section": "listening", "group": "L2", "theme": "school", "materialId": "C1B-M08", "target": "Understand a changed class location.", "promptEn": "Where will today’s PE lesson take place?", "options": {"A": {"zh-Hans": "教室", "zh-Hant": "教室"}, "B": {"zh-Hans": "图书馆", "zh-Hant": "圖書館"}, "C": {"zh-Hans": "操场", "zh-Hant": "操場"}}, "correctAnswer": "C", "evidence": {"materialId": "C1B-M08", "quote": {"zh-Hans": "我们去操场上课", "zh-Hant": "我們去操場上課"}}, "explanation": {"en": "Both speakers confirm the playground.", "zh": "双方都确认去操场。"}, "distractors": {"A": {"en": "The teacher says today’s lesson is not in the classroom.", "zh": "老师否定了今天在教室上课。"}, "B": {"en": "The library is not mentioned as the lesson location.", "zh": "对话没有安排去图书馆上课。"}}, "reviewStatus": "author_self_checked_pending_teacher_and_user_review"}, {"id": "course-zh1-b-q09", "number": 9, "section": "listening", "group": "L2", "theme": "school", "materialId": "C1B-M09", "target": "Follow the order of two simple classroom actions.", "promptEn": "What should students do first?", "options": {"A": {"zh-Hans": "写名字", "zh-Hant": "寫名字"}, "B": {"zh-Hans": "打开书", "zh-Hant": "打開書"}, "C": {"zh-Hans": "看答案", "zh-Hant": "看答案"}}, "correctAnswer": "A", "evidence": {"materialId": "C1B-M09", "quote": {"zh-Hans": "请先在纸上写名字，再打开书", "zh-Hant": "請先在紙上寫名字，再打開書"}}, "explanation": {"en": "Writing a name comes before opening the book.", "zh": "老师要求先写名字，再打开书。"}, "distractors": {"B": {"en": "Opening the book is the second action.", "zh": "打开书是后面的动作。"}, "C": {"en": "Checking answers happens before the lesson ends, not first.", "zh": "一起看答案安排在下课前，不是最先。"}}, "reviewStatus": "author_self_checked_pending_teacher_and_user_review"}, {"id": "course-zh1-b-q10", "number": 10, "section": "listening", "group": "L2", "theme": "schedule", "materialId": "C1B-M10", "target": "Identify an appointment time before a lesson.", "promptEn": "When should the student meet the teacher?", "options": {"A": {"zh-Hans": "下午两点", "zh-Hant": "下午兩點"}, "B": {"zh-Hans": "下午一点四十五", "zh-Hant": "下午一點四十五"}, "C": {"zh-Hans": "下午两点十五", "zh-Hant": "下午兩點十五"}}, "correctAnswer": "B", "evidence": {"materialId": "C1B-M10", "quote": {"zh-Hans": "一点四十五来办公室吧", "zh-Hant": "一點四十五來辦公室吧"}}, "explanation": {"en": "The teacher gives one forty-five for the meeting.", "zh": "老师让学生一点四十五来。"}, "distractors": {"A": {"en": "Two o’clock is the class start, not the meeting.", "zh": "两点是上课时间，不是约见时间。"}, "C": {"en": "Two fifteen is not the agreed time.", "zh": "双方没有约定两点十五。"}}, "reviewStatus": "author_self_checked_pending_teacher_and_user_review"}, {"id": "course-zh1-b-q11", "number": 11, "section": "listening", "group": "L3", "theme": "food", "materialId": "C1B-M11", "target": "Identify a final food choice after an item becomes unavailable.", "promptEn": "What food does the customer finally order?", "options": {"A": {"zh-Hans": "面包", "zh-Hant": "麪包"}, "B": {"zh-Hans": "面条", "zh-Hant": "麪條"}, "C": {"zh-Hans": "包子", "zh-Hant": "包子"}}, "correctAnswer": "C", "evidence": {"materialId": "C1B-M11", "quote": {"zh-Hans": "那我要两个包子吧", "zh-Hant": "那我要兩個包子吧"}}, "explanation": {"en": "The final food order is two buns.", "zh": "最后顾客要两个包子。"}, "distractors": {"A": {"en": "Bread is unavailable, so the initial order changes.", "zh": "面包卖完了，顾客改变了原先的选择。"}, "B": {"en": "Noodles are not ordered.", "zh": "顾客没有点面条。"}}, "reviewStatus": "author_self_checked_pending_teacher_and_user_review"}, {"id": "course-zh1-b-q12", "number": 12, "section": "listening", "group": "L3", "theme": "food", "materialId": "C1B-M12", "target": "Connect a drink type to the correct quantity.", "promptEn": "How many cups of HOT TEA are requested?", "options": {"A": {"zh-Hans": "三杯", "zh-Hant": "三杯"}, "B": {"zh-Hans": "两杯", "zh-Hant": "兩杯"}, "C": {"zh-Hans": "五杯", "zh-Hant": "五杯"}}, "correctAnswer": "A", "evidence": {"materialId": "C1B-M12", "quote": {"zh-Hans": "三杯热茶、两杯冷水", "zh-Hant": "三杯熱茶、兩杯冷水"}}, "explanation": {"en": "Three cups of hot tea are requested.", "zh": "原文要求三杯热茶。"}, "distractors": {"B": {"en": "Two cups refers to cold water.", "zh": "两杯指冷水。"}, "C": {"en": "Five counts both kinds of drinks together.", "zh": "五杯把热茶和冷水合在一起了。"}}, "reviewStatus": "author_self_checked_pending_teacher_and_user_review"}, {"id": "course-zh1-b-q13", "number": 13, "section": "listening", "group": "L3", "theme": "food", "materialId": "C1B-M13", "target": "Use an explicit taste preference to identify a choice.", "promptEn": "Which fruit does the customer choose?", "options": {"A": {"zh-Hans": "苹果", "zh-Hant": "蘋果"}, "B": {"zh-Hans": "香蕉", "zh-Hant": "香蕉"}, "C": {"zh-Hans": "橙子", "zh-Hant": "橙子"}}, "correctAnswer": "B", "evidence": {"materialId": "C1B-M13", "quote": {"zh-Hans": "那我不要苹果了，买香蕉吧", "zh-Hant": "那我不要蘋果了，買香蕉吧"}}, "explanation": {"en": "The customer selects the sweet bananas.", "zh": "顾客选择甜的香蕉。"}, "distractors": {"A": {"en": "The customer rejects the sour apples.", "zh": "顾客不要有点酸的苹果。"}, "C": {"en": "Oranges are not discussed.", "zh": "对话没有提到橙子。"}}, "reviewStatus": "author_self_checked_pending_teacher_and_user_review"}, {"id": "course-zh1-b-q14", "number": 14, "section": "listening", "group": "L3", "theme": "food", "materialId": "C1B-M14", "target": "Distinguish explicitly stated change from price and payment.", "promptEn": "How much change does the customer receive?", "options": {"A": {"zh-Hans": "九块", "zh-Hant": "九塊"}, "B": {"zh-Hans": "十块", "zh-Hant": "十塊"}, "C": {"zh-Hans": "一块", "zh-Hant": "一塊"}}, "correctAnswer": "C", "evidence": {"materialId": "C1B-M14", "quote": {"zh-Hans": "找你一块", "zh-Hant": "找你一塊"}}, "explanation": {"en": "The seller explicitly returns one yuan.", "zh": "卖家直接说找一块。"}, "distractors": {"A": {"en": "Nine is the price.", "zh": "九块是豆浆的价格。"}, "B": {"en": "Ten is the amount paid.", "zh": "十块是顾客付出的金额。"}}, "reviewStatus": "author_self_checked_pending_teacher_and_user_review"}, {"id": "course-zh1-b-q15", "number": 15, "section": "listening", "group": "L3", "theme": "clothing", "materialId": "C1B-M15", "target": "Match a clothing item to its owner.", "promptEn": "Which item belongs to the older sister?", "options": {"A": {"zh-Hans": "围巾", "zh-Hant": "圍巾"}, "B": {"zh-Hans": "帽子", "zh-Hant": "帽子"}, "C": {"zh-Hans": "外套", "zh-Hant": "外套"}}, "correctAnswer": "A", "evidence": {"materialId": "C1B-M15", "quote": {"zh-Hans": "围巾是姐姐的", "zh-Hant": "圍巾是姐姐的"}}, "explanation": {"en": "The scarf belongs to the older sister.", "zh": "围巾是姐姐的。"}, "distractors": {"B": {"en": "The hat belongs to the younger brother.", "zh": "帽子是弟弟的。"}, "C": {"en": "The coat belongs to the speaker.", "zh": "外套是说话者自己的。"}}, "reviewStatus": "author_self_checked_pending_teacher_and_user_review"}, {"id": "course-zh1-b-q16", "number": 16, "section": "listening", "group": "L4", "theme": "schedule", "materialId": "C1B-M16", "target": "Identify an agreed meeting time between two other activities.", "promptEn": "When do they agree to meet?", "options": {"A": {"zh-Hans": "上午八点", "zh-Hant": "上午八點"}, "B": {"zh-Hans": "上午十点", "zh-Hant": "上午十點"}, "C": {"zh-Hans": "中午十二点", "zh-Hant": "中午十二點"}}, "correctAnswer": "B", "evidence": {"materialId": "C1B-M16", "quote": {"zh-Hans": "十点见正好", "zh-Hant": "十點見正好"}}, "explanation": {"en": "Both agree to meet at ten.", "zh": "双方约定上午十点见。"}, "distractors": {"A": {"en": "Eight is the girl’s breakfast time.", "zh": "八点是女生吃早饭的时间。"}, "C": {"en": "Noon is when she needs to return home.", "zh": "十二点是她要回家的时间。"}}, "reviewStatus": "author_self_checked_pending_teacher_and_user_review"}, {"id": "course-zh1-b-q17", "number": 17, "section": "listening", "group": "L4", "theme": "schedule", "materialId": "C1B-M17", "target": "Find a suitable contact time in a brief schedule.", "promptEn": "When should the girl call?", "options": {"A": {"zh-Hans": "下午四点", "zh-Hant": "下午四點"}, "B": {"zh-Hans": "下午三点", "zh-Hant": "下午三點"}, "C": {"zh-Hans": "下午五点", "zh-Hant": "下午五點"}}, "correctAnswer": "A", "evidence": {"materialId": "C1B-M17", "quote": {"zh-Hans": "你四点打给我吧", "zh-Hant": "你四點打給我吧"}}, "explanation": {"en": "The boy explicitly asks for a call at four.", "zh": "男生明确让她四点打电话。"}, "distractors": {"B": {"en": "He is in class at three.", "zh": "三点他在上课。"}, "C": {"en": "He goes out at five.", "zh": "五点他要出去。"}}, "reviewStatus": "author_self_checked_pending_teacher_and_user_review"}, {"id": "course-zh1-b-q18", "number": 18, "section": "listening", "group": "L4", "theme": "clothing", "materialId": "C1B-M18", "target": "Identify an item by owner and color.", "promptEn": "What color are the boy’s sports shoes?", "options": {"A": {"zh-Hans": "黑色", "zh-Hant": "黑色"}, "B": {"zh-Hans": "红色", "zh-Hant": "紅色"}, "C": {"zh-Hans": "白色", "zh-Hant": "白色"}}, "correctAnswer": "C", "evidence": {"materialId": "C1B-M18", "quote": {"zh-Hans": "我的白色运动鞋找不到了", "zh-Hant": "我的白色運動鞋找不到了"}}, "explanation": {"en": "The boy describes his own pair as white.", "zh": "男生说自己的运动鞋是白色的。"}, "distractors": {"A": {"en": "The black pair belongs to Dad.", "zh": "黑色鞋是爸爸的。"}, "B": {"en": "No red shoes are described.", "zh": "对话没有说到红鞋。"}}, "reviewStatus": "author_self_checked_pending_teacher_and_user_review"}, {"id": "course-zh1-b-q19", "number": 19, "section": "listening", "group": "L4", "theme": "leisure", "materialId": "C1B-M19", "target": "Read a weekday activity from a short spoken plan.", "promptEn": "What will the boy do on Wednesday afternoon?", "options": {"A": {"zh-Hans": "去公园", "zh-Hant": "去公園"}, "B": {"zh-Hans": "游泳", "zh-Hant": "游泳"}, "C": {"zh-Hans": "看电影", "zh-Hant": "看電影"}}, "correctAnswer": "B", "evidence": {"materialId": "C1B-M19", "quote": {"zh-Hans": "星期三下午去游泳", "zh-Hant": "星期三下午去游泳"}}, "explanation": {"en": "Swimming is the Wednesday activity.", "zh": "星期三下午去游泳。"}, "distractors": {"A": {"en": "The park visit is on Friday.", "zh": "去公园安排在星期五。"}, "C": {"en": "No film outing is planned.", "zh": "材料没有安排看电影。"}}, "reviewStatus": "author_self_checked_pending_teacher_and_user_review"}, {"id": "course-zh1-b-q20", "number": 20, "section": "listening", "group": "L4", "theme": "leisure", "materialId": "C1B-M20", "target": "Understand the order of two leisure activities.", "promptEn": "What will the girl do BEFORE playing ball?", "options": {"A": {"zh-Hans": "画画", "zh-Hant": "畫畫"}, "B": {"zh-Hans": "唱歌", "zh-Hant": "唱歌"}, "C": {"zh-Hans": "游泳", "zh-Hant": "游泳"}}, "correctAnswer": "A", "evidence": {"materialId": "C1B-M20", "quote": {"zh-Hans": "我想先把这张画画完，然后去打球", "zh-Hant": "我想先把這張畫畫完，然後去打球"}}, "explanation": {"en": "She first wants to finish her drawing.", "zh": "她想先把画画完，再去打球。"}, "distractors": {"B": {"en": "Singing is not part of the plan.", "zh": "计划没有唱歌。"}, "C": {"en": "Swimming is not mentioned.", "zh": "材料没有提到游泳。"}}, "reviewStatus": "author_self_checked_pending_teacher_and_user_review"}, {"id": "course-zh1-b-q21", "number": 21, "section": "reading", "group": "R1", "theme": "identity", "materialId": "C1B-M21", "target": "Identify a birthday month without confusing family members.", "promptEn": "In which month is Tian Le’s birthday?", "options": {"A": {"zh-Hans": "十月", "zh-Hant": "十月"}, "B": {"zh-Hans": "六月", "zh-Hant": "六月"}, "C": {"zh-Hans": "十二月", "zh-Hant": "十二月"}}, "correctAnswer": "B", "evidence": {"materialId": "C1B-M21", "quote": {"zh-Hans": "生日：六月十日", "zh-Hant": "生日：六月十日"}}, "explanation": {"en": "The profile gives Tian Le’s birthday as June 10.", "zh": "田乐的生日是六月十日。"}, "distractors": {"A": {"en": "October is the older brother’s birthday month.", "zh": "十月是哥哥生日所在月份。"}, "C": {"en": "December is not listed.", "zh": "资料没有出现十二月。"}}, "reviewStatus": "author_self_checked_pending_teacher_and_user_review"}, {"id": "course-zh1-b-q22", "number": 22, "section": "reading", "group": "R1", "theme": "identity", "materialId": "C1B-M22", "target": "Read an explicitly stated household size.", "promptEn": "How many people are in Xiaoxia’s family?", "options": {"A": {"zh-Hans": "四个人", "zh-Hant": "四個人"}, "B": {"zh-Hans": "五个人", "zh-Hant": "五個人"}, "C": {"zh-Hans": "六个人", "zh-Hant": "六個人"}}, "correctAnswer": "C", "evidence": {"materialId": "C1B-M22", "quote": {"zh-Hans": "我家有六个人", "zh-Hant": "我家有六個人"}}, "explanation": {"en": "The text explicitly states six people.", "zh": "正文直接写家里有六个人。"}, "distractors": {"A": {"en": "Four does not match the stated size.", "zh": "四个人与明确给出的家庭人数不符。"}, "B": {"en": "The household includes Xiaoxia as the sixth person.", "zh": "小夏自己也在家庭六个人之中。"}}, "reviewStatus": "author_self_checked_pending_teacher_and_user_review"}, {"id": "course-zh1-b-q23", "number": 23, "section": "reading", "group": "R1", "theme": "identity", "materialId": "C1B-M23", "target": "Match a workplace to a family member.", "promptEn": "Where does the mother work?", "options": {"A": {"zh-Hans": "学校", "zh-Hant": "學校"}, "B": {"zh-Hans": "饭店", "zh-Hant": "飯店"}, "C": {"zh-Hans": "商店", "zh-Hant": "商店"}}, "correctAnswer": "A", "evidence": {"materialId": "C1B-M23", "quote": {"zh-Hans": "妈妈：学校，教英语", "zh-Hant": "媽媽：學校，教英語"}}, "explanation": {"en": "The mother teaches English at a school.", "zh": "妈妈在学校教英语。"}, "distractors": {"B": {"en": "The father works at the restaurant.", "zh": "饭店是爸爸的工作地点。"}, "C": {"en": "The older sister works at the shop.", "zh": "商店是姐姐的工作地点。"}}, "reviewStatus": "author_self_checked_pending_teacher_and_user_review"}, {"id": "course-zh1-b-q24", "number": 24, "section": "reading", "group": "R1", "theme": "identity", "materialId": "C1B-M24", "target": "Identify a family activity partner in a short message.", "promptEn": "Who will Xiaowu take a walk with after dinner?", "options": {"A": {"zh-Hans": "哥哥", "zh-Hant": "哥哥"}, "B": {"zh-Hans": "爸爸妈妈", "zh-Hant": "爸爸媽媽"}, "C": {"zh-Hans": "妹妹", "zh-Hant": "妹妹"}}, "correctAnswer": "C", "evidence": {"materialId": "C1B-M24", "quote": {"zh-Hans": "饭后和妹妹一起散步", "zh-Hant": "飯後和妹妹一起散步"}}, "explanation": {"en": "The writer says he will walk with his younger sister.", "zh": "小武说饭后和妹妹一起散步。"}, "distractors": {"A": {"en": "The older brother has work; he is not the walking companion.", "zh": "哥哥要工作，没有安排与小武散步。"}, "B": {"en": "The parents go shopping.", "zh": "爸爸妈妈去买东西。"}}, "reviewStatus": "author_self_checked_pending_teacher_and_user_review"}, {"id": "course-zh1-b-q25", "number": 25, "section": "reading", "group": "R1", "theme": "school", "materialId": "C1B-M25", "target": "Locate a student’s place in a classroom plan.", "promptEn": "Where should Ma Li sit?", "options": {"A": {"zh-Hans": "窗户旁边", "zh-Hant": "窗戶旁邊"}, "B": {"zh-Hans": "门旁边", "zh-Hant": "門旁邊"}, "C": {"zh-Hans": "第一排", "zh-Hant": "第一排"}}, "correctAnswer": "A", "evidence": {"materialId": "C1B-M25", "quote": {"zh-Hans": "马力：窗户旁边", "zh-Hant": "馬力：窗戶旁邊"}}, "explanation": {"en": "The seating note puts Ma Li by the window.", "zh": "座位表把马力安排在窗户旁边。"}, "distractors": {"B": {"en": "The seat near the door is Xiaoqing’s.", "zh": "门旁边是小青的位置。"}, "C": {"en": "The first-row place is Tian Le’s.", "zh": "第一排的位置属于田乐。"}}, "reviewStatus": "author_self_checked_pending_teacher_and_user_review"}, {"id": "course-zh1-b-q26", "number": 26, "section": "reading", "group": "R2", "theme": "school", "materialId": "C1B-M26", "target": "Use a short school notice to identify an available time.", "promptEn": "When can students borrow books on Thursday?", "options": {"A": {"zh-Hans": "上午九点", "zh-Hant": "上午九點"}, "B": {"zh-Hans": "下午三点", "zh-Hant": "下午三點"}, "C": {"zh-Hans": "晚上七点", "zh-Hant": "晚上七點"}}, "correctAnswer": "B", "evidence": {"materialId": "C1B-M26", "quote": {"zh-Hans": "下午两点到五点可以借书", "zh-Hant": "下午兩點到五點可以借書"}}, "explanation": {"en": "Three is within Thursday’s two-to-five opening hours.", "zh": "下午三点在周四两点到五点开放时段内。"}, "distractors": {"A": {"en": "Nine in the morning refers to Friday, not Thursday.", "zh": "上午九点开门说的是星期五。"}, "C": {"en": "Seven in the evening is outside the stated hours.", "zh": "晚上七点不在通知给出的开放时段。"}}, "reviewStatus": "author_self_checked_pending_teacher_and_user_review"}, {"id": "course-zh1-b-q27", "number": 27, "section": "reading", "group": "R2", "theme": "school", "materialId": "C1B-M27", "target": "Match a school item to its location.", "promptEn": "Where is the English book?", "options": {"A": {"zh-Hans": "桌子上", "zh-Hant": "桌子上"}, "B": {"zh-Hans": "椅子上", "zh-Hant": "椅子上"}, "C": {"zh-Hans": "书架上", "zh-Hant": "書架上"}}, "correctAnswer": "C", "evidence": {"materialId": "C1B-M27", "quote": {"zh-Hans": "你的英语书在后面的书架上", "zh-Hant": "你的英語書在後面的書架上"}}, "explanation": {"en": "The English book is on the shelf at the back.", "zh": "英语书在后面的书架上。"}, "distractors": {"A": {"en": "The Chinese book is on the desk.", "zh": "桌子上放的是中文书。"}, "B": {"en": "The exercise book is on the chair.", "zh": "椅子上放的是练习本。"}}, "reviewStatus": "author_self_checked_pending_teacher_and_user_review"}, {"id": "course-zh1-b-q28", "number": 28, "section": "reading", "group": "R2", "theme": "school", "materialId": "C1B-M28", "target": "Read an assigned action from a classroom list.", "promptEn": "What should Tian Ming do?", "options": {"A": {"zh-Hans": "关窗户", "zh-Hant": "關窗戶"}, "B": {"zh-Hans": "擦黑板", "zh-Hant": "擦黑板"}, "C": {"zh-Hans": "把书放好", "zh-Hant": "把書放好"}}, "correctAnswer": "A", "evidence": {"materialId": "C1B-M28", "quote": {"zh-Hans": "田明：关窗户", "zh-Hant": "田明：關窗戶"}}, "explanation": {"en": "Closing the windows is Tian Ming’s duty.", "zh": "田明的任务是关窗户。"}, "distractors": {"B": {"en": "Cleaning the board is Zhao Ping’s duty.", "zh": "擦黑板是赵平的任务。"}, "C": {"en": "Putting books on the shelf is Xiaosu’s duty.", "zh": "把书放上书架是小苏的任务。"}}, "reviewStatus": "author_self_checked_pending_teacher_and_user_review"}, {"id": "course-zh1-b-q29", "number": 29, "section": "reading", "group": "R2", "theme": "school", "materialId": "C1B-M29", "target": "Follow a simple alternative location in a class notice.", "promptEn": "Where should students go if it rains?", "options": {"A": {"zh-Hans": "教室", "zh-Hant": "教室"}, "B": {"zh-Hans": "体育馆", "zh-Hant": "體育館"}, "C": {"zh-Hans": "操场", "zh-Hant": "操場"}}, "correctAnswer": "B", "evidence": {"materialId": "C1B-M29", "quote": {"zh-Hans": "下雨就改在体育馆", "zh-Hant": "下雨就改在體育館"}}, "explanation": {"en": "Rain moves the lesson to the sports hall.", "zh": "下雨就改到体育馆。"}, "distractors": {"A": {"en": "The notice tells students not to wait in the classroom.", "zh": "通知说不要在教室等。"}, "C": {"en": "The playground is the plan before the rain change.", "zh": "操场是不下雨时的原计划。"}}, "reviewStatus": "author_self_checked_pending_teacher_and_user_review"}, {"id": "course-zh1-b-q30", "number": 30, "section": "reading", "group": "R2", "theme": "schedule", "materialId": "C1B-M30", "target": "Distinguish the start and end of a break in a timetable.", "promptEn": "When does the break start?", "options": {"A": {"zh-Hans": "九点", "zh-Hant": "九點"}, "B": {"zh-Hans": "十点半", "zh-Hant": "十點半"}, "C": {"zh-Hans": "十点", "zh-Hant": "十點"}}, "correctAnswer": "C", "evidence": {"materialId": "C1B-M30", "quote": {"zh-Hans": "10:00—10:30 休息", "zh-Hant": "10:00—10:30 休息"}}, "explanation": {"en": "The break runs from ten to ten thirty.", "zh": "休息时段从十点开始。"}, "distractors": {"A": {"en": "Nine is when English begins.", "zh": "九点开始英语课。"}, "B": {"en": "Ten thirty is when the break ends and mathematics begins.", "zh": "十点半休息结束、数学课开始。"}}, "reviewStatus": "author_self_checked_pending_teacher_and_user_review"}, {"id": "course-zh1-b-q31", "number": 31, "section": "reading", "group": "R3", "theme": "food", "materialId": "C1B-M31", "target": "Read a simple availability statement on a menu.", "promptEn": "Which drink is NOT sold today?", "options": {"A": {"zh-Hans": "咖啡", "zh-Hant": "咖啡"}, "B": {"zh-Hans": "热茶", "zh-Hant": "熱茶"}, "C": {"zh-Hans": "牛奶", "zh-Hant": "牛奶"}}, "correctAnswer": "A", "evidence": {"materialId": "C1B-M31", "quote": {"zh-Hans": "今天不卖咖啡", "zh-Hant": "今天不賣咖啡"}}, "explanation": {"en": "The menu explicitly says coffee is not sold today.", "zh": "菜单明确写今天不卖咖啡。"}, "distractors": {"B": {"en": "Hot tea is listed for sale.", "zh": "菜单列有热茶。"}, "C": {"en": "Milk is listed for sale.", "zh": "菜单列有牛奶。"}}, "reviewStatus": "author_self_checked_pending_teacher_and_user_review"}, {"id": "course-zh1-b-q32", "number": 32, "section": "reading", "group": "R3", "theme": "food", "materialId": "C1B-M32", "target": "Read an item quantity from a simple receipt.", "promptEn": "Which item has TWO portions on the receipt?", "options": {"A": {"zh-Hans": "面条", "zh-Hant": "麪條"}, "B": {"zh-Hans": "米饭", "zh-Hant": "米飯"}, "C": {"zh-Hans": "水", "zh-Hant": "水"}}, "correctAnswer": "B", "evidence": {"materialId": "C1B-M32", "quote": {"zh-Hans": "米饭：两份", "zh-Hant": "米飯：兩份"}}, "explanation": {"en": "The receipt lists two portions of rice.", "zh": "小票写米饭两份。"}, "distractors": {"A": {"en": "The receipt lists only one portion of noodles.", "zh": "面条只有一份。"}, "C": {"en": "There is one bottle of water, not two portions.", "zh": "水是一瓶，不是两份。"}}, "reviewStatus": "author_self_checked_pending_teacher_and_user_review"}, {"id": "course-zh1-b-q33", "number": 33, "section": "reading", "group": "R3", "theme": "food", "materialId": "C1B-M33", "target": "Understand a food request expressed with negation.", "promptEn": "What does Xiaohe ask Dad NOT to add?", "options": {"A": {"zh-Hans": "青菜", "zh-Hant": "青菜"}, "B": {"zh-Hans": "米饭", "zh-Hant": "米飯"}, "C": {"zh-Hans": "鸡蛋", "zh-Hant": "雞蛋"}}, "correctAnswer": "C", "evidence": {"materialId": "C1B-M33", "quote": {"zh-Hans": "不要加鸡蛋", "zh-Hant": "不要加雞蛋"}}, "explanation": {"en": "Xiaohe twice says not to include eggs.", "zh": "小禾明确说不要加鸡蛋。"}, "distractors": {"A": {"en": "Xiaohe asks for vegetables to be added.", "zh": "小禾要求加一些青菜。"}, "B": {"en": "Rice is the younger brother’s meal; it is not the requested addition.", "zh": "米饭是弟弟想吃的，不是要求加的食材。"}}, "reviewStatus": "author_self_checked_pending_teacher_and_user_review"}, {"id": "course-zh1-b-q34", "number": 34, "section": "reading", "group": "R3", "theme": "food", "materialId": "C1B-M34", "target": "Match an order detail to the correct person.", "promptEn": "Who wants tea without sugar?", "options": {"A": {"zh-Hans": "爸爸", "zh-Hant": "爸爸"}, "B": {"zh-Hans": "妈妈", "zh-Hant": "媽媽"}, "C": {"zh-Hans": "弟弟", "zh-Hant": "弟弟"}}, "correctAnswer": "A", "evidence": {"materialId": "C1B-M34", "quote": {"zh-Hans": "爸爸：不加糖的茶", "zh-Hant": "爸爸：不加糖的茶"}}, "explanation": {"en": "Dad’s entry specifies tea without sugar.", "zh": "爸爸一栏写不加糖的茶。"}, "distractors": {"B": {"en": "Mum wants hot coffee.", "zh": "妈妈要热咖啡。"}, "C": {"en": "The younger brother wants apple juice.", "zh": "弟弟要苹果汁。"}}, "reviewStatus": "author_self_checked_pending_teacher_and_user_review"}, {"id": "course-zh1-b-q35", "number": 35, "section": "reading", "group": "R3", "theme": "clothing", "materialId": "C1B-M35", "target": "Read two clothing-order details while distinguishing ownership.", "promptEn": "Which T-shirt should Xiaofang collect for Aping?", "options": {"A": {"zh-Hans": "中号绿色", "zh-Hant": "中號綠色"}, "B": {"zh-Hans": "大号黄色", "zh-Hant": "大號黃色"}, "C": {"zh-Hans": "小号黄色", "zh-Hant": "小號黃色"}}, "correctAnswer": "B", "evidence": {"materialId": "C1B-M35", "quote": {"zh-Hans": "大号黄色T恤", "zh-Hant": "大號黃色T恤"}}, "explanation": {"en": "Aping bought the large yellow shirt.", "zh": "阿平买的是大号黄色T恤。"}, "distractors": {"A": {"en": "The medium green shirt belongs to Xiaotian.", "zh": "中号绿色那件是小田的。"}, "C": {"en": "The color matches but the requested size is large.", "zh": "颜色相同，但阿平要的是大号。"}}, "reviewStatus": "author_self_checked_pending_teacher_and_user_review"}, {"id": "course-zh1-b-q36", "number": 36, "section": "reading", "group": "R4", "theme": "schedule", "materialId": "C1B-M36", "target": "Separate an arrival time from a required return time.", "promptEn": "When does Xiaoyu need to go home?", "options": {"A": {"zh-Hans": "下午四点", "zh-Hant": "下午四點"}, "B": {"zh-Hans": "下午六点", "zh-Hant": "下午六點"}, "C": {"zh-Hans": "下午五点半", "zh-Hant": "下午五點半"}}, "correctAnswer": "C", "evidence": {"materialId": "C1B-M36", "quote": {"zh-Hans": "五点半我要回家吃饭", "zh-Hant": "五點半我要回家喫飯"}}, "explanation": {"en": "The writer needs to return home at five thirty.", "zh": "小余五点半要回家吃饭。"}, "distractors": {"A": {"en": "Four is the proposed arrival time.", "zh": "四点是计划到朋友家的时间。"}, "B": {"en": "The writer explicitly cannot stay until six.", "zh": "作者明确说不能留到六点。"}}, "reviewStatus": "author_self_checked_pending_teacher_and_user_review"}, {"id": "course-zh1-b-q37", "number": 37, "section": "reading", "group": "R4", "theme": "schedule", "materialId": "C1B-M37", "target": "Find explicitly stated availability rather than infer it from being home.", "promptEn": "On which evening is the writer explicitly free to meet friends?", "options": {"A": {"zh-Hans": "周三", "zh-Hant": "週三"}, "B": {"zh-Hans": "周一", "zh-Hant": "週一"}, "C": {"zh-Hans": "周二", "zh-Hant": "週二"}}, "correctAnswer": "A", "evidence": {"materialId": "C1B-M37", "quote": {"zh-Hans": "周三：在家，有空，可以和朋友见面", "zh-Hant": "週三：在家，有空，可以和朋友見面"}}, "explanation": {"en": "Wednesday explicitly has free time for meeting friends.", "zh": "周三明确写有空，可以见朋友。"}, "distractors": {"B": {"en": "Monday has a drawing class.", "zh": "周一有画画课。"}, "C": {"en": "Tuesday is for swimming.", "zh": "周二去游泳。"}}, "reviewStatus": "author_self_checked_pending_teacher_and_user_review"}, {"id": "course-zh1-b-q38", "number": 38, "section": "reading", "group": "R4", "theme": "clothing", "materialId": "C1B-M38", "target": "Identify a lost clothing item from a description.", "promptEn": "Which item is Xiaotian looking for?", "options": {"A": {"zh-Hans": "白外套", "zh-Hant": "白外套"}, "B": {"zh-Hans": "绿色毛衣", "zh-Hant": "綠色毛衣"}, "C": {"zh-Hans": "蓝帽子", "zh-Hant": "藍帽子"}}, "correctAnswer": "B", "evidence": {"materialId": "C1B-M38", "quote": {"zh-Hans": "我把一件绿色毛衣忘在公园了", "zh-Hant": "我把一件綠色毛衣忘在公園了"}}, "explanation": {"en": "Xiaotian’s missing item is the green sweater.", "zh": "小田在找遗忘的绿色毛衣。"}, "distractors": {"A": {"en": "The white coat belongs to Xiaofang.", "zh": "白外套是小方的。"}, "C": {"en": "No blue hat is described in this note.", "zh": "便条没有提到蓝帽子。"}}, "reviewStatus": "author_self_checked_pending_teacher_and_user_review"}, {"id": "course-zh1-b-q39", "number": 39, "section": "reading", "group": "R4", "theme": "leisure", "materialId": "C1B-M39", "target": "Find the venue of a leisure activity in a brief notice.", "promptEn": "Where does the singing group meet?", "options": {"A": {"zh-Hans": "一楼", "zh-Hant": "一樓"}, "B": {"zh-Hans": "三楼", "zh-Hant": "三樓"}, "C": {"zh-Hans": "二楼", "zh-Hant": "二樓"}}, "correctAnswer": "C", "evidence": {"materialId": "C1B-M39", "quote": {"zh-Hans": "周四下午四点到二楼教室", "zh-Hant": "週四下午四點到二樓教室"}}, "explanation": {"en": "The singing group is directed to the second-floor classroom.", "zh": "唱歌小组去二楼教室。"}, "distractors": {"A": {"en": "The first floor is for the drawing group.", "zh": "一楼是画画小组的地点。"}, "B": {"en": "The third floor is not listed for either group.", "zh": "通知没有安排唱歌去三楼。"}}, "reviewStatus": "author_self_checked_pending_teacher_and_user_review"}, {"id": "course-zh1-b-q40", "number": 40, "section": "reading", "group": "R4", "theme": "leisure", "materialId": "C1B-M40", "target": "Compare two simple preference statements to find a shared activity.", "promptEn": "Which activity do BOTH friends like?", "options": {"A": {"zh-Hans": "跳舞", "zh-Hant": "跳舞"}, "B": {"zh-Hans": "画画", "zh-Hant": "畫畫"}, "C": {"zh-Hans": "游泳", "zh-Hant": "游泳"}}, "correctAnswer": "A", "evidence": {"materialId": "C1B-M40", "quote": {"zh-Hans": "李平：我喜欢跳舞，不喜欢画画。\n周月：我喜欢画画，也喜欢跳舞。", "zh-Hant": "李平：我喜歡跳舞，不喜歡畫畫。\n周月：我喜歡畫畫，也喜歡跳舞。"}}, "explanation": {"en": "Both friends explicitly say they like dancing.", "zh": "两人都明确说喜欢跳舞。"}, "distractors": {"B": {"en": "Only Zhou Yue likes drawing; Li Ping does not.", "zh": "周月喜欢画画，李平不喜欢。"}, "C": {"en": "Neither friend states a preference for swimming.", "zh": "两人都没有表示喜欢游泳。"}}, "reviewStatus": "author_self_checked_pending_teacher_and_user_review"}], "tasks": [{"id": "W1", "section": "writing", "type": "short-message-reply", "title": "Arrange a reading visit", "promptEn": "Reply in Chinese to your classmate. Say whether you can join the Wednesday reading visit, give a time or propose another day, and ask one question about the visit. About 20-40 Chinese characters is a guide, not a minimum. You may invent personal details.", "stimulus": {"zh-Hans": "小方：你好！星期三放学后一起去图书馆看书，好吗？你三点还是四点有空？\n小叶", "zh-Hant": "小方：你好！星期三放學後一起去圖書館看書，好嗎？你三點還是四點有空？\n小葉"}, "requirements": ["Respond to the Wednesday invitation.", "Give a workable time or an alternative day.", "Ask one relevant question about the visit."], "reference": {"zh-Hans": "小叶，你好！周三可以，我四点有空。我们在图书馆门口见吗？", "zh-Hant": "小葉，你好！週三可以，我四點有空。我們在圖書館門口見嗎？"}, "alternateReference": {"zh-Hans": "你好！周三我有课，周四四点可以吗？图书馆那时开门吗？", "zh-Hant": "你好！週三我有課，週四四點可以嗎？圖書館那時開門嗎？"}, "reviewNotes": ["An acceptance or a decline with an alternative can both work.", "Questions about meeting place, books or opening time are relevant.", "Names and invented schedules may differ; do not impose a length penalty."], "suggestedHanzi": [20, 40], "enforcedMinimum": null, "sharedTimingGroup": "writing", "rubric": {"maxPoints": 8, "dimensions": [{"id": "completion", "name": "任务完成", "levels": {"0": "无相关可评内容。", "1": "回应部分要求，遗漏关键信息。", "2": "以初阶表达回应主要要求。"}}, {"id": "comprehensibility", "name": "可理解性", "levels": {"0": "大部分意思无法恢复。", "1": "部分需借助上下文猜测。", "2": "主要意思能够理解。"}}, {"id": "language", "name": "基础语言运用", "levels": {"0": "缺少可用于表达目标意思的中文。", "1": "有限词句传达部分意思，错误有时干扰。", "2": "简单词句基本适合情境，允许初阶错误。"}}, {"id": "organization", "name": "组织／相关回应", "levels": {"0": "缺乏可辨关系或相关回应。", "1": "有部分顺序或相关回应。", "2": "简单但连贯，回应相关、易于跟随。"}}], "missing": "unsubmitted", "technicalFailure": "needs_rerecording", "automaticGrade": false, "reviewerOptions": ["self", "own_teacher"], "teacherServiceIncluded": false, "notes": "One profile per task. Accent similarity and suggested length are not scoring criteria. Review S1 partial responses as a partial task; mark the whole task unsubmitted only if no response is submitted. Technical failure needs rerecording."}}, {"id": "W2", "section": "writing", "type": "profile-or-day-description", "title": "Introduce a pen friend", "promptEn": "Read Heyue’s fictional message. Introduce Heyue in Chinese to another classmate, using third-person wording or the name. Include name and age, school and class starting time, and at least one preference. About 40-70 Chinese characters is a guide, not a minimum.", "stimulus": {"zh-Hans": "你好！我叫何月，今年十四岁，在青禾学校二班上学。我们上午八点半上课。我喜欢看书，也喜欢游泳，不喜欢唱歌。希望认识新朋友！", "zh-Hant": "你好！我叫何月，今年十四歲，在青禾學校二班上學。我們上午八點半上課。我喜歡看書，也喜歡游泳，不喜歡唱歌。希望認識新朋友！"}, "requirements": ["Identify Heyue by name and age.", "Give the school and class starting time.", "Give at least one preference consistent with the message."], "reference": {"zh-Hans": "这位新朋友叫何月，今年十四岁。何月在青禾学校二班上学，上午八点半开始上课。何月喜欢看书，也喜欢游泳，不喜欢唱歌。", "zh-Hant": "這位新朋友叫何月，今年十四歲。何月在青禾學校二班上學，上午八點半開始上課。何月喜歡看書，也喜歡游泳，不喜歡唱歌。"}, "reviewNotes": ["The task turns a first-person message into an introduction; copying it verbatim in first person gives less evidence of audience adaptation.", "Do not infer gender. Using the name instead of a pronoun is acceptable.", "At least one stated preference meets the preference requirement."], "suggestedHanzi": [40, 70], "enforcedMinimum": null, "sharedTimingGroup": "writing", "rubric": {"maxPoints": 8, "dimensions": [{"id": "completion", "name": "任务完成", "levels": {"0": "无相关可评内容。", "1": "回应部分要求，遗漏关键信息。", "2": "以初阶表达回应主要要求。"}}, {"id": "comprehensibility", "name": "可理解性", "levels": {"0": "大部分意思无法恢复。", "1": "部分需借助上下文猜测。", "2": "主要意思能够理解。"}}, {"id": "language", "name": "基础语言运用", "levels": {"0": "缺少可用于表达目标意思的中文。", "1": "有限词句传达部分意思，错误有时干扰。", "2": "简单词句基本适合情境，允许初阶错误。"}}, {"id": "organization", "name": "组织／相关回应", "levels": {"0": "缺乏可辨关系或相关回应。", "1": "有部分顺序或相关回应。", "2": "简单但连贯，回应相关、易于跟随。"}}], "missing": "unsubmitted", "technicalFailure": "needs_rerecording", "automaticGrade": false, "reviewerOptions": ["self", "own_teacher"], "teacherServiceIncluded": false, "notes": "One profile per task. Accent similarity and suggested length are not scoring criteria. Review S1 partial responses as a partial task; mark the whole task unsubmitted only if no response is submitted. Technical failure needs rerecording."}}, {"id": "S1", "section": "speaking", "type": "simulated-guided-exchange", "title": "Plan an activity with a new friend", "promptEn": "Answer four recorded prompts in Chinese. Each plays twice, then allows 10 seconds to prepare and up to 20 seconds to record. Use real or invented information. The four responses form ONE task out of eight. This is fixed-prompt practice, not an adaptive conversation.", "scenarioEn": "A new friend asks about your family, interests and school day, then suggests a weekend outing.", "exchanges": [{"id": "S1-1", "speaker": "male", "prompt": {"zh-Hans": "你家有几个人？你和谁一起住？", "zh-Hant": "你家有幾個人？你和誰一起住？"}, "reference": {"zh-Hans": "我家有三个人。我和爸爸妈妈一起住。", "zh-Hant": "我家有三個人。我和爸爸媽媽一起住。"}, "checklist": ["Give a household size and say who lives with you; invented information is fine."]}, {"id": "S1-2", "speaker": "male", "prompt": {"zh-Hans": "周末你喜欢做什么？不喜欢做什么？", "zh-Hant": "週末你喜歡做什麼？不喜歡做什麼？"}, "reference": {"zh-Hans": "我喜欢看书和跳舞，不喜欢打篮球。", "zh-Hant": "我喜歡看書和跳舞，不喜歡打籃球。"}, "checklist": ["State one liked and one disliked activity."]}, {"id": "S1-3", "speaker": "male", "prompt": {"zh-Hans": "星期五你几点下课？下课后去哪儿？", "zh-Hant": "星期五你幾點下課？下課後去哪兒？"}, "reference": {"zh-Hans": "我下午三点下课，然后去图书馆。", "zh-Hant": "我下午三點下課，然後去圖書館。"}, "checklist": ["Give a lesson-end time and a destination afterward."]}, {"id": "S1-4", "speaker": "male", "prompt": {"zh-Hans": "星期天一起看电影，好吗？你上午还是下午有空？", "zh-Hant": "星期天一起看電影，好嗎？你上午還是下午有空？"}, "reference": {"zh-Hans": "好啊，我下午有空。我们两点见，好吗？", "zh-Hant": "好啊，我下午有空。我們兩點見，好嗎？"}, "alternateReference": {"zh-Hans": "对不起，星期天没有时间。星期六下午可以吗？", "zh-Hant": "對不起，星期天沒有時間。星期六下午可以嗎？"}, "checklist": ["Accept with availability, or decline and suggest another time."]}], "playsPerPrompt": 2, "preparationSecondsPerPrompt": 10, "responseSecondsPerPrompt": 20, "rubricScope": "all_four_responses_together", "rubric": {"maxPoints": 8, "dimensions": [{"id": "completion", "name": "任务完成", "levels": {"0": "无相关可评内容。", "1": "回应部分要求，遗漏关键信息。", "2": "以初阶表达回应主要要求。"}}, {"id": "comprehensibility", "name": "可理解性", "levels": {"0": "大部分意思无法恢复。", "1": "部分需借助上下文猜测。", "2": "主要意思能够理解。"}}, {"id": "language", "name": "基础语言运用", "levels": {"0": "缺少可用于表达目标意思的中文。", "1": "有限词句传达部分意思，错误有时干扰。", "2": "简单词句基本适合情境，允许初阶错误。"}}, {"id": "organization", "name": "组织／相关回应", "levels": {"0": "缺乏可辨关系或相关回应。", "1": "有部分顺序或相关回应。", "2": "简单但连贯，回应相关、易于跟随。"}}], "missing": "unsubmitted", "technicalFailure": "needs_rerecording", "automaticGrade": false, "reviewerOptions": ["self", "own_teacher"], "teacherServiceIncluded": false, "notes": "One profile per task. Accent similarity and suggested length are not scoring criteria. Review S1 partial responses as a partial task; mark the whole task unsubmitted only if no response is submitted. Technical failure needs rerecording."}}, {"id": "S2", "section": "speaking", "type": "short-presentation", "title": "Describe a Thursday at school", "promptEn": "Introduce the fictional student’s Thursday in Chinese from the card. Include the student’s name, school and at least one class time, and an after-school activity. You have 60 seconds to prepare and up to 60 seconds to speak. Simple sentences are sufficient; no minimum recording length applies.", "stimulus": {"zh-Hans": "许乐的星期四\n学校：青禾学校\n上午八点半：开始上课\n中午十二点：和同学在食堂吃饭\n下午四点：下课\n下课后：和朋友在操场打篮球", "zh-Hant": "許樂的星期四\n學校：青禾學校\n上午八點半：開始上課\n中午十二點：和同學在食堂喫飯\n下午四點：下課\n下課後：和朋友在操場打籃球"}, "requirements": ["Identify Xu Le.", "Give the school and at least one class time.", "Describe the after-school activity on the card."], "reference": {"zh-Hans": "这是许乐在学校的一天。许乐在青禾学校上学，上午八点半开始上课，中午和同学在食堂吃饭。下午四点下课后，许乐和朋友在操场打篮球。", "zh-Hant": "這是許樂在學校的一天。許樂在青禾學校上學，上午八點半開始上課，中午和同學在食堂喫飯。下午四點下課後，許樂和朋友在操場打籃球。"}, "reviewNotes": ["The learner need not recite every card detail to meet the task.", "Simple connected sentences are enough; a native-like accent or sixty seconds of speech is not required."], "preparationSeconds": 60, "responseSeconds": 60, "rubric": {"maxPoints": 8, "dimensions": [{"id": "completion", "name": "任务完成", "levels": {"0": "无相关可评内容。", "1": "回应部分要求，遗漏关键信息。", "2": "以初阶表达回应主要要求。"}}, {"id": "comprehensibility", "name": "可理解性", "levels": {"0": "大部分意思无法恢复。", "1": "部分需借助上下文猜测。", "2": "主要意思能够理解。"}}, {"id": "language", "name": "基础语言运用", "levels": {"0": "缺少可用于表达目标意思的中文。", "1": "有限词句传达部分意思，错误有时干扰。", "2": "简单词句基本适合情境，允许初阶错误。"}}, {"id": "organization", "name": "组织／相关回应", "levels": {"0": "缺乏可辨关系或相关回应。", "1": "有部分顺序或相关回应。", "2": "简单但连贯，回应相关、易于跟随。"}}], "missing": "unsubmitted", "technicalFailure": "needs_rerecording", "automaticGrade": false, "reviewerOptions": ["self", "own_teacher"], "teacherServiceIncluded": false, "notes": "One profile per task. Accent similarity and suggested length are not scoring criteria. Review S1 partial responses as a partial task; mark the whole task unsubmitted only if no response is submitted. Technical failure needs rerecording."}}], "instructions": {"en": "Choose one of A, B, C. Listening sources play twice in the timed track. The two writing tasks share fifteen minutes. Oral/written responses need self-review or review by your own teacher; no automatic grade or teacher-marking service is included. Invented personal details are acceptable.", "zh": "听读每题三选一，整轨每段听两遍。写作两题共用十五分钟。口写按量表自评或交由自己的教师评阅，不自动批改，不包含本站教师代评。可以使用虚构个人资料。"}, "vocabularySupport": [{"term": {"zh-Hans": "围巾", "zh-Hant": "圍巾"}, "pinyin": "wéijīn", "meaningEn": "scarf"}, {"term": {"zh-Hans": "运动鞋", "zh-Hant": "運動鞋"}, "pinyin": "yùndòngxié", "meaningEn": "sports shoes"}, {"term": {"zh-Hans": "毛衣", "zh-Hant": "毛衣"}, "pinyin": "máoyī", "meaningEn": "sweater"}, {"term": {"zh-Hans": "T恤", "zh-Hant": "T恤"}, "pinyin": "T xù", "meaningEn": "T-shirt"}, {"term": {"zh-Hans": "包子", "zh-Hant": "包子"}, "pinyin": "bāozi", "meaningEn": "steamed bun"}, {"term": {"zh-Hans": "豆浆", "zh-Hant": "豆漿"}, "pinyin": "dòujiāng", "meaningEn": "soy milk"}, {"term": {"zh-Hans": "酸", "zh-Hant": "酸"}, "pinyin": "suān", "meaningEn": "sour"}, {"term": {"zh-Hans": "甜", "zh-Hant": "甜"}, "pinyin": "tián", "meaningEn": "sweet"}, {"term": {"zh-Hans": "青菜", "zh-Hant": "青菜"}, "pinyin": "qīngcài", "meaningEn": "green vegetables"}, {"term": {"zh-Hans": "书架", "zh-Hant": "書架"}, "pinyin": "shūjià", "meaningEn": "bookshelf"}, {"term": {"zh-Hans": "体育馆", "zh-Hant": "體育館"}, "pinyin": "tǐyùguǎn", "meaningEn": "sports hall"}, {"term": {"zh-Hans": "操场", "zh-Hant": "操場"}, "pinyin": "cāochǎng", "meaningEn": "playground / sports field"}, {"term": {"zh-Hans": "窗户", "zh-Hant": "窗戶"}, "pinyin": "chuānghu", "meaningEn": "window"}, {"term": {"zh-Hans": "擦黑板", "zh-Hant": "擦黑板"}, "pinyin": "cā hēibǎn", "meaningEn": "clean the board"}, {"term": {"zh-Hans": "游泳", "zh-Hant": "游泳"}, "pinyin": "yóuyǒng", "meaningEn": "swim"}, {"term": {"zh-Hans": "跳舞", "zh-Hant": "跳舞"}, "pinyin": "tiàowǔ", "meaningEn": "dance"}, {"term": {"zh-Hans": "散步", "zh-Hant": "散步"}, "pinyin": "sànbù", "meaningEn": "take a walk"}, {"term": {"zh-Hans": "放学", "zh-Hant": "放學"}, "pinyin": "fàngxué", "meaningEn": "finish school for the day"}], "supportPolicy": "Preparation/practice aid only; not printed in the timed learner paper. Assisted and unassisted results are different conditions.", "nextAcceptance": ["Human listening to this B paper", "Independent teacher review of elementary language load and ambiguity", "Learner timing/difficulty pilot", "Separate production integration and release checks"]}</script><script id="audio-data" type="application/json">{"paperId": "course-chinese-1-b-v1", "provider": "Edge TTS used at authoring time; playback uses local MP3 files, no runtime TTS service", "rate": "-8%", "voices": {"female": "zh-CN-XiaoxiaoNeural", "male": "zh-CN-YunxiNeural"}, "humanListeningAcceptance": false, "units": [{"id": "C1B-M01", "kind": "listening-source", "sourcePlays": 1, "script": [{"speaker": "male", "text": {"zh-Hans": "我家有五个人：爷爷、爸爸、妈妈、姐姐和我。姐姐在大学读书，我在中学上学。我们都住在一起。", "zh-Hant": "我家有五個人：爺爺、爸爸、媽媽、姐姐和我。姐姐在大學讀書，我在中學上學。我們都住在一起。"}}], "sourceDurationSeconds": 10.728, "src": "assets/audio/c1b-m01.mp3", "durationSeconds": 11.28, "pcmSeconds": 11.228, "bytes": 90476, "sha256": "9b34e8c6c771d4330900189eafec6062557a8024ceaca461fc1958a86c7d6cee"}, {"id": "C1B-M02", "kind": "listening-source", "sourcePlays": 1, "script": [{"speaker": "female", "text": {"zh-Hans": "我妈妈是医生，星期六也要去医院。爸爸星期六不工作，在家做饭。我和哥哥下午一起回家吃饭。", "zh-Hant": "我媽媽是醫生，星期六也要去醫院。爸爸星期六不工作，在家做飯。我和哥哥下午一起回家喫飯。"}}], "sourceDurationSeconds": 10.512, "src": "assets/audio/c1b-m02.mp3", "durationSeconds": 11.064, "pcmSeconds": 11.012, "bytes": 88748, "sha256": "ff5476648428fdde4c063a9432900805f4c54b530ea88a61574122c1dea4c57d"}, {"id": "C1B-M03", "kind": "listening-source", "sourcePlays": 1, "script": [{"speaker": "male", "text": {"zh-Hans": "我们拍全家照时，爷爷坐在中间。爸爸站在爷爷左边，妈妈在右边。姐姐和我站在后面。", "zh-Hant": "我們拍全家照時，爺爺坐在中間。爸爸站在爺爺左邊，媽媽在右邊。姐姐和我站在後面。"}}], "sourceDurationSeconds": 9.12, "src": "assets/audio/c1b-m03.mp3", "durationSeconds": 9.672, "pcmSeconds": 9.62, "bytes": 77612, "sha256": "d2b09e5000df6b2ef33e0116a9a7f9e786b372cf97a515b16645cf87ecc6231f"}, {"id": "C1B-M04", "kind": "listening-source", "sourcePlays": 1, "script": [{"speaker": "female", "text": {"zh-Hans": "你们好，我姓马，叫马文。我的中文老师姓林。今天王老师带我来这个班，我很高兴认识大家。", "zh-Hant": "你們好，我姓馬，叫馬文。我的中文老師姓林。今天王老師帶我來這個班，我很高興認識大家。"}}], "sourceDurationSeconds": 10.272, "src": "assets/audio/c1b-m04.mp3", "durationSeconds": 10.824, "pcmSeconds": 10.772, "bytes": 86828, "sha256": "8c839062046c8f8f7da2412704f1fb80f1ac86b669b2e400ac929a29b1dfc91a"}, {"id": "C1B-M05", "kind": "listening-source", "sourcePlays": 1, "script": [{"speaker": "male", "text": {"zh-Hans": "我们上午在教室上课，中午去学校食堂吃饭。下午下课后，大家常常去操场运动。今天我也去。", "zh-Hant": "我們上午在教室上課，中午去學校食堂喫飯。下午下課後，大家常常去操場運動。今天我也去。"}}], "sourceDurationSeconds": 10.056, "src": "assets/audio/c1b-m05.mp3", "durationSeconds": 10.608, "pcmSeconds": 10.556, "bytes": 85100, "sha256": "59e7072218e64b7170b4202ae7132cb588131715d4939a439b89a8e97177658f"}, {"id": "C1B-M06", "kind": "listening-source", "sourcePlays": 1, "script": [{"speaker": "female", "text": {"zh-Hans": "同学们，请把书包放在椅子上，不要放在地上。桌子上只放书和本子。现在我们开始上课。", "zh-Hant": "同學們，請把書包放在椅子上，不要放在地上。桌子上只放書和本子。現在我們開始上課。"}}], "sourceDurationSeconds": 9.936, "src": "assets/audio/c1b-m06.mp3", "durationSeconds": 10.488, "pcmSeconds": 10.436, "bytes": 84140, "sha256": "be6e970ab7d6e12840575066daa3d4c1e0a95c01f8f5f0e5078a9c1ae547d201"}, {"id": "C1B-M07", "kind": "listening-source", "sourcePlays": 1, "script": [{"speaker": "male", "text": {"zh-Hans": "老师，我今天能借三本书吗？", "zh-Hant": "老師，我今天能借三本書嗎？"}}, {"speaker": "female", "text": {"zh-Hans": "每人一次只能借两本。你可以先选两本，明天还书以后再借。", "zh-Hant": "每人一次只能借兩本。你可以先選兩本，明天還書以後再借。"}}], "sourceDurationSeconds": 11.222, "src": "assets/audio/c1b-m07.mp3", "durationSeconds": 11.784, "pcmSeconds": 11.722, "bytes": 94508, "sha256": "56423c2a538f6e5e4834230a135fb6070b3c1f98aa07df1091b9b2c0543b3e80"}, {"id": "C1B-M08", "kind": "listening-source", "sourcePlays": 1, "script": [{"speaker": "female", "text": {"zh-Hans": "今天体育课还在教室吗？", "zh-Hant": "今天體育課還在教室嗎？"}}, {"speaker": "male", "text": {"zh-Hans": "不，今天不下雨，我们去操场上课。", "zh-Hant": "不，今天不下雨，我們去操場上課。"}}, {"speaker": "female", "text": {"zh-Hans": "好的，我叫同学们一起去操场。", "zh-Hant": "好的，我叫同學們一起去操場。"}}], "sourceDurationSeconds": 11.332, "src": "assets/audio/c1b-m08.mp3", "durationSeconds": 11.88, "pcmSeconds": 11.832, "bytes": 95276, "sha256": "785ef3cd2aa9ef79b9f0856ce739f821fc8b47d2a451a3f1a3adecc63f8216ab"}, {"id": "C1B-M09", "kind": "listening-source", "sourcePlays": 1, "script": [{"speaker": "female", "text": {"zh-Hans": "大家拿到纸了吗？请先在纸上写名字，再打开书。今天的练习很短，下课前我们一起看答案。", "zh-Hant": "大家拿到紙了嗎？請先在紙上寫名字，再打開書。今天的練習很短，下課前我們一起看答案。"}}], "sourceDurationSeconds": 10.224, "src": "assets/audio/c1b-m09.mp3", "durationSeconds": 10.776, "pcmSeconds": 10.724, "bytes": 86444, "sha256": "7d48ae8144b436af73dbbb473e475226d39f564a4d50d9028f87815ee8af7d1d"}, {"id": "C1B-M10", "kind": "listening-source", "sourcePlays": 1, "script": [{"speaker": "male", "text": {"zh-Hans": "老师，下午两点上课，我想课前问一个问题。", "zh-Hant": "老師，下午兩點上課，我想課前問一個問題。"}}, {"speaker": "female", "text": {"zh-Hans": "可以，一点四十五来办公室吧。", "zh-Hant": "可以，一點四十五來辦公室吧。"}}, {"speaker": "male", "text": {"zh-Hans": "好，我一点四十五到。", "zh-Hant": "好，我一點四十五到。"}}], "sourceDurationSeconds": 12.364, "src": "assets/audio/c1b-m10.mp3", "durationSeconds": 12.912, "pcmSeconds": 12.864, "bytes": 103532, "sha256": "3a1dc0d8727513c9b242d3b62a9b97bedaa91dd1feea8b8fbc67465dfbdd2869"}, {"id": "C1B-M11", "kind": "listening-source", "sourcePlays": 1, "script": [{"speaker": "male", "text": {"zh-Hans": "我要两个面包和一杯牛奶。", "zh-Hant": "我要兩個麪包和一杯牛奶。"}}, {"speaker": "female", "text": {"zh-Hans": "面包卖完了，还有包子。", "zh-Hant": "麪包賣完了，還有包子。"}}, {"speaker": "male", "text": {"zh-Hans": "那我要两个包子吧，牛奶还是一杯。", "zh-Hant": "那我要兩個包子吧，牛奶還是一杯。"}}], "sourceDurationSeconds": 10.996, "src": "assets/audio/c1b-m11.mp3", "durationSeconds": 11.544, "pcmSeconds": 11.496, "bytes": 92588, "sha256": "fda72ae91b422b87243c208b83183ad4909b0a5da3ff973f9d9fae2173703df6"}, {"id": "C1B-M12", "kind": "listening-source", "sourcePlays": 1, "script": [{"speaker": "female", "text": {"zh-Hans": "我们这桌要三杯热茶、两杯冷水。热茶给爸爸妈妈和奶奶，冷水给我和弟弟。请不要拿错了。", "zh-Hant": "我們這桌要三杯熱茶、兩杯冷水。熱茶給爸爸媽媽和奶奶，冷水給我和弟弟。請不要拿錯了。"}}], "sourceDurationSeconds": 10.248, "src": "assets/audio/c1b-m12.mp3", "durationSeconds": 10.8, "pcmSeconds": 10.748, "bytes": 86636, "sha256": "db4916185c4477ba0c6748146f0049e90134747a83a6d5bef10891dba955e934"}, {"id": "C1B-M13", "kind": "listening-source", "sourcePlays": 1, "script": [{"speaker": "male", "text": {"zh-Hans": "今天这些苹果怎么样？", "zh-Hant": "今天這些蘋果怎麼樣？"}}, {"speaker": "female", "text": {"zh-Hans": "有点儿酸，香蕉很甜。", "zh-Hant": "有點兒酸，香蕉很甜。"}}, {"speaker": "male", "text": {"zh-Hans": "我想买甜的。那我不要苹果了，买香蕉吧。", "zh-Hant": "我想買甜的。那我不要蘋果了，買香蕉吧。"}}], "sourceDurationSeconds": 11.572, "src": "assets/audio/c1b-m13.mp3", "durationSeconds": 12.12, "pcmSeconds": 12.072, "bytes": 97196, "sha256": "f2d8bdefcd2b5ab3798c143f0a3763d0100bdb2ba76a83e44c59e09c1f6e2185"}, {"id": "C1B-M14", "kind": "listening-source", "sourcePlays": 1, "script": [{"speaker": "male", "text": {"zh-Hans": "这杯豆浆多少钱？", "zh-Hant": "這杯豆漿多少錢？"}}, {"speaker": "female", "text": {"zh-Hans": "九块。", "zh-Hant": "九塊。"}}, {"speaker": "male", "text": {"zh-Hans": "给你十块。", "zh-Hant": "給你十塊。"}}, {"speaker": "female", "text": {"zh-Hans": "谢谢，找你一块。豆浆有点儿热，请小心。", "zh-Hant": "謝謝，找你一塊。豆漿有點兒熱，請小心。"}}], "sourceDurationSeconds": 12.042, "src": "assets/audio/c1b-m14.mp3", "durationSeconds": 12.6, "pcmSeconds": 12.542, "bytes": 101036, "sha256": "5a19ebaaa9d74c9067743960b8bf3c96ef4bf05a9c39fdfe71050f66e8433f81"}, {"id": "C1B-M15", "kind": "listening-source", "sourcePlays": 1, "script": [{"speaker": "female", "text": {"zh-Hans": "门口有一件外套、一条围巾和一顶帽子。外套是我的，围巾是姐姐的，帽子是弟弟的。我们都找到了。", "zh-Hant": "門口有一件外套、一條圍巾和一頂帽子。外套是我的，圍巾是姐姐的，帽子是弟弟的。我們都找到了。"}}], "sourceDurationSeconds": 10.992, "src": "assets/audio/c1b-m15.mp3", "durationSeconds": 11.544, "pcmSeconds": 11.492, "bytes": 92588, "sha256": "7244f86e3de7416b9da63500c4a79bdf09494476c2862f774df468f4f92af11a"}, {"id": "C1B-M16", "kind": "listening-source", "sourcePlays": 1, "script": [{"speaker": "male", "text": {"zh-Hans": "明天上午一起去买东西吧，十点见，好吗？", "zh-Hant": "明天上午一起去買東西吧，十點見，好嗎？"}}, {"speaker": "female", "text": {"zh-Hans": "好，我八点吃早饭，十二点要回家。十点见正好。", "zh-Hant": "好，我八點喫早飯，十二點要回家。十點見正好。"}}], "sourceDurationSeconds": 11.03, "src": "assets/audio/c1b-m16.mp3", "durationSeconds": 11.592, "pcmSeconds": 11.53, "bytes": 92972, "sha256": "8405450ad41c6e8d4d70b83988c14ecbb459e98905bc9ac9f23e0821b1bf2af9"}, {"id": "C1B-M17", "kind": "listening-source", "sourcePlays": 1, "script": [{"speaker": "female", "text": {"zh-Hans": "今天下午什么时候能给你打电话？", "zh-Hant": "今天下午什麼時候能給你打電話？"}}, {"speaker": "male", "text": {"zh-Hans": "三点我在上课，四点到家，五点出去。你四点打给我吧。", "zh-Hant": "三點我在上課，四點到家，五點出去。你四點打給我吧。"}}], "sourceDurationSeconds": 10.526, "src": "assets/audio/c1b-m17.mp3", "durationSeconds": 11.088, "pcmSeconds": 11.026, "bytes": 88940, "sha256": "84e6aa2d3eeb32a3eced2b094916c7c2765c6c4954c3463c43e628faeabc4b64"}, {"id": "C1B-M18", "kind": "listening-source", "sourcePlays": 1, "script": [{"speaker": "male", "text": {"zh-Hans": "我的白色运动鞋找不到了，你看见了吗？", "zh-Hant": "我的白色運動鞋找不到了，你看見了嗎？"}}, {"speaker": "female", "text": {"zh-Hans": "门口有一双黑色的。", "zh-Hant": "門口有一雙黑色的。"}}, {"speaker": "male", "text": {"zh-Hans": "黑色的是爸爸的，我的白鞋在床下面。", "zh-Hant": "黑色的是爸爸的，我的白鞋在牀下面。"}}], "sourceDurationSeconds": 11.26, "src": "assets/audio/c1b-m18.mp3", "durationSeconds": 11.808, "pcmSeconds": 11.76, "bytes": 94700, "sha256": "de33e0fe98aa162b174259b3ce6c68d73fca785199270d2991d105242db45739"}, {"id": "C1B-M19", "kind": "listening-source", "sourcePlays": 1, "script": [{"speaker": "female", "text": {"zh-Hans": "你这周有什么活动？", "zh-Hant": "你這周有什麼活動？"}}, {"speaker": "male", "text": {"zh-Hans": "星期三下午去游泳，星期五下午去公园。我喜欢游泳，也喜欢和朋友在公园走走。", "zh-Hant": "星期三下午去游泳，星期五下午去公園。我喜歡游泳，也喜歡和朋友在公園走走。"}}], "sourceDurationSeconds": 11.174, "src": "assets/audio/c1b-m19.mp3", "durationSeconds": 11.736, "pcmSeconds": 11.674, "bytes": 94124, "sha256": "3cc33c82468921f57002aa48f29822c2e63fa23bf5be65d4446e3cdd804ee5b1"}, {"id": "C1B-M20", "kind": "listening-source", "sourcePlays": 1, "script": [{"speaker": "male", "text": {"zh-Hans": "下午先去打球，好吗？", "zh-Hant": "下午先去打球，好嗎？"}}, {"speaker": "female", "text": {"zh-Hans": "我想先把这张画画完，然后去打球。", "zh-Hant": "我想先把這張畫畫完，然後去打球。"}}, {"speaker": "male", "text": {"zh-Hans": "好的，你画完以后叫我，我在家等你。", "zh-Hant": "好的，你畫完以後叫我，我在家等你。"}}], "sourceDurationSeconds": 12.028, "src": "assets/audio/c1b-m20.mp3", "durationSeconds": 12.576, "pcmSeconds": 12.528, "bytes": 100844, "sha256": "d225971eec1f0edbb63ab189dde8cbf6a465f7b6b461b47879ee4a7fcd001c0a"}, {"id": "S1-1", "kind": "oral-prompt", "sourcePlays": 2, "singlePlayPcmSeconds": 4.176, "repeatGapSeconds": 1.5, "singlePlayPcmSha256": "7a267d475ca2ef4a277784f606b9e2b564d3471dfd7f8b9207e9fd3cc2be53a4", "script": {"zh-Hans": "你家有几个人？你和谁一起住？", "zh-Hant": "你家有幾個人？你和誰一起住？"}, "src": "assets/audio/s1-1.mp3", "durationSeconds": 9.912, "pcmSeconds": 9.852, "bytes": 79532, "sha256": "8f8579bfc0b807d67f5a8ee085839bb66e4dc77c30cde2189533694bf7b4144e"}, {"id": "S1-2", "kind": "oral-prompt", "sourcePlays": 2, "singlePlayPcmSeconds": 4.248, "repeatGapSeconds": 1.5, "singlePlayPcmSha256": "5b4feccaf916d8fe7a24deda01a5312d6a81de29c327ece94a1c6126c6d80998", "script": {"zh-Hans": "周末你喜欢做什么？不喜欢做什么？", "zh-Hant": "週末你喜歡做什麼？不喜歡做什麼？"}, "src": "assets/audio/s1-2.mp3", "durationSeconds": 10.056, "pcmSeconds": 9.996, "bytes": 80684, "sha256": "0b99336954b2e8bf3e97ebaec1eaff5a54aaa44611f4d301b4827f160c82434e"}, {"id": "S1-3", "kind": "oral-prompt", "sourcePlays": 2, "singlePlayPcmSeconds": 4.512, "repeatGapSeconds": 1.5, "singlePlayPcmSha256": "7ceab3b44327aaf956913e385a9f1d021374d4ed580a2d29715609e03ccd81b8", "script": {"zh-Hans": "星期五你几点下课？下课后去哪儿？", "zh-Hant": "星期五你幾點下課？下課後去哪兒？"}, "src": "assets/audio/s1-3.mp3", "durationSeconds": 10.584, "pcmSeconds": 10.524, "bytes": 84908, "sha256": "42bec3450dac182a2db416f2b0f45016c657892d3de06b06f6ec6f03069f43fa"}, {"id": "S1-4", "kind": "oral-prompt", "sourcePlays": 2, "singlePlayPcmSeconds": 5.832, "repeatGapSeconds": 1.5, "singlePlayPcmSha256": "5bddfd7b829292d6f07a8cf793f608b22feef19f3f1cfc1d30ec73478c68d848", "script": {"zh-Hans": "星期天一起看电影，好吗？你上午还是下午有空？", "zh-Hant": "星期天一起看電影，好嗎？你上午還是下午有空？"}, "src": "assets/audio/s1-4.mp3", "durationSeconds": 13.224, "pcmSeconds": 13.164, "bytes": 106028, "sha256": "77e3cf949ac2b27100300d0642b0234a9e2e160cb23ac1b522c76217f5ffc403"}], "groups": [{"id": "L1", "sourcePlays": 2, "src": "assets/audio/listening-group-1.mp3", "durationSeconds": 225.048, "pcmSeconds": 225.0, "bytes": 1800620, "sha256": "9608d35188700a7099e73d7f6189425b4c10af5530cf7170e113ea36d008cba8"}, {"id": "L2", "sourcePlays": 2, "src": "assets/audio/listening-group-2.mp3", "durationSeconds": 225.072, "pcmSeconds": 225.0, "bytes": 1800812, "sha256": "e02f3b1d9dd1c932569772de16e273454b945d0f1dedae21a43d82482fd40daa"}, {"id": "L3", "sourcePlays": 2, "src": "assets/audio/listening-group-3.mp3", "durationSeconds": 225.048, "pcmSeconds": 225.0, "bytes": 1800620, "sha256": "c510054a92ebed08948f208eba37f2b78002df6e32074bdd002c6fd818d14d4b"}, {"id": "L4", "sourcePlays": 2, "src": "assets/audio/listening-group-4.mp3", "durationSeconds": 225.048, "pcmSeconds": 225.0, "bytes": 1800620, "sha256": "232c97793c78e0d20c425585b83ecf78dbe2ccb5af681fbb97000c49e3dbc077"}], "timedTrack": {"src": "assets/audio/listening-full.mp3", "durationSeconds": 900.048, "pcmSeconds": 900.0, "bytes": 7200620, "sha256": "cc699211de907a81e854f623e55b8558db9c684c685339d0dbb3ea0db09a00dd"}, "timeline": [{"id": "C1B-M01", "questionNumber": 1, "labelStartSeconds": 7.96, "firstPlayStartSeconds": 9.996, "secondPlayStartSeconds": 22.224, "speechEndSeconds": 32.952, "answerWindowSeconds": 18.416, "slotEndSeconds": 51.368, "sourcePlays": 2}, {"id": "C1B-M02", "questionNumber": 2, "labelStartSeconds": 51.368, "firstPlayStartSeconds": 53.38, "secondPlayStartSeconds": 65.392, "speechEndSeconds": 75.904, "answerWindowSeconds": 18.872, "slotEndSeconds": 94.776, "sourcePlays": 2}, {"id": "C1B-M03", "questionNumber": 3, "labelStartSeconds": 94.776, "firstPlayStartSeconds": 96.908, "secondPlayStartSeconds": 107.528, "speechEndSeconds": 116.648, "answerWindowSeconds": 21.536, "slotEndSeconds": 138.184, "sourcePlays": 2}, {"id": "C1B-M04", "questionNumber": 4, "labelStartSeconds": 138.184, "firstPlayStartSeconds": 140.316, "secondPlayStartSeconds": 152.088, "speechEndSeconds": 162.36, "answerWindowSeconds": 19.232, "slotEndSeconds": 181.592, "sourcePlays": 2}, {"id": "C1B-M05", "questionNumber": 5, "labelStartSeconds": 181.592, "firstPlayStartSeconds": 183.652, "secondPlayStartSeconds": 195.208, "speechEndSeconds": 205.264, "answerWindowSeconds": 19.736, "slotEndSeconds": 225.0, "sourcePlays": 2}, {"id": "C1B-M06", "questionNumber": 6, "labelStartSeconds": 232.984, "firstPlayStartSeconds": 235.092, "secondPlayStartSeconds": 246.528, "speechEndSeconds": 256.464, "answerWindowSeconds": 19.923, "slotEndSeconds": 276.387, "sourcePlays": 2}, {"id": "C1B-M07", "questionNumber": 7, "labelStartSeconds": 276.387, "firstPlayStartSeconds": 278.495, "secondPlayStartSeconds": 291.217, "speechEndSeconds": 302.439, "answerWindowSeconds": 17.351, "slotEndSeconds": 319.79, "sourcePlays": 2}, {"id": "C1B-M08", "questionNumber": 8, "labelStartSeconds": 319.79, "firstPlayStartSeconds": 321.874, "secondPlayStartSeconds": 334.706, "speechEndSeconds": 346.038, "answerWindowSeconds": 17.155, "slotEndSeconds": 363.194, "sourcePlays": 2}, {"id": "C1B-M09", "questionNumber": 9, "labelStartSeconds": 363.194, "firstPlayStartSeconds": 365.278, "secondPlayStartSeconds": 377.002, "speechEndSeconds": 387.226, "answerWindowSeconds": 19.371, "slotEndSeconds": 406.597, "sourcePlays": 2}, {"id": "C1B-M10", "questionNumber": 10, "labelStartSeconds": 406.597, "firstPlayStartSeconds": 408.753, "secondPlayStartSeconds": 422.617, "speechEndSeconds": 434.981, "answerWindowSeconds": 15.019, "slotEndSeconds": 450.0, "sourcePlays": 2}, {"id": "C1B-M11", "questionNumber": 11, "labelStartSeconds": 458.032, "firstPlayStartSeconds": 460.308, "secondPlayStartSeconds": 472.804, "speechEndSeconds": 483.8, "answerWindowSeconds": 17.626, "slotEndSeconds": 501.426, "sourcePlays": 2}, {"id": "C1B-M12", "questionNumber": 12, "labelStartSeconds": 501.426, "firstPlayStartSeconds": 503.702, "secondPlayStartSeconds": 515.45, "speechEndSeconds": 525.698, "answerWindowSeconds": 19.122, "slotEndSeconds": 544.819, "sourcePlays": 2}, {"id": "C1B-M13", "questionNumber": 13, "labelStartSeconds": 544.819, "firstPlayStartSeconds": 547.143, "secondPlayStartSeconds": 560.215, "speechEndSeconds": 571.787, "answerWindowSeconds": 16.426, "slotEndSeconds": 588.213, "sourcePlays": 2}, {"id": "C1B-M14", "questionNumber": 14, "labelStartSeconds": 588.213, "firstPlayStartSeconds": 590.561, "secondPlayStartSeconds": 604.103, "speechEndSeconds": 616.145, "answerWindowSeconds": 15.462, "slotEndSeconds": 631.606, "sourcePlays": 2}, {"id": "C1B-M15", "questionNumber": 15, "labelStartSeconds": 631.606, "firstPlayStartSeconds": 633.882, "secondPlayStartSeconds": 646.374, "speechEndSeconds": 657.366, "answerWindowSeconds": 17.634, "slotEndSeconds": 675.0, "sourcePlays": 2}, {"id": "C1B-M16", "questionNumber": 16, "labelStartSeconds": 683.032, "firstPlayStartSeconds": 685.38, "secondPlayStartSeconds": 697.91, "speechEndSeconds": 708.94, "answerWindowSeconds": 17.486, "slotEndSeconds": 726.426, "sourcePlays": 2}, {"id": "C1B-M17", "questionNumber": 17, "labelStartSeconds": 726.426, "firstPlayStartSeconds": 728.774, "secondPlayStartSeconds": 740.8, "speechEndSeconds": 751.326, "answerWindowSeconds": 18.494, "slotEndSeconds": 769.819, "sourcePlays": 2}, {"id": "C1B-M18", "questionNumber": 18, "labelStartSeconds": 769.819, "firstPlayStartSeconds": 772.119, "secondPlayStartSeconds": 784.879, "speechEndSeconds": 796.139, "answerWindowSeconds": 17.074, "slotEndSeconds": 813.213, "sourcePlays": 2}, {"id": "C1B-M19", "questionNumber": 19, "labelStartSeconds": 813.213, "firstPlayStartSeconds": 815.537, "secondPlayStartSeconds": 828.211, "speechEndSeconds": 839.385, "answerWindowSeconds": 17.222, "slotEndSeconds": 856.606, "sourcePlays": 2}, {"id": "C1B-M20", "questionNumber": 20, "labelStartSeconds": 856.606, "firstPlayStartSeconds": 858.834, "secondPlayStartSeconds": 872.362, "speechEndSeconds": 884.39, "answerWindowSeconds": 15.61, "slotEndSeconds": 900.0, "sourcePlays": 2}], "cache": [{"key": "ae32627f43a3b1c9a6b9abfd", "speaker": "female", "text": "中文一，B卷，听力第1组。每段听两遍，请选择一个答案。", "sha256": "489b5bde58196f6854cfb0d51a82e8b53647a4149837fecf0e50933baf907891"}, {"key": "f1b1a9a97394ce8724a1568c", "speaker": "female", "text": "中文一，B卷，听力第2组。每段听两遍，请选择一个答案。", "sha256": "0daaa40c5da94cfb671166dad242da682302303d3ca7ecee72984f516b63297e"}, {"key": "bc0fa8e7cbd328e150b994e3", "speaker": "female", "text": "中文一，B卷，听力第3组。每段听两遍，请选择一个答案。", "sha256": "044535e0aee8426fa7d524f0c2861b2b3f0f412d2ec59631763c5b8ffdf7ae5d"}, {"key": "70f6a621764ce969099d6fa1", "speaker": "female", "text": "中文一，B卷，听力第4组。每段听两遍，请选择一个答案。", "sha256": "122d8dc1f85b7b12dbad8c775f30c3c8e71ac094427c71d7381193199ad0f4b3"}, {"key": "b51c31fbc39d4af6648daa24", "speaker": "male", "text": "我家有五个人：爷爷、爸爸、妈妈、姐姐和我。姐姐在大学读书，我在中学上学。我们都住在一起。", "sha256": "57c60d5f08393f2786250cd6025cd9c387c3c4b64b78fef17ef64842280fabf3"}, {"key": "34e89f8d03ace2b111d8dc37", "speaker": "female", "text": "第1题。", "sha256": "3895df58b8b6ce61365216490dcb339db3aa7ef168eef8d2098c469073a4cdc2"}, {"key": "cc94d9af1bfce222406c0ca0", "speaker": "female", "text": "我妈妈是医生，星期六也要去医院。爸爸星期六不工作，在家做饭。我和哥哥下午一起回家吃饭。", "sha256": "c2f9b2de9d2da87cf712963067d7970362703d8e887bda87b7f96d8dc1f42c69"}, {"key": "1741fb60958696627ba5f0ed", "speaker": "female", "text": "第2题。", "sha256": "39f2c75a46983608745be0da5fe2130f1e77b5cd88f7b9b3928a0a06485a2744"}, {"key": "10b9b5339cc9627aec6708dc", "speaker": "male", "text": "我们拍全家照时，爷爷坐在中间。爸爸站在爷爷左边，妈妈在右边。姐姐和我站在后面。", "sha256": "aadb1ff83759a8a6af35622d26fc1d659ba8ecbb79c53c73ad4498eda52d24fe"}, {"key": "97e9c8d06f3e0171388ee24b", "speaker": "female", "text": "第3题。", "sha256": "74d7fdba0fd9fae146470574deadbd8616eca796fece18aaf8190b3792f4225e"}, {"key": "11ff8761881a68fc15ef219f", "speaker": "female", "text": "你们好，我姓马，叫马文。我的中文老师姓林。今天王老师带我来这个班，我很高兴认识大家。", "sha256": "d5b3e0e39f124658b9811fb7a6046e174022e9dcc443e552416e26f461b2cd56"}, {"key": "b25d3caab3d72c3d0347de4b", "speaker": "female", "text": "第4题。", "sha256": "cc38e6d168e0664b2b8f98558b26288abcea294390f4e9aa13d8f457ef5a7046"}, {"key": "2de89c8dc7f514681e167439", "speaker": "male", "text": "我们上午在教室上课，中午去学校食堂吃饭。下午下课后，大家常常去操场运动。今天我也去。", "sha256": "f37fa75f9d6fd4bb5821ae55da8d6127071c30c344b5c6e37a58c344a3582116"}, {"key": "c5b1d9675aba74bbd668ea00", "speaker": "female", "text": "第5题。", "sha256": "057a4202f7d25216a190a84d6056c30f42be93ac60cdc21879a97aaaf19252d9"}, {"key": "031a10c6dc82c557238d0a40", "speaker": "female", "text": "同学们，请把书包放在椅子上，不要放在地上。桌子上只放书和本子。现在我们开始上课。", "sha256": "cb33718645a3c43d9e4b90c6cb603ec9c0fdc158f4bd416fc7397e46973f74d2"}, {"key": "5e6c5b336701fe2c48b7fa2f", "speaker": "female", "text": "第6题。", "sha256": "fcc5b0fabad8f1fa79148054a17b60ac8d2cb351d57ed0d5eb073df550e3ee93"}, {"key": "e3f055c30aa447473ed12f0c", "speaker": "male", "text": "老师，我今天能借三本书吗？", "sha256": "8953d24bb01bce7fc883dba98b5bddf10363c2334452bee235565c3ab53307c8"}, {"key": "aa1ac3f5da9631c23072fd65", "speaker": "female", "text": "每人一次只能借两本。你可以先选两本，明天还书以后再借。", "sha256": "b1f7c2227d10b0e840d0bbfb62d4692bcafff8258d988fd2eddffc8d74234791"}, {"key": "79e0bdfd02236c1d4253adc0", "speaker": "female", "text": "第7题。", "sha256": "5151859d99f51fb43c1c4ba74a72c7d8898fd12ebdb151ca350243f27169a52c"}, {"key": "7e9460cca88d9800639819db", "speaker": "female", "text": "今天体育课还在教室吗？", "sha256": "10045c0e3d22d46b957c0b6942ab8ee61f8e3db379f7c80ce5c1f86be8273c00"}, {"key": "1e9642a1ad6bfa891cd14b03", "speaker": "male", "text": "不，今天不下雨，我们去操场上课。", "sha256": "2aca67398e00533c905396444158e2f1185ad588adf6345fb463aa94fde6e0fc"}, {"key": "59ef7ede781ee2f905d2ea2b", "speaker": "female", "text": "好的，我叫同学们一起去操场。", "sha256": "5bbd4a39a7a283d262af5b904a987b6cd9013622ca9e96421e2bba7855c8f9b2"}, {"key": "b431efe26b8c6cc712ef43b8", "speaker": "female", "text": "第8题。", "sha256": "65ff1f952179bc643f6b488a3150eee5a21667f5901053151fd7aeb53f0c7786"}, {"key": "e11b8fdfb34e85cb9a9b4ad6", "speaker": "female", "text": "大家拿到纸了吗？请先在纸上写名字，再打开书。今天的练习很短，下课前我们一起看答案。", "sha256": "224983386edf11bb732863d00d5ee89a79c641e7b2fcbd1842ea90b03ba7641e"}, {"key": "76f9b7034e5801a6360f40bd", "speaker": "female", "text": "第9题。", "sha256": "439f37e4f9738e7ac1dc180f588ae4ed900731c0623d4038b9f3533da20c0ada"}, {"key": "13793e62356effe66a16aeb9", "speaker": "male", "text": "老师，下午两点上课，我想课前问一个问题。", "sha256": "1b508ce86eda9f5789eee1e5e61ad9c8e9b30429f8f9c58bce8704888d74d6bc"}, {"key": "ddde83d0b8ea4d0a9e5c90dc", "speaker": "female", "text": "可以，一点四十五来办公室吧。", "sha256": "e194574fdf1fffed299cddb56da875e2816637c6679d40eb24e1e1743edbfc29"}, {"key": "c03d26ce21a4b1237ad01ee3", "speaker": "male", "text": "好，我一点四十五到。", "sha256": "22b3978be1865cdaec3bfa21843acfed9b5b66d43a7e38eff99b9a110a52c589"}, {"key": "86d64da7bc27367110de5cb7", "speaker": "female", "text": "第10题。", "sha256": "a443b83201af7bae91780e167c2fcd53ef523b448bf77dd4ad6b238de2e582d2"}, {"key": "5c16b43ddc13aa592625cd5e", "speaker": "male", "text": "我要两个面包和一杯牛奶。", "sha256": "7b5528d2d4ad6af54b9ebd0914da44ea34c8f43db224541eeea928ccce161340"}, {"key": "5223b774690ce552358be5e0", "speaker": "female", "text": "面包卖完了，还有包子。", "sha256": "a086806fb42e03fd824e61c113d2c0573fc0bfb2d3ad5b743b52c58d7b817687"}, {"key": "fa312daf45033990151aa4f2", "speaker": "male", "text": "那我要两个包子吧，牛奶还是一杯。", "sha256": "3e7b83cd535521f31bc1430909f204d1e09296312fdc36d9608bc30eecd395df"}, {"key": "63d3dd3f27ad85dca9aa0606", "speaker": "female", "text": "第11题。", "sha256": "09609165ce7b5b5bbc80de6236e7726415e2ab45d65241e1ca3c75ec4a697f32"}, {"key": "9f49aaa6ead41d9a0a49dcc2", "speaker": "female", "text": "我们这桌要三杯热茶、两杯冷水。热茶给爸爸妈妈和奶奶，冷水给我和弟弟。请不要拿错了。", "sha256": "2eca5b56d3e6a4d109cf4e05ea0542cc2ca523bbcd49b42ee8fa20e841ecaeaf"}, {"key": "2dbff9b332f7edc61b4c3c18", "speaker": "female", "text": "第12题。", "sha256": "f25ea7d43ed9f81b7dd1af25fa0339498c7d458e79931122755e838f8d314a83"}, {"key": "dc3e10baca5b15ad5be9b8c4", "speaker": "male", "text": "今天这些苹果怎么样？", "sha256": "737acdcbdad3996a12fbd2229130436e055c789e591ba2ca48522084a89ea86f"}, {"key": "51370ca43f52fcd7840cefdc", "speaker": "female", "text": "有点儿酸，香蕉很甜。", "sha256": "b5e01290b4450065a33bb7d449bf9d50bf655ade2c8540ddcb9ec5baf0402ee7"}, {"key": "a226b8526bf702d28452d65d", "speaker": "male", "text": "我想买甜的。那我不要苹果了，买香蕉吧。", "sha256": "d14f3c8602a5de0c59c7d9440d695f2cb6c2b9d5e475ba4ae6bc1cb09d39946a"}, {"key": "ec1acc6c51d958bc6eb290a5", "speaker": "female", "text": "第13题。", "sha256": "e6515323a9eef38c0320124c2e99d81f002d229d597de7f44a76008521622c43"}, {"key": "b15e393e69ee8ab7701e0df1", "speaker": "male", "text": "这杯豆浆多少钱？", "sha256": "d2363657532df0c18ccebde5524a14e0387bb15f2b3699e2b4c4c73a87d5360b"}, {"key": "87c2a3c8331b846c1837aed1", "speaker": "female", "text": "九块。", "sha256": "333d4a7cf505f4df13dd853660f3182fb5824b969332a80e3753a4c984f99c92"}, {"key": "ca943c8f75c3f38777a609c6", "speaker": "male", "text": "给你十块。", "sha256": "6d3901867c5922a3a28810a4321828973fa0bd3b41ffbcccaf7a90db2c7350ea"}, {"key": "1f66bf9c8bbf1c3ff8ef14f7", "speaker": "female", "text": "谢谢，找你一块。豆浆有点儿热，请小心。", "sha256": "8b0251866cb0e06f1f1a2ae7f5cbbb7d2ac6c1a5353d3ac52f59fa64b03e0fbf"}, {"key": "6a9458d981e42c448c56e5d7", "speaker": "female", "text": "第14题。", "sha256": "3c248ca1222db546caafa3ccef0afeb1d63689c8e501a91b906f7c38012bc8f4"}, {"key": "a75992cd576642e8f26c796f", "speaker": "female", "text": "门口有一件外套、一条围巾和一顶帽子。外套是我的，围巾是姐姐的，帽子是弟弟的。我们都找到了。", "sha256": "03528e154fce7c0d722eb0845b3bcece5c80905189ffcc4d68ac151e09af8f45"}, {"key": "9d1b8c046279c5b498214791", "speaker": "female", "text": "第15题。", "sha256": "774136cf8893575562e62fc53ca824d970e119df2986004fbc9a795341529ed7"}, {"key": "c24cf8c7054a25cfcc7508a6", "speaker": "male", "text": "明天上午一起去买东西吧，十点见，好吗？", "sha256": "a9fc10c3c46ba6a7b71be964ff63aba1599dc5c4f969908a38f41f133fb7b885"}, {"key": "13ed1fb40f5f51e9be725ebe", "speaker": "female", "text": "好，我八点吃早饭，十二点要回家。十点见正好。", "sha256": "bf9eb3a5ac447638615a47935d14bb6b7ae17fbdba15fad1b03a2e7409d01dbf"}, {"key": "0cffbf1010d1e54023057ea9", "speaker": "female", "text": "第16题。", "sha256": "6cbe22b4463ef0127dbcb5957919648ee9b071c97d70d0b85edf327b6a0071df"}, {"key": "dd51dd3d73cfb7d170c4652d", "speaker": "female", "text": "今天下午什么时候能给你打电话？", "sha256": "46a4a3605d92caa43ec2d99d6a6ecb2debd55d56e220f7f66af20445139f07f1"}, {"key": "1711d8ec8930d8b7ec56438f", "speaker": "male", "text": "三点我在上课，四点到家，五点出去。你四点打给我吧。", "sha256": "aace61d939ebfcebfb3606a17de290d098a6f5c6cb33ea6cfc9f864862b80636"}, {"key": "61f4d2e4e5f3e0536be36453", "speaker": "female", "text": "第17题。", "sha256": "7b303e3cdea4e6b338b981ca7d27218c5da50fd4e2ca1cb297c3ba0853fbff6b"}, {"key": "cbf0d948b1c695d019920b84", "speaker": "male", "text": "我的白色运动鞋找不到了，你看见了吗？", "sha256": "d4e9cef4d8a1557420b8648043ce28251925aec70037a555612d0827a0ef46d4"}, {"key": "c32d2991e1c39352a5b65509", "speaker": "female", "text": "门口有一双黑色的。", "sha256": "063f52a3aa329ec0d8df53dc8cdbcab68512c737b858f1d1e6721a0df4ff736d"}, {"key": "760183eeae738878c6fa4de3", "speaker": "male", "text": "黑色的是爸爸的，我的白鞋在床下面。", "sha256": "40ac97e808985be4aa9c08215e50596f0ab68c6f5aa9f171678b81fdc0025c32"}, {"key": "2e9092b1191d42999a9f695d", "speaker": "female", "text": "第18题。", "sha256": "b0832c56a97774c35b538f689f08bf8314e263e14ab809871867bcdede27a70b"}, {"key": "c69c490e659e24a35c8ee815", "speaker": "female", "text": "你这周有什么活动？", "sha256": "88f30f8d453732644ef56f6534b1caf899b039af439547c025c70c49be2dea7d"}, {"key": "34660bf999c74740fdb31daa", "speaker": "male", "text": "星期三下午去游泳，星期五下午去公园。我喜欢游泳，也喜欢和朋友在公园走走。", "sha256": "7b6108877c0b290517e591fc1967b398000a4e4b296280ced3a93544cfad7213"}, {"key": "ee9540a1a810afba0a3a7056", "speaker": "female", "text": "第19题。", "sha256": "91a1a230e642a4906da5e058c485a56cf6a1c77b67c899338da1843b7db5066e"}, {"key": "d6bf5442f6a17d346d24764c", "speaker": "male", "text": "下午先去打球，好吗？", "sha256": "607c49747632c75baa061794c25a4193afaa9ec857b0f8c2c0ce83ff2c5ae863"}, {"key": "1119bc1f3959a37f84b0f673", "speaker": "female", "text": "我想先把这张画画完，然后去打球。", "sha256": "fb53bf201f0dd4cc2f7dc6ed9949f5738bf911dc623e607c63ff67760d7f9744"}, {"key": "646f25a6dc00dea8c8ce3377", "speaker": "male", "text": "好的，你画完以后叫我，我在家等你。", "sha256": "3d1cefb406ff673847cac068a94229971cdfbe64b5e6df119eb58d4b2abe3d54"}, {"key": "689adfbaa5b63ac16b96aac6", "speaker": "female", "text": "第20题。", "sha256": "f2a7aa65a74fad7dc9d19d81d6990ac99260287106ff304656efb599e75400e1"}, {"key": "e3f39eb640472bfdf7a1e998", "speaker": "male", "text": "你家有几个人？你和谁一起住？", "sha256": "40012b35c2b784b9e5f6d9e5fdcb787de108b802fbfed886af54cbb588f4b642"}, {"key": "f302b815b8ff1ff635599549", "speaker": "male", "text": "周末你喜欢做什么？不喜欢做什么？", "sha256": "dd967e9ccf2c6ff80e509ed5a68479609138e59e097848df229d8aebe1d2370f"}, {"key": "62e9e9a82790894272c3014d", "speaker": "male", "text": "星期五你几点下课？下课后去哪儿？", "sha256": "e5468b7b37fcb84d70ff392531057d5a7bb9970d015549b1852c582ea037908f"}, {"key": "ad23bf862781dbb9c8be8c23", "speaker": "male", "text": "星期天一起看电影，好吗？你上午还是下午有空？", "sha256": "5b32b1fa611276dd0a0cc0d768049b6da3730876d3a2407147f8aecdfcba87d5"}]}</script><script src="workspace.js" defer></script><noscript>Use the learner PDF and audio review if JavaScript is unavailable.</noscript></body></html>