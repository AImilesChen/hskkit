  "units": [
    {
      "id": "C2B-M01",
      "kind": "listening-source",
      "sourcePlays": 1,
      "script": [
        {
          "speaker": "female",
          "text": {
            "zh-Hans": "小何来帮我们照顾猫以前，家里要准备什么？",
            "zh-Hant": "小何來幫我們照顧貓以前，家裏要準備什麼？"
          }
        },
        {
          "speaker": "male",
          "text": {
            "zh-Hans": "你把猫粮放在桌上，我去把备用钥匙交给小何，猫的水我已经换好了。",
            "zh-Hant": "你把貓糧放在桌上，我去把備用鑰匙交給小何，貓的水我已經換好了。"
          }
        },
        {
          "speaker": "female",
          "text": {
            "zh-Hans": "好，我现在准备猫粮。",
            "zh-Hant": "好，我現在準備貓糧。"
          }
        }
      ],
      "sourceDurationSeconds": 15.196,
      "src": "assets/audio/c2b-m01.mp3",
      "durationSeconds": 15.744,
      "pcmSeconds": 15.696,
      "bytes": 126188,
      "sha256": "594f3974f30f68c9436bc2c63f610103878c140847ff76c6168e17fcb690ff7d"
    },
    {
      "id": "C2B-M02",
      "kind": "listening-source",
      "sourcePlays": 1,
      "script": [
        {
          "speaker": "male",
          "text": {
            "zh-Hans": "今天下午的宠物照顾活动几点开始？",
            "zh-Hant": "今天下午的寵物照顧活動幾點開始？"
          }
        },
        {
          "speaker": "female",
          "text": {
            "zh-Hans": "四点。三点半大家可以先看照片，四点老师教我们怎么给小狗梳毛，五点再提问题。",
            "zh-Hant": "四點。三點半大家可以先看照片，四點老師教我們怎麼給小狗梳毛，五點再提問題。"
          }
        },
        {
          "speaker": "male",
          "text": {
            "zh-Hans": "我四点前到。",
            "zh-Hant": "我四點前到。"
          }
        }
      ],
      "sourceDurationSeconds": 16.276,
      "src": "assets/audio/c2b-m02.mp3",
      "durationSeconds": 16.824,
      "pcmSeconds": 16.776,
      "bytes": 134828,
      "sha256": "692763139ca93334ab4e4734a664a40b7dbbd4e8f5594a0c8cdf48ba54fa325f"
    },
    {
      "id": "C2B-M03",
      "kind": "listening-source",
      "sourcePlays": 1,
      "script": [
        {
          "speaker": "female",
          "text": {
            "zh-Hans": "放学以后，我每次带小狗出去二十分钟。哥哥今天问我要不要走四十分钟，可是小狗走久了会累，我还是按平时的时间走。",
            "zh-Hant": "放學以後，我每次帶小狗出去二十分鐘。哥哥今天問我要不要走四十分鐘，可是小狗走久了會累，我還是按平時的時間走。"
          }
        }
      ],
      "sourceDurationSeconds": 12.072,
      "src": "assets/audio/c2b-m03.mp3",
      "durationSeconds": 12.624,
      "pcmSeconds": 12.572,
      "bytes": 101228,
      "sha256": "ea98d1835cf62b096be63faed43620b2c55fbcfec3bf93399754236520b15b89"
    },
    {
      "id": "C2B-M04",
      "kind": "listening-source",
      "sourcePlays": 1,
      "script": [
        {
          "speaker": "male",
          "text": {
            "zh-Hans": "你想学打球还是游泳？",
            "zh-Hant": "你想學打球還是游泳？"
          }
        },
        {
          "speaker": "female",
          "text": {
            "zh-Hans": "我想游泳，可是只有周三晚上有空。",
            "zh-Hant": "我想游泳，可是隻有周三晚上有空。"
          }
        },
        {
          "speaker": "male",
          "text": {
            "zh-Hans": "游泳课周二晚上开，周三有篮球课。",
            "zh-Hant": "游泳課週二晚上開，週三有籃球課。"
          }
        },
        {
          "speaker": "female",
          "text": {
            "zh-Hans": "那先试试篮球课吧。",
            "zh-Hant": "那先試試籃球課吧。"
          }
        }
      ],
      "sourceDurationSeconds": 15.282,
      "src": "assets/audio/c2b-m04.mp3",
      "durationSeconds": 15.84,
      "pcmSeconds": 15.782,
      "bytes": 126956,
      "sha256": "9d997d2a09ef48b80a87e050b332150f3b5c8c0997467ba9754c30e2143f2baf"
    },
    {
      "id": "C2B-M05",
      "kind": "listening-source",
      "sourcePlays": 1,
      "script": [
        {
          "speaker": "female",
          "text": {
            "zh-Hans": "上次打球，小丁忘了带水，打完以后一直说口渴。今天他还没出门，就先往书包里放了一大瓶水，旁边的球鞋倒是差点儿忘了。",
            "zh-Hant": "上次打球，小丁忘了帶水，打完以後一直說口渴。今天他還沒出門，就先往書包裏放了一大瓶水，旁邊的球鞋倒是差點兒忘了。"
          }
        }
      ],
      "sourceDurationSeconds": 13.152,
      "src": "assets/audio/c2b-m05.mp3",
      "durationSeconds": 13.704,
      "pcmSeconds": 13.652,
      "bytes": 109868,
      "sha256": "61520ae639724b215477d4103122e53fac4567efa8ca183a03b4ac73d75875f9"
    },
    {
      "id": "C2B-M06",
      "kind": "listening-source",
      "sourcePlays": 1,
      "script": [
        {
          "speaker": "male",
          "text": {
            "zh-Hans": "你到了运动中心就在游泳馆等我吧。",
            "zh-Hant": "你到了運動中心就在游泳館等我吧。"
          }
        },
        {
          "speaker": "female",
          "text": {
            "zh-Hans": "我不游泳，今天要上篮球课。我们在篮球馆门口见，别走到游泳馆去。",
            "zh-Hant": "我不游泳，今天要上籃球課。我們在籃球館門口見，別走到游泳館去。"
          }
        },
        {
          "speaker": "male",
          "text": {
            "zh-Hans": "好，我去篮球馆。",
            "zh-Hant": "好，我去籃球館。"
          }
        }
      ],
      "sourceDurationSeconds": 14.716,
      "src": "assets/audio/c2b-m06.mp3",
      "durationSeconds": 15.264,
      "pcmSeconds": 15.216,
      "bytes": 122348,
      "sha256": "6651a8664ea03bea56c758d468ee2fe6c9e505229d2c45db1a01cab64387c360"
    },
    {
      "id": "C2B-M07",
      "kind": "listening-source",
      "sourcePlays": 1,
      "script": [
        {
          "speaker": "female",
          "text": {
            "zh-Hans": "公交车还要等半个小时，你想怎么去运动中心？",
            "zh-Hant": "公交車還要等半個小時，你想怎麼去運動中心？"
          }
        },
        {
          "speaker": "male",
          "text": {
            "zh-Hans": "我们的自行车都在这儿，骑车只要十分钟。",
            "zh-Hant": "我們的自行車都在這兒，騎車只要十分鐘。"
          }
        },
        {
          "speaker": "female",
          "text": {
            "zh-Hans": "好，把球放进车篮，我们骑车去。",
            "zh-Hant": "好，把球放進車籃，我們騎車去。"
          }
        }
      ],
      "sourceDurationSeconds": 13.732,
      "src": "assets/audio/c2b-m07.mp3",
      "durationSeconds": 14.28,
      "pcmSeconds": 14.232,
      "bytes": 114476,
      "sha256": "3d7ee49dc1e40f8b85580932a3d411ae197fa8341d0b7e60b222d5a48462881b"
    },
    {
      "id": "C2B-M08",
      "kind": "listening-source",
      "sourcePlays": 1,
      "script": [
        {
          "speaker": "male",
          "text": {
            "zh-Hans": "从西门进去以后，怎么到篮球馆？",
            "zh-Hant": "從西門進去以後，怎麼到籃球館？"
          }
        },
        {
          "speaker": "female",
          "text": {
            "zh-Hans": "先穿过小广场，看到食堂再向左。篮球馆在食堂后面，不在停车场旁边。",
            "zh-Hant": "先穿過小廣場，看到食堂再向左。籃球館在食堂後面，不在停車場旁邊。"
          }
        },
        {
          "speaker": "male",
          "text": {
            "zh-Hans": "好，先过广场。",
            "zh-Hant": "好，先過廣場。"
          }
        }
      ],
      "sourceDurationSeconds": 15.532,
      "src": "assets/audio/c2b-m08.mp3",
      "durationSeconds": 16.08,
      "pcmSeconds": 16.032,
      "bytes": 128876,
      "sha256": "74a633eff18f6f4f4d22e923f0a6bbd63def2ff6e0e4d173ecf71ddef372c670"
    },
    {
      "id": "C2B-M09",
      "kind": "listening-source",
      "sourcePlays": 1,
      "script": [
        {
          "speaker": "female",
          "text": {
            "zh-Hans": "六路车两点前到运动中心，不用换车。十路车也能两点前到，可是中间要换一次。",
            "zh-Hant": "六路車兩點前到運動中心，不用換車。十路車也能兩點前到，可是中間要換一次。"
          }
        },
        {
          "speaker": "male",
          "text": {
            "zh-Hans": "我带着两个球和一个大包，不想换车，坐六路吧。",
            "zh-Hant": "我帶着兩個球和一個大包，不想換車，坐六路吧。"
          }
        }
      ],
      "sourceDurationSeconds": 14.486,
      "src": "assets/audio/c2b-m09.mp3",
      "durationSeconds": 15.048,
      "pcmSeconds": 14.986,
      "bytes": 120620,
      "sha256": "3f2375e57272ffc349db9bc6c715c10121d38cb89d820a5ba70e7ee5e4cffb70"
    },
    {
      "id": "C2B-M10",
      "kind": "listening-source",
      "sourcePlays": 1,
      "script": [
        {
          "speaker": "male",
          "text": {
            "zh-Hans": "星期六下午三点太热，室外练球还照原计划吗？",
            "zh-Hant": "星期六下午三點太熱，室外練球還照原計劃嗎？"
          }
        },
        {
          "speaker": "female",
          "text": {
            "zh-Hans": "老师说改到早上八点，地点不变，还是学校球场。",
            "zh-Hant": "老師說改到早上八點，地點不變，還是學校球場。"
          }
        },
        {
          "speaker": "male",
          "text": {
            "zh-Hans": "好，我把原来下午的提醒改掉。",
            "zh-Hant": "好，我把原來下午的提醒改掉。"
          }
        }
      ],
      "sourceDurationSeconds": 16.108,
      "src": "assets/audio/c2b-m10.mp3",
      "durationSeconds": 16.656,
      "pcmSeconds": 16.608,
      "bytes": 133484,
      "sha256": "755ddeddab775fd0131550a65932f766f66683c3f468163abbe7f5c5868cfc5b"
    },
    {
      "id": "C2B-M11",
      "kind": "listening-source",
      "sourcePlays": 1,
      "script": [
        {
          "speaker": "female",
          "text": {
            "zh-Hans": "野餐要带几盒果汁？",
            "zh-Hant": "野餐要帶幾盒果汁？"
          }
        },
        {
          "speaker": "male",
          "text": {
            "zh-Hans": "原来六个人，现在只有四个人去，一人一盒就够。",
            "zh-Hant": "原來六個人，現在只有四個人去，一人一盒就夠。"
          }
        },
        {
          "speaker": "female",
          "text": {
            "zh-Hans": "那我带四盒，面包另外买两袋。",
            "zh-Hant": "那我帶四盒，麪包另外買兩袋。"
          }
        },
        {
          "speaker": "male",
          "text": {
            "zh-Hans": "好，别按原来的人数买。",
            "zh-Hant": "好，別按原來的人數買。"
          }
        }
      ],
      "sourceDurationSeconds": 15.834,
      "src": "assets/audio/c2b-m11.mp3",
      "durationSeconds": 16.392,
      "pcmSeconds": 16.334,
      "bytes": 131372,
      "sha256": "809b4cc8b1c57d8a60e9e1c299aca975e4fc46d2a2cfa20f898d2395df263646"
    },
    {
      "id": "C2B-M12",
      "kind": "listening-source",
      "sourcePlays": 1,
      "script": [
        {
          "speaker": "male",
          "text": {
            "zh-Hans": "你想买哪张野餐垫？小号轻一些。",
            "zh-Hant": "你想買哪張野餐墊？小號輕一些。"
          }
        },
        {
          "speaker": "female",
          "text": {
            "zh-Hans": "我们四个人，小号只能坐两个人。我买能坐四个人的大号，蓝色和绿色都可以。",
            "zh-Hant": "我們四個人，小號只能坐兩個人。我買能坐四個人的大號，藍色和綠色都可以。"
          }
        },
        {
          "speaker": "male",
          "text": {
            "zh-Hans": "那拿这张绿色大号吧。",
            "zh-Hant": "那拿這張綠色大號吧。"
          }
        }
      ],
      "sourceDurationSeconds": 15.916,
      "src": "assets/audio/c2b-m12.mp3",
      "durationSeconds": 16.464,
      "pcmSeconds": 16.416,
      "bytes": 131948,
      "sha256": "16b5f404de6a3c84a9a235ef69748c92ac27e3acf2142094f391d49aaebe6460"
    },
    {
      "id": "C2B-M13",
      "kind": "listening-source",
      "sourcePlays": 1,
      "script": [
        {
          "speaker": "female",
          "text": {
            "zh-Hans": "这袋面包原来六块，今天学生买只要四块。纸袋要另外一块。",
            "zh-Hant": "這袋麪包原來六塊，今天學生買只要四塊。紙袋要另外一塊。"
          }
        },
        {
          "speaker": "male",
          "text": {
            "zh-Hans": "我是学生，自己带了袋子，只买面包。",
            "zh-Hant": "我是學生，自己帶了袋子，只買麪包。"
          }
        },
        {
          "speaker": "female",
          "text": {
            "zh-Hans": "那收你四块。",
            "zh-Hant": "那收你四塊。"
          }
        }
      ],
      "sourceDurationSeconds": 13.876,
      "src": "assets/audio/c2b-m13.mp3",
      "durationSeconds": 14.424,
      "pcmSeconds": 14.376,
      "bytes": 115628,
      "sha256": "c9e757e3a2919b5dcc364a0a5fc826775806dca5a89bff673eb3fae9b27b68db"
    },
    {
      "id": "C2B-M14",
      "kind": "listening-source",
      "sourcePlays": 1,
      "script": [
        {
          "speaker": "male",
          "text": {
            "zh-Hans": "野餐包要轻一点儿，还要能挡雨。甲包轻，可是怕水；乙包很重；丙包又轻又能挡雨。",
            "zh-Hant": "野餐包要輕一點兒，還要能擋雨。甲包輕，可是怕水；乙包很重；丙包又輕又能擋雨。"
          }
        },
        {
          "speaker": "female",
          "text": {
            "zh-Hans": "我们要走很久，天气也可能下雨，就选丙包。",
            "zh-Hant": "我們要走很久，天氣也可能下雨，就選丙包。"
          }
        }
      ],
      "sourceDurationSeconds": 14.798,
      "src": "assets/audio/c2b-m14.mp3",
      "durationSeconds": 15.36,
      "pcmSeconds": 15.298,
      "bytes": 123116,
      "sha256": "fb4a3ee214fdf8751c2422011d81424bd4d308e274a3868c18ab383eb432233a"
    },
    {
      "id": "C2B-M15",
      "kind": "listening-source",
      "sourcePlays": 1,
      "script": [
        {
          "speaker": "female",
          "text": {
            "zh-Hans": "小何六点来照顾猫，钥匙还在你那儿吗？",
            "zh-Hant": "小何六點來照顧貓，鑰匙還在你那兒嗎？"
          }
        },
        {
          "speaker": "male",
          "text": {
            "zh-Hans": "在，但我放学后要去打球，七点才到家。",
            "zh-Hant": "在，但我放學後要去打球，七點纔到家。"
          }
        },
        {
          "speaker": "female",
          "text": {
            "zh-Hans": "那你先把钥匙给楼下王阿姨，小何来了找她拿。",
            "zh-Hant": "那你先把鑰匙給樓下王阿姨，小何來了找她拿。"
          }
        }
      ],
      "sourceDurationSeconds": 14.524,
      "src": "assets/audio/c2b-m15.mp3",
      "durationSeconds": 15.072,
      "pcmSeconds": 15.024,
      "bytes": 120812,
      "sha256": "3ce66a9829cf3beef75ea57c55b9e420b2a1411c49bb95b11500163e18a1091c"
    },
    {
      "id": "C2B-M16",
      "kind": "listening-source",
      "sourcePlays": 1,
      "script": [
        {
          "speaker": "male",
          "text": {
            "zh-Hans": "早上还比较凉快，只有二十四度。下午会升到三十五度，也没有风。傍晚才慢慢凉下来。今天想去买球鞋的话，最好别在下午最热的时候出门。",
            "zh-Hant": "早上還比較涼快，只有二十四度。下午會升到三十五度，也沒有風。傍晚才慢慢涼下來。今天想去買球鞋的話，最好別在下午最熱的時候出門。"
          }
        }
      ],
      "sourceDurationSeconds": 13.8,
      "src": "assets/audio/c2b-m16.mp3",
      "durationSeconds": 14.352,
      "pcmSeconds": 14.3,
      "bytes": 115052,
      "sha256": "9445401064e3b8a6817a3a6b12a2372693c5cd842a811dacbcb0801184a29368"
    },
    {
      "id": "C2B-M17",
      "kind": "listening-source",
      "sourcePlays": 1,
      "script": [
        {
          "speaker": "female",
          "text": {
            "zh-Hans": "今天的球赛为什么改到晚上七点？场地没空吗？",
            "zh-Hant": "今天的球賽爲什麼改到晚上七點？場地沒空嗎？"
          }
        },
        {
          "speaker": "male",
          "text": {
            "zh-Hans": "场地一直能用，是下午太阳太强，大家怕热。晚上凉快一点儿，打起来更舒服。",
            "zh-Hant": "場地一直能用，是下午太陽太強，大家怕熱。晚上涼快一點兒，打起來更舒服。"
          }
        },
        {
          "speaker": "female",
          "text": {
            "zh-Hans": "明白了。",
            "zh-Hant": "明白了。"
          }
        }
      ],
      "sourceDurationSeconds": 16.444,
      "src": "assets/audio/c2b-m17.mp3",
      "durationSeconds": 16.992,
      "pcmSeconds": 16.944,
      "bytes": 136172,
      "sha256": "6e21162c508979f0aa895f2f699287d5f0d8361f734226f11ae8a98e5d1c2b3f"
    },
    {
      "id": "C2B-M18",
      "kind": "listening-source",
      "sourcePlays": 1,
      "script": [
        {
          "speaker": "male",
          "text": {
            "zh-Hans": "我今天想运动，但老师说每次别超过一个小时，也先别跑步。",
            "zh-Hant": "我今天想運動，但老師說每次別超過一個小時，也先別跑步。"
          }
        },
        {
          "speaker": "female",
          "text": {
            "zh-Hans": "那可以选五十分钟的投篮课。跑步课只有半小时，游泳课却要九十分钟。",
            "zh-Hant": "那可以選五十分鐘的投籃課。跑步課只有半小時，游泳課卻要九十分鐘。"
          }
        },
        {
          "speaker": "male",
          "text": {
            "zh-Hans": "好，我去投篮。",
            "zh-Hant": "好，我去投籃。"
          }
        }
      ],
      "sourceDurationSeconds": 17.188,
      "src": "assets/audio/c2b-m18.mp3",
      "durationSeconds": 17.736,
      "pcmSeconds": 17.688,
      "bytes": 142124,
      "sha256": "fd3e397e7737c34a964e61585f19feabca2a10778f57a163c81be6f7871c473b"
    },
    {
      "id": "C2B-M19",
      "kind": "listening-source",
      "sourcePlays": 1,
      "script": [
        {
          "speaker": "female",
          "text": {
            "zh-Hans": "端午那天，我们先在河边看龙舟，回来以后听老师讲活动的故事。听完故事，大家才到教室学做香包。我做的香包送给了弟弟，他特别喜欢。",
            "zh-Hant": "端午那天，我們先在河邊看龍舟，回來以後聽老師講活動的故事。聽完故事，大家纔到教室學做香包。我做的香包送給了弟弟，他特別喜歡。"
          }
        }
      ],
      "sourceDurationSeconds": 14.52,
      "src": "assets/audio/c2b-m19.mp3",
      "durationSeconds": 15.072,
      "pcmSeconds": 15.02,
      "bytes": 120812,
      "sha256": "77b266e37d81cd7ceef8c168227ad563bdcae5997dd17ef3cf59caa58d6b0971"
    },
    {
      "id": "C2B-M20",
      "kind": "listening-source",
      "sourcePlays": 1,
      "script": [
        {
          "speaker": "male",
          "text": {
            "zh-Hans": "端午活动刚开始，小方说自己手笨，做不好香包。老师陪着她做了一次。后来老师还没走过来，她已经自己做好第二个，又开始教旁边的小朋友了。",
            "zh-Hant": "端午活動剛開始，小方說自己手笨，做不好香包。老師陪着她做了一次。後來老師還沒走過來，她已經自己做好第二個，又開始教旁邊的小朋友了。"
          }
        }
      ],
      "sourceDurationSeconds": 14.112,
      "src": "assets/audio/c2b-m20.mp3",
      "durationSeconds": 14.664,
      "pcmSeconds": 14.612,
      "bytes": 117548,
      "sha256": "b017a30b0f0bc4227cad2dfc9ff05f8698572f7df99a16dbfc2bc23eec1678b8"
    },
    {
      "id": "S1-1",
      "kind": "oral-prompt",
      "sourcePlays": 2,
      "singlePlayPcmSeconds": 8.664,
