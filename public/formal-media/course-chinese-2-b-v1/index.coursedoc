<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="robots" content="noindex,nofollow"><base href="/api/v1/course-tests/chinese-2/b/file/"><title>Chinese 2 · Paper B · HSKKit</title><link rel="stylesheet" href="workspace.css"></head><body><header class="bar"><a class="brand" href="/">HSKKit</a><a href="/chinese-course-tests#chinese-2">← Chinese 2 papers</a></header><div id="live" class="live" aria-live="polite"></div><div id="clockbar" class="clockbar" hidden><strong id="clock" role="timer"></strong><span id="oral-clock" role="timer"></span></div><div id="audio-dock" class="audio-dock" hidden><strong id="audio-label"></strong><audio id="listening-player" controls preload="metadata"></audio><p id="audio-error" role="alert" hidden>Audio could not load. Retry or open Audio review.</p></div><main id="app"></main><audio id="prompt-player" preload="none"></audio><footer><p>Independent HSKKit course review. Writing and speaking need manual review. Not an official school, HSK or ACTFL assessment.</p><a href="listening.html">Audio review</a> · <a href="teacher.html">Answer guide</a></footer><script id="paper-data" type="application/json">{"id": "course-chinese-2-b-v1", "product": "HSKKit Chinese 2 Course Review", "paperCode": "B", "version": "content-draft-v1", "authoredOn": "2026-11-10", "status": "content_authored_independent_acceptance_pending", "officialExam": false, "purpose": "Review HSKKit Chinese 2 scope only; no school credit, placement or official level conversion.", "blueprint": {"id": "course-chinese-2-blueprint-v1", "source": "docs/course-chinese2-spec-20261110/blueprint.json", "sha256": "aa5a92d630a8e6063448555a90ce684a2b1569012b15be2b11f686e902575dae"}, "provenance": {"original": true, "aiAssisted": true, "competitorQuestionsCopied": false, "relabelledHskQuestions": false, "humanListeningAcceptance": false, "teacherReview": false, "learnerPilot": false, "userAcceptance": false, "traditionalScript": "OpenCC s2t with author comparison; independent review pending"}, "order": ["listening", "reading", "writing", "speaking"], "sections": [{"id": "listening", "seconds": 1200, "objectiveItems": 20, "groups": 4, "itemsPerGroup": 5, "sourcePlays": 2}, {"id": "reading", "seconds": 1500, "objectiveItems": 20, "groups": 4, "itemsPerGroup": 5}, {"id": "writing", "seconds": 1200, "manualTasks": 2, "sharedClock": true}, {"id": "speaking", "seconds": 600, "manualTasks": 2}], "counts": {"listening": 20, "reading": 20, "writing": 2, "speaking": 2, "speakingRecordings": 5, "topLevelTasks": 44}, "scoring": {"listeningMax": 20, "readingMax": 20, "pointsPerObjectiveItem": 1, "incorrectOrUnansweredPoints": 0, "manualTaskMax": 8, "combinedScore": null, "passCutoff": null, "officialConversion": null, "unsubmittedManual": "unsubmitted", "technicalFailureManual": "needs_rerecording"}, "materials": [{"id": "C2B-M01", "title": "Before the pet sitter arrives", "section": "listening", "kind": "short-audio", "original": true, "script": [{"speaker": "female", "text": {"zh-Hans": "小何来帮我们照顾猫以前，家里要准备什么？", "zh-Hant": "小何來幫我們照顧貓以前，家裏要準備什麼？"}}, {"speaker": "male", "text": {"zh-Hans": "你把猫粮放在桌上，我去把备用钥匙交给小何，猫的水我已经换好了。", "zh-Hant": "你把貓糧放在桌上，我去把備用鑰匙交給小何，貓的水我已經換好了。"}}, {"speaker": "female", "text": {"zh-Hans": "好，我现在准备猫粮。", "zh-Hant": "好，我現在準備貓糧。"}}], "glossary": []}, {"id": "C2B-M02", "title": "An after-school demonstration", "section": "listening", "kind": "short-audio", "original": true, "script": [{"speaker": "male", "text": {"zh-Hans": "今天下午的宠物照顾活动几点开始？", "zh-Hant": "今天下午的寵物照顧活動幾點開始？"}}, {"speaker": "female", "text": {"zh-Hans": "四点。三点半大家可以先看照片，四点老师教我们怎么给小狗梳毛，五点再提问题。", "zh-Hant": "四點。三點半大家可以先看照片，四點老師教我們怎麼給小狗梳毛，五點再提問題。"}}, {"speaker": "male", "text": {"zh-Hans": "我四点前到。", "zh-Hant": "我四點前到。"}}], "glossary": []}, {"id": "C2B-M03", "title": "Taking turns with the dog", "section": "listening", "kind": "short-audio", "original": true, "script": [{"speaker": "female", "text": {"zh-Hans": "放学以后，我每次带小狗出去二十分钟。哥哥今天问我要不要走四十分钟，可是小狗走久了会累，我还是按平时的时间走。", "zh-Hant": "放學以後，我每次帶小狗出去二十分鐘。哥哥今天問我要不要走四十分鐘，可是小狗走久了會累，我還是按平時的時間走。"}}], "glossary": []}, {"id": "C2B-M04", "title": "Trying a sports class", "section": "listening", "kind": "short-audio", "original": true, "script": [{"speaker": "male", "text": {"zh-Hans": "你想学打球还是游泳？", "zh-Hant": "你想學打球還是游泳？"}}, {"speaker": "female", "text": {"zh-Hans": "我想游泳，可是只有周三晚上有空。", "zh-Hant": "我想游泳，可是隻有周三晚上有空。"}}, {"speaker": "male", "text": {"zh-Hans": "游泳课周二晚上开，周三有篮球课。", "zh-Hant": "游泳課週二晚上開，週三有籃球課。"}}, {"speaker": "female", "text": {"zh-Hans": "那先试试篮球课吧。", "zh-Hant": "那先試試籃球課吧。"}}], "glossary": []}, {"id": "C2B-M05", "title": "Remembering water for practice", "section": "listening", "kind": "short-audio", "original": true, "script": [{"speaker": "female", "text": {"zh-Hans": "上次打球，小丁忘了带水，打完以后一直说口渴。今天他还没出门，就先往书包里放了一大瓶水，旁边的球鞋倒是差点儿忘了。", "zh-Hant": "上次打球，小丁忘了帶水，打完以後一直說口渴。今天他還沒出門，就先往書包裏放了一大瓶水，旁邊的球鞋倒是差點兒忘了。"}}], "glossary": []}, {"id": "C2B-M06", "title": "A precise meeting place", "section": "listening", "kind": "short-audio", "original": true, "script": [{"speaker": "male", "text": {"zh-Hans": "你到了运动中心就在游泳馆等我吧。", "zh-Hant": "你到了運動中心就在游泳館等我吧。"}}, {"speaker": "female", "text": {"zh-Hans": "我不游泳，今天要上篮球课。我们在篮球馆门口见，别走到游泳馆去。", "zh-Hant": "我不游泳，今天要上籃球課。我們在籃球館門口見，別走到游泳館去。"}}, {"speaker": "male", "text": {"zh-Hans": "好，我去篮球馆。", "zh-Hant": "好，我去籃球館。"}}], "glossary": []}, {"id": "C2B-M07", "title": "Getting to the centre", "section": "listening", "kind": "short-audio", "original": true, "script": [{"speaker": "female", "text": {"zh-Hans": "公交车还要等半个小时，你想怎么去运动中心？", "zh-Hant": "公交車還要等半個小時，你想怎麼去運動中心？"}}, {"speaker": "male", "text": {"zh-Hans": "我们的自行车都在这儿，骑车只要十分钟。", "zh-Hant": "我們的自行車都在這兒，騎車只要十分鐘。"}}, {"speaker": "female", "text": {"zh-Hans": "好，把球放进车篮，我们骑车去。", "zh-Hant": "好，把球放進車籃，我們騎車去。"}}], "glossary": []}, {"id": "C2B-M08", "title": "Entering the sports centre", "section": "listening", "kind": "short-audio", "original": true, "script": [{"speaker": "male", "text": {"zh-Hans": "从西门进去以后，怎么到篮球馆？", "zh-Hant": "從西門進去以後，怎麼到籃球館？"}}, {"speaker": "female", "text": {"zh-Hans": "先穿过小广场，看到食堂再向左。篮球馆在食堂后面，不在停车场旁边。", "zh-Hant": "先穿過小廣場，看到食堂再向左。籃球館在食堂後面，不在停車場旁邊。"}}, {"speaker": "male", "text": {"zh-Hans": "好，先过广场。", "zh-Hant": "好，先過廣場。"}}], "glossary": []}, {"id": "C2B-M09", "title": "Carrying equipment on a bus", "section": "listening", "kind": "short-audio", "original": true, "script": [{"speaker": "female", "text": {"zh-Hans": "六路车两点前到运动中心，不用换车。十路车也能两点前到，可是中间要换一次。", "zh-Hant": "六路車兩點前到運動中心，不用換車。十路車也能兩點前到，可是中間要換一次。"}}, {"speaker": "male", "text": {"zh-Hans": "我带着两个球和一个大包，不想换车，坐六路吧。", "zh-Hant": "我帶着兩個球和一個大包，不想換車，坐六路吧。"}}], "glossary": []}, {"id": "C2B-M10", "title": "A cooler time for training", "section": "listening", "kind": "short-audio", "original": true, "script": [{"speaker": "male", "text": {"zh-Hans": "星期六下午三点太热，室外练球还照原计划吗？", "zh-Hant": "星期六下午三點太熱，室外練球還照原計劃嗎？"}}, {"speaker": "female", "text": {"zh-Hans": "老师说改到早上八点，地点不变，还是学校球场。", "zh-Hant": "老師說改到早上八點，地點不變，還是學校球場。"}}, {"speaker": "male", "text": {"zh-Hans": "好，我把原来下午的提醒改掉。", "zh-Hant": "好，我把原來下午的提醒改掉。"}}], "glossary": []}, {"id": "C2B-M11", "title": "Packing for a picnic", "section": "listening", "kind": "short-audio", "original": true, "script": [{"speaker": "female", "text": {"zh-Hans": "野餐要带几盒果汁？", "zh-Hant": "野餐要帶幾盒果汁？"}}, {"speaker": "male", "text": {"zh-Hans": "原来六个人，现在只有四个人去，一人一盒就够。", "zh-Hant": "原來六個人，現在只有四個人去，一人一盒就夠。"}}, {"speaker": "female", "text": {"zh-Hans": "那我带四盒，面包另外买两袋。", "zh-Hant": "那我帶四盒，麪包另外買兩袋。"}}, {"speaker": "male", "text": {"zh-Hans": "好，别按原来的人数买。", "zh-Hant": "好，別按原來的人數買。"}}], "glossary": []}, {"id": "C2B-M12", "title": "A mat for the whole group", "section": "listening", "kind": "short-audio", "original": true, "script": [{"speaker": "male", "text": {"zh-Hans": "你想买哪张野餐垫？小号轻一些。", "zh-Hant": "你想買哪張野餐墊？小號輕一些。"}}, {"speaker": "female", "text": {"zh-Hans": "我们四个人，小号只能坐两个人。我买能坐四个人的大号，蓝色和绿色都可以。", "zh-Hant": "我們四個人，小號只能坐兩個人。我買能坐四個人的大號，藍色和綠色都可以。"}}, {"speaker": "male", "text": {"zh-Hans": "那拿这张绿色大号吧。", "zh-Hant": "那拿這張綠色大號吧。"}}], "glossary": []}, {"id": "C2B-M13", "title": "A student offer", "section": "listening", "kind": "short-audio", "original": true, "script": [{"speaker": "female", "text": {"zh-Hans": "这袋面包原来六块，今天学生买只要四块。纸袋要另外一块。", "zh-Hant": "這袋麪包原來六塊，今天學生買只要四塊。紙袋要另外一塊。"}}, {"speaker": "male", "text": {"zh-Hans": "我是学生，自己带了袋子，只买面包。", "zh-Hant": "我是學生，自己帶了袋子，只買麪包。"}}, {"speaker": "female", "text": {"zh-Hans": "那收你四块。", "zh-Hant": "那收你四塊。"}}], "glossary": []}, {"id": "C2B-M14", "title": "A practical picnic bag", "section": "listening", "kind": "short-audio", "original": true, "script": [{"speaker": "male", "text": {"zh-Hans": "野餐包要轻一点儿，还要能挡雨。甲包轻，可是怕水；乙包很重；丙包又轻又能挡雨。", "zh-Hant": "野餐包要輕一點兒，還要能擋雨。甲包輕，可是怕水；乙包很重；丙包又輕又能擋雨。"}}, {"speaker": "female", "text": {"zh-Hans": "我们要走很久，天气也可能下雨，就选丙包。", "zh-Hant": "我們要走很久，天氣也可能下雨，就選丙包。"}}], "glossary": []}, {"id": "C2B-M15", "title": "The pet sitter’s key", "section": "listening", "kind": "short-audio", "original": true, "script": [{"speaker": "female", "text": {"zh-Hans": "小何六点来照顾猫，钥匙还在你那儿吗？", "zh-Hant": "小何六點來照顧貓，鑰匙還在你那兒嗎？"}}, {"speaker": "male", "text": {"zh-Hans": "在，但我放学后要去打球，七点才到家。", "zh-Hant": "在，但我放學後要去打球，七點纔到家。"}}, {"speaker": "female", "text": {"zh-Hans": "那你先把钥匙给楼下王阿姨，小何来了找她拿。", "zh-Hant": "那你先把鑰匙給樓下王阿姨，小何來了找她拿。"}}], "glossary": []}, {"id": "C2B-M16", "title": "Heat later in the day", "section": "listening", "kind": "short-audio", "original": true, "script": [{"speaker": "male", "text": {"zh-Hans": "早上还比较凉快，只有二十四度。下午会升到三十五度，也没有风。傍晚才慢慢凉下来。今天想去买球鞋的话，最好别在下午最热的时候出门。", "zh-Hant": "早上還比較涼快，只有二十四度。下午會升到三十五度，也沒有風。傍晚才慢慢涼下來。今天想去買球鞋的話，最好別在下午最熱的時候出門。"}}], "glossary": []}, {"id": "C2B-M17", "title": "Why the start time changed", "section": "listening", "kind": "short-audio", "original": true, "script": [{"speaker": "female", "text": {"zh-Hans": "今天的球赛为什么改到晚上七点？场地没空吗？", "zh-Hant": "今天的球賽爲什麼改到晚上七點？場地沒空嗎？"}}, {"speaker": "male", "text": {"zh-Hans": "场地一直能用，是下午太阳太强，大家怕热。晚上凉快一点儿，打起来更舒服。", "zh-Hant": "場地一直能用，是下午太陽太強，大家怕熱。晚上涼快一點兒，打起來更舒服。"}}, {"speaker": "female", "text": {"zh-Hans": "明白了。", "zh-Hant": "明白了。"}}], "glossary": []}, {"id": "C2B-M18", "title": "A manageable practice session", "section": "listening", "kind": "short-audio", "original": true, "script": [{"speaker": "male", "text": {"zh-Hans": "我今天想运动，但老师说每次别超过一个小时，也先别跑步。", "zh-Hant": "我今天想運動，但老師說每次別超過一個小時，也先別跑步。"}}, {"speaker": "female", "text": {"zh-Hans": "那可以选五十分钟的投篮课。跑步课只有半小时，游泳课却要九十分钟。", "zh-Hant": "那可以選五十分鐘的投籃課。跑步課只有半小時，游泳課卻要九十分鐘。"}}, {"speaker": "male", "text": {"zh-Hans": "好，我去投篮。", "zh-Hant": "好，我去投籃。"}}], "glossary": []}, {"id": "C2B-M19", "title": "A festival visit in stages", "section": "listening", "kind": "short-audio", "original": true, "script": [{"speaker": "female", "text": {"zh-Hans": "端午那天，我们先在河边看龙舟，回来以后听老师讲活动的故事。听完故事，大家才到教室学做香包。我做的香包送给了弟弟，他特别喜欢。", "zh-Hant": "端午那天，我們先在河邊看龍舟，回來以後聽老師講活動的故事。聽完故事，大家纔到教室學做香包。我做的香包送給了弟弟，他特別喜歡。"}}], "glossary": []}, {"id": "C2B-M20", "title": "A growing sense of confidence", "section": "listening", "kind": "short-audio", "original": true, "script": [{"speaker": "male", "text": {"zh-Hans": "端午活动刚开始，小方说自己手笨，做不好香包。老师陪着她做了一次。后来老师还没走过来，她已经自己做好第二个，又开始教旁边的小朋友了。", "zh-Hant": "端午活動剛開始，小方說自己手笨，做不好香包。老師陪着她做了一次。後來老師還沒走過來，她已經自己做好第二個，又開始教旁邊的小朋友了。"}}], "glossary": []}, {"id": "C2B-M21", "title": "A note for feeding the rabbit", "section": "reading", "kind": "text-card", "original": true, "text": {"zh-Hans": "给小宁的留言\n兔子的晚饭我已经放在盒子里，六点开盒子就可以。今天放学后，请你先把空水瓶装满。兔笼我早上已经打扫过了，不用再打扫，也不要另外买饲料。\n爸爸", "zh-Hant": "給小寧的留言\n兔子的晚飯我已經放在盒子裏，六點開盒子就可以。今天放學後，請你先把空水瓶裝滿。兔籠我早上已經打掃過了，不用再打掃，也不要另外買飼料。\n爸爸"}, "glossary": [{"term": {"zh-Hans": "兔笼", "zh-Hant": "兔籠"}, "meaningEn": "rabbit cage"}]}, {"id": "C2B-M22", "title": "A programme with several stages", "section": "reading", "kind": "text-card", "original": true, "text": {"zh-Hans": "课后宠物小组\n周五三点半开门，四点开始讲解。四点半大家练习怎样给猫梳毛，五点离开。第一次来的同学请三点四十前到，先登记姓名，不要把到场时间当成讲解开始时间。", "zh-Hant": "課後寵物小組\n週五三點半開門，四點開始講解。四點半大家練習怎樣給貓梳毛，五點離開。第一次來的同學請三點四十前到，先登記姓名，不要把到場時間當成講解開始時間。"}, "glossary": [{"term": {"zh-Hans": "梳毛", "zh-Hant": "梳毛"}, "meaningEn": "brush fur"}]}, {"id": "C2B-M23", "title": "A short daily responsibility", "section": "reading", "kind": "text-card", "original": true, "text": {"zh-Hans": "照顾小狗的约定\n这个星期，小安每天放学后带小狗出去十五分钟，回来再准备自己的晚饭。星期三虽然放学晚，也照常出去十五分钟。周末改由哥哥照顾，但每次时间仍然一样。", "zh-Hant": "照顧小狗的約定\n這個星期，小安每天放學後帶小狗出去十五分鐘，回來再準備自己的晚飯。星期三雖然放學晚，也照常出去十五分鐘。週末改由哥哥照顧，但每次時間仍然一樣。"}, "glossary": []}, {"id": "C2B-M24", "title": "Choosing a class after a rest day", "section": "reading", "kind": "text-card", "original": true, "text": {"zh-Hans": "小安的选课卡\n本周只有周一下午能参加活动，想学球类运动。运动中心周一有羽毛球课、周二有篮球课，周一另有绘画课。三种课都不需要以前学过，费用也都一样。", "zh-Hant": "小安的選課卡\n本週只有週一下午能參加活動，想學球類運動。運動中心週一有羽毛球課、週二有籃球課，週一另有繪畫課。三種課都不需要以前學過，費用也都一樣。"}, "glossary": []}, {"id": "C2B-M25", "title": "A useful reminder", "section": "reading", "kind": "text-card", "original": true, "text": {"zh-Hans": "运动后的记录\n以前小宁一打完球就赶着回家，书包里也总忘放水。昨天教练提醒他带水，并在结束后坐一会儿。他照着做了，回家路上说比以前轻松，打算下次也提前准备。", "zh-Hant": "運動後的記錄\n以前小寧一打完球就趕着回家，書包裏也總忘放水。昨天教練提醒他帶水，並在結束後坐一會兒。他照着做了，回家路上說比以前輕鬆，打算下次也提前準備。"}, "glossary": []}, {"id": "C2B-M26", "title": "A venue inside a large complex", "section": "reading", "kind": "text-card", "original": true, "text": {"zh-Hans": "集合消息\n运动中心里有游泳馆、篮球馆和网球场。本周小组的球拍课在网球场，大家直接在那里集合，不用先去售票处等。游泳馆今天只对学校开放，篮球馆下午有比赛。", "zh-Hant": "集合消息\n運動中心裏有游泳館、籃球館和網球場。本週小組的球拍課在網球場，大家直接在那裏集合，不用先去售票處等。游泳館今天只對學校開放，籃球館下午有比賽。"}, "glossary": [{"term": {"zh-Hans": "售票处", "zh-Hant": "售票處"}, "meaningEn": "ticket office"}]}, {"id": "C2B-M27", "title": "A route with equipment", "section": "reading", "kind": "text-card", "original": true, "text": {"zh-Hans": "小组交通约定\n教练会用小巴接大家到运动中心，车上可以放球拍。请九点在学校南门等，不用自己骑车。我们到了中心还要一起检查器材，所以先别一个人提前过去。", "zh-Hant": "小組交通約定\n教練會用小巴接大家到運動中心，車上可以放球拍。請九點在學校南門等，不用自己騎車。我們到了中心還要一起檢查器材，所以先別一個人提前過去。"}, "glossary": [{"term": {"zh-Hans": "器材", "zh-Hant": "器材"}, "meaningEn": "equipment"}]}, {"id": "C2B-M28", "title": "Finding the practice hall", "section": "reading", "kind": "text-card", "original": true, "text": {"zh-Hans": "运动中心入口图说明\n由北门进入后，先经过小花园，到服务台领取活动卡，再按蓝色箭头上二楼。练习馆就在楼梯右边。没有活动卡不能进馆，请不要进门就直接上楼。", "zh-Hant": "運動中心入口圖說明\n由北門進入後，先經過小花園，到服務檯領取活動卡，再按藍色箭頭上二樓。練習館就在樓梯右邊。沒有活動卡不能進館，請不要進門就直接上樓。"}, "glossary": []}, {"id": "C2B-M29", "title": "Two entrances with different opening times", "section": "reading", "kind": "text-card", "original": true, "text": {"zh-Hans": "运动中心入口卡\n东门九点开放，从车站步行十五分钟。西门十点开放，从车站步行五分钟。小何九点下车，要在九点半前进场。进门以后到教室的路程一样，他不能等到十点。", "zh-Hant": "運動中心入口卡\n東門九點開放，從車站步行十五分鐘。西門十點開放，從車站步行五分鐘。小何九點下車，要在九點半前進場。進門以後到教室的路程一樣，他不能等到十點。"}, "glossary": [{"term": {"zh-Hans": "步行", "zh-Hant": "步行"}, "meaningEn": "on foot"}]}, {"id": "C2B-M30", "title": "An indoor replacement activity", "section": "reading", "kind": "text-card", "original": true, "text": {"zh-Hans": "运动中心活动更新\n周六下午太热，原定两点在室外参观球场的活动取消，改看一楼展厅里的运动照片展。开始时间仍是下午两点，不需要去游泳馆集合。请把这条新消息告诉其他同学。", "zh-Hant": "運動中心活動更新\n週六下午太熱，原定兩點在室外參觀球場的活動取消，改看一樓展廳裏的運動照片展。開始時間仍是下午兩點，不需要去游泳館集合。請把這條新消息告訴其他同學。"}, "glossary": []}, {"id": "C2B-M31", "title": "A picnic packing list", "section": "reading", "kind": "text-card", "original": true, "text": {"zh-Hans": "野餐装箱单\n果汁五盒，牛奶两盒，面包三袋。小林带果汁，小陈带面包，老师带牛奶。名单上有五位同学，每个人可以拿一盒果汁；牛奶是留给另外两位帮忙的家长的。", "zh-Hant": "野餐裝箱單\n果汁五盒，牛奶兩盒，麪包三袋。小林帶果汁，小陳帶麪包，老師帶牛奶。名單上有五位同學，每個人可以拿一盒果汁；牛奶是留給另外兩位幫忙的家長的。"}, "glossary": []}, {"id": "C2B-M32", "title": "A picnic mat label", "section": "reading", "kind": "text-card", "original": true, "text": {"zh-Hans": "用品卡\n小号垫：两个人坐，收起来放进书包。\n大号垫：四个人坐，需要单独拿。\n这次四位同学只有一张垫子的预算，大家都想坐在垫子上，不能再借别人的垫子。", "zh-Hant": "用品卡\n小號墊：兩個人坐，收起來放進書包。\n大號墊：四個人坐，需要單獨拿。\n這次四位同學只有一張墊子的預算，大家都想坐在墊子上，不能再借別人的墊子。"}, "glossary": []}, {"id": "C2B-M33", "title": "Borrowing a picnic basket", "section": "reading", "kind": "text-card", "original": true, "text": {"zh-Hans": "野餐篮租用单\n一天使用费十元，另交押金二十元。小何先付三十元，店员说明：按时还回完整的篮子，就退二十元押金；十元使用费不退。小何打算当天傍晚按时归还。", "zh-Hant": "野餐籃租用單\n一天使用費十元，另交押金二十元。小何先付三十元，店員說明：按時還回完整的籃子，就退二十元押金；十元使用費不退。小何打算當天傍晚按時歸還。"}, "glossary": [{"term": {"zh-Hans": "押金", "zh-Hant": "押金"}, "meaningEn": "refundable deposit"}]}, {"id": "C2B-M34", "title": "Buying without a kitchen", "section": "reading", "kind": "text-card", "original": true, "text": {"zh-Hans": "野餐准备\n公园没有厨房，也没有冰箱。甲套餐是需要加热的生饺子；乙套餐是面包和洗好的苹果，不用加热也不用冷藏；丙套餐要一直冷藏。小组要在公园待三小时，只能带一套。", "zh-Hant": "野餐準備\n公園沒有廚房，也沒有冰箱。甲套餐是需要加熱的生餃子；乙套餐是麪包和洗好的蘋果，不用加熱也不用冷藏；丙套餐要一直冷藏。小組要在公園待三小時，只能帶一套。"}, "glossary": [{"term": {"zh-Hans": "冷藏", "zh-Hant": "冷藏"}, "meaningEn": "keep refrigerated"}]}, {"id": "C2B-M35", "title": "Passing on responsibility", "section": "reading", "kind": "text-card", "original": true, "text": {"zh-Hans": "家庭群消息\n妈妈今天五点到家，小安四点半下课，哥哥六点回来。小狗五点以前要有人接回家。妈妈说自己赶不上，小安答应放学直接去接，哥哥回来以后再带狗出去走走。", "zh-Hant": "家庭羣消息\n媽媽今天五點到家，小安四點半下課，哥哥六點回來。小狗五點以前要有人接回家。媽媽說自己趕不上，小安答應放學直接去接，哥哥回來以後再帶狗出去走走。"}, "glossary": []}, {"id": "C2B-M36", "title": "A hot afternoon forecast", "section": "reading", "kind": "text-card", "original": true, "text": {"zh-Hans": "周日天气表\n早晨二十三度，微风；下午三十六度，无风；晚上二十七度。运动中心提醒：下午来上课请带水，不要把早晨的凉快当成全天的天气，室外活动尽量避开午后。", "zh-Hant": "週日天氣表\n早晨二十三度，微風；下午三十六度，無風；晚上二十七度。運動中心提醒：下午來上課請帶水，不要把早晨的涼快當成全天的天氣，室外活動儘量避開午後。"}, "glossary": []}, {"id": "C2B-M37", "title": "The reason for an earlier lesson", "section": "reading", "kind": "text-card", "original": true, "text": {"zh-Hans": "课程群消息\n周二篮球课本来四点开始，现改为上午九点。球场没有比赛，也没有维修。老师说下午太热，希望大家在太阳还不强的时候练习。报名和上课地点都不用改变。", "zh-Hant": "課程羣消息\n週二籃球課本來四點開始，現改爲上午九點。球場沒有比賽，也沒有維修。老師說下午太熱，希望大家在太陽還不強的時候練習。報名和上課地點都不用改變。"}, "glossary": []}, {"id": "C2B-M38", "title": "Rest between two practice periods", "section": "reading", "kind": "text-card", "original": true, "text": {"zh-Hans": "训练安排卡\n教练要求小林每练习二十分钟，至少休息五分钟再继续。\n甲：连续练四十分钟。乙：练二十分钟，休息五分钟，再练二十分钟。丙：练二十分钟，休息一分钟，再继续练。小林要选符合要求的安排。", "zh-Hant": "訓練安排卡\n教練要求小林每練習二十分鐘，至少休息五分鐘再繼續。\n甲：連續練四十分鐘。乙：練二十分鐘，休息五分鐘，再練二十分鐘。丙：練二十分鐘，休息一分鐘，再繼續練。小林要選符合要求的安排。"}, "glossary": []}, {"id": "C2B-M39", "title": "Using a festival activity card", "section": "reading", "kind": "text-card", "original": true, "text": {"zh-Hans": "端午活动须知\n进门先领取活动卡，再到服务桌盖章。拿到盖章的卡才可以换一份手工材料。完成香包后可以在出口拍照。没有盖章不能领材料，请不要直接到出口排队。", "zh-Hant": "端午活動須知\n進門先領取活動卡，再到服務桌蓋章。拿到蓋章的卡纔可以換一份手工材料。完成香包後可以在出口拍照。沒有蓋章不能領材料，請不要直接到出口排隊。"}, "glossary": [{"term": {"zh-Hans": "盖章", "zh-Hant": "蓋章"}, "meaningEn": "stamp"}, {"term": {"zh-Hans": "香包", "zh-Hant": "香包"}, "meaningEn": "sachet"}]}, {"id": "C2B-M40", "title": "From being helped to helping", "section": "reading", "kind": "text-card", "original": true, "text": {"zh-Hans": "小何的端午活动记录\n我第一次来，找不到做香包的教室，工作人员带我过去。活动结束后，我看见新来的同学也在找教室，就陪他走过去，还留在门口给后面的人指路，直到大家都进了教室。", "zh-Hant": "小何的端午活動記錄\n我第一次來，找不到做香包的教室，工作人員帶我過去。活動結束後，我看見新來的同學也在找教室，就陪他走過去，還留在門口給後面的人指路，直到大家都進了教室。"}, "glossary": []}], "questions": [{"id": "course-zh2-b-q01", "blueprintSlotId": "C2-L-01", "number": 1, "section": "listening", "group": "L1", "theme": "daily", "cognitiveTarget": "direct", "designDifficulty": "foundation", "materialId": "C2B-M01", "target": "identify the final household task", "promptEn": "What will the man do next?", "options": {"A": {"zh-Hans": "换猫的水", "zh-Hant": "換貓的水"}, "B": {"zh-Hans": "交备用钥匙", "zh-Hant": "交備用鑰匙"}, "C": {"zh-Hans": "准备猫粮", "zh-Hant": "準備貓糧"}}, "correctAnswer": "B", "evidence": {"materialId": "C2B-M01", "quote": {"zh-Hans": "我去把备用钥匙交给小何", "zh-Hant": "我去把備用鑰匙交給小何"}}, "explanation": {"en": "He will give the spare key to the sitter.", "zh": "男生接下来交备用钥匙。"}, "distractors": {"A": {"en": "He says the water has already been changed.", "zh": "猫的水已经换好，不是下一步。"}, "C": {"en": "The woman is preparing the food.", "zh": "准备猫粮是女生的任务。"}}, "languageTags": ["sequence", "frequency", "completed-action"], "reviewStatus": "author_checked_pending_independent_review"}, {"id": "course-zh2-b-q02", "blueprintSlotId": "C2-L-02", "number": 2, "section": "listening", "group": "L1", "theme": "daily", "cognitiveTarget": "direct", "designDifficulty": "foundation", "materialId": "C2B-M02", "target": "locate activity time", "promptEn": "When does the teacher-led pet-care activity start?", "options": {"A": {"zh-Hans": "下午三点半", "zh-Hant": "下午三點半"}, "B": {"zh-Hans": "下午四点", "zh-Hant": "下午四點"}, "C": {"zh-Hans": "下午五点", "zh-Hant": "下午五點"}}, "correctAnswer": "B", "evidence": {"materialId": "C2B-M02", "quote": {"zh-Hans": "四点老师教我们怎么给小狗梳毛", "zh-Hant": "四點老師教我們怎麼給小狗梳毛"}}, "explanation": {"en": "The teacher begins the pet-care demonstration at four.", "zh": "老师四点开始教宠物照顾。"}, "distractors": {"A": {"en": "Three thirty is the optional photo-viewing time.", "zh": "三点半是提前看照片的时间。"}, "C": {"en": "Five is the question period.", "zh": "五点才进入提问环节。"}}, "languageTags": ["sequence", "frequency", "completed-action"], "reviewStatus": "author_checked_pending_independent_review"}, {"id": "course-zh2-b-q03", "blueprintSlotId": "C2-L-03", "number": 3, "section": "listening", "group": "L1", "theme": "daily", "cognitiveTarget": "direct", "designDifficulty": "standard", "materialId": "C2B-M03", "target": "identify duration or frequency", "promptEn": "How long does the speaker normally take the dog out each time?", "options": {"A": {"zh-Hans": "四十分钟", "zh-Hant": "四十分鐘"}, "B": {"zh-Hans": "两个小时", "zh-Hant": "兩個小時"}, "C": {"zh-Hans": "二十分钟", "zh-Hant": "二十分鐘"}}, "correctAnswer": "C", "evidence": {"materialId": "C2B-M03", "quote": {"zh-Hans": "我每次带小狗出去二十分钟", "zh-Hant": "我每次帶小狗出去二十分鐘"}}, "explanation": {"en": "She states that each normal outing lasts twenty minutes.", "zh": "她明确说平时每次二十分钟。"}, "distractors": {"A": {"en": "Forty minutes is the longer suggestion she does not adopt.", "zh": "四十分钟是她没有采用的建议。"}, "B": {"en": "Two hours is not stated.", "zh": "材料没有说两小时。"}}, "languageTags": ["sequence", "frequency", "completed-action"], "reviewStatus": "author_checked_pending_independent_review"}, {"id": "course-zh2-b-q04", "blueprintSlotId": "C2-L-04", "number": 4, "section": "listening", "group": "L1", "theme": "health", "cognitiveTarget": "integrate", "designDifficulty": "standard", "materialId": "C2B-M04", "target": "combine routine and availability", "promptEn": "Which class can the woman try within her available time?", "options": {"A": {"zh-Hans": "周二游泳课", "zh-Hant": "週二游泳課"}, "B": {"zh-Hans": "周三游泳课", "zh-Hant": "週三游泳課"}, "C": {"zh-Hans": "周三篮球课", "zh-Hant": "週三籃球課"}}, "correctAnswer": "C", "evidence": {"materialId": "C2B-M04", "quote": {"zh-Hans": "游泳课周二晚上开，周三有篮球课", "zh-Hant": "游泳課週二晚上開，週三有籃球課"}}, "explanation": {"en": "Basketball is offered on the only evening she is free.", "zh": "只有周三有空，而周三开篮球课。"}, "distractors": {"A": {"en": "Swimming is on Tuesday, when she is not free.", "zh": "游泳课在她没空的周二。"}, "B": {"en": "No Wednesday swimming class is offered.", "zh": "材料没有周三游泳课。"}}, "languageTags": ["duration", "simple-advice"], "reviewStatus": "author_checked_pending_independent_review"}, {"id": "course-zh2-b-q05", "blueprintSlotId": "C2-L-05", "number": 5, "section": "listening", "group": "L1", "theme": "health", "cognitiveTarget": "infer", "designDifficulty": "stretch", "materialId": "C2B-M05", "target": "infer one supported lifestyle choice", "promptEn": "What does Xiaoding’s preparation suggest he has learned?", "options": {"A": {"zh-Hans": "打球要记得带水", "zh-Hant": "打球要記得帶水"}, "B": {"zh-Hans": "球鞋完全不需要带", "zh-Hant": "球鞋完全不需要帶"}, "C": {"zh-Hans": "打完球也不会口渴", "zh-Hant": "打完球也不會口渴"}}, "correctAnswer": "A", "evidence": {"materialId": "C2B-M05", "quote": {"zh-Hans": "上次打球，小丁忘了带水，打完以后一直说口渴。今天他还没出门，就先往书包里放了一大瓶水", "zh-Hant": "上次打球，小丁忘了帶水，打完以後一直說口渴。今天他還沒出門，就先往書包裏放了一大瓶水"}}, "explanation": {"en": "Remembering water before leaving addresses his previous thirsty experience.", "zh": "提前放水对应上次忘带水又口渴的经历。"}, "distractors": {"B": {"en": "Nearly forgetting shoes does not mean they are unnecessary.", "zh": "差点忘鞋不等于球鞋不需要。"}, "C": {"en": "He explicitly felt thirsty last time.", "zh": "上次明确口渴，不能说不会口渴。"}}, "languageTags": ["duration", "simple-advice"], "reviewStatus": "author_checked_pending_independent_review"}, {"id": "course-zh2-b-q06", "blueprintSlotId": "C2-L-06", "number": 6, "section": "listening", "group": "L2", "theme": "travel", "cognitiveTarget": "direct", "designDifficulty": "foundation", "materialId": "C2B-M06", "target": "locate destination", "promptEn": "At which part of the sports centre will they meet?", "options": {"A": {"zh-Hans": "游泳馆里面", "zh-Hant": "游泳館裏面"}, "B": {"zh-Hans": "中心外的商店", "zh-Hant": "中心外的商店"}, "C": {"zh-Hans": "篮球馆门口", "zh-Hant": "籃球館門口"}}, "correctAnswer": "C", "evidence": {"materialId": "C2B-M06", "quote": {"zh-Hans": "我们在篮球馆门口见", "zh-Hant": "我們在籃球館門口見"}}, "explanation": {"en": "The final meeting point is the basketball hall entrance.", "zh": "最后确认在篮球馆门口见。"}, "distractors": {"A": {"en": "The swimming hall is explicitly rejected.", "zh": "游泳馆被明确否定。"}, "B": {"en": "No outside shop is named as the meeting point.", "zh": "没有约定去外面的商店。"}}, "languageTags": ["direction", "comparison", "sequence"], "reviewStatus": "author_checked_pending_independent_review"}, {"id": "course-zh2-b-q07", "blueprintSlotId": "C2-L-07", "number": 7, "section": "listening", "group": "L2", "theme": "travel", "cognitiveTarget": "direct", "designDifficulty": "foundation", "materialId": "C2B-M07", "target": "identify transport choice", "promptEn": "Which means of transport do they choose?", "options": {"A": {"zh-Hans": "等公交车", "zh-Hant": "等公交車"}, "B": {"zh-Hans": "坐出租车", "zh-Hant": "坐出租車"}, "C": {"zh-Hans": "骑自行车", "zh-Hant": "騎自行車"}}, "correctAnswer": "C", "evidence": {"materialId": "C2B-M07", "quote": {"zh-Hans": "我们骑车去", "zh-Hant": "我們騎車去"}}, "explanation": {"en": "They decide to cycle using their available bicycles.", "zh": "双方决定骑现有的自行车。"}, "distractors": {"A": {"en": "They choose not to wait for the bus.", "zh": "他们没有选择继续等公交车。"}, "B": {"en": "A taxi is not proposed.", "zh": "材料没有提出出租车。"}}, "languageTags": ["direction", "comparison", "sequence"], "reviewStatus": "author_checked_pending_independent_review"}, {"id": "course-zh2-b-q08", "blueprintSlotId": "C2-L-08", "number": 8, "section": "listening", "group": "L2", "theme": "travel", "cognitiveTarget": "direct", "designDifficulty": "standard", "materialId": "C2B-M08", "target": "identify route step", "promptEn": "What is the first step after entering the west gate?", "options": {"A": {"zh-Hans": "向食堂左转", "zh-Hant": "向食堂左轉"}, "B": {"zh-Hans": "穿过小广场", "zh-Hant": "穿過小廣場"}, "C": {"zh-Hans": "去停车场", "zh-Hant": "去停車場"}}, "correctAnswer": "B", "evidence": {"materialId": "C2B-M08", "quote": {"zh-Hans": "先穿过小广场，看到食堂再向左", "zh-Hant": "先穿過小廣場，看到食堂再向左"}}, "explanation": {"en": "Crossing the little square comes before the turn.", "zh": "先穿过广场，之后才在食堂处转弯。"}, "distractors": {"A": {"en": "The left turn comes after crossing the square.", "zh": "左转不是进门第一步。"}, "C": {"en": "The parking area is not on the given route.", "zh": "给出的路线不是去停车场。"}}, "languageTags": ["direction", "comparison", "sequence"], "reviewStatus": "author_checked_pending_independent_review"}, {"id": "course-zh2-b-q09", "blueprintSlotId": "C2-L-09", "number": 9, "section": "listening", "group": "L2", "theme": "travel", "cognitiveTarget": "integrate", "designDifficulty": "standard", "materialId": "C2B-M09", "target": "compare two route constraints", "promptEn": "Which bus fits the man’s arrival and luggage needs?", "options": {"A": {"zh-Hans": "六路车", "zh-Hant": "六路車"}, "B": {"zh-Hans": "十路车", "zh-Hant": "十路車"}, "C": {"zh-Hans": "两路车都来不及", "zh-Hant": "兩路車都來不及"}}, "correctAnswer": "A", "evidence": {"materialId": "C2B-M09", "quote": {"zh-Hans": "六路车两点前到运动中心，不用换车", "zh-Hant": "六路車兩點前到運動中心，不用換車"}}, "explanation": {"en": "Bus six arrives before two and avoids a transfer with his equipment.", "zh": "六路两点前到，又不用带东西换车。"}, "distractors": {"B": {"en": "Bus ten meets the arrival time but requires a transfer.", "zh": "十路时间合适，但要换车。"}, "C": {"en": "Both routes are said to arrive before two.", "zh": "两条线路都能两点前到，不能说都来不及。"}}, "languageTags": ["direction", "comparison", "sequence"], "reviewStatus": "author_checked_pending_independent_review"}, {"id": "course-zh2-b-q10", "blueprintSlotId": "C2-L-10", "number": 10, "section": "listening", "group": "L2", "theme": "weather", "cognitiveTarget": "integrate", "designDifficulty": "standard", "materialId": "C2B-M10", "target": "select the final plan after a stated change", "promptEn": "What is the updated training arrangement?", "options": {"A": {"zh-Hans": "早上八点在学校球场", "zh-Hant": "早上八點在學校球場"}, "B": {"zh-Hans": "下午三点在学校球场", "zh-Hant": "下午三點在學校球場"}, "C": {"zh-Hans": "早上八点在体育馆", "zh-Hant": "早上八點在體育館"}}, "correctAnswer": "A", "evidence": {"materialId": "C2B-M10", "quote": {"zh-Hans": "改到早上八点，地点不变，还是学校球场", "zh-Hant": "改到早上八點，地點不變，還是學校球場"}}, "explanation": {"en": "Training moves to eight in the morning at the same school court.", "zh": "训练改到早上八点，仍在学校球场。"}, "distractors": {"B": {"en": "Three in the afternoon is the replaced time.", "zh": "下午三点是更改前的时间。"}, "C": {"en": "No move to an indoor gym is stated.", "zh": "材料没有改到体育馆。"}}, "languageTags": ["cause", "revised-plan"], "reviewStatus": "author_checked_pending_independent_review"}, {"id": "course-zh2-b-q11", "blueprintSlotId": "C2-L-11", "number": 11, "section": "listening", "group": "L3", "theme": "dining-shopping", "cognitiveTarget": "direct", "designDifficulty": "foundation", "materialId": "C2B-M11", "target": "identify order quantity", "promptEn": "How many cartons of juice will they bring?", "options": {"A": {"zh-Hans": "六盒", "zh-Hant": "六盒"}, "B": {"zh-Hans": "四盒", "zh-Hant": "四盒"}, "C": {"zh-Hans": "两盒", "zh-Hant": "兩盒"}}, "correctAnswer": "B", "evidence": {"materialId": "C2B-M11", "quote": {"zh-Hans": "那我带四盒，面包另外买两袋", "zh-Hant": "那我帶四盒，麪包另外買兩袋"}}, "explanation": {"en": "The confirmed juice quantity is four cartons.", "zh": "最后确认果汁四盒。"}, "distractors": {"A": {"en": "Six was the original number of people.", "zh": "六是原来的人数。"}, "C": {"en": "Two refers to bags of bread.", "zh": "两袋指面包，不是果汁。"}}, "languageTags": ["quantity", "choice", "comparison"], "reviewStatus": "author_checked_pending_independent_review"}, {"id": "course-zh2-b-q12", "blueprintSlotId": "C2-L-12", "number": 12, "section": "listening", "group": "L3", "theme": "dining-shopping", "cognitiveTarget": "direct", "designDifficulty": "foundation", "materialId": "C2B-M12", "target": "identify size or stated preference", "promptEn": "Which mat will suit the woman’s group?", "options": {"A": {"zh-Hans": "两人用的小号", "zh-Hant": "兩人用的小號"}, "B": {"zh-Hans": "只要蓝色小号", "zh-Hant": "只要藍色小號"}, "C": {"zh-Hans": "四人用的大号", "zh-Hant": "四人用的大號"}}, "correctAnswer": "C", "evidence": {"materialId": "C2B-M12", "quote": {"zh-Hans": "我买能坐四个人的大号，蓝色和绿色都可以", "zh-Hant": "我買能坐四個人的大號，藍色和綠色都可以"}}, "explanation": {"en": "The group needs the large mat with room for four.", "zh": "四人小组需要能坐四人的大号。"}, "distractors": {"A": {"en": "The small mat holds only two.", "zh": "小号只能坐两人。"}, "B": {"en": "Colour is flexible; a blue small mat still lacks room.", "zh": "颜色不限，蓝色小号仍然不够坐。"}}, "languageTags": ["quantity", "choice", "comparison"], "reviewStatus": "author_checked_pending_independent_review"}, {"id": "course-zh2-b-q13", "blueprintSlotId": "C2-L-13", "number": 13, "section": "listening", "group": "L3", "theme": "dining-shopping", "cognitiveTarget": "direct", "designDifficulty": "standard", "materialId": "C2B-M13", "target": "identify stated price or total", "promptEn": "How much must the student pay?", "options": {"A": {"zh-Hans": "六块", "zh-Hant": "六塊"}, "B": {"zh-Hans": "四块", "zh-Hant": "四塊"}, "C": {"zh-Hans": "五块", "zh-Hant": "五塊"}}, "correctAnswer": "B", "evidence": {"materialId": "C2B-M13", "quote": {"zh-Hans": "那收你四块", "zh-Hant": "那收你四塊"}}, "explanation": {"en": "The student price is four, and he needs no paper bag.", "zh": "学生价四块，自己带袋子不另付袋费。"}, "distractors": {"A": {"en": "Six is the ordinary original price.", "zh": "六块是普通原价。"}, "C": {"en": "Five would add a bag he does not need.", "zh": "五块多算了不需要的纸袋。"}}, "languageTags": ["quantity", "choice", "comparison"], "reviewStatus": "author_checked_pending_independent_review"}, {"id": "course-zh2-b-q14", "blueprintSlotId": "C2-L-14", "number": 14, "section": "listening", "group": "L3", "theme": "dining-shopping", "cognitiveTarget": "integrate", "designDifficulty": "standard", "materialId": "C2B-M14", "target": "choose an option satisfying two needs", "promptEn": "Which bag meets both practical requirements?", "options": {"A": {"zh-Hans": "丙包", "zh-Hant": "丙包"}, "B": {"zh-Hans": "甲包", "zh-Hant": "甲包"}, "C": {"zh-Hans": "乙包", "zh-Hant": "乙包"}}, "correctAnswer": "A", "evidence": {"materialId": "C2B-M14", "quote": {"zh-Hans": "丙包又轻又能挡雨", "zh-Hant": "丙包又輕又能擋雨"}}, "explanation": {"en": "Bag C is both light and rain-resistant.", "zh": "丙包同时满足轻和挡雨。"}, "distractors": {"B": {"en": "Bag A is light but cannot handle water.", "zh": "甲包虽轻却怕水。"}, "C": {"en": "Bag B is heavy, contrary to the request.", "zh": "乙包很重，不符合轻的要求。"}}, "languageTags": ["quantity", "choice", "comparison"], "reviewStatus": "author_checked_pending_independent_review"}, {"id": "course-zh2-b-q15", "blueprintSlotId": "C2-L-15", "number": 15, "section": "listening", "group": "L3", "theme": "daily", "cognitiveTarget": "integrate", "designDifficulty": "standard", "materialId": "C2B-M15", "target": "combine a household request and availability", "promptEn": "What must the man do before going to play ball?", "options": {"A": {"zh-Hans": "把钥匙交给王阿姨", "zh-Hant": "把鑰匙交給王阿姨"}, "B": {"zh-Hans": "带着钥匙等到七点", "zh-Hant": "帶着鑰匙等到七點"}, "C": {"zh-Hans": "自己六点回家喂猫", "zh-Hant": "自己六點回家喂貓"}}, "correctAnswer": "A", "evidence": {"materialId": "C2B-M15", "quote": {"zh-Hans": "你先把钥匙给楼下王阿姨，小何来了找她拿", "zh-Hant": "你先把鑰匙給樓下王阿姨，小何來了找她拿"}}, "explanation": {"en": "Leaving the key with Aunt Wang lets the sitter enter before he returns.", "zh": "先交王阿姨，照顾者才能在他回来前取钥匙。"}, "distractors": {"B": {"en": "Keeping the key until seven blocks the six-o’clock visit.", "zh": "留到七点不符合六点来照顾猫的安排。"}, "C": {"en": "He says he cannot return until seven.", "zh": "他明确七点才回家，不能六点自己回去。"}}, "languageTags": ["sequence", "frequency", "completed-action"], "reviewStatus": "author_checked_pending_independent_review"}, {"id": "course-zh2-b-q16", "blueprintSlotId": "C2-L-16", "number": 16, "section": "listening", "group": "L4", "theme": "weather", "cognitiveTarget": "direct", "designDifficulty": "foundation", "materialId": "C2B-M16", "target": "identify a weather change", "promptEn": "How will the afternoon compare with the morning?", "options": {"A": {"zh-Hans": "更凉快", "zh-Hant": "更涼快"}, "B": {"zh-Hans": "一直有大风", "zh-Hant": "一直有大風"}, "C": {"zh-Hans": "热得多", "zh-Hant": "熱得多"}}, "correctAnswer": "C", "evidence": {"materialId": "C2B-M16", "quote": {"zh-Hans": "下午会升到三十五度，也没有风", "zh-Hant": "下午會升到三十五度，也沒有風"}}, "explanation": {"en": "The temperature rises from twenty-four to thirty-five.", "zh": "气温从二十四度升到三十五度，明显更热。"}, "distractors": {"A": {"en": "Cooling is expected in the evening.", "zh": "变凉是傍晚的情况。"}, "B": {"en": "The afternoon is described as having no wind.", "zh": "下午明确没有风，不是大风。"}}, "languageTags": ["cause", "revised-plan"], "reviewStatus": "author_checked_pending_independent_review"}, {"id": "course-zh2-b-q17", "blueprintSlotId": "C2-L-17", "number": 17, "section": "listening", "group": "L4", "theme": "weather", "cognitiveTarget": "direct", "designDifficulty": "foundation", "materialId": "C2B-M17", "target": "identify an explicit activity reason", "promptEn": "Why has the match been moved to the evening?", "options": {"A": {"zh-Hans": "下午没有场地", "zh-Hant": "下午沒有場地"}, "B": {"zh-Hans": "下午太热", "zh-Hant": "下午太熱"}, "C": {"zh-Hans": "晚上门票更便宜", "zh-Hant": "晚上門票更便宜"}}, "correctAnswer": "B", "evidence": {"materialId": "C2B-M17", "quote": {"zh-Hans": "是下午太阳太强，大家怕热", "zh-Hant": "是下午太陽太強，大家怕熱"}}, "explanation": {"en": "Strong afternoon sun and heat cause the change.", "zh": "改时间是因为下午太阳强、大家怕热。"}, "distractors": {"A": {"en": "The court is available throughout the day.", "zh": "场地一直能用，不是没场地。"}, "C": {"en": "No ticket-price reason is given.", "zh": "没有提到门票价格。"}}, "languageTags": ["cause", "revised-plan"], "reviewStatus": "author_checked_pending_independent_review"}, {"id": "course-zh2-b-q18", "blueprintSlotId": "C2-L-18", "number": 18, "section": "listening", "group": "L4", "theme": "health", "cognitiveTarget": "direct", "designDifficulty": "standard", "materialId": "C2B-M18", "target": "combine activity and health constraint", "promptEn": "Which activity fits both of the stated limits?", "options": {"A": {"zh-Hans": "半小时跑步课", "zh-Hant": "半小時跑步課"}, "B": {"zh-Hans": "五十分钟投篮课", "zh-Hant": "五十分鐘投籃課"}, "C": {"zh-Hans": "九十分钟游泳课", "zh-Hant": "九十分鐘游泳課"}}, "correctAnswer": "B", "evidence": {"materialId": "C2B-M18", "quote": {"zh-Hans": "每次别超过一个小时，也先别跑步", "zh-Hant": "每次別超過一個小時，也先別跑步"}}, "explanation": {"en": "The fifty-minute shooting class is under an hour and involves no running class.", "zh": "投篮课少于一小时，也不是跑步课。"}, "distractors": {"A": {"en": "The running class is short enough but violates the no-running condition.", "zh": "跑步课时间短，但不符合先别跑步。"}, "C": {"en": "Ninety minutes is longer than an hour.", "zh": "九十分钟超过一小时。"}}, "languageTags": ["duration", "simple-advice"], "reviewStatus": "author_checked_pending_independent_review"}, {"id": "course-zh2-b-q19", "blueprintSlotId": "C2-L-19", "number": 19, "section": "listening", "group": "L4", "theme": "festival", "cognitiveTarget": "integrate", "designDifficulty": "standard", "materialId": "C2B-M19", "target": "order two stated event steps", "promptEn": "What did the group do directly after watching the boats?", "options": {"A": {"zh-Hans": "听老师讲故事", "zh-Hant": "聽老師講故事"}, "B": {"zh-Hans": "学做香包", "zh-Hant": "學做香包"}, "C": {"zh-Hans": "送礼物给弟弟", "zh-Hant": "送禮物給弟弟"}}, "correctAnswer": "A", "evidence": {"materialId": "C2B-M19", "quote": {"zh-Hans": "回来以后听老师讲活动的故事。听完故事，大家才到教室学做香包", "zh-Hant": "回來以後聽老師講活動的故事。聽完故事，大家纔到教室學做香包"}}, "explanation": {"en": "They listen to the teacher before the craft session.", "zh": "看船回来先听故事，之后才做手工。"}, "distractors": {"B": {"en": "Making sachets follows the story.", "zh": "做香包在听完故事之后。"}, "C": {"en": "Giving the gift is later, after it has been made.", "zh": "送礼发生在做好香包之后。"}}, "languageTags": ["experience", "sequence", "feeling"], "reviewStatus": "author_checked_pending_independent_review"}, {"id": "course-zh2-b-q20", "blueprintSlotId": "C2-L-20", "number": 20, "section": "listening", "group": "L4", "theme": "festival", "cognitiveTarget": "infer", "designDifficulty": "stretch", "materialId": "C2B-M20", "target": "infer a feeling from stated evidence", "promptEn": "What can we infer about Xiaofang by the end?", "options": {"A": {"zh-Hans": "她仍然完全不会做", "zh-Hant": "她仍然完全不會做"}, "B": {"zh-Hans": "她只想让老师代做", "zh-Hant": "她只想讓老師代做"}, "C": {"zh-Hans": "她对自己更有信心了", "zh-Hant": "她對自己更有信心了"}}, "correctAnswer": "C", "evidence": {"materialId": "C2B-M20", "quote": {"zh-Hans": "她已经自己做好第二个，又开始教旁边的小朋友了", "zh-Hant": "她已經自己做好第二個，又開始教旁邊的小朋友了"}}, "explanation": {"en": "Working independently and teaching another child suggest greater confidence.", "zh": "自己做第二个还教别人，支持更有信心。"}, "distractors": {"A": {"en": "She has already completed one independently.", "zh": "她已经自己做好，不能说完全不会。"}, "B": {"en": "She begins before the teacher approaches again.", "zh": "老师还没过来，她已独立开始。"}}, "languageTags": ["experience", "sequence", "feeling"], "reviewStatus": "author_checked_pending_independent_review"}, {"id": "course-zh2-b-q21", "blueprintSlotId": "C2-R-01", "number": 21, "section": "reading", "group": "R1", "theme": "daily", "cognitiveTarget": "direct", "designDifficulty": "foundation", "materialId": "C2B-M21", "target": "identify the final household task", "promptEn": "What should Xiaoning do after school?", "options": {"A": {"zh-Hans": "重新打扫兔笼", "zh-Hant": "重新打掃兔籠"}, "B": {"zh-Hans": "给水瓶装水", "zh-Hant": "給水瓶裝水"}, "C": {"zh-Hans": "去买饲料", "zh-Hant": "去買飼料"}}, "correctAnswer": "B", "evidence": {"materialId": "C2B-M21", "quote": {"zh-Hans": "请你先把空水瓶装满", "zh-Hant": "請你先把空水瓶裝滿"}}, "explanation": {"en": "The new request is to fill the empty water bottle.", "zh": "新的要求是把空水瓶装满。"}, "distractors": {"A": {"en": "The cage was cleaned that morning.", "zh": "兔笼早上已经清理。"}, "C": {"en": "The note explicitly says not to buy extra feed.", "zh": "留言明确不用另买饲料。"}}, "languageTags": ["sequence", "frequency", "completed-action"], "reviewStatus": "author_checked_pending_independent_review"}, {"id": "course-zh2-b-q22", "blueprintSlotId": "C2-R-02", "number": 22, "section": "reading", "group": "R1", "theme": "daily", "cognitiveTarget": "direct", "designDifficulty": "foundation", "materialId": "C2B-M22", "target": "locate activity time", "promptEn": "When does the explanatory talk begin?", "options": {"A": {"zh-Hans": "下午三点四十", "zh-Hant": "下午三點四十"}, "B": {"zh-Hans": "下午四点半", "zh-Hant": "下午四點半"}, "C": {"zh-Hans": "下午四点", "zh-Hant": "下午四點"}}, "correctAnswer": "C", "evidence": {"materialId": "C2B-M22", "quote": {"zh-Hans": "四点开始讲解", "zh-Hant": "四點開始講解"}}, "explanation": {"en": "The talk starts at four.", "zh": "讲解四点开始。"}, "distractors": {"A": {"en": "Three forty is the arrival deadline for newcomers.", "zh": "三点四十是新同学到场期限。"}, "B": {"en": "Four thirty begins the practical exercise.", "zh": "四点半开始练习。"}}, "languageTags": ["sequence", "frequency", "completed-action"], "reviewStatus": "author_checked_pending_independent_review"}, {"id": "course-zh2-b-q23", "blueprintSlotId": "C2-R-03", "number": 23, "section": "reading", "group": "R1", "theme": "daily", "cognitiveTarget": "direct", "designDifficulty": "standard", "materialId": "C2B-M23", "target": "identify duration or frequency", "promptEn": "How long is each outing with the dog?", "options": {"A": {"zh-Hans": "三十分钟", "zh-Hant": "三十分鐘"}, "B": {"zh-Hans": "一小时", "zh-Hant": "一小時"}, "C": {"zh-Hans": "十五分钟", "zh-Hant": "十五分鐘"}}, "correctAnswer": "C", "evidence": {"materialId": "C2B-M23", "quote": {"zh-Hans": "每次时间仍然一样", "zh-Hant": "每次時間仍然一樣"}}, "explanation": {"en": "Every outing is fifteen minutes, including the later school day and weekend.", "zh": "每次都是十五分钟，晚放学和周末也不变。"}, "distractors": {"A": {"en": "Thirty minutes is not the stated duration.", "zh": "约定没有说三十分钟。"}, "B": {"en": "An hour is not the stated duration.", "zh": "材料没有说一小时。"}}, "languageTags": ["sequence", "frequency", "completed-action"], "reviewStatus": "author_checked_pending_independent_review"}, {"id": "course-zh2-b-q24", "blueprintSlotId": "C2-R-04", "number": 24, "section": "reading", "group": "R1", "theme": "health", "cognitiveTarget": "integrate", "designDifficulty": "standard", "materialId": "C2B-M24", "target": "combine routine and availability", "promptEn": "Which class matches Xiao’an’s day and learning goal?", "options": {"A": {"zh-Hans": "周二篮球课", "zh-Hant": "週二籃球課"}, "B": {"zh-Hans": "周一绘画课", "zh-Hant": "週一繪畫課"}, "C": {"zh-Hans": "周一羽毛球课", "zh-Hant": "週一羽毛球課"}}, "correctAnswer": "C", "evidence": {"materialId": "C2B-M24", "quote": {"zh-Hans": "周一有羽毛球课、周二有篮球课", "zh-Hant": "週一有羽毛球課、週二有籃球課"}}, "explanation": {"en": "Badminton is a ball-related sport available on the free day.", "zh": "羽毛球课既在周一，又符合球类运动目标。"}, "distractors": {"A": {"en": "Tuesday is outside the stated available day.", "zh": "周二不是她有空的日期。"}, "B": {"en": "Drawing fits the day but not the sports goal.", "zh": "绘画日期合适，但不是想学的球类运动。"}}, "languageTags": ["duration", "simple-advice"], "reviewStatus": "author_checked_pending_independent_review"}, {"id": "course-zh2-b-q25", "blueprintSlotId": "C2-R-05", "number": 25, "section": "reading", "group": "R1", "theme": "health", "cognitiveTarget": "infer", "designDifficulty": "stretch", "materialId": "C2B-M25", "target": "infer one supported lifestyle choice", "promptEn": "Which preparation is supported by Xiaoning’s record?", "options": {"A": {"zh-Hans": "带水并留一点休息时间", "zh-Hant": "帶水並留一點休息時間"}, "B": {"zh-Hans": "结束后马上跑回家", "zh-Hant": "結束後馬上跑回家"}, "C": {"zh-Hans": "把水留在家里", "zh-Hant": "把水留在家裏"}}, "correctAnswer": "A", "evidence": {"materialId": "C2B-M25", "quote": {"zh-Hans": "教练提醒他带水，并在结束后坐一会儿。他照着做了", "zh-Hant": "教練提醒他帶水，並在結束後坐一會兒。他照着做了"}}, "explanation": {"en": "Preparing water and allowing a rest are the changes linked to his better reported experience.", "zh": "带水和留休息时间对应他感觉轻松的那次经历。"}, "distractors": {"B": {"en": "Rushing home is the earlier routine, not the change he will continue.", "zh": "急着回家是以前的做法。"}, "C": {"en": "Leaving water at home contradicts the preparation described.", "zh": "把水留家里与提前带水不符。"}}, "languageTags": ["duration", "simple-advice"], "reviewStatus": "author_checked_pending_independent_review"}, {"id": "course-zh2-b-q26", "blueprintSlotId": "C2-R-06", "number": 26, "section": "reading", "group": "R2", "theme": "travel", "cognitiveTarget": "direct", "designDifficulty": "foundation", "materialId": "C2B-M26", "target": "locate destination", "promptEn": "Where should the group meet?", "options": {"A": {"zh-Hans": "网球场", "zh-Hant": "網球場"}, "B": {"zh-Hans": "游泳馆", "zh-Hant": "游泳館"}, "C": {"zh-Hans": "售票处", "zh-Hant": "售票處"}}, "correctAnswer": "A", "evidence": {"materialId": "C2B-M26", "quote": {"zh-Hans": "大家直接在那里集合", "zh-Hant": "大家直接在那裏集合"}}, "explanation": {"en": "The preceding sentence identifies the tennis court as the class venue and direct meeting point.", "zh": "前句指定网球场，要求直接在那里集合。"}, "distractors": {"B": {"en": "The swimming hall is restricted to a school group.", "zh": "游泳馆今天只对学校开放。"}, "C": {"en": "The notice says not to wait at the ticket office first.", "zh": "消息明确不用先去售票处等。"}}, "languageTags": ["direction", "comparison", "sequence"], "reviewStatus": "author_checked_pending_independent_review"}, {"id": "course-zh2-b-q27", "blueprintSlotId": "C2-R-07", "number": 27, "section": "reading", "group": "R2", "theme": "travel", "cognitiveTarget": "direct", "designDifficulty": "foundation", "materialId": "C2B-M27", "target": "identify transport choice", "promptEn": "How is the group asked to travel?", "options": {"A": {"zh-Hans": "各自骑车", "zh-Hant": "各自騎車"}, "B": {"zh-Hans": "各自提前坐地铁", "zh-Hant": "各自提前坐地鐵"}, "C": {"zh-Hans": "乘教练的小巴", "zh-Hant": "乘教練的小巴"}}, "correctAnswer": "C", "evidence": {"materialId": "C2B-M27", "quote": {"zh-Hans": "教练会用小巴接大家到运动中心", "zh-Hant": "教練會用小巴接大家到運動中心"}}, "explanation": {"en": "The group is to travel together in the coach’s minibus.", "zh": "小组按约定一起坐教练的小巴。"}, "distractors": {"A": {"en": "They are told not to cycle individually.", "zh": "约定明确不用自己骑车。"}, "B": {"en": "Going ahead alone is discouraged, and no subway arrangement is given.", "zh": "约定请大家不要独自先去，也没有地铁安排。"}}, "languageTags": ["direction", "comparison", "sequence"], "reviewStatus": "author_checked_pending_independent_review"}, {"id": "course-zh2-b-q28", "blueprintSlotId": "C2-R-08", "number": 28, "section": "reading", "group": "R2", "theme": "travel", "cognitiveTarget": "direct", "designDifficulty": "standard", "materialId": "C2B-M28", "target": "identify route step", "promptEn": "What should visitors pass first after entering?", "options": {"A": {"zh-Hans": "二楼练习馆", "zh-Hant": "二樓練習館"}, "B": {"zh-Hans": "小花园", "zh-Hant": "小花園"}, "C": {"zh-Hans": "楼梯右侧", "zh-Hant": "樓梯右側"}}, "correctAnswer": "B", "evidence": {"materialId": "C2B-M28", "quote": {"zh-Hans": "由北门进入后，先经过小花园", "zh-Hant": "由北門進入後，先經過小花園"}}, "explanation": {"en": "The small garden is the first feature on the route.", "zh": "进北门后先经过小花园。"}, "distractors": {"A": {"en": "The hall is upstairs after collecting a card.", "zh": "先领卡上楼后才到练习馆。"}, "C": {"en": "The right side of the stairs locates the hall, not the first step.", "zh": "楼梯右边说明馆的位置，不是入门第一步。"}}, "languageTags": ["direction", "comparison", "sequence"], "reviewStatus": "author_checked_pending_independent_review"}, {"id": "course-zh2-b-q29", "blueprintSlotId": "C2-R-09", "number": 29, "section": "reading", "group": "R2", "theme": "travel", "cognitiveTarget": "integrate", "designDifficulty": "standard", "materialId": "C2B-M29", "target": "compare two route constraints", "promptEn": "Which entrance lets Xiaohe enter before the stated deadline?", "options": {"A": {"zh-Hans": "西门", "zh-Hant": "西門"}, "B": {"zh-Hans": "东门", "zh-Hant": "東門"}, "C": {"zh-Hans": "两个门都来不及", "zh-Hant": "兩個門都來不及"}}, "correctAnswer": "B", "evidence": {"materialId": "C2B-M29", "quote": {"zh-Hans": "东门九点开放，从车站步行十五分钟", "zh-Hant": "東門九點開放，從車站步行十五分鐘"}}, "explanation": {"en": "The east gate is open when he reaches it at nine fifteen, before nine thirty.", "zh": "东门九点已开，九点十五分可到，早于九点半。"}, "distractors": {"A": {"en": "The nearer west gate stays closed until ten.", "zh": "西门虽近，却到十点才开。"}, "C": {"en": "The east gate provides a timely route.", "zh": "东门能及时进入，不能说两个门都来不及。"}}, "languageTags": ["direction", "comparison", "sequence"], "reviewStatus": "author_checked_pending_independent_review"}, {"id": "course-zh2-b-q30", "blueprintSlotId": "C2-R-10", "number": 30, "section": "reading", "group": "R2", "theme": "weather", "cognitiveTarget": "integrate", "designDifficulty": "standard", "materialId": "C2B-M30", "target": "select the final plan after a stated change", "promptEn": "What will the group now do at two in the afternoon?", "options": {"A": {"zh-Hans": "在室外参观球场", "zh-Hant": "在室外參觀球場"}, "B": {"zh-Hans": "在一楼展厅看照片展", "zh-Hant": "在一樓展廳看照片展"}, "C": {"zh-Hans": "在游泳馆集合", "zh-Hant": "在游泳館集合"}}, "correctAnswer": "B", "evidence": {"materialId": "C2B-M30", "quote": {"zh-Hans": "改看一楼展厅里的运动照片展。开始时间仍是下午两点", "zh-Hant": "改看一樓展廳裏的運動照片展。開始時間仍是下午兩點"}}, "explanation": {"en": "The replacement is the indoor sports-photo exhibition, at the unchanged time.", "zh": "新安排是室内看运动照片展，时间不变。"}, "distractors": {"A": {"en": "The outdoor court tour is cancelled.", "zh": "室外参观球场已取消。"}, "C": {"en": "The update explicitly says not to gather at the pool.", "zh": "通知明确不用在游泳馆集合。"}}, "languageTags": ["cause", "revised-plan"], "reviewStatus": "author_checked_pending_independent_review"}, {"id": "course-zh2-b-q31", "blueprintSlotId": "C2-R-11", "number": 31, "section": "reading", "group": "R3", "theme": "dining-shopping", "cognitiveTarget": "direct", "designDifficulty": "foundation", "materialId": "C2B-M31", "target": "identify order quantity", "promptEn": "How many cartons of juice are listed?", "options": {"A": {"zh-Hans": "两盒", "zh-Hant": "兩盒"}, "B": {"zh-Hans": "三盒", "zh-Hant": "三盒"}, "C": {"zh-Hans": "五盒", "zh-Hant": "五盒"}}, "correctAnswer": "C", "evidence": {"materialId": "C2B-M31", "quote": {"zh-Hans": "果汁五盒，牛奶两盒，面包三袋", "zh-Hant": "果汁五盒，牛奶兩盒，麪包三袋"}}, "explanation": {"en": "The list contains five cartons of juice.", "zh": "装箱单果汁五盒。"}, "distractors": {"A": {"en": "Two cartons refer to milk.", "zh": "两盒指牛奶。"}, "B": {"en": "Three refers to bags of bread.", "zh": "三袋指面包。"}}, "languageTags": ["quantity", "choice", "comparison"], "reviewStatus": "author_checked_pending_independent_review"}, {"id": "course-zh2-b-q32", "blueprintSlotId": "C2-R-12", "number": 32, "section": "reading", "group": "R3", "theme": "dining-shopping", "cognitiveTarget": "direct", "designDifficulty": "foundation", "materialId": "C2B-M32", "target": "identify size or stated preference", "promptEn": "Which size should the group choose?", "options": {"A": {"zh-Hans": "两人坐的小号", "zh-Hant": "兩人坐的小號"}, "B": {"zh-Hans": "四人坐的大号", "zh-Hant": "四人坐的大號"}, "C": {"zh-Hans": "两张小号", "zh-Hant": "兩張小號"}}, "correctAnswer": "B", "evidence": {"materialId": "C2B-M32", "quote": {"zh-Hans": "大号垫：四个人坐，需要单独拿", "zh-Hant": "大號墊：四個人坐，需要單獨拿"}}, "explanation": {"en": "One large mat provides space for all four within the one-mat limit.", "zh": "一张大号容纳四人，符合只买一张的限制。"}, "distractors": {"A": {"en": "A small mat leaves two people without space.", "zh": "小号只有两人位置。"}, "C": {"en": "The budget covers one mat, not two.", "zh": "预算只有一张，不能买两张。"}}, "languageTags": ["quantity", "choice", "comparison"], "reviewStatus": "author_checked_pending_independent_review"}, {"id": "course-zh2-b-q33", "blueprintSlotId": "C2-R-13", "number": 33, "section": "reading", "group": "R3", "theme": "dining-shopping", "cognitiveTarget": "direct", "designDifficulty": "standard", "materialId": "C2B-M33", "target": "identify stated price or total", "promptEn": "Which amount is the non-refundable one-day usage fee?", "options": {"A": {"zh-Hans": "十元", "zh-Hant": "十元"}, "B": {"zh-Hans": "二十元", "zh-Hant": "二十元"}, "C": {"zh-Hans": "三十元", "zh-Hant": "三十元"}}, "correctAnswer": "A", "evidence": {"materialId": "C2B-M33", "quote": {"zh-Hans": "十元使用费不退", "zh-Hant": "十元使用費不退"}}, "explanation": {"en": "Ten yuan is explicitly the usage fee that is not returned.", "zh": "十元明确是不会退的使用费。"}, "distractors": {"B": {"en": "Twenty yuan is the refundable deposit, not the usage fee.", "zh": "二十元是会退的押金，不是使用费。"}, "C": {"en": "Thirty yuan combines the fee and deposit paid initially.", "zh": "三十元是最初一起交的使用费与押金。"}}, "languageTags": ["quantity", "choice", "comparison"], "reviewStatus": "author_checked_pending_independent_review"}, {"id": "course-zh2-b-q34", "blueprintSlotId": "C2-R-14", "number": 34, "section": "reading", "group": "R3", "theme": "dining-shopping", "cognitiveTarget": "integrate", "designDifficulty": "standard", "materialId": "C2B-M34", "target": "choose an option satisfying two needs", "promptEn": "Which package fits the facilities described in the note?", "options": {"A": {"zh-Hans": "甲套餐", "zh-Hant": "甲套餐"}, "B": {"zh-Hans": "丙套餐", "zh-Hant": "丙套餐"}, "C": {"zh-Hans": "乙套餐", "zh-Hant": "乙套餐"}}, "correctAnswer": "C", "evidence": {"materialId": "C2B-M34", "quote": {"zh-Hans": "乙套餐是面包和洗好的苹果，不用加热也不用冷藏", "zh-Hant": "乙套餐是麪包和洗好的蘋果，不用加熱也不用冷藏"}}, "explanation": {"en": "Package B needs neither heating nor refrigeration, which the park lacks.", "zh": "乙不用加热冷藏，符合公园设施条件。"}, "distractors": {"A": {"en": "Package A requires heating equipment.", "zh": "甲需要公园没有的加热条件。"}, "B": {"en": "Package C requires continuous refrigeration.", "zh": "丙需要一直冷藏。"}}, "languageTags": ["quantity", "choice", "comparison"], "reviewStatus": "author_checked_pending_independent_review"}, {"id": "course-zh2-b-q35", "blueprintSlotId": "C2-R-15", "number": 35, "section": "reading", "group": "R3", "theme": "daily", "cognitiveTarget": "integrate", "designDifficulty": "standard", "materialId": "C2B-M35", "target": "combine a household request and availability", "promptEn": "What has Xiao’an agreed to do immediately after class?", "options": {"A": {"zh-Hans": "接小狗回家", "zh-Hant": "接小狗回家"}, "B": {"zh-Hans": "等哥哥六点回来", "zh-Hant": "等哥哥六點回來"}, "C": {"zh-Hans": "先回家等妈妈", "zh-Hant": "先回家等媽媽"}}, "correctAnswer": "A", "evidence": {"materialId": "C2B-M35", "quote": {"zh-Hans": "小安答应放学直接去接", "zh-Hant": "小安答應放學直接去接"}}, "explanation": {"en": "Xiao’an accepts the pickup before the five-o’clock deadline.", "zh": "小安答应在五点期限前直接接狗。"}, "distractors": {"B": {"en": "Waiting for the brother misses the deadline.", "zh": "等哥哥六点回来会错过期限。"}, "C": {"en": "The mother says she cannot handle the pickup in time.", "zh": "妈妈说自己赶不上，不能先等她处理。"}}, "languageTags": ["sequence", "frequency", "completed-action"], "reviewStatus": "author_checked_pending_independent_review"}, {"id": "course-zh2-b-q36", "blueprintSlotId": "C2-R-16", "number": 36, "section": "reading", "group": "R4", "theme": "weather", "cognitiveTarget": "direct", "designDifficulty": "foundation", "materialId": "C2B-M36", "target": "identify a weather change", "promptEn": "How is the afternoon expected to compare with early morning?", "options": {"A": {"zh-Hans": "更热，而且没有风", "zh-Hant": "更熱，而且沒有風"}, "B": {"zh-Hans": "更凉快，风更大", "zh-Hant": "更涼快，風更大"}, "C": {"zh-Hans": "温度完全一样", "zh-Hant": "溫度完全一樣"}}, "correctAnswer": "A", "evidence": {"materialId": "C2B-M36", "quote": {"zh-Hans": "下午三十六度，无风", "zh-Hant": "下午三十六度，無風"}}, "explanation": {"en": "The afternoon is hotter than the twenty-three-degree morning and has no wind.", "zh": "下午三十六度，比早晨热，又无风。"}, "distractors": {"B": {"en": "Neither cooling nor stronger wind is forecast for the afternoon.", "zh": "下午没有变凉或风更大。"}, "C": {"en": "The two temperatures differ.", "zh": "早晚两段温度并不相同。"}}, "languageTags": ["cause", "revised-plan"], "reviewStatus": "author_checked_pending_independent_review"}, {"id": "course-zh2-b-q37", "blueprintSlotId": "C2-R-17", "number": 37, "section": "reading", "group": "R4", "theme": "weather", "cognitiveTarget": "direct", "designDifficulty": "foundation", "materialId": "C2B-M37", "target": "identify an explicit activity reason", "promptEn": "Why is the lesson now in the morning?", "options": {"A": {"zh-Hans": "球场下午有比赛", "zh-Hant": "球場下午有比賽"}, "B": {"zh-Hans": "球场需要维修", "zh-Hant": "球場需要維修"}, "C": {"zh-Hans": "避开下午的高温", "zh-Hant": "避開下午的高溫"}}, "correctAnswer": "C", "evidence": {"materialId": "C2B-M37", "quote": {"zh-Hans": "老师说下午太热，希望大家在太阳还不强的时候练习", "zh-Hant": "老師說下午太熱，希望大家在太陽還不強的時候練習"}}, "explanation": {"en": "The change avoids the afternoon heat.", "zh": "改时间是为了避开下午高温。"}, "distractors": {"A": {"en": "The message explicitly rules out a match.", "zh": "群消息明确说没有比赛。"}, "B": {"en": "The message explicitly rules out repairs.", "zh": "群消息明确说没有维修。"}}, "languageTags": ["cause", "revised-plan"], "reviewStatus": "author_checked_pending_independent_review"}, {"id": "course-zh2-b-q38", "blueprintSlotId": "C2-R-18", "number": 38, "section": "reading", "group": "R4", "theme": "health", "cognitiveTarget": "direct", "designDifficulty": "standard", "materialId": "C2B-M38", "target": "combine activity and health constraint", "promptEn": "Which plan follows the coach’s practice-and-rest requirement?", "options": {"A": {"zh-Hans": "甲", "zh-Hant": "甲"}, "B": {"zh-Hans": "乙", "zh-Hant": "乙"}, "C": {"zh-Hans": "丙", "zh-Hant": "丙"}}, "correctAnswer": "B", "evidence": {"materialId": "C2B-M38", "quote": {"zh-Hans": "乙：练二十分钟，休息五分钟，再练二十分钟", "zh-Hant": "乙：練二十分鐘，休息五分鐘，再練二十分鐘"}}, "explanation": {"en": "Plan B includes the required rest after twenty minutes and before continuing.", "zh": "乙在二十分钟练习后休息五分钟，再继续。"}, "distractors": {"A": {"en": "Plan A has no break between the two twenty-minute periods.", "zh": "甲连续四十分钟，中间没有规定休息。"}, "C": {"en": "Plan C rests for only one minute instead of at least five.", "zh": "丙只休息一分钟，不够至少五分钟。"}}, "languageTags": ["duration", "simple-advice"], "reviewStatus": "author_checked_pending_independent_review"}, {"id": "course-zh2-b-q39", "blueprintSlotId": "C2-R-19", "number": 39, "section": "reading", "group": "R4", "theme": "festival", "cognitiveTarget": "integrate", "designDifficulty": "standard", "materialId": "C2B-M39", "target": "order two stated event steps", "promptEn": "What must visitors do just after collecting the activity card?", "options": {"A": {"zh-Hans": "直接领取手工材料", "zh-Hant": "直接領取手工材料"}, "B": {"zh-Hans": "到服务桌盖章", "zh-Hant": "到服務桌蓋章"}, "C": {"zh-Hans": "去出口拍照", "zh-Hant": "去出口拍照"}}, "correctAnswer": "B", "evidence": {"materialId": "C2B-M39", "quote": {"zh-Hans": "进门先领取活动卡，再到服务桌盖章", "zh-Hant": "進門先領取活動卡，再到服務桌蓋章"}}, "explanation": {"en": "The next required step is getting the card stamped.", "zh": "领卡后下一步是到服务桌盖章。"}, "distractors": {"A": {"en": "Materials require a stamp first.", "zh": "先盖章才能换材料。"}, "C": {"en": "Photos come after finishing the craft.", "zh": "做好手工后才到出口拍照。"}}, "languageTags": ["experience", "sequence", "feeling"], "reviewStatus": "author_checked_pending_independent_review"}, {"id": "course-zh2-b-q40", "blueprintSlotId": "C2-R-20", "number": 40, "section": "reading", "group": "R4", "theme": "festival", "cognitiveTarget": "infer", "designDifficulty": "stretch", "materialId": "C2B-M40", "target": "infer a feeling from stated evidence", "promptEn": "What does Xiaohe’s later behaviour suggest?", "options": {"A": {"zh-Hans": "他愿意帮助不熟悉活动的人", "zh-Hant": "他願意幫助不熟悉活動的人"}, "B": {"zh-Hans": "他只想早点独自离开", "zh-Hant": "他只想早點獨自離開"}, "C": {"zh-Hans": "他一直没有找到教室", "zh-Hant": "他一直沒有找到教室"}}, "correctAnswer": "A", "evidence": {"materialId": "C2B-M40", "quote": {"zh-Hans": "还留在门口给后面的人指路，直到大家都进了教室", "zh-Hant": "還留在門口給後面的人指路，直到大家都進了教室"}}, "explanation": {"en": "Guiding newcomers after being helped suggests willingness to help others.", "zh": "被帮助后留下引路，支持愿意帮助新人的推断。"}, "distractors": {"B": {"en": "Staying to guide people contradicts wanting only to leave early alone.", "zh": "留下帮忙与只想独自早走不符。"}, "C": {"en": "He reaches the room and later guides others to it.", "zh": "他已经到过教室，还带别人过去。"}}, "languageTags": ["experience", "sequence", "feeling"], "reviewStatus": "author_checked_pending_independent_review"}], "tasks": [{"id": "W1", "section": "writing", "type": "message-reply", "title": "Reply to a sports schedule conflict", "promptEn": "Reply to Xiaoyu in Chinese. Answer whether you can attend the new badminton session on Tuesday at five and say whether you can bring a racket. Give one reason connected to your availability or equipment. Suggest a workable alternative or ask a relevant question. Invent details if needed. About 40-60 Chinese characters is a guide, not a minimum.", "stimulus": {"zh-Hans": "小何：周三的羽毛球课取消了，小组想改到周二下午五点。你能参加吗？你能带球拍来吗？如果不方便，我们再想别的办法。\n小雨", "zh-Hant": "小何：週三的羽毛球課取消了，小組想改到週二下午五點。你能參加嗎？你能帶球拍來嗎？如果不方便，我們再想別的辦法。\n小雨"}, "requirements": ["Answer whether Tuesday at five works for you.", "Say whether you can bring a racket.", "Give a reason related to availability or equipment.", "Suggest a feasible alternative or ask a relevant question."], "reference": {"zh-Hans": "小雨，周二五点我有课，不能来。我有球拍，周四可以带。我们改到周四五点好吗？那天小组其他同学有空吗？", "zh-Hant": "小雨，週二五點我有課，不能來。我有球拍，週四可以帶。我們改到週四五點好嗎？那天小組其他同學有空嗎？"}, "alternateReference": {"zh-Hans": "小雨，我周二五点能来，也能带球拍，因为哥哥把他的借给我了。我们在运动中心哪个门见？我想提前十分钟到。", "zh-Hant": "小雨，我週二五點能來，也能帶球拍，因爲哥哥把他的借給我了。我們在運動中心哪個門見？我想提前十分鐘到。"}, "suggestedHanzi": [40, 60], "enforcedMinimum": null, "sharedTimingGroup": "writing", "rubric": {"maxPoints": 8, "automaticGrade": false, "missing": "unsubmitted", "technicalFailure": "needs_rerecording", "reviewerOptions": ["self", "own_teacher"], "teacherServiceIncluded": false, "dimensions": [{"id": "completion", "name": "任务完成", "levels": {"0": "已提交内容没有回应相关任务。", "1": "回应部分要求，但遗漏或误解关键信息。", "2": "完成本任务主要观察点：Answer whether Tuesday at five works for you.；Say whether you can bring a racket.；Give a reason related to availability or equipment.；Suggest a feasible alternative or ask a relevant question."}}, {"id": "comprehensibility", "name": "可理解性", "levels": {"0": "主要意思无法恢复。", "1": "部分意思需猜测，个别错误影响理解。", "2": "主要意思清楚；允许不影响理解的错误和口音。"}}, {"id": "language", "name": "语言运用", "levels": {"0": "缺少可表达任务意思的中文。", "1": "有限词句可表达部分意思，但关系不够清楚。", "2": "能用简单中文和必要连接表达多项信息，不要求指定句型。"}}, {"id": "organization", "name": "组织和相关回应", "levels": {"0": "缺少可辨顺序或相关回应。", "1": "部分顺序或回应相关，但连接不清。", "2": "多句内容易于跟随，先后或比较关系清楚，回应相关。"}}], "notes": "Suggested length and native-like accent are not scoring criteria. S1 is ONE profile across four responses; a missing turn is partial submission.", "taskObservations": ["Answer whether Tuesday at five works for you.", "Say whether you can bring a racket.", "Give a reason related to availability or equipment.", "Suggest a feasible alternative or ask a relevant question."]}, "reviewNotes": ["A refusal with a feasible suggestion is valid.", "A learner can lack a racket and ask about borrowing one.", "Judge completion of the four observations rather than exact wording."]}, {"id": "W2", "section": "writing", "type": "short-experience-narrative", "title": "Tell a classmate about a short trip", "promptEn": "Use the fictional trip card to describe last Sunday in Chinese. Include when and where the trip happened, at least two actions in a consistent order, and a feeling or reason. You may add plausible details. About 80-120 Chinese characters is a guide, not a minimum.", "stimulus": {"zh-Hans": "时间：上周日\n地点：城外的小湖\n早上：全班坐小巴出发\n到达后：老师带大家沿湖看鸟\n中午：在树下吃自带的午饭\n下午：整理垃圾，再坐车返校\n感受：自己选择并说明", "zh-Hant": "時間：上週日\n地點：城外的小湖\n早上：全班坐小巴出發\n到達後：老師帶大家沿湖看鳥\n中午：在樹下喫自帶的午飯\n下午：整理垃圾，再坐車返校\n感受：自己選擇並說明"}, "requirements": ["Identify last Sunday.", "Identify the lake outside town.", "Describe one action on the card.", "Describe a second action in a consistent sequence.", "Give a feeling or a reason."], "reference": {"zh-Hans": "上周日，我们班坐小巴去了城外的小湖。下车后，老师先带我们沿湖看鸟，还教我们拍照。中午，大家在树下吃自己带的午饭。下午，我们整理好垃圾，再坐车回学校。我喜欢这次短途活动，因为能和同学聊天，也看到了平时不常见的鸟。", "zh-Hant": "上週日，我們班坐小巴去了城外的小湖。下車後，老師先帶我們沿湖看鳥，還教我們拍照。中午，大家在樹下喫自己帶的午飯。下午，我們整理好垃圾，再坐車回學校。我喜歡這次短途活動，因爲能和同學聊天，也看到了平時不常見的鳥。"}, "suggestedHanzi": [80, 120], "enforcedMinimum": null, "sharedTimingGroup": "writing", "rubric": {"maxPoints": 8, "automaticGrade": false, "missing": "unsubmitted", "technicalFailure": "needs_rerecording", "reviewerOptions": ["self", "own_teacher"], "teacherServiceIncluded": false, "dimensions": [{"id": "completion", "name": "任务完成", "levels": {"0": "已提交内容没有回应相关任务。", "1": "回应部分要求，但遗漏或误解关键信息。", "2": "完成本任务主要观察点：Identify last Sunday.；Identify the lake outside town.；Describe one action on the card.；Describe a second action in a consistent sequence.；Give a feeling or a reason."}}, {"id": "comprehensibility", "name": "可理解性", "levels": {"0": "主要意思无法恢复。", "1": "部分意思需猜测，个别错误影响理解。", "2": "主要意思清楚；允许不影响理解的错误和口音。"}}, {"id": "language", "name": "语言运用", "levels": {"0": "缺少可表达任务意思的中文。", "1": "有限词句可表达部分意思，但关系不够清楚。", "2": "能用简单中文和必要连接表达多项信息，不要求指定句型。"}}, {"id": "organization", "name": "组织和相关回应", "levels": {"0": "缺少可辨顺序或相关回应。", "1": "部分顺序或回应相关，但连接不清。", "2": "多句内容易于跟随，先后或比较关系清楚，回应相关。"}}], "notes": "Suggested length and native-like accent are not scoring criteria. S1 is ONE profile across four responses; a missing turn is partial submission.", "taskObservations": ["Identify last Sunday.", "Identify the lake outside town.", "Describe one action on the card.", "Describe a second action in a consistent sequence.", "Give a feeling or a reason."]}, "reviewNotes": ["A negative feeling with a coherent reason is also acceptable.", "Do not require every time label or the added detail in the reference.", "Different sentence structures may express the same sequence."]}, {"id": "S1", "section": "speaking", "type": "simulated-guided-exchange", "title": "Arrange a sports-centre visit", "promptEn": "A classmate is arranging a visit to the sports centre. Answer four fixed recorded prompts in Chinese. Each prompt plays twice, followed by 15 seconds to prepare and up to 25 seconds to record. Use real or invented details. Four responses are reviewed together as one task out of eight; these prompts are not adaptive.", "scenarioEn": "Discuss equipment needs, choose an activity, explain your choice, and handle a changed meeting point.", "exchanges": [{"id": "S1-1", "speaker": "male", "prompt": {"zh-Hans": "明天去运动中心，你还需要借什么东西吗？球、球拍，或者别的东西都可以说。", "zh-Hant": "明天去運動中心，你還需要借什麼東西嗎？球、球拍，或者別的東西都可以說。"}, "reference": {"zh-Hans": "我没有球拍，想借一副。球我已经有了。", "zh-Hant": "我沒有球拍，想借一副。球我已經有了。"}, "checklist": ["State equipment needed or explain that you need none."]}, {"id": "S1-2", "speaker": "male", "prompt": {"zh-Hans": "你想参加羽毛球还是游泳？也可以提出另一个运动。", "zh-Hant": "你想參加羽毛球還是游泳？也可以提出另一個運動。"}, "reference": {"zh-Hans": "我想参加羽毛球，先跟大家练一练。", "zh-Hant": "我想參加羽毛球，先跟大家練一練。"}, "checklist": ["Choose a relevant sport or propose another."]}, {"id": "S1-3", "speaker": "male", "prompt": {"zh-Hans": "为什么这个运动适合你？告诉我一个理由就可以。", "zh-Hant": "爲什麼這個運動適合你？告訴我一個理由就可以。"}, "reference": {"zh-Hans": "因为我以前学过一点儿，想和同学一起练。", "zh-Hant": "因爲我以前學過一點兒，想和同學一起練。"}, "checklist": ["Give a reason relevant to the learner’s own choice."]}, {"id": "S1-4", "speaker": "male", "prompt": {"zh-Hans": "南门明天不开，我们改在东门见，你觉得怎么样？如果不方便，你有什么办法？", "zh-Hant": "南門明天不開，我們改在東門見，你覺得怎麼樣？如果不方便，你有什麼辦法？"}, "reference": {"zh-Hans": "东门可以，我知道怎么走。我们九点在那里见。", "zh-Hant": "東門可以，我知道怎麼走。我們九點在那裏見。"}, "alternateReference": {"zh-Hans": "我不认识东门，能先在公交站见，再一起走过去吗？", "zh-Hant": "我不認識東門，能先在公交站見，再一起走過去嗎？"}, "checklist": ["Accept the new meeting point or propose a workable alternative."]}], "playsPerPrompt": 2, "preparationSecondsPerPrompt": 15, "responseSecondsPerPrompt": 25, "rubricScope": "all_four_responses_together", "rubric": {"maxPoints": 8, "automaticGrade": false, "missing": "unsubmitted", "technicalFailure": "needs_rerecording", "reviewerOptions": ["self", "own_teacher"], "teacherServiceIncluded": false, "dimensions": [{"id": "completion", "name": "任务完成", "levels": {"0": "已提交内容没有回应相关任务。", "1": "回应部分要求，但遗漏或误解关键信息。", "2": "完成本任务主要观察点：State equipment needed or explain that you need none.；Choose a relevant sport or propose another.；Give a reason relevant to the learner’s own choice.；Accept the new meeting point or propose a workable alternative."}}, {"id": "comprehensibility", "name": "可理解性", "levels": {"0": "主要意思无法恢复。", "1": "部分意思需猜测，个别错误影响理解。", "2": "主要意思清楚；允许不影响理解的错误和口音。"}}, {"id": "language", "name": "语言运用", "levels": {"0": "缺少可表达任务意思的中文。", "1": "有限词句可表达部分意思，但关系不够清楚。", "2": "能用简单中文和必要连接表达多项信息，不要求指定句型。"}}, {"id": "organization", "name": "组织和相关回应", "levels": {"0": "缺少可辨顺序或相关回应。", "1": "部分顺序或回应相关，但连接不清。", "2": "多句内容易于跟随，先后或比较关系清楚，回应相关。"}}], "notes": "Suggested length and native-like accent are not scoring criteria. S1 is ONE profile across four responses; a missing turn is partial submission.", "taskObservations": ["State equipment needed or explain that you need none.", "Choose a relevant sport or propose another.", "Give a reason relevant to the learner’s own choice.", "Accept the new meeting point or propose a workable alternative."]}}, {"id": "S2", "section": "speaking", "type": "compare-and-plan-presentation", "title": "Compare two short trips", "promptEn": "Recommend one of the two short trips to a classmate who must be back at school by three on Sunday and has forty yuan. Compare the options, state a choice, give two reasons supported by the cards and explain a short plan. If you choose an option with a difficulty, explain how you would manage it. Prepare for 60 seconds and speak for up to 90 seconds.", "stimulus": {"zh-Hans": "周日短途选择\n甲：学校组织的小湖活动，上午九点出发、下午两点回校，三十五元含往返车费，需要自带午饭。\n乙：邻城公园，上午十点出发、下午四点回校，二十元含往返车费和午饭；可以提前离开，但提前返程的车费另算，金额未知。\n同学：下午三点前必须回校，预算四十元，家中已准备好可带走的午饭。", "zh-Hant": "週日短途選擇\n甲：學校組織的小湖活動，上午九點出發、下午兩點回校，三十五元含往返車費，需要自帶午飯。\n乙：鄰城公園，上午十點出發、下午四點回校，二十元含往返車費和午飯；可以提前離開，但提前返程的車費另算，金額未知。\n同學：下午三點前必須回校，預算四十元，家中已準備好可帶走的午飯。"}, "requirements": ["Compare one or more features of both trips.", "Choose a trip.", "Give a first supported reason.", "Give a second supported reason.", "Describe a feasible short plan, including how to handle any chosen constraint."], "reference": {"zh-Hans": "我建议选甲。甲要三十五元，比乙贵，但是没有超过四十元。甲两点就回学校，能赶上同学三点以前回校的要求。乙正常四点才回来，提前回来的车费也不知道。我们可以先准备午饭，八点五十分到学校，九点和大家一起出发。", "zh-Hant": "我建議選甲。甲要三十五元，比乙貴，但是沒有超過四十元。甲兩點就回學校，能趕上同學三點以前回校的要求。乙正常四點纔回來，提前回來的車費也不知道。我們可以先準備午飯，八點五十分到學校，九點和大家一起出發。"}, "alternateReference": {"zh-Hans": "如果选乙，就必须先问清提前回校的车次和另外的车费，确认三点前能到，而且总共不超过四十元。在这些事情没有确认以前，我不会直接建议同学报名乙。", "zh-Hant": "如果選乙，就必須先問清提前回校的車次和另外的車費，確認三點前能到，而且總共不超過四十元。在這些事情沒有確認以前，我不會直接建議同學報名乙。"}, "preparationSeconds": 60, "responseSeconds": 90, "rubric": {"maxPoints": 8, "automaticGrade": false, "missing": "unsubmitted", "technicalFailure": "needs_rerecording", "reviewerOptions": ["self", "own_teacher"], "teacherServiceIncluded": false, "dimensions": [{"id": "completion", "name": "任务完成", "levels": {"0": "已提交内容没有回应相关任务。", "1": "回应部分要求，但遗漏或误解关键信息。", "2": "完成本任务主要观察点：Compare one or more features of both trips.；Choose a trip.；Give a first supported reason.；Give a second supported reason.；Describe a feasible short plan, including how to handle any chosen constraint."}}, {"id": "comprehensibility", "name": "可理解性", "levels": {"0": "主要意思无法恢复。", "1": "部分意思需猜测，个别错误影响理解。", "2": "主要意思清楚；允许不影响理解的错误和口音。"}}, {"id": "language", "name": "语言运用", "levels": {"0": "缺少可表达任务意思的中文。", "1": "有限词句可表达部分意思，但关系不够清楚。", "2": "能用简单中文和必要连接表达多项信息，不要求指定句型。"}}, {"id": "organization", "name": "组织和相关回应", "levels": {"0": "缺少可辨顺序或相关回应。", "1": "部分顺序或回应相关，但连接不清。", "2": "多句内容易于跟随，先后或比较关系清楚，回应相关。"}}], "notes": "Suggested length and native-like accent are not scoring criteria. S1 is ONE profile across four responses; a missing turn is partial submission.", "taskObservations": ["Compare one or more features of both trips.", "Choose a trip.", "Give a first supported reason.", "Give a second supported reason.", "Describe a feasible short plan, including how to handle any chosen constraint."]}, "reviewNotes": ["A meets known time and budget limits.", "B requires a conditional plan; do not assume an unknown return fare is free.", "Do not impose a native accent or a minimum recording length."]}], "instructions": {"en": "Choose one answer per listening/reading item. Full listening sources play twice. Writing tasks share 20 minutes. Use your own recorder for speaking; this preview does not time or save work. Self/own-teacher marking only; no included marking service.", "zh": "听读每题三选一，整轨听力每段两遍。写作共用二十分钟。口语用自己的录音工具；此审阅页不计时或保存作答。口写自评或交自己的教师评阅，不包含本站代评。"}, "vocabularySupport": [{"term": {"zh-Hans": "备用钥匙", "zh-Hant": "備用鑰匙"}, "pinyin": "bèiyòng yàoshi", "meaningEn": "spare key"}, {"term": {"zh-Hans": "猫粮", "zh-Hant": "貓糧"}, "pinyin": "māoliáng", "meaningEn": "cat food"}, {"term": {"zh-Hans": "梳毛", "zh-Hant": "梳毛"}, "pinyin": "shū máo", "meaningEn": "brush fur"}, {"term": {"zh-Hans": "羽毛球", "zh-Hant": "羽毛球"}, "pinyin": "yǔmáoqiú", "meaningEn": "badminton"}, {"term": {"zh-Hans": "球拍", "zh-Hant": "球拍"}, "pinyin": "qiúpāi", "meaningEn": "racket"}, {"term": {"zh-Hans": "车篮", "zh-Hant": "車籃"}, "pinyin": "chēlán", "meaningEn": "bicycle basket"}, {"term": {"zh-Hans": "广场", "zh-Hant": "廣場"}, "pinyin": "guǎngchǎng", "meaningEn": "square"}, {"term": {"zh-Hans": "换车", "zh-Hant": "換車"}, "pinyin": "huàn chē", "meaningEn": "transfer vehicles"}, {"term": {"zh-Hans": "野餐垫", "zh-Hant": "野餐墊"}, "pinyin": "yěcān diàn", "meaningEn": "picnic mat"}, {"term": {"zh-Hans": "押金", "zh-Hant": "押金"}, "pinyin": "yājīn", "meaningEn": "refundable deposit"}, {"term": {"zh-Hans": "冷藏", "zh-Hant": "冷藏"}, "pinyin": "lěngcáng", "meaningEn": "keep refrigerated"}, {"term": {"zh-Hans": "香包", "zh-Hant": "香包"}, "pinyin": "xiāngbāo", "meaningEn": "sachet"}, {"term": {"zh-Hans": "盖章", "zh-Hant": "蓋章"}, "pinyin": "gài zhāng", "meaningEn": "stamp"}, {"term": {"zh-Hans": "返校", "zh-Hant": "返校"}, "pinyin": "fǎn xiào", "meaningEn": "return to school"}], "supportPolicy": "Preparation support is separate from timed papers. Per-item lexical audit and teacher suitability review remain separate.", "nextAcceptance": ["Actual media timing and structural validation", "ASR screening and retained flags", "Human listening acceptance", "Independent teacher and learner pilot", "Separate product integration and release"]}</script><script id="audio-data" type="application/json">{"paperId": "course-chinese-2-b-v1", "provider": "Edge TTS at authoring time; local MP3 playback, no runtime TTS", "rate": "-8%", "voices": {"female": "zh-CN-XiaoxiaoNeural", "male": "zh-CN-YunxiNeural"}, "humanListeningAcceptance": false, "units": [{"id": "C2B-M01", "kind": "listening-source", "sourcePlays": 1, "script": [{"speaker": "female", "text": {"zh-Hans": "小何来帮我们照顾猫以前，家里要准备什么？", "zh-Hant": "小何來幫我們照顧貓以前，家裏要準備什麼？"}}, {"speaker": "male", "text": {"zh-Hans": "你把猫粮放在桌上，我去把备用钥匙交给小何，猫的水我已经换好了。", "zh-Hant": "你把貓糧放在桌上，我去把備用鑰匙交給小何，貓的水我已經換好了。"}}, {"speaker": "female", "text": {"zh-Hans": "好，我现在准备猫粮。", "zh-Hant": "好，我現在準備貓糧。"}}], "sourceDurationSeconds": 15.196, "src": "assets/audio/c2b-m01.mp3", "durationSeconds": 15.744, "pcmSeconds": 15.696, "bytes": 126188, "sha256": "594f3974f30f68c9436bc2c63f610103878c140847ff76c6168e17fcb690ff7d"}, {"id": "C2B-M02", "kind": "listening-source", "sourcePlays": 1, "script": [{"speaker": "male", "text": {"zh-Hans": "今天下午的宠物照顾活动几点开始？", "zh-Hant": "今天下午的寵物照顧活動幾點開始？"}}, {"speaker": "female", "text": {"zh-Hans": "四点。三点半大家可以先看照片，四点老师教我们怎么给小狗梳毛，五点再提问题。", "zh-Hant": "四點。三點半大家可以先看照片，四點老師教我們怎麼給小狗梳毛，五點再提問題。"}}, {"speaker": "male", "text": {"zh-Hans": "我四点前到。", "zh-Hant": "我四點前到。"}}], "sourceDurationSeconds": 16.276, "src": "assets/audio/c2b-m02.mp3", "durationSeconds": 16.824, "pcmSeconds": 16.776, "bytes": 134828, "sha256": "692763139ca93334ab4e4734a664a40b7dbbd4e8f5594a0c8cdf48ba54fa325f"}, {"id": "C2B-M03", "kind": "listening-source", "sourcePlays": 1, "script": [{"speaker": "female", "text": {"zh-Hans": "放学以后，我每次带小狗出去二十分钟。哥哥今天问我要不要走四十分钟，可是小狗走久了会累，我还是按平时的时间走。", "zh-Hant": "放學以後，我每次帶小狗出去二十分鐘。哥哥今天問我要不要走四十分鐘，可是小狗走久了會累，我還是按平時的時間走。"}}], "sourceDurationSeconds": 12.072, "src": "assets/audio/c2b-m03.mp3", "durationSeconds": 12.624, "pcmSeconds": 12.572, "bytes": 101228, "sha256": "ea98d1835cf62b096be63faed43620b2c55fbcfec3bf93399754236520b15b89"}, {"id": "C2B-M04", "kind": "listening-source", "sourcePlays": 1, "script": [{"speaker": "male", "text": {"zh-Hans": "你想学打球还是游泳？", "zh-Hant": "你想學打球還是游泳？"}}, {"speaker": "female", "text": {"zh-Hans": "我想游泳，可是只有周三晚上有空。", "zh-Hant": "我想游泳，可是隻有周三晚上有空。"}}, {"speaker": "male", "text": {"zh-Hans": "游泳课周二晚上开，周三有篮球课。", "zh-Hant": "游泳課週二晚上開，週三有籃球課。"}}, {"speaker": "female", "text": {"zh-Hans": "那先试试篮球课吧。", "zh-Hant": "那先試試籃球課吧。"}}], "sourceDurationSeconds": 15.282, "src": "assets/audio/c2b-m04.mp3", "durationSeconds": 15.84, "pcmSeconds": 15.782, "bytes": 126956, "sha256": "9d997d2a09ef48b80a87e050b332150f3b5c8c0997467ba9754c30e2143f2baf"}, {"id": "C2B-M05", "kind": "listening-source", "sourcePlays": 1, "script": [{"speaker": "female", "text": {"zh-Hans": "上次打球，小丁忘了带水，打完以后一直说口渴。今天他还没出门，就先往书包里放了一大瓶水，旁边的球鞋倒是差点儿忘了。", "zh-Hant": "上次打球，小丁忘了帶水，打完以後一直說口渴。今天他還沒出門，就先往書包裏放了一大瓶水，旁邊的球鞋倒是差點兒忘了。"}}], "sourceDurationSeconds": 13.152, "src": "assets/audio/c2b-m05.mp3", "durationSeconds": 13.704, "pcmSeconds": 13.652, "bytes": 109868, "sha256": "61520ae639724b215477d4103122e53fac4567efa8ca183a03b4ac73d75875f9"}, {"id": "C2B-M06", "kind": "listening-source", "sourcePlays": 1, "script": [{"speaker": "male", "text": {"zh-Hans": "你到了运动中心就在游泳馆等我吧。", "zh-Hant": "你到了運動中心就在游泳館等我吧。"}}, {"speaker": "female", "text": {"zh-Hans": "我不游泳，今天要上篮球课。我们在篮球馆门口见，别走到游泳馆去。", "zh-Hant": "我不游泳，今天要上籃球課。我們在籃球館門口見，別走到游泳館去。"}}, {"speaker": "male", "text": {"zh-Hans": "好，我去篮球馆。", "zh-Hant": "好，我去籃球館。"}}], "sourceDurationSeconds": 14.716, "src": "assets/audio/c2b-m06.mp3", "durationSeconds": 15.264, "pcmSeconds": 15.216, "bytes": 122348, "sha256": "6651a8664ea03bea56c758d468ee2fe6c9e505229d2c45db1a01cab64387c360"}, {"id": "C2B-M07", "kind": "listening-source", "sourcePlays": 1, "script": [{"speaker": "female", "text": {"zh-Hans": "公交车还要等半个小时，你想怎么去运动中心？", "zh-Hant": "公交車還要等半個小時，你想怎麼去運動中心？"}}, {"speaker": "male", "text": {"zh-Hans": "我们的自行车都在这儿，骑车只要十分钟。", "zh-Hant": "我們的自行車都在這兒，騎車只要十分鐘。"}}, {"speaker": "female", "text": {"zh-Hans": "好，把球放进车篮，我们骑车去。", "zh-Hant": "好，把球放進車籃，我們騎車去。"}}], "sourceDurationSeconds": 13.732, "src": "assets/audio/c2b-m07.mp3", "durationSeconds": 14.28, "pcmSeconds": 14.232, "bytes": 114476, "sha256": "3d7ee49dc1e40f8b85580932a3d411ae197fa8341d0b7e60b222d5a48462881b"}, {"id": "C2B-M08", "kind": "listening-source", "sourcePlays": 1, "script": [{"speaker": "male", "text": {"zh-Hans": "从西门进去以后，怎么到篮球馆？", "zh-Hant": "從西門進去以後，怎麼到籃球館？"}}, {"speaker": "female", "text": {"zh-Hans": "先穿过小广场，看到食堂再向左。篮球馆在食堂后面，不在停车场旁边。", "zh-Hant": "先穿過小廣場，看到食堂再向左。籃球館在食堂後面，不在停車場旁邊。"}}, {"speaker": "male", "text": {"zh-Hans": "好，先过广场。", "zh-Hant": "好，先過廣場。"}}], "sourceDurationSeconds": 15.532, "src": "assets/audio/c2b-m08.mp3", "durationSeconds": 16.08, "pcmSeconds": 16.032, "bytes": 128876, "sha256": "74a633eff18f6f4f4d22e923f0a6bbd63def2ff6e0e4d173ecf71ddef372c670"}, {"id": "C2B-M09", "kind": "listening-source", "sourcePlays": 1, "script": [{"speaker": "female", "text": {"zh-Hans": "六路车两点前到运动中心，不用换车。十路车也能两点前到，可是中间要换一次。", "zh-Hant": "六路車兩點前到運動中心，不用換車。十路車也能兩點前到，可是中間要換一次。"}}, {"speaker": "male", "text": {"zh-Hans": "我带着两个球和一个大包，不想换车，坐六路吧。", "zh-Hant": "我帶着兩個球和一個大包，不想換車，坐六路吧。"}}], "sourceDurationSeconds": 14.486, "src": "assets/audio/c2b-m09.mp3", "durationSeconds": 15.048, "pcmSeconds": 14.986, "bytes": 120620, "sha256": "3f2375e57272ffc349db9bc6c715c10121d38cb89d820a5ba70e7ee5e4cffb70"}, {"id": "C2B-M10", "kind": "listening-source", "sourcePlays": 1, "script": [{"speaker": "male", "text": {"zh-Hans": "星期六下午三点太热，室外练球还照原计划吗？", "zh-Hant": "星期六下午三點太熱，室外練球還照原計劃嗎？"}}, {"speaker": "female", "text": {"zh-Hans": "老师说改到早上八点，地点不变，还是学校球场。", "zh-Hant": "老師說改到早上八點，地點不變，還是學校球場。"}}, {"speaker": "male", "text": {"zh-Hans": "好，我把原来下午的提醒改掉。", "zh-Hant": "好，我把原來下午的提醒改掉。"}}], "sourceDurationSeconds": 16.108, "src": "assets/audio/c2b-m10.mp3", "durationSeconds": 16.656, "pcmSeconds": 16.608, "bytes": 133484, "sha256": "755ddeddab775fd0131550a65932f766f66683c3f468163abbe7f5c5868cfc5b"}, {"id": "C2B-M11", "kind": "listening-source", "sourcePlays": 1, "script": [{"speaker": "female", "text": {"zh-Hans": "野餐要带几盒果汁？", "zh-Hant": "野餐要帶幾盒果汁？"}}, {"speaker": "male", "text": {"zh-Hans": "原来六个人，现在只有四个人去，一人一盒就够。", "zh-Hant": "原來六個人，現在只有四個人去，一人一盒就夠。"}}, {"speaker": "female", "text": {"zh-Hans": "那我带四盒，面包另外买两袋。", "zh-Hant": "那我帶四盒，麪包另外買兩袋。"}}, {"speaker": "male", "text": {"zh-Hans": "好，别按原来的人数买。", "zh-Hant": "好，別按原來的人數買。"}}], "sourceDurationSeconds": 15.834, "src": "assets/audio/c2b-m11.mp3", "durationSeconds": 16.392, "pcmSeconds": 16.334, "bytes": 131372, "sha256": "809b4cc8b1c57d8a60e9e1c299aca975e4fc46d2a2cfa20f898d2395df263646"}, {"id": "C2B-M12", "kind": "listening-source", "sourcePlays": 1, "script": [{"speaker": "male", "text": {"zh-Hans": "你想买哪张野餐垫？小号轻一些。", "zh-Hant": "你想買哪張野餐墊？小號輕一些。"}}, {"speaker": "female", "text": {"zh-Hans": "我们四个人，小号只能坐两个人。我买能坐四个人的大号，蓝色和绿色都可以。", "zh-Hant": "我們四個人，小號只能坐兩個人。我買能坐四個人的大號，藍色和綠色都可以。"}}, {"speaker": "male", "text": {"zh-Hans": "那拿这张绿色大号吧。", "zh-Hant": "那拿這張綠色大號吧。"}}], "sourceDurationSeconds": 15.916, "src": "assets/audio/c2b-m12.mp3", "durationSeconds": 16.464, "pcmSeconds": 16.416, "bytes": 131948, "sha256": "16b5f404de6a3c84a9a235ef69748c92ac27e3acf2142094f391d49aaebe6460"}, {"id": "C2B-M13", "kind": "listening-source", "sourcePlays": 1, "script": [{"speaker": "female", "text": {"zh-Hans": "这袋面包原来六块，今天学生买只要四块。纸袋要另外一块。", "zh-Hant": "這袋麪包原來六塊，今天學生買只要四塊。紙袋要另外一塊。"}}, {"speaker": "male", "text": {"zh-Hans": "我是学生，自己带了袋子，只买面包。", "zh-Hant": "我是學生，自己帶了袋子，只買麪包。"}}, {"speaker": "female", "text": {"zh-Hans": "那收你四块。", "zh-Hant": "那收你四塊。"}}], "sourceDurationSeconds": 13.876, "src": "assets/audio/c2b-m13.mp3", "durationSeconds": 14.424, "pcmSeconds": 14.376, "bytes": 115628, "sha256": "c9e757e3a2919b5dcc364a0a5fc826775806dca5a89bff673eb3fae9b27b68db"}, {"id": "C2B-M14", "kind": "listening-source", "sourcePlays": 1, "script": [{"speaker": "male", "text": {"zh-Hans": "野餐包要轻一点儿，还要能挡雨。甲包轻，可是怕水；乙包很重；丙包又轻又能挡雨。", "zh-Hant": "野餐包要輕一點兒，還要能擋雨。甲包輕，可是怕水；乙包很重；丙包又輕又能擋雨。"}}, {"speaker": "female", "text": {"zh-Hans": "我们要走很久，天气也可能下雨，就选丙包。", "zh-Hant": "我們要走很久，天氣也可能下雨，就選丙包。"}}], "sourceDurationSeconds": 14.798, "src": "assets/audio/c2b-m14.mp3", "durationSeconds": 15.36, "pcmSeconds": 15.298, "bytes": 123116, "sha256": "fb4a3ee214fdf8751c2422011d81424bd4d308e274a3868c18ab383eb432233a"}, {"id": "C2B-M15", "kind": "listening-source", "sourcePlays": 1, "script": [{"speaker": "female", "text": {"zh-Hans": "小何六点来照顾猫，钥匙还在你那儿吗？", "zh-Hant": "小何六點來照顧貓，鑰匙還在你那兒嗎？"}}, {"speaker": "male", "text": {"zh-Hans": "在，但我放学后要去打球，七点才到家。", "zh-Hant": "在，但我放學後要去打球，七點纔到家。"}}, {"speaker": "female", "text": {"zh-Hans": "那你先把钥匙给楼下王阿姨，小何来了找她拿。", "zh-Hant": "那你先把鑰匙給樓下王阿姨，小何來了找她拿。"}}], "sourceDurationSeconds": 14.524, "src": "assets/audio/c2b-m15.mp3", "durationSeconds": 15.072, "pcmSeconds": 15.024, "bytes": 120812, "sha256": "3ce66a9829cf3beef75ea57c55b9e420b2a1411c49bb95b11500163e18a1091c"}, {"id": "C2B-M16", "kind": "listening-source", "sourcePlays": 1, "script": [{"speaker": "male", "text": {"zh-Hans": "早上还比较凉快，只有二十四度。下午会升到三十五度，也没有风。傍晚才慢慢凉下来。今天想去买球鞋的话，最好别在下午最热的时候出门。", "zh-Hant": "早上還比較涼快，只有二十四度。下午會升到三十五度，也沒有風。傍晚才慢慢涼下來。今天想去買球鞋的話，最好別在下午最熱的時候出門。"}}], "sourceDurationSeconds": 13.8, "src": "assets/audio/c2b-m16.mp3", "durationSeconds": 14.352, "pcmSeconds": 14.3, "bytes": 115052, "sha256": "9445401064e3b8a6817a3a6b12a2372693c5cd842a811dacbcb0801184a29368"}, {"id": "C2B-M17", "kind": "listening-source", "sourcePlays": 1, "script": [{"speaker": "female", "text": {"zh-Hans": "今天的球赛为什么改到晚上七点？场地没空吗？", "zh-Hant": "今天的球賽爲什麼改到晚上七點？場地沒空嗎？"}}, {"speaker": "male", "text": {"zh-Hans": "场地一直能用，是下午太阳太强，大家怕热。晚上凉快一点儿，打起来更舒服。", "zh-Hant": "場地一直能用，是下午太陽太強，大家怕熱。晚上涼快一點兒，打起來更舒服。"}}, {"speaker": "female", "text": {"zh-Hans": "明白了。", "zh-Hant": "明白了。"}}], "sourceDurationSeconds": 16.444, "src": "assets/audio/c2b-m17.mp3", "durationSeconds": 16.992, "pcmSeconds": 16.944, "bytes": 136172, "sha256": "6e21162c508979f0aa895f2f699287d5f0d8361f734226f11ae8a98e5d1c2b3f"}, {"id": "C2B-M18", "kind": "listening-source", "sourcePlays": 1, "script": [{"speaker": "male", "text": {"zh-Hans": "我今天想运动，但老师说每次别超过一个小时，也先别跑步。", "zh-Hant": "我今天想運動，但老師說每次別超過一個小時，也先別跑步。"}}, {"speaker": "female", "text": {"zh-Hans": "那可以选五十分钟的投篮课。跑步课只有半小时，游泳课却要九十分钟。", "zh-Hant": "那可以選五十分鐘的投籃課。跑步課只有半小時，游泳課卻要九十分鐘。"}}, {"speaker": "male", "text": {"zh-Hans": "好，我去投篮。", "zh-Hant": "好，我去投籃。"}}], "sourceDurationSeconds": 17.188, "src": "assets/audio/c2b-m18.mp3", "durationSeconds": 17.736, "pcmSeconds": 17.688, "bytes": 142124, "sha256": "fd3e397e7737c34a964e61585f19feabca2a10778f57a163c81be6f7871c473b"}, {"id": "C2B-M19", "kind": "listening-source", "sourcePlays": 1, "script": [{"speaker": "female", "text": {"zh-Hans": "端午那天，我们先在河边看龙舟，回来以后听老师讲活动的故事。听完故事，大家才到教室学做香包。我做的香包送给了弟弟，他特别喜欢。", "zh-Hant": "端午那天，我們先在河邊看龍舟，回來以後聽老師講活動的故事。聽完故事，大家纔到教室學做香包。我做的香包送給了弟弟，他特別喜歡。"}}], "sourceDurationSeconds": 14.52, "src": "assets/audio/c2b-m19.mp3", "durationSeconds": 15.072, "pcmSeconds": 15.02, "bytes": 120812, "sha256": "77b266e37d81cd7ceef8c168227ad563bdcae5997dd17ef3cf59caa58d6b0971"}, {"id": "C2B-M20", "kind": "listening-source", "sourcePlays": 1, "script": [{"speaker": "male", "text": {"zh-Hans": "端午活动刚开始，小方说自己手笨，做不好香包。老师陪着她做了一次。后来老师还没走过来，她已经自己做好第二个，又开始教旁边的小朋友了。", "zh-Hant": "端午活動剛開始，小方說自己手笨，做不好香包。老師陪着她做了一次。後來老師還沒走過來，她已經自己做好第二個，又開始教旁邊的小朋友了。"}}], "sourceDurationSeconds": 14.112, "src": "assets/audio/c2b-m20.mp3", "durationSeconds": 14.664, "pcmSeconds": 14.612, "bytes": 117548, "sha256": "b017a30b0f0bc4227cad2dfc9ff05f8698572f7df99a16dbfc2bc23eec1678b8"}, {"id": "S1-1", "kind": "oral-prompt", "sourcePlays": 2, "singlePlayPcmSeconds": 8.664, "repeatGapSeconds": 1.5, "singlePlayPcmSha256": "3972205d5d4600e2d66cdbdc4118691aa8048c40b04faf4fe16e1f748ba5a6cb", "script": {"zh-Hans": "明天去运动中心，你还需要借什么东西吗？球、球拍，或者别的东西都可以说。", "zh-Hant": "明天去運動中心，你還需要借什麼東西嗎？球、球拍，或者別的東西都可以說。"}, "src": "assets/audio/s1-1.mp3", "durationSeconds": 18.888, "pcmSeconds": 18.828, "bytes": 151340, "sha256": "f3cfec7b107e157ec8d1cf9ec95c0e25e8fbd614a739d8995631bebdb61dcdc6"}, {"id": "S1-2", "kind": "oral-prompt", "sourcePlays": 2, "singlePlayPcmSeconds": 5.76, "repeatGapSeconds": 1.5, "singlePlayPcmSha256": "f5d1d5b514eb14d66d21c2149f1ef7b9bc7e627b474425eddcf044aa09c843fc", "script": {"zh-Hans": "你想参加羽毛球还是游泳？也可以提出另一个运动。", "zh-Hant": "你想參加羽毛球還是游泳？也可以提出另一個運動。"}, "src": "assets/audio/s1-2.mp3", "durationSeconds": 13.08, "pcmSeconds": 13.02, "bytes": 104876, "sha256": "cbe94d9091b1ea2fde001f56488ca3a46243bb6f585c70394576595d247ce04b"}, {"id": "S1-3", "kind": "oral-prompt", "sourcePlays": 2, "singlePlayPcmSeconds": 4.704, "repeatGapSeconds": 1.5, "singlePlayPcmSha256": "02243a4ce9ea877ea9e1bc6cf13c19d225aa14e91c5cd5e60c6b6cb9b5a041a9", "script": {"zh-Hans": "为什么这个运动适合你？告诉我一个理由就可以。", "zh-Hant": "爲什麼這個運動適合你？告訴我一個理由就可以。"}, "src": "assets/audio/s1-3.mp3", "durationSeconds": 10.968, "pcmSeconds": 10.908, "bytes": 87980, "sha256": "8dea01c1e76b254e96b201730ae16d737e2774a56af498c772847a6e65f9a6de"}, {"id": "S1-4", "kind": "oral-prompt", "sourcePlays": 2, "singlePlayPcmSeconds": 8.76, "repeatGapSeconds": 1.5, "singlePlayPcmSha256": "859b83850c0603840258f8b9b3f6e7e90e049660c76ba480ab50819ad69ef5ed", "script": {"zh-Hans": "南门明天不开，我们改在东门见，你觉得怎么样？如果不方便，你有什么办法？", "zh-Hant": "南門明天不開，我們改在東門見，你覺得怎麼樣？如果不方便，你有什麼辦法？"}, "src": "assets/audio/s1-4.mp3", "durationSeconds": 19.08, "pcmSeconds": 19.02, "bytes": 152876, "sha256": "9cc9128a789e07c27183eb8584adb8ceebc882e3f5d3fbf65560ff1b1f39f146"}], "groups": [{"id": "L1", "sourcePlays": 2, "src": "assets/audio/listening-group-1.mp3", "durationSeconds": 300.048, "pcmSeconds": 300.0, "bytes": 2400620, "sha256": "e0d1b747889a9d18547103e2434bad81861519bcd277e77a1795582aad673799"}, {"id": "L2", "sourcePlays": 2, "src": "assets/audio/listening-group-2.mp3", "durationSeconds": 300.048, "pcmSeconds": 300.0, "bytes": 2400620, "sha256": "319c175f4f313f17a383949598d44f2de4196d6684798c76407cf3f56f35cb88"}, {"id": "L3", "sourcePlays": 2, "src": "assets/audio/listening-group-3.mp3", "durationSeconds": 300.048, "pcmSeconds": 300.0, "bytes": 2400620, "sha256": "5e12f4b5abb40da561709c6ae448db5dd99764a4233de1d82a8526724eb208b4"}, {"id": "L4", "sourcePlays": 2, "src": "assets/audio/listening-group-4.mp3", "durationSeconds": 300.048, "pcmSeconds": 300.0, "bytes": 2400620, "sha256": "e11bd4ac44395fae320c348df6bb79a7832ca72e2c136da18164034890967f97"}], "timedTrack": {"src": "assets/audio/listening-full.mp3", "durationSeconds": 1200.048, "pcmSeconds": 1200.0, "bytes": 9600620, "sha256": "5c351a2e1012fcfa39902319b5cc5843449b7c095b7e5cc40c584828866425de"}, "timeline": [{"id": "C2B-M01", "questionNumber": 1, "previewStartSeconds": 0.0, "labelStartSeconds": 5.0, "firstPlayStartSeconds": 8.0, "secondPlayStartSeconds": 24.696, "speechEndSeconds": 39.892, "answerWindowSeconds": 18.608, "transitionSeconds": 1.5, "slotEndSeconds": 60.0, "sourcePlays": 2}, {"id": "C2B-M02", "questionNumber": 2, "previewStartSeconds": 60.0, "labelStartSeconds": 65.0, "firstPlayStartSeconds": 68.0, "secondPlayStartSeconds": 85.776, "speechEndSeconds": 102.052, "answerWindowSeconds": 16.448, "transitionSeconds": 1.5, "slotEndSeconds": 120.0, "sourcePlays": 2}, {"id": "C2B-M03", "questionNumber": 3, "previewStartSeconds": 120.0, "labelStartSeconds": 125.0, "firstPlayStartSeconds": 128.0, "secondPlayStartSeconds": 141.572, "speechEndSeconds": 153.644, "answerWindowSeconds": 24.856, "transitionSeconds": 1.5, "slotEndSeconds": 180.0, "sourcePlays": 2}, {"id": "C2B-M04", "questionNumber": 4, "previewStartSeconds": 180.0, "labelStartSeconds": 185.0, "firstPlayStartSeconds": 188.0, "secondPlayStartSeconds": 204.782, "speechEndSeconds": 220.064, "answerWindowSeconds": 18.436, "transitionSeconds": 1.5, "slotEndSeconds": 240.0, "sourcePlays": 2}, {"id": "C2B-M05", "questionNumber": 5, "previewStartSeconds": 240.0, "labelStartSeconds": 245.0, "firstPlayStartSeconds": 248.0, "secondPlayStartSeconds": 262.652, "speechEndSeconds": 275.804, "answerWindowSeconds": 22.696, "transitionSeconds": 1.5, "slotEndSeconds": 300.0, "sourcePlays": 2}, {"id": "C2B-M06", "questionNumber": 6, "previewStartSeconds": 300.0, "labelStartSeconds": 305.0, "firstPlayStartSeconds": 308.0, "secondPlayStartSeconds": 324.216, "speechEndSeconds": 338.932, "answerWindowSeconds": 19.568, "transitionSeconds": 1.5, "slotEndSeconds": 360.0, "sourcePlays": 2}, {"id": "C2B-M07", "questionNumber": 7, "previewStartSeconds": 360.0, "labelStartSeconds": 365.0, "firstPlayStartSeconds": 368.0, "secondPlayStartSeconds": 383.232, "speechEndSeconds": 396.964, "answerWindowSeconds": 21.536, "transitionSeconds": 1.5, "slotEndSeconds": 420.0, "sourcePlays": 2}, {"id": "C2B-M08", "questionNumber": 8, "previewStartSeconds": 420.0, "labelStartSeconds": 425.0, "firstPlayStartSeconds": 428.0, "secondPlayStartSeconds": 445.032, "speechEndSeconds": 460.564, "answerWindowSeconds": 17.936, "transitionSeconds": 1.5, "slotEndSeconds": 480.0, "sourcePlays": 2}, {"id": "C2B-M09", "questionNumber": 9, "previewStartSeconds": 480.0, "labelStartSeconds": 485.0, "firstPlayStartSeconds": 488.0, "secondPlayStartSeconds": 503.986, "speechEndSeconds": 518.472, "answerWindowSeconds": 20.028, "transitionSeconds": 1.5, "slotEndSeconds": 540.0, "sourcePlays": 2}, {"id": "C2B-M10", "questionNumber": 10, "previewStartSeconds": 540.0, "labelStartSeconds": 545.0, "firstPlayStartSeconds": 548.0, "secondPlayStartSeconds": 565.608, "speechEndSeconds": 581.716, "answerWindowSeconds": 16.784, "transitionSeconds": 1.5, "slotEndSeconds": 600.0, "sourcePlays": 2}, {"id": "C2B-M11", "questionNumber": 11, "previewStartSeconds": 600.0, "labelStartSeconds": 605.0, "firstPlayStartSeconds": 608.0, "secondPlayStartSeconds": 625.334, "speechEndSeconds": 641.168, "answerWindowSeconds": 17.332, "transitionSeconds": 1.5, "slotEndSeconds": 660.0, "sourcePlays": 2}, {"id": "C2B-M12", "questionNumber": 12, "previewStartSeconds": 660.0, "labelStartSeconds": 665.0, "firstPlayStartSeconds": 668.0, "secondPlayStartSeconds": 685.416, "speechEndSeconds": 701.332, "answerWindowSeconds": 17.168, "transitionSeconds": 1.5, "slotEndSeconds": 720.0, "sourcePlays": 2}, {"id": "C2B-M13", "questionNumber": 13, "previewStartSeconds": 720.0, "labelStartSeconds": 725.0, "firstPlayStartSeconds": 728.0, "secondPlayStartSeconds": 743.376, "speechEndSeconds": 757.252, "answerWindowSeconds": 21.248, "transitionSeconds": 1.5, "slotEndSeconds": 780.0, "sourcePlays": 2}, {"id": "C2B-M14", "questionNumber": 14, "previewStartSeconds": 780.0, "labelStartSeconds": 785.0, "firstPlayStartSeconds": 788.0, "secondPlayStartSeconds": 804.298, "speechEndSeconds": 819.096, "answerWindowSeconds": 19.404, "transitionSeconds": 1.5, "slotEndSeconds": 840.0, "sourcePlays": 2}, {"id": "C2B-M15", "questionNumber": 15, "previewStartSeconds": 840.0, "labelStartSeconds": 845.0, "firstPlayStartSeconds": 848.0, "secondPlayStartSeconds": 864.024, "speechEndSeconds": 878.548, "answerWindowSeconds": 19.952, "transitionSeconds": 1.5, "slotEndSeconds": 900.0, "sourcePlays": 2}, {"id": "C2B-M16", "questionNumber": 16, "previewStartSeconds": 900.0, "labelStartSeconds": 905.0, "firstPlayStartSeconds": 908.0, "secondPlayStartSeconds": 923.3, "speechEndSeconds": 937.1, "answerWindowSeconds": 21.4, "transitionSeconds": 1.5, "slotEndSeconds": 960.0, "sourcePlays": 2}, {"id": "C2B-M17", "questionNumber": 17, "previewStartSeconds": 960.0, "labelStartSeconds": 965.0, "firstPlayStartSeconds": 968.0, "secondPlayStartSeconds": 985.944, "speechEndSeconds": 1002.388, "answerWindowSeconds": 16.112, "transitionSeconds": 1.5, "slotEndSeconds": 1020.0, "sourcePlays": 2}, {"id": "C2B-M18", "questionNumber": 18, "previewStartSeconds": 1020.0, "labelStartSeconds": 1025.0, "firstPlayStartSeconds": 1028.0, "secondPlayStartSeconds": 1046.688, "speechEndSeconds": 1063.876, "answerWindowSeconds": 14.624, "transitionSeconds": 1.5, "slotEndSeconds": 1080.0, "sourcePlays": 2}, {"id": "C2B-M19", "questionNumber": 19, "previewStartSeconds": 1080.0, "labelStartSeconds": 1085.0, "firstPlayStartSeconds": 1088.0, "secondPlayStartSeconds": 1104.02, "speechEndSeconds": 1118.54, "answerWindowSeconds": 19.96, "transitionSeconds": 1.5, "slotEndSeconds": 1140.0, "sourcePlays": 2}, {"id": "C2B-M20", "questionNumber": 20, "previewStartSeconds": 1140.0, "labelStartSeconds": 1145.0, "firstPlayStartSeconds": 1148.0, "secondPlayStartSeconds": 1163.612, "speechEndSeconds": 1177.724, "answerWindowSeconds": 20.776, "transitionSeconds": 1.5, "slotEndSeconds": 1200.0, "sourcePlays": 2}], "speakingPlannedMaximumSeconds": 415.776, "cache": [{"key": "211c8236d11e94770d282ebe", "speaker": "female", "text": "小何来帮我们照顾猫以前，家里要准备什么？", "sha256": "743dfb5530747f2e0577d79868fd74dd4b88e630502b23855924bd6e91d65ce7"}, {"key": "9cde21af76447d6677b56f27", "speaker": "male", "text": "你把猫粮放在桌上，我去把备用钥匙交给小何，猫的水我已经换好了。", "sha256": "5c0a24c619c479a596da37c98755f5f5b808e658c10b9682a73d167493e6e476"}, {"key": "41f07ab7bd62ce092dde8ff5", "speaker": "female", "text": "好，我现在准备猫粮。", "sha256": "884824e1d973d8a04c947d01e3c08ab6017c37bd21d76e03f2f3b72da5a00d95"}, {"key": "34e89f8d03ace2b111d8dc37", "speaker": "female", "text": "第1题。", "sha256": "3895df58b8b6ce61365216490dcb339db3aa7ef168eef8d2098c469073a4cdc2"}, {"key": "bddb8bd391270c0eb4adf0be", "speaker": "male", "text": "今天下午的宠物照顾活动几点开始？", "sha256": "a733c36548e819073a98275ac7c21503b312a3603426f011cff61f138b00c0f5"}, {"key": "e07457b5c1d94b1e8c8f627e", "speaker": "female", "text": "四点。三点半大家可以先看照片，四点老师教我们怎么给小狗梳毛，五点再提问题。", "sha256": "68a20c04ce32e046f558fab4eea6185be235e041382c9547f66d25b89b43530b"}, {"key": "c83a55bd1a6916f7476c881e", "speaker": "male", "text": "我四点前到。", "sha256": "3cba6f1558c489e3ad327a990bea7a83768daf7443225d7a3593843dddc5378f"}, {"key": "1741fb60958696627ba5f0ed", "speaker": "female", "text": "第2题。", "sha256": "39f2c75a46983608745be0da5fe2130f1e77b5cd88f7b9b3928a0a06485a2744"}, {"key": "0315f6641e3cb25031dd784e", "speaker": "female", "text": "放学以后，我每次带小狗出去二十分钟。哥哥今天问我要不要走四十分钟，可是小狗走久了会累，我还是按平时的时间走。", "sha256": "f0f4ecc27e5801db48a282aea57274fae879bdac28b8d5f6a495527e0f04d229"}, {"key": "97e9c8d06f3e0171388ee24b", "speaker": "female", "text": "第3题。", "sha256": "74d7fdba0fd9fae146470574deadbd8616eca796fece18aaf8190b3792f4225e"}, {"key": "bb7a2d0e3455282c5628c6e1", "speaker": "male", "text": "你想学打球还是游泳？", "sha256": "29e30c42dff580686966d2c442de14b5068f15a7a2c7b9bcc422868b30e00885"}, {"key": "b922073fd8885b1215eedcd8", "speaker": "female", "text": "我想游泳，可是只有周三晚上有空。", "sha256": "3daf499d5af8559242addb36b06d23fba1b67bff99916aa410c95b55c1bd1b3a"}, {"key": "1832f4bada4aa1e553f561d5", "speaker": "male", "text": "游泳课周二晚上开，周三有篮球课。", "sha256": "9194cc7762c037331d93a8d2acc7186c9abbad177e5e53c00abea120718f32a4"}, {"key": "981b3dad50f8b6eee5c478a1", "speaker": "female", "text": "那先试试篮球课吧。", "sha256": "8be099083b8b24df7aca09461ab2c26e06efa9629b80e6b8af8fee745543d2cf"}, {"key": "b25d3caab3d72c3d0347de4b", "speaker": "female", "text": "第4题。", "sha256": "cc38e6d168e0664b2b8f98558b26288abcea294390f4e9aa13d8f457ef5a7046"}, {"key": "08517117d0ee52abf4e6326c", "speaker": "female", "text": "上次打球，小丁忘了带水，打完以后一直说口渴。今天他还没出门，就先往书包里放了一大瓶水，旁边的球鞋倒是差点儿忘了。", "sha256": "3884ddc5072417809089d83e9e27be89e3c726988cfbb1886e2f2dcc48186eeb"}, {"key": "c5b1d9675aba74bbd668ea00", "speaker": "female", "text": "第5题。", "sha256": "057a4202f7d25216a190a84d6056c30f42be93ac60cdc21879a97aaaf19252d9"}, {"key": "2d947c43ca4e2641d9aa876d", "speaker": "male", "text": "你到了运动中心就在游泳馆等我吧。", "sha256": "b435bc1b1aeb1fe73ff6a0a92715708c61825b4b2c341f55e0b14b8d4f5a9f51"}, {"key": "adb117d8d2b756941f0b2e54", "speaker": "female", "text": "我不游泳，今天要上篮球课。我们在篮球馆门口见，别走到游泳馆去。", "sha256": "24a0eb6eac2a30f902f1f2ef89208cede61b41e0a584497fbbeab59fae05af8e"}, {"key": "9057c450d8fe592085b5d57b", "speaker": "male", "text": "好，我去篮球馆。", "sha256": "f66472b7284cc41408d2d7dab2786c1b52f966164c5902827206747cd67de03a"}, {"key": "5e6c5b336701fe2c48b7fa2f", "speaker": "female", "text": "第6题。", "sha256": "fcc5b0fabad8f1fa79148054a17b60ac8d2cb351d57ed0d5eb073df550e3ee93"}, {"key": "ec114f1480d71e26223bc8ef", "speaker": "female", "text": "公交车还要等半个小时，你想怎么去运动中心？", "sha256": "19b6c68f959013183bc08e1fa1c0f66bc3e22c82524ca3d06398b95e6f39b18d"}, {"key": "1c4fa8506402773ba46e0147", "speaker": "male", "text": "我们的自行车都在这儿，骑车只要十分钟。", "sha256": "71207e29ced1a3df7d8e1340346529412385f8d1b05a08c1eeb64626559607a2"}, {"key": "045b407c4ffe6ab39e1e6f95", "speaker": "female", "text": "好，把球放进车篮，我们骑车去。", "sha256": "f5ac78ed8cc50120fd9ecbd53384fc365d6dfc580c4d0b4d62c060070a6b98c1"}, {"key": "79e0bdfd02236c1d4253adc0", "speaker": "female", "text": "第7题。", "sha256": "5151859d99f51fb43c1c4ba74a72c7d8898fd12ebdb151ca350243f27169a52c"}, {"key": "c3626edaece6eb5ffa68a9c9", "speaker": "male", "text": "从西门进去以后，怎么到篮球馆？", "sha256": "f5d8011c98a8802c34d3a45f223271520791c760b64fcb6db1782f29d494c7ca"}, {"key": "3c202a0b337523b51a8962b4", "speaker": "female", "text": "先穿过小广场，看到食堂再向左。篮球馆在食堂后面，不在停车场旁边。", "sha256": "653ef837267b726edaf33e9862fb5d1e1465e1005d45ecb7a1922fc190341dc2"}, {"key": "75b521c6feecd0ade80cdd63", "speaker": "male", "text": "好，先过广场。", "sha256": "85fa13a05f0c450c8fce6c21b0f030ae4e0cbbba965fad36ef07aea57d95449c"}, {"key": "b431efe26b8c6cc712ef43b8", "speaker": "female", "text": "第8题。", "sha256": "65ff1f952179bc643f6b488a3150eee5a21667f5901053151fd7aeb53f0c7786"}, {"key": "7957146ab5edc915c296a9b5", "speaker": "female", "text": "六路车两点前到运动中心，不用换车。十路车也能两点前到，可是中间要换一次。", "sha256": "dc9aed748663ef40cf82f7b95783031e20286871861db22392dbbfdde1d2c179"}, {"key": "8a1504e01c149932e08546e9", "speaker": "male", "text": "我带着两个球和一个大包，不想换车，坐六路吧。", "sha256": "099b279902306c68b079891f8d001f221bfa6d36c77b597404999145a4e66844"}, {"key": "76f9b7034e5801a6360f40bd", "speaker": "female", "text": "第9题。", "sha256": "439f37e4f9738e7ac1dc180f588ae4ed900731c0623d4038b9f3533da20c0ada"}, {"key": "25918b8354f9fe7257c8064c", "speaker": "male", "text": "星期六下午三点太热，室外练球还照原计划吗？", "sha256": "05c2109803c7b92904d19fe6b8a78a4c8061c055228c0776b61af50ac0990a65"}, {"key": "0ed2875fca5364564e58cc2d", "speaker": "female", "text": "老师说改到早上八点，地点不变，还是学校球场。", "sha256": "67d91749bb65ec8e6012f1a8d78a5b4219ace02387b123b84ff73cdfcb655b95"}, {"key": "98450733aa9eb7ce1acda3d8", "speaker": "male", "text": "好，我把原来下午的提醒改掉。", "sha256": "9e28d63fa7e48e533eba73518aa3a14dd1e3ffa5d0c41b43b62427ab849b77b7"}, {"key": "86d64da7bc27367110de5cb7", "speaker": "female", "text": "第10题。", "sha256": "a443b83201af7bae91780e167c2fcd53ef523b448bf77dd4ad6b238de2e582d2"}, {"key": "ee25892af09dc723c01b3dd7", "speaker": "female", "text": "野餐要带几盒果汁？", "sha256": "c4f66b296ed0dbcc6a5cab59182cf8bf484db87ecf42838610954b8c90c97afe"}, {"key": "5bd050df0cb1dc34dbbbc8f0", "speaker": "male", "text": "原来六个人，现在只有四个人去，一人一盒就够。", "sha256": "0b34d20b084b5b65a4f95df4c3e420bddbea8f136966c7353519d88a441685d1"}, {"key": "c22462b05ec681303d6e420b", "speaker": "female", "text": "那我带四盒，面包另外买两袋。", "sha256": "68b30aaeea0f049d4bb714d396fbee344a74282b5c294c9901214644c8097286"}, {"key": "cb4453d7b0d2e38d43dd9a10", "speaker": "male", "text": "好，别按原来的人数买。", "sha256": "6e342605b353baee208bcd4a6931ab0c36f6ea8f7697d5c75a526e93fc4dc3df"}, {"key": "63d3dd3f27ad85dca9aa0606", "speaker": "female", "text": "第11题。", "sha256": "09609165ce7b5b5bbc80de6236e7726415e2ab45d65241e1ca3c75ec4a697f32"}, {"key": "5760a985d15fe467d89cbd07", "speaker": "male", "text": "你想买哪张野餐垫？小号轻一些。", "sha256": "ded4c62f75647a957dceb53cdd29ef7d9e758a78dbfbab0294eab172e310520c"}, {"key": "47176595a1f26c1369d2a37e", "speaker": "female", "text": "我们四个人，小号只能坐两个人。我买能坐四个人的大号，蓝色和绿色都可以。", "sha256": "9a29fc5173db9529366e84e4f692f073831df67db3a66a0b7fb4b249e95d83eb"}, {"key": "e8a1c8d9881731e9c24fa7d3", "speaker": "male", "text": "那拿这张绿色大号吧。", "sha256": "3d4cda1868fa0514d5806220b859734c51b19e299ee24e8a952e51d65aaa6a65"}, {"key": "2dbff9b332f7edc61b4c3c18", "speaker": "female", "text": "第12题。", "sha256": "f25ea7d43ed9f81b7dd1af25fa0339498c7d458e79931122755e838f8d314a83"}, {"key": "6b2abe5f85871a28436446ba", "speaker": "female", "text": "这袋面包原来六块，今天学生买只要四块。纸袋要另外一块。", "sha256": "5e423effccf3e3137abb442cafbd0fd0810ccaeb7c86cf9e5246e275eb821106"}, {"key": "1abaec8b7bb99af379d5448b", "speaker": "male", "text": "我是学生，自己带了袋子，只买面包。", "sha256": "548b2286a4fbbf8cce0c3b582f6c47d28123cb1b476a67387529464d64383da1"}, {"key": "95907f821dc70a79eac7e099", "speaker": "female", "text": "那收你四块。", "sha256": "9ff8e0a01720e1d8bd451ec0299c5b041c38a6f1f09f479b87e61b47f30c5f3a"}, {"key": "ec1acc6c51d958bc6eb290a5", "speaker": "female", "text": "第13题。", "sha256": "e6515323a9eef38c0320124c2e99d81f002d229d597de7f44a76008521622c43"}, {"key": "76141f8a39c2be404b5b860b", "speaker": "male", "text": "野餐包要轻一点儿，还要能挡雨。甲包轻，可是怕水；乙包很重；丙包又轻又能挡雨。", "sha256": "d4aef418de2bad55cf150c3253d4f6f33a21ee994add93b5230bba5dc44a3966"}, {"key": "9692c12a6e7ac3dd49b225e9", "speaker": "female", "text": "我们要走很久，天气也可能下雨，就选丙包。", "sha256": "d55c3230b898841e5f6ea29e8fab783fcdb01edd0e08cfacf7d91e0428553bd4"}, {"key": "6a9458d981e42c448c56e5d7", "speaker": "female", "text": "第14题。", "sha256": "3c248ca1222db546caafa3ccef0afeb1d63689c8e501a91b906f7c38012bc8f4"}, {"key": "70ecdec22f4ae16074aad817", "speaker": "female", "text": "小何六点来照顾猫，钥匙还在你那儿吗？", "sha256": "ecad31535986642dfe2c651401d2435428e3616dc86edc18b87b38027e03af38"}, {"key": "cf975c32812746220c5bc48c", "speaker": "male", "text": "在，但我放学后要去打球，七点才到家。", "sha256": "f09e03161390ec42a6d723d16044a104100f8c766b932cc08d1981b7f8e5ebda"}, {"key": "4e77e331a5d99559d85cd0e3", "speaker": "female", "text": "那你先把钥匙给楼下王阿姨，小何来了找她拿。", "sha256": "1c50b1d54e51f6bb9fae9f90618ff370f6a154ac7b4c5053a5a4c728fd840bfc"}, {"key": "9d1b8c046279c5b498214791", "speaker": "female", "text": "第15题。", "sha256": "774136cf8893575562e62fc53ca824d970e119df2986004fbc9a795341529ed7"}, {"key": "7d3f9649dd715d40db259d99", "speaker": "male", "text": "早上还比较凉快，只有二十四度。下午会升到三十五度，也没有风。傍晚才慢慢凉下来。今天想去买球鞋的话，最好别在下午最热的时候出门。", "sha256": "f68047966fa96030b42acc78cac53ffa7c2375819eae39171a3c59fb4da0cf7a"}, {"key": "0cffbf1010d1e54023057ea9", "speaker": "female", "text": "第16题。", "sha256": "6cbe22b4463ef0127dbcb5957919648ee9b071c97d70d0b85edf327b6a0071df"}, {"key": "018715c4a5cb34fbdd4a7a21", "speaker": "female", "text": "今天的球赛为什么改到晚上七点？场地没空吗？", "sha256": "d4bb8013d50437ea6027b78a38551a3b9366195d9eb3cff755410a1d3f75e823"}, {"key": "7a71f122447159098e39208f", "speaker": "male", "text": "场地一直能用，是下午太阳太强，大家怕热。晚上凉快一点儿，打起来更舒服。", "sha256": "f0ba2c4438a4b8b64b4010d5c2188a02cedff02061bb28e9182aafd94e968b90"}, {"key": "ad7f6865e4c3a831208309e1", "speaker": "female", "text": "明白了。", "sha256": "17602b5b58dcf39c9d3e95bb2633087e19dbb273da9c802f7d236a2545252b21"}, {"key": "61f4d2e4e5f3e0536be36453", "speaker": "female", "text": "第17题。", "sha256": "7b303e3cdea4e6b338b981ca7d27218c5da50fd4e2ca1cb297c3ba0853fbff6b"}, {"key": "1c2c978b8f99b5377cb7cee4", "speaker": "male", "text": "我今天想运动，但老师说每次别超过一个小时，也先别跑步。", "sha256": "e4a17ea504e6b72836368398015b86cc05428d3e563c3bc4472a07b8b6364f6e"}, {"key": "30060d64301d795baeef633e", "speaker": "female", "text": "那可以选五十分钟的投篮课。跑步课只有半小时，游泳课却要九十分钟。", "sha256": "102b4cc948eb7c3b2c236af9cd2c7e23739e122474aafbfca6fb5193036a3e60"}, {"key": "ae69416cb9c8dc3e7b1a1b8a", "speaker": "male", "text": "好，我去投篮。", "sha256": "6e0ef5554dcbcfe4c078de586a03e59553ad1ea269ec6560ea50b8c2efd4bb04"}, {"key": "2e9092b1191d42999a9f695d", "speaker": "female", "text": "第18题。", "sha256": "b0832c56a97774c35b538f689f08bf8314e263e14ab809871867bcdede27a70b"}, {"key": "84edffe2951883db3196a67e", "speaker": "female", "text": "端午那天，我们先在河边看龙舟，回来以后听老师讲活动的故事。听完故事，大家才到教室学做香包。我做的香包送给了弟弟，他特别喜欢。", "sha256": "77028711fa02a22c62930cb478f34d2f8491f348c7bc19f847fdbdaf793a7c4b"}, {"key": "ee9540a1a810afba0a3a7056", "speaker": "female", "text": "第19题。", "sha256": "91a1a230e642a4906da5e058c485a56cf6a1c77b67c899338da1843b7db5066e"}, {"key": "e8df6b634115c14b827d76af", "speaker": "male", "text": "端午活动刚开始，小方说自己手笨，做不好香包。老师陪着她做了一次。后来老师还没走过来，她已经自己做好第二个，又开始教旁边的小朋友了。", "sha256": "b63fea9e2a79ae3654bbd81538a7d7a5e3ad6ded2c4688a22c07d74f97020d35"}, {"key": "689adfbaa5b63ac16b96aac6", "speaker": "female", "text": "第20题。", "sha256": "f2a7aa65a74fad7dc9d19d81d6990ac99260287106ff304656efb599e75400e1"}, {"key": "a4a177a840cb9ed5d222f949", "speaker": "male", "text": "明天去运动中心，你还需要借什么东西吗？球、球拍，或者别的东西都可以说。", "sha256": "05e0faf99a89b155efc0258e4cddf0ffb88b6058428be4393caef2a5abc89bc7"}, {"key": "8188b633244f4aea3f175d0e", "speaker": "male", "text": "你想参加羽毛球还是游泳？也可以提出另一个运动。", "sha256": "6dfbaeeca62a3d9803f34988f3505c4161bcecf2009f6c887a8745afef5e3bba"}, {"key": "f0d792bc5ec7b72cfa33c73f", "speaker": "male", "text": "为什么这个运动适合你？告诉我一个理由就可以。", "sha256": "b2e5b934f10d0f51d7b8567f950f74379918603212bbe8f29540eaef0e38d2b9"}, {"key": "e68eb3af1e5c0ee191a35b61", "speaker": "male", "text": "南门明天不开，我们改在东门见，你觉得怎么样？如果不方便，你有什么办法？", "sha256": "c6f7ce89df35534a454ad0c3aee7ae44d2cfa1a250cf1a5e5a63eb533c82cc6e"}]}</script><script src="workspace.js" defer></script><noscript>Use the learner PDF and audio review if JavaScript is unavailable.</noscript></body></html>