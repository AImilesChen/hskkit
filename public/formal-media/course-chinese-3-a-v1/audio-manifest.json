      "bytes": 309356,
      "sha256": "1f9124ec952076c5472ad37978e5bd09c5efd1b13cbcccbcbb4dbd41054d00a7"
    },
    {
      "id": "C3A-L4a",
      "kind": "listening-source",
      "questionNumbers": [
        16
      ],
      "sourcePlays": 1,
      "script": [
        {
          "speaker": "male",
          "text": {
            "zh-Hans": "原定周五下午收集可重复使用的纸盒，现在改到周六上午九点。因为周五要先检查教室，不能提前堆放东西。收集地点还是教学楼门口，只改日期和时间。如果已经和同学约好，请记得把新时间告诉对方。",
            "zh-Hant": "原定週五下午收集可重複使用的紙盒，現在改到週六上午九點。因爲週五要先檢查教室，不能提前堆放東西。收集地點還是教學樓門口，只改日期和時間。如果已經和同學約好，請記得把新時間告訴對方。"
          }
        }
      ],
      "sourceDurationSeconds": 19.728,
      "targetSeconds": [
        18,
        25
      ],
      "withinTarget": true,
      "src": "assets/audio/c3a-l4a.mp3",
      "durationSeconds": 20.28,
      "pcmSeconds": 20.228,
      "bytes": 162476,
      "sha256": "2457b3c7e5adb4de8541627bec59c68d4563cb97f43d3266aa39a914fd7b0518"
    },
    {
      "id": "C3A-L4b",
      "kind": "listening-source",
      "questionNumbers": [
        17,
        18
      ],
      "sourcePlays": 1,
      "script": [
        {
          "speaker": "female",
          "text": {
            "zh-Hans": "小宁以前写完作业就一直看手机，第二天常觉得准备东西很匆忙。这个月她试着睡前半小时不用手机，先把书包放好，再读一小段书。她不是每天都做得到，不过大多数晚上能按计划结束。",
            "zh-Hant": "小寧以前寫完作業就一直看手機，第二天常覺得準備東西很匆忙。這個月她試着睡前半小時不用手機，先把書包放好，再讀一小段書。她不是每天都做得到，不過大多數晚上能按計劃結束。"
          }
        },
        {
          "speaker": "male",
          "text": {
            "zh-Hans": "她觉得有什么不同？",
            "zh-Hant": "她覺得有什麼不同？"
          }
        },
        {
          "speaker": "female",
          "text": {
            "zh-Hans": "两周后她说，早上少了到处找东西的着急，出门也从容一些。她觉得这个安排比较容易重复做。她没有说这办法适合所有人，只打算再试一段时间。",
            "zh-Hant": "兩週後她說，早上少了到處找東西的着急，出門也從容一些。她覺得這個安排比較容易重複做。她沒有說這辦法適合所有人，只打算再試一段時間。"
          }
        }
      ],
      "sourceDurationSeconds": 38.14,
      "targetSeconds": [
        35,
        48
      ],
      "withinTarget": true,
      "src": "assets/audio/c3a-l4b.mp3",
