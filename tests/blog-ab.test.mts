import assert from "node:assert/strict";
import { readFileSync } from "node:fs";
import { DatabaseSync } from "node:sqlite";
import test from "node:test";
import { displayStatus,isEmailAllowed,isSameOriginRequest,markdownToSafeHtml,normalizeBlogInput,normalizePublishAt,safeMediaKey } from "../src/lib/blog/domain.ts";
const root=new URL("../",import.meta.url);const source=(path:string)=>readFileSync(new URL(path,root),"utf8");

test("allowlist is exact, normalized, verified-email ready, and fail closed",()=>{assert.equal(isEmailAllowed("Owner@Example.com","owner@example.com,publisher@example.com"),true);assert.equal(isEmailAllowed("owner@example.com.evil","owner@example.com"),false);assert.equal(isEmailAllowed("owner@example.com",undefined),false);});
test("same-origin write protection rejects cross-site requests",()=>{assert.equal(isSameOriginRequest(new Request("https://hskkit.com/internal",{headers:{host:"hskkit.com",origin:"https://hskkit.com","sec-fetch-site":"same-origin"}})),true);assert.equal(isSameOriginRequest(new Request("https://hskkit.com/internal",{headers:{host:"hskkit.com",origin:"https://evil.example","sec-fetch-site":"cross-site"}})),false);});
test("article input and media keys are bounded",()=>{const value=normalizeBlogInput({title:"How to Review HSK Vocabulary",excerpt:"A practical routine for spaced review.",slug:"How to Review HSK Vocabulary!",contentMarkdown:"## Build a small daily habit\n\nReview what is due every single day."});assert.equal(value.slug,"how-to-review-hsk-vocabulary");assert.throws(()=>normalizeBlogInput({title:"x",excerpt:"short",slug:"x",contentMarkdown:"tiny"}),/INVALID_/);assert.equal(safeMediaKey("blog/2026/asset.webp"),"blog/2026/asset.webp");assert.equal(safeMediaKey("../secret"),undefined);assert.equal(safeMediaKey("commercial/private.pdf"),undefined);});
test("publish dates distinguish scheduled articles and reject invalid ranges",()=>{const now=new Date("2026-09-04T00:00:00.000Z");const future=normalizePublishAt("2026-09-05T00:00:00.000Z",now);assert.equal(displayStatus("published",future),Date.parse(future)>Date.now()?"scheduled":"published");assert.throws(()=>normalizePublishAt("not-a-date",now),/INVALID_PUBLISH_TIME/);assert.throws(()=>normalizePublishAt("2028-09-05T00:00:00.000Z",now),/INVALID_PUBLISH_TIME/);});
test("Markdown preview escapes raw HTML and unsafe links",()=>{const html=markdownToSafeHtml("# Safe\n\n<script>alert(1)</script>\n\n[bad](javascript:alert(1))\n\n**Useful**");assert.match(html,/<h1>Safe<\/h1>/);assert.doesNotMatch(html,/<script/i);assert.match(html,/&lt;script&gt;/);assert.doesNotMatch(html,/href="javascript:/i);assert.match(html,/<strong>Useful<\/strong>/);});
test("migrations create versioned publishing state and immutable history",()=>{const db=new DatabaseSync(":memory:");db.exec("PRAGMA foreign_keys=ON;");for(const migration of ["0023_blog_mvp.sql","0024_blog_version_immutability.sql","0025_blog_editor_publish_loop.sql"])db.exec(source(`migrations/${migration}`));db.exec("INSERT INTO blog_posts(id,slug,title,excerpt,content_markdown,status,revision,author_user_id,created_at,updated_at) VALUES('p1','guide','Guide title','A sufficiently long excerpt','A sufficiently long article body for migration testing','draft',1,'u1','2026-01-01','2026-01-01')");db.exec("INSERT INTO blog_post_versions(id,post_id,version_number,snapshot_json,created_by_user_id,created_at) VALUES('v1','p1',1,'{}','u1','2026-01-01')");assert.throws(()=>db.exec("UPDATE blog_post_versions SET snapshot_json='{}' WHERE id='v1'"),/BLOG_VERSION_IMMUTABLE/);assert.throws(()=>db.exec("DELETE FROM blog_post_versions WHERE id='v1'"),/BLOG_VERSION_IMMUTABLE/);db.exec("UPDATE blog_posts SET status='published',published_at='2099-01-01',published_version_number=1 WHERE id='p1'");const row=db.prepare("SELECT status,published_version_number FROM blog_posts WHERE id='p1'").get()!;assert.equal(row.status,"published");assert.equal(row.published_version_number,1);for(const action of ["autosave","schedule","restore"])db.prepare("INSERT INTO blog_audit_logs(id,actor_user_id,actor_email,action,post_id,created_at) VALUES(?,?,?,?,?,?)").run(action,"u1","owner@example.com",action,"p1","2026-01-01");db.close();});
test("every admin route authenticates and every write validates same origin",()=>{const files=["src/app/api/v1/admin/blog/route.ts","src/app/api/v1/admin/blog/[id]/route.ts","src/app/api/v1/admin/blog/[id]/versions/route.ts","src/app/api/v1/admin/blog/media/route.ts"];for(const file of files){const code=source(file);assert.match(code,/requireBlogAdmin/);if(/POST|PATCH/.test(code))assert.match(code,/requireSameOrigin/);}const access=source("src/lib/blog/access.ts");assert.match(access,/BlogHttpError\(401, "AUTH_REQUIRED"\)/);assert.match(access,/BlogHttpError\(403, "BLOG_ADMIN_REQUIRED"\)/);assert.match(access,/email_verified === 1/);});
test("published content is pinned to immutable versions and editor supports full Stage B loop",()=>{const repository=source("src/lib/blog/repository.ts");assert.match(repository,/published_version_number/);assert.match(repository,/published_at<=\?/);assert.match(repository,/SLUG_LOCKED_AFTER_PUBLISH/);assert.match(repository,/action,post_id[\s\S]*'restore'/);const editor=source("src/app/admin/blog/blog-admin-client.tsx");for(const marker of ["autosave","schedule","withdraw","Version history","Live preview","Republish"])assert.match(editor,new RegExp(marker,"i"));assert.match(editor,/setTimeout\(\(\)=>void persist\("autosave"\),1400\)/);assert.match(source("src/app/admin/blog/page.tsx"),/index:false,follow:false,nocache:true/);});
test("Account exposes Blog studio only after allowlist access succeeds",()=>{const account=source("src/app/account/account-client.tsx");assert.match(account,/\/api\/v1\/admin\/blog\/access/);assert.match(account,/blogAdmin &&/);assert.match(account,/href="\/admin\/blog"/);});
