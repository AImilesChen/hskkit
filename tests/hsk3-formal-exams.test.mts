import test from 'node:test';
import assert from 'node:assert/strict';
import {readFileSync} from 'node:fs';
import {startFormal,saveFormalAnswer,submitFormal,formalView,studentPaper,examPhase,mayOpenPaper} from '../src/lib/formal-exams/hsk3/domain.ts';
import type {ExamPaper,Form} from '../src/lib/formal-exams/hsk3/types.ts';
const paper=(f:Form)=>JSON.parse(readFileSync(`src/lib/formal-exams/hsk3/data/${f}.json`,'utf8')) as ExamPaper;
const now='2026-11-08T10:00:00Z',at=(n:number)=>new Date(Date.parse(now)+n*1000).toISOString();
test('three HSK3 papers: 70 items, phases, no scored answer or sentence reference leaks',()=>{for(const f of ['a','b','c'] as const){const p=paper(f),s=startFormal(p,'guest','k',now);assert.equal(s.questions.length,70);assert.equal(Date.parse(s.deadlineAt)-Date.parse(now),4680000);const v=studentPaper(p);assert.equal(v.parts.filter(x=>x.example).length,9);for(const part of v.parts)for(const q of part.questions){assert(!Object.hasOwn(q,'answer'));assert(!Object.hasOwn(q,'audioScript'));assert(!Object.hasOwn(q,'explanation'));if(q.writing)assert.deepEqual(Object.keys(q.writing),['imageId','keyword']);}assert(!JSON.stringify(formalView(s,p,now)).includes('correctAnswer'));}});
test('server phase boundaries are 23+5+30+20 minutes',()=>{for(const [n,p] of [[1379,'listening'],[1380,'transfer'],[1679,'transfer'],[1680,'reading'],[3479,'reading'],[3480,'writing'],[4679,'writing'],[4680,'expired']] as const)assert.equal(examPhase(now,at(n)),p);});
test('all papers score only 65 objective answers; correct reference sentences still await self-review',()=>{for(const f of ['a','b','c'] as const){const p=paper(f);let s=startFormal(p,'g','k',now);for(const q of s.questions)s=saveFormalAnswer(s,{questionId:q.id,answer:q.correctAnswer,idempotencyKey:q.id,now:at(q.dimension==='listening'?100:q.dimension==='reading'?1800:3600)});const done=submitFormal(s,'submit',at(4000)),v=formalView(done,p,at(4000));assert.equal(v.result?.correct,65);assert.equal(v.result?.total,65);assert.equal(v.result?.listening,30);assert.equal(v.result?.reading,30);assert.equal(v.result?.writing,5);assert.equal(v.result?.items.filter(x=>x.manual && x.correct===null).length,5);assert.equal(done.result?.percentage,100);assert.equal(submitFormal(done,'retry',at(5000)),done);}});
test('sentences save, normalize, clear, retry and reject invalid payloads; Hanzi stays single-character',()=>{let s=startFormal(paper('a'),'g','k',now);const q=s.questions[65];const x={questionId:q.id,answer:' 另一种正确的句子。 ',idempotencyKey:'one',now:at(3600)};s=saveFormalAnswer(s,x);assert.equal(s.answers[0].answer,'另一种正确的句子。');assert.equal(saveFormalAnswer(s,x),s);assert.throws(()=>saveFormalAnswer(s,{...x,answer:'不同'}),/IDEMPOTENCY/);for(const answer of ['x'.repeat(201),'<script>','x\ny'])assert.throws(()=>saveFormalAnswer(s,{...x,answer,idempotencyKey:answer}),/INVALID/);assert.throws(()=>saveFormalAnswer(s,{...x,questionId:s.questions[60].id,answer:'两个',idempotencyKey:'han'}),/INVALID/);assert.throws(()=>saveFormalAnswer(s,{...x,idempotencyKey:'late',now:at(4680)}),/EXPIRED/);assert.throws(()=>saveFormalAnswer(s,{...x,idempotencyKey:'early',now:at(3000)}),/LOCKED/);});
test('A free, B/C existing Pro access; namespace isolated',()=>{assert(mayOpenPaper('a','free'));for(const f of ['b','c'] as const){assert(!mayOpenPaper(f,'free'));assert(mayOpenPaper(f,'pro'));}const r=readFileSync('src/app/api/v1/formal-exams/hsk3/route.ts','utf8');assert(r.includes('hsk3-([abc])-v1'));const m=readFileSync('src/app/api/v1/formal-exams/hsk3/media/[form]/[filename]/route.ts','utf8');assert(m.indexOf('requirePaperAccess(form')<m.indexOf('env.ASSETS.fetch'));});
