{
  "name": "hskkit",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "start": "next start",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test tests/*.test.mts",
    "typecheck": "tsc --noEmit",
    "content:import:batch1": "python3 scripts/content/import-hsk3-batch1.py",
    "content:validate": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/content/validate-content.mts src/lib/content/catalog.json",
    "content:import": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/content/import-content.mts",
    "content:release": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/content/release-content.mts",
    "lint": "next lint",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "next": "^15.0.0",
    "pdf-lib": "^1.17.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.19.11",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.5.0",
    "esbuild": "^0.28.0",
    "postcss": "^8.5.15",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.0.0",
    "wrangler": "^4.94.0"
  }
}
