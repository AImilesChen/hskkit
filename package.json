    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.5.0",
    "esbuild": "^0.28.0",
    "postcss": "^8.5.15",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.0.0",
    "wrangler": "^4.94.0"
  }
