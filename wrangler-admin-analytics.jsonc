{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hskkit-admin-analytics",
  "main": "workers/admin-analytics-worker.ts",
  "compatibility_date": "2026-05-24",
  "workers_dev": false,
  "triggers": { "crons": ["15 9 * * *"] },
  "d1_databases": [{
    "binding": "LEARNING_DB",
    "database_name": "hskkit-learning",
    "database_id": "214d11f8-3cb2-46b7-b7b1-0dfb602dc6e7",
    "migrations_dir": "migrations"
  }]
}
