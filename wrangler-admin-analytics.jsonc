{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hskkit-admin-analytics",
  "main": "workers/admin-analytics-worker.ts",
  "compatibility_date": "2026-05-24",
  "workers_dev": false,
  "triggers": { "crons": ["15 9 * * *"] },
  "services": [{ "binding": "DASHBOARD", "service": "hskkit", "entrypoint": "AdminAnalyticsSync" }]
}
